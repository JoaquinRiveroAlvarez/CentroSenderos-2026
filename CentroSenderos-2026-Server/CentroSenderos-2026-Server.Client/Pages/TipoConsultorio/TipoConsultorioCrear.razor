@page "/tipoconsultorio/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="consultorio-form-page">

    <div class="consultorio-card">

        <div class="card-header">

            <div>
                <button type="button"
                        class="back-button"
                        @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </button>
                <h1>Nuevo Consultorio</h1>
                <p>Complete los datos del tipo de consultorio.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="CrearTipoConsultorioForm"
                  class="consultorio-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />


            <div class="field-group">

                <label>TIPO DE CONSULTORIO</label>

                <InputText class="senderos-input"
                           @bind-Value="modelo.Tipo"
                           placeholder="Ej: Consultorio 1, Sala de Terapia..." />

                <ValidationMessage For="@(() => modelo.Tipo)" />

            </div>


            <div class="field-group">

                <label>DESCRIPCIÓN</label>

                <InputTextArea class="senderos-textarea"
                               @bind-Value="modelo.Descripcion"
                               placeholder="Ingrese una descripción del consultorio" />

                <ValidationMessage For="@(() => modelo.Descripcion)" />

            </div>


            <div class="field-group">

                <label>DIRECCIÓN</label>

                <div class="input-with-icon">

                    <i class="bi bi-geo-alt"></i>

                    <InputText class="senderos-input address-input"
                               @bind-Value="modelo.Direccion"
                               placeholder="Ingrese la dirección" />

                </div>

                <ValidationMessage For="@(() => modelo.Direccion)" />

            </div>


            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>@Mensaje</span>

                </div>
            }


            <div class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        @onclick="Cancelar">

                    Cancelar

                </button>


                <button type="submit"
                        class="btn-guardar"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar</span>
                    }

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private TipoConsultorioDTO modelo = new()
    {
        Tipo = string.Empty,
        Descripcion = string.Empty,
        Direccion = string.Empty
    };

    private bool guardando = false;

    private string Mensaje = string.Empty;


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Post<TipoConsultorioDTO, int>(
                "api/tipoconsultorio",
                modelo
            );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/tipoconsultorio",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/tipoconsultorio");
    }

    private void Volver()
    {
        Nav.NavigateTo("/tipoconsultorio");
    }
}