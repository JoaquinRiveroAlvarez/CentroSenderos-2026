@page "/tipoconsultorio"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="consultorios-page" inert="@(modalActual != ModalConsultorio.Ninguno)">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Consultorio</h1>

            <p>
                Gestioná los consultorios disponibles en Senderos.
            </p>

        </div>


        <div class="header-actions">


            <button type="button"
                    class="btn-nuevo"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Consultorio</span>

            </button>

        </div>

    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar consultorio" Placeholder="Buscar consultorio..." />


    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
            </div>

            <span>Cargando consultorios...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-door-open"></i>
            </div>

            <h2>No hay consultorios registrados</h2>

            <p>
                Todavía no se registraron tipos de consultorio.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nuevo-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Consultorio</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !ConsultoriosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos coincidencias</h2>

            <p>
                No hay consultorios que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">

                <div>CONSULTORIO</div>
                <div>DESCRIPCIÓN</div>
                <div>DIRECCIÓN</div>
                <div></div>

            </div>


            <div class="list-body">

                @foreach (var item in ConsultoriosFiltrados)
                {
                    <div class="consultorio-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="consultorio-info">

                            <div class="consultorio-icon">
                                <i class="bi bi-door-open"></i>
                            </div>

                            <div class="consultorio-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        <div class="consultorio-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="consultorio-direccion">

                            @if (string.IsNullOrWhiteSpace(item.Direccion))
                            {
                                <span class="sin-dato">
                                    Sin dirección
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-geo-alt"></i>
                                <span>@item.Direccion</span>
                            }

                        </div>


                        <div class="consultorio-action">
                            
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@ConsultoriosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "consultorio" : "consultorios")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalConsultorio.Ninguno)
    {
        <AvisoSenderos Mensaje="@Mensaje" />
    }

</div>


@* =========================================================
   MODAL DETALLE
========================================================= *@

@if (modalActual == ModalConsultorio.Detalle)
{
    <ModalAdministracion Icono="bi-door-open" Titulo="Detalle de consultorio" CerrarAlTocarFondo="true" Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar" AlCerrar="SolicitarCerrarModal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando consultorio...</span>

                </div>
            }
            else
            {
                <div class="administracion-cuerpo">


                <div class="field-group administracion-campo">

                    <label>CONSULTORIO</label>

                    <div class="administracion-valor detail-value">
                        @MostrarValor(modelo.Tipo)
                    </div>

                </div>


                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <div class="administracion-valor detail-value detail-value-large">

                        @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                        {
                            <span class="sin-dato">
                                Sin descripción
                            </span>
                        }
                        else
                        {
                            @modelo.Descripcion
                        }

                    </div>

                </div>


                <div class="field-group administracion-campo">

                    <label>DIRECCIÓN</label>

                    <div class="detail-address">

                        <span class="detail-address-icon">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <span class="detail-address-value">
                            @MostrarValor(modelo.Direccion)
                        </span>

                    </div>

                </div>


                </div>
                <footer class="administracion-acciones">
                    <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                    <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                </footer>
            }

    </ModalAdministracion>
}


@* =========================================================
   MODAL CREAR
========================================================= *@

@if (modalActual == ModalConsultorio.Crear)
{
    <ModalAdministracion Icono="bi-door-open" Titulo="Nuevo consultorio" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCerrarModal">



            <EditForm Model="@modelo"
                      OnValidSubmit="CrearConsultorio" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group administracion-campo">

                    <label>CONSULTORIO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del consultorio" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>


                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingrese una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>


                <div class="field-group administracion-campo">

                    <label>DIRECCIÓN</label>

                    <div class="address-input-group">

                        <span class="address-prefix">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <InputText class="address-input"
                                   @bind-Value="modelo.Direccion"
                                   placeholder="Ingresar dirección" />

                    </div>

                    <ValidationMessage For="@(() => modelo.Direccion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <AvisoSenderos Mensaje="@Mensaje" />
                }


                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrarModal">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}


@* =========================================================
   MODAL EDITAR
========================================================= *@

@if (modalActual == ModalConsultorio.Editar)
{
    <ModalAdministracion Icono="bi-door-open" Titulo="Editar consultorio" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCancelarEdicion">



            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group administracion-campo">

                    <label>CONSULTORIO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del consultorio" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>


                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingrese una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>


                <div class="field-group administracion-campo">

                    <label>DIRECCIÓN</label>

                    <div class="address-input-group">

                        <span class="address-prefix">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <InputText class="address-input"
                                   @bind-Value="modelo.Direccion"
                                   placeholder="Ingresar dirección" />

                    </div>

                    <ValidationMessage For="@(() => modelo.Direccion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <AvisoSenderos Mensaje="@Mensaje" />
                }


                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCancelarEdicion">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : "Guardar cambios")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}


@* =========================================================
   CONFIRMAR ELIMINACIÓN
========================================================= *@

@if (mostrarConfirmacionEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar este registro?" Ocupado="@eliminando" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>Si confirmás, el registro dejará de estar disponible.</p>
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@eliminando" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@eliminando" @onclick="ConfirmarEliminar">@(eliminando ? "Eliminando…" : "Eliminar")</button>
        </footer>
    </ModalAdministracion>
}


@if (salidaPendiente is not null)
{
    <ConfirmacionDescarte OnContinuar="SeguirEditando"
                          OnDescartar="DescartarCambios" />
}

@code {
    private Func<Task>? salidaPendiente;
    private string? estadoInicial;
    private string CapturarEstadoFormulario() => System.Text.Json.JsonSerializer.Serialize(modelo);

    private void SeguirEditando() => salidaPendiente = null;

    private async Task DescartarCambios()
    {
        var salir = salidaPendiente;
        salidaPendiente = null;
        if (salir is not null)
            await salir();
    }

    private Task SolicitarCancelarEdicion() => SolicitarSalida(CancelarEdicion);

    private Task SolicitarCerrarModal() => SolicitarSalida(() =>
    {
        CerrarModal();
        return Task.CompletedTask;
    });

    private async Task SolicitarSalida(Func<Task> salir)
    {
        if (guardando || eliminando || cargandoDetalle || salidaPendiente is not null)
            return;

        if ((modalActual is ModalConsultorio.Crear or ModalConsultorio.Editar) &&
            estadoInicial is not null && estadoInicial != CapturarEstadoFormulario())
        {
            salidaPendiente = salir;
            return;
        }

        await salir();
    }


    private enum ModalConsultorio
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }


    private List<TipoConsultorioListadoDTO> lista = new();

    private TipoConsultorioDTO modelo = CrearModeloVacio();

    private ModalConsultorio modalActual =
        ModalConsultorio.Ninguno;


    private int? idSeleccionado;


    private bool cargando = true;

    private bool cargandoDetalle = false;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    private IEnumerable<TipoConsultorioListadoDTO> ConsultoriosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                ContieneTexto(item.Direccion, busqueda)
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;

        idSeleccionado = id;

        modelo = CrearModeloVacio();

        modalActual = ModalConsultorio.Detalle;

        cargandoDetalle = true;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{id}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void AbrirCrear()
    {
        Mensaje = string.Empty;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalConsultorio.Crear;
    }


    private async Task CrearConsultorio()
    {
        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Post<TipoConsultorioDTO, int>(
                "api/tipoconsultorio",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            modalActual = ModalConsultorio.Ninguno;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirEditar()
    {
        Mensaje = string.Empty;

        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalConsultorio.Editar;
    }


    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }


        Mensaje = string.Empty;

        cargandoDetalle = true;

        modalActual = ModalConsultorio.Detalle;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Editar;
        }


        cargandoDetalle = false;
    }


    private async Task GuardarCambios()
    {
        if (idSeleccionado is null)
            return;


        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Put<TipoConsultorioDTO, string>(
                $"api/tipoconsultorio/{idSeleccionado.Value}",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            await Cargar();

            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null)
            return;


        eliminando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Delete(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            modalActual = ModalConsultorio.Ninguno;

            idSeleccionado = null;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;


        cargandoDetalle = true;

        modalActual = ModalConsultorio.Detalle;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void CerrarModal()
    {
        if (guardando || eliminando)
            return;


        modalActual = ModalConsultorio.Ninguno;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        Mensaje = string.Empty;
    }


    private static TipoConsultorioDTO CrearModeloVacio()
    {
        return new TipoConsultorioDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            Direccion = string.Empty
        };
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && FiltrosEntidades.ContieneTexto(valor, busqueda);
    }


    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }

}