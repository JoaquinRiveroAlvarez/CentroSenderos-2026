@page "/tipoconsultorio"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="consultorios-page">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Consultorio</h1>

            <p>
                Gestioná los consultorios disponibles en Senderos.
            </p>

        </div>


        <div class="header-actions">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar consultorio..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />

            </div>


            <button type="button"
                    class="btn-nuevo"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Consultorio</span>

            </button>

        </div>

    </div>


    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
            </div>

            <span>Cargando consultorios...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-door-open"></i>
            </div>

            <h2>No hay consultorios registrados</h2>

            <p>
                Todavía no se registraron tipos de consultorio.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nuevo-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Consultorio</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !ConsultoriosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay consultorios que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">

                <div>CONSULTORIO</div>
                <div>DESCRIPCIÓN</div>
                <div>DIRECCIÓN</div>
                <div></div>

            </div>


            <div class="list-body">

                @foreach (var item in ConsultoriosFiltrados)
                {
                    <div class="consultorio-row"
                         @onclick="() => AbrirDetalle(item.Id)">

                        <div class="consultorio-info">

                            <div class="consultorio-icon">
                                <i class="bi bi-door-open"></i>
                            </div>

                            <div class="consultorio-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        <div class="consultorio-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="consultorio-direccion">

                            @if (string.IsNullOrWhiteSpace(item.Direccion))
                            {
                                <span class="sin-dato">
                                    Sin dirección
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-geo-alt"></i>
                                <span>@item.Direccion</span>
                            }

                        </div>


                        <div class="consultorio-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@ConsultoriosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "consultorio" : "consultorios")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalConsultorio.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


@* =========================================================
   MODAL DETALLE
========================================================= *@

@if (modalActual == ModalConsultorio.Detalle)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando consultorio...</span>

                </div>
            }
            else
            {
                <div class="modal-header">

                    <div>

                        <h2>Detalle Consultorio</h2>

                        <p>
                            Información del consultorio seleccionado.
                        </p>

                    </div>


                    <button type="button"
                            class="close-button"
                            title="Cerrar"
                            @onclick="CerrarModal">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <div class="field-group">

                    <label>CONSULTORIO</label>

                    <div class="detail-value">
                        @MostrarValor(modelo.Tipo)
                    </div>

                </div>


                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <div class="detail-value detail-value-large">

                        @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                        {
                            <span class="sin-dato">
                                Sin descripción
                            </span>
                        }
                        else
                        {
                            @modelo.Descripcion
                        }

                    </div>

                </div>


                <div class="field-group">

                    <label>DIRECCIÓN</label>

                    <div class="detail-address">

                        <span class="detail-address-icon">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <span class="detail-address-value">
                            @MostrarValor(modelo.Direccion)
                        </span>

                    </div>

                </div>


                <div class="modal-actions detail-actions">

                    <button type="button"
                            class="btn-cerrar"
                            @onclick="CerrarModal">

                        Cerrar

                    </button>


                    <button type="button"
                            class="btn-editar"
                            @onclick="AbrirEditar">

                        <i class="bi bi-pencil-square"></i>
                        Editar

                    </button>

                </div>
            }

        </div>

    </div>
}


@* =========================================================
   MODAL CREAR
========================================================= *@

@if (modalActual == ModalConsultorio.Crear)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Nuevo Consultorio</h2>

                    <p>
                        Complete los datos del consultorio.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        title="Cerrar"
                        disabled="@guardando"
                        @onclick="CerrarModal">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="CrearConsultorio">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group">

                    <label>CONSULTORIO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del consultorio" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>


                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingrese una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>


                <div class="field-group">

                    <label>DIRECCIÓN</label>

                    <div class="address-input-group">

                        <span class="address-prefix">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <InputText class="address-input"
                                   @bind-Value="modelo.Direccion"
                                   placeholder="Ingresar dirección" />

                    </div>

                    <ValidationMessage For="@(() => modelo.Direccion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@guardando"
                            @onclick="CerrarModal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-guardar"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@* =========================================================
   MODAL EDITAR
========================================================= *@

@if (modalActual == ModalConsultorio.Editar)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Editar Consultorio</h2>

                    <p>
                        Modifique los datos del consultorio.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        title="Volver al detalle"
                        disabled="@guardando"
                        @onclick="CancelarEdicion">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group">

                    <label>CONSULTORIO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del consultorio" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>


                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingrese una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>


                <div class="field-group">

                    <label>DIRECCIÓN</label>

                    <div class="address-input-group">

                        <span class="address-prefix">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <InputText class="address-input"
                                   @bind-Value="modelo.Direccion"
                                   placeholder="Ingresar dirección" />

                    </div>

                    <ValidationMessage For="@(() => modelo.Direccion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions edit-actions">

                    <button type="button"
                            class="btn-eliminar"
                            disabled="@guardando"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>
                        Eliminar Consultorio

                    </button>


                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                disabled="@guardando"
                                @onclick="CancelarEdicion">

                            Cancelar

                        </button>


                        <button type="submit"
                                class="btn-guardar"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>

        </div>

    </div>
}


@* =========================================================
   CONFIRMAR ELIMINACIÓN
========================================================= *@

@if (mostrarConfirmacionEliminar)
{
    <div class="delete-modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>


            <h2>
                ¿Estás seguro que querés eliminar este consultorio?
            </h2>


            <p>
                Esta acción no se puede deshacer.
                El consultorio será eliminado definitivamente.
            </p>


            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    private enum ModalConsultorio
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }


    private List<TipoConsultorioListadoDTO> lista = new();

    private TipoConsultorioDTO modelo = CrearModeloVacio();

    private ModalConsultorio modalActual =
        ModalConsultorio.Ninguno;


    private int? idSeleccionado;


    private bool cargando = true;

    private bool cargandoDetalle = false;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    private IEnumerable<TipoConsultorioListadoDTO> ConsultoriosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                ContieneTexto(item.Direccion, busqueda)
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;

        idSeleccionado = id;

        modelo = CrearModeloVacio();

        modalActual = ModalConsultorio.Detalle;

        cargandoDetalle = true;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{id}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void AbrirCrear()
    {
        Mensaje = string.Empty;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        modalActual = ModalConsultorio.Crear;
    }


    private async Task CrearConsultorio()
    {
        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Post<TipoConsultorioDTO, int>(
                "api/tipoconsultorio",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            modalActual = ModalConsultorio.Ninguno;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirEditar()
    {
        Mensaje = string.Empty;

        modalActual = ModalConsultorio.Editar;
    }


    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }


        Mensaje = string.Empty;

        cargandoDetalle = true;

        modalActual = ModalConsultorio.Detalle;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Editar;
        }


        cargandoDetalle = false;
    }


    private async Task GuardarCambios()
    {
        if (idSeleccionado is null)
            return;


        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Put<TipoConsultorioDTO, string>(
                $"api/tipoconsultorio/{idSeleccionado.Value}",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            await Cargar();

            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null)
            return;


        eliminando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Delete(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            modalActual = ModalConsultorio.Ninguno;

            idSeleccionado = null;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;


        cargandoDetalle = true;

        modalActual = ModalConsultorio.Detalle;


        var resp =
            await Http.Get<TipoConsultorioDTO>(
                $"api/tipoconsultorio/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalConsultorio.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void CerrarModal()
    {
        if (guardando || eliminando)
            return;


        modalActual = ModalConsultorio.Ninguno;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        Mensaje = string.Empty;
    }


    private static TipoConsultorioDTO CrearModeloVacio()
    {
        return new TipoConsultorioDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            Direccion = string.Empty
        };
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && valor.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            );
    }


    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }

}