@page "/tipoconsultorio"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<h3>Listado de Tipos de Consultorio</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="IrACrear">Nuevo Consultorio</button>
</div>

@if (cargando)
{
    <p>Cargando registros...</p>
}
else if (lista == null || lista.Count == 0)
{
    <p>No hay consultorios registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Dirección</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in lista)
            {
                <tr style="cursor:pointer" @onclick="() => IrAEditar(item.Id)">
                    <td>@item.Id</td>
                    <td>@item.Tipo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Direccion</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>@Mensaje</p>

@code {
    private List<TipoConsultorioListadoDTO> lista = new();
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        var resp = await Http.Get<List<TipoConsultorioListadoDTO>>("api/tipoconsultorio/ListaTipoConsultorio");
        lista = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        await Task.Delay(200);
        cargando = false;
    }

    private void IrAEditar(int id) => Nav.NavigateTo($"/tipoconsultorio/editar/{id}");
    private void IrACrear() => Nav.NavigateTo("/tipoconsultorio/crear");
}

