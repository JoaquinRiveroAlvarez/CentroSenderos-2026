@page "/tipoconsultorio/editar/{id:int}"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<h3>Editar Tipo de Consultorio</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="@modelo" OnValidSubmit="Grabar" FormName="EditarTipoConsultorioForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Tipo</label>
            <InputText class="form-control" @bind-Value="modelo.Tipo" />
        </div>

        <div class="form-group">
            <label>Descripción</label>
            <InputText class="form-control" @bind-Value="modelo.Descripcion" />
        </div>

        <div class="form-group">
            <label>Dirección</label>
            <InputText class="form-control" @bind-Value="modelo.Direccion" />
        </div>

        <button class="btn btn-primary" type="submit">Actualizar</button>
        <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
        <button class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
    </EditForm>
}

<p>@Mensaje</p>

@code {
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public int id { get; set; }
    private TipoConsultorioDTO modelo = new TipoConsultorioDTO
    {
        Tipo = string.Empty,
        Descripcion = string.Empty,
        Direccion = string.Empty
    };
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        var resp = await Http.Get<TipoConsultorioDTO>($"api/tipoconsultorio/{id}");
        modelo = resp.Error ? new TipoConsultorioDTO { Tipo = string.Empty, Descripcion = string.Empty, Direccion = string.Empty }
                            : resp.Respuesta ?? new TipoConsultorioDTO { Tipo = string.Empty, Descripcion = string.Empty, Direccion = string.Empty };
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        await Task.Delay(200);
        cargando = false;
    }

    private async Task Grabar()
    {
        var resp = await Http.Put<TipoConsultorioDTO, string>($"api/tipoconsultorio/{id}", modelo);
        Mensaje = resp.Error ? resp.ObtenerError() : "Actualizado correctamente.";
        if (!resp.Error) Nav.NavigateTo("/tipoconsultorio", true);
    }

    private async Task Eliminar()
    {
        var confirmar = await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar este consultorio?");
        if (confirmar)
        {
            var resp = await Http.Delete($"api/tipoconsultorio/{id}");
            Mensaje = resp.Error ? resp.ObtenerError() : "Consultorio eliminado correctamente.";
            if (!resp.Error) Nav.NavigateTo("/tipoconsultorio", true);
        }
    }

    private void Cancelar() => Nav.NavigateTo("/tipoconsultorio");
}

