@page "/socio"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Presentacion
@using CentroSenderos_2026_Shared.Enum
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="socios-page" inert="@(modalActual != ModalSocio.Ninguno)">
    <div class="page-header">
        <div class="header-title">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Socios</h1>
            <p>Gestioná los socios y Caja Senderos.</p>
        </div>

        <div class="header-actions">


            <button type="button"
                    class="btn-nuevo"
                    disabled="@cargando"
                    @onclick="AbrirCrear">
                <i class="bi bi-person-plus"></i>
                <span>Nuevo socio</span>
            </button>
        </div>
    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar socios" Placeholder="Buscar por profesional, área u observación..." />

    @if (cargando)
    {
        <div class="estado-card">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando socios...</span>
        </div>
    }
    else if (lista.Count == 0)
    {
        @if (string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="estado-card">
                <div class="estado-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h2>No hay socios registrados</h2>
                <p>Podés crear el primero desde esta pantalla.</p>

                <button type="button"
                        class="btn-nuevo-estado"
                        @onclick="AbrirCrear">
                    <i class="bi bi-person-plus"></i>
                    <span>Nuevo socio</span>
                </button>
            </div>
        }
    }
    else if (!SociosFiltrados.Any())
    {
        <div class="estado-card">
            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay socios que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">
                Limpiar búsqueda
            </button>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <div>SOCIO / CAJA</div>
                <div>OBSERVACIÓN</div>
                <div></div>
            </div>

            <div class="list-body">
                @foreach (var item in SociosFiltrados)
                {
                    <div @key="item.Id"
                         class="socio-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {NombreSocio(item)}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="socio-info">
                            <div class="socio-avatar">
                                @if (item.EsCaja)
                                {
                                    <i class="bi bi-wallet2"></i>
                                }
                                else
                                {
                                    @ObtenerIniciales(NombreSocio(item))
                                }
                            </div>

                            <div class="socio-nombre">
                                <span>@NombreSocio(item)</span>
                                @if (!item.EsCaja)
                                {
                                    <AreasProfesional Areas="ObtenerAreasSocio(item)"
                                                       TextoVacio="@(profesionalesCargados ? "Sin área asignada" : "Áreas no disponibles")" />
                                }
                            </div>
                        </div>

                        <div class="socio-observacion">
                            @if (string.IsNullOrWhiteSpace(item.Observacion))
                            {
                                <span class="sin-dato">Sin observación</span>
                            }
                            else
                            {
                                @item.Observacion
                            }
                        </div>

                        <div class="socio-action">
                            
                        </div>
                    </div>
                }
            </div>

            <div class="list-footer">
                <span>
                    Mostrando
                    <strong>@SociosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    registros
                </span>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalSocio.Ninguno)
    {
        <div class="mensaje-error" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            <span>@Mensaje</span>
        </div>
    }
</div>

@if (modalActual == ModalSocio.Crear)
{
    <ModalAdministracion Titulo="Nuevo socio" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCerrarModal">


            @if (cargandoProfesionales)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando profesionales...</span>
                </div>
            }
            else
            {
                <EditForm Model="@modelo"
                          OnValidSubmit="CrearSocio"
                          FormName="CrearSocioModalForm" class="administracion-formulario">
                <div class="administracion-cuerpo">

                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="field-group administracion-campo">
                        <label for="crear-socio-profesional">PROFESIONAL</label>

                        <InputSelect id="crear-socio-profesional"
                                     class="senderos-select"
                                     @bind-Value="modelo.ProfesionalId"
                                     disabled="@(guardando || !profesionalesCargados)">

                            <option value="">Seleccione un profesional</option>

                            @foreach (var prof in profesionales)
                            {
                                <option value="@prof.Id">
                                    @prof.Nombre (@PresentacionProfesional.ObtenerResumenAreas(prof.Areas))
                                </option>
                            }

                        </InputSelect>
                        @if (modelo.ProfesionalId is > 0)
                        {
                            <div class="socio-areas-profesional">
                                <AreasProfesional Areas="AreasSeleccionadas" />
                            </div>
                        }


                        <ValidationMessage For="@(() => modelo.ProfesionalId)" />
                    </div>

                    <div class="field-group administracion-campo">
                        <label for="crear-socio-observacion">OBSERVACIÓN</label>

                        <InputTextArea id="crear-socio-observacion"
                                       class="senderos-textarea"
                                       @bind-Value="modelo.Observacion"
                                       placeholder="Ingrese una observación"
                                       disabled="@guardando" />

                        <ValidationMessage For="@(() => modelo.Observacion)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="form-message" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@Mensaje</span>
                        </div>
                    }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrarModal">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando || !profesionalesCargados)">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </footer>
                </EditForm>
            }
    </ModalAdministracion>
}

@if (modalActual == ModalSocio.Detalle)
{
    <ModalAdministracion Titulo="Detalle de socio" CerrarAlTocarFondo="true" Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar" AlCerrar="SolicitarCerrarModal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando socio...</span>
                </div>
            }
            else
            {
                <div class="administracion-cuerpo">

                <div class="field-group administracion-campo">
                    <label>@(modelo.EsCaja ? "CAJA" : "PROFESIONAL")</label>

                    <div class="detail-profesional">
                        <div class="detail-avatar">
                            @if (modelo.EsCaja)
                            {
                                <i class="bi bi-wallet2"></i>
                            }
                            else
                            {
                                @ObtenerIniciales(ObtenerNombreProfesional())
                            }
                        </div>

                        <div class="detail-profesional-text">
                            <strong>@ObtenerNombreProfesional()</strong>

                            @if (!modelo.EsCaja)
                            {
                                <AreasProfesional Areas="AreasSeleccionadas" />
                            }
                        </div>
                    </div>
                </div>

                <div class="field-group administracion-campo">
                    <label>OBSERVACIÓN</label>

                    <div class="administracion-valor detail-value detail-value-large">
                        @if (string.IsNullOrWhiteSpace(modelo.Observacion))
                        {
                            <span class="sin-dato">Sin observación</span>
                        }
                        else
                        {
                            @modelo.Observacion
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>
                    </div>
                }

                </div>
                <footer class="administracion-acciones">
                    @if (!modelo.EsCaja)
                    {
                        <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                    }
                    <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                </footer>
            }
    </ModalAdministracion>
}

@if (modalActual == ModalSocio.Editar)
{
    <ModalAdministracion Titulo="Editar socio" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCancelarEdicion">


            @if (cargandoProfesionales)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando profesionales...</span>
                </div>
            }
            else
            {
                <EditForm Model="@modelo"
                          OnValidSubmit="GuardarCambios"
                          FormName="EditarSocioModalForm" class="administracion-formulario">
                <div class="administracion-cuerpo">

                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    @if (modelo.EsCaja)
                    {
                        <div class="field-group administracion-campo">
                            <label>NOMBRE</label>
                            <div class="administracion-valor detail-value">Caja Senderos</div>
                        </div>
                    }
                    else
                    {
                        <div class="field-group administracion-campo">
                            <label for="editar-socio-profesional">PROFESIONAL</label>

                            <InputSelect id="editar-socio-profesional"
                                         class="senderos-select"
                                         @bind-Value="modelo.ProfesionalId"
                                         disabled="@(guardando || !profesionalesCargados)">

                                <option value="">Seleccione un profesional</option>

                                @if (modelo.ProfesionalId.HasValue &&
                                     !profesionales.Any(p => p.Id == modelo.ProfesionalId))
                                {
                                    <option value="@modelo.ProfesionalId">
                                        @modelo.Profesional (actual)
                                    </option>
                                }

                                @foreach (var prof in profesionales)
                                {
                                    <option value="@prof.Id">
                                        @prof.Nombre (@PresentacionProfesional.ObtenerResumenAreas(prof.Areas))
                                    </option>
                                }

                            </InputSelect>
                            @if (modelo.ProfesionalId is > 0)
                            {
                                <div class="socio-areas-profesional">
                                    <AreasProfesional Areas="AreasSeleccionadas" />
                                </div>
                            }


                            <ValidationMessage For="@(() => modelo.ProfesionalId)" />
                        </div>
                    }

                    <div class="field-group administracion-campo">
                        <label for="editar-socio-observacion">OBSERVACIÓN</label>

                        <InputTextArea id="editar-socio-observacion"
                                       class="senderos-textarea"
                                       @bind-Value="modelo.Observacion"
                                       placeholder="Ingrese una observación"
                                       disabled="@guardando" />

                        <ValidationMessage For="@(() => modelo.Observacion)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="form-message" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@Mensaje</span>
                        </div>
                    }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCancelarEdicion">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando)">
                        @(guardando ? "Guardando…" : "Guardar cambios")
                    </button>
                </footer>
                </EditForm>
            }
    </ModalAdministracion>
}

@if (mostrarConfirmacionEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar este registro?" Ocupado="@eliminando" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>Si confirmás, el registro dejará de estar disponible.</p>
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@eliminando" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@eliminando" @onclick="ConfirmarEliminar">@(eliminando ? "Eliminando…" : "Eliminar")</button>
        </footer>
    </ModalAdministracion>
}

@if (salidaPendiente is not null)
{
    <ConfirmacionDescarte OnContinuar="SeguirEditando"
                          OnDescartar="DescartarCambios" />
}

@code {
    private Func<Task>? salidaPendiente;
    private string? estadoInicial;
    private string CapturarEstadoFormulario() => System.Text.Json.JsonSerializer.Serialize(modelo);

    private void SeguirEditando() => salidaPendiente = null;

    private async Task DescartarCambios()
    {
        var salir = salidaPendiente;
        salidaPendiente = null;
        if (salir is not null)
            await salir();
    }

    private Task SolicitarCancelarEdicion() => SolicitarSalida(CancelarEdicion);

    private Task SolicitarCerrarModal() => SolicitarSalida(() =>
    {
        CerrarModal();
        return Task.CompletedTask;
    });

    private async Task SolicitarSalida(Func<Task> salir)
    {
        if (guardando || eliminando || cargandoDetalle || cargandoProfesionales || salidaPendiente is not null)
            return;

        if ((modalActual is ModalSocio.Crear or ModalSocio.Editar) &&
            estadoInicial is not null && estadoInicial != CapturarEstadoFormulario())
        {
            salidaPendiente = salir;
            return;
        }

        await salir();
    }

    private IEnumerable<string> ObtenerAreasSocio(SocioListadoDTO socio)
    {
        if (socio.EsCaja)
            return Enumerable.Empty<string>();

        return profesionales.FirstOrDefault(profesional => profesional.Id == socio.ProfesionalId)
            ?.Areas.AsEnumerable() ?? Enumerable.Empty<string>();
    }

    private IEnumerable<string> AreasSeleccionadas =>
        ObtenerProfesionalSeleccionado()?.Areas.AsEnumerable() ?? Enumerable.Empty<string>();


    private enum ModalSocio
    {
        Ninguno,
        Crear,
        Detalle,
        Editar
    }

    private List<SocioListadoDTO> lista = new();
    private List<ProfesionalListadoDTO> profesionales = new();
    private SocioDTO modelo = CrearModeloVacio();

    private ModalSocio modalActual = ModalSocio.Ninguno;
    private int? idSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;
    private bool cargandoProfesionales;
    private bool profesionalesCargados;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private IEnumerable<SocioListadoDTO> SociosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? lista
            : lista.Where(item =>
                ContieneTexto(NombreSocio(item), textoBusqueda.Trim()) ||
                ContieneTexto(item.Observacion, textoBusqueda.Trim()) ||
                ObtenerAreasSocio(item).Any(area => ContieneTexto(area, textoBusqueda.Trim())));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.WhenAll(Cargar(), CargarProfesionales());
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Cargar()
    {
        try
        {
            var resp = await Http.Get<List<SocioListadoDTO>>(
                "api/socio/ListaSocio");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            if (resp.Respuesta == null)
            {
                Mensaje = "No se pudo obtener el listado de socios.";
                return;
            }

            lista = resp.Respuesta;
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar los socios.";
        }
    }

    private async Task CargarProfesionales()
    {
        cargandoProfesionales = true;
        profesionalesCargados = false;
        profesionales = new();

        try
        {
            var resp = await Http.Get<List<ProfesionalListadoDTO>>(
                "api/profesional/ListaProfesional");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            if (resp.Respuesta == null)
            {
                Mensaje = "No se pudo obtener el listado de profesionales.";
                return;
            }

            profesionales = resp.Respuesta;
            profesionalesCargados = true;
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar los profesionales.";
        }
        finally
        {
            cargandoProfesionales = false;
        }
    }

    private async Task AbrirCrear()
    {
        if (guardando || eliminando ||
            cargandoDetalle || cargandoProfesionales)
        {
            return;
        }

        Mensaje = string.Empty;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalSocio.Crear;

        await CargarProfesionales();
    }

    private async Task CrearSocio()
    {
        if (guardando || !profesionalesCargados)
            return;

        Mensaje = string.Empty;

        if (!modelo.ProfesionalId.HasValue ||
            modelo.ProfesionalId.Value <= 0)
        {
            Mensaje = "Seleccioná un profesional para el socio.";
            return;
        }

        modelo.EsCaja = false;
        guardando = true;

        try
        {
            var resp = await Http.Post<SocioDTO, int>(
                "api/socio/insertar",
                modelo);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            modalActual = ModalSocio.Ninguno;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar el guardado. " +
                "Revisá el listado antes de intentar nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task AbrirDetalle(int id)
    {
        if (cargandoDetalle || cargandoProfesionales ||
            guardando || eliminando)
        {
            return;
        }

        Mensaje = string.Empty;
        idSeleccionado = id;
        modelo = CrearModeloVacio();

        await RecargarDetalle();
    }

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;

        cargandoDetalle = true;
        modalActual = ModalSocio.Detalle;

        try
        {
            var resp = await Http.Get<SocioListadoDTO>(
                $"api/socio/{idSeleccionado.Value}");

            if (resp.Error || resp.Respuesta == null)
            {
                Mensaje = resp.Error
                    ? resp.ObtenerError()
                    : "No se pudo obtener el socio seleccionado.";

                modalActual = ModalSocio.Ninguno;
                return;
            }

            var socio = resp.Respuesta;

            modelo = new SocioDTO
            {
                Id = socio.Id,
                ProfesionalId = socio.ProfesionalId,
                EsCaja = socio.EsCaja,
                Profesional = socio.Profesional,
                Observacion = socio.Observacion,
                EstadoRegistro = EnumEstadoRegistro.activo
            };
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar el detalle.";
            modalActual = ModalSocio.Ninguno;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private async Task AbrirEditar()
    {
        if (idSeleccionado is null ||
            cargandoDetalle || guardando || eliminando)
        {
            return;
        }

        Mensaje = string.Empty;
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalSocio.Editar;

        if (!modelo.EsCaja)
            await CargarProfesionales();
    }

    private async Task CancelarEdicion()
    {
        if (guardando || eliminando ||
            cargandoProfesionales || idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;
        await RecargarDetalle();
    }

    private async Task GuardarCambios()
    {
        if (guardando || eliminando ||
            cargandoProfesionales || idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;

        if (modelo.EsCaja)
        {
            modelo.ProfesionalId = null;
        }
        else if (!modelo.ProfesionalId.HasValue ||
                 modelo.ProfesionalId.Value <= 0)
        {
            Mensaje = "Seleccioná un profesional para el socio.";
            return;
        }

        guardando = true;

        try
        {
            var resp = await Http.Put<SocioDTO, RespuestaDTO>(
                $"api/socio/{idSeleccionado.Value}",
                modelo);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            await Cargar();
            await RecargarDetalle();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar el guardado. " +
                "Volvé a consultar el detalle antes de intentar nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (modelo.EsCaja || guardando ||
            eliminando || cargandoProfesionales)
        {
            return;
        }

        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
            mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (eliminando || guardando ||
            idSeleccionado is null || modelo.EsCaja)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        try
        {
            var resp = await Http.Delete(
                $"api/socio/{idSeleccionado.Value}");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            modalActual = ModalSocio.Ninguno;
            idSeleccionado = null;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar la baja del socio. " +
                "Volvé a consultar el listado.";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
        }
    }

    private void CerrarModal()
    {
        if (guardando || eliminando ||
            cargandoDetalle || cargandoProfesionales)
        {
            return;
        }

        modalActual = ModalSocio.Ninguno;
        mostrarConfirmacionEliminar = false;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        Mensaje = string.Empty;
    }

    private ProfesionalListadoDTO? ObtenerProfesionalSeleccionado()
    {
        if (modelo.EsCaja)
            return null;

        return profesionales.FirstOrDefault(
            p => p.Id == modelo.ProfesionalId);
    }

    private string ObtenerNombreProfesional()
    {
        if (modelo.EsCaja)
            return "Caja Senderos";

        var nombre = ObtenerProfesionalSeleccionado()?.Nombre;

        if (!string.IsNullOrWhiteSpace(nombre))
            return nombre;

        return string.IsNullOrWhiteSpace(modelo.Profesional)
            ? "Sin profesional"
            : modelo.Profesional;
    }

    private static SocioDTO CrearModeloVacio()
    {
        return new SocioDTO
        {
            ProfesionalId = null,
            EsCaja = false,
            Observacion = string.Empty,
            EstadoRegistro = EnumEstadoRegistro.EnGrabacion
        };
    }

    private static string NombreSocio(SocioListadoDTO socio)
    {
        return socio.EsCaja
            ? "Caja Senderos"
            : string.IsNullOrWhiteSpace(socio.Profesional)
                ? "Sin profesional"
                : socio.Profesional;
    }

    private static bool ContieneTexto(string? valor, string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor) &&
            FiltrosEntidades.ContieneTexto(valor, busqueda);
    }

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "S";

        var partes = nombre.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
            return "S";

        return partes.Length == 1
            ? partes[0][0].ToString().ToUpper()
            : string.Concat(partes[0][0], partes[1][0]).ToUpper();
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}
