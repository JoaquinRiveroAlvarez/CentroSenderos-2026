@page "/socio"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="socios-page">
    <div class="page-header">
        <div class="header-title">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Socios</h1>
            <p>Gestioná los socios y Caja Senderos.</p>
        </div>

        <div class="header-actions">
            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar socio..."
                       aria-label="Buscar socio"
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>

            <button type="button"
                    class="btn-nuevo"
                    disabled="@cargando"
                    @onclick="AbrirCrear">
                <i class="bi bi-person-plus"></i>
                <span>Nuevo socio</span>
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="estado-card">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando socios...</span>
        </div>
    }
    else if (lista.Count == 0)
    {
        @if (string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="estado-card">
                <div class="estado-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h2>No hay socios registrados</h2>
                <p>Podés crear el primero desde esta pantalla.</p>

                <button type="button"
                        class="btn-nuevo-estado"
                        @onclick="AbrirCrear">
                    <i class="bi bi-person-plus"></i>
                    <span>Nuevo socio</span>
                </button>
            </div>
        }
    }
    else if (!SociosFiltrados.Any())
    {
        <div class="estado-card">
            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay socios que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">
                Limpiar búsqueda
            </button>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <div>SOCIO / CAJA</div>
                <div>OBSERVACIÓN</div>
                <div></div>
            </div>

            <div class="list-body">
                @foreach (var item in SociosFiltrados)
                {
                    <div @key="item.Id"
                         class="socio-row"
                         @onclick="() => AbrirDetalle(item.Id)">

                        <div class="socio-info">
                            <div class="socio-avatar">
                                @if (item.EsCaja)
                                {
                                    <i class="bi bi-wallet2"></i>
                                }
                                else
                                {
                                    @ObtenerIniciales(NombreSocio(item))
                                }
                            </div>

                            <div class="socio-nombre">
                                @NombreSocio(item)
                            </div>
                        </div>

                        <div class="socio-observacion">
                            @if (string.IsNullOrWhiteSpace(item.Observacion))
                            {
                                <span class="sin-dato">Sin observación</span>
                            }
                            else
                            {
                                @item.Observacion
                            }
                        </div>

                        <div class="socio-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="list-footer">
                <span>
                    Mostrando
                    <strong>@SociosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    registros
                </span>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalSocio.Ninguno)
    {
        <div class="mensaje-error" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            <span>@Mensaje</span>
        </div>
    }
</div>

@if (modalActual == ModalSocio.Crear)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="titulo-crear-socio">

            <div class="modal-header">
                <div>
                    <h2 id="titulo-crear-socio">Nuevo socio</h2>
                    <p>Seleccione el profesional y complete la observación.</p>
                </div>

                <button type="button"
                        class="close-button"
                        title="Cerrar"
                        aria-label="Cerrar formulario"
                        disabled="@guardando"
                        @onclick="CerrarModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (cargandoProfesionales)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando profesionales...</span>
                </div>
            }
            else
            {
                <EditForm Model="@modelo"
                          OnValidSubmit="CrearSocio"
                          FormName="CrearSocioModalForm">

                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="field-group">
                        <label for="crear-socio-profesional">PROFESIONAL</label>

                        <InputSelect id="crear-socio-profesional"
                                     class="senderos-select"
                                     @bind-Value="modelo.ProfesionalId"
                                     disabled="@(guardando || !profesionalesCargados)">

                            <option value="">Seleccione un profesional</option>

                            @foreach (var prof in profesionales)
                            {
                                <option value="@prof.Id">
                                    @prof.Nombre (@prof.Area)
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.ProfesionalId)" />
                    </div>

                    <div class="field-group">
                        <label for="crear-socio-observacion">OBSERVACIÓN</label>

                        <InputTextArea id="crear-socio-observacion"
                                       class="senderos-textarea"
                                       @bind-Value="modelo.Observacion"
                                       placeholder="Ingrese una observación"
                                       disabled="@guardando" />

                        <ValidationMessage For="@(() => modelo.Observacion)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="form-message" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@Mensaje</span>
                        </div>
                    }

                    <div class="modal-actions">
                        <button type="button"
                                class="btn-cancelar"
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn-guardar"
                                disabled="@(guardando || !profesionalesCargados)">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"
                                      aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar socio</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (modalActual == ModalSocio.Detalle)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="titulo-detalle-socio">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando socio...</span>
                </div>
            }
            else
            {
                <div class="modal-header">
                    <div>
                        <h2 id="titulo-detalle-socio">
                            @(modelo.EsCaja ? "Detalle Caja Senderos" : "Detalle socio")
                        </h2>

                        <p>Información del registro seleccionado.</p>
                    </div>

                    <button type="button"
                            class="close-button"
                            title="Cerrar"
                            aria-label="Cerrar detalle"
                            @onclick="CerrarModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="field-group">
                    <label>@(modelo.EsCaja ? "CAJA" : "PROFESIONAL")</label>

                    <div class="detail-profesional">
                        <div class="detail-avatar">
                            @if (modelo.EsCaja)
                            {
                                <i class="bi bi-wallet2"></i>
                            }
                            else
                            {
                                @ObtenerIniciales(ObtenerNombreProfesional())
                            }
                        </div>

                        <div class="detail-profesional-text">
                            <strong>@ObtenerNombreProfesional()</strong>

                            @if (!string.IsNullOrWhiteSpace(ObtenerAreaProfesional()))
                            {
                                <span>@ObtenerAreaProfesional()</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="field-group">
                    <label>OBSERVACIÓN</label>

                    <div class="detail-value detail-value-large">
                        @if (string.IsNullOrWhiteSpace(modelo.Observacion))
                        {
                            <span class="sin-dato">Sin observación</span>
                        }
                        else
                        {
                            @modelo.Observacion
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>
                    </div>
                }

                <div class="modal-actions detail-actions">
                    <button type="button"
                            class="btn-cerrar"
                            @onclick="CerrarModal">
                        Cerrar
                    </button>

                    <button type="button"
                            class="btn-editar"
                            @onclick="AbrirEditar">
                        <i class="bi bi-pencil-square"></i>
                        Editar
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (modalActual == ModalSocio.Editar)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="titulo-editar-socio">

            <div class="modal-header">
                <div>
                    <h2 id="titulo-editar-socio">
                        @(modelo.EsCaja ? "Editar Caja Senderos" : "Editar socio")
                    </h2>

                    <p>
                        @(modelo.EsCaja
                            ? "Modifique la observación de Caja Senderos."
                            : "Modifique los datos asociados al socio.")
                    </p>
                </div>

                <button type="button"
                        class="close-button"
                        title="Volver al detalle"
                        aria-label="Volver al detalle"
                        disabled="@(guardando || cargandoProfesionales)"
                        @onclick="CancelarEdicion">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (cargandoProfesionales)
            {
                <div class="modal-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando profesionales...</span>
                </div>
            }
            else
            {
                <EditForm Model="@modelo"
                          OnValidSubmit="GuardarCambios"
                          FormName="EditarSocioModalForm">

                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    @if (modelo.EsCaja)
                    {
                        <div class="field-group">
                            <label>NOMBRE</label>
                            <div class="detail-value">Caja Senderos</div>
                        </div>
                    }
                    else
                    {
                        <div class="field-group">
                            <label for="editar-socio-profesional">PROFESIONAL</label>

                            <InputSelect id="editar-socio-profesional"
                                         class="senderos-select"
                                         @bind-Value="modelo.ProfesionalId"
                                         disabled="@(guardando || !profesionalesCargados)">

                                <option value="">Seleccione un profesional</option>

                                @if (modelo.ProfesionalId.HasValue &&
                                     !profesionales.Any(p => p.Id == modelo.ProfesionalId))
                                {
                                    <option value="@modelo.ProfesionalId">
                                        @modelo.Profesional (actual)
                                    </option>
                                }

                                @foreach (var prof in profesionales)
                                {
                                    <option value="@prof.Id">
                                        @prof.Nombre (@prof.Area)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.ProfesionalId)" />
                        </div>
                    }

                    <div class="field-group">
                        <label for="editar-socio-observacion">OBSERVACIÓN</label>

                        <InputTextArea id="editar-socio-observacion"
                                       class="senderos-textarea"
                                       @bind-Value="modelo.Observacion"
                                       placeholder="Ingrese una observación"
                                       disabled="@guardando" />

                        <ValidationMessage For="@(() => modelo.Observacion)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="form-message" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@Mensaje</span>
                        </div>
                    }

                    <div class="modal-actions edit-actions">
                        @if (!modelo.EsCaja)
                        {
                            <button type="button"
                                    class="btn-eliminar"
                                    disabled="@guardando"
                                    @onclick="AbrirConfirmacionEliminar">
                                <i class="bi bi-trash3"></i>
                                Eliminar socio
                            </button>
                        }

                        <div class="right-actions">
                            <button type="button"
                                    class="btn-cancelar"
                                    disabled="@guardando"
                                    @onclick="CancelarEdicion">
                                Cancelar
                            </button>

                            <button type="submit"
                                    class="btn-guardar"
                                    disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm"
                                          aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar cambios</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="delete-modal-overlay">
        <div class="delete-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="titulo-eliminar-socio">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2 id="titulo-eliminar-socio">
                ¿Querés dar de baja este socio?
            </h2>

            <p>
                El socio dejará de aparecer en el listado activo.
                Sus movimientos registrados se conservarán.
            </p>

            <div class="delete-modal-actions">
                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">
                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              aria-hidden="true"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }
                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum ModalSocio
    {
        Ninguno,
        Crear,
        Detalle,
        Editar
    }

    private List<SocioListadoDTO> lista = new();
    private List<ProfesionalListadoDTO> profesionales = new();
    private SocioDTO modelo = CrearModeloVacio();

    private ModalSocio modalActual = ModalSocio.Ninguno;
    private int? idSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;
    private bool cargandoProfesionales;
    private bool profesionalesCargados;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private IEnumerable<SocioListadoDTO> SociosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? lista
            : lista.Where(item =>
                ContieneTexto(NombreSocio(item), textoBusqueda.Trim()) ||
                ContieneTexto(item.Observacion, textoBusqueda.Trim()));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Cargar();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Cargar()
    {
        try
        {
            var resp = await Http.Get<List<SocioListadoDTO>>(
                "api/socio/ListaSocio");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            if (resp.Respuesta == null)
            {
                Mensaje = "No se pudo obtener el listado de socios.";
                return;
            }

            lista = resp.Respuesta;
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar los socios.";
        }
    }

    private async Task CargarProfesionales()
    {
        cargandoProfesionales = true;
        profesionalesCargados = false;
        profesionales = new();

        try
        {
            var resp = await Http.Get<List<ProfesionalListadoDTO>>(
                "api/profesional/ListaProfesional");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            if (resp.Respuesta == null)
            {
                Mensaje = "No se pudo obtener el listado de profesionales.";
                return;
            }

            profesionales = resp.Respuesta;
            profesionalesCargados = true;
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar los profesionales.";
        }
        finally
        {
            cargandoProfesionales = false;
        }
    }

    private async Task AbrirCrear()
    {
        if (guardando || eliminando ||
            cargandoDetalle || cargandoProfesionales)
        {
            return;
        }

        Mensaje = string.Empty;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        modalActual = ModalSocio.Crear;

        await CargarProfesionales();
    }

    private async Task CrearSocio()
    {
        if (guardando || !profesionalesCargados)
            return;

        Mensaje = string.Empty;

        if (!modelo.ProfesionalId.HasValue ||
            modelo.ProfesionalId.Value <= 0)
        {
            Mensaje = "Seleccioná un profesional para el socio.";
            return;
        }

        modelo.EsCaja = false;
        guardando = true;

        try
        {
            var resp = await Http.Post<SocioDTO, int>(
                "api/socio/insertar",
                modelo);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            modalActual = ModalSocio.Ninguno;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar el guardado. " +
                "Revisá el listado antes de intentar nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task AbrirDetalle(int id)
    {
        if (cargandoDetalle || cargandoProfesionales ||
            guardando || eliminando)
        {
            return;
        }

        Mensaje = string.Empty;
        idSeleccionado = id;
        modelo = CrearModeloVacio();

        await RecargarDetalle();
    }

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;

        cargandoDetalle = true;
        modalActual = ModalSocio.Detalle;

        try
        {
            var resp = await Http.Get<SocioListadoDTO>(
                $"api/socio/{idSeleccionado.Value}");

            if (resp.Error || resp.Respuesta == null)
            {
                Mensaje = resp.Error
                    ? resp.ObtenerError()
                    : "No se pudo obtener el socio seleccionado.";

                modalActual = ModalSocio.Ninguno;
                return;
            }

            var socio = resp.Respuesta;

            modelo = new SocioDTO
            {
                Id = socio.Id,
                ProfesionalId = socio.ProfesionalId,
                EsCaja = socio.EsCaja,
                Profesional = socio.Profesional,
                Observacion = socio.Observacion,
                EstadoRegistro = EnumEstadoRegistro.activo
            };
        }
        catch (Exception)
        {
            Mensaje = "No se pudo conectar para cargar el detalle.";
            modalActual = ModalSocio.Ninguno;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private async Task AbrirEditar()
    {
        if (idSeleccionado is null ||
            cargandoDetalle || guardando || eliminando)
        {
            return;
        }

        Mensaje = string.Empty;
        modalActual = ModalSocio.Editar;

        if (!modelo.EsCaja)
            await CargarProfesionales();
    }

    private async Task CancelarEdicion()
    {
        if (guardando || eliminando ||
            cargandoProfesionales || idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;
        await RecargarDetalle();
    }

    private async Task GuardarCambios()
    {
        if (guardando || eliminando ||
            cargandoProfesionales || idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;

        if (modelo.EsCaja)
        {
            modelo.ProfesionalId = null;
        }
        else if (!modelo.ProfesionalId.HasValue ||
                 modelo.ProfesionalId.Value <= 0)
        {
            Mensaje = "Seleccioná un profesional para el socio.";
            return;
        }

        guardando = true;

        try
        {
            var resp = await Http.Put<SocioDTO, RespuestaDTO>(
                $"api/socio/{idSeleccionado.Value}",
                modelo);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            await Cargar();
            await RecargarDetalle();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar el guardado. " +
                "Volvé a consultar el detalle antes de intentar nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (modelo.EsCaja || guardando ||
            eliminando || cargandoProfesionales)
        {
            return;
        }

        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
            mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (eliminando || guardando ||
            idSeleccionado is null || modelo.EsCaja)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        try
        {
            var resp = await Http.Delete(
                $"api/socio/{idSeleccionado.Value}");

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            modalActual = ModalSocio.Ninguno;
            idSeleccionado = null;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        catch (Exception)
        {
            Mensaje =
                "No se pudo confirmar la baja del socio. " +
                "Volvé a consultar el listado.";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
        }
    }

    private void CerrarModal()
    {
        if (guardando || eliminando ||
            cargandoDetalle || cargandoProfesionales)
        {
            return;
        }

        modalActual = ModalSocio.Ninguno;
        mostrarConfirmacionEliminar = false;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        Mensaje = string.Empty;
    }

    private ProfesionalListadoDTO? ObtenerProfesionalSeleccionado()
    {
        if (modelo.EsCaja)
            return null;

        return profesionales.FirstOrDefault(
            p => p.Id == modelo.ProfesionalId);
    }

    private string ObtenerNombreProfesional()
    {
        if (modelo.EsCaja)
            return "Caja Senderos";

        var nombre = ObtenerProfesionalSeleccionado()?.Nombre;

        if (!string.IsNullOrWhiteSpace(nombre))
            return nombre;

        return string.IsNullOrWhiteSpace(modelo.Profesional)
            ? "Sin profesional"
            : modelo.Profesional;
    }

    private string ObtenerAreaProfesional()
    {
        return modelo.EsCaja
            ? string.Empty
            : ObtenerProfesionalSeleccionado()?.Area ?? string.Empty;
    }

    private static SocioDTO CrearModeloVacio()
    {
        return new SocioDTO
        {
            ProfesionalId = null,
            EsCaja = false,
            Observacion = string.Empty,
            EstadoRegistro = EnumEstadoRegistro.EnGrabacion
        };
    }

    private static string NombreSocio(SocioListadoDTO socio)
    {
        return socio.EsCaja
            ? "Caja Senderos"
            : string.IsNullOrWhiteSpace(socio.Profesional)
                ? "Sin profesional"
                : socio.Profesional;
    }

    private static bool ContieneTexto(string? valor, string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor) &&
            valor.Contains(busqueda, StringComparison.OrdinalIgnoreCase);
    }

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "S";

        var partes = nombre.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
            return "S";

        return partes.Length == 1
            ? partes[0][0].ToString().ToUpper()
            : string.Concat(partes[0][0], partes[1][0]).ToUpper();
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}