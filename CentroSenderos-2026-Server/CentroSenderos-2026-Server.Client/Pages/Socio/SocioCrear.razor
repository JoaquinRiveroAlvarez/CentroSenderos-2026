@page "/socio/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="socio-form-page">

    <div class="socio-card">

        <div class="card-header">

            <div>
                <h1>Nuevo Socio</h1>
                <p>Seleccione el profesional y complete la observación.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        @if (cargando)
        {
            <div class="loading-state">

                <div class="spinner-border"
                     role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>

                <span>Cargando profesionales...</span>

            </div>
        }
        else
        {
            <EditForm Model="@modelo"
                      OnValidSubmit="Grabar"
                      FormName="CrearSocioForm"
                      class="socio-form">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group">

                    <label>PROFESIONAL</label>

                    <InputSelect class="senderos-select"
                                 @bind-Value="modelo.ProfesionalId">

                        <option value="0">
                            Seleccione un profesional
                        </option>

                        @foreach (var prof in profesionales)
                        {
                            <option value="@prof.Id">
                                @prof.Nombre (@prof.Area)
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => modelo.ProfesionalId)" />

                </div>


                <div class="field-group">

                    <label>OBSERVACIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Observacion"
                                   placeholder="Ingrese una observación" />

                    <ValidationMessage For="@(() => modelo.Observacion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="form-actions">

                    <button type="button"
                            class="btn-cancelar"
                            @onclick="Cancelar">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-guardar"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Socio</span>
                        }

                    </button>

                </div>

            </EditForm>
        }

    </div>

</div>


@code {

    private SocioDTO modelo = new()
    {
        ProfesionalId = 0,
        Observacion = string.Empty,
        EstadoRegistro = EnumEstadoRegistro.EnGrabacion
    };

    private List<ProfesionalListadoDTO> profesionales = new();

    private bool cargando = true;

    private bool guardando = false;

    private string Mensaje = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarProfesionales();
    }


    private async Task CargarProfesionales()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respProf =
            await Http.Get<List<ProfesionalListadoDTO>>(
                "api/profesional/ListaProfesional"
            );

        if (!respProf.Error)
        {
            profesionales =
                respProf.Respuesta ?? new();
        }
        else
        {
            profesionales = new();

            Mensaje =
                respProf.ObtenerError();
        }

        cargando = false;
    }


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Post<SocioDTO, int>(
                "api/socio/insertar",
                modelo
            );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/socio",
                forceLoad: true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/socio");
    }

}