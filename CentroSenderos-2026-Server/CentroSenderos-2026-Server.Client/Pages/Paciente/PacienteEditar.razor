@page "/pacientes/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="editar-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@(guardando || eliminando)"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <h1>Editar Paciente</h1>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="editar-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Fecha de nacimiento</label>

                        <InputDate class="form-input"
                                   @bind-Value="modelo.FechaNacimiento" />

                        <ValidationMessage For="@(() => modelo.FechaNacimiento)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label>Obra Social / Prepaga</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <div class="readonly-number-field">

                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="readonly-number-value">
                                    @modelo.NumeroAfiliado
                                </span>

                                <span class="readonly-number-description">
                                    Asignado automáticamente
                                </span>
                            </div>

                        </div>

                    </div>

                    <div class="field-group">

                        <label>Diagnóstico / Motivo de Consulta</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            @foreach (var diagnostico in tiposDiagnostico)
                            {
                                <option value="@diagnostico.Id">
                                    @diagnostico.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado Único de Discapacidad</label>

                        <label class="cud-option">

                            <InputCheckbox class="cud-checkbox"
                                           @bind-Value="modelo.TieneCud" />

                            <span class="cud-option-content">

                                <span class="cud-option-title">
                                    Tiene CUD
                                </span>

                                <span class="cud-option-description">
                                    Marcar si el paciente posee un CUD vigente.
                                </span>

                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title section-title-actions">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de Contacto</span>
                    </div>

                    <button type="button"
                            class="add-phone-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="AgregarTelefono">
                        <i class="bi bi-plus-lg"></i>
                        Agregar teléfono
                    </button>

                </div>

                <div class="phones-list">

                    @foreach (var telefono in modelo.Telefonos)
                    {
                        <div class="phone-row" @key="telefono">

                            <div class="field-group">

                                <label>Etiqueta</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Etiqueta"
                                           placeholder="Ej.: Paciente, madre o tutor" />

                            </div>

                            <div class="field-group">

                                <label>Número de teléfono</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Numero"
                                           placeholder="Insertar teléfono" />

                            </div>

                            <button type="button"
                                    class="remove-phone-button"
                                    title="Eliminar teléfono"
                                    disabled="@(guardando ||
                                                                                eliminando ||
                                                                                modelo.Telefonos.Count == 1)"
                                    @onclick="() => EliminarTelefono(telefono)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeTelefonos))
                {
                    <div class="phone-validation">
                        @MensajeTelefonos
                    </div>
                }

                <div class="form-grid">
                    <div class="field-group address-field">

                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>
                </div>

            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="editar-mensaje">
                    @Mensaje
                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        disabled="@(guardando || eliminando)"
                        @onclick="AbrirConfirmacionEliminar">
                    <i class="bi bi-trash"></i>
                    <span>Eliminar Paciente</span>
                </button>

                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Paciente</span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>¿Eliminar paciente?</h2>

            <p>
                ¿Estás seguro de que querés eliminar a
                <strong>@modelo?.Nombre</strong>?
                El paciente dejará de aparecer entre los registros activos.
            </p>

            @if (!string.IsNullOrWhiteSpace(MensajeEliminar))
            {
                <div class="delete-error">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>@MensajeEliminar</span>

                </div>
            }

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar paciente</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PacienteDTO? modelo;

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string MensajeTelefonos = string.Empty;
    private string MensajeEliminar = string.Empty;

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }

        var respDiagnostico = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiagnostico.Error &&
            respDiagnostico.Respuesta != null)
        {
            tiposDiagnostico = respDiagnostico.Respuesta;
        }
        else if (respDiagnostico.Error)
        {
            Mensaje = respDiagnostico.ObtenerError();
        }

        var respPaciente = await Http.Get<PacienteDTO>(
            $"api/paciente/{Id}"
        );

        if (!respPaciente.Error &&
            respPaciente.Respuesta != null)
        {
            modelo = respPaciente.Respuesta;

            /*
             * Compatibilidad con pacientes que fueron registrados
             * antes de crear la tabla de teléfonos.
             */
            if (modelo.Telefonos.Count == 0 &&
                !string.IsNullOrWhiteSpace(modelo.Telefono))
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = modelo.Telefono,
                    Etiqueta = "Principal"
                });
            }

            if (modelo.Telefonos.Count == 0)
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = string.Empty,
                    Etiqueta = "Paciente"
                });
            }
        }
        else
        {
            modelo = null;
            Mensaje = respPaciente.ObtenerError();
        }

        cargando = false;
    }

    private void AgregarTelefono()
    {
        if (modelo == null)
            return;

        MensajeTelefonos = string.Empty;

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá el teléfono actual antes de agregar otro.";

            return;
        }

        modelo.Telefonos.Add(new PacienteTelefonoDTO
        {
            Numero = string.Empty,
            Etiqueta = string.Empty
        });
    }

    private void EliminarTelefono(PacienteTelefonoDTO telefono)
    {
        if (modelo == null || modelo.Telefonos.Count <= 1)
            return;

        modelo.Telefonos.Remove(telefono);
        MensajeTelefonos = string.Empty;
    }

    private async Task Grabar()
    {
        if (modelo == null)
            return;

        Mensaje = string.Empty;
        MensajeTelefonos = string.Empty;

        if (modelo.FechaNacimiento.HasValue &&
            modelo.FechaNacimiento.Value.Date > DateTime.Today)
        {
            Mensaje =
                "La fecha de nacimiento no puede ser posterior a hoy.";

            return;
        }

        if (modelo.Telefonos.Count == 0)
        {
            MensajeTelefonos =
                "Debe registrar al menos un teléfono.";

            return;
        }

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá la etiqueta y el número de todos los teléfonos.";

            return;
        }

        modelo.Telefono = modelo.Telefonos
            .First()
            .Numero;

        guardando = true;

        var resp = await Http.Put<PacienteDTO, RespuestaDTO>(
            $"api/paciente/{Id}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                $"/pacientes/detalle/{Id}?estado=actualizado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (eliminando)
            return;

        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        MensajeEliminar = string.Empty;

        var resp = await Http.Delete(
            $"api/paciente/{Id}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/pacientes?estado=eliminado"
            );
        }
        else
        {
            MensajeEliminar = resp.ObtenerError();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }

    private void Volver()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }
}