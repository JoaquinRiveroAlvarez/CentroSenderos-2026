@page "/pacientes/editar/{id:int}"
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using CentroSenderos_2026_Shared.DTO
@attribute [Authorize]
@inject IHttpServicio Http
@inject NavigationManager Nav

<div class="editar-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@(guardando || eliminando)"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <h1>Editar Paciente</h1>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="editar-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <!-- SECCIÓN 01: Información Personal -->
            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Fecha de nacimiento</label>

                        <InputDate class="form-input"
                                   @bind-Value="modelo.FechaNacimiento" />

                        <ValidationMessage For="@(() => modelo.FechaNacimiento)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <!-- SECCIÓN 02: Información Médica / Administrativa -->
            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label>Obra Social / Prepaga</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <div class="readonly-number-field">

                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="readonly-number-value">
                                    @modelo.NumeroAfiliado
                                </span>

                                <span class="readonly-number-description">
                                    Asignado automáticamente
                                </span>
                            </div>

                        </div>

                    </div>

                    <div class="field-group">

                        <label>Diagnóstico / Motivo de Consulta</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            @foreach (var diagnostico in tiposDiagnostico)
                            {
                                <option value="@diagnostico.Id">
                                    @diagnostico.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado Único de Discapacidad</label>

                        <label class="cud-option">

                            <InputCheckbox class="cud-checkbox"
                                           @bind-Value="modelo.TieneCud" />

                            <span class="cud-option-content">

                                <span class="cud-option-title">
                                    Tiene CUD
                                </span>

                                <span class="cud-option-description">
                                    Marcar si el paciente posee un CUD vigente.
                                </span>

                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <!-- SECCIÓN 03: Datos de Contacto -->
            <section class="form-section">

                <div class="section-title section-title-actions">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de Contacto</span>
                    </div>

                    <button type="button"
                            class="add-phone-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="AgregarTelefono">
                        <i class="bi bi-plus-lg"></i>
                        Agregar teléfono
                    </button>

                </div>

                <div class="phones-list">

                    @foreach (var telefono in modelo.Telefonos)
                    {
                        <div class="phone-row" @key="telefono">

                            <div class="field-group">

                                <label>Etiqueta</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Etiqueta"
                                           placeholder="Ej.: Paciente, madre o tutor" />

                            </div>

                            <div class="field-group">

                                <label>Número de teléfono</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Numero"
                                           placeholder="Insertar teléfono" />

                            </div>

                            <button type="button"
                                    class="remove-phone-button"
                                    title="Eliminar teléfono"
                                    disabled="@(guardando ||
                                                                                eliminando ||
                                                                                modelo.Telefonos.Count == 1)"
                                    @onclick="() => EliminarTelefono(telefono)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeTelefonos))
                {
                    <div class="phone-validation">
                        @MensajeTelefonos
                    </div>
                }

                <div class="form-grid">
                    <div class="field-group address-field">

                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>
                </div>

            </section>

            <!-- SECCIÓN 04: Documentos y Estudios (Estilo Classroom / Drive) -->
            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">04</span>
                    <span>Documentos y Estudios</span>
                </div>

                <!-- Barra de selección de tipo y dropzone de carga -->
                <div style="display: flex; gap: 14px; align-items: stretch; flex-wrap: wrap; margin-bottom: 20px;">
                    <!-- Selector de tipo de documento -->
                    <div style="min-width: 250px; display: flex; flex-direction: column; justify-content: center;">
                        <label style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #8c8275; margin-bottom: 6px; font-weight: 600;">
                            Tipo de documento
                        </label>
                        <InputSelect @bind-Value="nuevoDocumento.TipoDocumentoId" class="form-input" style="height: 52px; border-radius: 12px;">
                            <option value="0">-- Seleccione tipo --</option>
                            @foreach (var tipo in tiposDocumentos)
                            {
                                <option value="@tipo.Id">@tipo.Tipo</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Tarjeta/Botón de subida de archivo estilo Drive -->
                    <label style="flex: 1; min-width: 280px; min-height: 64px; border: 2px dashed #c8c2b7; border-radius: 14px; background: #faf9f6; display: flex; align-items: center; justify-content: center; gap: 14px; cursor: pointer; padding: 10px 18px; transition: all 0.2s ease;">
                        <i class="bi bi-cloud-arrow-up" style="font-size: 28px; color: #556f4f;"></i>
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-size: 13px; font-weight: 600; color: #3d4a3b;">
                                @(subiendoDocumento ? "Subiendo archivo a la base de datos..." : "Haga clic para cargar documentos")
                            </span>
                            <span style="font-size: 11px; color: #8a847b;">
                                @(subiendoDocumento ? "Por favor espere unos instantes" : "Archivos PDF, fotos de estudios, recetas, CUD, etc.")
                            </span>
                        </div>
                        <InputFile OnChange="SubirDocumento"
                                   disabled="@(subiendoDocumento || guardando || eliminando)"
                                   style="display: none;" />
                    </label>
                </div>

                <!-- Chips compactos de documentos adjuntos -->
                @if (modelo.Documentos != null && modelo.Documentos.Any())
                {
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px;">
                        @foreach (var doc in modelo.Documentos)
                        {
                            <div style="background: #ffffff; border: 1.5px solid #e3e0d8; border-radius: 12px; padding: 9px 14px; display: inline-flex; align-items: center; gap: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.03); max-width: 400px; transition: all 0.15s ease;">

                                <!-- Icono según formato -->
                                <div @onclick="() => AbrirVistaPrevia(doc)"
                                     style="width: 36px; height: 36px; border-radius: 9px; background: #eaf1e9; color: #4e6a47; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; flex-shrink: 0;"
                                     title="Clic para ver vista previa">
                                    @if (EsPdf(doc.NombreGenerado))
                                    {
                                        <i class="bi bi-file-earmark-pdf-fill" style="color: #b54747;"></i>
                                    }
                                    else if (EsImagen(doc.NombreGenerado))
                                    {
                                        <i class="bi bi-file-earmark-image-fill" style="color: #4a7c59;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-text-fill" style="color: #4b6645;"></i>
                                    }
                                </div>

                                <!-- Nombre y Tipo (al hacer clic abre el visor oscuro) -->
                                <div @onclick="() => AbrirVistaPrevia(doc)"
                                     style="cursor: pointer; display: flex; flex-direction: column; overflow: hidden; min-width: 140px; max-width: 220px;"
                                     title="Clic para ver vista previa">
                                    <span style="font-size: 13px; font-weight: 600; color: #2c3329; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                        @doc.NombreGenerado
                                    </span>
                                    <span style="font-size: 11px; color: #7f786d;">
                                        @(string.IsNullOrEmpty(doc.TipoDocumentoNombre) ? "Documento" : doc.TipoDocumentoNombre)
                                    </span>
                                </div>

                                <!-- Botones de acción: Descargar y Eliminar -->
                                <div style="display: flex; align-items: center; gap: 4px; margin-left: auto;">
                                    <a href="/api/documento/descargar/@doc.Id"
                                       download="@doc.NombreGenerado"
                                       style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #50614e; text-decoration: none;"
                                       title="Descargar archivo">
                                        <i class="bi bi-download" style="font-size: 15px;"></i>
                                    </a>
                                    <button type="button"
                                            @onclick="() => SolicitarEliminarDocumento(doc)"
                                            disabled="@(guardando || eliminando || eliminandoDocumento)"
                                            style="width: 32px; height: 32px; border-radius: 8px; border: none; background: transparent; display: flex; align-items: center; justify-content: center; color: #c44d4d; cursor: pointer;"
                                            title="Eliminar documento">
                                        <i class="bi bi-trash3" style="font-size: 15px;"></i>
                                    </button>
                                </div>

                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="padding: 14px 18px; background: #faf9f6; border-radius: 12px; border: 1px dashed #d5d0c7; color: #8a847b; font-size: 13px;">
                        <i class="bi bi-folder-x"></i> Este paciente no tiene documentos ni estudios adjuntos.
                    </div>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="editar-mensaje">
                    @Mensaje
                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        disabled="@(guardando || eliminando)"
                        @onclick="AbrirConfirmacionEliminar">
                    <i class="bi bi-trash"></i>
                    <span>Eliminar Paciente</span>
                </button>

                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Paciente</span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN DE PACIENTE -->
@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>¿Eliminar paciente?</h2>

            <p>
                ¿Estás seguro de que querés eliminar a
                <strong>@modelo?.Nombre</strong>?
                El paciente dejará de aparecer entre los registros activos.
            </p>

            @if (!string.IsNullOrWhiteSpace(MensajeEliminar))
            {
                <div class="delete-error">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>@MensajeEliminar</span>

                </div>
            }

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar paciente</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}

<!-- MODAL DE VISTA PREVIA OSCURECIDA (ESTILO CLASSROOM / GOOGLE DRIVE) -->
@if (documentoVistaPrevia != null)
{
    <div @onclick="CerrarVistaPrevia"
         style="position: fixed; inset: 0; background: rgba(15, 18, 14, 0.82); backdrop-filter: blur(4px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 20px;">

        <div @onclick:stopPropagation="true"
             style="background: #1c211b; border-radius: 16px; width: 92vw; max-width: 1020px; height: 88vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.1);">

            <!-- Barra superior del visor -->
            <div style="padding: 14px 20px; background: #262c24; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.08); color: #fff;">
                <div style="display: flex; align-items: center; gap: 12px; overflow: hidden;">
                    @if (EsPdf(documentoVistaPrevia.NombreGenerado))
                    {
                        <i class="bi bi-file-earmark-pdf-fill" style="font-size: 22px; color: #ef5350;"></i>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-image-fill" style="font-size: 22px; color: #81c784;"></i>
                    }
                    <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <span style="font-size: 14px; font-weight: 600; color: #f1f3f0;">@documentoVistaPrevia.NombreGenerado</span>
                        <span style="margin-left: 8px; font-size: 11px; background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 6px; color: #d0d7cf;">
                            @(string.IsNullOrEmpty(documentoVistaPrevia.TipoDocumentoNombre) ? "Documento" : documentoVistaPrevia.TipoDocumentoNombre)
                        </span>
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <a href="/api/documento/descargar/@documentoVistaPrevia.Id"
                       download="@documentoVistaPrevia.NombreGenerado"
                       style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.14); color: #fff; padding: 7px 14px; border-radius: 8px; font-size: 13px; text-decoration: none; font-weight: 500;"
                       title="Descargar este archivo">
                        <i class="bi bi-download"></i> Descargar
                    </a>
                    <button type="button"
                            @onclick="() => SolicitarEliminarDocumento(documentoVistaPrevia)"
                            disabled="@(guardando || eliminando || eliminandoDocumento)"
                            style="display: inline-flex; align-items: center; gap: 8px; background: rgba(220, 53, 69, 0.25); color: #ff9b9b; padding: 7px 14px; border-radius: 8px; font-size: 13px; border: 1px solid rgba(220, 53, 69, 0.45); cursor: pointer; font-weight: 500;"
                            title="Eliminar este archivo">
                        <i class="bi bi-trash3"></i> Eliminar
                    </button>
                    <button type="button"
                            @onclick="CerrarVistaPrevia"
                            style="background: transparent; border: none; color: #ddd; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px;"
                            title="Cerrar vista previa">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Contenedor central del archivo -->
            <div style="flex: 1; display: flex; align-items: center; justify-content: center; background: #121511; padding: 14px; overflow: hidden;">
                @if (EsPdf(documentoVistaPrevia.NombreGenerado))
                {
                    <iframe src="/api/documento/ver/@documentoVistaPrevia.Id" style="width: 100%; height: 100%; border: none; border-radius: 8px; background: #fff;"></iframe>
                }
                else
                {
                    <img src="/api/documento/ver/@documentoVistaPrevia.Id"
                         alt="@documentoVistaPrevia.NombreGenerado"
                         style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.6);" />
                }
            </div>

        </div>
    </div>
}

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN DE DOCUMENTO -->
@if (documentoAEliminar != null)
{
    <div class="modal-overlay" style="z-index: 100000;" @onclick="CancelarEliminarDocumento">

        <div class="delete-modal" @onclick:stopPropagation="true">

            <div class="delete-warning-icon">
                <i class="bi bi-trash3-fill"></i>
            </div>

            <h2>¿Eliminar documento?</h2>

            <p>
                ¿Estás seguro de que querés eliminar el documento
                <strong style="display: block; margin: 10px 0; color: #2e382d; word-break: break-all; font-size: 13px; background: #f3f0e8; padding: 8px 12px; border-radius: 8px; border: 1px solid #dfdad0;">
                    "@documentoAEliminar.NombreGenerado"
                </strong>
                Esta acción no se puede deshacer.
            </p>

            @if (!string.IsNullOrWhiteSpace(MensajeEliminarDocumento))
            {
                <div class="delete-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@MensajeEliminarDocumento</span>
                </div>
            }

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminandoDocumento"
                        @onclick="ConfirmarEliminarDocumento">

                    @if (eliminandoDocumento)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar documento</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminandoDocumento"
                        @onclick="CancelarEliminarDocumento">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private PacienteDTO? modelo;

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string MensajeTelefonos = string.Empty;
    private string MensajeEliminar = string.Empty;

    private List<TipoDocumentoDTO> tiposDocumentos = new();
    private DocumentoDTO nuevoDocumento = new();

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();

    private bool subiendoDocumento = false;
    private DocumentoDTO? documentoVistaPrevia;
    private DocumentoDTO? documentoAEliminar;
    private bool eliminandoDocumento = false;
    private string MensajeEliminarDocumento = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respuesta = await Http.Get<List<TipoDocumentoDTO>>("api/documento/tipos");

        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            tiposDocumentos = respuesta.Respuesta;
        }
        else if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
        }

        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }

        var respDiagnostico = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiagnostico.Error &&
            respDiagnostico.Respuesta != null)
        {
            tiposDiagnostico = respDiagnostico.Respuesta;
        }
        else if (respDiagnostico.Error)
        {
            Mensaje = respDiagnostico.ObtenerError();
        }

        var respPaciente = await Http.Get<PacienteDTO>(
            $"api/paciente/{Id}"
        );

        if (!respPaciente.Error &&
            respPaciente.Respuesta != null)
        {
            modelo = respPaciente.Respuesta;

            /*
             * Compatibilidad con pacientes que fueron registrados
             * antes de crear la tabla de teléfonos.
             */
            if (modelo.Telefonos.Count == 0 &&
                !string.IsNullOrWhiteSpace(modelo.Telefono))
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = modelo.Telefono,
                    Etiqueta = "Principal"
                });
            }

            if (modelo.Telefonos.Count == 0)
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = string.Empty,
                    Etiqueta = "Paciente"
                });
            }
        }
        else
        {
            modelo = null;
            Mensaje = respPaciente.ObtenerError();
        }

        cargando = false;
    }

    private void AbrirVistaPrevia(DocumentoDTO doc)
    {
        documentoVistaPrevia = doc;
    }

    private void CerrarVistaPrevia()
    {
        documentoVistaPrevia = null;
    }

    private static bool EsPdf(string? nombre)
    {
        return !string.IsNullOrEmpty(nombre) && nombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static bool EsImagen(string? nombre)
    {
        return !string.IsNullOrEmpty(nombre) && (
            nombre.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
            nombre.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
            nombre.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
            nombre.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)
        );
    }

    private void SolicitarEliminarDocumento(DocumentoDTO? doc)
    {
        if (doc == null) return;
        documentoAEliminar = doc;
        MensajeEliminarDocumento = string.Empty;
    }

    private void CancelarEliminarDocumento()
    {
        if (eliminandoDocumento)
            return;

        documentoAEliminar = null;
        MensajeEliminarDocumento = string.Empty;
    }

    private async Task ConfirmarEliminarDocumento()
    {
        if (documentoAEliminar == null)
            return;

        eliminandoDocumento = true;
        MensajeEliminarDocumento = string.Empty;

        var idAEliminar = documentoAEliminar.Id;
        var resp = await Http.Delete($"api/documento/{idAEliminar}");

        eliminandoDocumento = false;

        if (!resp.Error)
        {
            modelo?.Documentos.RemoveAll(d => d.Id == idAEliminar);
            if (documentoVistaPrevia?.Id == idAEliminar)
            {
                documentoVistaPrevia = null;
            }
            documentoAEliminar = null;
        }
        else
        {
            MensajeEliminarDocumento = resp.ObtenerError();
        }
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (nuevoDocumento.TipoDocumentoId <= 0)
        {
            Mensaje = "Debe seleccionar un tipo de documento antes de subir.";
            return;
        }

        try
        {
            subiendoDocumento = true;
            Mensaje = string.Empty;

            var file = e.File;
            // Leer el archivo a memoria primero para evitar contención de streams en el circuito SignalR
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(bytes);
            if (!string.IsNullOrWhiteSpace(file.ContentType))
            {
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            }
            content.Add(fileContent, "archivo", file.Name);
            content.Add(new StringContent(modelo!.Id.ToString()), "pacienteId");
            content.Add(new StringContent(nuevoDocumento.TipoDocumentoId.ToString()), "tipoDocumentoId");

            var resp = await Http.PostMultipart<DocumentoDTO>("api/documento/insertar", content);
            if (!resp.Error && resp.Respuesta != null)
            {
                modelo.Documentos.Add(resp.Respuesta);
                nuevoDocumento.TipoDocumentoId = 0; // Reinicia el selector
            }
            else
            {
                Mensaje = resp.ObtenerError();
            }
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al procesar el archivo: {ex.Message}";
        }
        finally
        {
            subiendoDocumento = false;
        }
    }

    private void AgregarTelefono()
    {
        if (modelo == null)
            return;

        MensajeTelefonos = string.Empty;

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá el teléfono actual antes de agregar otro.";

            return;
        }

        modelo.Telefonos.Add(new PacienteTelefonoDTO
        {
            Numero = string.Empty,
            Etiqueta = string.Empty
        });
    }

    private void EliminarTelefono(PacienteTelefonoDTO telefono)
    {
        if (modelo == null || modelo.Telefonos.Count <= 1)
            return;

        modelo.Telefonos.Remove(telefono);
        MensajeTelefonos = string.Empty;
    }

    private async Task Grabar()
    {
        if (modelo == null)
            return;

        Mensaje = string.Empty;
        MensajeTelefonos = string.Empty;

        if (modelo.FechaNacimiento.HasValue &&
            modelo.FechaNacimiento.Value.Date > DateTime.Today)
        {
            Mensaje =
                "La fecha de nacimiento no puede ser posterior a hoy.";

            return;
        }

        if (modelo.Telefonos.Count == 0)
        {
            MensajeTelefonos =
                "Debe registrar al menos un teléfono.";

            return;
        }

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá la etiqueta y el número de todos los teléfonos.";

            return;
        }

        modelo.Telefono = modelo.Telefonos
            .First()
            .Numero;

        guardando = true;

        var resp = await Http.Put<PacienteDTO, RespuestaDTO>(
            $"api/paciente/{Id}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                $"/pacientes/detalle/{Id}?estado=actualizado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (eliminando)
            return;

        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        MensajeEliminar = string.Empty;

        var resp = await Http.Delete(
            $"api/paciente/{Id}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/pacientes?estado=eliminado"
            );
        }
        else
        {
            MensajeEliminar = resp.ObtenerError();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }

    private void Volver()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }
}