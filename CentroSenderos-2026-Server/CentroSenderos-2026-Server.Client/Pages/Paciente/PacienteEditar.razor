@page "/pacientes/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto


<div class="editar-paciente-page">

    <!-- =========================================
         VOLVER
    ========================================== -->

    <button type="button"
            class="back-button"
            disabled="@(guardando || eliminando)"
            @onclick="Volver">

        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>

    </button>


    <h1>Editar Paciente</h1>


    <!-- =========================================
         CARGANDO
    ========================================== -->
    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="editar-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />


            <!-- =========================================
                 01 - INFORMACIÓN PERSONAL
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>


                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 02 - INFORMACIÓN MÉDICA
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>


                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Obra Social / Prepaga</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <InputNumber class="form-input"
                                     @bind-Value="modelo.NumeroAfiliado"
                                     placeholder="Nro. afiliado" />

                        <ValidationMessage For="@(() => modelo.NumeroAfiliado)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>Diagnóstico / Motivo de Consulta</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            @foreach (var diag in tiposDiagnostico)
                            {
                                <option value="@diag.Id">
                                    @diag.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 03 - DATOS DE CONTACTO
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>


                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Teléfono</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Telefono"
                                   placeholder="Teléfono" />

                        <ValidationMessage For="@(() => modelo.Telefono)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 ERROR GENERAL
            ========================================== -->
            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="editar-mensaje">
                    @Mensaje
                </div>
            }


            <!-- =========================================
                 ACCIONES
            ========================================== -->

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        disabled="@(guardando || eliminando)"
                        @onclick="AbrirConfirmacionEliminar">

                    <i class="bi bi-trash"></i>
                    <span>Eliminar Paciente</span>

                </button>


                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="Cancelar">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Paciente</span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>


<!-- =========================================
     MODAL ELIMINAR
========================================== -->
@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>


            <h2>¿Eliminar paciente?</h2>


            <p>
                ¿Estás seguro de que querés eliminar a
                <strong>@modelo?.Nombre</strong>?
                El paciente dejará de aparecer entre los registros activos.
            </p>


            @if (!string.IsNullOrWhiteSpace(MensajeEliminar))
            {
                <div class="delete-error">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>
                        @MensajeEliminar
                    </span>

                </div>
            }


            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar paciente</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public int Id { get; set; }


    private PacienteDTO? modelo;


    private bool cargando = true;
    private bool guardando = false;
    private bool eliminando = false;
    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = "";
    private string MensajeEliminar = "";


    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();


    // CARGAR DATOS

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = "";


        // Obras sociales
        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }


        // Diagnósticos
        var respDiag = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiag.Error && respDiag.Respuesta != null)
        {
            tiposDiagnostico = respDiag.Respuesta;
        }
        else if (respDiag.Error)
        {
            Mensaje = respDiag.ObtenerError();
        }


        // Paciente
        var respPac = await Http.Get<PacienteDTO>(
            $"api/paciente/{Id}"
        );

        if (!respPac.Error && respPac.Respuesta != null)
        {
            modelo = respPac.Respuesta;
        }
        else
        {
            modelo = null;
            Mensaje = respPac.ObtenerError();
        }


        cargando = false;
    }


    // GUARDAR

    private async Task Grabar()
    {
        if (modelo == null)
            return;


        guardando = true;
        Mensaje = "";


        var resp = await Http.Put<PacienteDTO, RespuestaDTO>(
            $"api/paciente/{Id}",
            modelo
        );


        guardando = false;


        if (!resp.Error)
        {
            Nav.NavigateTo(
                $"/pacientes/detalle/{Id}?estado=actualizado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // ABRIR MODAL ELIMINAR

    private void AbrirConfirmacionEliminar()
    {
        MensajeEliminar = "";
        mostrarConfirmacionEliminar = true;
    }


    // CERRAR MODAL ELIMINAR

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            MensajeEliminar = "";
            mostrarConfirmacionEliminar = false;
        }
    }


    // ELIMINAR

    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        MensajeEliminar = "";


        var resp = await Http.Delete(
            $"api/paciente/{Id}"
        );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/pacientes?estado=eliminado"
            );
        }
        else
        {
            MensajeEliminar = resp.ObtenerError();
        }
    }


    // CANCELAR

    private void Cancelar()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }


    // VOLVER

    private void Volver()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }

}