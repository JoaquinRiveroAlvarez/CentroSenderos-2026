@page "/pacientes/editar/{id:int}"
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using CentroSenderos_2026_Shared.DTO
@attribute [Authorize]
@inject IHttpServicio Http
@inject NavigationManager Nav

<div class="editar-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@(guardando || eliminando)"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <h1>Editar Paciente</h1>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="editar-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Fecha de nacimiento</label>

                        <InputDate class="form-input"
                                   @bind-Value="modelo.FechaNacimiento" />

                        <ValidationMessage For="@(() => modelo.FechaNacimiento)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label>Obra Social / Prepaga</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <div class="readonly-number-field">

                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="readonly-number-value">
                                    @modelo.NumeroAfiliado
                                </span>

                                <span class="readonly-number-description">
                                    Asignado automáticamente
                                </span>
                            </div>

                        </div>

                    </div>

                    <div class="field-group">

                        <label>Diagnóstico / Motivo de Consulta</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            @foreach (var diagnostico in tiposDiagnostico)
                            {
                                <option value="@diagnostico.Id">
                                    @diagnostico.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado Único de Discapacidad</label>

                        <label class="cud-option">

                            <InputCheckbox class="cud-checkbox"
                                           @bind-Value="modelo.TieneCud" />

                            <span class="cud-option-content">

                                <span class="cud-option-title">
                                    Tiene CUD
                                </span>

                                <span class="cud-option-description">
                                    Marcar si el paciente posee un CUD vigente.
                                </span>

                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">04</span>
                    <span>Documentos y Estudios</span>
                </div>

                <!-- Controles de selección y subida -->
                <div class="document-upload-bar" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px;">
                    <!-- Selector de tipo de documento -->
                    <InputSelect @bind-Value="nuevoDocumento.TipoDocumentoId" class="form-input" style="max-width: 280px;">
                        <option value="0">-- Seleccione tipo de documento --</option>
                        @foreach (var tipo in tiposDocumentos)
                        {
                            <option value="@tipo.Id">@tipo.Tipo</option>
                        }
                    </InputSelect>

                    <!-- Subida de archivo (con límite de tamaño ampliado) -->
                    <div style="position: relative;">
                        <InputFile OnChange="SubirDocumento"
                                   disabled="@(subiendoDocumento || guardando || eliminando)"
                                   class="form-input" />
                    </div>

                    @if (subiendoDocumento)
                    {
                        <span style="font-size: 13px; color: #556f4f; font-weight: 500;">
                            <i class="bi bi-hourglass-split"></i> Subiendo archivo a la base de datos...
                        </span>
                    }
                </div>

                <!-- Listado de documentos del paciente -->
                @if (modelo.Documentos != null && modelo.Documentos.Any())
                {
                    <ul class="document-list" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px;">
                        @foreach (var doc in modelo.Documentos)
                        {
                            <li style="border: 1px solid #e4e1dc; border-radius: 12px; padding: 14px 18px; background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 8px;">
                                    <div>
                                        <strong style="color: #2b3a2a; font-size: 14px;">@doc.NombreGenerado</strong>
                                        <span class="doc-type" style="margin-left: 8px; font-size: 12px; background: #f0eee9; padding: 3px 8px; border-radius: 6px; color: #736c64;">
                                            @(string.IsNullOrEmpty(doc.TipoDocumentoNombre) ? "Sin tipo" : doc.TipoDocumentoNombre)
                                        </span>
                                    </div>

                                    <!-- Acciones (con barra inicial / para que la ruta sea absoluta) -->
                                    <div style="display: flex; gap: 10px; align-items: center;">
                                        <a href="/api/documento/ver/@doc.Id" target="_blank" class="btn-link" style="color: #556f4f; text-decoration: none; font-size: 13px; font-weight: 600;">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <a href="/api/documento/descargar/@doc.Id" download="@doc.NombreGenerado" class="btn-link" style="color: #3b5b75; text-decoration: none; font-size: 13px; font-weight: 600;">
                                            <i class="bi bi-download"></i> Descargar
                                        </a>
                                        <button type="button"
                                                @onclick="() => EliminarDocumento(doc.Id)"
                                                disabled="@(guardando || eliminando)"
                                                style="background: transparent; border: none; color: #b94a48; cursor: pointer; font-size: 13px; font-weight: 600;">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>

                                <!-- Vista previa embebida en base al archivo -->
                                @if (doc.NombreGenerado.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div style="margin-top: 10px; border-radius: 8px; overflow: hidden; border: 1px solid #eee;">
                                        <iframe src="/api/documento/ver/@doc.Id" width="100%" height="320" style="border: none;"></iframe>
                                    </div>
                                }
                                else if (doc.NombreGenerado.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                         doc.NombreGenerado.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                         doc.NombreGenerado.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div style="margin-top: 10px;">
                                        <img src="/api/documento/ver/@doc.Id" alt="@doc.NombreGenerado" style="max-width: 280px; max-height: 220px; border-radius: 8px; border: 1px solid #ddd; object-fit: contain;" />
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div style="padding: 14px 16px; background: #faf9f6; border-radius: 10px; border: 1px dashed #d5d0c7; color: #8a847b; font-size: 13px;">
                        <i class="bi bi-folder-x"></i> Este paciente no tiene documentos ni estudios adjuntos.
                    </div>
                }
            </section>

            <section class="form-section">

                <div class="section-title section-title-actions">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de Contacto</span>
                    </div>

                    <button type="button"
                            class="add-phone-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="AgregarTelefono">
                        <i class="bi bi-plus-lg"></i>
                        Agregar teléfono
                    </button>

                </div>

                <div class="phones-list">

                    @foreach (var telefono in modelo.Telefonos)
                    {
                        <div class="phone-row" @key="telefono">

                            <div class="field-group">

                                <label>Etiqueta</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Etiqueta"
                                           placeholder="Ej.: Paciente, madre o tutor" />

                            </div>

                            <div class="field-group">

                                <label>Número de teléfono</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Numero"
                                           placeholder="Insertar teléfono" />

                            </div>

                            <button type="button"
                                    class="remove-phone-button"
                                    title="Eliminar teléfono"
                                    disabled="@(guardando ||
                                                                                eliminando ||
                                                                                modelo.Telefonos.Count == 1)"
                                    @onclick="() => EliminarTelefono(telefono)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeTelefonos))
                {
                    <div class="phone-validation">
                        @MensajeTelefonos
                    </div>
                }

                <div class="form-grid">
                    <div class="field-group address-field">

                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>
                </div>

            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="editar-mensaje">
                    @Mensaje
                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        disabled="@(guardando || eliminando)"
                        @onclick="AbrirConfirmacionEliminar">
                    <i class="bi bi-trash"></i>
                    <span>Eliminar Paciente</span>
                </button>

                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Paciente</span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>¿Eliminar paciente?</h2>

            <p>
                ¿Estás seguro de que querés eliminar a
                <strong>@modelo?.Nombre</strong>?
                El paciente dejará de aparecer entre los registros activos.
            </p>

            @if (!string.IsNullOrWhiteSpace(MensajeEliminar))
            {
                <div class="delete-error">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>@MensajeEliminar</span>

                </div>
            }

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar paciente</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private PacienteDTO? modelo;

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string MensajeTelefonos = string.Empty;
    private string MensajeEliminar = string.Empty;

    private List<TipoDocumentoDTO> tiposDocumentos = new();
    private DocumentoDTO nuevoDocumento = new();

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respuesta = await Http.Get<List<TipoDocumentoDTO>>("api/documento/tipos");

        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            tiposDocumentos = respuesta.Respuesta;
        }
        else if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
        }

        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }

        var respDiagnostico = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiagnostico.Error &&
            respDiagnostico.Respuesta != null)
        {
            tiposDiagnostico = respDiagnostico.Respuesta;
        }
        else if (respDiagnostico.Error)
        {
            Mensaje = respDiagnostico.ObtenerError();
        }

        var respPaciente = await Http.Get<PacienteDTO>(
            $"api/paciente/{Id}"
        );

        if (!respPaciente.Error &&
            respPaciente.Respuesta != null)
        {
            modelo = respPaciente.Respuesta;

            /*
             * Compatibilidad con pacientes que fueron registrados
             * antes de crear la tabla de teléfonos.
             */
            if (modelo.Telefonos.Count == 0 &&
                !string.IsNullOrWhiteSpace(modelo.Telefono))
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = modelo.Telefono,
                    Etiqueta = "Principal"
                });
            }

            if (modelo.Telefonos.Count == 0)
            {
                modelo.Telefonos.Add(new PacienteTelefonoDTO
                {
                    Numero = string.Empty,
                    Etiqueta = "Paciente"
                });
            }
        }
        else
        {
            modelo = null;
            Mensaje = respPaciente.ObtenerError();
        }

        cargando = false;
    }
    private async Task EliminarDocumento(int id)
    {
        var resp = await Http.Delete($"api/documento/{id}");
        if (!resp.Error)
        {
            modelo?.Documentos.RemoveAll(d => d.Id == id);
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private bool subiendoDocumento = false;

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (nuevoDocumento.TipoDocumentoId <= 0)
        {
            Mensaje = "Debe seleccionar un tipo de documento antes de subir.";
            return;
        }

        try
        {
            subiendoDocumento = true;
            Mensaje = string.Empty;

            var file = e.File;

            // 1. Leemos el archivo en memoria (máx 20 MB) para que SignalR lo reciba limpiamente
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();

            // 2. Preparamos el contenido como ByteArrayContent
            var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(bytes);
            if (!string.IsNullOrWhiteSpace(file.ContentType))
            {
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            }
            content.Add(fileContent, "archivo", file.Name);
            content.Add(new StringContent(modelo!.Id.ToString()), "pacienteId");
            content.Add(new StringContent(nuevoDocumento.TipoDocumentoId.ToString()), "tipoDocumentoId");

            // 3. Enviamos a la API
            var resp = await Http.PostMultipart<DocumentoDTO>("api/documento/insertar", content);
            if (!resp.Error && resp.Respuesta != null)
            {
                modelo.Documentos.Add(resp.Respuesta);
                nuevoDocumento.TipoDocumentoId = 0; // Reinicia el selector
            }
            else
            {
                Mensaje = resp.ObtenerError();
            }
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al procesar el archivo: {ex.Message}";
        }
        finally
        {
            subiendoDocumento = false;
        }
    }



    private void AgregarTelefono()
    {
        if (modelo == null)
            return;

        MensajeTelefonos = string.Empty;

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá el teléfono actual antes de agregar otro.";

            return;
        }

        modelo.Telefonos.Add(new PacienteTelefonoDTO
        {
            Numero = string.Empty,
            Etiqueta = string.Empty
        });
    }

    private void EliminarTelefono(PacienteTelefonoDTO telefono)
    {
        if (modelo == null || modelo.Telefonos.Count <= 1)
            return;

        modelo.Telefonos.Remove(telefono);
        MensajeTelefonos = string.Empty;
    }

    private async Task Grabar()
    {
        if (modelo == null)
            return;

        Mensaje = string.Empty;
        MensajeTelefonos = string.Empty;

        if (modelo.FechaNacimiento.HasValue &&
            modelo.FechaNacimiento.Value.Date > DateTime.Today)
        {
            Mensaje =
                "La fecha de nacimiento no puede ser posterior a hoy.";

            return;
        }

        if (modelo.Telefonos.Count == 0)
        {
            MensajeTelefonos =
                "Debe registrar al menos un teléfono.";

            return;
        }

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá la etiqueta y el número de todos los teléfonos.";

            return;
        }

        modelo.Telefono = modelo.Telefonos
            .First()
            .Numero;

        guardando = true;

        var resp = await Http.Put<PacienteDTO, RespuestaDTO>(
            $"api/paciente/{Id}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                $"/pacientes/detalle/{Id}?estado=actualizado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (eliminando)
            return;

        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        MensajeEliminar = string.Empty;

        var resp = await Http.Delete(
            $"api/paciente/{Id}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/pacientes?estado=eliminado"
            );
        }
        else
        {
            MensajeEliminar = resp.ObtenerError();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }

    private void Volver()
    {
        Nav.NavigateTo(
            $"/pacientes/detalle/{Id}"
        );
    }
}