@page "/pacientes/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto


<div class="editar-paciente-page">

    <h1>Editar Paciente</h1>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="editar-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />

            <!-- =========================================
                 01 - INFORMACIÓN PERSONAL
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-2">

                    <div class="field-group">
                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />
                    </div>

                    <div class="field-group">
                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />
                    </div>

                </div>

            </section>


            <!-- =========================================
                 02 - INFORMACIÓN MÉDICA
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">
                        <label>Obra Social / Prepaga</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>
                    </div>


                    <div class="field-group">
                        <label>Nro. Afiliado</label>

                        <InputNumber class="form-input"
                                     @bind-Value="modelo.NumeroAfiliado"
                                     placeholder="Nro. afiliado" />

                        <ValidationMessage For="@(() => modelo.NumeroAfiliado)"
                                           class="validation-message" />
                    </div>


                    <div class="field-group">
                        <label>Diagnóstico / Motivo de Consulta</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            @foreach (var diag in tiposDiagnostico)
                            {
                                <option value="@diag.Id">
                                    @diag.Tipo
                                </option>
                            }

                        </InputSelect>
                    </div>

                </div>

            </section>


            <!-- =========================================
                 03 - DATOS DE CONTACTO
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>

                <div class="form-grid form-grid-2">

                    <div class="field-group">
                        <label>Teléfono</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Telefono"
                                   placeholder="Teléfono" />
                    </div>

                    <div class="field-group">
                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Domicilio" />
                    </div>

                </div>

            </section>


            <!-- =========================================
                 ACCIONES
            ========================================== -->

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        @onclick="AbrirConfirmacionEliminar">
                    Eliminar Paciente
                </button>

                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button">
                        Guardar Paciente
                    </button>

                </div>

            </div>

        </EditForm>
    }

    @if (mostrarConfirmacionEliminar)
    {
        <div class="modal-overlay">

            <div class="delete-modal">

                <div class="delete-warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <h2>¿Estás seguro que querés eliminar?</h2>

                <p>
                    Por favor, confirmá que deseás eliminar definitivamente
                    este paciente.
                </p>

                <div class="delete-modal-actions">

                    <button type="button"
                            class="confirm-delete-button"
                            @onclick="ConfirmarEliminar">
                        Eliminar
                    </button>

                    <button type="button"
                            class="modal-cancel-button"
                            @onclick="CerrarConfirmacionEliminar">
                        Cancelar
                    </button>

                </div>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <p class="editar-mensaje">
            @Mensaje
        </p>
    }

</div>

<p>@Mensaje</p>

@code {
    [Parameter]
    public int Id { get; set; }

    private PacienteDTO? modelo;
    private bool cargando = true;
    private string Mensaje = "";

    private bool mostrarConfirmacionEliminar = false;

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = false;
    }
    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        // cargar listas
        var respObra = await Http.Get<List<TipoDTO>>("api/tipoobrasocial/ListaTipoObraSocial");
        if (!respObra.Error && respObra.Respuesta != null)
            tiposObraSocial = respObra.Respuesta;

        var respDiag = await Http.Get<List<TipoDTO>>("api/tipodiagnostico/ListaTipoDiagnostico");
        if (!respDiag.Error && respDiag.Respuesta != null)
            tiposDiagnostico = respDiag.Respuesta;

        // cargar paciente
        var respPac = await Http.Get<PacienteDTO>($"api/paciente/{Id}");
        if (!respPac.Error)
            modelo = respPac.Respuesta;
        else
            Mensaje = respPac.ObtenerError();
        await Task.Delay(200);
        cargando = false;
    }

    private async Task Grabar()
    {
        if (modelo == null) return;

        var resp = await Http.Put<PacienteDTO, RespuestaDTO>($"api/paciente/{Id}", modelo);
        Mensaje = resp.Error ? resp.ObtenerError() : resp.Respuesta?.mensaje!;

        if (!resp.Error)
        {
            await Task.Delay(500);
            Nav.NavigateTo("/pacientes", true);
        }
    }

    private async Task ConfirmarEliminar()
    {
        var resp = await Http.Delete($"api/paciente/{Id}");

        Mensaje = resp.Error
            ? resp.ObtenerError()
            : "Paciente eliminado correctamente.";

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            await Task.Delay(500);

            Nav.NavigateTo("/pacientes", true);
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/pacientes");
    }
}
