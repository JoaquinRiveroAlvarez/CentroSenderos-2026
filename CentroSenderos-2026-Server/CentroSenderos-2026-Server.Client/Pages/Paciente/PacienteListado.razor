@page "/pacientes"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<h3>Listado de Pacientes</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="IrACrear">Nuevo Paciente</button>
</div>

@if (cargando)
{
    <p>Cargando Pacientes...</p>
}
else if (listaPacientes == null || listaPacientes.Count == 0)
{
    <p>No hay pacientes registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>DNI</th>
                <th>Nro Afiliado</th>
                <th>Diagnóstico</th>
                <th>Obra Social</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paciente in listaPacientes)
            {
                <tr style="cursor:pointer" @onclick="() => IrAEditar(paciente.Id)">
                    <td>@paciente.Nombre</td>
                    <td>@paciente.DNI</td>
                    <td>@paciente.NumeroAfiliado</td>
                    <td>@paciente.TipoDiagnosticoNombre</td>
                    <td>@paciente.TipoObraSocialNombre</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>@Mensaje</p>

@code {
    private List<PacienteResumenDTO> listaPacientes = new();
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargando = true;
        var resp = await Http.Get<List<PacienteResumenDTO>>("api/paciente/ListaPaciente");
        listaPacientes = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        await Task.Delay(200);
        cargando = false;
    }

    private void IrAEditar(int id)
    {
        Nav.NavigateTo($"/pacientes/editar/{id}");
    }

    private void IrACrear()
    {
        Nav.NavigateTo("/pacientes/crear");
    }
}
