@page "/pacientes"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="pacientes-header">

    <h1>Gestión de Pacientes</h1>

    <div class="pacientes-actions">

        <div class="search-box">
            <i class="bi bi-search"></i>

            <input type="text"
                   placeholder="Buscar paciente..."
                   @bind="busqueda"
                   @bind:event="oninput" />
        </div>

        <button class="filter-button">
            <i class="bi bi-funnel"></i>
            <span>Filtros</span>
        </button>

        <button class="new-patient-button"
                @onclick="IrACrear">

            <i class="bi bi-person-plus"></i>
            <span>Nuevo Paciente</span>

        </button>

    </div>

</div>

@if (cargando)
{
    <div class="pacientes-loading">
        <span>Cargando pacientes...</span>
    </div>
}
else if (listaPacientes == null || listaPacientes.Count == 0)
{
    <p class="pacientes-mensaje">
        No hay pacientes registrados.
    </p>
}
    else
    {
        <div class="pacientes-card">

            <div class="pacientes-table-wrapper">

                <table class="pacientes-table">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>DNI</th>
                            <th>Nro. Afiliado</th>
                            <th>Diagnóstico</th>
                            <th>Obra Social</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var paciente in PacientesFiltrados)
                        {
                            <tr @onclick="() => IrAEditar(paciente.Id)">

                            <td class="paciente-nombre">
                                @paciente.Nombre
                            </td>

                                <td>
                                    @paciente.DNI
                                </td>

                                <td>
                                    @paciente.NumeroAfiliado
                                </td>

                                <td>
                                    @paciente.TipoDiagnosticoNombre
                                </td>

                                <td>
                                    @paciente.TipoObraSocialNombre
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }


<p>@Mensaje</p>

@code {
    private List<PacienteResumenDTO> listaPacientes = new();
    private bool cargando = true;
    private string Mensaje = "";

    private string busqueda = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargando = true;
        var resp = await Http.Get<List<PacienteResumenDTO>>("api/paciente/ListaPaciente");
        listaPacientes = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        await Task.Delay(200);
        cargando = false;
    }

    private void IrAEditar(int id)
    {
        Nav.NavigateTo($"/pacientes/editar/{id}");
    }

    private void IrACrear()
    {
        Nav.NavigateTo("/pacientes/crear");
    }


    private IEnumerable<PacienteResumenDTO> PacientesFiltrados =>
    string.IsNullOrWhiteSpace(busqueda)
        ? listaPacientes
        : listaPacientes.Where(p =>
            (p.Nombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.DNI?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.NumeroAfiliado.ToString().Contains(busqueda, StringComparison.OrdinalIgnoreCase)) ||
            (p.TipoDiagnosticoNombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.TipoObraSocialNombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false)
        );

}
