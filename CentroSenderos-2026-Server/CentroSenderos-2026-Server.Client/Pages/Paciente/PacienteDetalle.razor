@page "/pacientes/detalle/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="detalle-paciente-page">

    <button type="button"
            class="back-button"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver a Pacientes</span>
    </button>

    <h1>Detalle Paciente</h1>

    @if (Estado == "creado")
    {
        <div class="success-message">

            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Paciente registrado</strong>
                <span>El paciente fue registrado correctamente.</span>
            </div>

        </div>
    }
    else if (Estado == "actualizado")
    {
        <div class="success-message">

            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Paciente actualizado</strong>
                <span>Los cambios se guardaron correctamente.</span>
            </div>

        </div>
    }

    @if (cargando)
    {
        <div class="detalle-loading">
            Cargando datos del paciente...
        </div>
    }
    else if (modelo == null)
    {
        <div class="detalle-mensaje">
            No se encontró el paciente.
        </div>
    }
    else
    {
        <div class="paciente-form">

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <div class="form-input read-only-field">
                            @MostrarValor(modelo.Nombre)
                        </div>

                    </div>

                    <div class="field-group">

                        <label>DNI</label>

                        <div class="form-input read-only-field">
                            @MostrarValor(modelo.DNI)
                        </div>

                    </div>

                    <div class="field-group">

                        <label>Fecha de nacimiento</label>

                        <div class="form-input read-only-field">
                            @MostrarFecha(modelo.FechaNacimiento)
                        </div>

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label>Obra Social / Prepaga</label>

                        <div class="form-input read-only-field">
                            @MostrarValor(modelo.TipoObraSocialNombre)
                        </div>

                    </div>

                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <div class="automatic-field">

                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="automatic-field-title">
                                    N.º @modelo.NumeroAfiliado
                                </span>

                                <span class="automatic-field-description">
                                    Asignado automáticamente
                                </span>
                            </div>

                        </div>

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado Único de Discapacidad</label>

                        <div class="cud-option read-only-option">

                            <input type="checkbox"
                                   class="cud-checkbox"
                                   checked="@modelo.TieneCud"
                                   disabled />

                            <span class="cud-option-content">

                                <span class="cud-option-title">
                                    @(modelo.TieneCud
                                        ? "Tiene CUD"
                                        : "No tiene CUD")
                                </span>

                                <span class="cud-option-description">
                                    Registro informado manualmente
                                </span>

                            </span>

                        </div>

                    </div>

                    <div class="field-group">

                        <label>Diagnóstico / Motivo de Consulta</label>

                        <div class="form-input read-only-field">
                            @MostrarValor(modelo.TipoDiagnosticoNombre)
                        </div>

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de Contacto</span>
                    </div>

                </div>

                <div class="phones-list">

                    @if (TelefonosAMostrar.Any())
                    {
                        @foreach (var telefono in TelefonosAMostrar)
                        {
                            <div class="phone-row"
                                 @key="telefono">

                                <div class="field-group">

                                    <label>Etiqueta</label>

                                    <div class="form-input read-only-field">
                                        @MostrarValor(telefono.Etiqueta)
                                    </div>

                                </div>

                                <div class="field-group">

                                    <label>Número de teléfono</label>

                                    <div class="form-input read-only-field">
                                        @MostrarValor(telefono.Numero)
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-phones">
                            No hay teléfonos registrados.
                        </div>
                    }

                </div>

                <div class="form-grid form-grid-2 contact-address">

                    <div class="field-group">

                        <label>Domicilio</label>

                        <div class="form-input read-only-field">
                            @MostrarValor(modelo.Domicilio)
                        </div>

                    </div>

                </div>

            </section>

            <div class="form-actions detail-actions">

                <button type="button"
                        class="edit-button"
                        @onclick="Editar">
                    <i class="bi bi-pencil-square"></i>
                    <span>Editar Paciente</span>
                </button>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="detalle-mensaje">
            @Mensaje
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    private PacienteDTO? modelo;

    private bool cargando = true;
    private string Mensaje = string.Empty;

    private IEnumerable<PacienteTelefonoDTO> TelefonosAMostrar
    {
        get
        {
            if (modelo?.Telefonos != null &&
                modelo.Telefonos.Count > 0)
            {
                return modelo.Telefonos;
            }

            /*
             * Compatibilidad con pacientes registrados antes
             * de crear la tabla PacienteTelefonos.
             */
            if (!string.IsNullOrWhiteSpace(modelo?.Telefono))
            {
                return new List<PacienteTelefonoDTO>
                {
                    new()
                    {
                        Etiqueta = "Principal",
                        Numero = modelo.Telefono
                    }
                };
            }

            return Enumerable.Empty<PacienteTelefonoDTO>();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var resp = await Http.Get<PacienteDTO>(
            $"api/paciente/{Id}"
        );

        if (!resp.Error && resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            modelo = null;
            Mensaje = resp.ObtenerError();
        }

        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender &&
            (Estado == "creado" || Estado == "actualizado"))
        {
            await Task.Delay(5000);

            Nav.NavigateTo(
                $"/pacientes/detalle/{Id}",
                replace: true
            );
        }
    }

    private void Editar()
    {
        Nav.NavigateTo(
            $"/pacientes/editar/{Id}"
        );
    }

    private void Volver()
    {
        Nav.NavigateTo("/pacientes");
    }

    private static string MostrarFecha(DateTime? fecha)
    {
        return fecha.HasValue
            ? fecha.Value.ToString("dd/MM/yyyy")
            : "—";
    }

    private static string MostrarValor(object? valor)
    {
        if (valor is null)
            return "—";

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }
}