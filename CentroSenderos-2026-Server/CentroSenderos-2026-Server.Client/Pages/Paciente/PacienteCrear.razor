@page "/pacientes/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto


<div class="crear-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>


    <h1>Crear Paciente</h1>


    @if (cargando)
    {
        <div class="crear-loading">
            Cargando datos...
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="CrearPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />


            <!-- =========================================
                 01 - INFORMACIÓN PERSONAL
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>


                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Insertar nombre" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>DNI</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.DNI"
                                   placeholder="Insertar DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 02 - INFORMACIÓN MÉDICA
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Médica / Administrativa</span>
                </div>


                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label for="obraSocial">
                            Obra Social / Prepaga
                        </label>

                        <InputSelect id="obraSocial"
                                     class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            <option value="0">
                                Seleccione obra social
                            </option>

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>Nro. Afiliado</label>

                        <InputNumber class="form-input"
                                     @bind-Value="modelo.NumeroAfiliado"
                                     placeholder="Insertar nro. afiliado" />

                        <ValidationMessage For="@(() => modelo.NumeroAfiliado)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label for="diagnostico">
                            Diagnóstico / Motivo de Consulta
                        </label>

                        <InputSelect id="diagnostico"
                                     class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            <option value="0">
                                Seleccione diagnóstico
                            </option>

                            @foreach (var diag in tiposDiagnostico)
                            {
                                <option value="@diag.Id">
                                    @diag.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 03 - DATOS DE CONTACTO
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>


                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Teléfono</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Telefono"
                                   placeholder="Insertar teléfono" />

                        <ValidationMessage For="@(() => modelo.Telefono)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>Domicilio</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   placeholder="Insertar domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 ERROR GENERAL
            ========================================== -->
            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    @Mensaje
                </div>
            }


            <!-- =========================================
                 ACCIONES
            ========================================== -->

            <div class="form-actions">

                <button type="button"
                        class="cancel-button"
                        disabled="@guardando"
                        @onclick="Cancelar">

                    Cancelar

                </button>


                <button type="submit"
                        class="save-button"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Paciente</span>
                    }

                </button>

            </div>

        </EditForm>
    }

</div>


@code {

    private PacienteCrearDTO modelo = new()
    {
        Nombre = string.Empty,
        DNI = string.Empty,
        NumeroAfiliado = 0,
        Telefono = string.Empty,
        Domicilio = string.Empty,
        TipoObraSocialId = 0,
        TipoDiagnosticoId = 0
    };


    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();


    private bool cargando = true;
    private bool guardando = false;

    private string Mensaje = "";


    // CARGAR DATOS

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = "";


        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }


        var respDiag = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiag.Error && respDiag.Respuesta != null)
        {
            tiposDiagnostico = respDiag.Respuesta;
        }
        else if (respDiag.Error)
        {
            Mensaje = respDiag.ObtenerError();
        }


        cargando = false;
    }


    // GUARDAR

    private async Task Grabar()
    {
        guardando = true;
        Mensaje = "";


        var resp = await Http.Post<PacienteCrearDTO, int>(
            "api/paciente/insertar",
            modelo
        );


        guardando = false;


        if (!resp.Error)
        {
            var pacienteId = resp.Respuesta;

            Nav.NavigateTo(
                $"/pacientes/detalle/{pacienteId}?estado=creado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // CANCELAR

    private void Cancelar()
    {
        Nav.NavigateTo(
            "/pacientes"
        );
    }


    // VOLVER

    private void Volver()
    {
        Nav.NavigateTo(
            "/pacientes"
        );
    }

}