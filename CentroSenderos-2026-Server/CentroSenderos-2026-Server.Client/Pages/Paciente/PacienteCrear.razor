@page "/pacientes/crear"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario,equipo")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Text.Json
@using CentroSenderos_2026_Shared.Reglas
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<NavigationLock ConfirmExternalNavigation="TieneCambios" OnBeforeInternalNavigation="AntesDeNavegar" />

<div class="crear-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@(guardando || leyendoDocumentos)"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <header class="page-header">
        <div class="page-heading-icon" aria-hidden="true">
            <i class="bi bi-person-plus"></i>
        </div>
        <div>
            <h1>Crear paciente</h1>
            <p>Registrá sus datos personales, cobertura y contactos.</p>
        </div>
    </header>

    @if (cargando)
    {
        <div class="crear-loading">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Cargando datos del formulario...</span>
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="CrearPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label for="pacienteNombre">Nombre completo</label>

                        <InputText id="pacienteNombre" class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   @oninput="e => modelo.Nombre = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar nombre" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label for="pacienteDni">DNI</label>

                        <InputText id="pacienteDni" class="form-input"
                                   @bind-Value="modelo.DNI"
                                   @oninput="e => modelo.DNI = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />
                        @if (!string.IsNullOrWhiteSpace(MensajeDni))
                        {
                            <div class="dni-error" role="alert">@MensajeDni</div>
                        }

                    </div>

                    <div class="field-group">

                        <label for="pacienteNacimiento">Fecha de nacimiento</label>

                        <InputDate id="pacienteNacimiento" class="form-input"
                                   @bind-Value="modelo.FechaNacimiento" />

                        <ValidationMessage For="@(() => modelo.FechaNacimiento)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información médica y administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label for="obraSocial">
                            Obra social / prepaga
                        </label>

                        <div class="catalogo-selector">
<EntradaConBusqueda id="obraSocial"
                                     @bind-Value="modelo.TipoObraSocialId" Disabled="@(guardando || leyendoDocumentos)"
                                     Etiqueta="Obra social" Placeholder="Seleccioná una obra social"
                                     Opciones="OpcionesObrasSociales" ValorVacio="0" />
                    <button type="button" class="catalogo-agregar" disabled="@(guardando || leyendoDocumentos)" aria-label="Crear obra social" title="Crear obra social" @onclick="() => tipoobrasocialModal.Abrir()"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                    </div>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>N.º de afiliado</label>

                        <div class="automatic-field">
                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="automatic-field-title">
                                    Asignación automática
                                </span>

                                <span class="automatic-field-description">
                                    Se generará al guardar el paciente.
                                </span>
                            </div>
                        </div>

                    </div>

                    <div class="field-group">

                        <label for="diagnostico">
                            Diagnóstico / motivo de consulta
                        </label>

                        <div class="catalogo-selector">
<EntradaConBusqueda id="diagnostico"
                                     @bind-Value="modelo.TipoDiagnosticoId" Disabled="@(guardando || leyendoDocumentos)"
                                     Etiqueta="Diagnóstico" Placeholder="Seleccioná un diagnóstico"
                                     Opciones="OpcionesDiagnosticosFormulario" ValorVacio="0" />
                    <button type="button" class="catalogo-agregar" disabled="@(guardando || leyendoDocumentos)" aria-label="Crear diagnóstico" title="Crear diagnóstico" @onclick="() => tipodiagnosticoModal.Abrir()"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                    </div>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado único de discapacidad</label>

                        <label class="cud-option">

                            <InputCheckbox class="cud-checkbox"
                                           @bind-Value="modelo.TieneCud" />

                            <span class="cud-option-content">
                                <span class="cud-option-title">
                                    Tiene CUD
                                </span>

                                <span class="cud-option-description">
                                    Marcar si el paciente posee un CUD vigente.
                                </span>
                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title section-title-actions">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de contacto</span>
                    </div>

                    <button type="button"
                            class="add-phone-button"
                            disabled="@(guardando || leyendoDocumentos)"
                            @onclick="AgregarTelefono">
                        <i class="bi bi-plus-lg"></i>
                        Agregar teléfono
                    </button>

                </div>

                <div class="phones-list">

                    @foreach (var telefono in modelo.Telefonos)
                    {
                        <div class="phone-row" @key="telefono">

                            <div class="field-group">

                                <label>Etiqueta</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Etiqueta"
                                           @oninput="e => telefono.Etiqueta = e.Value?.ToString() ?? string.Empty"
                                           placeholder="Ej.: Paciente, madre o tutor" />

                            </div>

                            <div class="field-group">

                                <label>Número de teléfono</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Numero"
                                           @oninput="e => telefono.Numero = e.Value?.ToString() ?? string.Empty"
                                           placeholder="Insertar teléfono" />

                            </div>

                            <button type="button"
                                    class="remove-phone-button"
                                    title="Eliminar teléfono"
                                    aria-label="Eliminar teléfono"
                                    disabled="@(guardando || modelo.Telefonos.Count == 1)"
                                    @onclick="() => EliminarTelefono(telefono)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeTelefonos))
                {
                    <div class="validation-message phone-validation">
                        @MensajeTelefonos
                    </div>
                }

                <div class="form-grid form-grid-2 contact-address">

                    <div class="field-group">

                        <label for="pacienteDomicilio">Domicilio</label>

                        <InputText id="pacienteDomicilio" class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   @oninput="e => modelo.Domicilio = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <section class="form-section documentos-seccion" aria-labelledby="documentos-titulo">
                <div class="section-title">
                    <span class="section-number">04</span>
                    <span id="documentos-titulo">Documentos y estudios</span>
                    <span class="documentos-opcional">Opcional</span>
                </div>
                <p class="documentos-ayuda">Podés adjuntar estudios, recetas, CUD u otros documentos. Se guardarán junto con el paciente.</p>
                <div class="documentos-controles">
                        <div class="field-group">
                            <label for="tipoDocumentoNuevo">Tipo de documento</label>
                            <div class="catalogo-selector">
                                <EntradaConBusqueda id="tipoDocumentoNuevo" @bind-Value="tipoDocumentoSeleccionado" Disabled="@(guardando || leyendoDocumentos || tiposDocumentos.Count == 0)"
                                     Etiqueta="Tipo de documento" Placeholder="Seleccioná un tipo"
                                     Opciones="OpcionesDocumentos" ValorVacio="0" />
                                <button type="button" class="catalogo-agregar" aria-label="Crear tipo de documento" title="Crear tipo de documento" disabled="@(guardando || leyendoDocumentos)" @onclick="() => tipodocumentoModal.Abrir()"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <label class="documentos-carga @((tipoDocumentoSeleccionado <= 0 || guardando || leyendoDocumentos || documentosPendientes.Count >= ReglasDocumentosPaciente.MaximoArchivos) ? "deshabilitada" : "")">
                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                            <span><strong>@(leyendoDocumentos ? "Preparando archivos…" : "Adjuntar documentos")</strong><small>PDF, fotos, estudios y otros archivos</small></span>
                            <InputFile multiple OnChange="AgregarDocumentos" aria-label="Adjuntar documentos del paciente"
                                       disabled="@(guardando || leyendoDocumentos || tipoDocumentoSeleccionado <= 0 || documentosPendientes.Count >= ReglasDocumentosPaciente.MaximoArchivos)" />
                        </label>
                    </div>
                    <p class="documentos-limite">Primero elegí un tipo. Hasta 10 archivos, 20 MB por archivo y 30 MB en total.</p>
                @if (tiposDocumentos.Count == 0)
                {
                    <p class="documentos-ayuda">Creá un tipo con el botón + para adjuntar documentos, o continuá sin archivos.</p>
                    <button type="button" class="documentos-reintentar" @onclick="CargarTiposDocumentos" disabled="@(guardando || leyendoDocumentos)">Volver a cargar tipos</button>
                }
                @if (documentosPendientes.Count > 0)
                {
                    <div class="documentos-pendientes" aria-label="Documentos para guardar">
                        @foreach (var doc in documentosPendientes)
                        {
                            <article @key="doc.Clave" class="documento-pendiente">
                                <span class="documento-icono"><i class="bi @(doc.Nombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "bi-file-earmark-pdf" : "bi-file-earmark")" aria-hidden="true"></i></span>
                                <div class="documento-datos"><strong>@doc.Nombre</strong><span>@doc.Tipo · @FormatearTamano(doc.Contenido.LongLength) · Pendiente de guardar</span></div>
                                <button type="button" class="documento-quitar" aria-label="Quitar @doc.Nombre" title="Quitar documento" disabled="@(guardando || leyendoDocumentos)" @onclick="() => documentosPendientes.Remove(doc)"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                            </article>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(mensajeDocumentos))
                {
                    <p class="documentos-error" role="alert">@mensajeDocumentos</p>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    @Mensaje
                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="cancel-button"
                        disabled="@(guardando || leyendoDocumentos)"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="save-button"
                        disabled="@(guardando || leyendoDocumentos)">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2" aria-hidden="true"></i>
                        <span>Guardar paciente</span>
                    }

                </button>

            </div>

        </EditForm>
    }

</div>


@if (destinoPendiente != null)
{
    <div class="salida-fondo">
        <section class="salida-modal" role="dialog" aria-modal="true" aria-labelledby="salida-titulo">
            <span class="salida-icono"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span>
            <h2 id="salida-titulo">Hay cambios sin guardar</h2>
            <p>Si salís ahora, se perderán las modificaciones del formulario.</p>
            <div class="salida-acciones">
                <button type="button" class="cancel-button" @onclick="SeguirEditando">Seguir editando</button>
                <button type="button" class="salida-confirmar" @onclick="SalirSinGuardar">Salir sin guardar</button>
            </div>
        </section>
    </div>
}

<CrearCatalogo @ref="tipoobrasocialModal" Recurso="tipoobrasocial" Etiqueta="obra social" Creado="ObraCreada" />
<CrearCatalogo @ref="tipodiagnosticoModal" Recurso="tipodiagnostico" Etiqueta="diagnóstico" Creado="DiagnosticoCreado" />

<CrearCatalogo @ref="tipodocumentoModal" Recurso="tipodocumento" Etiqueta="tipo de documento" Creado="TipoDocumentoCreado" />

@code {
    #region Opciones de los buscadores

    private IEnumerable<OpcionSelector> OpcionesObrasSociales =>
        tiposObraSocial
            .Select(obra => new OpcionSelector(obra.Id.ToString(), obra.Tipo));

    private IEnumerable<OpcionSelector> OpcionesDiagnosticosFormulario =>
        tiposDiagnostico
            .Select(diagnostico => new OpcionSelector(diagnostico.Id.ToString(), diagnostico.Tipo));

    private IEnumerable<OpcionSelector> OpcionesDocumentos =>
        tiposDocumentos.OrderBy(tipo => tipo.Tipo)
            .Select(tipo => new OpcionSelector(tipo.Id.ToString(), tipo.Tipo));

    #endregion

    private CrearCatalogo tipodocumentoModal = default!;
    private void TipoDocumentoCreado(TipoListadoDTO tipo)
    {
        tiposDocumentos.Add(new TipoDocumentoDTO { Id = tipo.Id, Tipo = tipo.Tipo, Descripcion = tipo.Descripcion });
        tipoDocumentoSeleccionado = tipo.Id;
        mensajeDocumentos = string.Empty;
    }

    private CrearCatalogo tipodiagnosticoModal = default!;
    private CrearCatalogo tipoobrasocialModal = default!;
    private void ObraCreada(TipoListadoDTO tipo)
    {
        tiposObraSocial.Add(new TipoDTO { Id = tipo.Id, Tipo = tipo.Tipo, Descripcion = tipo.Descripcion });
        modelo.TipoObraSocialId = tipo.Id;
    }
    private void DiagnosticoCreado(TipoListadoDTO tipo)
    {
        tiposDiagnostico.Add(new TipoDTO { Id = tipo.Id, Tipo = tipo.Tipo, Descripcion = tipo.Descripcion });
        modelo.TipoDiagnosticoId = tipo.Id;
    }


    [SupplyParameterFromQuery(Name = "volver")]
    public string? VolverA { get; set; }

    private string? estadoInicial;
    private string? destinoPendiente;
    private bool permitirSalida;
    private string MensajeDni = string.Empty;

    private bool TieneCambios => !permitirSalida && !cargando && estadoInicial != null
        && (leyendoDocumentos || estadoInicial != ObtenerEstadoFormulario());

    private string ObtenerEstadoFormulario() => JsonSerializer.Serialize(new
    {
        Nombre = modelo?.Nombre,
        DNI = modelo?.DNI,
        FechaNacimiento = modelo?.FechaNacimiento,
        TieneCud = modelo?.TieneCud,
        TipoObraSocialId = modelo?.TipoObraSocialId,
        TipoDiagnosticoId = modelo?.TipoDiagnosticoId,
        Domicilio = modelo?.Domicilio,
        Telefonos = modelo?.Telefonos.Select(t => new { t.Etiqueta, t.Numero }).ToList(),
        Documentos = documentosPendientes.Select(d => new { d.Clave, d.TipoDocumentoId, d.Nombre }).ToList()
    });

    private void AntesDeNavegar(LocationChangingContext contexto)
    {
        if (!TieneCambios) return;
        contexto.PreventNavigation();
        destinoPendiente = contexto.TargetLocation;
        StateHasChanged();
    }

    private void SeguirEditando() => destinoPendiente = null;

    private void SalirSinGuardar()
    {
        if (destinoPendiente == null) return;
        var destino = destinoPendiente;
        destinoPendiente = null;
        permitirSalida = true;
        Nav.NavigateTo(destino);
    }

    private string ContextoRegreso => !string.IsNullOrWhiteSpace(VolverA)
        && (VolverA == "/pacientes" || VolverA.StartsWith("/pacientes?", StringComparison.Ordinal))
            ? VolverA
            : "/pacientes";


    private PacienteCrearDTO modelo = new()
    {
        Nombre = string.Empty,
        DNI = string.Empty,
        FechaNacimiento = null,
        TieneCud = false,
        //NumeroAfiliado = 0,
        Telefono = string.Empty,
        Domicilio = string.Empty,
        TipoObraSocialId = 0,
        TipoDiagnosticoId = 0,

        Telefonos = new List<PacienteTelefonoDTO>
        {
            new()
            {
                Etiqueta = "Paciente",
                Numero = string.Empty
            }
        }
    };

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();

    private bool cargando = true;
    private bool guardando;

    private string Mensaje = string.Empty;
    private string MensajeTelefonos = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }

        var respDiagnostico = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiagnostico.Error &&
            respDiagnostico.Respuesta != null)
        {
            tiposDiagnostico = respDiagnostico.Respuesta;
        }
        else if (respDiagnostico.Error)
        {
            Mensaje = respDiagnostico.ObtenerError();
        }

        await CargarTiposDocumentos();
        estadoInicial = ObtenerEstadoFormulario();
        cargando = false;
    }

    private void AgregarTelefono()
    {
        MensajeTelefonos = string.Empty;

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá el teléfono actual antes de agregar otro.";

            return;
        }

        modelo.Telefonos.Add(new PacienteTelefonoDTO
        {
            Etiqueta = string.Empty,
            Numero = string.Empty
        });
    }

    private void EliminarTelefono(PacienteTelefonoDTO telefono)
    {
        if (modelo.Telefonos.Count <= 1)
            return;

        modelo.Telefonos.Remove(telefono);
        MensajeTelefonos = string.Empty;
    }

    private List<TipoDocumentoDTO> tiposDocumentos = new();
    private List<DocumentoPendiente> documentosPendientes = new();
    private int tipoDocumentoSeleccionado;
    private bool leyendoDocumentos;
    private string mensajeDocumentos = string.Empty;
    private sealed record DocumentoPendiente(Guid Clave, int TipoDocumentoId, string Tipo, string Nombre, string ContentType, byte[] Contenido);

    private async Task CargarTiposDocumentos()
    {
        try
        {
            var respuesta = await Http.Get<List<TipoDocumentoDTO>>("api/documento/tipos");
            tiposDocumentos = respuesta.Error ? new() : respuesta.Respuesta ?? new();
            mensajeDocumentos = respuesta.Error ? "No pudimos cargar los tipos de documento. Podés guardar el paciente sin adjuntos." : string.Empty;
        }
        catch { mensajeDocumentos = "No pudimos cargar los tipos de documento. Podés guardar el paciente sin adjuntos."; }
    }

    private async Task AgregarDocumentos(InputFileChangeEventArgs evento)
    {
        if (guardando || leyendoDocumentos) return;
        var tipo = tiposDocumentos.FirstOrDefault(t => t.Id == tipoDocumentoSeleccionado);
        if (tipo is null) { mensajeDocumentos = "Seleccioná un tipo de documento antes de adjuntar."; return; }
        mensajeDocumentos = string.Empty;
        leyendoDocumentos = true;
        try
        {
            var archivos = evento.GetMultipleFiles(ReglasDocumentosPaciente.MaximoArchivos);
            if (archivos.Count + documentosPendientes.Count > ReglasDocumentosPaciente.MaximoArchivos)
            { mensajeDocumentos = "Podés adjuntar hasta 10 archivos."; return; }
            if (archivos.Any(a => a.Size <= 0 || a.Size > ReglasDocumentosPaciente.MaximoBytesPorArchivo))
            { mensajeDocumentos = "Los archivos no pueden estar vacíos ni superar los 20 MB cada uno."; return; }
            if (archivos.Sum(a => a.Size) + documentosPendientes.Sum(d => d.Contenido.LongLength) > ReglasDocumentosPaciente.MaximoBytesTotal)
            { mensajeDocumentos = "Los documentos adjuntos no pueden superar los 30 MB en total."; return; }
            var nuevos = new List<DocumentoPendiente>();
            foreach (var archivo in archivos)
            {
                using var memoria = new MemoryStream();
                await using var entrada = archivo.OpenReadStream(ReglasDocumentosPaciente.MaximoBytesPorArchivo);
                await entrada.CopyToAsync(memoria);
                nuevos.Add(new(Guid.NewGuid(), tipo.Id, tipo.Tipo, archivo.Name, archivo.ContentType, memoria.ToArray()));
            }
            documentosPendientes.AddRange(nuevos);
        }
        catch { mensajeDocumentos = "No pudimos preparar los archivos. Seleccioná hasta 10 archivos de 20 MB como máximo e intentá nuevamente."; }
        finally { leyendoDocumentos = false; }
    }

    private static string FormatearTamano(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / (1024d * 1024d):0.#} MB" : $"{Math.Max(1, bytes / 1024d):0.#} KB";

    private async Task<HttpRespuesta<int>> GuardarPaciente()
    {
        if (documentosPendientes.Count == 0)
            return await Http.Post<PacienteCrearDTO, int>("api/paciente/insertar", modelo);
        using var contenido = new MultipartFormDataContent();
        contenido.Add(new StringContent(JsonSerializer.Serialize(modelo)), "pacienteJson");
        foreach (var doc in documentosPendientes)
        {
            var archivo = new ByteArrayContent(doc.Contenido);
            archivo.Headers.ContentType = System.Net.Http.Headers.MediaTypeHeaderValue.TryParse(doc.ContentType, out var tipo)
                ? tipo : new("application/octet-stream");
            contenido.Add(archivo, "archivos", doc.Nombre);
            contenido.Add(new StringContent(doc.TipoDocumentoId.ToString()), "tipoDocumentoIds");
        }
        return await Http.PostMultipart<int>("api/paciente/insertar-con-documentos", contenido);
    }

    private async Task Grabar()
    {
        if (guardando || leyendoDocumentos) return;
        Mensaje = string.Empty;
        MensajeDni = string.Empty;
        MensajeTelefonos = string.Empty;

        if (modelo.FechaNacimiento > DateTime.Today)
        {
            Mensaje = "La fecha de nacimiento no puede ser posterior a hoy.";
            return;
        }

        if (modelo.Telefonos.Count == 0)
        {
            MensajeTelefonos =
                "Debe registrar al menos un teléfono.";

            return;
        }

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Etiqueta) ||
            string.IsNullOrWhiteSpace(t.Numero));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá la etiqueta y el número de todos los teléfonos.";

            return;
        }

        modelo.Telefono = modelo.Telefonos
            .First()
            .Numero;

        guardando = true;

        HttpRespuesta<int> resp;
        try { resp = await GuardarPaciente(); }
        catch
        {
            Mensaje = "No pudimos confirmar el guardado. Revisá el listado antes de reintentar para evitar duplicar el paciente.";
            return;
        }
        finally { guardando = false; }

        if (!resp.Error)
        {
            permitirSalida = true;
            var pacienteId = resp.Respuesta;

            Nav.NavigateTo(
                ContextoRegreso + (ContextoRegreso.Contains('?') ? "&" : "?") + $"detalle={pacienteId}&estado=creado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
            if (Mensaje.Contains("DNI", StringComparison.OrdinalIgnoreCase)
                && Mensaje.Contains("Ya existe", StringComparison.OrdinalIgnoreCase))
                MensajeDni = "Ya existe un paciente con ese DNI. Revisá el número ingresado.";
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo(ContextoRegreso);
    }

    private void Volver()
    {
        Nav.NavigateTo(ContextoRegreso);
    }
}
