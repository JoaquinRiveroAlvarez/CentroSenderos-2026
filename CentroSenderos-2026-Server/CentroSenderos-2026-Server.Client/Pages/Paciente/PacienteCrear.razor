@page "/pacientes/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Text.Json
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<NavigationLock ConfirmExternalNavigation="TieneCambios" OnBeforeInternalNavigation="AntesDeNavegar" />

<div class="crear-paciente-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <header class="page-header">
        <div class="page-heading-icon" aria-hidden="true">
            <i class="bi bi-person-plus"></i>
        </div>
        <div>
            <h1>Crear paciente</h1>
            <p>Registrá sus datos personales, cobertura y contactos.</p>
        </div>
    </header>

    @if (cargando)
    {
        <div class="crear-loading">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Cargando datos del formulario...</span>
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="CrearPacienteForm"
                  class="paciente-form">

            <DataAnnotationsValidator />

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información personal</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label for="pacienteNombre">Nombre completo</label>

                        <InputText id="pacienteNombre" class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   @oninput="e => modelo.Nombre = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar nombre" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label for="pacienteDni">DNI</label>

                        <InputText id="pacienteDni" class="form-input"
                                   @bind-Value="modelo.DNI"
                                   @oninput="e => modelo.DNI = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar DNI" />

                        <ValidationMessage For="@(() => modelo.DNI)"
                                           class="validation-message" />
                        @if (!string.IsNullOrWhiteSpace(MensajeDni))
                        {
                            <div class="dni-error" role="alert">@MensajeDni</div>
                        }

                    </div>

                    <div class="field-group">

                        <label for="pacienteNacimiento">Fecha de nacimiento</label>

                        <InputDate id="pacienteNacimiento" class="form-input"
                                   @bind-Value="modelo.FechaNacimiento" />

                        <ValidationMessage For="@(() => modelo.FechaNacimiento)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información médica y administrativa</span>
                </div>

                <div class="form-grid form-grid-medical">

                    <div class="field-group">

                        <label for="obraSocial">
                            Obra social / prepaga
                        </label>

                        <InputSelect id="obraSocial"
                                     class="form-input"
                                     @bind-Value="modelo.TipoObraSocialId">

                            <option value="0">
                                Seleccione obra social
                            </option>

                            @foreach (var obra in tiposObraSocial)
                            {
                                <option value="@obra.Id">
                                    @obra.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoObraSocialId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group">

                        <label>N.º de afiliado</label>

                        <div class="automatic-field">
                            <i class="bi bi-hash"></i>

                            <div>
                                <span class="automatic-field-title">
                                    Asignación automática
                                </span>

                                <span class="automatic-field-description">
                                    Se generará al guardar el paciente.
                                </span>
                            </div>
                        </div>

                    </div>

                    <div class="field-group">

                        <label for="diagnostico">
                            Diagnóstico / motivo de consulta
                        </label>

                        <InputSelect id="diagnostico"
                                     class="form-input"
                                     @bind-Value="modelo.TipoDiagnosticoId">

                            <option value="0">
                                Seleccione diagnóstico
                            </option>

                            @foreach (var diagnostico in tiposDiagnostico)
                            {
                                <option value="@diagnostico.Id">
                                    @diagnostico.Tipo
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.TipoDiagnosticoId)"
                                           class="validation-message" />

                    </div>

                    <div class="field-group cud-field">

                        <label>Certificado único de discapacidad</label>

                        <label class="cud-option">

                            <InputCheckbox class="cud-checkbox"
                                           @bind-Value="modelo.TieneCud" />

                            <span class="cud-option-content">
                                <span class="cud-option-title">
                                    Tiene CUD
                                </span>

                                <span class="cud-option-description">
                                    Marcar si el paciente posee un CUD vigente.
                                </span>
                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <section class="form-section">

                <div class="section-title section-title-actions">

                    <div class="section-title-content">
                        <span class="section-number">03</span>
                        <span>Datos de contacto</span>
                    </div>

                    <button type="button"
                            class="add-phone-button"
                            disabled="@guardando"
                            @onclick="AgregarTelefono">
                        <i class="bi bi-plus-lg"></i>
                        Agregar teléfono
                    </button>

                </div>

                <div class="phones-list">

                    @foreach (var telefono in modelo.Telefonos)
                    {
                        <div class="phone-row" @key="telefono">

                            <div class="field-group">

                                <label>Etiqueta</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Etiqueta"
                                           @oninput="e => telefono.Etiqueta = e.Value?.ToString() ?? string.Empty"
                                           placeholder="Ej.: Paciente, madre o tutor" />

                            </div>

                            <div class="field-group">

                                <label>Número de teléfono</label>

                                <InputText class="form-input"
                                           @bind-Value="telefono.Numero"
                                           @oninput="e => telefono.Numero = e.Value?.ToString() ?? string.Empty"
                                           placeholder="Insertar teléfono" />

                            </div>

                            <button type="button"
                                    class="remove-phone-button"
                                    title="Eliminar teléfono"
                                    aria-label="Eliminar teléfono"
                                    disabled="@(guardando || modelo.Telefonos.Count == 1)"
                                    @onclick="() => EliminarTelefono(telefono)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeTelefonos))
                {
                    <div class="validation-message phone-validation">
                        @MensajeTelefonos
                    </div>
                }

                <div class="form-grid form-grid-2 contact-address">

                    <div class="field-group">

                        <label for="pacienteDomicilio">Domicilio</label>

                        <InputText id="pacienteDomicilio" class="form-input"
                                   @bind-Value="modelo.Domicilio"
                                   @oninput="e => modelo.Domicilio = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Insertar domicilio" />

                        <ValidationMessage For="@(() => modelo.Domicilio)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    @Mensaje
                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="cancel-button"
                        disabled="@guardando"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="save-button"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2" aria-hidden="true"></i>
                        <span>Guardar paciente</span>
                    }

                </button>

            </div>

        </EditForm>
    }

</div>


@if (destinoPendiente != null)
{
    <div class="salida-fondo">
        <section class="salida-modal" role="dialog" aria-modal="true" aria-labelledby="salida-titulo">
            <span class="salida-icono"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span>
            <h2 id="salida-titulo">Hay cambios sin guardar</h2>
            <p>Si salís ahora, se perderán las modificaciones del formulario.</p>
            <div class="salida-acciones">
                <button type="button" class="cancel-button" @onclick="SeguirEditando">Seguir editando</button>
                <button type="button" class="salida-confirmar" @onclick="SalirSinGuardar">Salir sin guardar</button>
            </div>
        </section>
    </div>
}

@code {

    [SupplyParameterFromQuery(Name = "volver")]
    public string? VolverA { get; set; }

    private string? estadoInicial;
    private string? destinoPendiente;
    private bool permitirSalida;
    private string MensajeDni = string.Empty;

    private bool TieneCambios => !permitirSalida && !cargando && estadoInicial != null
        && estadoInicial != ObtenerEstadoFormulario();

    private string ObtenerEstadoFormulario() => JsonSerializer.Serialize(new
    {
        Nombre = modelo?.Nombre,
        DNI = modelo?.DNI,
        FechaNacimiento = modelo?.FechaNacimiento,
        TieneCud = modelo?.TieneCud,
        TipoObraSocialId = modelo?.TipoObraSocialId,
        TipoDiagnosticoId = modelo?.TipoDiagnosticoId,
        Domicilio = modelo?.Domicilio,
        Telefonos = modelo?.Telefonos.Select(t => new { t.Etiqueta, t.Numero }).ToList()
    });

    private void AntesDeNavegar(LocationChangingContext contexto)
    {
        if (!TieneCambios) return;
        contexto.PreventNavigation();
        destinoPendiente = contexto.TargetLocation;
        StateHasChanged();
    }

    private void SeguirEditando() => destinoPendiente = null;

    private void SalirSinGuardar()
    {
        if (destinoPendiente == null) return;
        var destino = destinoPendiente;
        destinoPendiente = null;
        permitirSalida = true;
        Nav.NavigateTo(destino);
    }

    private string ContextoRegreso => !string.IsNullOrWhiteSpace(VolverA)
        && (VolverA == "/pacientes" || VolverA.StartsWith("/pacientes?", StringComparison.Ordinal))
            ? VolverA
            : "/pacientes";


    private PacienteCrearDTO modelo = new()
    {
        Nombre = string.Empty,
        DNI = string.Empty,
        FechaNacimiento = null,
        TieneCud = false,
        //NumeroAfiliado = 0,
        Telefono = string.Empty,
        Domicilio = string.Empty,
        TipoObraSocialId = 0,
        TipoDiagnosticoId = 0,

        Telefonos = new List<PacienteTelefonoDTO>
        {
            new()
            {
                Etiqueta = "Paciente",
                Numero = string.Empty
            }
        }
    };

    private List<TipoDTO> tiposObraSocial = new();
    private List<TipoDTO> tiposDiagnostico = new();

    private bool cargando = true;
    private bool guardando;

    private string Mensaje = string.Empty;
    private string MensajeTelefonos = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respObra = await Http.Get<List<TipoDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        if (!respObra.Error && respObra.Respuesta != null)
        {
            tiposObraSocial = respObra.Respuesta;
        }
        else if (respObra.Error)
        {
            Mensaje = respObra.ObtenerError();
        }

        var respDiagnostico = await Http.Get<List<TipoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        if (!respDiagnostico.Error &&
            respDiagnostico.Respuesta != null)
        {
            tiposDiagnostico = respDiagnostico.Respuesta;
        }
        else if (respDiagnostico.Error)
        {
            Mensaje = respDiagnostico.ObtenerError();
        }

        estadoInicial = ObtenerEstadoFormulario();
        cargando = false;
    }

    private void AgregarTelefono()
    {
        MensajeTelefonos = string.Empty;

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Numero) ||
            string.IsNullOrWhiteSpace(t.Etiqueta));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá el teléfono actual antes de agregar otro.";

            return;
        }

        modelo.Telefonos.Add(new PacienteTelefonoDTO
        {
            Etiqueta = string.Empty,
            Numero = string.Empty
        });
    }

    private void EliminarTelefono(PacienteTelefonoDTO telefono)
    {
        if (modelo.Telefonos.Count <= 1)
            return;

        modelo.Telefonos.Remove(telefono);
        MensajeTelefonos = string.Empty;
    }

    private async Task Grabar()
    {
        Mensaje = string.Empty;
        MensajeDni = string.Empty;
        MensajeTelefonos = string.Empty;

        if (modelo.FechaNacimiento > DateTime.Today)
        {
            Mensaje = "La fecha de nacimiento no puede ser posterior a hoy.";
            return;
        }

        if (modelo.Telefonos.Count == 0)
        {
            MensajeTelefonos =
                "Debe registrar al menos un teléfono.";

            return;
        }

        var existeTelefonoIncompleto = modelo.Telefonos.Any(t =>
            string.IsNullOrWhiteSpace(t.Etiqueta) ||
            string.IsNullOrWhiteSpace(t.Numero));

        if (existeTelefonoIncompleto)
        {
            MensajeTelefonos =
                "Completá la etiqueta y el número de todos los teléfonos.";

            return;
        }

        modelo.Telefono = modelo.Telefonos
            .First()
            .Numero;

        guardando = true;

        var resp = await Http.Post<PacienteCrearDTO, int>(
            "api/paciente/insertar",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            permitirSalida = true;
            var pacienteId = resp.Respuesta;

            Nav.NavigateTo(
                ContextoRegreso + (ContextoRegreso.Contains('?') ? "&" : "?") + $"detalle={pacienteId}&estado=creado"
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
            if (Mensaje.Contains("DNI", StringComparison.OrdinalIgnoreCase)
                && Mensaje.Contains("Ya existe", StringComparison.OrdinalIgnoreCase))
                MensajeDni = "Ya existe un paciente con ese DNI. Revisá el número ingresado.";
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo(ContextoRegreso);
    }

    private void Volver()
    {
        Nav.NavigateTo(ContextoRegreso);
    }
}
