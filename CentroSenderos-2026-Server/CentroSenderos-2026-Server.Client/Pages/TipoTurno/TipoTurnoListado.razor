@page "/tipoturno"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turnos-page" inert="@(modalActual != ModalTurno.Ninguno)">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Turno</h1>

            <p>
                Gestioná los tipos de turno disponibles en Senderos.
            </p>

        </div>

        <div class="header-actions">

            <button type="button"
                    class="btn-nuevo"
                    @onclick="AbrirCrear">
                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>
            </button>

        </div>

    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar tipo de turno" Placeholder="Buscar tipo de turno..." />

    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando tipos de turno...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h2>No hay tipos de turno registrados</h2>

            <p>
                Todavía no se registraron tipos de turno.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nuevo-estado"
                    @onclick="AbrirCrear">
                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>
            </button>

        </div>
    }
    else if (lista.Count > 0 && !TurnosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay tipos de turno que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">
                Limpiar búsqueda
            </button>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">
                <div>TIPO DE TURNO</div>
                <div>DESCRIPCIÓN</div>
                <div>DURACIÓN</div>
                <div></div>
            </div>

            <div class="list-body">

                @foreach (var item in TurnosFiltrados)
                {
                    <div class="turno-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="turno-info">

                            <div class="turno-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div class="turno-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">Sin nombre</span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>

                        <div class="turno-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">Sin descripción</span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>

                        <div class="turno-duracion">

                            <div class="duracion-badge">

                                <i class="bi bi-clock"></i>

                                <span>
                                    @item.DuracionMinutos min
                                </span>

                            </div>

                        </div>

                        <div class="turno-action">
                            
                        </div>

                    </div>
                }

            </div>

            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@TurnosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "tipo de turno" : "tipos de turno")
                </span>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalTurno.Ninguno)
    {
        <div class="mensaje-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@Mensaje</span>
        </div>
    }

</div>

@* Modal Detalle *@

@if (modalActual == ModalTurno.Detalle)
{
    <ModalAdministracion Titulo="Detalle de tipo de turno" CerrarAlTocarFondo="true" Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar" AlCerrar="SolicitarCerrarModal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <span>Cargando tipo de turno...</span>

                </div>
            }
            else
            {
                <div class="administracion-cuerpo">

                <div class="detail-grid">

                    <div class="field-group administracion-campo field-full">

                        <label>TIPO DE TURNO</label>

                        <div class="administracion-valor detail-value">
                            @MostrarValor(modelo.Tipo)
                        </div>

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>DESCRIPCIÓN</label>

                        <div class="administracion-valor detail-value detail-value-large">

                            @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                            {
                                <span class="sin-dato">Sin descripción</span>
                            }
                            else
                            {
                                @modelo.Descripcion
                            }

                        </div>

                    </div>

                    <div class="field-group administracion-campo field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-detail">

                            <span class="duration-icon">
                                <i class="bi bi-clock"></i>
                            </span>

                            <span class="duration-number">
                                @modelo.DuracionMinutos
                            </span>

                            <span class="duration-suffix">
                                minutos
                            </span>

                        </div>

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>PACIENTES</label>

                        <div class="tipo-turno-regla-resumen">
                            @(modelo.RequierePacientes
                                ? "Se requiere al menos un paciente."
                                : "Permite turnos sin pacientes asignados.")
                        </div>

                    </div>

                </div>

                </div>
                <footer class="administracion-acciones">
                    <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                    <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                </footer>
            }

    </ModalAdministracion>
}

@* Modal Crear *@

@if (modalActual == ModalTurno.Crear)
{
    <ModalAdministracion IconoFormulario="bi-calendar-event" Titulo="Nuevo tipo de turno" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCerrarModal">


            <EditForm Model="@modelo"
                      OnValidSubmit="CrearTurno" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="form-grid">

                    <div class="field-group administracion-campo field-full">

                        <label>TIPO DE TURNO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Sesión individual" />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>

                    <div class="field-group administracion-campo field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-input-group">

                            <span class="duration-prefix">
                                <i class="bi bi-clock"></i>
                            </span>

                            <InputNumber class="duration-input"
                                         @bind-Value="modelo.DuracionMinutos" />

                            <span class="duration-suffix-input">
                                minutos
                            </span>

                        </div>

                        <ValidationMessage For="@(() => modelo.DuracionMinutos)" />

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label class="tipo-turno-regla">

                            <InputCheckbox @bind-Value="modelo.RequierePacientes"
                                           disabled="@guardando" />

                            <span>

                                <strong>
                                    Requiere al menos un paciente
                                </strong>

                                <small>
                                    Si está desmarcado, permite guardar turnos
                                    sin pacientes asignados.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>
                    </div>
                }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrarModal">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}

@* Modal Editar *@

@if (modalActual == ModalTurno.Editar)
{
    <ModalAdministracion IconoFormulario="bi-calendar-event" Titulo="Editar tipo de turno" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCancelarEdicion">


            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="form-grid">

                    <div class="field-group administracion-campo field-full">

                        <label>TIPO DE TURNO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Sesión individual" />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>

                    <div class="field-group administracion-campo field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-input-group">

                            <span class="duration-prefix">
                                <i class="bi bi-clock"></i>
                            </span>

                            <InputNumber class="duration-input"
                                         @bind-Value="modelo.DuracionMinutos" />

                            <span class="duration-suffix-input">
                                minutos
                            </span>

                        </div>

                        <ValidationMessage For="@(() => modelo.DuracionMinutos)" />

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label class="tipo-turno-regla">

                            <InputCheckbox @bind-Value="modelo.RequierePacientes"
                                           disabled="@guardando" />

                            <span>

                                <strong>
                                    Requiere al menos un paciente
                                </strong>

                                <small>
                                    Si está desmarcado, permite guardar turnos
                                    sin pacientes asignados.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>
                    </div>
                }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCancelarEdicion">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : "Guardar cambios")
                    </button>
                </footer>

            </EditForm>

