@page "/tipoturno"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turnos-page">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Turno</h1>

            <p>
                Gestioná los tipos de turno disponibles en Senderos.
            </p>

        </div>


        <div class="header-actions">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar tipo de turno..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />

            </div>


            <button type="button"
                    class="btn-nuevo"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>

            </button>

        </div>

    </div>


    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
            </div>

            <span>Cargando tipos de turno...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h2>No hay tipos de turno registrados</h2>

            <p>
                Todavía no se registraron tipos de turno.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nuevo-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !TurnosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay tipos de turno que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">

                <div>TIPO DE TURNO</div>
                <div>DESCRIPCIÓN</div>
                <div>DURACIÓN</div>
                <div></div>

            </div>


            <div class="list-body">

                @foreach (var item in TurnosFiltrados)
                {
                    <div class="turno-row"
                         @onclick="() => AbrirDetalle(item.Id)">

                        <div class="turno-info">

                            <div class="turno-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div class="turno-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        <div class="turno-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="turno-duracion">

                            <div class="duracion-badge">

                                <i class="bi bi-clock"></i>

                                <span>
                                    @item.DuracionMinutos min
                                </span>

                            </div>

                        </div>


                        <div class="turno-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@TurnosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "tipo de turno" : "tipos de turno")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalTurno.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


@* =========================================================
   MODAL DETALLE
========================================================= *@

@if (modalActual == ModalTurno.Detalle)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando tipo de turno...</span>

                </div>
            }
            else
            {
                <div class="modal-header">

                    <div>

                        <h2>Detalle Tipo de Turno</h2>

                        <p>
                            Información del tipo de turno seleccionado.
                        </p>

                    </div>


                    <button type="button"
                            class="close-button"
                            title="Cerrar"
                            @onclick="CerrarModal">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <div class="detail-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE TURNO</label>

                        <div class="detail-value">
                            @MostrarValor(modelo.Tipo)
                        </div>

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <div class="detail-value detail-value-large">

                            @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @modelo.Descripcion
                            }

                        </div>

                    </div>


                    <div class="field-group field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-detail">

                            <span class="duration-icon">
                                <i class="bi bi-clock"></i>
                            </span>

                            <span class="duration-number">
                                @modelo.DuracionMinutos
                            </span>

                            <span class="duration-suffix">
                                minutos
                            </span>

                        </div>

                    </div>

                </div>


                <div class="modal-actions detail-actions">

                    <button type="button"
                            class="btn-cerrar"
                            @onclick="CerrarModal">

                        Cerrar

                    </button>


                    <button type="button"
                            class="btn-editar"
                            @onclick="AbrirEditar">

                        <i class="bi bi-pencil-square"></i>
                        Editar

                    </button>

                </div>
            }

        </div>

    </div>
}


@* =========================================================
   MODAL CREAR
========================================================= *@

@if (modalActual == ModalTurno.Crear)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Nuevo Tipo de Turno</h2>

                    <p>
                        Complete los datos del tipo de turno.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        disabled="@guardando"
                        title="Cerrar"
                        @onclick="CerrarModal">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="CrearTurno">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE TURNO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Sesión individual" />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-input-group">

                            <span class="duration-prefix">
                                <i class="bi bi-clock"></i>
                            </span>

                            <InputNumber class="duration-input"
                                         @bind-Value="modelo.DuracionMinutos" />

                            <span class="duration-suffix-input">
                                minutos
                            </span>

                        </div>

                        <ValidationMessage For="@(() => modelo.DuracionMinutos)" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@guardando"
                            @onclick="CerrarModal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-guardar"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@* =========================================================
   MODAL EDITAR
========================================================= *@

@if (modalActual == ModalTurno.Editar)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Editar Tipo de Turno</h2>

                    <p>
                        Modifique los datos del tipo de turno.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        disabled="@guardando"
                        title="Volver al detalle"
                        @onclick="CancelarEdicion">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE TURNO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Sesión individual" />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group field-duration">

                        <label>DURACIÓN</label>

                        <div class="duration-input-group">

                            <span class="duration-prefix">
                                <i class="bi bi-clock"></i>
                            </span>

                            <InputNumber class="duration-input"
                                         @bind-Value="modelo.DuracionMinutos" />

                            <span class="duration-suffix-input">
                                minutos
                            </span>

                        </div>

                        <ValidationMessage For="@(() => modelo.DuracionMinutos)" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions edit-actions">

                    <button type="button"
                            class="btn-eliminar"
                            disabled="@guardando"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>

                        Eliminar Tipo de Turno

                    </button>


                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                disabled="@guardando"
                                @onclick="CancelarEdicion">

                            Cancelar

                        </button>


                        <button type="submit"
                                class="btn-guardar"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>

        </div>

    </div>
}


@* =========================================================
   CONFIRMAR ELIMINACIÓN
========================================================= *@

@if (mostrarConfirmacionEliminar)
{
    <div class="delete-modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>


            <h2>
                ¿Estás seguro que querés eliminar este tipo de turno?
            </h2>


            <p>
                Esta acción no se puede deshacer.
                El tipo de turno será eliminado definitivamente.
            </p>


            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    private enum ModalTurno
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }


    private List<TipoTurnoListadoDTO> lista = new();

    private TipoTurnoDTO modelo = CrearModeloVacio();

    private ModalTurno modalActual =
        ModalTurno.Ninguno;


    private int? idSeleccionado;


    private bool cargando = true;

    private bool cargandoDetalle = false;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    private IEnumerable<TipoTurnoListadoDTO> TurnosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                item.DuracionMinutos
                    .ToString()
                    .Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;

        idSeleccionado = id;

        modelo = CrearModeloVacio();

        modalActual = ModalTurno.Detalle;

        cargandoDetalle = true;


        var resp =
            await Http.Get<TipoTurnoDTO>(
                $"api/tipoturno/{id}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalTurno.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void AbrirCrear()
    {
        Mensaje = string.Empty;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        modalActual = ModalTurno.Crear;
    }


    private async Task CrearTurno()
    {
        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Post<TipoTurnoDTO, int>(
                "api/tipoturno",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            modalActual = ModalTurno.Ninguno;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirEditar()
    {
        Mensaje = string.Empty;

        modalActual = ModalTurno.Editar;
    }


    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }


        Mensaje = string.Empty;

        cargandoDetalle = true;

        modalActual = ModalTurno.Detalle;


        var resp =
            await Http.Get<TipoTurnoDTO>(
                $"api/tipoturno/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalTurno.Editar;
        }


        cargandoDetalle = false;
    }


    private async Task GuardarCambios()
    {
        if (idSeleccionado is null)
            return;


        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Put<TipoTurnoDTO, string>(
                $"api/tipoturno/{idSeleccionado.Value}",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            await Cargar();

            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null)
            return;


        eliminando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Delete(
                $"api/tipoturno/{idSeleccionado.Value}"
            );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            modalActual = ModalTurno.Ninguno;

            idSeleccionado = null;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;


        cargandoDetalle = true;

        modalActual = ModalTurno.Detalle;


        var resp =
            await Http.Get<TipoTurnoDTO>(
                $"api/tipoturno/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalTurno.Ninguno;
        }


        cargandoDetalle = false;
    }


    private void CerrarModal()
    {
        if (guardando || eliminando)
            return;


        modalActual = ModalTurno.Ninguno;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        Mensaje = string.Empty;
    }


    private static TipoTurnoDTO CrearModeloVacio()
    {
        return new TipoTurnoDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            DuracionMinutos = 0
        };
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && valor.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            );
    }


    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }

}