@page "/tipoturno"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turnos-page">

    <div class="page-header">

        <div class="header-title">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>
            <h1>Tipos de Turno</h1>
            <p>Gestioná los tipos de turno disponibles en Senderos.</p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar tipo de turno..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>

            <button type="button"
                    class="btn-nuevo"
                    @onclick="IrACrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>

            </button>

        </div>

    </div>


    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando tipos de turno...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h2>No hay tipos de turno registrados</h2>

            <p>
                Todavía no se registraron tipos de turno.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nuevo-estado"
                    @onclick="IrACrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nuevo Tipo de Turno</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !TurnosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay tipos de turno que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">
                Limpiar búsqueda
            </button>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">
                <div>TIPO DE TURNO</div>
                <div>DESCRIPCIÓN</div>
                <div>DURACIÓN</div>
                <div></div>
            </div>


            <div class="list-body">

                @foreach (var item in TurnosFiltrados)
                {
                    <div class="turno-row"
                         @onclick="() => IrAEditar(item.Id)">

                        <div class="turno-info">

                            <div class="turno-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div class="turno-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">Sin nombre</span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        <div class="turno-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="turno-duracion">

                            <div class="duracion-badge">
                                <i class="bi bi-clock"></i>
                                <span>@item.DuracionMinutos min</span>
                            </div>

                        </div>


                        <div class="turno-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@TurnosFiltrados.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "tipo de turno" : "tipos de turno")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


@code {

    private List<TipoTurnoListadoDTO> lista = new();

    private bool cargando = true;

    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    private IEnumerable<TipoTurnoListadoDTO> TurnosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                item.DuracionMinutos
                    .ToString()
                    .Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );

        if (resp.Error)
        {
            lista = new();
            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }

        cargando = false;
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && valor.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            );
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void IrAEditar(int id)
    {
        Nav.NavigateTo(
            $"/tipoturno/editar/{id}"
        );
    }


    private void IrACrear()
    {
        Nav.NavigateTo(
            "/tipoturno/crear"
        );
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}