@page "/tipoturno"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<h3>Listado de Tipos de Turno</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="IrACrear">Nuevo Tipo de Turno</button>
</div>

@if (cargando)
{
    <p>Cargando registros...</p>
}
else if (lista == null || lista.Count == 0)
{
    <p>No hay tipos de turno registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Duración (min)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in lista)
            {
                <tr style="cursor:pointer" @onclick="() => IrAEditar(item.Id)">
                    <td>@item.Id</td>
                    <td>@item.Tipo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.DuracionMinutos</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>@Mensaje</p>

@code {
    private List<TipoTurnoListadoDTO> lista = new();
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        var resp = await Http.Get<List<TipoTurnoListadoDTO>>("api/tipoturno/ListaTipoTurno");
        lista = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        cargando = false;
    }

    private void IrAEditar(int id)
    {
        Nav.NavigateTo($"/tipoturno/editar/{id}");
    }

    private void IrACrear()
    {
        Nav.NavigateTo("/tipoturno/crear");
    }
}
