@page "/tipoturno/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turno-form-page">

    <div class="turno-card">

        <div class="card-header">

            <div>
                <button type="button"
                        class="back-button"
                        @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </button>
                <h1>Nuevo Tipo de Turno</h1>
                <p>Complete los datos del tipo de turno.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="turno-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />


            <div class="field-group">

                <label>TIPO DE TURNO</label>

                <InputText class="senderos-input"
                           @bind-Value="modelo.Tipo"
                           placeholder="Ej: Sesión individual, Evaluación inicial..." />

                <ValidationMessage For="@(() => modelo.Tipo)" />

            </div>


            <div class="field-group">

                <label>DESCRIPCIÓN</label>

                <InputTextArea class="senderos-textarea"
                               @bind-Value="modelo.Descripcion"
                               placeholder="Ingrese una descripción del tipo de turno" />

                <ValidationMessage For="@(() => modelo.Descripcion)" />

            </div>


            <div class="field-group">

                <label>DURACIÓN</label>

                <div class="duration-input-group">

                    <div class="duration-icon">
                        <i class="bi bi-clock"></i>
                    </div>

                    <InputNumber class="duration-input"
                                 @bind-Value="modelo.DuracionMinutos"
                                 min="0"
                                 step="5" />

                    <div class="duration-suffix">
                        minutos
                    </div>

                </div>

                <ValidationMessage For="@(() => modelo.DuracionMinutos)" />

            </div>


            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>
                </div>
            }


            <div class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar</span>
                    }

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private TipoTurnoDTO modelo = new()
    {
        Tipo = string.Empty,
        Descripcion = string.Empty,
        DuracionMinutos = 0
    };

    private bool guardando = false;

    private string Mensaje = string.Empty;


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Post<TipoTurnoDTO, int>(
                "api/tipoturno",
                modelo
            );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/tipoturno",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/tipoturno");
    }
    private void Volver()
    {
        Nav.NavigateTo("/tipoturno");
    }

}