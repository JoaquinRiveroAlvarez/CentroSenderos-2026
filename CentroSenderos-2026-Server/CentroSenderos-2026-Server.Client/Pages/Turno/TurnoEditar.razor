@page "/turnos/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<PageTitle>Editar turno</PageTitle>

<div class="turno-editar-page">

    <button type="button"
            class="btn-volver"
            disabled="@OperacionEnCurso"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>
    </button>

    <header class="editar-header">

        <div>
            <h1>Editar turno</h1>
            <p>Modificá los datos, el horario o el estado del turno.</p>
        </div>

        @if (!cargando && string.IsNullOrWhiteSpace(errorCarga))
        {
            <span class="turno-identificador">
                Turno #@id
            </span>
        }

    </header>

    @if (cargando)
    {
        <div class="estado-pagina">

            <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando los datos del turno...</span>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="estado-pagina estado-error">

            <i class="bi bi-exclamation-circle"></i>

            <div>
                <strong>No pudimos cargar el turno</strong>
                <p>@errorCarga</p>
            </div>

        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnSubmit="SolicitarGuardado"
                  class="turno-editar-form">

            @if (mostrarSelectorProfesionales || mostrarSelectorPacientes)
            {
                <button type="button"
                        class="selector-cierre-fondo"
                        aria-label="Cerrar selectores"
                        @onclick="CerrarSelectores">
                </button>
            }

            <div class="editar-contenido">

                <section class="editar-card datos-card">

                    <div class="seccion-encabezado">

                        <span class="seccion-numero">01</span>

                        <div>
                            <h2>Datos del turno</h2>
                            <p>Actualizá la fecha, la hora y el consultorio.</p>
                        </div>

                    </div>

                    @if (modelo.SerieTurnoId.HasValue)
                    {
                        <fieldset class="alcance-edicion"
                                  disabled="@OperacionEnCurso">

                            <legend>¿Qué turnos querés modificar?</legend>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@(!modelo.ModificarTodaLaSerie)"
                                       @onchange="SeleccionarEdicionIndividual" />

                                <span class="alcance-opcion-contenido">

                                    <strong>Solo este turno</strong>

                                    <small>
                                        Los demás turnos de la serie no se modificarán.
                                    </small>

                                </span>

                            </label>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@modelo.ModificarTodaLaSerie"
                                       @onchange="SeleccionarEdicionSerie" />

                                <span class="alcance-opcion-contenido">

                                    <strong>
                                        Todos los turnos futuros de la serie
                                    </strong>

                                    <small>
                                        Se actualizarán las ocurrencias de hoy en adelante.
                                        Los turnos anteriores conservarán sus datos.
                                    </small>

                                </span>

                            </label>

                        </fieldset>
                    }

                    <div class="campos-grid">

                        <div class="campo campo-completo">

                            <label for="tipoTurno">Tipo de turno</label>

                            <div class="select-contenedor">

                                <InputSelect id="tipoTurno"
                                             class="control-formulario"
                                             disabled="@OperacionEnCurso"
                                             @bind-Value="modelo.TipoTurnoId"
                                             @bind-Value:after="ActualizarHorariosPorCambio">

                                    <option value="0">
                                        Seleccionar tipo de turno
                                    </option>

                                    @foreach (var tipo in tiposTurno)
                                    {
                                        <option value="@tipo.Id">
                                            @tipo.Tipo (@tipo.DuracionMinutos min)
                                        </option>
                                    }

                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>

                            </div>

                        </div>

                        <div class="campo campo-completo">

                            <label for="consultorio">Consultorio</label>

                            <div class="select-contenedor">

                                <InputSelect id="consultorio"
                                             class="control-formulario"
                                             disabled="@OperacionEnCurso"
                                             @bind-Value="modelo.TipoConsultorioId"
                                             @bind-Value:after="ActualizarHorariosPorCambio">

                                    <option value="0">
                                        Seleccionar consultorio
                                    </option>

                                    @foreach (var consultorio in consultorios)
                                    {
                                        <option value="@consultorio.Id">
                                            @consultorio.Tipo
                                        </option>
                                    }

                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>

                            </div>

                        </div>

                        <div class="campo fecha-campo">

                            <label>Fecha</label>

                            <button type="button"
                                    class="selector-fecha"
                                    disabled="@(modelo.ModificarTodaLaSerie || OperacionEnCurso)"
                                    @onclick="AlternarCalendario">

                                @if (modelo.ModificarTodaLaSerie)
                                {
                                    <span class="campo-ayuda">
                                        Las fechas originales se conservarán y los cambios
                                        se aplicarán solamente a los turnos futuros.
                                    </span>
                                }

                                <span>@TextoFechaSeleccionada</span>

                                <i class="bi bi-calendar3"></i>

                            </button>

                            @if (calendarioAbierto)
                            {
                                <div class="calendario-personalizado">

                                    <div class="calendario-cabecera">

                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes anterior"
                                                disabled="@OperacionEnCurso"
                                                @onclick="MesAnterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>

                                        <strong>@TituloMesCalendario</strong>

                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes siguiente"
                                                disabled="@OperacionEnCurso"
                                                @onclick="MesSiguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>

                                    </div>

                                    <div class="calendario-semana">
                                        <span>Lu</span>
                                        <span>Ma</span>
                                        <span>Mi</span>
                                        <span>Ju</span>
                                        <span>Vi</span>
                                        <span>Sá</span>
                                        <span>Do</span>
                                    </div>

                                    <div class="calendario-dias">

                                        @foreach (var dia in DiasCalendario)
                                        {
                                            <button type="button"
                                                    class="@ObtenerClaseDia(dia)"
                                                    disabled="@(EsDiaPasado(dia) || OperacionEnCurso)"
                                                    @onclick="() => SeleccionarFecha(dia.Fecha)">
                                                @dia.Fecha.Day
                                            </button>
                                        }

                                    </div>

                                    <div class="calendario-pie">

                                        <button type="button"
                                                disabled="@OperacionEnCurso"
                                                @onclick="SeleccionarHoy">
                                            Hoy
                                        </button>

                                        <button type="button"
                                                @onclick="CerrarCalendario">
                                            Cerrar
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                    <div class="campo campo-completo">

                        <label>Profesionales</label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    disabled="@OperacionEnCurso"
                                    aria-expanded="@mostrarSelectorProfesionales"
                                    @onclick="AlternarSelectorProfesionales">

                                <span>@TextoProfesionalesSeleccionados</span>

                                <i class="bi @(mostrarSelectorProfesionales
                                    ? "bi-chevron-up"
                                    : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorProfesionales)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar profesional..."
                                               autocomplete="off"
                                               disabled="@OperacionEnCurso"
                                               @bind="busquedaProfesional"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (ProfesionalesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron profesionales.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var profesional in ProfesionalesFiltrados)
                                            {
                                                var estaSeleccionado =
                                                    modelo.ProfesionalIds.Contains(
                                                        profesional.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                            ? "selector-desplegable-opcion seleccionado"
                                                            : "selector-desplegable-opcion")"
                                                        disabled="@OperacionEnCurso"
                                                        @onclick="() => AlternarProfesional(profesional.Id)">

                                                    <span>@profesional.Nombre</span>

                                                    @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                    @if (modelo.ProfesionalIds.Count > 0)
                    {
                        <div class="campo campo-completo">

                            <div class="profesionales-prestaciones-lista">

                                @foreach (var profesionalId in modelo.ProfesionalIds)
                                {
                                    var profesional = profesionales.FirstOrDefault(
                                        item => item.Id == profesionalId
                                    );

                                    if (profesional is not null)
                                    {
                                        <div class="profesional-prestacion-card">

                                            <div class="profesional-prestacion-header">

                                                <div class="profesional-prestacion-identidad">

                                                    <span class="profesional-prestacion-icono">
                                                        <i class="bi bi-person"></i>
                                                    </span>

                                                    <div>

                                                        <strong>
                                                            @profesional.Nombre
                                                        </strong>

                                                        @if (!string.IsNullOrWhiteSpace(profesional.Area))
                                                        {
                                                            <span>@profesional.Area</span>
                                                        }

                                                    </div>

                                                </div>

                                                <button type="button"
                                                        class="profesional-prestacion-quitar"
                                                        title="Quitar profesional"
                                                        disabled="@OperacionEnCurso"
                                                        @onclick="() => QuitarProfesional(profesional.Id)">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>

                                            </div>

                                            <div class="profesional-prestacion-cuerpo">

                                                <label>Prestación</label>

                                                @if (profesional.TipoPrestacionIds.Count == 0)
                                                {
                                                    <div class="profesional-sin-prestaciones">

                                                        <i class="bi bi-exclamation-circle"></i>

                                                        <span>
                                                            Este profesional no tiene
                                                            prestaciones disponibles.
                                                        </span>

                                                    </div>
                                                }
                                                else if (profesional.TipoPrestacionIds.Count == 1)
                                                {
                                                    <div class="prestacion-automatica">

                                                        <i class="bi bi-check-circle"></i>

                                                        <span>
                                                            @(profesional.TipoPrestacionNombres
                                                                .FirstOrDefault()
                                                                ?? "Prestación")
                                                        </span>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <select class="control-formulario"
                                                            disabled="@OperacionEnCurso"
                                                            value="@ObtenerPrestacionSeleccionada(profesional.Id)"
                                                            @onchange="evento => SeleccionarPrestacion(profesional.Id, evento)">

                                                        <option value="0">
                                                            Seleccioná una prestación
                                                        </option>

                                                        @for (
                                                            var indice = 0;
                                                            indice < profesional.TipoPrestacionIds.Count;
                                                            indice++)
                                                        {
                                                            var prestacionId =
                                                                profesional.TipoPrestacionIds[indice];

                                                            var nombrePrestacion =
                                                                indice < profesional.TipoPrestacionNombres.Count
                                                                    ? profesional.TipoPrestacionNombres[indice]
                                                                    : "Prestación";

                                                            <option value="@prestacionId">
                                                                @nombrePrestacion
                                                            </option>
                                                        }

                                                    </select>
                                                }

                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                        </div>
                    }

                    <div class="campo campo-completo">

                        <label>
                            Pacientes @(RequierePacientes
                                                            ? "(obligatorio)"
                                                            : "(opcional)")
                        </label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    disabled="@OperacionEnCurso"
                                    aria-expanded="@mostrarSelectorPacientes"
                                    @onclick="AlternarSelectorPacientes">

                                <span>@TextoPacientesSeleccionados</span>

                                <i class="bi @(mostrarSelectorPacientes
                                    ? "bi-chevron-up"
                                    : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorPacientes)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar paciente..."
                                               autocomplete="off"
                                               disabled="@OperacionEnCurso"
                                               @bind="busquedaPaciente"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (PacientesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron pacientes.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var paciente in PacientesFiltrados)
                                            {
                                                var estaSeleccionado =
                                                    modelo.PacienteIds.Contains(
                                                        paciente.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                            ? "selector-desplegable-opcion seleccionado"
                                                            : "selector-desplegable-opcion")"
                                                        disabled="@OperacionEnCurso"
                                                        @onclick="() => AlternarPaciente(paciente.Id)">

                                                    <span>@paciente.Nombre</span>

                                                    @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                </div>
                            }

                        </div>

                        @if (modelo.PacienteIds.Count > 0)
                        {
                            <div class="selector-multiple-seleccionados">

                                @foreach (var pacienteId in modelo.PacienteIds)
                                {
                                    <span class="selector-multiple-chip">

                                        @ObtenerNombrePaciente(pacienteId)

                                        <button type="button"
                                                title="Quitar paciente"
                                                disabled="@OperacionEnCurso"
                                                @onclick="() => QuitarPaciente(pacienteId)">
                                            <i class="bi bi-x"></i>
                                        </button>

                                    </span>
                                }

                            </div>
                        }

                    </div>

                    <div class="campo campo-completo editar-asistencia">

                        <div class="editar-asistencia-encabezado">

                            <strong>Asistencia por paciente</strong>

                            <p>
                                Se guarda al seleccionar una opción y corresponde
                                únicamente al turno #@id.
                                Cancelar no revierte la asistencia ya guardada.
                            </p>

                        </div>

                        @if (modelo.ModificarTodaLaSerie)
                        {
                            <p class="editar-asistencia-aviso">
                                La asistencia no se aplica a los demás turnos de la serie.
                            </p>
                        }

                        @if (modelo.PacienteIds.Count == 0)
                        {
                            <p class="editar-asistencia-vacio">
                                No hay pacientes asignados.
                            </p>
                        }
                        else
                        {
                            <div class="editar-asistencia-lista">

                                @foreach (var pacienteId in modelo.PacienteIds)
                                {
                                    var pacienteGuardado =
                                        pacientesGuardados.Contains(pacienteId);

                                    var asistenciaActual =
                                        asistenciasGuardadas.GetValueOrDefault(
                                            pacienteId
                                        );

                                    <article class="editar-asistencia-paciente">

                                        <strong>
                                            @ObtenerNombrePaciente(pacienteId)
                                        </strong>

                                        @if (pacienteGuardado)
                                        {
                                            <div class="editar-asistencia-opciones"
                                                 role="group"
                                                 aria-label="@($"Asistencia de {ObtenerNombrePaciente(pacienteId)}")"
                                                 aria-busy="@(pacienteGuardandoAsistencia == pacienteId)">

                                                @foreach (var asistencia in OpcionesAsistencia)
                                                {
                                                    <button type="button"
                                                            class="@($"{ObtenerClaseAsistencia(asistencia)} {(asistenciaActual == asistencia ? "activa" : "")}")"
                                                            disabled="@OperacionEnCurso"
                                                            aria-pressed="@(asistenciaActual == asistencia ? "true" : "false")"
                                                            @onclick="() => GuardarAsistenciaPaciente(pacienteId, asistencia)">

                                                        @ObtenerTextoAsistencia(asistencia)

                                                    </button>
                                                }

                                            </div>

                                            @if (pacienteGuardandoAsistencia == pacienteId)
                                            {
                                                <p class="editar-asistencia-mensaje"
                                                   role="status">
                                                    Guardando...
                                                </p>
                                            }
                                            else if (
                                                pacienteMensajeAsistencia == pacienteId &&
                                                !string.IsNullOrWhiteSpace(mensajeAsistencia))
                                            {
                                                <p class="editar-asistencia-mensaje @(errorAsistencia ? "es-error" : "")"
                                                   role="status">
                                                    @mensajeAsistencia
                                                </p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="editar-asistencia-aviso">
                                                Guardá los cambios del turno y volvé a abrir
                                                Editar para registrar la asistencia
                                                de este paciente nuevo.
                                            </p>
                                        }

                                    </article>
                                }

                            </div>
                        }

                    </div>

                </section>

                <aside class="editar-lateral">

                    <section class="editar-card horarios-card">

                        <div class="seccion-encabezado">

                            <span class="seccion-numero">02</span>

                            <div>
                                <h2>Horarios disponibles</h2>
                                <p>Elegí el horario de inicio para el turno.</p>
                            </div>

                        </div>

                        @if (consultandoHorarios)
                        {
                            <div class="horarios-cargando">

                                <span class="spinner-border spinner-border-sm"
                                      role="status">
                                </span>

                                <span>Actualizando horarios...</span>

                            </div>
                        }
                        else if (!horariosConsultados)
                        {
                            <div class="horarios-vacio">

                                <i class="bi bi-clock"></i>

                                <p>
                                    Completá los datos del turno para consultar
                                    la disponibilidad.
                                </p>

                            </div>
                        }
                        else if (horasDisponibles.Count == 0)
                        {
                            <div class="horarios-vacio">

                                <i class="bi bi-calendar-x"></i>

                                <p>
                                    No hay horarios disponibles para esta selección.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="@(MostrarNavegacionHorarios
                                 ? "horarios-navegacion"
                                 : "horarios-navegacion sin-flechas")">

                                @if (MostrarNavegacionHorarios)
                                {
                                    <button type="button"
                                            class="horarios-flecha"
                                            title="Horarios anteriores"
                                            disabled="@(!PuedeRetrocederHorarios || OperacionEnCurso)"
                                            @onclick="RetrocederHorarios">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                }

                                <div class="horarios-grid">

                                    @foreach (var hora in HorariosVisibles)
                                    {
                                        <button type="button"
                                                class="@ObtenerClaseHorario(hora)"
                                                disabled="@OperacionEnCurso"
                                                @onclick="() => SeleccionarHora(hora)">
                                            @hora
                                        </button>
                                    }

                                </div>

                                @if (MostrarNavegacionHorarios)
                                {
                                    <button type="button"
                                            class="horarios-flecha"
                                            title="Horarios siguientes"
                                            disabled="@(!PuedeAvanzarHorarios || OperacionEnCurso)"
                                            @onclick="AvanzarHorarios">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                }

                            </div>
                        }

                    </section>

                    <section class="editar-card estado-card">

                        <div class="seccion-encabezado">

                            <span class="seccion-numero">03</span>

                            <div>
                                <h2>Estado del turno</h2>
                                <p>Indicá la situación actual.</p>
                            </div>

                        </div>

                        <div class="estados-lista">

                            @foreach (var estado in EstadosDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseEstado(estado)"
                                        disabled="@OperacionEnCurso"
                                        @onclick="() => SeleccionarEstado(estado)">

                                    <span class="estado-indicador"></span>
                                    <span>@ObtenerNombreEstado(estado)</span>

                                    @if (modelo.EstadoTurno == estado)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }

                                </button>
                            }

                        </div>

                    </section>

                </aside>

                <section class="editar-card resumen-card resumen-card-inferior">

                    <div class="seccion-encabezado resumen-encabezado">

                        <span class="seccion-numero">04</span>

                        <div>
                            <h2>Resumen</h2>
                            <p>Revisá los cambios antes de guardar.</p>
                        </div>

                    </div>

                    <div class="resumen-datos">

                        <div class="resumen-fila">
                            <span>Fecha</span>
                            <strong>@TextoFechaResumen</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Horario</span>
                            <strong>@TextoHorarioResumen</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Tipo</span>
                            <strong>@NombreTipoTurno</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Consultorio</span>
                            <strong>@NombreConsultorio</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Estado</span>
                            <strong class="resumen-estado">
                                @ObtenerNombreEstado(modelo.EstadoTurno)
                            </strong>
                        </div>

                    </div>

                </section>

            </div>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-formulario @(operacionExitosa ? "mensaje-exito" : "mensaje-error")">

                    <i class="bi @(operacionExitosa
                        ? "bi-check-circle"
                        : "bi-exclamation-circle")">
                    </i>

                    <span>@Mensaje</span>

                </div>
            }

            <footer class="acciones-formulario">

                <button type="button"
                        class="btn-eliminar"
                        disabled="@OperacionEnCurso"
                        @onclick="SolicitarEliminacion">
                    <i class="bi bi-trash3"></i>
                    <span>Eliminar turno</span>
                </button>

                <div class="acciones-principales">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@OperacionEnCurso"
                            @onclick="Volver">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-guardar"
                            disabled="@OperacionEnCurso">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Guardar cambios</span>
                        }

                    </button>

                </div>

            </footer>

        </EditForm>
    }

</div>

@if (mostrarConfirmacionSerie)
{
    <div class="modal-fondo"
         @onclick="CancelarEdicionSerie">

        <div class="modal-eliminar"
             @onclick:stopPropagation="true">

            <div class="modal-icono">
                <i class="bi bi-calendar-check"></i>
            </div>

            <h2>¿Modificar los turnos futuros?</h2>

            <p>
                Se actualizarán todos los turnos futuros de la serie.
                Los turnos anteriores no se modificarán.
            </p>

            <div class="modal-acciones">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@OperacionEnCurso"
                        @onclick="CancelarEdicionSerie">
                    No, volver
                </button>

                <button type="button"
                        class="btn-guardar"
                        disabled="@OperacionEnCurso"
                        @onclick="ConfirmarEdicionSerie">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Sí, modificar</span>
                    }

                </button>

            </div>

        </div>

    </div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-fondo"
         @onclick="CancelarEliminacion">

        <div class="modal-eliminar"
             @onclick:stopPropagation="true">

            <div class="modal-icono">
                <i class="bi bi-trash3"></i>
            </div>

            <h2>¿Eliminar este turno?</h2>

            <p>
                Esta acción eliminará el turno del
                <strong>@TextoFechaResumen</strong>
                a las
                <strong>@modelo.Hora.ToString("HH:mm")</strong>.
            </p>

            <div class="modal-acciones">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@OperacionEnCurso"
                        @onclick="CancelarEliminacion">
                    No, conservar
                </button>

                <button type="button"
                        class="btn-confirmar-eliminar"
                        disabled="@OperacionEnCurso"
                        @onclick="Eliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3"></i>
                        <span>Sí, eliminar</span>
                    }

                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int id { get; set; }

    [SupplyParameterFromQuery(Name = "volverADetalle")]
    public bool VolverADetalle { get; set; }

    [SupplyParameterFromQuery(Name = "volverAVista")]
    public bool VolverAVista { get; set; }

    [SupplyParameterFromQuery(Name = "vistaOrigen")]
    public string? VistaOrigen { get; set; }

    [SupplyParameterFromQuery(Name = "fechaOrigen")]
    public string? FechaOrigen { get; set; }

    [SupplyParameterFromQuery(Name = "consultorios")]
    public string? ConsultoriosDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "tipos")]
    public string? TiposDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "profesionales")]
    public string? ProfesionalesDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "pacientes")]
    public string? PacientesDesdeUrl { get; set; }

    private TurnoDTO modelo = new();

    private List<ProfesionalListadoDTO> profesionales = new();
    private List<PacienteResumenDTO> pacientes = new();
    private List<TipoTurnoListadoDTO> tiposTurno = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();
    private List<string> horasDisponibles = new();

    private const int HorariosPorPagina = 24;
    private int paginaHorarios;
    private int versionConsultaHorarios;

    private string horaSeleccionada = string.Empty;
    private string busquedaProfesional = string.Empty;
    private string busquedaPaciente = string.Empty;
    private string Mensaje = string.Empty;
    private string errorCarga = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool consultandoHorarios;
    private bool horariosConsultados;
    private bool operacionExitosa;
    private bool calendarioAbierto;
    private bool mostrarConfirmacionEliminar;
    private bool mostrarConfirmacionSerie;
    private bool mostrarSelectorProfesionales;
    private bool mostrarSelectorPacientes;

    private HashSet<int> pacientesGuardados = new();

    private Dictionary<int, EnumAsistenciaPaciente?>
        asistenciasGuardadas = new();

    private int? pacienteGuardandoAsistencia;
    private int? pacienteMensajeAsistencia;

    private string mensajeAsistencia = string.Empty;
    private bool errorAsistencia;

    private bool OperacionEnCurso =>
        guardando ||
        eliminando ||
        pacienteGuardandoAsistencia.HasValue;

    private DateTime mesCalendario = new(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1
    );

    private bool RequierePacientes =>
        tiposTurno.FirstOrDefault(
            tipo => tipo.Id == modelo.TipoTurnoId
        )?.RequierePacientes ?? true;

    private bool SeleccionPacientesValida =>
        !RequierePacientes || modelo.PacienteIds.Count > 0;

    private readonly EnumEstadoTurno[] EstadosDisponibles =
    {
        EnumEstadoTurno.reservado,
        EnumEstadoTurno.atendido,
        EnumEstadoTurno.cancelado,
        EnumEstadoTurno.ausente
    };

    private readonly EnumAsistenciaPaciente?[] OpcionesAsistencia =
    {
        null,
        EnumAsistenciaPaciente.asistio,
        EnumAsistenciaPaciente.ausente
    };

    private bool PuedeGuardar =>
        !consultandoHorarios &&
        horariosConsultados &&
        !string.IsNullOrWhiteSpace(horaSeleccionada) &&
        modelo.Fecha != default &&
        modelo.Hora != TimeOnly.MinValue &&
        modelo.TipoTurnoId > 0 &&
        modelo.TipoConsultorioId > 0 &&
        modelo.ProfesionalIds.Count > 0 &&
        modelo.ProfesionalIds.All(profesionalId =>
            modelo.ProfesionalPrestaciones.Any(seleccion =>
                seleccion.ProfesionalId == profesionalId &&
                seleccion.TipoPrestacionId > 0
            )
        ) &&
        SeleccionPacientesValida;

    private string TextoFechaSeleccionada =>
        modelo.Fecha == default
            ? "Seleccionar fecha"
            : modelo.Fecha.ToString(
                "dddd, d 'de' MMMM 'de' yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoFechaResumen =>
        modelo.Fecha == default
            ? "Sin seleccionar"
            : modelo.Fecha.ToString(
                "dd/MM/yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoHorarioResumen
    {
        get
        {
            if (modelo.Hora == TimeOnly.MinValue)
            {
                return "Sin seleccionar";
            }

            var duracion = ObtenerDuracionSeleccionada();

            if (duracion <= 0)
            {
                return modelo.Hora.ToString("HH:mm");
            }

            var horaFin = modelo.Hora.AddMinutes(duracion);

            return $"{modelo.Hora:HH\\:mm} - {horaFin:HH\\:mm}";
        }
    }

    private string NombreTipoTurno =>
        tiposTurno.FirstOrDefault(
            item => item.Id == modelo.TipoTurnoId
        )?.Tipo ?? "Sin seleccionar";

    private string NombreConsultorio =>
        consultorios.FirstOrDefault(
            item => item.Id == modelo.TipoConsultorioId
        )?.Tipo ?? "Sin seleccionar";

    private string TituloMesCalendario =>
        mesCalendario.ToString(
            "MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-AR")
        );

    private IEnumerable<string> HorariosVisibles =>
        horasDisponibles
            .Skip(paginaHorarios * HorariosPorPagina)
            .Take(HorariosPorPagina);

    private int CantidadPaginasHorarios =>
        (int)Math.Ceiling(
            horasDisponibles.Count / (double)HorariosPorPagina
        );

    private bool MostrarNavegacionHorarios =>
        CantidadPaginasHorarios > 1;

    private bool PuedeRetrocederHorarios =>
        paginaHorarios > 0;

    private bool PuedeAvanzarHorarios =>
        paginaHorarios < CantidadPaginasHorarios - 1;

    private List<DiaCalendario> DiasCalendario
    {
        get
        {
            var primerDiaMes = new DateTime(
                mesCalendario.Year,
                mesCalendario.Month,
                1
            );

            var desplazamiento =
                ((int)primerDiaMes.DayOfWeek + 6) % 7;

            var primerDiaVisible =
                primerDiaMes.AddDays(-desplazamiento);

            return Enumerable.Range(0, 42)
                .Select(indice => new DiaCalendario
                {
                    Fecha = primerDiaVisible.AddDays(indice),

                    PerteneceAlMes =
                        primerDiaVisible.AddDays(indice).Month ==
                        mesCalendario.Month
                })
                .ToList();
        }
    }

    private List<ProfesionalListadoDTO> ProfesionalesFiltrados =>
        string.IsNullOrWhiteSpace(busquedaProfesional)
            ? profesionales
            : profesionales
                .Where(profesional =>
                    profesional.Nombre.Contains(
                        busquedaProfesional,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .ToList();

    private List<PacienteResumenDTO> PacientesFiltrados =>
        string.IsNullOrWhiteSpace(busquedaPaciente)
            ? pacientes
            : pacientes
                .Where(paciente =>
                    paciente.Nombre.Contains(
                        busquedaPaciente,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .ToList();

    private string TextoProfesionalesSeleccionados =>
        modelo.ProfesionalIds.Count switch
        {
            0 => "Seleccione profesionales",
            1 => "1 profesional seleccionado",
            _ => $"{modelo.ProfesionalIds.Count} profesionales seleccionados"
        };

    private string TextoPacientesSeleccionados =>
        modelo.PacienteIds.Count switch
        {
            0 => "Seleccione pacientes",
            1 => "1 paciente seleccionado",
            _ => $"{modelo.PacienteIds.Count} pacientes seleccionados"
        };

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        errorCarga = string.Empty;

        try
        {
            var respuestaTurno =
                await Http.Get<TurnoDTO>($"api/turno/{id}");

            if (respuestaTurno.Error ||
                respuestaTurno.Respuesta is null)
            {
                errorCarga = respuestaTurno.Error
                    ? ObtenerMensajeAmigable(
                        respuestaTurno.ObtenerError(),
                        "No pudimos cargar el turno. Intentá nuevamente."
                    )
                    : "No encontramos el turno solicitado.";

                return;
            }

            modelo = respuestaTurno.Respuesta;

            pacientesGuardados = modelo.PacienteIds.ToHashSet();

            asistenciasGuardadas = modelo.PacientesDetalle
                .GroupBy(paciente => paciente.PacienteId)
                .ToDictionary(
                    grupo => grupo.Key,
                    grupo => grupo.First().Asistencia
                );

            if (modelo.Hora != TimeOnly.MinValue)
            {
                horaSeleccionada = modelo.Hora.ToString("HH:mm");
            }

            if (modelo.Fecha != default)
            {
                mesCalendario = new DateTime(
                    modelo.Fecha.Year,
                    modelo.Fecha.Month,
                    1
                );
            }

            var respuestaTipos =
                await Http.Get<List<TipoTurnoListadoDTO>>(
                    "api/tipoturno/ListaTipoTurno"
                );

            if (!respuestaTipos.Error &&
                respuestaTipos.Respuesta is not null)
            {
                tiposTurno = respuestaTipos.Respuesta;
            }

            var respuestaConsultorios =
                await Http.Get<List<TipoConsultorioListadoDTO>>(
                    "api/tipoconsultorio/ListaTipoConsultorio"
                );

            if (!respuestaConsultorios.Error &&
                respuestaConsultorios.Respuesta is not null)
            {
                consultorios = respuestaConsultorios.Respuesta;
            }

            var respuestaProfesionales =
                await Http.Get<List<ProfesionalListadoDTO>>(
                    "api/profesional/ListaProfesional"
                );

            if (!respuestaProfesionales.Error &&
                respuestaProfesionales.Respuesta is not null)
            {
                profesionales = respuestaProfesionales.Respuesta;
            }

            var respuestaPacientes =
                await Http.Get<List<PacienteResumenDTO>>(
                    "api/paciente/ListaPaciente"
                );

            if (!respuestaPacientes.Error &&
                respuestaPacientes.Respuesta is not null)
            {
                pacientes = respuestaPacientes.Respuesta;
            }

            await CargarHorasDisponibles();
        }
        catch (TaskCanceledException)
        {
            errorCarga =
                "La carga tardó más de lo esperado. " +
                "Actualizá la página para intentarlo nuevamente.";
        }
        catch (HttpRequestException)
        {
            errorCarga =
                "No pudimos conectarnos con el servidor. " +
                "Verificá tu conexión e intentá nuevamente.";
        }
        catch (Exception)
        {
            errorCarga =
                "Ocurrió un problema al cargar el turno. " +
                "Actualizá la página para intentarlo nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerNombrePaciente(int pacienteId)
    {
        var paciente = pacientes.FirstOrDefault(
            item => item.Id == pacienteId
        );

        if (paciente is not null)
        {
            return paciente.Nombre;
        }

        return modelo.PacientesDetalle.FirstOrDefault(
            item => item.PacienteId == pacienteId
        )?.NombrePaciente ?? "Paciente";
    }

    private static string ObtenerTextoAsistencia(
        EnumAsistenciaPaciente? asistencia)
    {
        return asistencia switch
        {
            EnumAsistenciaPaciente.asistio => "Asistió",
            EnumAsistenciaPaciente.ausente => "Ausente",
            _ => "Sin registrar"
        };
    }

    private static string ObtenerClaseAsistencia(
        EnumAsistenciaPaciente? asistencia)
    {
        return asistencia switch
        {
            EnumAsistenciaPaciente.asistio =>
                "editar-asistencia-opcion es-presente",

            EnumAsistenciaPaciente.ausente =>
                "editar-asistencia-opcion es-ausente",

            _ => "editar-asistencia-opcion es-pendiente"
        };
    }

    private async Task GuardarAsistenciaPaciente(
        int pacienteId,
        EnumAsistenciaPaciente? asistencia)
    {
        if (OperacionEnCurso ||
            !pacientesGuardados.Contains(pacienteId) ||
            !modelo.PacienteIds.Contains(pacienteId) ||
            asistenciasGuardadas.GetValueOrDefault(pacienteId) == asistencia)
        {
            return;
        }

        pacienteGuardandoAsistencia = pacienteId;
        pacienteMensajeAsistencia = pacienteId;
        mensajeAsistencia = string.Empty;
        errorAsistencia = false;

        CerrarSelectores();

        try
        {
            var dto = new TurnoPacienteAsistenciaDTO
            {
                Asistencia = asistencia
            };

            var respuesta =
                await Http.Put<TurnoPacienteAsistenciaDTO, RespuestaDTO>(
                    $"api/turno/{id}/pacientes/{pacienteId}/asistencia",
                    dto
                );

            if (respuesta.Error)
            {
                errorAsistencia = true;

                mensajeAsistencia = ObtenerMensajeAmigable(
                    respuesta.ObtenerError(),
                    "No pudimos guardar la asistencia. Intentá nuevamente."
                );

                return;
            }

            asistenciasGuardadas[pacienteId] = asistencia;

            var pacienteDetalle = modelo.PacientesDetalle
                .FirstOrDefault(paciente =>
                    paciente.PacienteId == pacienteId
                );

            if (pacienteDetalle is not null)
            {
                pacienteDetalle.Asistencia = asistencia;
            }

            mensajeAsistencia = "Asistencia guardada.";
        }
        catch
        {
            errorAsistencia = true;

            mensajeAsistencia =
                "No pudimos guardar la asistencia. Intentá nuevamente.";
        }
        finally
        {
            pacienteGuardandoAsistencia = null;
        }
    }

    private void AlternarSelectorProfesionales()
    {
        if (OperacionEnCurso)
        {
            return;
        }

        mostrarSelectorProfesionales = !mostrarSelectorProfesionales;
        mostrarSelectorPacientes = false;
        busquedaPaciente = string.Empty;
    }

    private void CerrarSelectores()
    {
        mostrarSelectorProfesionales = false;
        mostrarSelectorPacientes = false;
        busquedaProfesional = string.Empty;
        busquedaPaciente = string.Empty;
    }

    private void AlternarSelectorPacientes()
    {
        if (OperacionEnCurso)
        {
            return;
        }

        mostrarSelectorPacientes = !mostrarSelectorPacientes;
        mostrarSelectorProfesionales = false;
        busquedaProfesional = string.Empty;
    }

    private async Task AlternarPaciente(int pacienteId)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        if (modelo.PacienteIds.Contains(pacienteId))
        {
            modelo.PacienteIds.Remove(pacienteId);
        }
        else
        {
            modelo.PacienteIds.Add(pacienteId);
        }

        SincronizarPacienteAnterior();

        await ActualizarHorariosPorCambio();
    }

    private async Task QuitarPaciente(int pacienteId)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        modelo.PacienteIds.Remove(pacienteId);

        SincronizarPacienteAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void SincronizarPacienteAnterior()
    {
        modelo.PacienteId = modelo.PacienteIds.FirstOrDefault();
        Mensaje = string.Empty;
    }

    private async Task AlternarProfesional(int profesionalId)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        if (modelo.ProfesionalIds.Contains(profesionalId))
        {
            modelo.ProfesionalIds.Remove(profesionalId);
            QuitarPrestacionDelProfesional(profesionalId);
        }
        else
        {
            modelo.ProfesionalIds.Add(profesionalId);
            SeleccionarPrestacionAutomatica(profesionalId);
        }

        SincronizarProfesionalAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void SeleccionarPrestacionAutomatica(int profesionalId)
    {
        var profesional = profesionales.FirstOrDefault(
            item => item.Id == profesionalId
        );

        if (profesional is null ||
            profesional.TipoPrestacionIds.Count != 1)
        {
            return;
        }

        modelo.ProfesionalPrestaciones.Add(
            new TurnoProfesionalPrestacionDTO
            {
                ProfesionalId = profesionalId,
                TipoPrestacionId = profesional.TipoPrestacionIds[0]
            }
        );

        modelo.TipoPrestacionIds = modelo.ProfesionalPrestaciones
            .Select(seleccion => seleccion.TipoPrestacionId)
            .Distinct()
            .ToList();
    }

    private async Task QuitarProfesional(int profesionalId)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        modelo.ProfesionalIds.Remove(profesionalId);

        QuitarPrestacionDelProfesional(profesionalId);
        SincronizarProfesionalAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void QuitarPrestacionDelProfesional(int profesionalId)
    {
        modelo.ProfesionalPrestaciones.RemoveAll(seleccion =>
            seleccion.ProfesionalId == profesionalId
        );

        modelo.TipoPrestacionIds = modelo.ProfesionalPrestaciones
            .Select(seleccion => seleccion.TipoPrestacionId)
            .Distinct()
            .ToList();
    }

    private void SincronizarProfesionalAnterior()
    {
        modelo.ProfesionalId = modelo.ProfesionalIds.FirstOrDefault();
        Mensaje = string.Empty;
    }

    private void SeleccionarEdicionIndividual(ChangeEventArgs argumento)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        modelo.ModificarTodaLaSerie = false;
        Mensaje = string.Empty;
    }

    private void SeleccionarEdicionSerie(ChangeEventArgs argumento)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        modelo.ModificarTodaLaSerie = true;
        calendarioAbierto = false;
        Mensaje = string.Empty;
    }

    private async Task ActualizarHorariosPorCambio()
    {
        Mensaje = string.Empty;
        horasDisponibles.Clear();
        horariosConsultados = false;

        versionConsultaHorarios++;

        var seleccionCompleta =
            modelo.Fecha != default &&
            modelo.TipoTurnoId > 0 &&
            modelo.TipoConsultorioId > 0 &&
            modelo.ProfesionalIds.Count > 0 &&
            modelo.ProfesionalPrestaciones.Count ==
                modelo.ProfesionalIds.Count &&
            modelo.ProfesionalPrestaciones.All(seleccion =>
                seleccion.TipoPrestacionId > 0 &&
                modelo.ProfesionalIds.Contains(
                    seleccion.ProfesionalId
                )
            ) &&
            SeleccionPacientesValida;

        if (!seleccionCompleta)
        {
            consultandoHorarios = false;
            return;
        }

        await CargarHorasDisponibles();
    }

    private async Task CargarHorasDisponibles()
    {
        var versionActual = ++versionConsultaHorarios;

        Mensaje = string.Empty;
        horasDisponibles.Clear();
        paginaHorarios = 0;
        horariosConsultados = false;

        if (modelo.TipoTurnoId <= 0 ||
            modelo.TipoConsultorioId <= 0 ||
            modelo.ProfesionalIds.Count == 0 ||
            !SeleccionPacientesValida ||
            modelo.Fecha == DateTime.MinValue)
        {
            consultandoHorarios = false;
            return;
        }

        consultandoHorarios = true;

        var parametrosProfesionales = string.Concat(
            modelo.ProfesionalIds.Select(profesionalId =>
                $"&profesionalIds={profesionalId}"
            )
        );

        var parametrosPacientes = string.Concat(
            modelo.PacienteIds.Select(pacienteId =>
                $"&pacienteIds={pacienteId}"
            )
        );

        var url =
            "api/turno/Disponibles" +
            $"?fecha={modelo.Fecha:yyyy-MM-dd}" +
            $"&tipoTurnoId={modelo.TipoTurnoId}" +
            $"&consultorioId={modelo.TipoConsultorioId}" +
            $"&turnoIdExcluir={id}" +
            parametrosProfesionales +
            parametrosPacientes;

        try
        {
            var respuesta = await Http.Get<List<string>>(url);

            if (versionActual != versionConsultaHorarios)
            {
                return;
            }

            consultandoHorarios = false;

            if (respuesta.Error)
            {
                horariosConsultados = false;

                Mensaje = ObtenerMensajeAmigable(
                    respuesta.ObtenerError(),
                    "No pudimos consultar los horarios disponibles. " +
                    "Intentá nuevamente."
                );

                return;
            }

            horariosConsultados = true;

            horasDisponibles =
                respuesta.Respuesta ?? new List<string>();

            if (!string.IsNullOrWhiteSpace(horaSeleccionada) &&
                !horasDisponibles.Contains(horaSeleccionada))
            {
                horaSeleccionada = string.Empty;
                modelo.Hora = TimeOnly.MinValue;
            }
        }
        catch (TaskCanceledException)
        {
            if (versionActual == versionConsultaHorarios)
            {
                consultandoHorarios = false;
                horariosConsultados = false;

                Mensaje =
                    "La consulta de horarios tardó más de lo esperado. " +
                    "Cambiá la selección para intentarlo nuevamente.";
            }
        }
        catch (HttpRequestException)
        {
            if (versionActual == versionConsultaHorarios)
            {
                consultandoHorarios = false;
                horariosConsultados = false;

                Mensaje =
                    "No pudimos conectarnos con el servidor para consultar " +
                    "los horarios. Verificá tu conexión e intentá nuevamente.";
            }
        }
        catch (Exception)
        {
            if (versionActual == versionConsultaHorarios)
            {
                consultandoHorarios = false;
                horariosConsultados = false;

                Mensaje =
                    "Ocurrió un problema al consultar los horarios. " +
                    "Intentá nuevamente.";
            }
        }
    }

