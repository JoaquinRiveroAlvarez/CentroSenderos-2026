    private async Task Eliminar()
    {
        if (eliminando)
        {
            return;
        }

        eliminando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        var respuesta =
            await Http.Delete($"api/turno/{id}");

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            return;
        }

        operacionExitosa = true;
        Mensaje = "Turno eliminado correctamente.";

        var vistaDestino =
    string.IsNullOrWhiteSpace(VistaOrigen)
        ? "diaria"
        : VistaOrigen;

        var fechaDestino =
            string.IsNullOrWhiteSpace(FechaOrigen)
                ? modelo.Fecha.ToString("yyyy-MM-dd")
                : FechaOrigen;

        Nav.NavigateTo(
    "/turnos" +
    "?estado=eliminado" +
    $"&vista={vistaDestino}" +
    $"&fecha={fechaDestino}" +
    ObtenerFiltrosParaRegreso(),
    forceLoad: true
);
    }
    private string ObtenerFiltrosParaRegreso()
    {
        return
            $"&consultorios={ConsultoriosDesdeUrl ?? string.Empty}" +
            $"&tipos={TiposDesdeUrl ?? string.Empty}";
    }
    private async Task SolicitarGuardado()
    {
        if (!PuedeGuardar || guardando)
        {
            return;
        }

        if (modelo.ModificarTodaLaSerie)
        {
            mostrarConfirmacionSerie = true;
            return;
        }

        await Grabar();
    }

    private void CancelarEdicionSerie()
    {
        if (!guardando)
        {
            mostrarConfirmacionSerie = false;
        }
    }

    private async Task ConfirmarEdicionSerie()
    {
        if (guardando)
        {
            return;
        }

        mostrarConfirmacionSerie = false;

        await Grabar();
    }


    private int ObtenerPrestacionSeleccionada(int profesionalId)
    {
        return modelo.ProfesionalPrestaciones
            .FirstOrDefault(seleccion =>
                seleccion.ProfesionalId ==
                profesionalId
            )
            ?.TipoPrestacionId ?? 0;
    }

    private void SeleccionarPrestacion(int profesionalId, ChangeEventArgs evento)
    {
        if (!int.TryParse(
                evento.Value?.ToString(),
                out var tipoPrestacionId
            ))
        {
            tipoPrestacionId = 0;
        }

        var seleccionActual =
            modelo.ProfesionalPrestaciones
                .FirstOrDefault(seleccion =>
                    seleccion.ProfesionalId ==
                    profesionalId
                );

        if (tipoPrestacionId == 0)
        {
            if (seleccionActual is not null)
            {
                modelo.ProfesionalPrestaciones.Remove(
                    seleccionActual
                );
            }
        }
        else if (seleccionActual is null)
        {
            modelo.ProfesionalPrestaciones.Add(
                new TurnoProfesionalPrestacionDTO
                {
                    ProfesionalId = profesionalId,
                    TipoPrestacionId =
                        tipoPrestacionId
                }
            );
        }
        else
        {
            seleccionActual.TipoPrestacionId =
                tipoPrestacionId;
        }

        modelo.TipoPrestacionIds =
            modelo.ProfesionalPrestaciones
                .Select(seleccion =>
                    seleccion.TipoPrestacionId
                )
                .Distinct()
                .ToList();

        Mensaje = string.Empty;
    }

    // Reconstruye una única pareja profesional-prestación antes de enviar el DTO.
    // Evita que queden relaciones de profesionales eliminados o selecciones duplicadas.
    private bool PrepararPrestacionesParaGuardar()
    {
        var profesionalIdsSeleccionados =
            modelo.ProfesionalIds
                .Where(profesionalId =>
                    profesionalId > 0
                )
                .Distinct()
                .ToHashSet();

        var relacionesNormalizadas =
            modelo.ProfesionalPrestaciones
                .Where(seleccion =>
                    profesionalIdsSeleccionados.Contains(
                        seleccion.ProfesionalId
                    ) &&
                    seleccion.TipoPrestacionId > 0
                )
                .GroupBy(seleccion =>
                    seleccion.ProfesionalId
                )
                .Select(grupo =>
                    grupo.First()
                )
                .ToList();

        foreach (var profesionalId in
                 profesionalIdsSeleccionados)
        {
            var profesional =
                profesionales.FirstOrDefault(item =>
                    item.Id == profesionalId
                );

            var seleccion =
                relacionesNormalizadas.FirstOrDefault(item =>
                    item.ProfesionalId == profesionalId
                );

            if (profesional is null ||
                seleccion is null)
            {
                Mensaje =
                    "Debe seleccionar una prestación para cada profesional.";

                return false;
            }

            if (!profesional.TipoPrestacionIds.Contains(
                    seleccion.TipoPrestacionId
                ))
            {
                Mensaje =
                    $"La prestación seleccionada no está asignada a " +
                    $"{profesional.Nombre}.";

                return false;
            }
        }

        modelo.ProfesionalPrestaciones =
            relacionesNormalizadas;

        modelo.TipoPrestacionIds =
            relacionesNormalizadas
                .Select(seleccion =>
                    seleccion.TipoPrestacionId
                )
                .Distinct()
                .ToList();

        return true;
    }

    private async Task Grabar()
    {
        if (!PuedeGuardar || guardando)
        {
            return;
        }

        if (!PrepararPrestacionesParaGuardar())
        {
            return;
        }

        guardando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        var respuesta =
            await Http.Put<TurnoDTO, RespuestaDTO>(
                $"api/turno/{id}",
                modelo
            );

        if (respuesta.Error)
        {
            Mensaje =
                respuesta.Respuesta?.mensaje ??
                respuesta.ObtenerError();

            guardando = false;
            return;
        }

        operacionExitosa = true;
        Mensaje = respuesta.Respuesta?.mensaje
            ?? "Turno actualizado correctamente.";

        guardando = false;

        await Task.Delay(500);

        var estadoResultado = modelo.ModificarTodaLaSerie
    ? "serie-actualizada"
    : "actualizado";

        var vistaDestino =
            string.IsNullOrWhiteSpace(VistaOrigen)
                ? "diaria"
                : VistaOrigen;

        var fechaDestino =
            string.IsNullOrWhiteSpace(FechaOrigen)
                ? modelo.Fecha.ToString("yyyy-MM-dd")
                : FechaOrigen;

        Nav.NavigateTo(
    "/turnos" +
    $"?estado={estadoResultado}" +
    $"&vista={vistaDestino}" +
    $"&fecha={fechaDestino}" +
    ObtenerFiltrosParaRegreso(),
    forceLoad: true
);
    }
    private void Volver()
    {
        var vista =
            string.IsNullOrWhiteSpace(VistaOrigen)
                ? "diaria"
                : VistaOrigen;

        var fecha =
            string.IsNullOrWhiteSpace(FechaOrigen)
                ? modelo.Fecha.ToString("yyyy-MM-dd")
                : FechaOrigen;

        var filtros =
            ObtenerFiltrosParaRegreso();

        if (VolverADetalle)
        {
            Nav.NavigateTo(
                "/turnos" +
                $"?detalle={id}" +
                $"&vista={vista}" +
                $"&fecha={fecha}" +
                filtros
            );

            return;
        }

        Nav.NavigateTo(
            "/turnos" +
            $"?vista={vista}" +
            $"&fecha={fecha}" +
            filtros
        );
    }

    private sealed class DiaCalendario
    {
        public DateTime Fecha { get; set; }

        public bool PerteneceAlMes { get; set; }
    }
}
