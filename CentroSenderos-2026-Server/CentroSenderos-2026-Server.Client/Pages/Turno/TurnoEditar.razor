    private void SeleccionarHoy()
    {
        SeleccionarFecha(DateTime.Today);
    }

    private void SeleccionarFecha(DateTime fecha)
    {
        if (EsDiaPasado(new DiaCalendario { Fecha = fecha }))
        {
            return;
        }

        modelo.Fecha = fecha.Date;

        mesCalendario = new DateTime(
            fecha.Year,
            fecha.Month,
            1
        );

        calendarioAbierto = false;
    }

    private bool EsDiaPasado(DiaCalendario dia)
    {
        return dia.Fecha.Date < DateTime.Today;
    }

    private string ObtenerClaseDia(DiaCalendario dia)
    {
        var clases = new List<string>
        {
            "calendario-dia"
        };

        if (!dia.PerteneceAlMes)
        {
            clases.Add("otro-mes");
        }

        if (dia.Fecha.Date == DateTime.Today)
        {
            clases.Add("dia-hoy");
        }

        if (modelo.Fecha != default &&
            dia.Fecha.Date == modelo.Fecha.Date)
        {
            clases.Add("dia-seleccionado");
        }

        if (EsDiaPasado(dia))
        {
            clases.Add("dia-deshabilitado");
        }

        return string.Join(" ", clases);
    }

    private void SeleccionarEstado(EnumEstadoTurno estado)
    {
        modelo.EstadoTurno = estado;
    }

    private string ObtenerClaseEstado(EnumEstadoTurno estado)
    {
        var clase = "estado-opcion";

        if (modelo.EstadoTurno == estado)
        {
            clase += " estado-seleccionado";
        }

        clase += estado switch
        {
            EnumEstadoTurno.disponible => " estado-disponible",
            EnumEstadoTurno.reservado => " estado-reservado",
            EnumEstadoTurno.atendido => " estado-atendido",
            EnumEstadoTurno.cancelado => " estado-cancelado",
            EnumEstadoTurno.ausente => " estado-ausente",
            _ => string.Empty
        };

        return clase;
    }

    private static string ObtenerNombreEstado(
        EnumEstadoTurno estado
    )
    {
        return estado switch
        {
            EnumEstadoTurno.disponible => "Disponible",
            EnumEstadoTurno.reservado => "Reservado",
            EnumEstadoTurno.atendido => "Atendido",
            EnumEstadoTurno.cancelado => "Cancelado",
            EnumEstadoTurno.ausente => "Ausente",
            _ => "Sin estado"
        };
    }

    private async Task Grabar()
    {
        if (!PuedeGuardar || guardando)
        {
            return;
        }

        guardando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        var respuesta =
            await Http.Put<TurnoDTO, RespuestaDTO>(
                $"api/turno/{id}",
                modelo
            );

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            guardando = false;
            return;
        }

        operacionExitosa = true;
        Mensaje = respuesta.Respuesta?.mensaje
            ?? "Turno actualizado correctamente.";

        guardando = false;

        await Task.Delay(500);

        Nav.NavigateTo(
            "/turnos?estado=actualizado",
            forceLoad: true
        );
    }

    private void SolicitarEliminacion()
    {
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminacion()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task Eliminar()
    {
        if (eliminando)
        {
            return;
        }

        eliminando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        var respuesta =
            await Http.Delete($"api/turno/{id}");

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            return;
        }

        operacionExitosa = true;
        Mensaje = "Turno eliminado correctamente.";

        Nav.NavigateTo(
            "/turnos?estado=eliminado",
            forceLoad: true
        );
    }

    private void Volver()
    {
        var vista = string.IsNullOrWhiteSpace(VistaOrigen)
            ? "diaria"
            : VistaOrigen;

        var fecha = string.IsNullOrWhiteSpace(FechaOrigen)
            ? DateTime.Today.ToString("yyyy-MM-dd")
            : FechaOrigen;

        if (VolverADetalle)
        {
            Nav.NavigateTo(
                $"/turnos" +
                $"?detalle={id}" +
                $"&vista={vista}" +
                $"&fecha={fecha}"
            );

            return;
        }

        if (VolverAVista)
        {
            Nav.NavigateTo(
                $"/turnos" +
                $"?vista={vista}" +
                $"&fecha={fecha}"
            );

            return;
        }

        Nav.NavigateTo("/turnos");
    }

