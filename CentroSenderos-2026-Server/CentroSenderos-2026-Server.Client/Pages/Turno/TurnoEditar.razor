    }

    private async Task ActualizarHorariosPorCambio()
    {
        Mensaje = string.Empty;
        horasDisponibles.Clear();
        horariosConsultados = false;

        // Invalida cualquier consulta anterior pendiente.
        versionConsultaHorarios++;

        var seleccionCompleta =
            modelo.Fecha != default &&
            modelo.TipoTurnoId > 0 &&
            modelo.TipoConsultorioId > 0 &&
            modelo.ProfesionalIds.Count > 0 &&
            modelo.ProfesionalPrestaciones.Count ==
            modelo.ProfesionalIds.Count &&
            modelo.ProfesionalPrestaciones.All(
            seleccion =>
            seleccion.TipoPrestacionId > 0 &&
            modelo.ProfesionalIds.Contains(seleccion.ProfesionalId)
            ) &&
        modelo.PacienteIds.Count > 0;

        if (!seleccionCompleta)
        {
            consultandoHorarios = false;
            return;
        }

        await CargarHorasDisponibles();
    }

    private async Task CargarHorasDisponibles()
    {
        var versionActual =
            ++versionConsultaHorarios;

        Mensaje = string.Empty;
        horasDisponibles.Clear();
        horariosConsultados = false;

        if (
            modelo.TipoTurnoId <= 0 ||
            modelo.TipoConsultorioId <= 0 ||
            modelo.ProfesionalIds.Count == 0 ||
            modelo.PacienteIds.Count == 0 ||
            modelo.Fecha == DateTime.MinValue
        )
        {
            consultandoHorarios = false;
            return;
        }

        consultandoHorarios = true;

        var parametrosProfesionales =
            string.Concat(
                modelo.ProfesionalIds.Select(
                    profesionalId =>
                        $"&profesionalIds={profesionalId}"
                )
            );

        var parametrosPacientes =
            string.Concat(
                modelo.PacienteIds.Select(
                    pacienteId =>
                        $"&pacienteIds={pacienteId}"
                )
            );

        var url =
            $"api/turno/Disponibles" +
            $"?fecha={modelo.Fecha:yyyy-MM-dd}" +
            $"&tipoTurnoId={modelo.TipoTurnoId}" +
            $"&consultorioId={modelo.TipoConsultorioId}" +
            $"&turnoIdExcluir={id}" +
            parametrosProfesionales +
            parametrosPacientes;

        var respuesta =
            await Http.Get<List<string>>(url);

        // Ignora respuestas pertenecientes a una selección anterior.
        if (versionActual != versionConsultaHorarios)
        {
            return;
        }

        consultandoHorarios = false;

        if (respuesta.Error)
        {
            horariosConsultados = false;
            Mensaje = respuesta.ObtenerError();
            return;
        }

        horariosConsultados = true;

        horasDisponibles =
            respuesta.Respuesta ?? new List<string>();

        if (
            !string.IsNullOrWhiteSpace(horaSeleccionada) &&
            !horasDisponibles.Contains(horaSeleccionada)
        )
        {
            horaSeleccionada = string.Empty;
            modelo.Hora = TimeOnly.MinValue;
        }
    }

    private void SeleccionarHora(string hora)
    {
        horaSeleccionada = hora;
        modelo.Hora = TimeOnly.ParseExact(hora, "HH:mm");
        Mensaje = string.Empty;
    }

