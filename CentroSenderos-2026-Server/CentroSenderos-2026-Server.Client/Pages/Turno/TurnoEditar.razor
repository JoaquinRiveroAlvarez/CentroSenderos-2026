    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        var respuestaTurno =
            await Http.Get<TurnoDTO>($"api/turno/{id}");

        if (respuestaTurno.Error || respuestaTurno.Respuesta is null)
        {
            errorCarga = respuestaTurno.Error
                ? respuestaTurno.ObtenerError()
                : "No se encontró el turno solicitado.";

            cargando = false;
            return;
        }

        modelo = respuestaTurno.Respuesta;

        if (modelo.Hora != TimeOnly.MinValue)
        {
            horaSeleccionada = modelo.Hora.ToString("HH:mm");
        }

        if (modelo.Fecha != default)
        {
            mesCalendario = new DateTime(
                modelo.Fecha.Year,
                modelo.Fecha.Month,
                1
            );
        }

        var respuestaTipos =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );

        if (!respuestaTipos.Error &&
            respuestaTipos.Respuesta is not null)
        {
            tiposTurno = respuestaTipos.Respuesta;
        }

        var respuestaConsultorios =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );

        if (!respuestaConsultorios.Error &&
            respuestaConsultorios.Respuesta is not null)
        {
            consultorios = respuestaConsultorios.Respuesta;
        }

        
        var respuestaProfesionales = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
        if (!respuestaProfesionales.Error && respuestaProfesionales.Respuesta is not null)
        {
            profesionales = respuestaProfesionales.Respuesta;
        }

        var respuestaPacientes = await Http.Get<List<PacienteResumenDTO>>("api/paciente/ListaPaciente");
        if (!respuestaPacientes.Error && respuestaPacientes.Respuesta is not null)
        {
            pacientes = respuestaPacientes.Respuesta;
        }

        await CargarHorasDisponibles();

        cargando = false;
    }

    private bool PuedeGuardar
    {
        get
        {
            return
                !consultandoHorarios &&
                horariosConsultados &&
                !string.IsNullOrWhiteSpace(
                    horaSeleccionada
                ) &&
                modelo.Fecha != default &&
                modelo.Hora != TimeOnly.MinValue &&
                modelo.TipoTurnoId > 0 &&
                modelo.TipoConsultorioId > 0 &&
                modelo.ProfesionalIds.Count > 0 &&
                modelo.ProfesionalIds.All(profesionalId =>
                    modelo.ProfesionalPrestaciones.Any(seleccion =>
                        seleccion.ProfesionalId == profesionalId &&
                        seleccion.TipoPrestacionId > 0
                    )
                ) &&
                modelo.PacienteIds.Count > 0;
        }
    }

    private string TextoFechaSeleccionada =>
        modelo.Fecha == default
            ? "Seleccionar fecha"
            : modelo.Fecha.ToString(
                "dddd, d 'de' MMMM 'de' yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoFechaResumen =>
        modelo.Fecha == default
            ? "Sin seleccionar"
            : modelo.Fecha.ToString(
                "dd/MM/yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoHorarioResumen
    {
        get
        {
            if (modelo.Hora == TimeOnly.MinValue)
            {
                return "Sin seleccionar";
            }

            var duracion = ObtenerDuracionSeleccionada();

            if (duracion <= 0)
            {
                return modelo.Hora.ToString("HH:mm");
            }

            var horaFin = modelo.Hora.AddMinutes(duracion);

            return $"{modelo.Hora:HH\\:mm} - {horaFin:HH\\:mm}";
        }
    }

