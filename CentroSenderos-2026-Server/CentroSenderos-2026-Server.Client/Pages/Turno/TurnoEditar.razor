@page "/turnos/editar/{id:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO

@inject IHttpServicio Http
@inject NavigationManager Nav

@rendermode InteractiveAuto

<PageTitle>Editar turno</PageTitle>

<div class="turno-editar-page">

    <button type="button"
            class="btn-volver"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>
    </button>

    <header class="editar-header">
        <div>
            <h1>Editar turno</h1>
            <p>Modificá los datos, el horario o el estado del turno.</p>
        </div>

        @if (!cargando && string.IsNullOrWhiteSpace(errorCarga))
        {
            <span class="turno-identificador">
                Turno #@id
            </span>
        }
    </header>

    @if (cargando)
    {
        <div class="estado-pagina">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Cargando los datos del turno...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="estado-pagina estado-error">
            <i class="bi bi-exclamation-circle"></i>

            <div>
                <strong>No pudimos cargar el turno</strong>
                <p>@errorCarga</p>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="SolicitarGuardado"
                  class="turno-editar-form">

            <DataAnnotationsValidator />

            <div class="editar-contenido">

                <section class="editar-card datos-card">

                    <div class="seccion-encabezado">
                        <span class="seccion-numero">01</span>

                        <div>
                            <h2>Datos del turno</h2>
                            <p>Actualizá la fecha, la hora y el consultorio.</p>
                        </div>
                    </div>

                    @if (modelo.SerieTurnoId.HasValue)
                    {
                        <fieldset class="alcance-edicion">

                            <legend>
                                ¿Qué turnos querés modificar?
                            </legend>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@(!modelo.ModificarTodaLaSerie)"
                                       @onchange="SeleccionarEdicionIndividual" />

                                <span class="alcance-opcion-contenido">

                                    <strong>
                                        Solo este turno
                                    </strong>

                                    <small>
                                        Los demás turnos de la serie no se modificarán.
                                    </small>

                                </span>

                            </label>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@modelo.ModificarTodaLaSerie"
                                       @onchange="SeleccionarEdicionSerie" />

                                <span class="alcance-opcion-contenido">

                                    <strong>
                                        Todos los turnos futuros de la serie
                                    </strong>

                                    <small>
                                        Se actualizarán las ocurrencias de hoy en adelante.
                                        Los turnos anteriores conservarán sus datos.
                                    </small>

                                </span>

                            </label>

                        </fieldset>
                    }

                    

                    <div class="campos-grid">

                        <div class="campo campo-completo">
                            <label for="tipoTurno">Tipo de turno</label>

                            <div class="select-contenedor">
                                <InputSelect id="tipoTurno"
                                             class="control-formulario"
                                             @bind-Value="modelo.TipoTurnoId"
                                             @bind-Value:after="ActualizarHorariosPorCambio">
                                    <option value="0">Seleccionar tipo de turno</option>

                                    @foreach (var tipo in tiposTurno)
                                    {
                                        <option value="@tipo.Id">
                                            @tipo.Tipo (@tipo.DuracionMinutos min)
                                        </option>
                                    }

                                   
                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>
                            </div>

                            <ValidationMessage For="@(() => modelo.TipoTurnoId)" />
                        </div>

                       

                        <div class="campo campo-completo">
                            <label for="consultorio">Consultorio</label>

                            <div class="select-contenedor">
                                <InputSelect id="consultorio"
                                             class="control-formulario"
                                             @bind-Value="modelo.TipoConsultorioId"
                                             @bind-Value:after="ActualizarHorariosPorCambio">
                                    <option value="0">Seleccionar consultorio</option>

                                    @foreach (var consultorio in consultorios)
                                    {
                                        <option value="@consultorio.Id">
                                            @consultorio.Tipo
                                        </option>
                                    }
                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>
                            </div>

                            <ValidationMessage For="@(() => modelo.TipoConsultorioId)" />
                        </div>

                        <div class="campo fecha-campo">
                            <label>Fecha</label>

                            <button type="button"
                                    class="selector-fecha"
                                    disabled="@modelo.ModificarTodaLaSerie"
                                    @onclick="AlternarCalendario">

                                @if (modelo.ModificarTodaLaSerie)
                                {
                                    <span class="campo-ayuda">
                                        Las fechas originales se conservarán y los cambios
                                        se aplicarán solamente a los turnos futuros.
                                    </span>
                                }

                                <span>
                                    @TextoFechaSeleccionada
                                </span>

                                <i class="bi bi-calendar3"></i>
                            </button>

                            @if (calendarioAbierto)
                            {
                                <div class="calendario-personalizado">

                                    <div class="calendario-cabecera">
                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes anterior"
                                                @onclick="MesAnterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>

                                        <strong>@TituloMesCalendario</strong>

                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes siguiente"
                                                @onclick="MesSiguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>

                                    <div class="calendario-semana">
                                        <span>Lu</span>
                                        <span>Ma</span>
                                        <span>Mi</span>
                                        <span>Ju</span>
                                        <span>Vi</span>
                                        <span>Sá</span>
                                        <span>Do</span>
                                    </div>

                                    <div class="calendario-dias">
                                        @foreach (var dia in DiasCalendario)
                                        {
                                            <button type="button"
                                                    class="@ObtenerClaseDia(dia)"
                                                    disabled="@EsDiaPasado(dia)"
                                                    @onclick="() => SeleccionarFecha(dia.Fecha)">
                                                @dia.Fecha.Day
                                            </button>
                                        }
                                    </div>

                                    <div class="calendario-pie">
                                        <button type="button"
                                                @onclick="SeleccionarHoy">
                                            Hoy
                                        </button>

                                        <button type="button"
                                                @onclick="CerrarCalendario">
                                            Cerrar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>

                    <div class="campo campo-completo">

                        <label>
                            Profesionales
                        </label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    aria-expanded="@mostrarSelectorProfesionales"
                                    @onclick="AlternarSelectorProfesionales">

                                <span>
                                    @TextoProfesionalesSeleccionados
                                </span>

                                <i class="bi @(mostrarSelectorProfesionales
                                                                                      ? "bi-chevron-up"
                                                                                      : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorProfesionales)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar profesional..."
                                               autocomplete="off"
                                               @bind="busquedaProfesional"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (ProfesionalesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron profesionales.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (
                                                var profesional
                                                in ProfesionalesFiltrados
                                            )
                                            {
                                                var estaSeleccionado =
                                                    modelo.ProfesionalIds.Contains(
                                                        profesional.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                                                                                ? "selector-desplegable-opcion seleccionado"
                                                                                                                : "selector-desplegable-opcion")"
                                                        @onclick="() => AlternarProfesional(
                                                                                                                profesional.Id
                                                                                                            )">

<span>
                                                        @profesional.Nombre
                                                    </span>

                                                    @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                    @if (modelo.ProfesionalIds.Count > 0)
                    {
                        <div class="campo campo-completo">

                            <div class="profesionales-prestaciones-lista">

                                @foreach (
                                    var profesionalId
                                    in modelo.ProfesionalIds
                                )
                                {
                                    var profesional =
                                        profesionales.FirstOrDefault(
                                            item =>
                                                item.Id == profesionalId
                                        );

                                    if (profesional is not null)
                                    {
                                        <div class="profesional-prestacion-card">

                                            <div class="profesional-prestacion-header">

                                                <div class="profesional-prestacion-identidad">

                                                    <span class="profesional-prestacion-icono">
                                                        <i class="bi bi-person"></i>
                                                    </span>

                                                    <div>
                                                        <strong>
                                                            @profesional.Nombre
                                                        </strong>

                                                        @if (
                                                            !string.IsNullOrWhiteSpace(
                                                                profesional.Area
                                                            )
                                                        )
                                                        {
                                                            <span>
                                                                @profesional.Area
                                                            </span>
                                                        }
                                                    </div>

                                                </div>

                                                <button type="button"
                                                        class="profesional-prestacion-quitar"
                                                        title="Quitar profesional"
                                                        @onclick="() => QuitarProfesional(
                                                                                                                profesional.Id
                                                                                                            )">

<i class="bi bi-x-lg"></i>

</button>

                                            </div>

                                            <div class="profesional-prestacion-cuerpo">

                                                <label>
                                                    Prestación
                                                </label>

                                                @if (
                                                    profesional
                                                        .TipoPrestacionIds
                                                        .Count == 0
                                                )
                                                {
                                                    <div class="profesional-sin-prestaciones">

                                                        <i class="bi bi-exclamation-circle"></i>

                                                        <span>
                                                            Este profesional no tiene
                                                            prestaciones disponibles.
                                                        </span>

                                                    </div>
                                                }
                                                else if (
                                                    profesional
                                                        .TipoPrestacionIds
                                                        .Count == 1
                                                )
                                                {
                                                    <div class="prestacion-automatica">

                                                        <i class="bi bi-check-circle"></i>

                                                        <span>
                                                            @(profesional
                                                                .TipoPrestacionNombres
                                                                .FirstOrDefault()
                                                                ?? "Prestación")
                                                        </span>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <select class="control-formulario"
                                                            value="@ObtenerPrestacionSeleccionada(
                                                                                                                        profesional.Id
                                                                                                                    )"
                                                            @onchange="evento =>
                                                                                                                        SeleccionarPrestacion(
                                                                                                                            profesional.Id,
                                                                                                                            evento
                                                                                                                        )">

<option value="0">
                                                            Seleccioná una prestación
                                                        </option>

                                                        @for (
                                                            var indice = 0;
                                                            indice <
                                                                profesional
                                                                    .TipoPrestacionIds
                                                                    .Count;
                                                            indice++
                                                        )
                                                        {
                                                            var prestacionId =
                                                                profesional
                                                                    .TipoPrestacionIds[indice];

                                                            var nombrePrestacion =
                                                                indice <
                                                                    profesional
                                                                        .TipoPrestacionNombres
                                                                        .Count
                                                                    ? profesional
                                                                        .TipoPrestacionNombres[indice]
                                                                    : "Prestación";

                                                            <option value="@prestacionId">
                                                                @nombrePrestacion
                                                            </option>
                                                        }

                                                    </select>
                                                }

                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                        </div>
                    }

                    <div class="campo campo-completo">
                        <label>
                            Pacientes
                        </label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    aria-expanded="@mostrarSelectorPacientes"
                                    @onclick="AlternarSelectorPacientes">

                                <span>
                                    @TextoPacientesSeleccionados
                                </span>

                                <i class="bi @(mostrarSelectorPacientes
                                                                   ? "bi-chevron-up"
                                                                   : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorPacientes)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar paciente..."
                                               autocomplete="off"
                                               @bind="busquedaPaciente"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (PacientesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron pacientes.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var paciente in PacientesFiltrados)
                                            {
                                                var estaSeleccionado =
                                                    modelo.PacienteIds.Contains(
                                                        paciente.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                                                            ? "selector-desplegable-opcion seleccionado"
                                                                                            : "selector-desplegable-opcion")"
                                                        @onclick="() =>
                                                                                                      AlternarPaciente(paciente.Id)">

<span>
                                                        @paciente.Nombre
                                                    </span>

                                                    @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                    <div class="selector-desplegable-footer">

                                        <span>
                                            @modelo.PacienteIds.Count
                                            @(modelo.PacienteIds.Count == 1
                                                ? "seleccionado"
                                                : "seleccionados")
                                        </span>

                                        <button type="button"
                                                @onclick="CerrarSelectorPacientes">
                                            Listo
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                        @if (modelo.PacienteIds.Count > 0)
                        {
                            <div class="selector-multiple-seleccionados">

                                @foreach (var pacienteId in modelo.PacienteIds)
                                {
                                    var paciente = pacientes.FirstOrDefault(
                                        item => item.Id == pacienteId
                                    );

                                    if (paciente is not null)
                                    {
                                        <span class="selector-multiple-chip">

                                            @paciente.Nombre

                                            <button type="button"
                                                    title="Quitar paciente"
                                                    @onclick="() =>
                                                                                                                                                                                    QuitarPaciente(paciente.Id)">

<i class="bi bi-x"></i>

</button>

                                        </span>
                                    }
                                }

                            </div>
                        }

                    </div>

                </section>

                <aside class="editar-lateral">

                    <section class="editar-card horarios-card">

                        <div class="seccion-encabezado">
                            <span class="seccion-numero">02</span>

                            <div>
                                <h2>Horarios disponibles</h2>
                                <p>Elegí el horario de inicio para el turno.</p>
                            </div>
                        </div>

                        

                        @if (consultandoHorarios)
                        {
                            <div class="horarios-cargando">

                                <span class="spinner-border spinner-border-sm"
                                      role="status">
                                </span>

                                <span>Actualizando horarios...</span>

                            </div>
                        }
                        else if (!horariosConsultados)
                        {
                            <div class="horarios-vacio">

                                <i class="bi bi-clock"></i>

                                <p>
                                    Completá los datos del turno para consultar
                                    la disponibilidad.
                                </p>

                            </div>
                        }
                        else if (horasDisponibles.Count == 0)
                        {
                            <div class="horarios-vacio">

                                <i class="bi bi-calendar-x"></i>

                                <p>
                                    No hay horarios disponibles para esta selección.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="horarios-grid">

                                @foreach (var hora in horasDisponibles)
                                {
                                    <button type="button"
                                            class="@ObtenerClaseHorario(hora)"
                                            @onclick="() => SeleccionarHora(hora)">

                                        @hora

                                    </button>
                                }

                            </div>
                        }

                    </section>

                    <section class="editar-card estado-card">

                        <div class="seccion-encabezado">
                            <span class="seccion-numero">03</span>

                            <div>
                                <h2>Estado del turno</h2>
                                <p>Indicá la situación actual.</p>
                            </div>
                        </div>

                        <div class="estados-lista">

                            @foreach (var estado in EstadosDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseEstado(estado)"
                                        @onclick="() => SeleccionarEstado(estado)">

                                    <span class="estado-indicador"></span>
                                    <span>@ObtenerNombreEstado(estado)</span>

                                    @if (modelo.EstadoTurno == estado)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                </button>
                            }

                        </div>
                    </section>

                </aside>

                <section class="editar-card resumen-card resumen-card-inferior">

                    <div class="seccion-encabezado resumen-encabezado">
                        <span class="seccion-numero">04</span>

                        <div>
                            <h2>Resumen</h2>
                            <p>Revisá los cambios antes de guardar.</p>
                        </div>
                    </div>

                    <div class="resumen-datos">

                        <div class="resumen-fila">
                            <span>Fecha</span>
                            <strong>@TextoFechaResumen</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Horario</span>
                            <strong>@TextoHorarioResumen</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Tipo</span>
                            <strong>@NombreTipoTurno</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Consultorio</span>
                            <strong>@NombreConsultorio</strong>
                        </div>

                        <div class="resumen-fila">
                            <span>Estado</span>
                            <strong class="resumen-estado">
                                @ObtenerNombreEstado(modelo.EstadoTurno)
                            </strong>
                        </div>

                    </div>
                </section>
            </div>

            <ValidationSummary class="mensaje-validacion" />

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-formulario @(operacionExitosa ? "mensaje-exito" : "mensaje-error")">
                    <i class="bi @(operacionExitosa ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                    <span>@Mensaje</span>
                </div>
            }

            <footer class="acciones-formulario">

                <button type="button"
                        class="btn-eliminar"
                        disabled="@(guardando || eliminando)"
                        @onclick="SolicitarEliminacion">
                    <i class="bi bi-trash3"></i>
                    <span>Eliminar turno</span>
                </button>

                <div class="acciones-principales">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@(guardando || eliminando)"
                            @onclick="Volver">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-guardar"
                            disabled="@(!PuedeGuardar || guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Guardar cambios</span>
                        }
                    </button>

                </div>
            </footer>

        </EditForm>
    }
</div>


@if (mostrarConfirmacionSerie)
{
    <div class="modal-fondo"
         @onclick="CancelarEdicionSerie">

        <div class="modal-eliminar"
             @onclick:stopPropagation="true">

            <div class="modal-icono">
                <i class="bi bi-calendar-check"></i>
            </div>

            <h2>¿Modificar los turnos futuros?</h2>

            <p>
                Se actualizarán todos los turnos futuros de la serie.
                Los turnos anteriores no se modificarán.
            </p>

            <div class="modal-acciones">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@guardando"
                        @onclick="CancelarEdicionSerie">
                    No, volver
                </button>

                <button type="button"
                        class="btn-guardar"
                        disabled="@guardando"
                        @onclick="ConfirmarEdicionSerie">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Sí, modificar</span>
                    }

                </button>

            </div>

        </div>

    </div>
}


@if (mostrarConfirmacionEliminar)
{
    <div class="modal-fondo" @onclick="CancelarEliminacion">

        <div class="modal-eliminar" @onclick:stopPropagation="true">

            <div class="modal-icono">
                <i class="bi bi-trash3"></i>
            </div>

            <h2>¿Eliminar este turno?</h2>

            <p>
                Esta acción eliminará el turno del
                <strong>@TextoFechaResumen</strong>
                a las
                <strong>@modelo.Hora.ToString("HH:mm")</strong>.
            </p>

            <div class="modal-acciones">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@eliminando"
                        @onclick="CancelarEliminacion">
                    No, conservar
                </button>

                <button type="button"
                        class="btn-confirmar-eliminar"
                        disabled="@eliminando"
                        @onclick="Eliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3"></i>
                        <span>Sí, eliminar</span>
                    }
                </button>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }
    [SupplyParameterFromQuery(Name = "volverADetalle")]
    public bool VolverADetalle { get; set; }
    [SupplyParameterFromQuery(Name = "volverAVista")]
    public bool VolverAVista { get; set; }
    [SupplyParameterFromQuery(Name = "vistaOrigen")]
    public string? VistaOrigen { get; set; }
