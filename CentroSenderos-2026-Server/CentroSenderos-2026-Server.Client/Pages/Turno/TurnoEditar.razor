    private async Task AlternarPaciente(int pacienteId)
    {
        if (modelo.PacienteIds.Contains(pacienteId))
        {
            modelo.PacienteIds.Remove(pacienteId);
        }
        else
        {
            modelo.PacienteIds.Add(pacienteId);
        }

        SincronizarPacienteAnterior();

        await ActualizarHorariosPorCambio();
    }

    private async Task QuitarPaciente(int pacienteId)
    {
        modelo.PacienteIds.Remove(pacienteId);

        SincronizarPacienteAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void SincronizarPacienteAnterior()
    {
        modelo.PacienteId =
            modelo.PacienteIds.FirstOrDefault();

        Mensaje = string.Empty;
    }

    private async Task AlternarProfesional(int profesionalId)
    {
        if (modelo.ProfesionalIds.Contains(profesionalId))
        {
            modelo.ProfesionalIds.Remove(
                profesionalId
            );

            QuitarPrestacionDelProfesional(
                profesionalId
            );
        }
        else
        {
            modelo.ProfesionalIds.Add(
                profesionalId
            );

            SeleccionarPrestacionAutomatica(
                profesionalId
            );
        }

        SincronizarProfesionalAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void SeleccionarPrestacionAutomatica(int profesionalId)
    {
        var profesional =
            profesionales.FirstOrDefault(
                item => item.Id == profesionalId
            );

        if (
            profesional is null ||
            profesional.TipoPrestacionIds.Count != 1
        )
        {
            return;
        }

        modelo.ProfesionalPrestaciones.Add(
            new TurnoProfesionalPrestacionDTO
            {
                ProfesionalId = profesionalId,
                TipoPrestacionId =
                    profesional.TipoPrestacionIds[0]
            }
        );

        modelo.TipoPrestacionIds =
            modelo.ProfesionalPrestaciones
                .Select(seleccion =>
                    seleccion.TipoPrestacionId
                )
                .Distinct()
                .ToList();
    }

    private async Task QuitarProfesional(int profesionalId)
    {
        modelo.ProfesionalIds.Remove(
            profesionalId
        );

        QuitarPrestacionDelProfesional(
            profesionalId
        );

        SincronizarProfesionalAnterior();

        await ActualizarHorariosPorCambio();
    }

    private void QuitarPrestacionDelProfesional(int profesionalId)
    {
        modelo.ProfesionalPrestaciones.RemoveAll(
            seleccion =>
                seleccion.ProfesionalId ==
                profesionalId
        );

        modelo.TipoPrestacionIds =
            modelo.ProfesionalPrestaciones
                .Select(seleccion =>
                    seleccion.TipoPrestacionId
                )
                .Distinct()
                .ToList();
    }

    private void SincronizarProfesionalAnterior()
    {
        modelo.ProfesionalId =
            modelo.ProfesionalIds.FirstOrDefault();

        Mensaje = string.Empty;
    }

