        {
            modelo.EstadoTurno = estado;
        }
    }

    private string ObtenerClaseEstado(EnumEstadoTurno estado)
    {
        var clase = "estado-opcion";

        if (modelo.EstadoTurno == estado)
        {
            clase += " estado-seleccionado";
        }

        clase += estado switch
        {
            EnumEstadoTurno.disponible => " estado-disponible",
            EnumEstadoTurno.reservado => " estado-reservado",
            EnumEstadoTurno.atendido => " estado-atendido",
            EnumEstadoTurno.cancelado => " estado-cancelado",
            EnumEstadoTurno.ausente => " estado-ausente",
            _ => string.Empty
        };

        return clase;
    }

    private static string ObtenerNombreEstado(EnumEstadoTurno estado)
    {
        return estado switch
        {
            EnumEstadoTurno.disponible => "Pendiente",
            EnumEstadoTurno.reservado => "Pendiente",
            EnumEstadoTurno.atendido => "Completado",
            EnumEstadoTurno.cancelado => "Cancelado",
            EnumEstadoTurno.ausente => "Ausente",
            _ => "Sin estado"
        };
    }

    private void SolicitarEliminacion()
    {
        if (!OperacionEnCurso)
        {
            mostrarConfirmacionEliminar = true;
        }
    }

    private void CancelarEliminacion()
    {
        if (!OperacionEnCurso)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task Eliminar()
    {
        if (OperacionEnCurso)
        {
            return;
        }

        eliminando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        try
        {
            var respuesta = await Http.Delete($"api/turno/{id}");

            if (respuesta.Error)
            {
                Mensaje = ObtenerMensajeAmigable(
                    respuesta.ObtenerError(),
                    "No pudimos eliminar el turno. Intentá nuevamente."
                );

                mostrarConfirmacionEliminar = false;
                return;
            }

            operacionExitosa = true;
            Mensaje = "Turno eliminado correctamente.";

            var vistaDestino = string.IsNullOrWhiteSpace(VistaOrigen)
                ? "diaria"
                : VistaOrigen;

            var fechaDestino = string.IsNullOrWhiteSpace(FechaOrigen)
                ? modelo.Fecha.ToString("yyyy-MM-dd")
                : FechaOrigen;

            Nav.NavigateTo(
                "/turnos" +
                "?estado=eliminado" +
                $"&vista={vistaDestino}" +
                $"&fecha={fechaDestino}" +
                ObtenerFiltrosParaRegreso(),
                forceLoad: true
            );
        }
        catch (TaskCanceledException)
        {
            Mensaje =
                "La eliminación tardó más de lo esperado. " +
                "Verificá si el turno sigue disponible antes de intentarlo nuevamente.";

            mostrarConfirmacionEliminar = false;
        }
        catch (HttpRequestException)
        {
            Mensaje =
                "No pudimos conectarnos con el servidor para eliminar el turno. " +
                "Verificá tu conexión e intentá nuevamente.";

            mostrarConfirmacionEliminar = false;
        }
        catch (Exception)
        {
            Mensaje =
                "Ocurrió un problema al eliminar el turno. " +
                "Intentá nuevamente.";

            mostrarConfirmacionEliminar = false;
        }
        finally
        {
            eliminando = false;
        }
    }

    private string ObtenerFiltrosParaRegreso()
    {
        return
            $"&consultorios={ConsultoriosDesdeUrl ?? string.Empty}" +
            $"&tipos={TiposDesdeUrl ?? string.Empty}" +
            $"&profesionales={ProfesionalesDesdeUrl ?? string.Empty}" +
            $"&pacientes={PacientesDesdeUrl ?? string.Empty}";
    }

    private static string ObtenerMensajeAmigable(
        string? mensaje,
        string mensajeAlternativo)
    {
        if (string.IsNullOrWhiteSpace(mensaje))
        {
            return mensajeAlternativo;
        }

        var mensajeLimpio = mensaje.Trim();

        if (mensajeLimpio.Contains(
                "The operation was canceled",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "TaskCanceledException",
                StringComparison.OrdinalIgnoreCase))
        {
            return
                "La operación tardó más de lo esperado. " +
                "Intentá nuevamente.";
        }

        if (mensajeLimpio.Contains(
                "Unable to read data from the transport connection",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "SocketException",
                StringComparison.OrdinalIgnoreCase))
        {
            return
                "Se interrumpió la conexión con el servidor. " +
                "Verificá tu conexión e intentá nuevamente.";
        }

        if (mensajeLimpio.StartsWith(
            "System.",
            StringComparison.OrdinalIgnoreCase))
        {
            var separador = mensajeLimpio.IndexOf(':');

            if (separador >= 0 &&
                separador < mensajeLimpio.Length - 1)
            {
                mensajeLimpio =
                    mensajeLimpio[(separador + 1)..].Trim();
            }

            mensajeLimpio = mensajeLimpio
                .Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries
                )
                .FirstOrDefault() ?? mensajeAlternativo;
        }

        if (mensajeLimpio.Contains(
                "InternalServerError",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "Response status code does not indicate success",
                StringComparison.OrdinalIgnoreCase))
        {
            return mensajeAlternativo;
        }

        return mensajeLimpio switch
        {
            "Debe seleccionar una hora válida." =>
                "Seleccioná un horario válido.",

            "Debe seleccionar un tipo de turno válido." =>
                "Seleccioná un tipo de turno válido.",

            "Debe seleccionar un consultorio válido." =>
                "Seleccioná un consultorio válido.",

            "Debe seleccionar al menos un profesional." =>
                "Seleccioná al menos un profesional.",

            "Debe seleccionar al menos un paciente." =>
                "Seleccioná al menos un paciente.",

            "Debe seleccionar una prestación para cada profesional." =>
                "Seleccioná una prestación para cada profesional.",

            "Las prestaciones seleccionadas no coinciden con los profesionales del turno." =>
                "Revisá las prestaciones seleccionadas. " +
                "Cada prestación debe corresponder a su profesional.",

            "La prestación seleccionada no pertenece al profesional indicado." =>
                "La prestación seleccionada no está asignada al profesional. " +
                "Elegí otra prestación.",

            "Uno o más pacientes seleccionados no existen." =>
                "Uno de los pacientes seleccionados ya no está disponible. " +
                "Actualizá la página e intentá nuevamente.",

            _ => mensajeLimpio
        };
    }

    private bool ValidarAntesDeGuardar()
    {
        operacionExitosa = false;
        Mensaje = string.Empty;

        if (modelo.TipoTurnoId <= 0)
        {
            Mensaje = "Seleccioná un tipo de turno.";
            return false;
        }

        if (modelo.TipoConsultorioId <= 0)
        {
            Mensaje = "Seleccioná un consultorio.";
            return false;
        }

        if (modelo.Fecha == default)
        {
            Mensaje = "Seleccioná la fecha del turno.";
            return false;
        }

        if (modelo.ProfesionalIds.Count == 0)
        {
            Mensaje = "Seleccioná al menos un profesional.";
            return false;
        }

        var prestacionesCompletas =
            modelo.ProfesionalPrestaciones.Count ==
                modelo.ProfesionalIds.Count &&
            modelo.ProfesionalPrestaciones.All(seleccion =>
                seleccion.TipoPrestacionId > 0 &&
                modelo.ProfesionalIds.Contains(
                    seleccion.ProfesionalId
                )
            );

        if (!prestacionesCompletas)
        {
            Mensaje = "Seleccioná una prestación para cada profesional.";
            return false;
        }

        if (!SeleccionPacientesValida)
        {
            Mensaje = "Este tipo de turno requiere al menos un paciente.";
            return false;
        }

        if (consultandoHorarios)
        {
            Mensaje =
                "Esperá mientras actualizamos los horarios disponibles.";
            return false;
        }

        if (!horariosConsultados)
        {
            Mensaje =
                "Completá los datos del turno para consultar " +
                "los horarios disponibles.";
            return false;
        }

        if (horasDisponibles.Count == 0)
        {
            Mensaje =
                "No hay horarios disponibles para la selección actual. " +
                "Probá cambiando la fecha o alguno de los participantes.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(horaSeleccionada) ||
            modelo.Hora == TimeOnly.MinValue)
        {
            Mensaje = "Seleccioná un horario disponible.";
            return false;
        }

        return true;
    }

    private async Task SolicitarGuardado()
    {
        if (OperacionEnCurso)
        {
            return;
        }

        if (!ValidarAntesDeGuardar())
        {
            return;
        }

        if (modelo.ModificarTodaLaSerie)
        {
            mostrarConfirmacionSerie = true;
            return;
        }

        await Grabar();
    }

