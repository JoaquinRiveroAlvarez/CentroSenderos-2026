    }

    private int ObtenerPrestacionSeleccionada(int profesionalId)
    {
        return modelo.ProfesionalPrestaciones
            .FirstOrDefault(seleccion =>
                seleccion.ProfesionalId == profesionalId
            )?.TipoPrestacionId ?? 0;
    }

    private void SeleccionarPrestacion(
        int profesionalId,
        ChangeEventArgs evento)
    {
        if (OperacionEnCurso)
        {
            return;
        }

        if (!int.TryParse(
            evento.Value?.ToString(),
            out var tipoPrestacionId))
        {
            tipoPrestacionId = 0;
        }

        var seleccionActual = modelo.ProfesionalPrestaciones
            .FirstOrDefault(seleccion =>
                seleccion.ProfesionalId == profesionalId
            );

        if (tipoPrestacionId == 0)
        {
            if (seleccionActual is not null)
            {
                modelo.ProfesionalPrestaciones.Remove(seleccionActual);
            }
        }
        else if (seleccionActual is null)
        {
            modelo.ProfesionalPrestaciones.Add(
                new TurnoProfesionalPrestacionDTO
                {
                    ProfesionalId = profesionalId,
                    TipoPrestacionId = tipoPrestacionId
                }
            );
        }
        else
        {
            seleccionActual.TipoPrestacionId = tipoPrestacionId;
        }

        modelo.TipoPrestacionIds = modelo.ProfesionalPrestaciones
            .Select(seleccion => seleccion.TipoPrestacionId)
            .Distinct()
            .ToList();

        Mensaje = string.Empty;
    }

    private bool PrepararPrestacionesParaGuardar()
    {
        var profesionalIdsSeleccionados = modelo.ProfesionalIds
            .Where(profesionalId => profesionalId > 0)
            .Distinct()
            .ToHashSet();

        var relacionesNormalizadas = modelo.ProfesionalPrestaciones
            .Where(seleccion =>
                profesionalIdsSeleccionados.Contains(
                    seleccion.ProfesionalId
                ) &&
                seleccion.TipoPrestacionId > 0
            )
            .GroupBy(seleccion => seleccion.ProfesionalId)
            .Select(grupo => grupo.First())
            .ToList();

        foreach (var profesionalId in profesionalIdsSeleccionados)
        {
            var profesional = profesionales.FirstOrDefault(
                item => item.Id == profesionalId
            );

            var seleccion = relacionesNormalizadas.FirstOrDefault(
                item => item.ProfesionalId == profesionalId
            );

            if (profesional is null || seleccion is null)
            {
                Mensaje =
                    "Seleccioná una prestación para cada profesional.";
                return false;
            }

            if (!profesional.TipoPrestacionIds.Contains(
                seleccion.TipoPrestacionId))
            {
                Mensaje =
                    "La prestación seleccionada no está asignada a " +
                    $"{profesional.Nombre}.";
                return false;
            }
        }

        modelo.ProfesionalPrestaciones = relacionesNormalizadas;

        modelo.TipoPrestacionIds = relacionesNormalizadas
            .Select(seleccion => seleccion.TipoPrestacionId)
            .Distinct()
            .ToList();

        return true;
    }

    private async Task Grabar()
    {
        if (!PuedeGuardar || OperacionEnCurso)
        {
            return;
        }

        if (!PrepararPrestacionesParaGuardar())
        {
            return;
        }

        guardando = true;
        operacionExitosa = false;
        Mensaje = string.Empty;

        try
        {
            var respuesta = await Http.Put<TurnoDTO, RespuestaDTO>(
                $"api/turno/{id}",
                modelo
            );

            if (respuesta.Error)
            {
                Mensaje = ObtenerMensajeAmigable(
                    respuesta.Respuesta?.mensaje ??
                        respuesta.ObtenerError(),
                    "No pudimos guardar los cambios. " +
                    "Revisá los datos e intentá nuevamente."
                );

                return;
            }

            operacionExitosa = true;
            Mensaje = "Turno actualizado correctamente.";

            await Task.Delay(500);

            var estadoResultado = modelo.ModificarTodaLaSerie
                ? "serie-actualizada"
                : "actualizado";

            var vistaDestino = string.IsNullOrWhiteSpace(VistaOrigen)
                ? "diaria"
                : VistaOrigen;

            var fechaDestino = string.IsNullOrWhiteSpace(FechaOrigen)
                ? modelo.Fecha.ToString("yyyy-MM-dd")
                : FechaOrigen;

            Nav.NavigateTo(
                "/turnos" +
                $"?estado={estadoResultado}" +
                $"&vista={vistaDestino}" +
                $"&fecha={fechaDestino}" +
                ObtenerFiltrosParaRegreso(),
                forceLoad: true
            );
        }
        catch (TaskCanceledException)
        {
            Mensaje =
                "El guardado tardó más de lo esperado. " +
                "Verificá si los cambios se aplicaron antes de intentarlo nuevamente.";
        }
        catch (HttpRequestException)
        {
            Mensaje =
                "No pudimos conectarnos con el servidor para guardar los cambios. " +
                "Verificá tu conexión e intentá nuevamente.";
        }
        catch (Exception)
        {
            Mensaje =
                "Ocurrió un problema al guardar los cambios. " +
                "Revisá los datos e intentá nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver()
    {
        if (OperacionEnCurso)
        {
            return;
        }

        var vista = string.IsNullOrWhiteSpace(VistaOrigen)
            ? "diaria"
            : VistaOrigen;

        var fecha = string.IsNullOrWhiteSpace(FechaOrigen)
            ? modelo.Fecha.ToString("yyyy-MM-dd")
            : FechaOrigen;

        var filtros = ObtenerFiltrosParaRegreso();

        if (VolverADetalle)
        {
            Nav.NavigateTo(
                "/turnos" +
                $"?detalle={id}" +
                $"&vista={vista}" +
                $"&fecha={fecha}" +
                filtros
            );

            return;
        }

        Nav.NavigateTo(
            "/turnos" +
            $"?vista={vista}" +
            $"&fecha={fecha}" +
            filtros
        );
    }

