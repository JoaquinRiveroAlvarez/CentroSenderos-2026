@page "/turnos/editar/{id:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO

@inject IHttpServicio Http
@inject NavigationManager Nav

@rendermode InteractiveAuto

<PageTitle>Editar turno</PageTitle>

<div class="turno-editar-page">

    <button type="button"
            class="btn-volver"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>
    </button>

    <header class="editar-header">
        <div>
            <h1>Editar turno</h1>
            <p>Modificá los datos, el horario o el estado del turno.</p>
        </div>

        @if (!cargando && string.IsNullOrWhiteSpace(errorCarga))
        {
            <span class="turno-identificador">
                Turno #@id
            </span>
        }
    </header>

    @if (cargando)
    {
        <div class="estado-pagina">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Cargando los datos del turno...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="estado-pagina estado-error">
            <i class="bi bi-exclamation-circle"></i>

            <div>
                <strong>No pudimos cargar el turno</strong>
                <p>@errorCarga</p>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="turno-editar-form">

            <DataAnnotationsValidator />

            <div class="editar-contenido">

                <section class="editar-card datos-card">

                    <div class="seccion-encabezado">
                        <span class="seccion-numero">01</span>

                        <div>
                            <h2>Datos del turno</h2>
                            <p>Actualizá la fecha, la hora y el consultorio.</p>
                        </div>
                    </div>
                    
                    @if (modelo.SerieTurnoId.HasValue)
                    {
                        <fieldset class="alcance-edicion">

                            <legend>
                                ¿Qué turnos querés modificar?
                            </legend>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@(!modelo.ModificarTodaLaSerie)"
                                       @onchange="SeleccionarEdicionIndividual" />

                                <span class="alcance-opcion-contenido">

                                    <strong>
                                        Solo este turno
                                    </strong>

                                    <small>
                                        Los demás turnos de la serie no se modificarán.
                                    </small>

                                </span>

                            </label>

                            <label class="alcance-opcion">

                                <input type="radio"
                                       name="alcanceEdicion"
                                       checked="@modelo.ModificarTodaLaSerie"
                                       @onchange="SeleccionarEdicionSerie" />

                                <span class="alcance-opcion-contenido">

                                    <strong>
                                        Todos los turnos de la serie
                                    </strong>

                                    <small>
                                        Se actualizarán los datos compartidos,
                                        pero cada turno conservará su fecha.
                                    </small>

                                </span>

                            </label>

                        </fieldset>
                    }

                    

                    <div class="campos-grid">

                        <div class="campo campo-completo">
                            <label for="tipoTurno">Tipo de turno</label>

                            <div class="select-contenedor">
                                <InputSelect id="tipoTurno"
                                             class="control-formulario"
                                             @bind-Value="modelo.TipoTurnoId">
                                    <option value="0">Seleccionar tipo de turno</option>

                                    @foreach (var tipo in tiposTurno)
                                    {
                                        <option value="@tipo.Id">
                                            @tipo.Tipo (@tipo.DuracionMinutos min)
                                        </option>
                                    }

                                    <option value="-1">Otro</option>
                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>
                            </div>

                            <ValidationMessage For="@(() => modelo.TipoTurnoId)" />
                        </div>

                        @if (modelo.TipoTurnoId == -1)
                        {
                            <div class="campo campo-completo">
                                <label for="duracionPersonalizada">
                                    Duración personalizada
                                </label>

                                <div class="input-con-sufijo">
                                    <InputNumber id="duracionPersonalizada"
                                                 class="control-formulario"
                                                 min="1"
                                                 max="480"
                                                 @bind-Value="modelo.DuracionPersonalizada" />

                                    <span>minutos</span>
                                </div>

                                <ValidationMessage For="@(() => modelo.DuracionPersonalizada)" />
                            </div>
                        }

                        <div class="campo campo-completo">
                            <label for="consultorio">Consultorio</label>

                            <div class="select-contenedor">
                                <InputSelect id="consultorio"
                                             class="control-formulario"
                                             @bind-Value="modelo.TipoConsultorioId">
                                    <option value="0">Seleccionar consultorio</option>

                                    @foreach (var consultorio in consultorios)
                                    {
                                        <option value="@consultorio.Id">
                                            @consultorio.Tipo
                                        </option>
                                    }
                                </InputSelect>

                                <i class="bi bi-chevron-down"></i>
                            </div>

                            <ValidationMessage For="@(() => modelo.TipoConsultorioId)" />
                        </div>

                        <div class="campo fecha-campo">
                            <label>Fecha</label>

                            <button type="button"
                                    class="selector-fecha"
                                    disabled="@modelo.ModificarTodaLaSerie"
                                    @onclick="AlternarCalendario">

                                @if (modelo.ModificarTodaLaSerie)
                                {
                                    <span class="campo-ayuda">
                                        Las fechas originales de la serie se conservarán.
                                    </span>
                                }

                                <span>
                                    @TextoFechaSeleccionada
                                </span>

                                <i class="bi bi-calendar3"></i>
                            </button>

                            @if (calendarioAbierto)
                            {
                                <div class="calendario-personalizado">

                                    <div class="calendario-cabecera">
                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes anterior"
                                                @onclick="MesAnterior">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>

                                        <strong>@TituloMesCalendario</strong>

                                        <button type="button"
                                                class="calendario-flecha"
                                                title="Mes siguiente"
                                                @onclick="MesSiguiente">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>

                                    <div class="calendario-semana">
                                        <span>Lu</span>
                                        <span>Ma</span>
                                        <span>Mi</span>
                                        <span>Ju</span>
                                        <span>Vi</span>
                                        <span>Sá</span>
                                        <span>Do</span>
                                    </div>

                                    <div class="calendario-dias">
                                        @foreach (var dia in DiasCalendario)
                                        {
                                            <button type="button"
                                                    class="@ObtenerClaseDia(dia)"
                                                    disabled="@EsDiaPasado(dia)"
                                                    @onclick="() => SeleccionarFecha(dia.Fecha)">
                                                @dia.Fecha.Day
                                            </button>
                                        }
                                    </div>

                                    <div class="calendario-pie">
                                        <button type="button"
                                                @onclick="SeleccionarHoy">
                                            Hoy
                                        </button>

                                        <button type="button"
                                                @onclick="CerrarCalendario">
                                            Cerrar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="campo">
                            <label for="horaTurno">Hora de inicio</label>

                            <div class="input-con-icono">
                                <input id="horaTurno"
                                       type="time"
                                       class="control-formulario"
                                       @bind="modelo.Hora" />

                                <i class="bi bi-clock"></i>
                            </div>
                        </div>

                    </div>

                    <div class="campo campo-completo">

                        <label>
                            Profesionales
                        </label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    aria-expanded="@mostrarSelectorProfesionales"
                                    @onclick="AlternarSelectorProfesionales">

                                <span>
                                    @TextoProfesionalesSeleccionados
                                </span>

                                <i class="bi @(mostrarSelectorProfesionales
                                                   ? "bi-chevron-up"
                                                   : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorProfesionales)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar profesional..."
                                               autocomplete="off"
                                               @bind="busquedaProfesional"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (ProfesionalesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron profesionales.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (
                                                var profesional in ProfesionalesFiltrados
                                            )
                                            {
                                                var estaSeleccionado =
                                                    modelo.ProfesionalIds.Contains(
                                                        profesional.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                                                            ? "selector-desplegable-opcion seleccionado"
                                                                                            : "selector-desplegable-opcion")"
                                                        @onclick="() =>
                                                                                            AlternarProfesional(profesional.Id)">

<span>@profesional.Nombre</span>

                                @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                    <div class="selector-desplegable-footer">

                                        <span>
                                            @modelo.ProfesionalIds.Count
                                            @(modelo.ProfesionalIds.Count == 1
                                                ? "seleccionado"
                                                : "seleccionados")
                                        </span>

                                        <button type="button"
                                                @onclick="CerrarSelectorProfesionales">
                                            Listo
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                        @if (modelo.ProfesionalIds.Count > 0)
                        {
                            <div class="selector-multiple-seleccionados">

                                @foreach (var profesionalId in modelo.ProfesionalIds)
                                {
                                    var profesional = profesionales.FirstOrDefault(
                                        item => item.Id == profesionalId
                                    );

                                    if (profesional is not null)
                                    {
                                        <span class="selector-multiple-chip">

                                            @profesional.Nombre

                                            <button type="button"
                                                    title="Quitar profesional"
                                                    @onclick="() =>
                                                                                    QuitarProfesional(profesional.Id)">

                                            <i class="bi bi-x"></i>

                                            </button>

                                        </span>
                                    }
                                }

                            </div>
                        }

                    </div>

                    <div class="campo campo-completo">

                        <label>
                            Pacientes
                        </label>

                        <div class="selector-desplegable">

                            <button type="button"
                                    class="selector-desplegable-boton"
                                    aria-expanded="@mostrarSelectorPacientes"
                                    @onclick="AlternarSelectorPacientes">

                                <span>
                                    @TextoPacientesSeleccionados
                                </span>

                                <i class="bi @(mostrarSelectorPacientes
                                                                  ? "bi-chevron-up"
                                                                  : "bi-chevron-down")">
                                </i>

                            </button>

                            @if (mostrarSelectorPacientes)
                            {
                                <div class="selector-desplegable-menu">

                                    <div class="buscador-selector">

                                        <i class="bi bi-search"></i>

                                        <input type="text"
                                               class="buscador-selector-input"
                                               placeholder="Buscar paciente..."
                                               autocomplete="off"
                                               @bind="busquedaPaciente"
                                               @bind:event="oninput" />

                                    </div>

                                    <div class="selector-desplegable-opciones">

                                        @if (PacientesFiltrados.Count == 0)
                                        {
                                            <div class="selector-multiple-vacio">
                                                No se encontraron pacientes.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var paciente in PacientesFiltrados)
                                            {
                                                var estaSeleccionado =
                                                    modelo.PacienteIds.Contains(
                                                        paciente.Id
                                                    );

                                                <button type="button"
                                                        class="@(estaSeleccionado
                                                                                            ? "selector-desplegable-opcion seleccionado"
                                                                                            : "selector-desplegable-opcion")"
                                                        @onclick="() =>
                                                                                            AlternarPaciente(paciente.Id)">

<span>
                                                        @paciente.Nombre
                                                    </span>

                                                    @if (estaSeleccionado)
                                                    {
                                                        <i class="bi bi-check-lg"></i>
                                                    }

                                                </button>
                                            }
                                        }

                                    </div>

                                    <div class="selector-desplegable-footer">

                                        <span>
                                            @modelo.PacienteIds.Count
                                            @(modelo.PacienteIds.Count == 1
                                                ? "seleccionado"
                                                : "seleccionados")
                                        </span>

                                        <button type="button"
                                                @onclick="CerrarSelectorPacientes">
                                            Listo
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                        @if (modelo.PacienteIds.Count > 0)
                        {
                            <div class="selector-multiple-seleccionados">

                                @foreach (var pacienteId in modelo.PacienteIds)
                                {
                                    var paciente = pacientes.FirstOrDefault(
                                        item => item.Id == pacienteId
                                    );

                                    if (paciente is not null)
                                    {
                                        <span class="selector-multiple-chip">

                                            @paciente.Nombre

                                            <button type="button"
                                                    title="Quitar paciente"
                                                    @onclick="() =>
                                                                                    QuitarPaciente(paciente.Id)">

                                            <i class="bi bi-x"></i>

                                            </button>

                                        </span>
                                    }
                                }

                            </div>
                        }

                    </div>

                </section>

                <aside class="editar-lateral">

                    <section class="editar-card estado-card">

                        <div class="seccion-encabezado">
                            <span class="seccion-numero">02</span>

                            <div>
                                <h2>Estado del turno</h2>
                                <p>Indicá la situación actual.</p>
                            </div>
                        </div>

                        <div class="estados-lista">

                            @foreach (var estado in EstadosDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseEstado(estado)"
                                        @onclick="() => SeleccionarEstado(estado)">

                                    <span class="estado-indicador"></span>
                                    <span>@ObtenerNombreEstado(estado)</span>

                                    @if (modelo.EstadoTurno == estado)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                </button>
                            }

                        </div>
                    </section>

                    <section class="editar-card resumen-card">

                        <div class="seccion-encabezado resumen-encabezado">
                            <span class="seccion-numero">03</span>

                            <div>
                                <h2>Resumen</h2>
                                <p>Revisá los cambios antes de guardar.</p>
                            </div>
                        </div>

                        <div class="resumen-datos">

                            <div class="resumen-fila">
                                <span>Fecha</span>
                                <strong>@TextoFechaResumen</strong>
                            </div>

                            <div class="resumen-fila">
                                <span>Horario</span>
                                <strong>@TextoHorarioResumen</strong>
                            </div>

                            <div class="resumen-fila">
                                <span>Tipo</span>
                                <strong>@NombreTipoTurno</strong>
                            </div>

                            <div class="resumen-fila">
                                <span>Consultorio</span>
                                <strong>@NombreConsultorio</strong>
                            </div>

                            <div class="resumen-fila">
                                <span>Estado</span>
                                <strong class="resumen-estado">
                                    @ObtenerNombreEstado(modelo.EstadoTurno)
                                </strong>
                            </div>

                        </div>
                    </section>

                </aside>
            </div>

            <ValidationSummary class="mensaje-validacion" />

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-formulario @(operacionExitosa ? "mensaje-exito" : "mensaje-error")">
                    <i class="bi @(operacionExitosa ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                    <span>@Mensaje</span>
                </div>
            }

            <footer class="acciones-formulario">

                <button type="button"
                        class="btn-eliminar"
                        disabled="@(guardando || eliminando)"
                        @onclick="SolicitarEliminacion">
                    <i class="bi bi-trash3"></i>
                    <span>Eliminar turno</span>
                </button>

                <div class="acciones-principales">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@(guardando || eliminando)"
                            @onclick="Volver">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-guardar"
                            disabled="@(!PuedeGuardar || guardando || eliminando)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Guardar cambios</span>
                        }
                    </button>

                </div>
            </footer>

        </EditForm>
    }
</div>

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-fondo" @onclick="CancelarEliminacion">

        <div class="modal-eliminar" @onclick:stopPropagation="true">

            <div class="modal-icono">
                <i class="bi bi-trash3"></i>
            </div>

            <h2>¿Eliminar este turno?</h2>

            <p>
                Esta acción eliminará el turno del
                <strong>@TextoFechaResumen</strong>
                a las
                <strong>@modelo.Hora.ToString("HH:mm")</strong>.
            </p>

            <div class="modal-acciones">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@eliminando"
                        @onclick="CancelarEliminacion">
                    No, conservar
                </button>

                <button type="button"
                        class="btn-confirmar-eliminar"
                        disabled="@eliminando"
                        @onclick="Eliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3"></i>
                        <span>Sí, eliminar</span>
                    }
                </button>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }
    [SupplyParameterFromQuery(Name = "volverADetalle")]
    public bool VolverADetalle { get; set; }
    [SupplyParameterFromQuery(Name = "volverAVista")]
    public bool VolverAVista { get; set; }
    [SupplyParameterFromQuery(Name = "vistaOrigen")]
    public string? VistaOrigen { get; set; }
    [SupplyParameterFromQuery(Name = "fechaOrigen")]
    public string? FechaOrigen { get; set; }

    private List<ProfesionalListadoDTO> profesionales = new();
    private List<PacienteResumenDTO> pacientes = new();


    private TurnoDTO modelo = new();

    private List<TipoTurnoListadoDTO> tiposTurno = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool operacionExitosa;
    private bool calendarioAbierto;
    private bool mostrarConfirmacionEliminar;
    private string busquedaProfesional = string.Empty;
    private bool mostrarSelectorProfesionales;
    private string busquedaPaciente = string.Empty;
    private bool mostrarSelectorPacientes;
    private string Mensaje = string.Empty;
    private string errorCarga = string.Empty;

    private DateTime mesCalendario = new(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1
    );

    private readonly EnumEstadoTurno[] EstadosDisponibles =
    {
        EnumEstadoTurno.disponible,
        EnumEstadoTurno.reservado,
        EnumEstadoTurno.atendido,
        EnumEstadoTurno.cancelado,
        EnumEstadoTurno.ausente
    };

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        var respuestaTurno =
            await Http.Get<TurnoDTO>($"api/turno/{id}");

        if (respuestaTurno.Error || respuestaTurno.Respuesta is null)
        {
            errorCarga = respuestaTurno.Error
                ? respuestaTurno.ObtenerError()
                : "No se encontró el turno solicitado.";

            cargando = false;
            return;
        }

        modelo = respuestaTurno.Respuesta;

        if (modelo.Fecha != default)
        {
            mesCalendario = new DateTime(
                modelo.Fecha.Year,
                modelo.Fecha.Month,
                1
            );
        }

        var respuestaTipos =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );

        if (!respuestaTipos.Error &&
            respuestaTipos.Respuesta is not null)
        {
            tiposTurno = respuestaTipos.Respuesta;
        }

        var respuestaConsultorios =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );

        if (!respuestaConsultorios.Error &&
            respuestaConsultorios.Respuesta is not null)
        {
            consultorios = respuestaConsultorios.Respuesta;
        }

        
        var respuestaProfesionales = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
        if (!respuestaProfesionales.Error && respuestaProfesionales.Respuesta is not null)
        {
            profesionales = respuestaProfesionales.Respuesta;
        }

        var respuestaPacientes = await Http.Get<List<PacienteResumenDTO>>("api/paciente/ListaPaciente");
        if (!respuestaPacientes.Error && respuestaPacientes.Respuesta is not null)
        {
            pacientes = respuestaPacientes.Respuesta;
        }


        cargando = false;
    }

    private bool PuedeGuardar
    {
        get
        {
            var datosPrincipalesValidos =
                modelo.Fecha != default &&
                modelo.Hora != TimeOnly.MinValue &&
                modelo.TipoTurnoId != 0 &&
                modelo.TipoConsultorioId > 0 &&
                modelo.ProfesionalIds.Count > 0 &&
                modelo.PacienteIds.Count > 0;

            var duracionValida =
                modelo.TipoTurnoId != -1 ||
                modelo.DuracionPersonalizada > 0;

            return datosPrincipalesValidos &&
                   duracionValida;
        }
    }

    private string TextoFechaSeleccionada =>
        modelo.Fecha == default
            ? "Seleccionar fecha"
            : modelo.Fecha.ToString(
                "dddd, d 'de' MMMM 'de' yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoFechaResumen =>
        modelo.Fecha == default
            ? "Sin seleccionar"
            : modelo.Fecha.ToString(
                "dd/MM/yyyy",
                new System.Globalization.CultureInfo("es-AR")
            );

    private string TextoHorarioResumen
    {
        get
        {
            if (modelo.Hora == TimeOnly.MinValue)
            {
                return "Sin seleccionar";
            }

            var duracion = ObtenerDuracionSeleccionada();

            if (duracion <= 0)
            {
                return modelo.Hora.ToString("HH:mm");
            }

            var horaFin = modelo.Hora.AddMinutes(duracion);

            return $"{modelo.Hora:HH\\:mm} - {horaFin:HH\\:mm}";
        }
    }

    private string NombreTipoTurno
    {
