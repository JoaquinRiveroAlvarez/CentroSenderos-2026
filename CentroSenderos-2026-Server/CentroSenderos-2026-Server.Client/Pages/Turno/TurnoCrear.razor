@page "/turnos/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Recurrencias
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turno-crear-page">

    <button type="button"
            class="btn-volver"
            @onclick="Cancelar">

        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>

    </button>

    <header class="crear-header">

        <div>
            <h1>Nuevo turno</h1>

            <p>
                Seleccioná los datos del turno y consultá
                los horarios disponibles.
            </p>
        </div>

    </header>

    @if (cargando)
    {
        <div class="estado-carga">

            <div class="spinner-border text-secondary"
                 role="status">
            </div>

            <span>Cargando datos...</span>

        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="turno-form">

            <DataAnnotationsValidator />

            <div class="form-layout">

                <section class="form-card datos-turno-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            01
                        </div>

                        <div>
                            <h2>Datos del turno</h2>

                            <p>
                                Completá la fecha, el tipo de turno
                                y el consultorio.
                            </p>
                        </div>

                    </div>

                    <div class="campos-grid">

                        <div class="campo campo-completo">

                            <label for="tipoTurno">
                                Tipo de turno
                            </label>

                            <InputSelect id="tipoTurno"
                                         class="form-select"
                                         @bind-Value="modelo.TipoTurnoId">

                                <option value="0">
                                    Seleccione un tipo de turno
                                </option>

                                @foreach (var tipo in tiposTurno)
                                {
                                    <option value="@tipo.Id">
                                        @tipo.Tipo
                                        (@tipo.DuracionMinutos min)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoTurnoId)" />

                        </div>

                   


                        <div class="campo">

                            <label for="consultorio">
                                Consultorio
                            </label>

                            <InputSelect id="consultorio"
                                         class="form-select"
                                         @bind-Value="modelo.TipoConsultorioId">

                                <option value="0">
                                    Seleccione un consultorio
                                </option>

                                @foreach (var consultorio in consultorios)
                                {
                                    <option value="@consultorio.Id">
                                        @consultorio.Tipo
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoConsultorioId)" />

                        </div>

                        <div class="campo campo-fecha">

                            <label>
                                Fecha
                            </label>

                            <button type="button"
                                    class="fecha-selector"
                                    aria-expanded="@calendarioAbierto"
                                    @onclick="AlternarCalendario">

                                <span>
                                    @modelo.Fecha.ToString("dd/MM/yyyy")
                                </span>

                                <i class="bi bi-calendar3"></i>

                            </button>

                            @if (calendarioAbierto)
                            {
                                <div class="calendario-crear">

                                    <div class="calendario-crear-header">

                                        <button type="button"
                                                class="calendario-crear-nav"
                                                title="Mes anterior"
                                                @onclick="IrMesAnteriorCalendario">

                                            <i class="bi bi-chevron-left"></i>

                                        </button>

                                        <strong>
                                            @FormatearMesCalendario(mesCalendario)
                                        </strong>

                                        <button type="button"
                                                class="calendario-crear-nav"
                                                title="Mes siguiente"
                                                @onclick="IrMesSiguienteCalendario">

                                            <i class="bi bi-chevron-right"></i>

                                        </button>

                                    </div>

                                    <div class="calendario-crear-semana">
                                        <span>Lu</span>
                                        <span>Ma</span>
                                        <span>Mi</span>
                                        <span>Ju</span>
                                        <span>Vi</span>
                                        <span>Sá</span>
                                        <span>Do</span>
                                    </div>

                                    <div class="calendario-crear-dias">

                                        @foreach (var dia in ObtenerDiasCalendarioCrear())
                                        {
                                            <button type="button"
                                                    class="@ObtenerClaseDiaCalendario(dia)"
                                                    @onclick="() => SeleccionarFechaCalendario(dia)">

                                                @dia.Day

                                            </button>
                                        }

                                    </div>

                                    <div class="calendario-crear-footer">

                                        <button type="button"
                                                @onclick="SeleccionarHoy">
                                            Hoy
                                        </button>

                                    </div>

                                </div>
                            }

                            <ValidationMessage For="@(() => modelo.Fecha)" />

                        </div>
                        <div class="campo">

                            <label>
                                Profesionales
                            </label>

                            <div class="selector-desplegable">

                                <button type="button"
                                        class="selector-desplegable-boton"
                                        aria-expanded="@mostrarSelectorProfesionales"
                                        @onclick="AlternarSelectorProfesionales">

                                    <span>
                                        @TextoProfesionalesSeleccionados
                                    </span>

                                    <i class="bi @(mostrarSelectorProfesionales
                                                       ? "bi-chevron-up"
                                                       : "bi-chevron-down")">
                                    </i>

                                </button>

                                @if (mostrarSelectorProfesionales)
                                {
                                    <div class="selector-desplegable-menu">

                                        <div class="buscador-selector">

                                            <i class="bi bi-search"></i>

                                            <input type="text"
                                                   class="buscador-selector-input"
                                                   placeholder="Buscar profesional..."
                                                   autocomplete="off"
                                                   @bind="busquedaProfesional"
                                                   @bind:event="oninput" />

                                        </div>

                                        <div class="selector-desplegable-opciones">

                                            @if (ProfesionalesFiltrados.Count == 0)
                                            {
                                                <div class="selector-multiple-vacio">
                                                    No se encontraron profesionales.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var profesional in ProfesionalesFiltrados)
                                                {
                                                    var estaSeleccionado =
                                                        modelo.ProfesionalIds.Contains(
                                                            profesional.Id
                                                        );

                                                    <button type="button"
                                                            class="@(estaSeleccionado
                                                                                                ? "selector-desplegable-opcion seleccionado"
                                                                                                : "selector-desplegable-opcion")"
                                                            @onclick="() => AlternarProfesional(
                                                                                                profesional.Id
                                                                                            )">

                                                            <span>@profesional.Nombre</span>

                                @if (estaSeleccionado)
                                                        {
                                                            <i class="bi bi-check-lg"></i>
                                                        }

                                                    </button>
                                                }
                                            }

                                        </div>

                                        <div class="selector-desplegable-footer">

                                            <span>
                                                @modelo.ProfesionalIds.Count
                                                @(modelo.ProfesionalIds.Count == 1
                                                    ? "seleccionado"
                                                    : "seleccionados")
                                            </span>

                                            <button type="button"
                                                    @onclick="CerrarSelectorProfesionales">
                                                Listo
                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (modelo.ProfesionalIds.Count > 0)
                            {
                                <div class="selector-multiple-seleccionados">

                                    @foreach (var profesionalId in modelo.ProfesionalIds)
                                    {
                                        var profesional = profesionales.FirstOrDefault(
                                            item => item.Id == profesionalId
                                        );

                                        if (profesional is not null)
                                        {
                                            <span class="selector-multiple-chip">

                                                @profesional.Nombre

                                                <button type="button"
                                                        title="Quitar profesional"
                                                        @onclick="() => QuitarProfesional(
                                                                                        profesional.Id
                                                                                    )">
                                                        <i class="bi bi-x"></i>
                                                        </button>

                                            </span>
                                        }
                                    }

                                </div>
                            }

                        </div>

                        <div class="campo">

                            <label>
                                Pacientes
                            </label>

                            <div class="selector-desplegable">

                                <button type="button"
                                        class="selector-desplegable-boton"
                                        aria-expanded="@mostrarSelectorPacientes"
                                        @onclick="AlternarSelectorPacientes">

                                    <span>
                                        @TextoPacientesSeleccionados
                                    </span>

                                    <i class="bi @(mostrarSelectorPacientes
                                                       ? "bi-chevron-up"
                                                       : "bi-chevron-down")">
                                    </i>

                                </button>

                                @if (mostrarSelectorPacientes)
                                {
                                    <div class="selector-desplegable-menu">

                                        <div class="buscador-selector">

                                            <i class="bi bi-search"></i>

                                            <input type="text"
                                                   class="buscador-selector-input"
                                                   placeholder="Buscar por nombre o DNI..."
                                                   autocomplete="off"
                                                   @bind="busquedaPaciente"
                                                   @bind:event="oninput" />

                                        </div>

                                        <div class="selector-desplegable-opciones">

                                            @if (PacientesFiltrados.Count == 0)
                                            {
                                                <div class="selector-multiple-vacio">
                                                    No se encontraron pacientes.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var paciente in PacientesFiltrados)
                                                {
                                                    var estaSeleccionado =
                                                        modelo.PacienteIds.Contains(
                                                            paciente.Id
                                                        );

                                                    <button type="button"
                                                            class="@(estaSeleccionado
                                                                                                ? "selector-desplegable-opcion seleccionado"
                                                                                                : "selector-desplegable-opcion")"
                                                            @onclick="() => AlternarPaciente(
                                                                                                paciente.Id
                                                                                            )">

                                                                        <span>
                                                            @paciente.Nombre — DNI @paciente.DNI
                                                        </span>

                                                        @if (estaSeleccionado)
                                                        {
                                                            <i class="bi bi-check-lg"></i>
                                                        }

                                                    </button>
                                                }
                                            }

                                        </div>

                                        <div class="selector-desplegable-footer">

                                            <span>
                                                @modelo.PacienteIds.Count
                                                @(modelo.PacienteIds.Count == 1
                                                    ? "seleccionado"
                                                    : "seleccionados")
                                            </span>

                                            <button type="button"
                                                    @onclick="CerrarSelectorPacientes">
                                                Listo
                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>

                            @if (modelo.PacienteIds.Count > 0)
                            {
                                <div class="selector-multiple-seleccionados">

                                    @foreach (var pacienteId in modelo.PacienteIds)
                                    {
                                        var paciente = pacientes.FirstOrDefault(
                                            item => item.Id == pacienteId
                                        );

                                        if (paciente is not null)
                                        {
                                            <span class="selector-multiple-chip">

                                                @paciente.Nombre

                                                <button type="button"
                                                        title="Quitar paciente"
                                                        @onclick="() => QuitarPaciente(paciente.Id)">
                                                        <i class="bi bi-x"></i>
                                                </button>

                                            </span>
                                        }
                                    }

                                </div>
                            }

                        
                    </div>

                    <div class="campo campo-completo">

                        <label for="frecuenciaRecurrencia">
                            Repetición
                        </label>

                        <InputSelect id="frecuenciaRecurrencia"
                                     class="form-select"
                                     @bind-Value="modelo.FrecuenciaRecurrencia">

                            <option value="@EnumFrecuenciaRecurrenciaTurno.noRepite">
                                No repetir
                            </option>

                            <option value="@EnumFrecuenciaRecurrenciaTurno.semanal">
                                Una vez por semana
                            </option>

                            <option value="@EnumFrecuenciaRecurrenciaTurno.cadaQuinceDias">
                                Cada 15 días
                            </option>

                            <option value="@EnumFrecuenciaRecurrenciaTurno.mensual">
                                Una vez por mes
                            </option>

                            <option value="@EnumFrecuenciaRecurrenciaTurno.personalizado">
                                Personalizado
                            </option>

                        </InputSelect>

                    </div>

                        @if (EsRecurrenciaPersonalizada)
                        {
                            <div class="campo">

                                <label for="intervaloRecurrencia">
                                    Repetir cada
                                </label>

                                <InputNumber id="intervaloRecurrencia"
                                             class="form-control"
                                             min="1"
                                             max="365"
                                             @bind-Value="modelo.IntervaloRecurrencia" />

                                @if (modelo.IntervaloRecurrencia <= 0)
                                {
                                    <span class="validation-message">
                                        El intervalo debe ser mayor que cero.
                                    </span>
                                }

                            </div>

                            <div class="campo">

                                <label for="unidadRecurrencia">
                                    Unidad
                                </label>

                                <InputSelect id="unidadRecurrencia"
                                             TValue="EnumUnidadRecurrenciaTurno?"
                                             class="form-select"
                                             @bind-Value="modelo.UnidadRecurrencia">

                                    <option value="">
                                        Seleccione una unidad
                                    </option>

                                    <option value="@EnumUnidadRecurrenciaTurno.dias">
                                        Días
                                    </option>

                                    <option value="@EnumUnidadRecurrenciaTurno.semanas">
                                        Semanas
                                    </option>

                                    <option value="@EnumUnidadRecurrenciaTurno.meses">
                                        Meses
                                    </option>

                                </InputSelect>

                            </div>
                        }

                        @if (EsRecurrente)
                        {
                            <div class="campo campo-completo">

                                <label>
                                    Repetir hasta
                                </label>

                                <div class="fecha-recurrencia-contenedor">

                                    <button type="button"
                                            class="fecha-selector"
                                            aria-expanded="@calendarioRecurrenciaAbierto"
                                            @onclick="AlternarCalendarioRecurrencia">

                                        <span>
                                            @(modelo.FechaHastaRecurrencia.HasValue
                                                ? modelo.FechaHastaRecurrencia.Value
                                                    .ToString("dd/MM/yyyy")
                                                : "Seleccione una fecha")
                                        </span>

                                        <i class="bi bi-calendar3"></i>

                                    </button>

                                    @if (calendarioRecurrenciaAbierto)
                                    {
                                        <div class="calendario-crear calendario-recurrencia">

                                            <div class="calendario-crear-header">

                                                <button type="button"
                                                        class="calendario-crear-nav"
                                                        title="Mes anterior"
                                                        @onclick="IrMesAnteriorRecurrencia">

                                                    <i class="bi bi-chevron-left"></i>

                                                </button>

                                                <strong>
                                                    @FormatearMesCalendario(
                                                        mesCalendarioRecurrencia
                                                    )
                                                </strong>

                                                <button type="button"
                                                        class="calendario-crear-nav"
                                                        title="Mes siguiente"
                                                        @onclick="IrMesSiguienteRecurrencia">

                                                    <i class="bi bi-chevron-right"></i>

                                                </button>

                                            </div>

                                            <div class="calendario-crear-semana">
                                                <span>Lu</span>
                                                <span>Ma</span>
                                                <span>Mi</span>
                                                <span>Ju</span>
                                                <span>Vi</span>
                                                <span>Sá</span>
                                                <span>Do</span>
                                            </div>

                                            <div class="calendario-crear-dias">

                                                @foreach (
                                                    var dia in ObtenerDiasCalendarioRecurrencia()
                                                )
                                                {
                                                    <button type="button"
                                                            class="@ObtenerClaseDiaRecurrencia(dia)"
                                                            disabled="@(dia.Date < modelo.Fecha.Date)"
                                                            @onclick="() =>
                                                                                                SeleccionarFechaRecurrencia(dia)">

                                                    @dia.Day

                                                    </button>
                                                }

                                            </div>

                                            <div class="calendario-crear-footer">

                                                <button type="button"
                                                        @onclick="SeleccionarMismaFechaRecurrencia">
                                                    Misma fecha
                                                </button>

                                            </div>

                                        </div>
                                    }

                                </div>

                                <span class="campo-ayuda">
                                    Se crearán turnos hasta esta fecha inclusive.
                                </span>

                                @if (modelo.FechaHastaRecurrencia.HasValue
                                    && modelo.FechaHastaRecurrencia.Value.Date
                                        < modelo.Fecha.Date)
                                {
                                    <span class="validation-message">
                                        La fecha final no puede ser anterior al primer turno.
                                    </span>
                                }

                            </div>
                        }

                            @if (modelo.FechaHastaRecurrencia.HasValue
                                && modelo.FechaHastaRecurrencia.Value.Date
                                    < modelo.Fecha.Date)
                            {
                                <span class="validation-message">
                                    La fecha final no puede ser anterior al primer turno.
                                </span>
                            }
                            
                        @if (EsRecurrente && RecurrenciaValida)
{
    var fechasVistaPrevia =
        ObtenerFechasRecurrenciaVistaPrevia();

    if (fechasVistaPrevia.Count > 0)
    {
        <div class="recurrencia-resumen campo-completo">

            <div class="recurrencia-resumen-header">

                <i class="bi bi-arrow-repeat"></i>

                <div>
                    <strong>
                        @fechasVistaPrevia.Count
                        @(fechasVistaPrevia.Count == 1
                            ? "turno será creado"
                            : "turnos serán creados")
                    </strong>

                    <span>
                        Incluyendo el primer turno.
                    </span>
                </div>

            </div>

            <div class="recurrencia-fechas">

                @foreach (
                    var fecha in fechasVistaPrevia.Take(8)
                )
                {
                    <span class="recurrencia-fecha">
                        @fecha.ToString("dd/MM/yyyy")
                    </span>
                }

                @if (fechasVistaPrevia.Count > 8)
                {
                    <span class="recurrencia-fecha recurrencia-fecha-mas">
                        +@(fechasVistaPrevia.Count - 8) más
                    </span>
                }

            </div>

        </div>
    }
}
                    
                </div>
                    <button type="button"
                            class="btn-consultar"
                            disabled="@consultandoHorarios"
                            @onclick="CargarHorasDisponibles">

                        @if (consultandoHorarios)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Consultando...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Consultar horarios disponibles</span>
                        }

                    </button>

                </section>

                <section class="form-card horarios-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            02
                        </div>

                        <div>
                            <h2>Horarios disponibles</h2>

                            <p>
                                Elegí el horario de inicio
                                para el turno.
                            </p>
                        </div>

                    </div>

                    @if (!horariosConsultados)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-clock"></i>

                            <p>
                                Completá los datos del turno
                                y consultá la disponibilidad.
                            </p>

                        </div>
                    }
                    else if (horasDisponibles.Count == 0)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-calendar-x"></i>

                            <p>
                                No hay horarios disponibles
                                para esta selección.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="horarios-grid">

                            @foreach (var hora in horasDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseHorario(hora)"
                                        @onclick="() => SeleccionarHora(hora)">

                                    @hora

                                </button>
                            }

                        </div>
                    }

                </section>

            </div>

            @if (!string.IsNullOrWhiteSpace(horaSeleccionada))
            {
                <section class="resumen-turno">

                    <div class="resumen-header">
                        <i class="bi bi-calendar-check"></i>

                        <div>
                            <h2>Resumen del turno</h2>
                            <p>Revisá los datos antes de guardar.</p>
                        </div>
                    </div>

                    <div class="resumen-grid">

                        <div class="resumen-item">
                            <span class="resumen-label">Fecha</span>

                            <strong>
                                @FormatearFecha(modelo.Fecha)
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Horario</span>

                            <strong>
                                @horaSeleccionada
                                -
                                @CalcularHoraFin()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Duración</span>

                            <strong>
                                @ObtenerDuracionSeleccionada() minutos
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Consultorio</span>

                            <strong>
                                @ObtenerNombreConsultorio()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">
                                Tipo de turno
                            </span>

                            <strong>
                                @ObtenerNombreTipoTurno()
                            </strong>
                        </div>

                    </div>

                </section>
            }

            <ValidationSummary class="validation-summary" />

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-form">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>
                </div>
            }

            <footer class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@guardando"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@(!PuedeGuardar || guardando)">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Guardar turno</span>
                    }

                </button>

            </footer>

        </EditForm>
    }

</div>

@code {
    private TurnoDTO modelo = new()
    {
        EstadoTurno = EnumEstadoTurno.reservado,
        Fecha = DateTime.Today,
        Hora = TimeOnly.MinValue
    };

    private List<TipoTurnoListadoDTO> tiposTurno = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();
    private List<ProfesionalListadoDTO> profesionales = new();
    private List<PacienteResumenDTO> pacientes = new();
    private List<string> horasDisponibles = new();

    private string horaSeleccionada = string.Empty;
    private string Mensaje = string.Empty;
    private string busquedaProfesional = string.Empty;
    private string busquedaPaciente = string.Empty;


    private bool cargando = true;
    private bool consultandoHorarios;
    private bool horariosConsultados;
    private bool guardando;
    private bool mostrarSelectorProfesionales;
    private bool mostrarSelectorPacientes;
    



    private bool EsRecurrente =>
    modelo.FrecuenciaRecurrencia !=
    EnumFrecuenciaRecurrenciaTurno.noRepite;

    private bool RecurrenciaValida
    {
        get
        {
            if (!EsRecurrente)
            {
                return true;
            }

            var fechaValida =
                modelo.FechaHastaRecurrencia.HasValue
                && modelo.FechaHastaRecurrencia.Value.Date
                    >= modelo.Fecha.Date;

            if (!fechaValida)
            {
                return false;
            }

            if (!EsRecurrenciaPersonalizada)
            {
                return true;
            }

            return modelo.IntervaloRecurrencia > 0
                && modelo.UnidadRecurrencia.HasValue;
        }
    }

    private List<DateTime> ObtenerFechasRecurrenciaVistaPrevia()
    {
        if (!EsRecurrente || !RecurrenciaValida)
        {
            return new List<DateTime>();
        }

        try
        {
            return CalculadorRecurrenciaTurno.CalcularFechas(
                modelo.Fecha,
                modelo.FrecuenciaRecurrencia,
                modelo.FechaHastaRecurrencia,
                modelo.IntervaloRecurrencia,
                modelo.UnidadRecurrencia
            );
        }
        catch
        {
            return new List<DateTime>();
        }
    }




