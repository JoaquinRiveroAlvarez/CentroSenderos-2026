    private void SeleccionarFechaRecurrencia(DateTime fecha)
    {
        if (fecha.Date < modelo.Fecha.Date)
        {
            return;
        }

        modelo.FechaHastaRecurrencia = fecha.Date;

        mesCalendarioRecurrencia = new DateTime(
            fecha.Year,
            fecha.Month,
            1
        );

        calendarioRecurrenciaAbierto = false;
        Mensaje = string.Empty;
    }

