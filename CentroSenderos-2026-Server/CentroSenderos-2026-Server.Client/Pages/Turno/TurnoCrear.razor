    private List<DateTime> ObtenerDiasCalendarioCrear()
    {
        var primerDiaMes = new DateTime(
            mesCalendario.Year,
            mesCalendario.Month,
            1
        );

        var desplazamiento =
            ((int)primerDiaMes.DayOfWeek + 6) % 7;

        var primerDiaVisible =
            primerDiaMes.AddDays(-desplazamiento);

        return Enumerable
            .Range(0, 42)
            .Select(numero =>
                primerDiaVisible.AddDays(numero))
            .ToList();
    }

