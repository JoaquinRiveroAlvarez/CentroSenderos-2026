@page "/turnos/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turno-crear-page">

    <button type="button"
            class="btn-volver"
            @onclick="Cancelar">

        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>

    </button>

    <header class="crear-header">

        <div>
            <h1>Nuevo turno</h1>

            <p>
                Seleccioná los datos del turno y consultá
                los horarios disponibles.
            </p>
        </div>

    </header>

    @if (cargando)
    {
        <div class="estado-carga">

            <div class="spinner-border text-secondary"
                 role="status">
            </div>

            <span>Cargando datos...</span>

        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="turno-form">

            <DataAnnotationsValidator />

            <div class="form-layout">

                <section class="form-card datos-turno-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            01
                        </div>

                        <div>
                            <h2>Datos del turno</h2>

                            <p>
                                Completá la fecha, el tipo de turno
                                y el consultorio.
                            </p>
                        </div>

                    </div>

                    <div class="campos-grid">

                        <div class="campo campo-completo">

                            <label for="tipoTurno">
                                Tipo de turno
                            </label>

                            <InputSelect id="tipoTurno"
                                         class="form-select"
                                         @bind-Value="modelo.TipoTurnoId">

                                <option value="0">
                                    Seleccione un tipo de turno
                                </option>

                                @foreach (var tipo in tiposTurno)
                                {
                                    <option value="@tipo.Id">
                                        @tipo.Tipo
                                        (@tipo.DuracionMinutos min)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoTurnoId)" />

                        </div>

                        <div class="campo">

                            <label for="consultorio">
                                Consultorio
                            </label>

                            <InputSelect id="consultorio"
                                         class="form-select"
                                         @bind-Value="modelo.TipoConsultorioId">

                                <option value="0">
                                    Seleccione un consultorio
                                </option>

                                @foreach (var consultorio in consultorios)
                                {
                                    <option value="@consultorio.Id">
                                        @consultorio.Tipo
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoConsultorioId)" />

                        </div>

                        <div class="campo">

                            <label for="fechaTurno">
                                Fecha
                            </label>

                            <InputDate id="fechaTurno"
                                       class="form-control"
                                       @bind-Value="modelo.Fecha" />

                            <ValidationMessage For="@(() => modelo.Fecha)" />

                        </div>

                    </div>

                    <button type="button"
                            class="btn-consultar"
                            disabled="@consultandoHorarios"
                            @onclick="CargarHorasDisponibles">

                        @if (consultandoHorarios)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Consultando...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Consultar horarios disponibles</span>
                        }

                    </button>

                </section>

                <section class="form-card horarios-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            02
                        </div>

                        <div>
                            <h2>Horarios disponibles</h2>

                            <p>
                                Elegí el horario de inicio
                                para el turno.
                            </p>
                        </div>

                    </div>

                    @if (!horariosConsultados)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-clock"></i>

                            <p>
                                Completá los datos del turno
                                y consultá la disponibilidad.
                            </p>

                        </div>
                    }
                    else if (horasDisponibles.Count == 0)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-calendar-x"></i>

                            <p>
                                No hay horarios disponibles
                                para esta selección.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="horarios-grid">

                            @foreach (var hora in horasDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseHorario(hora)"
                                        @onclick="() => SeleccionarHora(hora)">

                                    @hora

                                </button>
                            }

                        </div>
                    }

                </section>

            </div>

            @if (!string.IsNullOrWhiteSpace(horaSeleccionada))
            {
                <section class="resumen-turno">

                    <div class="resumen-header">
                        <i class="bi bi-calendar-check"></i>

                        <div>
                            <h2>Resumen del turno</h2>
                            <p>Revisá los datos antes de guardar.</p>
                        </div>
                    </div>

                    <div class="resumen-grid">

                        <div class="resumen-item">
                            <span class="resumen-label">Fecha</span>

                            <strong>
                                @FormatearFecha(modelo.Fecha)
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Horario</span>

                            <strong>
                                @horaSeleccionada
                                -
                                @CalcularHoraFin()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Duración</span>

                            <strong>
                                @ObtenerDuracionSeleccionada() minutos
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Consultorio</span>

                            <strong>
                                @ObtenerNombreConsultorio()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">
                                Tipo de turno
                            </span>

                            <strong>
                                @ObtenerNombreTipoTurno()
                            </strong>
                        </div>

                    </div>

                </section>
            }

            <ValidationSummary class="validation-summary" />

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-form">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>
                </div>
            }

            <footer class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@guardando"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@(!PuedeGuardar || guardando)">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Guardar turno</span>
                    }

                </button>

            </footer>

        </EditForm>
    }

</div>

@code {
    private TurnoDTO modelo = new()
    {
        EstadoTurno = EnumEstadoTurno.reservado,
        Fecha = DateTime.Today,
        Hora = TimeOnly.MinValue
    };

    private List<TipoTurnoListadoDTO> tiposTurno = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();
    private List<string> horasDisponibles = new();

    private string horaSeleccionada = string.Empty;
    private string Mensaje = string.Empty;

    private bool cargando = true;
    private bool consultandoHorarios;
    private bool horariosConsultados;
    private bool guardando;

    private bool PuedeGuardar =>
        modelo.TipoTurnoId > 0
        && modelo.TipoConsultorioId > 0
        && modelo.Fecha != DateTime.MinValue
        && !string.IsNullOrWhiteSpace(horaSeleccionada);

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respTurnos =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );

        if (!respTurnos.Error
            && respTurnos.Respuesta is not null)
        {
            tiposTurno = respTurnos.Respuesta;
        }
        else if (respTurnos.Error)
        {
            Mensaje = respTurnos.ObtenerError();
        }

        var respConsultorios =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );

        if (!respConsultorios.Error
            && respConsultorios.Respuesta is not null)
        {
            consultorios = respConsultorios.Respuesta;
        }
        else if (respConsultorios.Error
            && string.IsNullOrWhiteSpace(Mensaje))
        {
            Mensaje = respConsultorios.ObtenerError();
        }

        cargando = false;
    }

    private async Task CargarHorasDisponibles()
    {
        Mensaje = string.Empty;
        horasDisponibles.Clear();
        horaSeleccionada = string.Empty;
        modelo.Hora = TimeOnly.MinValue;
        horariosConsultados = false;

        if (modelo.TipoTurnoId <= 0)
        {
            Mensaje = "Seleccioná un tipo de turno.";
            return;
        }

        if (modelo.TipoConsultorioId <= 0)
        {
            Mensaje = "Seleccioná un consultorio.";
            return;
        }

        if (modelo.Fecha == DateTime.MinValue)
        {
            Mensaje = "Seleccioná una fecha.";
            return;
        }

        consultandoHorarios = true;

        var resp =
            await Http.Get<List<string>>(
                $"api/turno/Disponibles" +
                $"?fecha={modelo.Fecha:yyyy-MM-dd}" +
                $"&tipoTurnoId={modelo.TipoTurnoId}" +
                $"&consultorioId={modelo.TipoConsultorioId}"
            );

        horariosConsultados = true;
        consultandoHorarios = false;

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        horasDisponibles =
            resp.Respuesta ?? new List<string>();
    }

    private void SeleccionarHora(string hora)
    {
        horaSeleccionada = hora;

        modelo.Hora =
            TimeOnly.ParseExact(hora, "HH:mm");

        Mensaje = string.Empty;
    }

    private string ObtenerClaseHorario(string hora)
    {
        return hora == horaSeleccionada
            ? "horario-opcion seleccionado"
            : "horario-opcion";
    }

    private TipoTurnoListadoDTO? ObtenerTipoSeleccionado()
    {
        return tiposTurno.FirstOrDefault(
            tipo => tipo.Id == modelo.TipoTurnoId
        );
    }

    private int ObtenerDuracionSeleccionada()
    {
        return ObtenerTipoSeleccionado()
            ?.DuracionMinutos ?? 0;
    }

    private string CalcularHoraFin()
    {
        if (string.IsNullOrWhiteSpace(horaSeleccionada))
        {
            return "—";
        }

        var horaInicio =
            TimeOnly.ParseExact(
                horaSeleccionada,
                "HH:mm"
            );

        return horaInicio
            .AddMinutes(ObtenerDuracionSeleccionada())
            .ToString("HH:mm");
    }

    private string ObtenerNombreTipoTurno()
    {
        return ObtenerTipoSeleccionado()
            ?.Tipo ?? "—";
    }

    private string ObtenerNombreConsultorio()
    {
        return consultorios
            .FirstOrDefault(
                consultorio =>
                    consultorio.Id ==
                    modelo.TipoConsultorioId
            )
            ?.Tipo ?? "—";
    }

    private static string FormatearFecha(DateTime fecha)
    {
        var texto = fecha.ToString(
            "dddd d 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-AR")
        );

        return char.ToUpper(texto[0]) + texto[1..];
    }

    private async Task Grabar()
    {
        if (!PuedeGuardar)
        {
            Mensaje =
                "Completá los datos y seleccioná un horario.";
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Hora =
            TimeOnly.ParseExact(
                horaSeleccionada,
                "HH:mm"
            );

        var resp =
            await Http.Post<TurnoDTO, int>(
                "api/turno",
                modelo
            );

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            guardando = false;
            return;
        }

        Nav.NavigateTo(
            "/turnos",
            forceLoad: true
        );
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/turnos");
    }
}