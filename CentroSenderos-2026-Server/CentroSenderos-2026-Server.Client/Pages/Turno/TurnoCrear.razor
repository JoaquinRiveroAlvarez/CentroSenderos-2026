    private string ObtenerClaseDiaRecurrencia(DateTime dia)
    {
        var clases = new List<string>
    {
        "calendario-crear-dia"
    };

        if (dia.Month != mesCalendarioRecurrencia.Month)
        {
            clases.Add("otro-mes");
        }

        if (dia.Date == DateTime.Today)
        {
            clases.Add("hoy");
        }

        if (modelo.FechaHastaRecurrencia.HasValue
            && dia.Date ==
                modelo.FechaHastaRecurrencia.Value.Date)
        {
            clases.Add("seleccionado");
        }

        if (dia.Date < modelo.Fecha.Date)
        {
            clases.Add("fecha-no-disponible");
        }

        return string.Join(" ", clases);
    }







    private async Task Grabar()
    {
        if (!PuedeGuardar)
        {
            Mensaje =
                "Completá los datos y seleccioná un horario.";
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Hora =
            TimeOnly.ParseExact(
                horaSeleccionada,
                "HH:mm"
            );

        var resp =
            await Http.Post<TurnoDTO, int>(
                "api/turno",
                modelo
            );

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            guardando = false;
            return;
        }

        Nav.NavigateTo(
        "/turnos?estado=creado",
        forceLoad: true
        );
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/turnos");
    }
