@page "/turnos/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="turno-crear-page">

    <button type="button"
            class="btn-volver"
            @onclick="Cancelar">

        <i class="bi bi-arrow-left"></i>
        <span>Volver a la agenda</span>

    </button>

    <header class="crear-header">

        <div>
            <h1>Nuevo turno</h1>

            <p>
                Seleccioná los datos del turno y consultá
                los horarios disponibles.
            </p>
        </div>

    </header>

    @if (cargando)
    {
        <div class="estado-carga">

            <div class="spinner-border text-secondary"
                 role="status">
            </div>

            <span>Cargando datos...</span>

        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="turno-form">

            <DataAnnotationsValidator />

            <div class="form-layout">

                <section class="form-card datos-turno-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            01
                        </div>

                        <div>
                            <h2>Datos del turno</h2>

                            <p>
                                Completá la fecha, el tipo de turno
                                y el consultorio.
                            </p>
                        </div>

                    </div>

                    <div class="campos-grid">

                        <div class="campo campo-completo">

                            <label for="tipoTurno">
                                Tipo de turno
                            </label>

                            <InputSelect id="tipoTurno"
                                         class="form-select"
                                         @bind-Value="modelo.TipoTurnoId">

                                <option value="0">
                                    Seleccione un tipo de turno
                                </option>

                                @foreach (var tipo in tiposTurno)
                                {
                                    <option value="@tipo.Id">
                                        @tipo.Tipo
                                        (@tipo.DuracionMinutos min)
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoTurnoId)" />

                        </div>

                        <div class="campo">

                            <label for="consultorio">
                                Consultorio
                            </label>

                            <InputSelect id="consultorio"
                                         class="form-select"
                                         @bind-Value="modelo.TipoConsultorioId">

                                <option value="0">
                                    Seleccione un consultorio
                                </option>

                                @foreach (var consultorio in consultorios)
                                {
                                    <option value="@consultorio.Id">
                                        @consultorio.Tipo
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.TipoConsultorioId)" />

                        </div>

                        <div class="campo campo-fecha">

                            <label>
                                Fecha
                            </label>

                            <button type="button"
                                    class="fecha-selector"
                                    aria-expanded="@calendarioAbierto"
                                    @onclick="AlternarCalendario">

                                <span>
                                    @modelo.Fecha.ToString("dd/MM/yyyy")
                                </span>

                                <i class="bi bi-calendar3"></i>

                            </button>

                            @if (calendarioAbierto)
                            {
                                <div class="calendario-crear">

                                    <div class="calendario-crear-header">

                                        <button type="button"
                                                class="calendario-crear-nav"
                                                title="Mes anterior"
                                                @onclick="IrMesAnteriorCalendario">

                                            <i class="bi bi-chevron-left"></i>

                                        </button>

                                        <strong>
                                            @FormatearMesCalendario(mesCalendario)
                                        </strong>

                                        <button type="button"
                                                class="calendario-crear-nav"
                                                title="Mes siguiente"
                                                @onclick="IrMesSiguienteCalendario">

                                            <i class="bi bi-chevron-right"></i>

                                        </button>

                                    </div>

                                    <div class="calendario-crear-semana">
                                        <span>Lu</span>
                                        <span>Ma</span>
                                        <span>Mi</span>
                                        <span>Ju</span>
                                        <span>Vi</span>
                                        <span>Sá</span>
                                        <span>Do</span>
                                    </div>

                                    <div class="calendario-crear-dias">

                                        @foreach (var dia in ObtenerDiasCalendarioCrear())
                                        {
                                            <button type="button"
                                                    class="@ObtenerClaseDiaCalendario(dia)"
                                                    @onclick="() => SeleccionarFechaCalendario(dia)">

                                                @dia.Day

                                            </button>
                                        }

                                    </div>

                                    <div class="calendario-crear-footer">

                                        <button type="button"
                                                @onclick="SeleccionarHoy">
                                            Hoy
                                        </button>

                                    </div>

                                </div>
                            }

                            <ValidationMessage For="@(() => modelo.Fecha)" />

                        </div>
                        <div class="campo">

                            <label for="profesional">
                                Profesional
                            </label>

                            <div class="buscador-selector">

                                <i class="bi bi-search"></i>

                                <input type="text"
                                       class="buscador-selector-input"
                                       placeholder="Buscar profesional..."
                                       autocomplete="off"
                                       @bind="busquedaProfesional"
                                       @bind:event="oninput" />

                            </div>

                            <InputSelect id="profesional"
                                         class="form-select selector-con-buscador"
                                         @bind-Value="modelo.ProfesionalId">

                                <option value="0">
                                    Seleccione un profesional
                                </option>

                                @foreach (var profesional in ProfesionalesFiltrados)
                                {
                                    <option value="@profesional.Id">
                                        @profesional.Nombre
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <div class="campo">

                            <label for="paciente">
                                Paciente
                            </label>

                            <div class="buscador-selector">

                                <i class="bi bi-search"></i>

                                <input type="text"
                                       class="buscador-selector-input"
                                       placeholder="Buscar por nombre o DNI..."
                                       autocomplete="off"
                                       @bind="busquedaPaciente"
                                       @bind:event="oninput" />

                            </div>

                            <InputSelect id="paciente"
                                         class="form-select selector-con-buscador"
                                         @bind-Value="modelo.PacienteId">

                                <option value="0">
                                    Seleccione un paciente
                                </option>

                                @foreach (var paciente in PacientesFiltrados)
                                {
                                    <option value="@paciente.Id">
                                        @paciente.Nombre — DNI @paciente.DNI
                                    </option>
                                }

                            </InputSelect>

                        </div>
                    </div>

                    <button type="button"
                            class="btn-consultar"
                            disabled="@consultandoHorarios"
                            @onclick="CargarHorasDisponibles">

                        @if (consultandoHorarios)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status">
                            </span>

                            <span>Consultando...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Consultar horarios disponibles</span>
                        }

                    </button>

                </section>

                <section class="form-card horarios-card">

                    <div class="seccion-header">

                        <div class="seccion-numero">
                            02
                        </div>

                        <div>
                            <h2>Horarios disponibles</h2>

                            <p>
                                Elegí el horario de inicio
                                para el turno.
                            </p>
                        </div>

                    </div>

                    @if (!horariosConsultados)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-clock"></i>

                            <p>
                                Completá los datos del turno
                                y consultá la disponibilidad.
                            </p>

                        </div>
                    }
                    else if (horasDisponibles.Count == 0)
                    {
                        <div class="horarios-vacio">

                            <i class="bi bi-calendar-x"></i>

                            <p>
                                No hay horarios disponibles
                                para esta selección.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="horarios-grid">

                            @foreach (var hora in horasDisponibles)
                            {
                                <button type="button"
                                        class="@ObtenerClaseHorario(hora)"
                                        @onclick="() => SeleccionarHora(hora)">

                                    @hora

                                </button>
                            }

                        </div>
                    }

                </section>

            </div>

            @if (!string.IsNullOrWhiteSpace(horaSeleccionada))
            {
                <section class="resumen-turno">

                    <div class="resumen-header">
                        <i class="bi bi-calendar-check"></i>

                        <div>
                            <h2>Resumen del turno</h2>
                            <p>Revisá los datos antes de guardar.</p>
                        </div>
                    </div>

                    <div class="resumen-grid">

                        <div class="resumen-item">
                            <span class="resumen-label">Fecha</span>

                            <strong>
                                @FormatearFecha(modelo.Fecha)
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Horario</span>

                            <strong>
                                @horaSeleccionada
                                -
                                @CalcularHoraFin()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Duración</span>

                            <strong>
                                @ObtenerDuracionSeleccionada() minutos
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">Consultorio</span>

                            <strong>
                                @ObtenerNombreConsultorio()
                            </strong>
                        </div>

                        <div class="resumen-item">
                            <span class="resumen-label">
                                Tipo de turno
                            </span>

                            <strong>
                                @ObtenerNombreTipoTurno()
                            </strong>
                        </div>

                    </div>

                </section>
            }

            <ValidationSummary class="validation-summary" />

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-form">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>
                </div>
            }

            <footer class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@guardando"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@(!PuedeGuardar || guardando)">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Guardar turno</span>
                    }

                </button>

            </footer>

        </EditForm>
    }

</div>

@code {
    private TurnoDTO modelo = new()
    {
        EstadoTurno = EnumEstadoTurno.reservado,
        Fecha = DateTime.Today,
        Hora = TimeOnly.MinValue
    };

    private List<TipoTurnoListadoDTO> tiposTurno = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();
    private List<ProfesionalListadoDTO> profesionales = new();
    private List<PacienteResumenDTO> pacientes = new();
    private List<string> horasDisponibles = new();

    private string horaSeleccionada = string.Empty;
    private string Mensaje = string.Empty;
    private string busquedaProfesional = string.Empty;
    private string busquedaPaciente = string.Empty;


    private bool cargando = true;
    private bool consultandoHorarios;
    private bool horariosConsultados;
    private bool guardando;

    private bool PuedeGuardar =>
    modelo.TipoTurnoId > 0
    && modelo.TipoConsultorioId > 0
    && modelo.ProfesionalId > 0
    && modelo.PacienteId > 0
    && modelo.Fecha != DateTime.MinValue
    && !string.IsNullOrWhiteSpace(horaSeleccionada);

    private List<ProfesionalListadoDTO> ProfesionalesFiltrados =>
    string.IsNullOrWhiteSpace(busquedaProfesional)
        ? profesionales
        : profesionales
            .Where(profesional =>
                profesional.Nombre.Contains(
                    busquedaProfesional,
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();
    
    private List<PacienteResumenDTO> PacientesFiltrados =>
        string.IsNullOrWhiteSpace(busquedaPaciente)
            ? pacientes
            : pacientes
                .Where(paciente =>
                    paciente.Nombre.Contains(
                        busquedaPaciente,
                        StringComparison.OrdinalIgnoreCase
                    )
                    || paciente.DNI.Contains(
                        busquedaPaciente,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .ToList();




    private bool calendarioAbierto;

    private DateTime mesCalendario = new(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1
    );

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        Mensaje = string.Empty;

        var respTurnos =
            await Http.Get<List<TipoTurnoListadoDTO>>(
                "api/tipoturno/ListaTipoTurno"
            );

        if (!respTurnos.Error
            && respTurnos.Respuesta is not null)
        {
            tiposTurno = respTurnos.Respuesta;
        }
        else if (respTurnos.Error)
        {
            Mensaje = respTurnos.ObtenerError();
        }

        var respConsultorios =
            await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );

        if (!respConsultorios.Error
            && respConsultorios.Respuesta is not null)
        {
            consultorios = respConsultorios.Respuesta;
        }
        else if (respConsultorios.Error
            && string.IsNullOrWhiteSpace(Mensaje))
        {
            Mensaje = respConsultorios.ObtenerError();
        }

        var respProfesionales =
    await Http.Get<List<ProfesionalListadoDTO>>(
        "api/profesional/ListaProfesional"
    );

        if (!respProfesionales.Error
            && respProfesionales.Respuesta is not null)
        {
            profesionales = respProfesionales.Respuesta
                .OrderBy(profesional => profesional.Nombre)
                .ToList();
        }
        else if (respProfesionales.Error
            && string.IsNullOrWhiteSpace(Mensaje))
        {
            Mensaje = respProfesionales.ObtenerError();
        }

        var respPacientes =
    await Http.Get<List<PacienteResumenDTO>>(
        "api/paciente/ListaPaciente"
    );

        if (!respPacientes.Error
            && respPacientes.Respuesta is not null)
        {
            pacientes = respPacientes.Respuesta
                .OrderBy(paciente => paciente.Nombre)
                .ToList();
        }
        else if (respPacientes.Error
            && string.IsNullOrWhiteSpace(Mensaje))
        {
            Mensaje = respPacientes.ObtenerError();
        }

        cargando = false;
    }

    private async Task CargarHorasDisponibles()
    {
        Mensaje = string.Empty;
        horasDisponibles.Clear();
        horaSeleccionada = string.Empty;
        modelo.Hora = TimeOnly.MinValue;
        horariosConsultados = false;

        if (modelo.TipoTurnoId <= 0)
        {
            Mensaje = "Seleccioná un tipo de turno.";
            return;
        }

        if (modelo.TipoConsultorioId <= 0)
        {
            Mensaje = "Seleccioná un consultorio.";
            return;
        }

        if (modelo.Fecha == DateTime.MinValue)
        {
            Mensaje = "Seleccioná una fecha.";
            return;
        }

        consultandoHorarios = true;

        var resp =
            await Http.Get<List<string>>(
                $"api/turno/Disponibles" +
                $"?fecha={modelo.Fecha:yyyy-MM-dd}" +
                $"&tipoTurnoId={modelo.TipoTurnoId}" +
                $"&consultorioId={modelo.TipoConsultorioId}"
            );

        horariosConsultados = true;
        consultandoHorarios = false;

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        horasDisponibles =
            resp.Respuesta ?? new List<string>();
    }

    private void SeleccionarHora(string hora)
    {
        horaSeleccionada = hora;

        modelo.Hora =
            TimeOnly.ParseExact(hora, "HH:mm");

        Mensaje = string.Empty;
    }

    private string ObtenerClaseHorario(string hora)
    {
        return hora == horaSeleccionada
            ? "horario-opcion seleccionado"
            : "horario-opcion";
    }

    private TipoTurnoListadoDTO? ObtenerTipoSeleccionado()
    {
        return tiposTurno.FirstOrDefault(
            tipo => tipo.Id == modelo.TipoTurnoId
        );
    }

    private int ObtenerDuracionSeleccionada()
    {
        return ObtenerTipoSeleccionado()
            ?.DuracionMinutos ?? 0;
    }

    private string CalcularHoraFin()
    {
        if (string.IsNullOrWhiteSpace(horaSeleccionada))
        {
            return "—";
        }

        var horaInicio =
            TimeOnly.ParseExact(
                horaSeleccionada,
                "HH:mm"
            );

        return horaInicio
            .AddMinutes(ObtenerDuracionSeleccionada())
            .ToString("HH:mm");
    }

    private string ObtenerNombreTipoTurno()
    {
        return ObtenerTipoSeleccionado()
            ?.Tipo ?? "—";
    }

    private string ObtenerNombreConsultorio()
    {
        return consultorios
            .FirstOrDefault(
                consultorio =>
                    consultorio.Id ==
                    modelo.TipoConsultorioId
            )
            ?.Tipo ?? "—";
    }

    private static string FormatearFecha(DateTime fecha)
    {
        var texto = fecha.ToString(
            "dddd d 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-AR")
        );

        return char.ToUpper(texto[0]) + texto[1..];
    }

    private void AlternarCalendario()
    {
        calendarioAbierto = !calendarioAbierto;

        if (calendarioAbierto)
        {
            mesCalendario = new DateTime(
                modelo.Fecha.Year,
                modelo.Fecha.Month,
                1
            );
        }
    }

    private void IrMesAnteriorCalendario()
    {
        mesCalendario =
            mesCalendario.AddMonths(-1);
    }

    private void IrMesSiguienteCalendario()
    {
        mesCalendario =
            mesCalendario.AddMonths(1);
    }

    private List<DateTime> ObtenerDiasCalendarioCrear()
    {
        var primerDiaMes = new DateTime(
            mesCalendario.Year,
            mesCalendario.Month,
            1
        );

        var desplazamiento =
            ((int)primerDiaMes.DayOfWeek + 6) % 7;

        var primerDiaVisible =
            primerDiaMes.AddDays(-desplazamiento);

        return Enumerable
            .Range(0, 42)
            .Select(numero =>
                primerDiaVisible.AddDays(numero))
            .ToList();
    }

    private void SeleccionarFechaCalendario(
        DateTime fecha)
    {
        modelo.Fecha = fecha.Date;

        mesCalendario = new DateTime(
            fecha.Year,
            fecha.Month,
            1
        );

        calendarioAbierto = false;

        ReiniciarDisponibilidad();
    }

    private void SeleccionarHoy()
    {
        modelo.Fecha = DateTime.Today;

        mesCalendario = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1
        );

        calendarioAbierto = false;

        ReiniciarDisponibilidad();
    }

    private void ReiniciarDisponibilidad()
    {
        horasDisponibles.Clear();
        horaSeleccionada = string.Empty;
        modelo.Hora = TimeOnly.MinValue;
        horariosConsultados = false;
        Mensaje = string.Empty;
    }

    private string ObtenerClaseDiaCalendario(
        DateTime dia)
    {
        var clases = new List<string>
    {
        "calendario-crear-dia"
    };

        if (dia.Month != mesCalendario.Month)
        {
            clases.Add("otro-mes");
        }

        if (dia.Date == DateTime.Today)
        {
            clases.Add("hoy");
        }

        if (dia.Date == modelo.Fecha.Date)
        {
            clases.Add("seleccionado");
        }

        return string.Join(" ", clases);
    }

    private static string FormatearMesCalendario(
        DateTime fecha)
    {
        var texto = fecha.ToString(
            "MMMM yyyy",
            new System.Globalization.CultureInfo("es-AR")
        );

        return char.ToUpper(texto[0]) + texto[1..];
    }

    private async Task Grabar()
    {
        if (!PuedeGuardar)
        {
            Mensaje =
                "Completá los datos y seleccioná un horario.";
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Hora =
            TimeOnly.ParseExact(
                horaSeleccionada,
                "HH:mm"
            );

        var resp =
            await Http.Post<TurnoDTO, int>(
                "api/turno",
                modelo
            );

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            guardando = false;
            return;
        }

        Nav.NavigateTo(
        "/turnos?estado=creado",
        forceLoad: true
        );
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/turnos");
    }
}