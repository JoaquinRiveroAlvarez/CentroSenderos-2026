    private async Task GuardarAsistenciaPaciente(TurnoPacienteDetalleDTO paciente,EnumAsistenciaPaciente? asistencia)
    {
        if (GuardandoDetalle ||
            turnoSeleccionado is null ||
            paciente.Asistencia == asistencia)
        {
