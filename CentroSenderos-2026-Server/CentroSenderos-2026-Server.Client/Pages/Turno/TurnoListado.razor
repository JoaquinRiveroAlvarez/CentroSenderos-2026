            _ => string.Empty
        };

        return $"turno-grilla {claseEstado}";
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(Estado))
        {
            return;
        }

        var esResultadoValido =
            Estado == "creado" ||
            Estado == "actualizado" ||
            Estado == "eliminado";

        if (!esResultadoValido)
        {
            return;
        }

        await Task.Delay(4000);

        mostrarMensajeResultado = false;

        await InvokeAsync(StateHasChanged);
    }








