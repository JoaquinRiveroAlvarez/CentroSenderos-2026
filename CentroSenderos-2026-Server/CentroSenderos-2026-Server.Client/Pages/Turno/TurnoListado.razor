    private async Task SolicitarCambioEstado()
    {
        if (GuardandoDetalle || turnoSeleccionado is null)
        {
            return;
        }

        if (estadoSeleccionado == EnumEstadoTurno.cancelado)
        {
            cancelarTurnosSiguientes = false;
            mostrarConfirmacionCancelacion = true;
            return;
        }

        await GuardarEstadoTurno();
    }

    
    private void CerrarConfirmacionCancelacion()
    {
        if (guardandoEstado)
        {
            return;
        }

        mostrarConfirmacionCancelacion = false;
        cancelarTurnosSiguientes = false;
        estadoSeleccionado =
            turnoSeleccionado?.EstadoTurno ?? EnumEstadoTurno.reservado;
    }

    private async Task ConfirmarCancelacionTurno()
    {
        if (GuardandoDetalle || turnoSeleccionado is null)
        {
            return;
        }

        guardandoEstado = true;
        mensajeEstado = string.Empty;
        errorEstado = false;

        try
        {
            var id = turnoSeleccionado.Id;
            var cancelarSiguientes =
                turnoSeleccionado.SerieTurnoId.HasValue &&
                cancelarTurnosSiguientes;

            var respuesta = await Http.Put<object, RespuestaDTO>(
                $"api/turno/{id}/cancelar" +
                $"?cancelarSiguientes={cancelarSiguientes.ToString().ToLowerInvariant()}",
                new { }
            );

            if (respuesta.Error)
            {
                errorEstado = true;
                mensajeEstado = respuesta.ObtenerError();
                mostrarConfirmacionCancelacion = false;
                estadoSeleccionado = turnoSeleccionado.EstadoTurno;
                return;
            }

            turnoSeleccionado.EstadoTurno = EnumEstadoTurno.cancelado;
            estadoSeleccionado = EnumEstadoTurno.cancelado;

            if (cancelarSiguientes)
            {
                foreach (var turno in listaTurnos.Where(t =>
                    t.SerieTurnoId == turnoSeleccionado.SerieTurnoId &&
                    t.FechaInicio >= turnoSeleccionado.FechaInicio &&
                    t.EstadoTurno == EnumEstadoTurno.reservado))
                {
                    turno.EstadoTurno = EnumEstadoTurno.cancelado;
                }
            }

            mensajeEstado = respuesta.Respuesta?.mensaje
                ?? "Cancelación realizada correctamente.";

            mostrarConfirmacionCancelacion = false;
            cancelarTurnosSiguientes = false;
        }
        catch
        {
            errorEstado = true;
            mensajeEstado = "No pudimos cancelar los turnos. Intentá nuevamente.";
            mostrarConfirmacionCancelacion = false;
            estadoSeleccionado = turnoSeleccionado.EstadoTurno;
        }
        finally
        {
            guardandoEstado = false;
        }
    }


    private async Task GuardarEstadoTurno()
    {
        if (GuardandoDetalle || turnoSeleccionado is null)
        {
            return;
        }

        var turno = turnoSeleccionado;
        var nuevoEstado = estadoSeleccionado;

        if (nuevoEstado == turno.EstadoTurno)
        {
            return;
        }

        guardandoEstado = true;
        mensajeEstado = string.Empty;
        errorEstado = false;

        try
        {
            var respuesta = await Http.Put<EnumEstadoTurno, RespuestaDTO>(
                $"api/turno/{turno.Id}/estado",
                nuevoEstado
            );

            if (respuesta.Error)
            {
                errorEstado = true;
                mensajeEstado = respuesta.ObtenerError();
                return;
            }

            turno.EstadoTurno = nuevoEstado;

            // Recargar los datos del turno para reflejar la asistencia.
            var respuestaTurno = await Http.Get<TurnoDTO>(
                $"api/turno/{turno.Id}"
            );

            if (!respuestaTurno.Error &&
                respuestaTurno.Respuesta is not null)
            {
                turno.PacientesDetalle =
                    respuestaTurno.Respuesta.PacientesDetalle;
            }

            mensajeEstado = "Estado actualizado correctamente.";
        }
        catch
        {
            errorEstado = true;

            mensajeEstado =
                "No pudimos actualizar el estado. Intentá nuevamente.";
        }
        finally
        {
            guardandoEstado = false;
        }
    }

