    private string FormatearRangoSemana()
    {
        var cultura =
            new System.Globalization.CultureInfo("es-AR");

        if (InicioSemana.Month == FinSemana.Month)
        {
            return $"{InicioSemana.Day} - " +
                   $"{FinSemana.Day} de " +
                   $"{FinSemana.ToString("MMMM", cultura)} de " +
                   $"{FinSemana.Year}";
        }

        if (InicioSemana.Year == FinSemana.Year)
        {
            return $"{InicioSemana.Day} de " +
                   $"{InicioSemana.ToString("MMMM", cultura)} - " +
                   $"{FinSemana.Day} de " +
                   $"{FinSemana.ToString("MMMM", cultura)} de " +
                   $"{FinSemana.Year}";
        }

        return $"{InicioSemana:dd/MM/yyyy} - " +
               $"{FinSemana:dd/MM/yyyy}";
    }

    
    private static string FormatearNombreDia(DateTime fecha)
    {
        var texto = fecha.ToString(
            "dddd",
            new System.Globalization.CultureInfo("es-AR")
        );

        return char.ToUpper(texto[0]) + texto[1..];
    }

