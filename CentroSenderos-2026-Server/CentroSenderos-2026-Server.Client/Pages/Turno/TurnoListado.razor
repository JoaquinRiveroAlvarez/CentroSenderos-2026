@page "/turnos"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="agenda-page">

    @if (mostrarMensajeResultado && Estado == "creado")
    {
        <div class="success-message">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Turno creado</strong>
                <span>El turno fue creado correctamente.</span>
            </div>
        </div>
    }
    else if (mostrarMensajeResultado && Estado == "actualizado")
    {
        <div class="success-message">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Turno actualizado</strong>
                <span>El turno se actualizó correctamente.</span>
            </div>
        </div>
    }
    else if (mostrarMensajeResultado && Estado == "serie-actualizada")
    {
        <div class="success-message">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Serie actualizada</strong>
                <span>
                    Los turnos futuros de la serie se actualizaron correctamente.
                </span>
            </div>
        </div>
    }
    else if (mostrarMensajeResultado && Estado == "eliminado")
    {
        <div class="success-message">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Turno eliminado</strong>
                <span>El turno fue eliminado correctamente.</span>
            </div>
        </div>
    }

    <div class="agenda-toolbar">

        <div class="navegacion-fecha">

            <button type="button"
                    class="btn-hoy"
                    @onclick="IrAHoy">
                Hoy
            </button>

            <span class="fecha-actual">
                @(vistaSemanal
                    ? FormatearRangoSemana()
                    : FormatearFechaCorta(fechaSeleccionada))
            </span>

        </div>

        <div class="selector-presentacion">

            <button type="button"
                    class="@(vistaAmpliada && !vistaSemanal
                        ? "btn-presentacion activo"
                        : "btn-presentacion")"
                    title="Agenda ampliada"
                    @onclick="MostrarVistaAmpliada">
                <i class="bi bi-grid-fill"></i>
            </button>

            <button type="button"
                    class="@(!vistaAmpliada && !vistaSemanal
                        ? "btn-presentacion activo"
                        : "btn-presentacion")"
                    title="Agenda en lista"
                    @onclick="MostrarVistaLista">
                <i class="bi bi-list-ul"></i>
            </button>

        </div>

        <div class="selector-periodo">

            <button type="button"
                    class="@(vistaSemanal
                        ? "periodo-inactivo"
                        : "periodo-activo")"
                    @onclick="MostrarVistaDiaria">
                Diaria
            </button>

            <button type="button"
                    class="@(vistaSemanal
                        ? "periodo-activo"
                        : "periodo-inactivo")"
                    @onclick="MostrarVistaSemanal">
                Semanal
            </button>

        </div>

        <button type="button"
                class="btn-nuevo-turno"
                @onclick="IrACrear">
            <i class="bi bi-plus-lg"></i>
            Turno
        </button>

    </div>

    <div class="agenda-layout">

        <aside class="calendario-panel">

            <div class="calendario-cabecera">

                <button type="button"
                        class="calendario-nav"
                        title="Mes anterior"
                        @onclick="IrMesAnterior">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <span>@FormatearMes(mesVisible)</span>

                <button type="button"
                        class="calendario-nav"
                        title="Mes siguiente"
                        @onclick="IrMesSiguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>

            <div class="calendario-semana">
                <span>Lu</span>
                <span>Ma</span>
                <span>Mi</span>
                <span>Ju</span>
                <span>Vi</span>
                <span>Sá</span>
                <span>Do</span>
            </div>

            <div class="calendario-dias">

                @foreach (var dia in ObtenerDiasCalendario())
                {
                    <button type="button"
                            class="@ObtenerClaseDia(dia)"
                            @onclick="() => SeleccionarFecha(dia)">

                        <span>@dia.Day</span>

                        @if (TieneTurnos(dia))
                        {
                            <span class="indicador-turnos"></span>
                        }

                    </button>
                }

            </div>

            <div class="filtros-agenda">

                <div class="filtro-bloque">

                    <button type="button"
                            class="filtro-titulo"
                            @onclick="AlternarConsultorios">

                        <span>Consultorios</span>

                        <i class="bi @(mostrarConsultorios
                            ? "bi-chevron-up"
                            : "bi-chevron-down")">
                        </i>

                    </button>

                    @if (mostrarConsultorios)
                    {
                        <div class="filtro-opciones">

                            @foreach (var consultorio in ConsultoriosDisponibles)
                            {
                                <label class="filtro-check">

                                    <input type="checkbox"
                                           checked="@consultoriosSeleccionados.Contains(consultorio.Id)"
                                           @onchange="evento => CambiarFiltroConsultorio(
                                               consultorio.Id,
                                               Convert.ToBoolean(evento.Value))" />

<span>@consultorio.Nombre</span>

</label>
                            }

                        </div>
                    }

                </div>

                <div class="filtro-bloque">

                    <button type="button"
                            class="filtro-titulo"
                            @onclick="AlternarServicios">

                        <span>Tipo de Turno</span>

                        <i class="bi @(mostrarServicios
                            ? "bi-chevron-up"
                            : "bi-chevron-down")">
                        </i>

                    </button>

                    @if (mostrarServicios)
                    {
                        <div class="filtro-opciones">

                            @foreach (var tipo in TiposTurnoDisponibles)
                            {
                                <label class="filtro-check">

                                    <input type="checkbox"
                                           checked="@tiposSeleccionados.Contains(tipo.Id)"
                                           @onchange="evento => CambiarFiltroTipo(
                                               tipo.Id,
                                               Convert.ToBoolean(evento.Value))" />

<span>@tipo.Nombre</span>

</label>
                            }

                        </div>
                    }

                </div>

                <div class="filtro-bloque">

                    <button type="button"
                            class="filtro-titulo"
                            @onclick="AlternarProfesionales">

                        <span>Profesionales</span>

                        <i class="bi @(mostrarProfesionales
                            ? "bi-chevron-up"
                            : "bi-chevron-down")">
                        </i>

                    </button>

                    @if (mostrarProfesionales)
                    {
                        <div class="filtro-opciones">

                            @foreach (var profesional in ProfesionalesDisponibles)
                            {
                                <label class="filtro-check">

                                    <input type="checkbox"
                                           checked="@profesionalesSeleccionados.Contains(profesional.Id)"
                                           @onchange="evento => CambiarFiltroProfesional(
                                               profesional.Id,
                                               Convert.ToBoolean(evento.Value))" />

<span>@profesional.Nombre</span>

</label>
                            }

                        </div>
                    }

                </div>

                <div class="filtro-bloque">

                    <button type="button"
                            class="filtro-titulo"
                            @onclick="AlternarPacientes">

                        <span>Pacientes</span>

                        <i class="bi @(mostrarPacientes
                            ? "bi-chevron-up"
                            : "bi-chevron-down")">
                        </i>

                    </button>

                    @if (mostrarPacientes)
                    {
                        <div class="filtro-opciones">

                            @foreach (var paciente in PacientesDisponibles)
                            {
                                <label class="filtro-check">

                                    <input type="checkbox"
                                           checked="@pacientesSeleccionados.Contains(paciente.Id)"
                                           @onchange="evento => CambiarFiltroPaciente(
                                               paciente.Id,
                                               Convert.ToBoolean(evento.Value))" />

<span>@paciente.Nombre</span>

</label>
                            }

                        </div>
                    }

                </div>

            </div>

            <button type="button"
                    class="btn-restaurar-filtros"
                    @onclick="RestaurarTodosLosFiltros">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Restaurar filtros</span>
            </button>

        </aside>

        <main class="agenda-principal">

            @if (cargando)
            {
                <div class="estado-pagina">

                    <div class="spinner-border text-secondary"
                         role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>

                    <p>Cargando turnos...</p>

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="mensaje-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>
                </div>
            }
            else if (vistaSemanal)
            {
                <div class="agenda-semanal">

                    @foreach (var dia in DiasDeLaSemana)
                    {
                        var turnosDia = ObtenerTurnosDelDia(dia);

                        <section class="dia-semana">

                            <header class="dia-semana-header">

                                <div>

                                    <span class="dia-semana-nombre">
                                        @FormatearNombreDia(dia)
                                    </span>

                                    <span class="dia-semana-fecha">
                                        @dia.ToString(
                                            "d 'de' MMMM",
                                            new System.Globalization.CultureInfo("es-AR"))
                                    </span>

                                </div>

                                <span class="dia-semana-cantidad">
                                    @turnosDia.Count
                                    @(turnosDia.Count == 1 ? "turno" : "turnos")
                                </span>

                            </header>

                            @if (turnosDia.Count == 0)
                            {
                                <div class="dia-semana-vacio">
                                    Sin turnos programados
                                </div>
                            }
                            else
                            {
                                <div class="lista-turnos">

                                    @foreach (var turno in turnosDia)
                                    {
                                        <article class="turno-card turno-card-clickeable"
                                                 @onclick="() => AbrirDetalle(turno)">

                                            <div class="turno-icono">
                                                <i class="bi bi-calendar-check"></i>
                                            </div>

                                            <div class="turno-informacion">

                                                <div class="turno-encabezado-datos">

                                                    <span class="turno-consultorio">
                                                        @ObtenerCodigoConsultorio(
                                                            turno.NombreTipoConsultorio)
                                                    </span>

                                                    <span class="turno-prestacion">
                                                        @ObtenerTextoPrestaciones(turno)
                                                    </span>

                                                    <span class="turno-profesional">
                                                        @ObtenerResumenPersonas(
                                                            turno.NombresProfesionales,
                                                            "Sin profesional")
                                                    </span>

                                                </div>

                                                <div class="turno-horario-fila">

                                                    <h2>
                                                        @turno.FechaInicio.ToString("HH:mm")
                                                        -
                                                        @turno.FechaFin.ToString("HH:mm")
                                                    </h2>

                                                    @if (turno.SerieTurnoId.HasValue)
                                                    {
                                                        <span class="turno-recurrencia"
                                                              title="Este turno pertenece a una serie recurrente">

                                                            <i class="bi bi-arrow-repeat"></i>
                                                            @ObtenerTextoRecurrencia(turno)

                                                        </span>
                                                    }

                                                </div>

                                                <div class="turno-detalles">

                                                    <span>
                                                        @(string.IsNullOrWhiteSpace(turno.NombreTipoTurno)
                                                            ? "Turno"
                                                            : turno.NombreTipoTurno)
                                                    </span>

                                                    <span>
                                                        @ObtenerResumenPersonas(
                                                            turno.NombresPacientes,
                                                            "Sin paciente")
                                                    </span>

                                                </div>

                                            </div>

                                            <div class="turno-estado">
                                                <span class="@ObtenerClaseEstado(turno)">
                                                    @ObtenerTextoEstado(turno)
                                                </span>
                                            </div>

                                            <button type="button"
                                                    class="btn-editar-turno"
                                                    title="Editar turno"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => IrAEditar(turno.Id)">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                        </article>
                                    }

                                </div>
                            }

                        </section>
                    }

                </div>
            }
            else if (vistaAmpliada)
            {
                <div class="agenda-ampliada">

                    <div class="dias-agenda-ampliada">

                        @foreach (var dia in DiasDeLaSemana)
                        {
                            <button type="button"
                                    class="@(dia.Date == fechaSeleccionada.Date
                                        ? "dia-ampliado activo"
                                        : "dia-ampliado")"
                                    @onclick="() => SeleccionarFecha(dia)">

                                <span class="dia-ampliado-nombre">
                                    @FormatearNombreDia(dia)
                                </span>

                                <span class="dia-ampliado-numero">
                                    @dia.Day
                                </span>

                            </button>
                        }

                    </div>

                    @if (ConsultoriosVisibles.Count == 0)
                    {
                        <div class="estado-vacio">

                            <i class="bi bi-building-x"></i>

                            <h2>No hay consultorios seleccionados</h2>

                            <p>
                                Seleccioná al menos un consultorio
                                desde los filtros.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="grilla-agenda-scroll">

                            <div class="grilla-agenda"
                                 style="--cantidad-consultorios: @ConsultoriosVisibles.Count;">

                                <div class="grilla-esquina">Hora</div>

                                @for (
                                    var indice = 0;
                                    indice < ConsultoriosVisibles.Count;
                                    indice++)
                                {
                                    var consultorio = ConsultoriosVisibles[indice];
                                    var columna = indice + 2;

                                    <div class="grilla-consultorio"
                                         style="grid-column: @columna; grid-row: 1;">
                                        @consultorio.Nombre
                                    </div>

                                    <div class="grilla-columna-fondo @(indice % 2 == 0
                                            ? "columna-par"
                                            : "columna-impar")"
                                 style="grid-column: @columna; grid-row: 2 / 38;">
                            </div>
                        }

                        @for (var hora = 0; hora <= 12; hora++)
                        {
                            var horaActual = 8 + hora;
                            var fila = 2 + (hora * 3);

                            var claseHora = hora == 0
                                ? "grilla-hora primera-hora"
                                : "grilla-hora";

                            var estiloHora =
                                $"grid-column: 1; grid-row: {fila};";

                            var estiloLinea =
                                $"grid-column: 2 / -1; grid-row: {fila};";

                            <div class="@claseHora" style="@estiloHora">
                                @($"{horaActual:00}:00")
                            </div>

                            <div class="grilla-linea" style="@estiloLinea">
                            </div>
                        }

                        @foreach (var turno in TurnosGrilla)
                        {
                            <button type="button"
                                    class="@ObtenerClaseTurnoGrilla(turno)"
                                    style="@ObtenerPosicionTurno(turno)"
                                    title="Ver detalle del turno"
                                    @onclick="() => AbrirDetalle(turno)">

                                <span class="turno-grilla-cabecera">

                                    <strong>
                                        @turno.FechaInicio.ToString("HH:mm")
                                        -
                                        @turno.FechaFin.ToString("HH:mm")
                                    </strong>

                                    @if (turno.SerieTurnoId.HasValue)
                                    {
                                        <span class="turno-grilla-recurrencia"
                                              title="@ObtenerTextoRecurrencia(turno)">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </span>
                                    }

                                </span>

                                <span class="turno-grilla-prestacion">

                                    @(string.IsNullOrWhiteSpace(turno.NombreTipoTurno)
                                        ? "Turno"
                                        : turno.NombreTipoTurno)

                                    <span>—</span>

                                    @ObtenerTextoPrestaciones(turno)

                                </span>

                                <span class="turno-grilla-participantes">

                                    @ObtenerResumenPersonas(
                                        turno.NombresPacientes,
                                        "Sin paciente")

                                    <span>—</span>

                                    @ObtenerResumenPersonas(
                                        turno.NombresProfesionales,
                                        "Sin profesional")

                                </span>

                            </button>
                        }

                    </div>

                </div>
            }

        </div>
    }
            else if (TurnosDelDia.Count == 0)
    {
        <div class="estado-vacio">

            <i class="bi bi-calendar-x"></i>

            <h2>No encontramos turnos</h2>

            <p>
                No hay turnos para esta fecha con los filtros seleccionados.
                Podés restaurar los filtros o crear un turno nuevo.
            </p>

            <button type="button"
                    class="btn-nuevo-turno"
                    @onclick="IrACrear">
                Crear turno
            </button>

        </div>
    }
    else
    {
        <div class="agenda-contenido">

            <div class="resumen-dia">
                <span>
                    @TurnosDelDia.Count
                    @(TurnosDelDia.Count == 1
                        ? "turno programado"
                        : "turnos programados")
                </span>
            </div>

            <div class="lista-turnos">

                @foreach (var turno in TurnosDelDia)
                {
                    <article class="turno-card turno-card-clickeable"
                             @onclick="() => AbrirDetalle(turno)">

                        <div class="turno-icono">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div class="turno-informacion">

                            <div class="turno-encabezado-datos">

                                <span class="turno-consultorio">
                                    @ObtenerCodigoConsultorio(
                                        turno.NombreTipoConsultorio)
                                </span>

                                <span class="turno-prestacion">
                                    @ObtenerTextoPrestaciones(turno)
                                </span>

                                <span class="turno-profesional">
                                    @ObtenerResumenPersonas(
                                        turno.NombresProfesionales,
                                        "Sin profesional")
                                </span>

                            </div>

                            <div class="turno-horario-fila">

                                <h2>
                                    @turno.FechaInicio.ToString("HH:mm")
                                    -
                                    @turno.FechaFin.ToString("HH:mm")
                                </h2>

                                @if (turno.SerieTurnoId.HasValue)
                                {
                                    <span class="turno-recurrencia"
                                          title="Este turno pertenece a una serie recurrente">

                                        <i class="bi bi-arrow-repeat"></i>
                                        @ObtenerTextoRecurrencia(turno)

                                    </span>
                                }

                            </div>

                            <div class="turno-detalles">

                                <span>
                                    @(string.IsNullOrWhiteSpace(turno.NombreTipoTurno)
                                        ? "Turno"
                                        : turno.NombreTipoTurno)
                                </span>

                                <span>
                                    @ObtenerResumenPersonas(
                                        turno.NombresPacientes,
                                        "Sin paciente")
                                </span>

                            </div>

                        </div>

                        <div class="turno-estado">
                            <span class="@ObtenerClaseEstado(turno)">
                                @ObtenerTextoEstado(turno)
                            </span>
                        </div>

                        <button type="button"
                                class="btn-editar-turno"
                                title="Editar turno"
                                @onclick:stopPropagation="true"
                                @onclick="() => IrAEditar(turno.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>

                    </article>
                }

            </div>

        </div>
    }

</main>

</div>

</div>

@if (mostrarDetalle && turnoSeleccionado is not null)
{
    <div class="detalle-turno-fondo"
         @onclick="CerrarDetalle">

        <section class="detalle-turno-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Detalle del turno"
                 @onclick:stopPropagation="true">

            <header class="detalle-nuevo-encabezado">

                <div class="detalle-nuevo-identidad">

                    <span class="detalle-codigo-consultorio">
                        @ObtenerCodigoConsultorio(
                            turnoSeleccionado.NombreTipoConsultorio)
                    </span>

                    <div>
                        <span>Detalle del turno</span>
                        <strong>
                            @FormatearFechaDetalle(
                                turnoSeleccionado.FechaInicio)
                        </strong>
                    </div>

                </div>

                <div class="detalle-nuevo-encabezado-acciones">

                    <span class="@ObtenerClaseEstado(turnoSeleccionado)">
                        @ObtenerTextoEstado(turnoSeleccionado)
                    </span>

                    <button type="button"
                            class="detalle-turno-cerrar"
                            title="Cerrar"
                            disabled="@GuardandoDetalle"
                            @onclick="CerrarDetalle">
                        <i class="bi bi-x-lg"></i>
                    </button>

                </div>

            </header>

            <div class="detalle-nuevo-contenido">

                <section class="detalle-nuevo-principal">

                    <article class="detalle-nuevo-panel detalle-panel-pacientes">

                        <div class="detalle-nuevo-panel-titulo">
                            <i class="bi bi-people"></i>
                            <span>Pacientes</span>
                        </div>

                        @if (turnoSeleccionado.PacientesDetalle.Count > 0)
                        {
                            <p class="asistencia-ayuda">
                                Seleccioná una opción para guardar la asistencia.
                            </p>

                            @foreach (var paciente in turnoSeleccionado.PacientesDetalle)
                            {
                                <div class="detalle-nuevo-paciente">

                                    <strong>@paciente.NombrePaciente</strong>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(paciente.NombreObraSocial)
                                            ? "Sin obra social histórica"
                                            : paciente.NombreObraSocial)
                                    </span>

                                    <div class="asistencia-selector"
                                         role="group"
                                         aria-label="@($"Asistencia de {paciente.NombrePaciente}")"
                                         aria-busy="@(pacienteGuardandoAsistencia == paciente.PacienteId)">

                                        @foreach (var asistencia in opcionesAsistencia)
                                        {
                                            <button type="button"
                                                    class="@($"{ObtenerClaseAsistencia(asistencia)} {(paciente.Asistencia == asistencia ? "activa" : "")}")"
                                                    aria-pressed="@(paciente.Asistencia == asistencia ? "true" : "false")"
                                                    disabled="@GuardandoDetalle"
                                                    @onclick="() => GuardarAsistenciaPaciente(paciente, asistencia)">

                                                @ObtenerTextoAsistencia(asistencia)

                                            </button>
                                        }

                                    </div>

                                    @if (pacienteGuardandoAsistencia == paciente.PacienteId)
                                    {
                                        <p class="asistencia-mensaje" role="status">
                                            Guardando...
                                        </p>
                                    }
                                    else if (
                                        pacienteMensajeAsistencia == paciente.PacienteId &&
                                        !string.IsNullOrWhiteSpace(mensajeAsistencia))
                                    {
                                        <p class="asistencia-mensaje @(errorAsistencia ? "es-error" : "")"
                                           role="status">
                                            @mensajeAsistencia
                                        </p>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <div class="detalle-nuevo-paciente">
                                <strong>
                                    @ObtenerTextoPacientes(turnoSeleccionado)
                                </strong>
                                <span>Sin pacientes asignados</span>
                            </div>
                        }

                    </article>

                    <article class="detalle-nuevo-panel detalle-panel-atencion">

                        <div class="detalle-nuevo-panel-titulo">
                            <i class="bi bi-briefcase"></i>
                            <span>Atención</span>
                        </div>

                        @if (turnoSeleccionado.ProfesionalPrestaciones.Count > 0)
                        {
                            @foreach (var atencion in turnoSeleccionado.ProfesionalPrestaciones)
                            {
                                <div class="detalle-nuevo-atencion-relacion">

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(atencion.NombreProfesional)
                                            ? "Sin profesional"
                                            : atencion.NombreProfesional)
                                    </strong>

                                    <span>—</span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(atencion.NombreTipoPrestacion)
                                            ? "Sin prestación"
                                            : atencion.NombreTipoPrestacion)
                                    </strong>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="detalle-nuevo-atencion-relacion">

                                <strong>
                                    @ObtenerTextoProfesionales(turnoSeleccionado)
                                </strong>

                                <span>—</span>

                                <strong>
                                    @ObtenerTextoPrestaciones(turnoSeleccionado)
                                </strong>

                            </div>
                        }

                    </article>

                </section>

                <section class="detalle-nuevo-contexto">

                    <div class="detalle-nuevo-contexto-item">
                        <span>Horario</span>
                        <strong>
                            @turnoSeleccionado.FechaInicio.ToString("HH:mm")
                            <small>—</small>
                            @turnoSeleccionado.FechaFin.ToString("HH:mm")
                        </strong>
                    </div>

                    <div class="detalle-nuevo-contexto-item">
                        <span>Tipo de turno</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(turnoSeleccionado.NombreTipoTurno)
                                ? "Sin especificar"
                                : turnoSeleccionado.NombreTipoTurno)
                        </strong>
                    </div>

                </section>

                @if (turnoSeleccionado.SerieTurnoId.HasValue)
                {
                    <div class="detalle-nuevo-recurrencia">

                        <i class="bi bi-arrow-repeat"></i>

                        <span>

                            <strong>
                                @ObtenerTextoRecurrencia(turnoSeleccionado)
                            </strong>

                            @if (turnoSeleccionado.FechaHastaRecurrencia.HasValue)
                            {
                                <text>
                                    · hasta el
                                    @(turnoSeleccionado.FechaHastaRecurrencia.Value
                                        .ToString("dd/MM/yyyy"))
                                </text>
                            }

                        </span>

                    </div>
                }

            </div>

            <section class="detalle-cambio-estado"
                     aria-label="Cambiar estado del turno"
                     aria-busy="@guardandoEstado">

                <div class="detalle-estado-cabecera">

                    <span class="detalle-estado-titulo">
                        Estado del turno
                    </span>

                    @if (estadoSeleccionado != turnoSeleccionado.EstadoTurno)
                    {
                        <span class="detalle-estado-pendiente">
                            Sin guardar
                        </span>
                    }

                </div>

                <div class="detalle-estado-opciones"
                     role="group"
                     aria-label="Estados disponibles">

                    @foreach (var estado in estadosDisponibles)
                    {
                        var nombre = estado switch
                        {
                            EnumEstadoTurno.reservado => "Reservado",
                            EnumEstadoTurno.atendido => "Completado",
                            EnumEstadoTurno.cancelado => "Cancelado",
                            EnumEstadoTurno.ausente => "Faltó",
                            _ => "Sin especificar"
                        };

                        var icono = estado switch
                        {
                            EnumEstadoTurno.reservado => "bi-clock",
                            EnumEstadoTurno.atendido => "bi-check-circle",
                            EnumEstadoTurno.cancelado => "bi-x-circle",
                            _ => "bi-person-x"
                        };

                        <button type="button"
                                class="detalle-estado-opcion opcion-@estado @(estadoSeleccionado == estado ? "seleccionado" : "")"
                                aria-pressed="@(estadoSeleccionado == estado ? "true" : "false")"
                                disabled="@GuardandoDetalle"
                                @onclick="() =>
                                                                                        {
                                                                                            estadoSeleccionado = estado;
                                                                                            mensajeEstado = string.Empty;
                                                                                        }">

                            <i class="bi @icono" aria-hidden="true"></i>
                            <span>@nombre</span>

                        </button>
                    }

                </div>

                <div class="detalle-estado-pie">

                    <span class="detalle-estado-ayuda">
                        Se aplica únicamente a este turno.
                    </span>

                    <button type="button"
                            class="detalle-estado-guardar"
                            disabled="@(GuardandoDetalle ||
                                estadoSeleccionado == turnoSeleccionado.EstadoTurno)"
                            @onclick="SolicitarCambioEstado">

                        <i class="bi bi-check2" aria-hidden="true"></i>
                        @(guardandoEstado ? "Guardando..." : "Guardar estado")

                    </button>

                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeEstado))
                {
                    <p class="detalle-estado-mensaje @(errorEstado ? "es-error" : "")"
                       role="status">
                        @mensajeEstado
                    </p>
                }

            </section>

            <footer class="detalle-turno-acciones detalle-nuevo-acciones">

                <button type="button"
                        class="detalle-btn-cerrar"
                        disabled="@GuardandoDetalle"
                        @onclick="CerrarDetalle">
                    Cerrar
                </button>

                <button type="button"
                class="detalle-btn-editar"
                disabled="@GuardandoDetalle"
                @onclick="DuplicarTurnoSeleccionado">
                <i class="bi bi-copy"></i>
                <span>Duplicar turno</span>
                </button>   

                <button type="button"
                        class="detalle-btn-editar"
                        disabled="@GuardandoDetalle"
                        @onclick="EditarTurnoSeleccionado">
                    <i class="bi bi-pencil"></i>
                    <span>Editar turno</span>
                </button>

                
                @if (mostrarConfirmacionCancelacion && turnoSeleccionado is not null)
                {
                    <div class="modal-backdrop-custom">
                        <section class="modal-cancelacion"
                                 role="dialog"
                                 aria-modal="true"
                                 aria-label="Confirmar cancelación de turno">

                            <div class="modal-cancelacion-icono">
                                <i class="bi bi-exclamation-circle"></i>
                            </div>

                            <h3>Cancelar turno</h3>

                            <p>
                                Estás por cancelar el turno del
                                <strong>
                                    @turnoSeleccionado.FechaInicio.ToString("dd/MM/yyyy")
                                </strong>.
                            </p>

                            @if (turnoSeleccionado.SerieTurnoId.HasValue)
                            {
                                <div class="modal-cancelacion-opciones">
                                    <label>
                                        <input type="radio"
                                               name="alcanceCancelacion"
                                               checked="@(!cancelarTurnosSiguientes)"
                                               @onchange="() => cancelarTurnosSiguientes = false" />
                                        Solo este turno
                                    </label>

                                    <label>
                                        <input type="radio"
                                               name="alcanceCancelacion"
                                               checked="@cancelarTurnosSiguientes"
                                               @onchange="() => cancelarTurnosSiguientes = true" />
                                        Este turno y los siguientes
                                    </label>
                                </div>
                            }

                            <p class="modal-cancelacion-aviso">
                                Los turnos cancelados liberarán sus horarios.
                                No se eliminarán los registros ni las asistencias.
                            </p>

                            <div class="modal-cancelacion-acciones">
                                <button type="button"
                                        class="detalle-btn-cerrar"
                                        disabled="@guardandoEstado"
                                        @onclick="CerrarConfirmacionCancelacion">
                                    Volver
                                </button>

                                <button type="button"
                                        class="btn-confirmar-cancelacion"
                                        disabled="@guardandoEstado"
                                        @onclick="ConfirmarCancelacionTurno">
                                    @(guardandoEstado ? "Cancelando..." : "Confirmar cancelación")
                                </button>
                            </div>

                        </section>
                    </div>
                }


            </footer>

        </section>

    </div>
}

@code {

    private List<TurnoListadoDTO> listaTurnos = new();
    private List<TipoConsultorioListadoDTO> consultorios = new();

    private DateTime fechaSeleccionada = DateTime.Today;

    private DateTime mesVisible = new(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1
    );

    private HashSet<int> consultoriosSeleccionados = new();
    private HashSet<int> tiposSeleccionados = new();
    private HashSet<int> profesionalesSeleccionados = new();
    private HashSet<int> pacientesSeleccionados = new();

    private bool cargando = true;
    private string Mensaje = string.Empty;

    private bool vistaSemanal;
    private bool vistaAmpliada;

    private bool mostrarConsultorios = true;
    private bool mostrarServicios;
    private bool mostrarProfesionales;
    private bool mostrarPacientes;
    private bool mostrarDetalle;
    private bool mostrarMensajeResultado = true;

    private const int FiltroSinPaciente = 0;

    private TurnoListadoDTO? turnoSeleccionado;
    private string? ultimaUrlAgendaAplicada;

    private EnumEstadoTurno estadoSeleccionado;
    private bool guardandoEstado;
    private bool errorEstado;
    private string mensajeEstado = string.Empty;
    private bool mostrarConfirmacionCancelacion;
    private bool cancelarTurnosSiguientes;  

    private int? pacienteGuardandoAsistencia;
    private int? pacienteMensajeAsistencia;

    private string mensajeAsistencia = string.Empty;
    private bool errorAsistencia;

    private bool GuardandoAsistencia =>
        pacienteGuardandoAsistencia.HasValue;

    private bool GuardandoDetalle =>
        guardandoEstado || GuardandoAsistencia;

    private readonly EnumEstadoTurno[] estadosDisponibles =
    {
        EnumEstadoTurno.reservado,
        EnumEstadoTurno.atendido,
        EnumEstadoTurno.cancelado,
        EnumEstadoTurno.ausente
    };

    private readonly EnumAsistenciaPaciente?[] opcionesAsistencia =
    {
        null,
        EnumAsistenciaPaciente.asistio,
        EnumAsistenciaPaciente.ausente
    };

    [SupplyParameterFromQuery(Name = "detalle")]
    public int? DetalleTurnoId { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    [SupplyParameterFromQuery(Name = "vista")]
    public string? VistaDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "fecha")]
    public string? FechaDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "consultorios")]
    public string? ConsultoriosDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "tipos")]
    public string? TiposDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "profesionales")]
    public string? ProfesionalesDesdeUrl { get; set; }

    [SupplyParameterFromQuery(Name = "pacientes")]
    public string? PacientesDesdeUrl { get; set; }

    private List<TurnoListadoDTO> TurnosDelDia =>
        listaTurnos
            .Where(turno =>
                turno.FechaInicio.Date == fechaSeleccionada.Date &&
                EstaConsultorioSeleccionado(turno.TipoConsultorioId) &&
                EstaTipoSeleccionado(turno.TipoTurnoId) &&
                EstaProfesionalSeleccionado(turno) &&
                EstaPacienteSeleccionado(turno)
            )
            .OrderBy(turno => turno.FechaInicio)
            .ToList();

    private List<OpcionFiltro> ConsultoriosVisibles =>
        ConsultoriosDisponibles
            .Where(consultorio =>
                EstaConsultorioSeleccionado(consultorio.Id)
            )
            .ToList();

    private List<TurnoListadoDTO> TurnosGrilla =>
        TurnosDelDia
            .Where(turno =>
                turno.FechaInicio.TimeOfDay >= new TimeSpan(8, 0, 0) &&
                turno.FechaInicio.TimeOfDay < new TimeSpan(20, 0, 0)
            )
            .ToList();

    private DateTime InicioSemana
    {
        get
        {
            var desplazamiento =
                ((int)fechaSeleccionada.DayOfWeek + 6) % 7;

            return fechaSeleccionada.Date.AddDays(-desplazamiento);
        }
    }

    private DateTime FinSemana => InicioSemana.AddDays(6);

    private List<DateTime> DiasDeLaSemana =>
        Enumerable.Range(0, 7)
            .Select(numero => InicioSemana.AddDays(numero))
            .ToList();

    private List<OpcionFiltro> ConsultoriosDisponibles
    {
        get
        {
            if (consultorios.Count > 0)
            {
                return consultorios
                    .Select(consultorio => new OpcionFiltro
                    {
                        Id = consultorio.Id,

                        Nombre = string.IsNullOrWhiteSpace(consultorio.Tipo)
                            ? "Sin nombre"
                            : consultorio.Tipo
                    })
                    .OrderBy(item => item.Nombre)
                    .ToList();
            }

            return listaTurnos
                .Where(turno => turno.TipoConsultorioId > 0)
                .GroupBy(turno => new
                {
                    turno.TipoConsultorioId,
                    turno.NombreTipoConsultorio
                })
                .Select(grupo => new OpcionFiltro
                {
                    Id = grupo.Key.TipoConsultorioId,

                    Nombre = string.IsNullOrWhiteSpace(
                        grupo.Key.NombreTipoConsultorio)
                            ? "Sin consultorio"
                            : grupo.Key.NombreTipoConsultorio
                })
                .OrderBy(item => item.Nombre)
                .ToList();
        }
    }

    private List<OpcionFiltro> TiposTurnoDisponibles =>
        listaTurnos
            .Where(turno => turno.TipoTurnoId != 0)
            .GroupBy(turno => new
            {
                turno.TipoTurnoId,
                turno.NombreTipoTurno
            })
            .Select(grupo => new OpcionFiltro
            {
                Id = grupo.Key.TipoTurnoId,

                Nombre = string.IsNullOrWhiteSpace(grupo.Key.NombreTipoTurno)
                    ? "Turno"
                    : grupo.Key.NombreTipoTurno
            })
            .OrderBy(item => item.Nombre)
            .ToList();

    private List<OpcionFiltro> ProfesionalesDisponibles =>
        listaTurnos
            .SelectMany(turno => turno.ProfesionalPrestaciones)
            .Where(relacion => relacion.ProfesionalId > 0)
            .GroupBy(relacion => relacion.ProfesionalId)
            .Select(grupo => new OpcionFiltro
            {
                Id = grupo.Key,

                Nombre = grupo
                    .Select(relacion => relacion.NombreProfesional)
                    .FirstOrDefault(nombre =>
                        !string.IsNullOrWhiteSpace(nombre)
                    ) ?? "Profesional"
            })
            .OrderBy(profesional => profesional.Nombre)
            .ToList();

    private List<OpcionFiltro> PacientesDisponibles =>
        listaTurnos
            .SelectMany(turno => turno.PacientesDetalle)
            .Where(paciente => paciente.PacienteId > 0)
            .GroupBy(paciente => paciente.PacienteId)
            .Select(grupo => new OpcionFiltro
            {
                Id = grupo.Key,

                Nombre = grupo
                    .Select(paciente => paciente.NombrePaciente)
                    .FirstOrDefault(nombre =>
                        !string.IsNullOrWhiteSpace(nombre)
                    ) ?? "Paciente"
            })
            .OrderBy(paciente => paciente.Nombre)
            .Prepend(new OpcionFiltro
            {
                Id = FiltroSinPaciente,
                Nombre = "Sin paciente"
            })
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarConsultorios();
        await CargarTurnos();

        AplicarContextoDeAgenda();
    }

    protected override void OnParametersSet()
    {
        if (!cargando)
        {
            AplicarContextoDeAgenda();
        }
    }

    private void AplicarContextoDeAgenda()
    {
        var uri = new Uri(Nav.Uri);

        if (!uri.AbsolutePath.TrimEnd('/').Equals(
            "/turnos",
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (ultimaUrlAgendaAplicada == uri.AbsoluteUri)
        {
            return;
        }

        var parametros = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase
        );

        foreach (var parte in uri.Query.TrimStart('?').Split(
            '&',
            StringSplitOptions.RemoveEmptyEntries))
        {
            var par = parte.Split('=', 2);

            var nombre = Uri.UnescapeDataString(
                par[0].Replace("+", " ")
            );

            var valor = par.Length == 2
                ? Uri.UnescapeDataString(par[1].Replace("+", " "))
                : string.Empty;

            parametros[nombre] = valor;
        }

        string? Leer(string nombre) =>
            parametros.TryGetValue(nombre, out var valor)
                ? valor
                : null;

        VistaDesdeUrl = Leer("vista");
        FechaDesdeUrl = Leer("fecha");
        ConsultoriosDesdeUrl = Leer("consultorios");
        TiposDesdeUrl = Leer("tipos");
        ProfesionalesDesdeUrl = Leer("profesionales");
        PacientesDesdeUrl = Leer("pacientes");
        Estado = Leer("estado");

        DetalleTurnoId = int.TryParse(
            Leer("detalle"),
            out var detalleId)
                ? detalleId
                : null;

        InicializarFiltros();

        pacientesSeleccionados = PacientesDisponibles
            .Select(paciente => paciente.Id)
            .ToHashSet();

        fechaSeleccionada = DateTime.Today;

        mesVisible = new DateTime(
            fechaSeleccionada.Year,
            fechaSeleccionada.Month,
            1
        );

        RestaurarFiltrosDesdeUrl();
        RestaurarVistaDesdeUrl();
        CerrarDetalle();
        AbrirDetalleDesdeUrl();

        ultimaUrlAgendaAplicada = uri.AbsoluteUri;
    }

    private async Task CargarConsultorios()
    {
        try
        {
            var resp = await Http.Get<List<TipoConsultorioListadoDTO>>(
                "api/tipoconsultorio/ListaTipoConsultorio"
            );

            consultorios = resp.Error
                ? new List<TipoConsultorioListadoDTO>()
                : resp.Respuesta ?? new List<TipoConsultorioListadoDTO>();
        }
        catch
        {
            consultorios = new List<TipoConsultorioListadoDTO>();
        }
    }

    private async Task CargarTurnos()
    {
        cargando = true;
        Mensaje = string.Empty;

        try
        {
            var resp = await Http.Get<List<TurnoListadoDTO>>(
                "api/turno/ListaTurnos"
            );

            if (resp.Error)
            {
                listaTurnos = new List<TurnoListadoDTO>();

                var error = resp.ObtenerError();

                if (!error.Contains(
                    "No hay turnos disponibles",
                    StringComparison.OrdinalIgnoreCase))
                {
                    Mensaje = ObtenerMensajeAmigable(
                        error,
                        "No pudimos cargar los turnos. Intentá nuevamente."
                    );
                }
            }
            else
            {
                listaTurnos =
                    resp.Respuesta ?? new List<TurnoListadoDTO>();

                InicializarFiltros();
            }
        }
        catch (TaskCanceledException)
        {
            listaTurnos = new List<TurnoListadoDTO>();

            Mensaje =
                "La carga de turnos tardó más de lo esperado. " +
                "Actualizá la página para intentarlo nuevamente.";
        }
        catch (HttpRequestException)
        {
            listaTurnos = new List<TurnoListadoDTO>();

            Mensaje =
                "No pudimos conectarnos con el servidor para cargar los turnos. " +
                "Verificá tu conexión e intentá nuevamente.";
        }
        catch (Exception)
        {
            listaTurnos = new List<TurnoListadoDTO>();

            Mensaje =
                "Ocurrió un problema al cargar los turnos. " +
                "Actualizá la página para intentarlo nuevamente.";
        }
        finally
        {
            pacientesSeleccionados = PacientesDisponibles
                .Select(paciente => paciente.Id)
                .ToHashSet();

            cargando = false;
        }
    }

    private static string ObtenerMensajeAmigable(
        string? mensaje,
        string mensajeAlternativo)
    {
        if (string.IsNullOrWhiteSpace(mensaje))
        {
            return mensajeAlternativo;
        }

        var mensajeLimpio = mensaje.Trim();

        if (mensajeLimpio.Contains(
                "The operation was canceled",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "TaskCanceledException",
                StringComparison.OrdinalIgnoreCase))
        {
            return
                "La carga tardó más de lo esperado. " +
                "Actualizá la página para intentarlo nuevamente.";
        }

        if (mensajeLimpio.Contains(
                "Unable to read data from the transport connection",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "SocketException",
                StringComparison.OrdinalIgnoreCase))
        {
            return
                "Se interrumpió la conexión con el servidor. " +
                "Verificá tu conexión e intentá nuevamente.";
        }

        if (mensajeLimpio.StartsWith(
            "System.",
            StringComparison.OrdinalIgnoreCase))
        {
            var separador = mensajeLimpio.IndexOf(':');

            if (separador >= 0 &&
                separador < mensajeLimpio.Length - 1)
            {
                mensajeLimpio =
                    mensajeLimpio[(separador + 1)..].Trim();
            }

            mensajeLimpio = mensajeLimpio
                .Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries
                )
                .FirstOrDefault() ?? mensajeAlternativo;
        }

        if (mensajeLimpio.Contains(
                "InternalServerError",
                StringComparison.OrdinalIgnoreCase) ||
            mensajeLimpio.Contains(
                "Response status code does not indicate success",
                StringComparison.OrdinalIgnoreCase))
        {
            return mensajeAlternativo;
        }

        return mensajeLimpio;
    }

    private void InicializarFiltros()
    {
        consultoriosSeleccionados = ConsultoriosDisponibles
            .Select(consultorio => consultorio.Id)
            .ToHashSet();

        tiposSeleccionados = listaTurnos
            .Where(turno => turno.TipoTurnoId != 0)
            .Select(turno => turno.TipoTurnoId)
            .ToHashSet();

        profesionalesSeleccionados = ProfesionalesDisponibles
            .Select(profesional => profesional.Id)
            .ToHashSet();
    }

    private List<TurnoListadoDTO> ObtenerTurnosDelDia(DateTime dia)
    {
        return listaTurnos
            .Where(turno =>
                turno.FechaInicio.Date == dia.Date &&
                EstaConsultorioSeleccionado(turno.TipoConsultorioId) &&
                EstaTipoSeleccionado(turno.TipoTurnoId) &&
                EstaProfesionalSeleccionado(turno) &&
                EstaPacienteSeleccionado(turno)
            )
            .OrderBy(turno => turno.FechaInicio)
            .ToList();
    }

    private bool EstaConsultorioSeleccionado(int id)
    {
        return consultoriosSeleccionados.Count == 0 ||
            consultoriosSeleccionados.Contains(id);
    }

    private bool EstaTipoSeleccionado(int id)
    {
        return tiposSeleccionados.Count == 0 ||
            tiposSeleccionados.Contains(id);
    }

    private bool EstaProfesionalSeleccionado(TurnoListadoDTO turno)
    {
        return profesionalesSeleccionados.Count == 0 ||
            turno.ProfesionalPrestaciones.Any(relacion =>
                profesionalesSeleccionados.Contains(
                    relacion.ProfesionalId
                )
            );
    }

    private bool EstaPacienteSeleccionado(TurnoListadoDTO turno)
    {
        if (pacientesSeleccionados.Count == 0)
        {
            return true;
        }

        if (turno.PacientesDetalle.Count == 0)
        {
            return pacientesSeleccionados.Contains(FiltroSinPaciente);
        }

        return turno.PacientesDetalle.Any(paciente =>
            pacientesSeleccionados.Contains(paciente.PacienteId)
        );
    }

    private void CambiarFiltroConsultorio(int id, bool seleccionado)
    {
        if (seleccionado)
        {
            consultoriosSeleccionados.Add(id);
        }
        else
        {
            consultoriosSeleccionados.Remove(id);
        }
    }

    private void CambiarFiltroTipo(int id, bool seleccionado)
    {
        if (seleccionado)
        {
            tiposSeleccionados.Add(id);
        }
        else
        {
            tiposSeleccionados.Remove(id);
        }
    }

    private void CambiarFiltroProfesional(int id, bool seleccionado)
    {
        if (seleccionado)
        {
