    private void IrAEditar(int id)
{
    var vistaOrigen = ObtenerVistaActual();

    var fechaOrigen =
        fechaSeleccionada.ToString("yyyy-MM-dd");

    Nav.NavigateTo(
        $"/turnos/editar/{id}" +
        $"?volverAVista=true" +
        $"&vistaOrigen={vistaOrigen}" +
        $"&fechaOrigen={fechaOrigen}"
    );
}
    
    private void AbrirDetalle(TurnoListadoDTO turno)
    {
        turnoSeleccionado = turno;
        mostrarDetalle = true;
    }
    private void AbrirDetalleDesdeUrl()
    {
        if (!DetalleTurnoId.HasValue)
        {
            return;
        }

        var turno = listaTurnos.FirstOrDefault(
            item => item.Id == DetalleTurnoId.Value
        );

        if (turno is not null)
        {
            AbrirDetalle(turno);
        }
    }
    private void RestaurarVistaDesdeUrl()
    {
        if (DateTime.TryParseExact(
            FechaDesdeUrl,
            "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var fecha))
        {
            fechaSeleccionada = fecha.Date;

            mesVisible = new DateTime(
                fecha.Year,
                fecha.Month,
                1
            );
        }

        switch (VistaDesdeUrl?.ToLowerInvariant())
        {
            case "semanal":
                vistaSemanal = true;
                vistaAmpliada = false;
                break;

            case "ampliada":
                vistaSemanal = false;
                vistaAmpliada = true;
                break;

            default:
                vistaSemanal = false;
                vistaAmpliada = false;
                break;
        }
    }
    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        turnoSeleccionado = null;
    }

    private void EditarTurnoSeleccionado()
    {
        if (turnoSeleccionado is null)
        {
            return;
        }

        var vistaOrigen = ObtenerVistaActual();

        var fechaOrigen =
            fechaSeleccionada.ToString("yyyy-MM-dd");

        Nav.NavigateTo(
            $"/turnos/editar/{turnoSeleccionado.Id}" +
            $"?volverADetalle=true" +
            $"&vistaOrigen={vistaOrigen}" +
            $"&fechaOrigen={fechaOrigen}"
        );
    }

    private string ObtenerVistaActual()
    {
        if (vistaSemanal)
        {
            return "semanal";
        }

        if (vistaAmpliada)
        {
            return "ampliada";
        }

        return "diaria";
    }

