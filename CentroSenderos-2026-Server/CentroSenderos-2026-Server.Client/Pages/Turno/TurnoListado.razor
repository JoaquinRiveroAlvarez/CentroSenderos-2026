        }

        var turnoId = turnoSeleccionado.Id;

        pacienteGuardandoAsistencia = paciente.PacienteId;
        pacienteMensajeAsistencia = paciente.PacienteId;

        mensajeAsistencia = string.Empty;
        errorAsistencia = false;

        try
        {
            var dto = new TurnoPacienteAsistenciaDTO
            {
                Asistencia = asistencia
            };

            var respuesta =
                await Http.Put<TurnoPacienteAsistenciaDTO, RespuestaDTO>(
                    $"api/turno/{turnoId}/pacientes/" +
                    $"{paciente.PacienteId}/asistencia",
                    dto
                );

            if (respuesta.Error)
            {
                errorAsistencia = true;
                mensajeAsistencia = respuesta.ObtenerError();
                return;
            }

            paciente.Asistencia = asistencia;

            mensajeAsistencia = "Asistencia guardada.";
        }
        catch
        {
            errorAsistencia = true;

            mensajeAsistencia =
                "No pudimos guardar la asistencia. Intentá nuevamente.";
        }
        finally
        {
            pacienteGuardandoAsistencia = null;
        }
    }

    private class OpcionFiltro
    {
        public int Id { get; set; }

        public string Nombre { get; set; } = string.Empty;
    }
}