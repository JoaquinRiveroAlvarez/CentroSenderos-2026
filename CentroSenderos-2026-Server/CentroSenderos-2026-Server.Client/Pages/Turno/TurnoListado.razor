    private void SeleccionarFecha(DateTime dia)
    {
        fechaSeleccionada = dia.Date;

        mesVisible = new DateTime(
            dia.Year,
            dia.Month,
            1
        );
    }

    private List<DateTime> ObtenerDiasCalendario()
    {
        var primerDiaMes = new DateTime(
            mesVisible.Year,
            mesVisible.Month,
            1
        );

        // Convierte el inicio de semana de domingo a lunes.
        var desplazamiento =
            ((int)primerDiaMes.DayOfWeek + 6) % 7;

        var primerDiaVisible =
            primerDiaMes.AddDays(-desplazamiento);

        return Enumerable
            .Range(0, 42)
            .Select(numero =>
                primerDiaVisible.AddDays(numero))
            .ToList();
    }

    private bool TieneTurnos(DateTime dia)
    {
        return listaTurnos.Any(
            turno => turno.FechaInicio.Date == dia.Date
        );
    }

    private string ObtenerClaseDia(DateTime dia)
    {
        var clases = new List<string>
        {
            "calendario-dia"
        };

        if (dia.Month != mesVisible.Month)
        {
            clases.Add("otro-mes");
        }

        if (dia.Date == DateTime.Today)
        {
            clases.Add("dia-hoy");
        }

        if (dia.Date == fechaSeleccionada.Date)
        {
            clases.Add("dia-seleccionado");
        }

        if (TieneTurnos(dia))
        {
            clases.Add("dia-con-turnos");
        }

        return string.Join(" ", clases);
    }

