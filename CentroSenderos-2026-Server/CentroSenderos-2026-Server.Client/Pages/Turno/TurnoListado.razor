    private void RestaurarFiltrosDesdeUrl()
    {
        if (!string.IsNullOrWhiteSpace(ConsultoriosDesdeUrl))
        {
            consultoriosSeleccionados = ConsultoriosDesdeUrl
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(valor =>
                    int.TryParse(valor, out var id) ? id : 0
                )
                .Where(id =>
                    id > 0 &&
                    ConsultoriosDisponibles.Any(consultorio =>
                        consultorio.Id == id
                    )
                )
                .ToHashSet();
        }

        if (!string.IsNullOrWhiteSpace(TiposDesdeUrl))
        {
            tiposSeleccionados = TiposDesdeUrl
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(valor =>
                    int.TryParse(valor, out var id) ? id : 0
                )
                .Where(id =>
                    id > 0 &&
                    TiposTurnoDisponibles.Any(tipo => tipo.Id == id)
                )
                .ToHashSet();
        }

        if (!string.IsNullOrWhiteSpace(ProfesionalesDesdeUrl))
        {
            profesionalesSeleccionados = ProfesionalesDesdeUrl
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(valor =>
                    int.TryParse(valor, out var id) ? id : 0
                )
                .Where(id =>
                    id > 0 &&
                    ProfesionalesDisponibles.Any(profesional =>
                        profesional.Id == id
                    )
                )
                .ToHashSet();
        }

        if (!string.IsNullOrWhiteSpace(PacientesDesdeUrl))
        {
            var opcionesValidas = PacientesDisponibles
                .Select(paciente => paciente.Id)
                .ToHashSet();

            pacientesSeleccionados = PacientesDesdeUrl
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(valor =>
                    int.TryParse(valor, out var id) ? id : -1
                )
                .Where(id => opcionesValidas.Contains(id))
                .ToHashSet();
        }
    }

    private void RestaurarVistaDesdeUrl()
    {
        if (DateTime.TryParseExact(
            FechaDesdeUrl,
            "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var fecha))
        {
            fechaSeleccionada = fecha.Date;

            mesVisible = new DateTime(
                fecha.Year,
                fecha.Month,
                1
            );
        }

        switch (VistaDesdeUrl?.ToLowerInvariant())
        {
            case "semanal":
                vistaSemanal = true;
                vistaAmpliada = false;
                break;

            case "ampliada":
                vistaSemanal = false;
                vistaAmpliada = true;
                break;

            default:
                vistaSemanal = false;
                vistaAmpliada = false;
                break;
        }
    }

