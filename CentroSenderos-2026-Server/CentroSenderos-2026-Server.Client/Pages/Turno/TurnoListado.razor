    private string ObtenerPosicionTurno(TurnoListadoDTO turno)
    {
        var indiceConsultorio = ConsultoriosVisibles.FindIndex(
            consultorio => consultorio.Id == turno.TipoConsultorioId
        );

        if (indiceConsultorio < 0)
        {
            return "display: none;";
        }

        var inicioAgenda = fechaSeleccionada.Date.AddHours(8);

        var minutosDesdeInicio =
            (turno.FechaInicio - inicioAgenda).TotalMinutes;

        var duracionMinutos =
            (turno.FechaFin - turno.FechaInicio).TotalMinutes;

        var filaInicio =
            2 + Math.Max(
                0,
                (int)Math.Floor(minutosDesdeInicio / 20)
            );

        var cantidadFilas = Math.Max(
            1,
            (int)Math.Ceiling(duracionMinutos / 20)
        );

        var columna = indiceConsultorio + 2;

        return
            $"grid-column: {columna}; " +
            $"grid-row: {filaInicio} / span {cantidadFilas};";
    }

