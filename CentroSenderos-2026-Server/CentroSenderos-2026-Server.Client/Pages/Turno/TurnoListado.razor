                intervalo == 1 ? "semana" : "semanas",

            EnumUnidadRecurrenciaTurno.meses =>
                intervalo == 1 ? "mes" : "meses",

            _ => "períodos"
        };

        return $"Cada {intervalo} {unidad}";
