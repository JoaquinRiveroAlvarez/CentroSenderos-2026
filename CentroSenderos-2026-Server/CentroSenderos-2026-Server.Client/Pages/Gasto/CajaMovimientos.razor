@page "/gastos/caja"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization
@inject IHttpServicio Http

<PageTitle>Movimientos de Caja Senderos</PageTitle>

<div class="caja-movimientos">
    <header class="caja-cabecera">
        <div>
            <a class="caja-volver" href="/gastos">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a Gastos
            </a>
            <h1>Movimientos de Caja Senderos</h1>
        </div>
    </header>

    @if (cargando)
    {
        <p class="caja-aviso" role="status">Cargando movimientos…</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <p class="caja-aviso caja-error" role="alert">@error</p>
    }
    else
    {
        var periodoValido = !(desde > hasta);
        var visibles = movimientos.Where(movimiento =>
            periodoValido &&
            (!desde.HasValue || movimiento.Fecha.Date >= desde.Value.Date) &&
            (!hasta.HasValue || movimiento.Fecha.Date <= hasta.Value.Date)).ToList();

        <div class="caja-contenido">
            <aside class="caja-saldo" aria-labelledby="saldo-caja">
                <i class="bi bi-wallet2" aria-hidden="true"></i>
                <h2 id="saldo-caja">Saldo registrado</h2>
                <strong>@Moneda(movimientos.Sum(movimiento => movimiento.Importe))</strong>
                <p>Incluye efectivo y otros medios de pago desde el primer movimiento disponible.</p>
            </aside>

            <section class="caja-listado" aria-labelledby="movimientos-periodo">
                <div class="caja-listado-cabecera">
                    <h2 id="movimientos-periodo">Movimientos del período</h2>
                </div>

                <div class="caja-filtros" role="group" aria-label="Filtros de fecha">
                    <CalendarioGasto Id="caja-fecha-desde" Etiqueta="Desde" PermiteLimpiar="true"
                                     AlinearIzquierdaEnMovil="true" @bind-Value="desde" />
                    <CalendarioGasto Id="caja-fecha-hasta" Etiqueta="Hasta" PermiteLimpiar="true"
                                     @bind-Value="hasta" />
                </div>

                @if (!periodoValido)
                {
                    <p class="caja-aviso caja-error" role="alert">La fecha desde debe ser anterior o igual a la fecha hasta.</p>
                }
                else if (visibles.Count == 0)
                {
                    <p class="caja-aviso" role="status">Sin movimientos en el período.</p>
                }
                else
                {
                    <div class="caja-tabla" tabindex="0" role="region" aria-label="Tabla de movimientos">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Concepto</th>
                                    <th scope="col">Origen</th>
                                    <th scope="col">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movimiento in visibles)
                                {
                                    <tr class="@(ReferenceEquals(movimiento, seleccionado) ? "caja-seleccionado" : null)"
                                        @onclick="() => SeleccionarMovimiento(movimiento)">
                                        <td class="caja-fecha">@movimiento.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <button type="button" class="caja-detalle-enlace"
                                                    aria-label="@($"{movimiento.Concepto}, {movimiento.Referencia}, {movimiento.Fecha:dd/MM/yyyy}, {Moneda(movimiento.Importe)}")"
                                                    @onclick="() => SeleccionarMovimiento(movimiento)"
                                                    @onclick:stopPropagation="true">
                                                @movimiento.Concepto
                                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                        <td>
                                            @movimiento.Referencia
                                            <small>#@movimiento.OrigenId</small>
                                        </td>
                                        <td class="@(movimiento.Importe < 0 ? "caja-importe salida" : "caja-importe ingreso")">
                                            @(movimiento.Importe > 0 ? "+" : string.Empty)@Moneda(movimiento.Importe)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="3">Movimiento neto del período</th>
                                    <td class="caja-importe">@Moneda(visibles.Sum(movimiento => movimiento.Importe))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
</div>

@if (gastoDetalleId == null && seleccionado is { } movimientoSeleccionado &&
    movimientoSeleccionado.Tipo != TipoMovimientoCaja.PagoGasto)
{
    <div class="caja-detalle-fondo" @onclick="CerrarMovimiento">
        <section class="caja-detalle-movimiento" role="dialog" aria-modal="true"
                 aria-labelledby="titulo-movimiento-caja" @onclick:stopPropagation="true">
            <h3 id="titulo-movimiento-caja">@movimientoSeleccionado.Concepto</h3>
            <p>@movimientoSeleccionado.Referencia · @Moneda(movimientoSeleccionado.Importe)</p>
            @if (movimientoSeleccionado.Tipo == TipoMovimientoCaja.Reintegro)
            {
                @if (cargandoGastos)
                {
                    <p role="status">Cargando gastos del reintegro…</p>
                }
                else if (!string.IsNullOrWhiteSpace(errorDetalle))
                {
                    <p role="alert">@errorDetalle</p>
                }
                else if (gastosReintegro.Count == 0)
                {
                    <p>Sin gastos asociados.</p>
                }
                else
                {
                    <ul class="caja-gastos-reintegro">
                        @foreach (var gasto in gastosReintegro)
                        {
                            <li>
                                <button type="button" class="caja-detalle-enlace"
                                        @onclick="() => gastoDetalleId = gasto.GastoId">@gasto.Descripcion</button>
                                <strong>@Moneda(gasto.Monto)</strong>
                            </li>
                        }
                    </ul>
                }
            }
            <button type="button" class="caja-cerrar-detalle" @onclick="CerrarMovimiento">Cerrar</button>
        </section>
    </div>
}

@if (gastoDetalleId is int id)
{
    <GastosDetalle @key="id" GastoId="id" SoloLectura="true" OnCerrar="() => gastoDetalleId = null" />
}

@code {
    #region Estado

    private List<MovimientoCajaDTO> movimientos = new();
    private bool cargando = true;
    private string error = string.Empty;
    private DateTime? desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? hasta;
    private MovimientoCajaDTO? seleccionado;
    private List<GastoMovimientoCajaDTO> gastosReintegro = new();
    private int? gastoDetalleId;
    private bool cargandoGastos;
    private string errorDetalle = string.Empty;
    private int versionSeleccion;

    #endregion

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var respuesta = await Http.Get<List<MovimientoCajaDTO>>("api/caja/movimientos");
            if (respuesta.Error)
            {
                error = respuesta.ObtenerError();
                return;
            }

            movimientos = respuesta.Respuesta ?? new();
        }
        catch (Exception)
        {
            error = "No se pudieron consultar los movimientos de Caja.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SeleccionarMovimiento(MovimientoCajaDTO movimiento)
    {
        var version = ++versionSeleccion;
        seleccionado = movimiento;
        errorDetalle = string.Empty;
        gastosReintegro = new();
        cargandoGastos = movimiento.Tipo == TipoMovimientoCaja.Reintegro;
        if (movimiento.Tipo == TipoMovimientoCaja.PagoGasto)
        {
            gastoDetalleId = movimiento.OrigenId;
            return;
        }

        if (!cargandoGastos)
            return;

        try
        {
            var respuesta = await Http.Get<List<GastoMovimientoCajaDTO>>(
                $"api/caja/reintegros/{movimiento.OrigenId}/gastos");
            if (version != versionSeleccion)
                return;

            if (respuesta.Error)
                errorDetalle = respuesta.ObtenerError();
            else
                gastosReintegro = respuesta.Respuesta ?? new();
        }
        catch (Exception)
        {
            if (version == versionSeleccion)
                errorDetalle = "No se pudieron consultar los gastos de este reintegro.";
        }
        finally
        {
            if (version == versionSeleccion)
                cargandoGastos = false;
        }
    }

    private void CerrarMovimiento()
    {
        versionSeleccion++;
        seleccionado = null;
    }

    private static string Moneda(decimal monto) =>
        monto.ToString("C2", CultureInfo.GetCultureInfo("es-AR"));
}
