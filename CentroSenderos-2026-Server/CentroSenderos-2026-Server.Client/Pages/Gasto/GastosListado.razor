@page "/gastos"
@attribute [Authorize]
@rendermode InteractiveAuto

@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http
@inject NavigationManager Nav

<div class="gastos-page">
    <div class="page-header">
        <div>
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Gastos</h1>
            <p>Consultá los gastos y los aportes de cada socio.</p>
        </div>

        <button type="button"
                class="new-button"
                @onclick="AbrirCrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo gasto</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="success-message" role="status">
            <div>
                <i class="bi bi-check-circle"></i>
                <span>@mensajeExito</span>
            </div>

            <button type="button"
                    aria-label="Cerrar mensaje"
                    @onclick="CerrarMensaje">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="search-box">
        <i class="bi bi-search"></i>

        <input type="search"
               aria-label="Buscar gastos"
               placeholder="Buscar por tipo, descripción o socio..."
               @bind="busqueda"
               @bind:event="oninput" />
    </div>

    @if (cargando)
    {
        <div class="state-card" role="status">
            <p>Cargando gastos...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="state-card">
            <div class="state-icon">
                <i class="bi bi-exclamation-circle"></i>
            </div>

            <h2>No se pudo actualizar el listado</h2>
            <p role="alert">@mensajeError</p>

            <button type="button"
                    class="retry-button"
                    @onclick="CargarGastos">
                <i class="bi bi-arrow-clockwise"></i>
                Reintentar
            </button>
        </div>
    }
    else if (lista.Count == 0)
    {
        <div class="state-card">
            <div class="state-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <h2>No hay gastos registrados</h2>
            <p>Creá el primero desde Nuevo gasto.</p>
        </div>
    }
    else if (!GastosFiltrados.Any())
    {
        <div class="state-card">
            <div class="state-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>Sin resultados</h2>
            <p>Probá con otro tipo, descripción o nombre de socio.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="table-container">
                <table class="gastos-table">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Tipo de gasto</th>
                            <th scope="col">Descripción</th>
                            <th scope="col">Aportes por socio</th>
                            <th scope="col" class="amount-column">
                                Monto total
                            </th>
                            <th scope="col" class="actions-column">
                                Acción
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var gasto in GastosFiltrados)
                        {
                            <tr @key="gasto.Id">
                                <td class="date-cell">
                                    @gasto.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td class="type-cell">
                                    @gasto.TipoGasto
                                </td>

                                <td class="description-cell">
                                    @gasto.Descripcion
                                </td>

                                <td>
                                    <div class="socios-list">
                                        @foreach (var aporte in gasto.GastoSocios)
                                        {
                                            <div class="socio-aporte"
                                                 @key="aporte.SocioId">
                                                <span class="socio-name">
                                                    @aporte.Profesional
                                                </span>

                                                <span class="socio-amount">
                                                    @aporte.Monto.ToString("C2", cultura)
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td class="amount-column total-cell">
                                    @gasto.Monto.ToString("C2", cultura)
                                </td>

                                <td class="actions-column">
                                    <div class="gasto-actions">
                                        <button type="button"
                                                class="edit-button"
                                                title="Editar gasto"
                                                aria-label="@($"Editar gasto del {gasto.Fecha:dd/MM/yyyy}: {gasto.Descripcion}")"
                                                @onclick="() => AbrirEditar(gasto.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        @if (gasto.TieneHistorial)
                                        {
                                            <button type="button"
                                                    class="edit-button"
                                                    title="Ver historial"
                                                    aria-label="@($"Ver historial del gasto del {gasto.Fecha:dd/MM/yyyy}: {gasto.Descripcion}")"
                                                    @onclick="() => AbrirHistorial(gasto.Id)">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="list-footer">
                Mostrando @GastosFiltrados.Count() de @lista.Count gastos
            </div>
        </div>
    }

    @if (mostrarCrear)
    {
        <GastosCrear OnCerrar="CerrarCrear"
                     OnGuardado="GastoGuardado" />
    }

    @if (mostrarEditar)
    {
        <GastosEditar @key="gastoEditarId"
                      GastoId="gastoEditarId"
                      OnCerrar="CerrarEditar"
                      OnGuardado="GastoActualizado" />
    }

    @if (mostrarHistorial)
    {
        <GastosHistorial @key="gastoHistorialId"
                         GastoId="gastoHistorialId"
                         OnCerrar="CerrarHistorial" />
    }


</div>

@code {
    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private List<GastoListadoDTO> lista = new();

    private bool cargando = true;
    private bool cargaEnCurso;
    private bool mostrarCrear;
    private bool mostrarEditar;

    private int gastoEditarId;
    private int versionMensaje;

    private string busqueda = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private bool mostrarHistorial;
    private int gastoHistorialId;

    private void AbrirHistorial(int id)
    {
        CerrarMensaje();
        mostrarCrear = false;
        mostrarEditar = false;
        gastoHistorialId = id;
        mostrarHistorial = true;
    }

    private void CerrarHistorial()
    {
        mostrarHistorial = false;
    }

    private IEnumerable<GastoListadoDTO> GastosFiltrados
    {
        get
        {
            var texto = busqueda.Trim();

            if (string.IsNullOrWhiteSpace(texto))
                return lista;

            return lista.Where(gasto =>
                gasto.TipoGasto.Contains(
                    texto,
                    StringComparison.OrdinalIgnoreCase) ||
                gasto.Descripcion.Contains(
                    texto,
                    StringComparison.OrdinalIgnoreCase) ||
                gasto.GastoSocios.Any(aporte =>
                    aporte.Profesional.Contains(
                        texto,
                        StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarGastos();
    }

    private async Task CargarGastos()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var respuesta =
                await Http.Get<List<GastoListadoDTO>>(
                    "api/gasto/ListaGastos");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError = "No se pudieron consultar los gastos.";
                }

                return;
            }

            lista = respuesta.Respuesta ?? new();
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError =
                "No se pudieron cargar los gastos. Verificá la conexión.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private void AbrirCrear()
    {
        CerrarMensaje();
        mostrarEditar = false;
        mostrarCrear = true;
    }

    private void CerrarCrear()
    {
        mostrarCrear = false;
    }

    private void AbrirEditar(int id)
    {
        CerrarMensaje();
        mostrarCrear = false;
        gastoEditarId = id;
        mostrarEditar = true;
    }

    private void CerrarEditar()
    {
        mostrarEditar = false;
    }

    private async Task GastoGuardado()
    {
        mostrarCrear = false;
        busqueda = string.Empty;

        await ConfirmarCambio("Gasto registrado correctamente.");
    }

    private async Task GastoActualizado()
    {
        mostrarEditar = false;

        await ConfirmarCambio("Gasto actualizado correctamente.");
    }

    private async Task ConfirmarCambio(string texto)
    {
        mensajeExito = texto;

        var versionActual = ++versionMensaje;

        await CargarGastos();

        StateHasChanged();

        await Task.Delay(4000);

        if (versionActual == versionMensaje)
        {
            mensajeExito = string.Empty;
        }
    }

    private void CerrarMensaje()
    {
        versionMensaje++;
        mensajeExito = string.Empty;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}