    {
        volverAlDetalle = false;

        CerrarMensaje();
        CerrarModales();

        mostrarCrear = true;
    }

    private void CerrarCrear()
    {
        mostrarCrear = false;
    }

    private void AbrirEditar(int id)
    {
        volverAlDetalle = mostrarDetalle;

        CerrarMensaje();
        CerrarModales();

        gastoEditarId = id;
        mostrarEditar = true;
    }

    private void CerrarEditar()
    {
        mostrarEditar = false;

        if (volverAlDetalle)
        {
            volverAlDetalle = false;
            AbrirDetalle(gastoEditarId);
        }
    }

    private void AbrirHistorial(int id)
    {
        volverAlDetalle = mostrarDetalle;

        CerrarMensaje();
        CerrarModales();

        gastoHistorialId = id;
        mostrarHistorial = true;
    }

    private void CerrarHistorial()
    {
        mostrarHistorial = false;

        if (volverAlDetalle)
        {
            volverAlDetalle = false;
            AbrirDetalle(gastoHistorialId);
        }
    }

    private void AbrirDetalle(int id)
    {
        CerrarMensaje();
        CerrarModales();

        gastoDetalleId = id;
        mostrarDetalle = true;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        volverAlDetalle = false;
    }

    private void CerrarModales()
    {
        mostrarReintegro = false;
        mostrarCrear = false;
        mostrarEditar = false;
        mostrarHistorial = false;
        mostrarDetalle = false;

        CerrarCalendarioPeriodo();
    }

    private async Task GastoGuardado()
    {
        CerrarModales();

        await ConfirmarCambio("Gasto registrado correctamente.");
    }

    private async Task GastoActualizado()
    {
        var regresarAlDetalle = volverAlDetalle;
        volverAlDetalle = false;

        CerrarModales();

        if (regresarAlDetalle)
            AbrirDetalle(gastoEditarId);

        await ConfirmarCambio("Gasto actualizado correctamente.");
    }

    private async Task ConfirmarCambio(string texto)
    {
        mensajeExito = texto;

        var versionActual = ++versionMensaje;

        await CargarGastos();
        StateHasChanged();

        await Task.Delay(4000);

        if (versionActual == versionMensaje)
            mensajeExito = string.Empty;
    }

    private void CerrarMensaje()
    {
        versionMensaje++;
        mensajeExito = string.Empty;
    }
}