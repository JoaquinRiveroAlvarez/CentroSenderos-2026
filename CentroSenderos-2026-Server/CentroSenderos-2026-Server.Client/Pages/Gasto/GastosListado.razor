@page "/gastos"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http

<div class="gastos-page">
    @if (!string.IsNullOrEmpty(calendarioActivo))
    {
        <button type="button"
                class="periodo-cierre-fondo"
                aria-label="Cerrar calendario"
                @onclick="CerrarCalendarioPeriodo">
        </button>
    }

    <header class="gastos-header">
        <button type="button"
                class="new-button"
                @onclick="AbrirCrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo gasto</span>
        </button>

        <h1>Gastos</h1>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="success-message" role="status">
            <div>
                <i class="bi bi-check-circle"></i>
                <span>@mensajeExito</span>
            </div>

            <button type="button"
                    aria-label="Cerrar mensaje"
                    @onclick="CerrarMensaje">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="state-card" role="status">
            <p>Cargando gastos...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="state-card">
            <h2>No se pudo actualizar el listado</h2>
            <p role="alert">@mensajeError</p>

            <button type="button"
                    class="retry-button"
                    @onclick="CargarGastos">
                <i class="bi bi-arrow-clockwise"></i>
                Reintentar
            </button>
        </div>
    }
    else
    {
        var resultados = GastosFiltrados;
        var total = resultados.Sum(gasto => gasto.Monto);
        var gastosPanel = GastosFiltradosBase;
        var validos = gastosPanel.Where(TieneRepartoCompleto).ToList();
        var pendientes = validos.Where(TieneReintegroPendiente).ToList();
        var sinReparto = gastosPanel.Count - validos.Count;
        var saldados = validos.Count - pendientes.Count;
        var importePendiente = pendientes.Sum(ImportePendiente);
        var pagadoCaja = validos.Sum(g => g.GastoSocios.Where(a => a.SocioId == cajaId).Sum(a => a.Monto));
        var adelantado = validos.Sum(g => g.GastoSocios.Where(a => a.SocioId != cajaId).Sum(a => a.Monto));
        var reintegrado = validos.Sum(g => g.GastoReintegros.Sum(r => r.Monto));
        var porcentaje = adelantado > 0 ? Math.Clamp(reintegrado / adelantado * 100m, 0m, 100m) : 0m;
        var resumenSocios = ResumenSocios(validos);

        <div class="gastos-layout">
            <section class="list-card">
                <div class="gastos-filters">
                    <div class="filter-field">
                        <label for="filtroTipoGasto">Tipo de gasto</label>

                        <select id="filtroTipoGasto"
                                @bind="tipoSeleccionadoId">
                            <option value="0">Todos los tipos</option>

                            @foreach (var tipo in TiposDisponibles)
                            {
                                <option value="@tipo.Id">
                                    @tipo.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <label for="filtroSocioGasto">Pagado por</label>

                        <select id="filtroSocioGasto"
                                @bind="socioSeleccionadoId">
                            <option value="0">Todos los pagadores</option>

                            @foreach (var socio in SociosDisponibles)
                            {
                                <option value="@socio.SocioId">
                                    @socio.Profesional
                                </option>
                            }
                        </select>
                    </div>

                    <div class="@ClaseCampoFecha("desde")">
                        <label id="labelFechaDesde">Desde</label>

                        <button type="button"
                                class="periodo-fecha-selector"
                                aria-labelledby="labelFechaDesde textoFechaDesde"
                                aria-expanded="@(calendarioActivo == "desde")"
                                aria-controls="calendarioDesde"
                                @onclick="AbrirCalendarioDesde">
                            <span id="textoFechaDesde">
                                @(fechaDesde?.ToString("dd/MM/yyyy") ?? "Sin límite")
                            </span>

                            <i class="bi bi-calendar3"></i>
                        </button>

                        @if (calendarioActivo == "desde")
                        {
                            <section id="calendarioDesde"
                                     class="periodo-calendario"
                                     aria-label="Calendario Desde">
                                <div class="periodo-calendario-header">
                                    <button type="button"
                                            class="periodo-calendario-nav"
                                            aria-label="Mes anterior"
                                            disabled="@EsPrimerMes"
                                            @onclick="MesAnteriorPeriodo">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>

                                    <strong>@TituloMesCalendarioPeriodo</strong>

                                    <button type="button"
                                            class="periodo-calendario-nav"
                                            aria-label="Mes siguiente"
                                            disabled="@EsUltimoMes"
                                            @onclick="MesSiguientePeriodo">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>

                                <div class="periodo-calendario-semana">
                                    <span>Lu</span>
                                    <span>Ma</span>
                                    <span>Mi</span>
                                    <span>Ju</span>
                                    <span>Vi</span>
                                    <span>Sá</span>
                                    <span>Do</span>
                                </div>

                                <div class="periodo-calendario-dias">
                                    @for (var espacio = 0; espacio < EspaciosCalendarioPeriodo; espacio++)
                                    {
                                        <span aria-hidden="true"></span>
                                    }

                                    @foreach (var dia in DiasCalendarioPeriodo)
                                    {
                                        <button type="button"
                                                class="@ClaseDiaPeriodo(dia)"
                                                aria-label="@dia.ToString("D", cultura)"
                                                aria-pressed="@(FechaCalendarioPeriodo?.Date == dia.Date)"
                                                @onclick="() => SeleccionarFechaPeriodo(dia)">
                                            @dia.Day
                                        </button>
                                    }
                                </div>

                                <div class="periodo-calendario-footer">
                                    <button type="button"
                                            @onclick="LimpiarFechaPeriodo">
                                        Sin límite
                                    </button>

                                    <button type="button"
                                            @onclick="SeleccionarHoyPeriodo">
                                        Hoy
                                    </button>

                                    <button type="button"
                                            @onclick="CerrarCalendarioPeriodo">
                                        Cerrar
                                    </button>
                                </div>
                            </section>
                        }
                    </div>

                    <div class="@ClaseCampoFecha("hasta")">
                        <label id="labelFechaHasta">Hasta</label>

                        <button type="button"
                                class="periodo-fecha-selector"
                                aria-labelledby="labelFechaHasta textoFechaHasta"
                                aria-expanded="@(calendarioActivo == "hasta")"
                                aria-controls="calendarioHasta"
                                @onclick="AbrirCalendarioHasta">
                            <span id="textoFechaHasta">
                                @(fechaHasta?.ToString("dd/MM/yyyy") ?? "Sin límite")
                            </span>

                            <i class="bi bi-calendar3"></i>
                        </button>

                        @if (calendarioActivo == "hasta")
                        {
                            <section id="calendarioHasta"
                                     class="periodo-calendario"
                                     aria-label="Calendario Hasta">
                                <div class="periodo-calendario-header">
                                    <button type="button"
                                            class="periodo-calendario-nav"
                                            aria-label="Mes anterior"
                                            disabled="@EsPrimerMes"
                                            @onclick="MesAnteriorPeriodo">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>

                                    <strong>@TituloMesCalendarioPeriodo</strong>

                                    <button type="button"
                                            class="periodo-calendario-nav"
                                            aria-label="Mes siguiente"
                                            disabled="@EsUltimoMes"
                                            @onclick="MesSiguientePeriodo">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>

                                <div class="periodo-calendario-semana">
                                    <span>Lu</span>
                                    <span>Ma</span>
                                    <span>Mi</span>
                                    <span>Ju</span>
                                    <span>Vi</span>
                                    <span>Sá</span>
                                    <span>Do</span>
                                </div>

                                <div class="periodo-calendario-dias">
                                    @for (var espacio = 0; espacio < EspaciosCalendarioPeriodo; espacio++)
                                    {
                                        <span aria-hidden="true"></span>
                                    }

                                    @foreach (var dia in DiasCalendarioPeriodo)
                                    {
                                        <button type="button"
                                                class="@ClaseDiaPeriodo(dia)"
                                                aria-label="@dia.ToString("D", cultura)"
                                                aria-pressed="@(FechaCalendarioPeriodo?.Date == dia.Date)"
                                                @onclick="() => SeleccionarFechaPeriodo(dia)">
                                            @dia.Day
                                        </button>
                                    }
                                </div>

                                <div class="periodo-calendario-footer">
                                    <button type="button"
                                            @onclick="LimpiarFechaPeriodo">
                                        Sin límite
                                    </button>

                                    <button type="button"
                                            @onclick="SeleccionarHoyPeriodo">
                                        Hoy
                                    </button>

                                    <button type="button"
                                            @onclick="CerrarCalendarioPeriodo">
                                        Cerrar
                                    </button>
                                </div>
                            </section>
                        }
                    </div>

                    <button type="button"
                            class="filter-order-button"
                            title="Cambiar orden por fecha"
                            @onclick="CambiarOrden">
                        <i class="bi bi-arrow-down-up"></i>
                        @(ordenDescendente ? "Más recientes" : "Más antiguos")
                    </button>

                    <div class="filter-search">
                        <i class="bi bi-search"></i>

                        <input type="search"
                               aria-label="Buscar gastos"
                               placeholder="Buscar por tipo, descripción o socio..."
                               @bind="busqueda"
                               @bind:event="oninput" />
                    </div>

                    <button type="button"
                            class="filter-reset-button"
                            @onclick="RestaurarFiltros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Restaurar filtros
                    </button>
                </div>

                @if (soloSinReparto || soloConReintegros)
                {
                    <div class="pending-filter-bar" role="status">
                        <span>
                            <i class="bi bi-info-circle"></i>
                            @(soloConReintegros ? "Mostrando gastos con reintegros pendientes" : "Mostrando gastos con datos por revisar")
                        </span>

                        <button type="button"
                                @onclick="QuitarFiltroPendientes">
                            Quitar este filtro
                        </button>
                    </div>
                }

                @if (PeriodoInvalido)
                {
                    <div class="state-card">
                        <i class="bi bi-calendar3"></i>
                        <h2>Revisá el período</h2>

                        <p role="alert">
                            La fecha Desde no puede ser posterior a Hasta.
                        </p>
                    </div>
                }
                else if (lista.Count == 0)
                {
                    <div class="state-card">
                        <i class="bi bi-receipt"></i>
                        <h2>No hay gastos registrados</h2>
                        <p>Creá el primero desde Nuevo gasto.</p>
                    </div>
                }
                else if (resultados.Count == 0)
                {
                    <div class="state-card">
                        <i class="bi bi-search"></i>
                        <h2>Sin resultados</h2>
                        <p>No hay gastos que coincidan con los filtros.</p>
                    </div>
                }
                else
                {
                    <div class="table-container">
                        <table class="gastos-table">
                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Tipo de gasto</th>
                                    <th scope="col">Pagado por</th>
                                    <th scope="col">Descripción</th>

                                    <th scope="col" class="amount-column">
                                        Monto total
                                    </th>

                                    <th scope="col" class="actions-column">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var gasto in resultados)
                                {
                                    <tr @key="gasto.Id"
                                        class="@(TieneReintegroPendiente(gasto) ? "gasto-row reintegro-pendiente" : "gasto-row")"
                                        @onclick="() => AbrirDetalle(gasto.Id)">
                                        <td class="date-cell">
                                            @gasto.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td class="type-cell">
                                            @gasto.TipoGasto
                                        </td>

                                        <td>
                                            <div class="socios-list">
                                                @foreach (var aporte in gasto.GastoSocios)
                                                {
                                                    <div class="socio-aporte"
                                                         @key="aporte.SocioId">
                                                        <span class="socio-name">
                                                            @aporte.Profesional
                                                        </span>

                                                        <span class="socio-amount">
                                                            @Moneda(aporte.Monto)
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </td>

                                        <td class="description-cell">
                                            <button type="button"
                                                    class="gasto-detail-link"
                                                    aria-label="@($"Ver detalle: {gasto.Descripcion}")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => AbrirDetalle(gasto.Id)">
                                                @gasto.Descripcion
                                            </button>
                                            @if (TieneReintegroPendiente(gasto))
                                            {
                                                <span class="gasto-pendiente-badge"><i class="bi bi-arrow-left-right"></i> Pendiente: @Moneda(ImportePendiente(gasto))</span>
                                            }
                                            else if (!TieneRepartoCompleto(gasto))
                                            {
                                                <span class="gasto-reparto-badge">Datos por revisar</span>
                                            }
                                        </td>

                                        <td class="amount-column total-cell">
                                            @Moneda(gasto.Monto)
                                        </td>

                                        <td class="actions-column">
                                            <div class="gasto-actions"
                                                 @onclick:stopPropagation="true">
                                                <button type="button"
                                                        class="edit-button"
                                                        title="Editar gasto"
                                                        aria-label="@($"Editar: {gasto.Descripcion}")"
                                                        @onclick="() => AbrirEditar(gasto.Id)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                @if (gasto.TieneHistorial)
                                                {
                                                    <button type="button"
                                                            class="edit-button"
                                                            title="Ver historial"
                                                            aria-label="@($"Ver historial: {gasto.Descripcion}")"
                                                            @onclick="() => AbrirHistorial(gasto.Id)">
                                                        <i class="bi bi-clock-history"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="4">
                                        Total de gastos mostrados
                                    </th>

                                    <td class="amount-column">
                                        @Moneda(total)
                                    </td>

                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }

                <div class="list-footer">
                    Mostrando @resultados.Count de @lista.Count gastos
                </div>
            </section>

            <aside class="gastos-summary caja-panel" aria-label="Estado de gastos de Caja Senderos">
                <section class="caja-principal">
                    <div class="caja-encabezado">
                        <span class="caja-icono"><i class="bi bi-wallet2"></i></span>
                        <div><span class="panel-eyebrow">ESTADO DE GASTOS</span><h2>Caja Senderos</h2></div>
                    </div>
                    <span class="caja-periodo">@NombrePeriodo</span>
                    <div class="caja-deuda">
                        <span>Pendiente de reintegrar</span>
                        <strong>@(PeriodoInvalido ? "—" : Moneda(importePendiente))</strong>
                        <span class="@(importePendiente > 0 ? "caja-estado pendiente" : "caja-estado al-dia")">
                            <i class="@(importePendiente > 0 ? "bi bi-clock" : "bi bi-check-circle")"></i>
                            @(PeriodoInvalido ? "Revisá las fechas" : validos.Count == 0 ? "Sin gastos evaluables" : importePendiente > 0 ? "Con reintegros pendientes" : "Sin reintegros pendientes")
                        </span>
                    </div>
                    <div class="caja-metricas">
                        <div><span>Gastos de la selección</span><strong>@Moneda(gastosPanel.Sum(g => g.Monto))</strong></div>
                        <div><span>Pagado por Caja</span><strong>@Moneda(pagadoCaja)</strong></div>
                        <div><span>Devuelto a socios</span><strong>@Moneda(reintegrado)</strong></div>
                    </div>
                    <p class="panel-nota">Estado actual de los gastos seleccionados. El saldo del centro se incorporará cuando haya ingresos.</p>
                </section>

                <section class="panel-card">
                    <div class="panel-titulo"><h2>Avance de reintegros</h2><span>@porcentaje.ToString("0", cultura)%</span></div>
                    <div class="caja-progreso" role="progressbar" aria-label="Porcentaje reintegrado de los adelantos" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@porcentaje.ToString(CultureInfo.InvariantCulture)">
                        <span style="@($"width: {porcentaje.ToString(CultureInfo.InvariantCulture)}%")"></span>
                    </div>
                    <p class="panel-nota">@Moneda(reintegrado) devueltos de @Moneda(adelantado) adelantados por socios.</p>
                    <div class="panel-estados">
                        <button type="button" class="@(soloConReintegros ? "panel-filtro activo" : "panel-filtro")" aria-pressed="@soloConReintegros" @onclick="VerGastosConReintegros"><span><i class="bi bi-arrow-left-right"></i> Pendientes</span><strong>@pendientes.Count</strong></button>
                        <div class="panel-filtro saldados"><span><i class="bi bi-check-circle"></i> Saldados</span><strong>@saldados</strong></div>
                        <button type="button" class="@(soloSinReparto ? "panel-filtro activo" : "panel-filtro")" aria-pressed="@soloSinReparto" @onclick="VerGastosSinReparto"><span><i class="bi bi-exclamation-circle"></i> Por revisar</span><strong>@sinReparto</strong></button>
                    </div>
                    @if (sinReparto > 0)
                    {
                        <p class="panel-aviso">@sinReparto @(sinReparto == 1 ? "gasto excluido" : "gastos excluidos") de los saldos y reintegros por datos anteriores o inconsistentes.</p>
                    }
                    @if (soloSinReparto || soloConReintegros)
                    {
                        <button type="button" class="panel-enlace" @onclick="QuitarFiltroPendientes">Ver todos los estados <i class="bi bi-arrow-right"></i></button>
                    }
                </section>

                <section class="panel-card panel-socios">
                    <div class="panel-titulo"><h2>Socios</h2><span>@resumenSocios.Count</span></div>
                    <p class="panel-nota">Adelantos y devoluciones de esta selección.</p>
                    @if (resumenSocios.Count == 0)
                    {
                        <p class="panel-vacio">Sin adelantos de socios para mostrar.</p>
                    }
                    @foreach (var socio in resumenSocios)
                    {
                        <div class="panel-socio" @key="socio.Id">
                            <div class="panel-socio-header"><span>@socio.Nombre</span><strong class="@(socio.Pendiente > 0 ? "socio-pendiente" : "socio-saldado")">@(socio.Pendiente > 0 ? Moneda(socio.Pendiente) : "Al día")</strong></div>
                            <small>@(socio.Pendiente > 0 ? "Pendiente de recibir" : "Sin devolución pendiente")</small>
                            <div class="panel-socio-detalle"><span>Adelantó <b>@Moneda(socio.Adelantado)</b></span><span>Recibió <b>@Moneda(socio.Recibido)</b></span></div>
                        </div>
                    }
                </section>

                @if (pendientes.Count > 0)
                {
                    <section class="panel-card">
                        <div class="panel-titulo"><h2>Para resolver</h2><i class="bi bi-arrow-up-right"></i></div>
                        @foreach (var pendiente in pendientes.OrderByDescending(ImportePendiente).Take(3))
                        {
                            <button type="button" class="pendiente-gasto-link" @key="pendiente.Id" @onclick="() => AbrirDetalle(pendiente.Id)">
                                <span>@pendiente.Descripcion<small>@pendiente.Fecha.ToString("dd/MM/yyyy")</small></span>
                                <strong>@Moneda(ImportePendiente(pendiente))</strong><i class="bi bi-chevron-right"></i>
                            </button>
                        }
                    </section>
                }
                <p class="panel-alcance">Según fecha, tipo, pagador y búsqueda. Los reintegros incluyen todas las devoluciones de esos gastos, aunque se hayan realizado después del período.</p>
            </aside>
        </div>
    }

    @if (mostrarReintegro)
    {
        <ReintegrosCrear @key="gastoReintegroId"
                         GastoId="gastoReintegroId"
                         OnCerrar="CerrarReintegro"
                         OnGuardado="ReintegroGuardado" />
    }

    @if (mostrarCrear)
    {
        <GastosCrear OnCerrar="CerrarCrear"
                     OnGuardado="GastoGuardado" />
    }

    @if (mostrarEditar)
    {
        <GastosEditar @key="gastoEditarId"
                      GastoId="gastoEditarId"
                      OnCerrar="CerrarEditar"
                      OnGuardado="GastoActualizado" />
    }

    @if (mostrarHistorial)
    {
        <GastosHistorial @key="gastoHistorialId"
                         GastoId="gastoHistorialId"
                         OnCerrar="CerrarHistorial" />
    }

    @if (mostrarDetalle)
    {
        <GastosDetalle @key="gastoDetalleId"
                       GastoId="gastoDetalleId"
                       OnCerrar="CerrarDetalle"
                       OnEditar="AbrirEditar"
                       OnHistorial="AbrirHistorial"
                       OnReintegro="AbrirReintegro" />
    }
</div>

@code {
    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private List<GastoListadoDTO> lista = new();

    private bool cargando = true;
    private bool cargaEnCurso;
    private bool mostrarCrear;
    private bool mostrarReintegro;
    private bool mostrarEditar;
    private bool mostrarHistorial;
    private bool mostrarDetalle;
    private bool volverAlDetalle;
    private bool ordenDescendente = true;
    private bool soloSinReparto;
    private bool soloConReintegros;

    private int gastoReintegroId;
    private int gastoEditarId;
    private int gastoHistorialId;
    private int gastoDetalleId;
    private int versionMensaje;
    private int tipoSeleccionadoId;
    private int socioSeleccionadoId;

    private DateTime? fechaDesde =
        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime? fechaHasta =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            DateTime.DaysInMonth(
                DateTime.Today.Year,
                DateTime.Today.Month));

    private DateTime mesCalendarioPeriodo =
        new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private string calendarioActivo = string.Empty;
    private string busqueda = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private bool PeriodoInvalido =>
        fechaDesde.HasValue &&
        fechaHasta.HasValue &&
        fechaDesde.Value.Date > fechaHasta.Value.Date;

    private bool EsPrimerMes =>
        mesCalendarioPeriodo.Year == 1 &&
        mesCalendarioPeriodo.Month == 1;

    private bool EsUltimoMes =>
        mesCalendarioPeriodo.Year == 9999 &&
        mesCalendarioPeriodo.Month == 12;

    private DateTime? FechaCalendarioPeriodo =>
        calendarioActivo == "desde" ? fechaDesde : fechaHasta;

    private string TituloMesCalendarioPeriodo =>
        cultura.TextInfo.ToTitleCase(
            mesCalendarioPeriodo.ToString("MMMM yyyy", cultura));

    private int EspaciosCalendarioPeriodo =>
        ((int)mesCalendarioPeriodo.DayOfWeek + 6) % 7;

    private IEnumerable<DateTime> DiasCalendarioPeriodo =>
        Enumerable.Range(
                1,
                DateTime.DaysInMonth(
                    mesCalendarioPeriodo.Year,
                    mesCalendarioPeriodo.Month))
            .Select(dia => new DateTime(
                mesCalendarioPeriodo.Year,
                mesCalendarioPeriodo.Month,
                dia));

    private IEnumerable<(int Id, string Nombre)> TiposDisponibles =>
        lista
            .GroupBy(gasto => gasto.TipoGastoId)
            .Select(grupo => (
                Id: grupo.Key,
                Nombre: grupo.First().TipoGasto))
            .OrderBy(tipo => tipo.Nombre);

    private IEnumerable<GastoSocioListadoDTO> SociosDisponibles =>
        lista
            .SelectMany(gasto => gasto.GastoSocios)
            .GroupBy(aporte => aporte.SocioId)
            .Select(grupo => grupo.First())
            .OrderBy(aporte => aporte.Profesional);

    private string NombrePeriodo
    {
        get
        {
            if (PeriodoInvalido)
                return "Período inválido";

            if (fechaDesde.HasValue && fechaHasta.HasValue)
            {
                return $"{fechaDesde.Value:dd/MM/yyyy} al " +
                       $"{fechaHasta.Value:dd/MM/yyyy}";
            }

            if (fechaDesde.HasValue)
                return $"Desde {fechaDesde.Value:dd/MM/yyyy}";

            if (fechaHasta.HasValue)
                return $"Hasta {fechaHasta.Value:dd/MM/yyyy}";

            return "Todos los períodos";
        }
    }

    private List<GastoListadoDTO> GastosFiltradosBase
    {
        get
        {
            if (PeriodoInvalido)
                return new();

            var texto = busqueda.Trim();

            var gastos = lista.Where(gasto =>
                (tipoSeleccionadoId == 0 ||
                 gasto.TipoGastoId == tipoSeleccionadoId) &&
                (socioSeleccionadoId == 0 ||
                 gasto.GastoSocios.Any(aporte =>
                     aporte.SocioId == socioSeleccionadoId)) &&
                (!fechaDesde.HasValue ||
                 gasto.Fecha.Date >= fechaDesde.Value.Date) &&
                (!fechaHasta.HasValue ||
                 gasto.Fecha.Date <= fechaHasta.Value.Date) &&
                (string.IsNullOrWhiteSpace(texto) ||
                 gasto.TipoGasto.Contains(
                     texto,
                     StringComparison.OrdinalIgnoreCase) ||
                 gasto.Descripcion.Contains(
                     texto,
                     StringComparison.OrdinalIgnoreCase) ||
                 gasto.GastoSocios.Any(aporte =>
                     aporte.Profesional.Contains(
                         texto,
                         StringComparison.OrdinalIgnoreCase))));

            return ordenDescendente
                ? gastos
                    .OrderByDescending(gasto => gasto.Fecha)
                    .ThenByDescending(gasto => gasto.Id)
                    .ToList()
                : gastos
                    .OrderBy(gasto => gasto.Fecha)
                    .ThenBy(gasto => gasto.Id)
                    .ToList();
        }
    }

    private List<GastoListadoDTO> GastosFiltrados => GastosFiltradosBase
        .Where(gasto =>
            (!soloSinReparto || !TieneRepartoCompleto(gasto)) &&
            (!soloConReintegros || TieneReintegroPendiente(gasto)))
        .ToList();

    private int cajaId;

    private bool TieneRepartoCompleto(GastoListadoDTO gasto)
    {
        if (cajaId <= 0 || gasto.Monto <= 0 ||
            gasto.GastoRepartos.Count != 1 ||
            gasto.GastoRepartos[0].SocioId != cajaId ||
            gasto.GastoRepartos[0].Monto != gasto.Monto ||
            gasto.GastoSocios.Any(a => a.Monto <= 0) ||
            gasto.GastoSocios.Sum(a => a.Monto) != gasto.Monto ||
            gasto.GastoReintegros.Any(r => r.Monto <= 0 || r.SocioPagadorId != cajaId || r.SocioReceptorId == cajaId))
            return false;

        return gasto.GastoReintegros.GroupBy(r => r.SocioReceptorId)
            .All(grupo => grupo.Sum(r => r.Monto) <= gasto.GastoSocios
                .Where(a => a.SocioId == grupo.Key).Sum(a => a.Monto));
    }

    private decimal ImportePendiente(GastoListadoDTO gasto) =>
        TieneRepartoCompleto(gasto)
            ? gasto.GastoSocios.Where(a => a.SocioId != cajaId).Sum(a => a.Monto)
                - gasto.GastoReintegros.Sum(r => r.Monto)
            : 0m;

    private bool TieneReintegroPendiente(GastoListadoDTO gasto) =>
        ImportePendiente(gasto) > 0m;

    private List<ResumenSocioPanel> ResumenSocios(List<GastoListadoDTO> gastos)
    {
        return gastos.SelectMany(g => g.GastoSocios)
            .Where(a => a.SocioId != cajaId)
            .GroupBy(a => a.SocioId)
            .Select(grupo => new ResumenSocioPanel
            {
                Id = grupo.Key,
                Nombre = grupo.Select(a => a.Profesional).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "Socio",
                Adelantado = grupo.Sum(a => a.Monto),
                Recibido = gastos.SelectMany(g => g.GastoReintegros)
                    .Where(r => r.SocioReceptorId == grupo.Key).Sum(r => r.Monto)
            })
            .OrderByDescending(s => s.Pendiente).ThenBy(s => s.Nombre).ToList();
    }

    private class ResumenSocioPanel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Adelantado { get; set; }
        public decimal Recibido { get; set; }
        public decimal Pendiente => Adelantado - Recibido;
    }

