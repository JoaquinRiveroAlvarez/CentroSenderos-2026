    {
        soloSinReparto = true;
        soloConReintegros = false;
        CerrarCalendarioPeriodo();
    }

    private void CambiarOrden()
    {
        ordenDescendente = !ordenDescendente;
    }

    private void RestaurarFiltros()
    {
        tipoSeleccionadoId = 0;
        socioSeleccionadoId = 0;
        soloSinReparto = false;
        soloConReintegros = false;

        fechaDesde = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

        fechaHasta = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            DateTime.DaysInMonth(
                DateTime.Today.Year,
                DateTime.Today.Month));

        busqueda = string.Empty;
        ordenDescendente = true;

        CerrarCalendarioPeriodo();
    }

    private string ClaseCampoFecha(string campo)
    {
        return calendarioActivo == campo
            ? "filter-field periodo-campo calendario-abierto"
            : "filter-field periodo-campo";
    }

    private void AbrirCalendarioDesde()
    {
        AbrirCalendarioPeriodo("desde");
    }

    private void AbrirCalendarioHasta()
    {
        AbrirCalendarioPeriodo("hasta");
    }

    private void AbrirCalendarioPeriodo(string campo)
    {
        if (calendarioActivo == campo)
        {
            CerrarCalendarioPeriodo();
            return;
        }

        calendarioActivo = campo;

        var fecha = FechaCalendarioPeriodo ?? DateTime.Today;

        mesCalendarioPeriodo = new DateTime(
            fecha.Year,
            fecha.Month,
            1);
    }

    private void CerrarCalendarioPeriodo()
    {
        calendarioActivo = string.Empty;
    }

    private void MesAnteriorPeriodo()
    {
        if (!EsPrimerMes)
            mesCalendarioPeriodo = mesCalendarioPeriodo.AddMonths(-1);
    }

    private void MesSiguientePeriodo()
    {
        if (!EsUltimoMes)
            mesCalendarioPeriodo = mesCalendarioPeriodo.AddMonths(1);
    }

    private string ClaseDiaPeriodo(DateTime dia)
    {
        var clase = "periodo-calendario-dia";

        if (dia.Date == DateTime.Today)
            clase += " hoy";

        if (FechaCalendarioPeriodo?.Date == dia.Date)
            clase += " seleccionado";

        return clase;
    }

    private void SeleccionarFechaPeriodo(DateTime fecha)
    {
        if (calendarioActivo == "desde")
        {
            fechaDesde = fecha.Date;
        }
        else if (calendarioActivo == "hasta")
        {
            fechaHasta = fecha.Date;
        }

        CerrarCalendarioPeriodo();
    }

    private void SeleccionarHoyPeriodo()
    {
        SeleccionarFechaPeriodo(DateTime.Today);
    }

    private void LimpiarFechaPeriodo()
    {
        if (calendarioActivo == "desde")
        {
            fechaDesde = null;
        }
        else if (calendarioActivo == "hasta")
        {
            fechaHasta = null;
        }

        CerrarCalendarioPeriodo();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarGastos();
    }

    private async Task CargarGastos()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var respuestaSocios = await Http.Get<List<SocioListadoDTO>>("api/socio/ListaSocio");
            if (respuestaSocios.Error)
            {
                mensajeError = respuestaSocios.ObtenerError();
                return;
            }
            var caja = respuestaSocios.Respuesta?.SingleOrDefault(s => s.EsCaja);
            if (caja == null)
            {
                mensajeError = "No se pudo identificar Caja Senderos activa.";
                return;
            }
            cajaId = caja.Id;

            var respuesta =
                await Http.Get<List<GastoListadoDTO>>(
                    "api/gasto/ListaGastos");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError =
                        "No se pudieron consultar los gastos.";
                }

                return;
            }

            lista = respuesta.Respuesta ?? new();
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError =
                "No se pudieron cargar los gastos. Verificá la conexión.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private void AbrirReintegro(int id)
    {
        volverAlDetalle = true;
        CerrarMensaje();
        CerrarModales();
        gastoReintegroId = id;
        mostrarReintegro = true;
    }

    private async Task CerrarReintegro()
    {
        mostrarReintegro = false;
        volverAlDetalle = false;
        await CargarGastos();
        AbrirDetalle(gastoReintegroId);
    }

    private async Task ReintegroGuardado()
    {
        volverAlDetalle = false;
        CerrarModales();
        AbrirDetalle(gastoReintegroId);
        await ConfirmarCambio("Reintegro registrado correctamente.");
    }

