@page "/gastos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http

<div class="gastos-page">
    <header class="gastos-header">
        <button type="button"
                class="new-button"
                @onclick="AbrirCrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo gasto</span>
        </button>

        <h1>Gastos</h1>
        <div class="gastos-selector">
            <SelectorCaja />
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="success-message" role="status">
            <div>
                <i class="bi bi-check-circle"></i>
                <span>@mensajeExito</span>
            </div>

            <button type="button"
                    aria-label="Cerrar mensaje"
                    @onclick="CerrarMensaje">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="state-card" role="status">
            <p>Cargando gastos...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="state-card">
            <h2>No se pudo actualizar el listado</h2>
            <p role="alert">@mensajeError</p>

            <button type="button"
                    class="retry-button"
                    @onclick="CargarGastos">
                <i class="bi bi-arrow-clockwise"></i>
                Reintentar
            </button>
        </div>
    }
    else
    {
        var resultados = consulta.Gastos;
        var total = consulta.Total;
        var importePendiente = consulta.Adelantado - consulta.Reintegrado;
        var porcentaje = consulta.Adelantado > 0
            ? Math.Clamp(consulta.Reintegrado / consulta.Adelantado * 100m, 0m, 100m)
            : 0m;

        <div class="gastos-layout">
            <section class="list-card">
                <div class="gastos-filters">
                    <div class="filter-field">
                        <label for="filtroTipoGasto">Tipo de gasto</label>

                        <select id="filtroTipoGasto"
                                @bind="tipoSeleccionadoId" @bind:after="ActualizarConsulta">
                            <option value="0">Todos los tipos</option>

                            @foreach (var tipo in TiposDisponibles)
                            {
                                <option value="@tipo.Id">
                                    @tipo.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <label for="filtroSocioGasto">Pagado por</label>

                        <select id="filtroSocioGasto"
                                @bind="socioSeleccionadoId" @bind:after="ActualizarConsulta">
                            <option value="0">Todos los pagadores</option>

                            @foreach (var socio in SociosDisponibles)
                            {
                                <option value="@socio.SocioId">
                                    @socio.Profesional
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <label for="filtroReintegroGasto">Reintegro</label>
                        <select id="filtroReintegroGasto" @bind="estadoReintegro" @bind:after="ActualizarFiltroEstado">
                            <option value="">Todos los estados</option>
                            @foreach (var estado in Enum.GetValues<EstadoReintegroGasto>())
                            {
                                <option value="@estado">@NombreEstadoReintegro(estado)</option>
                            }
                        </select>
                    </div>

                    <CalendarioGasto Id="fechaFiltroDesde" Etiqueta="Desde" PermiteLimpiar="true"
                                     AlinearIzquierdaEnMovil="true" @bind-Value="fechaDesde"
                                     @bind-Value:after="ActualizarConsulta" />

                    <CalendarioGasto Id="fechaFiltroHasta" Etiqueta="Hasta" PermiteLimpiar="true"
                                     @bind-Value="fechaHasta" @bind-Value:after="ActualizarConsulta" />

                    <button type="button"
                            class="filter-order-button"
                            title="Cambiar orden por fecha"
                            @onclick="CambiarOrden">
                        <i class="bi bi-arrow-down-up"></i>
                        @(ordenDescendente ? "Más recientes" : "Más antiguos")
                    </button>

                    <div class="filter-search" role="search" aria-label="Búsqueda de gastos">
                        <input type="search"
                               aria-label="Buscar gastos"
                               placeholder="Buscar por tipo, descripción o socio..."
                               @bind="busqueda"
                               @bind:event="oninput"
                               @onkeydown="BuscarConTeclado" />
                        <button type="button" class="buscar-gastos" @onclick="ActualizarConsulta">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            Buscar
                        </button>
                    </div>

                    <button type="button"
                            class="filter-reset-button"
                            @onclick="RestaurarFiltros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Restaurar filtros
                    </button>
                </div>

                @if (socioPendienteId > 0)
                {
                    <div class="pending-filter-bar" role="status">
                        <span>Pendiente de devolver a @socioPendienteNombre</span>
                        <button type="button" @onclick="QuitarFiltroSocioPendiente">Quitar este filtro</button>
                    </div>
                }

                @if (PeriodoInvalido)
                {
                    <div class="state-card">
                        <i class="bi bi-calendar3"></i>
                        <h2>Revisá el período</h2>

                        <p role="alert">
                            La fecha Desde no puede ser posterior a Hasta.
                        </p>
                    </div>
                }
                else if (resultados.Count == 0 && !HayFiltros)
                {
                    <div class="state-card">
                        <i class="bi bi-receipt"></i>
                        <h2>No hay gastos registrados</h2>
                        <p>Creá el primero desde Nuevo gasto.</p>
                    </div>
                }
                else if (resultados.Count == 0)
                {
                    <div class="state-card">
                        <i class="bi bi-search"></i>
                        <h2>Sin resultados</h2>
                        <p>No hay gastos que coincidan con los filtros.</p>
                    </div>
                }
                else
                {
                    <div class="table-container">
                        <table class="gastos-table">
                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Tipo de gasto</th>
                                    <th scope="col">Pagado por</th>
                                    <th scope="col">Descripción</th>

                                    <th scope="col" class="amount-column">
                                        Monto total
                                    </th>

                                    <th scope="col">Reintegro</th>
                                    <th scope="col" class="actions-column">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var gasto in resultados)
                                {
                                    var estado = gasto.ObtenerEstadoReintegro(cajaId);
                                    var pendiente = socioPendienteId > 0
                                        ? gasto.SaldoSocio(socioPendienteId)
                                        : ImportePendiente(gasto);

                                    <tr @key="gasto.Id"
                                        class="@(TieneReintegroPendiente(gasto) ? "gasto-row reintegro-pendiente" : "gasto-row")"
                                        @onclick="() => AbrirDetalle(gasto.Id)">
                                        <td class="date-cell" data-label="Fecha">
                                            @gasto.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td class="type-cell" data-label="Tipo de gasto">
                                            @gasto.TipoGasto
                                        </td>

                                        <td data-label="Pagado por">
                                            <div class="socios-list">
                                                @foreach (var aporte in gasto.GastoSocios)
                                                {
                                                    <div class="socio-aporte"
                                                         @key="aporte.SocioId">
                                                        <span class="socio-name">
                                                            @aporte.Profesional
                                                        </span>

                                                        <span class="socio-amount">
                                                            @Moneda(aporte.Monto)
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </td>

                                        <td class="description-cell" data-label="Descripción">
                                            <div class="gasto-descripcion">
                                                <button type="button"
                                                        class="gasto-detail-link"
                                                        aria-label="@($"Ver detalle: {gasto.Descripcion}")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => AbrirDetalle(gasto.Id)">
                                                    @gasto.Descripcion
                                                </button>
                                                @if (gasto.CantidadComprobantes > 0)
                                                {
                                                    var etiqueta = gasto.CantidadComprobantes == 1
                                                        ? "1 comprobante"
                                                        : $"{gasto.CantidadComprobantes} comprobantes";
                                                    <button type="button" class="gasto-comprobantes-link"
                                                            title="@($"Ver {etiqueta}")"
                                                            aria-label="@($"Ver {etiqueta} de {gasto.Descripcion}")"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => AbrirDetalle(gasto.Id, irAComprobantes: true)">
                                                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                                                        <span>@gasto.CantidadComprobantes</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>

                                        <td class="amount-column total-cell" data-label="Monto total">
                                            @Moneda(gasto.Monto)
                                        </td>

                                        <td class="gasto-estado-reintegro" data-label="Reintegro">
                                            <span class="@ClaseEstadoReintegro(estado)">@NombreEstadoReintegro(estado)</span>
                                            @if (pendiente > 0m)
                                            {
                                                <small>@Moneda(pendiente) por devolver</small>
                                            }
                                            else if (estado == EstadoReintegroGasto.PorRevisar)
                                            {
                                                <small>@MotivoRevision(gasto)</small>
                                            }
                                        </td>

                                        <td class="actions-column" data-label="Acciones">
                                            <div class="gasto-actions"
                                                 @onclick:stopPropagation="true">
                                                <button type="button"
                                                        class="edit-button"
                                                        title="Editar gasto"
                                                        aria-label="@($"Editar: {gasto.Descripcion}")"
                                                        @onclick="() => AbrirEditar(gasto.Id)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                @if (gasto.TieneHistorial)
                                                {
                                                    <button type="button"
                                                            class="edit-button"
                                                            title="Ver historial"
                                                            aria-label="@($"Ver historial: {gasto.Descripcion}")"
                                                            @onclick="() => AbrirHistorial(gasto.Id)">
                                                        <i class="bi bi-clock-history"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="4">
                                        Total de gastos mostrados
                                    </th>

                                    <td class="amount-column">
                                        @Moneda(total)
                                    </td>

                                    <td></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }

                <div class="list-footer">
                    <span>@consulta.Cantidad gastos · Página @consulta.Pagina de @consulta.Paginas</span>
                    @if (consulta.Paginas > 1)
                    {
                        <nav class="gastos-paginacion" aria-label="Paginación de gastos">
                            <button type="button" disabled="@(consulta.Pagina == 1)"
                                    @onclick="() => CambiarPagina(-1)">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                Anterior
                            </button>
                            <button type="button" disabled="@(consulta.Pagina == consulta.Paginas)"
                                    @onclick="() => CambiarPagina(1)">
                                Siguiente
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        </nav>
                    }
                </div>
            </section>

            <aside class="gastos-summary caja-panel" aria-label="Estado de gastos de Caja Senderos">
                <section class="caja-principal">
                    <div class="caja-encabezado">
                        <span class="caja-icono"><i class="bi bi-wallet2"></i></span>
                        <div><span class="panel-eyebrow">ESTADO DE GASTOS</span><h2>Caja Senderos</h2></div>
                    </div>
                    <a class="caja-movimientos-enlace" href="/gastos/caja">
                        <span>Ver movimientos de Caja</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                    <span class="caja-periodo">@NombrePeriodo</span>
                    <div class="caja-deuda">
                        <span>Pendiente de reintegrar</span>
                        <strong>@(PeriodoInvalido ? "—" : Moneda(importePendiente))</strong>
                        <span class="@(importePendiente > 0 ? "caja-estado pendiente" : "caja-estado al-dia")">
                            <i class="@(importePendiente > 0 ? "bi bi-clock" : "bi bi-check-circle")"></i>
                            @(PeriodoInvalido ? "Revisá las fechas" : consulta.PagadoCaja == 0m && consulta.Adelantado == 0m ? "Sin gastos evaluables" : importePendiente > 0 ? "Con reintegros pendientes" : "Sin reintegros pendientes")
                        </span>
                    </div>
                    <div class="caja-metricas">
                        <div><span>Gastos de la selección</span><strong>@Moneda(consulta.TotalSeleccion)</strong></div>
                        <div><span>Pagado por Caja</span><strong>@Moneda(consulta.PagadoCaja)</strong></div>
                        <div><span>Devuelto a socios</span><strong>@Moneda(consulta.Reintegrado)</strong></div>
                    </div>
                    <p class="panel-nota">Saldo actual de los gastos seleccionados por fecha del gasto. Si filtrás por pagador, se incluyen todos los pagos de esos gastos.</p>
                </section>

                <section class="panel-card">
                    <div class="panel-titulo"><h2>Avance de reintegros</h2><span>@porcentaje.ToString("0", cultura)%</span></div>
                    <div class="caja-progreso" role="progressbar" aria-label="Porcentaje reintegrado de los adelantos" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@porcentaje.ToString(CultureInfo.InvariantCulture)">
                        <span style="@($"width: {porcentaje.ToString(CultureInfo.InvariantCulture)}%")"></span>
                    </div>
                    <p class="panel-nota">@Moneda(consulta.Reintegrado) devueltos de @Moneda(consulta.Adelantado) adelantados por socios.</p>
                    <div class="panel-estados">
                        <button type="button" class="@ClaseFiltroEstado(EstadoReintegroGasto.ConSaldoPendiente)"
                                aria-pressed="@(estadoReintegro == EstadoReintegroGasto.ConSaldoPendiente)"
                                @onclick="() => FiltrarEstado(EstadoReintegroGasto.ConSaldoPendiente)">
                            <span><i class="bi bi-arrow-left-right"></i> Pendientes</span><strong>@consulta.Pendientes</strong>
                        </button>
                        <button type="button" class="@ClaseFiltroEstado(EstadoReintegroGasto.Saldado)"
                                aria-pressed="@(estadoReintegro == EstadoReintegroGasto.Saldado)"
                                @onclick="() => FiltrarEstado(EstadoReintegroGasto.Saldado)">
                            <span><i class="bi bi-check-circle"></i> Saldados</span><strong>@consulta.Saldados</strong>
                        </button>
                        <button type="button" class="@ClaseFiltroEstado(EstadoReintegroGasto.PorRevisar)"
                                aria-pressed="@(estadoReintegro == EstadoReintegroGasto.PorRevisar)"
                                @onclick="() => FiltrarEstado(EstadoReintegroGasto.PorRevisar)">
                            <span><i class="bi bi-exclamation-circle"></i> Por revisar</span><strong>@consulta.PorRevisar</strong>
                        </button>
                    </div>
                    @if (consulta.PorRevisar > 0)
                    {
                        <p class="panel-aviso">@consulta.PorRevisar @(consulta.PorRevisar == 1 ? "gasto excluido" : "gastos excluidos") de los saldos y reintegros por datos anteriores o inconsistentes.</p>
                    }
                    @if (estadoReintegro.HasValue)
                    {
                        <button type="button" class="panel-enlace" @onclick="() => FiltrarEstado(null)">Ver todos los estados <i class="bi bi-arrow-right"></i></button>
                    }
                </section>

                <section class="panel-card panel-socios">
                    <div class="panel-titulo"><h2>Socios</h2><span>@consulta.Socios.Count</span></div>
                    <p class="panel-nota">Adelantos y devoluciones de esta selección.</p>
                    @if (consulta.Socios.Count == 0)
                    {
                        <p class="panel-vacio">Sin adelantos de socios para mostrar.</p>
                    }
                    @foreach (var socio in consulta.Socios)
                    {
                        <div class="panel-socio" @key="socio.Id">
                            <div class="panel-socio-header">
                                <span>@socio.Nombre</span>
                                @if (socio.Pendiente > 0m)
                                {
                                    <button type="button" class="socio-pendiente socio-pendiente-enlace"
                                            aria-label="@($"Ver gastos pendientes de {socio.Nombre}")"
                                            aria-pressed="@(socioPendienteId == socio.Id)"
                                            @onclick="() => FiltrarSocioPendiente(socio.Id, socio.Nombre)">
                                        @Moneda(socio.Pendiente)
                                    </button>
                                }
                                else
                                {
                                    <strong class="socio-saldado">Al día</strong>
                                }
                            </div>
                            <small>@(socio.Pendiente > 0 ? "Pendiente de recibir" : "Sin devolución pendiente")</small>
                            <div class="panel-socio-detalle"><span>Adelantó <b>@Moneda(socio.Adelantado)</b></span><span>Recibió <b>@Moneda(socio.Recibido)</b></span></div>
                        </div>
                    }
                </section>

                @if (consulta.Pendientes > 0)
                {
                    <section class="panel-card">
                        <div class="panel-titulo"><h2>Para resolver</h2><i class="bi bi-arrow-up-right"></i></div>
                        @foreach (var pendiente in consulta.Prioritarios)
                        {
                            <button type="button" class="pendiente-gasto-link" @key="pendiente.Id" @onclick="() => AbrirDetalle(pendiente.Id)">
                                <span>@pendiente.Descripcion<small>@pendiente.Fecha.ToString("dd/MM/yyyy")</small></span>
                                <strong>@Moneda(ImportePendiente(pendiente))</strong><i class="bi bi-chevron-right"></i>
                            </button>
                        }
                    </section>
                }
                <p class="panel-alcance">Según fecha, tipo, pagador y búsqueda. Los reintegros incluyen todas las devoluciones de esos gastos, aunque se hayan realizado después del período.</p>
            </aside>
        </div>
    }

    @if (mostrarReintegro)
    {
        <ReintegrosCrear @key="gastoReintegroId"
                         GastoId="gastoReintegroId"
                         OnCerrar="CerrarReintegro"
                         OnGuardado="ReintegroGuardado" />
    }

    @if (mostrarCrear)
    {
        <GastosCrear OnCerrar="CerrarCrear"
                     OnGuardado="GastoGuardado" />
    }

    @if (mostrarEditar)
    {
        <GastosEditar @key="gastoEditarId"
                      GastoId="gastoEditarId"
                      OnCerrar="CerrarEditar"
                      OnGuardado="GastoActualizado" />
    }

    @if (mostrarHistorial)
    {
        <GastosHistorial @key="gastoHistorialId"
                         GastoId="gastoHistorialId"
                         OnCerrar="CerrarHistorial" />
    }

    @if (mostrarDetalle)
    {
        <GastosDetalle @key="gastoDetalleId"
                       GastoId="gastoDetalleId"
                       IrAComprobantes="irAComprobantesDetalle"
                       OnCerrar="CerrarDetalle"
                       OnEditar="AbrirEditar"
                       OnHistorial="AbrirHistorial"
                       CajaId="cajaId"
                       OnReintegro="AbrirReintegro" />
    }
</div>

@code {
    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private GastosPaginaDTO consulta = new();
    private int pagina = 1;

    private bool cargando = true;
    private bool cargaEnCurso;
    private bool mostrarCrear;
    private bool mostrarReintegro;
    private bool mostrarEditar;
    private bool mostrarHistorial;
    private bool mostrarDetalle;
    private bool volverAlDetalle;
    private bool ordenDescendente = true;
    private EstadoReintegroGasto? estadoReintegro;
    private int socioPendienteId;
    private string socioPendienteNombre = string.Empty;

    private int gastoReintegroId;
    private int gastoEditarId;
    private int gastoHistorialId;
    private int gastoDetalleId;
    private bool irAComprobantesDetalle;
    private int versionMensaje;
    private int tipoSeleccionadoId;
    private int socioSeleccionadoId;

    private DateTime? fechaDesde =
        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime? fechaHasta =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            DateTime.DaysInMonth(
                DateTime.Today.Year,
                DateTime.Today.Month));

    private string busqueda = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private bool PeriodoInvalido =>
        fechaDesde.HasValue &&
        fechaHasta.HasValue &&
        fechaDesde.Value.Date > fechaHasta.Value.Date;

    private IEnumerable<(int Id, string Nombre)> TiposDisponibles =>
        consulta.Tipos.Select(tipo => (tipo.Id, tipo.Tipo));

    private IEnumerable<GastoSocioListadoDTO> SociosDisponibles => consulta.Pagadores;

    private bool HayFiltros => tipoSeleccionadoId > 0 || socioSeleccionadoId > 0 ||
        !string.IsNullOrWhiteSpace(busqueda) || estadoReintegro.HasValue || socioPendienteId > 0;

    private string NombrePeriodo
    {
        get
        {
            if (PeriodoInvalido)
                return "Período inválido";

            if (fechaDesde.HasValue && fechaHasta.HasValue)
            {
                return $"{fechaDesde.Value:dd/MM/yyyy} al " +
                       $"{fechaHasta.Value:dd/MM/yyyy}";
            }

            if (fechaDesde.HasValue)
                return $"Desde {fechaDesde.Value:dd/MM/yyyy}";

            if (fechaHasta.HasValue)
                return $"Hasta {fechaHasta.Value:dd/MM/yyyy}";

            return "Todos los períodos";
        }
    }

    private int cajaId => consulta.CajaId;

    private bool TieneRepartoCompleto(GastoListadoDTO gasto) =>
        gasto.EsCompatibleConCaja(cajaId);

    private decimal ImportePendiente(GastoListadoDTO gasto) =>
        TieneRepartoCompleto(gasto)
            ? gasto.GastoSocios.Where(a => a.SocioId != cajaId).Sum(a => a.Monto)
                - gasto.GastoReintegros.Sum(r => r.Monto)
            : 0m;

    private bool TieneReintegroPendiente(GastoListadoDTO gasto) =>
        ImportePendiente(gasto) > 0m;

    private string MotivoRevision(GastoListadoDTO gasto)
    {
        if (cajaId <= 0)
            return "Caja Senderos sin configurar";

        if (gasto.Monto <= 0m || gasto.GastoSocios.Any(aporte => aporte.Monto <= 0m)
            || gasto.GastoSocios.Sum(aporte => aporte.Monto) != gasto.Monto)
            return "Los pagos no coinciden con el total";

        if (gasto.GastoReintegros.Any(reintegro => reintegro.Monto <= 0m
            || reintegro.SocioPagadorId != cajaId || reintegro.SocioReceptorId == cajaId))
            return "Reintegro incompatible con Caja";

        if (gasto.GastoRepartos.Count == 0)
            return "Falta imputar a Caja";

        if (gasto.GastoRepartos.Count != 1 || gasto.GastoRepartos[0].SocioId != cajaId
            || gasto.GastoRepartos[0].Monto != gasto.Monto)
            return "Reparto incompatible con Caja";

        return "El reintegro supera el aporte";
    }

    private static string NombreEstadoReintegro(EstadoReintegroGasto estado) => estado switch
    {
        EstadoReintegroGasto.ConSaldoPendiente => "Pendiente o parcial",
        EstadoReintegroGasto.NoCorresponde => "No corresponde",
        EstadoReintegroGasto.PorRevisar => "Por revisar",
        _ => estado.ToString()
    };

    private static string ClaseEstadoReintegro(EstadoReintegroGasto estado) => estado switch
    {
        EstadoReintegroGasto.Pendiente or EstadoReintegroGasto.Parcial => "gasto-pendiente-badge",
        EstadoReintegroGasto.PorRevisar => "gasto-reparto-badge",
        EstadoReintegroGasto.Saldado => "socio-saldado",
        _ => "text-muted"
    };

    private string ClaseFiltroEstado(EstadoReintegroGasto estado) =>
        estadoReintegro == estado ? "panel-filtro activo" : "panel-filtro";

    private Task FiltrarEstado(EstadoReintegroGasto? estado)
    {
        estadoReintegro = estado;
        return ActualizarFiltroEstado();
    }

    private Task ActualizarFiltroEstado()
    {
        if (estadoReintegro is EstadoReintegroGasto.Saldado
            or EstadoReintegroGasto.NoCorresponde or EstadoReintegroGasto.PorRevisar)
            return QuitarFiltroSocioPendiente();

        return ActualizarConsulta();
    }

    private Task FiltrarSocioPendiente(int socioId, string nombre)
    {
        socioPendienteId = socioId;
        socioPendienteNombre = nombre;
        estadoReintegro = EstadoReintegroGasto.ConSaldoPendiente;
        return ActualizarConsulta();
    }

    private Task QuitarFiltroSocioPendiente()
    {
        socioPendienteId = 0;
        socioPendienteNombre = string.Empty;
        return ActualizarConsulta();
    }

    private string Moneda(decimal monto) => "$ " + monto.ToString("N2", cultura);

    private async Task CambiarOrden()
    {
        ordenDescendente = !ordenDescendente;
        await ActualizarConsulta();
    }

    private async Task RestaurarFiltros()
    {
        tipoSeleccionadoId = 0;
        socioSeleccionadoId = 0;
        estadoReintegro = null;
        socioPendienteId = 0;
        socioPendienteNombre = string.Empty;

        fechaDesde = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

        fechaHasta = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            DateTime.DaysInMonth(
                DateTime.Today.Year,
                DateTime.Today.Month));

        busqueda = string.Empty;
        ordenDescendente = true;

        await ActualizarConsulta();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarGastos();
    }

    private Task BuscarConTeclado(KeyboardEventArgs evento) =>
        evento.Key == "Enter" ? ActualizarConsulta() : Task.CompletedTask;

    private Task ActualizarConsulta()
    {
        pagina = 1;
        return CargarGastos();
    }

    private Task CambiarPagina(int desplazamiento)
    {
        pagina = consulta.Pagina + desplazamiento;
        return CargarGastos();
    }

    private async Task CargarGastos()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var parametros = $"pagina={pagina}&tipoId={tipoSeleccionadoId}&pagadorId={socioSeleccionadoId}" +
                $"&desde={fechaDesde:yyyy-MM-dd}&hasta={fechaHasta:yyyy-MM-dd}" +
                $"&descendente={ordenDescendente}&estadoReintegro={estadoReintegro}&socioPendienteId={socioPendienteId}" +
                $"&texto={Uri.EscapeDataString(busqueda)}";
            var respuesta = await Http.Get<GastosPaginaDTO>($"api/gasto/consulta?{parametros}");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError =
                        "No se pudieron consultar los gastos.";
                }

                return;
            }

            consulta = respuesta.Respuesta ?? new();
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError =
                "No se pudieron cargar los gastos. Verificá la conexión.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private void AbrirReintegro(int id)
    {
        volverAlDetalle = true;
        CerrarMensaje();
        CerrarModales();
        gastoReintegroId = id;
        mostrarReintegro = true;
    }

    private async Task CerrarReintegro()
    {
        mostrarReintegro = false;
        volverAlDetalle = false;
        await CargarGastos();
        AbrirDetalle(gastoReintegroId);
    }

    private async Task ReintegroGuardado()
    {
        volverAlDetalle = false;
        CerrarModales();
        AbrirDetalle(gastoReintegroId);
        await ConfirmarCambio("Reintegro registrado correctamente.");
    }

    private void AbrirCrear()
    {
        volverAlDetalle = false;

        CerrarMensaje();
        CerrarModales();

        mostrarCrear = true;
    }

    private void CerrarCrear()
    {
        mostrarCrear = false;
    }

    private void AbrirEditar(int id)
    {
        volverAlDetalle = mostrarDetalle;

        CerrarMensaje();
        CerrarModales();

        gastoEditarId = id;
        mostrarEditar = true;
    }

    private void CerrarEditar()
    {
        mostrarEditar = false;

        if (volverAlDetalle)
        {
            volverAlDetalle = false;
            AbrirDetalle(gastoEditarId);
        }
    }

    private void AbrirHistorial(int id)
    {
        volverAlDetalle = mostrarDetalle;

        CerrarMensaje();
        CerrarModales();

        gastoHistorialId = id;
        mostrarHistorial = true;
    }

    private void CerrarHistorial()
    {
        mostrarHistorial = false;

        if (volverAlDetalle)
        {
            volverAlDetalle = false;
            AbrirDetalle(gastoHistorialId);
        }
    }

    private void AbrirDetalle(int id, bool irAComprobantes = false)
    {
        CerrarMensaje();
        CerrarModales();

        gastoDetalleId = id;
        irAComprobantesDetalle = irAComprobantes;
        mostrarDetalle = true;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        volverAlDetalle = false;
    }

    private void CerrarModales()
    {
        mostrarReintegro = false;
        mostrarCrear = false;
        mostrarEditar = false;
        mostrarHistorial = false;
        mostrarDetalle = false;
    }

    private async Task GastoGuardado()
    {
        CerrarModales();

        await ConfirmarCambio("Gasto registrado correctamente.");
    }

    private async Task GastoActualizado()
    {
        var regresarAlDetalle = volverAlDetalle;
        volverAlDetalle = false;

        CerrarModales();

        if (regresarAlDetalle)
            AbrirDetalle(gastoEditarId);

        await ConfirmarCambio("Gasto actualizado correctamente.");
    }

    private async Task ConfirmarCambio(string texto)
    {
        mensajeExito = texto;

        var versionActual = ++versionMensaje;

        await CargarGastos();
        StateHasChanged();

        await Task.Delay(4000);

        if (versionActual == versionMensaje)
            mensajeExito = string.Empty;
    }

    private void CerrarMensaje()
    {
        versionMensaje++;
        mensajeExito = string.Empty;
    }
}