@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

@inject IHttpServicio Http

<div class="gasto-overlay" inert="@mostrarAltaTipo">
    <section class="gasto-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloNuevoGasto"
             @onclick:stopPropagation="true">

        <header class="modal-header">
            <div>
                <h2 id="tituloNuevoGasto">Nuevo gasto</h2>
                <p>Completá los datos y el aporte de cada socio.</p>
            </div>

            <button type="button"
                    class="close-button"
                    aria-label="Cerrar nuevo gasto"
                    disabled="@guardando"
                    @onclick="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        @if (cargando)
        {
            <div class="loading-message" role="status">
                <span class="spinner-border spinner-border-sm"></span>
                <span>Cargando tipos de gasto y socios...</span>
            </div>
        }
        else if (!datosCargados)
        {
            <div class="load-error">
                <p role="alert">@mensajeCarga</p>

                <button type="button"
                        class="secondary-button"
                        @onclick="CargarDatos">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reintentar
                </button>
            </div>
        }
        else
        {
            <EditForm EditContext="@contexto"
                      OnValidSubmit="Guardar"
                      FormName="CrearGastoForm">

                <DataAnnotationsValidator />

                <fieldset class="form-fields" disabled="@guardando">
                    <section class="form-section">
                        <h3>Detalles del gasto</h3>

                        <div class="form-grid">
                            <div class="field-group">
                                <label for="tipoGasto">Tipo de gasto</label>

                                <div class="selector-tipo-gasto">
                                    <InputSelect id="tipoGasto"
                                                 class="form-input"
                                                 @bind-Value="modelo.TipoGastoId">
                                        <option value="0">
                                            Seleccionar tipo
                                        </option>

                                        @foreach (var tipo in tiposGasto)
                                        {
                                            <option value="@tipo.Id">
                                                @tipo.Tipo
                                            </option>
                                        }
                                    </InputSelect>
                                    <button type="button" aria-label="Crear tipo de gasto"
                                            title="Crear tipo de gasto" @onclick="() => mostrarAltaTipo = true">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <ValidationMessage For="@(() => modelo.TipoGastoId)" />

                                @if (tiposGasto.Count == 0)
                                {
                                    <span class="field-help">
                                        Creá un tipo de gasto con el botón +.
                                    </span>
                                }
                            </div>

                            <div class="field-group">
                                <CalendarioGasto Id="fechaGasto" Etiqueta="Fecha"
                                                 @bind-Value="modelo.Fecha" />

                                <ValidationMessage For="@(() => modelo.Fecha)" />
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <h3>Aportes de los socios</h3>

                        <div class="field-group">
                            <label for="socioGasto">Agregar socio</label>

                            <select id="socioGasto"
                                    class="form-input"
                                    @bind="socioSeleccionadoId"
                                    @bind:after="AgregarSocio"
                                    disabled="@(guardando || !SociosDisponibles.Any())">

                                <option value="0">Seleccionar socio</option>

                                @foreach (var socio in SociosDisponibles)
                                {
                                    <option value="@socio.Id">
                                        @socio.Profesional
                                    </option>
                                }
                            </select>

                            @if (socios.Count == 0)
                            {
                                <span class="field-help">
                                    Primero registrá un socio
                                    en Administración.
                                </span>
                            }
                            else if (!SociosDisponibles.Any())
                            {
                                <span class="field-help">
                                    Ya agregaste todos los socios disponibles.
                                </span>
                            }
                        </div>

                        @if (modelo.GastoSocios.Count == 0)
                        {
                            <div class="empty-aportes">
                                Agregá los socios que pagaron este gasto.
                            </div>
                        }
                        else
                        {
                            <div class="aportes-list">
                                @foreach (var aporte in modelo.GastoSocios)
                                {
                                    <div class="aporte-row"
                                         @key="aporte.SocioId">

                                        <div class="aporte-name">
                                            <i class="bi bi-person"></i>
                                            <span>
                                                @NombreSocio(aporte.SocioId)
                                            </span>
                                        </div>

                                        <div class="field-group">
                                            <label for="@($"aporte-{aporte.SocioId}")">
                                                Monto aportado
                                            </label>

                                            <InputNumber id="@($"aporte-{aporte.SocioId}")"
                                                         class="form-input"
                                                         @bind-Value="aporte.Monto"
                                                         min="0.01"
                                                         step="0.01" />

                                            <ValidationMessage For="@(() => aporte.Monto)" />
                                        </div>

                                        <button type="button"
                                                class="remove-button"
                                                aria-label="@($"Quitar a {NombreSocio(aporte.SocioId)}")"
                                                @onclick="() => QuitarSocio(aporte)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <ValidationMessage For="@(() => modelo.GastoSocios)" />

                        @{
                            var cajaId = (socios.FirstOrDefault(socio => socio.EsCaja)?.Id ?? 0);
                            var pagadoCaja = modelo.GastoSocios.Where(aporte => aporte.SocioId == cajaId)
                                .Sum(aporte => aporte.Monto);
                            var adelantos = modelo.GastoSocios
                                .Where(aporte => aporte.SocioId != cajaId && aporte.Monto > 0m)
                                .ToList();
                            var pendiente = adelantos.Sum(aporte => aporte.Monto);
                        }
                        <div class="total-box" role="status">
                            <dl class="importe-principal">
                                <div>
                                    <dt>Monto total</dt>
                                    <dd>@Moneda(modelo.Monto)</dd>
                                </div>
                                <div class="importe-pendiente">
                                    <dt>Pendiente inicial de reintegrar</dt>
                                    <dd>@(cajaId > 0 ? Moneda(pendiente) : "Por revisar")</dd>
                                </div>
                            </dl>

                            @if (cajaId > 0)
                            {
                                <ul class="importe-desglose" aria-label="Desglose de pagos">
                                    <li>Caja pagó <strong>@Moneda(pagadoCaja)</strong></li>
                                    @foreach (var aporte in adelantos)
                                    {
                                        <li>@NombreSocio(aporte.SocioId) adelantó <strong>@Moneda(aporte.Monto)</strong></li>
                                    }
                                </ul>
                            }
                        </div>
                    </section>

                    <section class="form-section">
                        <h3>Notas adicionales</h3>

                        <div class="field-group">
                            <label for="descripcionGasto">
                                Descripción
                            </label>

                            <InputTextArea id="descripcionGasto"
                                           class="form-textarea"
                                           @bind-Value="modelo.Descripcion"
                                           maxlength="100"
                                           placeholder="Describí el gasto..." />

                            <ValidationMessage For="@(() => modelo.Descripcion)" />

                            <span class="field-help">
                                Máximo 100 caracteres.
                            </span>
                        </div>
                    </section>
                    <GastoComprobantes Modelo="modelo" OnLeyendoArchivo="CambiarLecturaComprobante" />
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="form-message" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@mensaje</span>
                    </div>
                }

                @if (MostrarAvisoDuplicado && datosAdvertidos is { } coincidencia)
                {
                    <div class="aviso-gasto-duplicado" role="alert">
                        <div class="aviso-gasto-duplicado__cabecera">
                            <span class="aviso-gasto-duplicado__icono" aria-hidden="true">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>

                            <div>
                                <strong>Posible gasto duplicado</strong>
                                <p>Estos gastos tienen la misma fecha, tipo e importe.</p>
                            </div>
                        </div>

                        <p class="aviso-gasto-duplicado__datos">
                            @coincidencia.Fecha.ToString("dd/MM/yyyy") · @Moneda(coincidencia.Monto)
                        </p>

                        <ul class="aviso-gasto-duplicado__lista">
                            @foreach (var gasto in posiblesDuplicados)
                            {
                                <li @key="gasto.Id">
                                    <span class="aviso-gasto-duplicado__numero">#@gasto.Id</span>
                                    <span>@gasto.Descripcion</span>
                                </li>
                            }
                        </ul>

                        <p class="aviso-gasto-duplicado__ayuda">
                            Si corresponde a otro gasto, elegí <strong>Guardar de todos modos</strong>.
                        </p>
                    </div>
                }

                <footer class="form-actions">
                    <button type="button"
                            class="secondary-button"
                            disabled="@guardando"
                            @onclick="Cerrar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || leyendoComprobante ||
                                        tiposGasto.Count == 0 ||
                                        socios.Count == 0)">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>@(MostrarAvisoDuplicado ? "Guardar de todos modos" : "Guardar gasto")</span>
                        }
                    </button>
                </footer>
            </EditForm>
        }
    </section>
</div>

@if (mostrarAltaTipo)
{
    <TipoGastoAltaRapida OnGuardado="SeleccionarTipoCreado" OnCerrar="() => mostrarAltaTipo = false" />
}

@code {
    private bool mostrarAltaTipo;

    private void SeleccionarTipoCreado(TipoListadoDTO tipo)
    {
        tiposGasto.RemoveAll(actual => actual.Id == tipo.Id);
        tiposGasto.Add(tipo);
        tiposGasto = tiposGasto.OrderBy(actual => actual.Tipo).ToList();
        modelo.TipoGastoId = tipo.Id;
        contexto.NotifyFieldChanged(FieldIdentifier.Create(() => modelo.TipoGastoId));
        mostrarAltaTipo = false;
    }

    [Parameter]
    public EventCallback OnCerrar { get; set; }

    [Parameter]
    public EventCallback OnGuardado { get; set; }

    private readonly GastoCrearDTO modelo = new()
    {
        Fecha = DateTime.Today,
        Descripcion = string.Empty,
        GastoSocios = new()
    };

    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private List<TipoListadoDTO> tiposGasto = new();
    private List<SocioListadoDTO> socios = new();

    private EditContext contexto = default!;
    private ValidationMessageStore erroresAportes = default!;

    private bool cargando = true;
    private bool datosCargados;
    private bool guardando;
    private bool leyendoComprobante;
    private (DateTime Fecha, int TipoGastoId, decimal Monto)? datosAdvertidos;
    private List<GastoListadoDTO> posiblesDuplicados = new();

    private (DateTime Fecha, int TipoGastoId, decimal Monto)? DatosParaDuplicado =>
        modelo.Fecha is DateTime fecha
            ? (fecha.Date, modelo.TipoGastoId, modelo.Monto)
            : null;

    private bool MostrarAvisoDuplicado =>
        posiblesDuplicados.Count > 0 && datosAdvertidos == DatosParaDuplicado;

    private void CambiarLecturaComprobante(bool leyendo) => leyendoComprobante = leyendo;

    private string mensaje = string.Empty;
    private string mensajeCarga = string.Empty;

    private int socioSeleccionadoId;

    private IEnumerable<SocioListadoDTO> SociosDisponibles =>
        socios.Where(socio =>
            !modelo.GastoSocios.Any(aporte =>
                aporte.SocioId == socio.Id));

    protected override async Task OnInitializedAsync()
    {
        contexto = new EditContext(modelo);
        erroresAportes = new ValidationMessageStore(contexto);

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        datosCargados = false;
        mensajeCarga = string.Empty;

        try
        {
            var respuestaTipos =
                await Http.Get<List<TipoListadoDTO>>(
                    "api/tipogasto/ListaTipoGasto");

            if (respuestaTipos.Error)
            {
                mensajeCarga = respuestaTipos.ObtenerError();
                return;
            }

            var respuestaSocios =
                await Http.Get<List<SocioListadoDTO>>(
                    "api/socio/ListaSocio");

            if (respuestaSocios.Error)
            {
                mensajeCarga = respuestaSocios.ObtenerError();
                return;
            }

            tiposGasto = respuestaTipos.Respuesta ?? new();
            socios = respuestaSocios.Respuesta ?? new();

            datosCargados = true;
        }
        catch (TaskCanceledException)
        {
            mensajeCarga =
                "La carga tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeCarga =
                "No se pudieron cargar los tipos de gasto o los socios. " +
                "Verificá la conexión y la respuesta de la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AgregarSocio()
    {
        var socioId = socioSeleccionadoId;
        socioSeleccionadoId = 0;

        if (guardando || socioId <= 0)
            return;

        if (!socios.Any(socio => socio.Id == socioId))
            return;

        if (modelo.GastoSocios.Any(aporte =>
                aporte.SocioId == socioId))
            return;

        modelo.GastoSocios.Add(new GastoSocioDTO
        {
            SocioId = socioId,
            Monto = 0m
        });

        LimpiarErroresAportes();
    }

    private void QuitarSocio(GastoSocioDTO aporte)
    {
        if (guardando)
            return;

        modelo.GastoSocios.Remove(aporte);
        LimpiarErroresAportes();
    }

    private string Moneda(decimal importe) => "$ " + importe.ToString("N2", cultura);

    private string NombreSocio(int socioId)
    {
        return socios.FirstOrDefault(socio =>
            socio.Id == socioId)?.Profesional ?? "Socio";
    }

    private bool ValidarAportes()
    {
        erroresAportes.Clear();

        if (modelo.GastoSocios.Count == 0)
        {
            erroresAportes.Add(
                new FieldIdentifier(
                    modelo,
                    nameof(modelo.GastoSocios)),
                "Agregá al menos un socio.");
        }

        foreach (var aporte in modelo.GastoSocios)
        {
            if (aporte.Monto <= 0)
            {
                erroresAportes.Add(
                    new FieldIdentifier(
                        aporte,
                        nameof(aporte.Monto)),
                    "Ingresá un monto mayor a cero.");
            }
        }

        contexto.NotifyValidationStateChanged();

        return !contexto.GetValidationMessages().Any();
    }

    private void LimpiarErroresAportes()
    {
        erroresAportes.Clear();

        contexto.NotifyFieldChanged(
            new FieldIdentifier(
                modelo,
                nameof(modelo.GastoSocios)));

        contexto.NotifyValidationStateChanged();
        mensaje = string.Empty;
    }

    private async Task Guardar()
    {
        if (guardando || leyendoComprobante)
            return;

        mensaje = string.Empty;

        if (!ValidarAportes())
            return;

        guardando = true;
        var registrado = false;

        try
        {
            if (!MostrarAvisoDuplicado && DatosParaDuplicado is { } datos)
            {
                var fecha = datos.Fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                var monto = datos.Monto.ToString(CultureInfo.InvariantCulture);

                var coincidencias = await Http.Get<List<GastoListadoDTO>>(
                    $"api/gasto/posibles-duplicados?fecha={fecha}" +
                    $"&tipoGastoId={datos.TipoGastoId}&monto={monto}");

                if (coincidencias.Error)
                {
                    mensaje = "No se pudo buscar posibles duplicados. Intentá guardar nuevamente.";
                    return;
                }

                if (DatosParaDuplicado != datos)
                {
                    mensaje = "Cambiaste los datos durante la consulta. Volvé a guardar.";
                    return;
                }

                posiblesDuplicados = coincidencias.Respuesta ?? new();
                datosAdvertidos = datos;

                if (posiblesDuplicados.Count > 0)
                    return;
            }

            datosAdvertidos = null;
            posiblesDuplicados.Clear();
            var respuesta =await Http.Post<GastoCrearDTO, int>("api/gasto/insertar",modelo);

            if (respuesta.Error)
            {
                mensaje = respuesta.ObtenerError();
                return;
            }

            registrado = true;
        }
        catch (TaskCanceledException)
        {
            mensaje =
                "No se pudo confirmar el registro a tiempo. " +
                "Verificá si se guardó antes de volver a enviarlo.";
        }
        catch (Exception)
        {
            mensaje =
                "No se pudo confirmar el registro del gasto. " +
                "Verificá la conexión antes de volver a enviarlo.";
        }
        finally
        {
            guardando = false;
        }

        if (registrado)
        {
            await OnGuardado.InvokeAsync();
        }
    }

    private async Task Cerrar()
    {
        if (guardando)
            return;

        await OnCerrar.InvokeAsync();
    }
}