@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http

<div class="historial-overlay" @onclick="Cerrar">
    <section class="historial-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloHistorialGasto"
             @onclick:stopPropagation="true">

        <header class="modal-header">
            <div>
                <h2 id="tituloHistorialGasto">Historial del gasto</h2>
                <p>Consultá las modificaciones y sus motivos.</p>
            </div>

            <button type="button"
                    class="close-button"
                    aria-label="Cerrar historial"
                    @onclick="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        @if (cargando)
        {
            <div class="state-card" role="status">
                <span class="spinner-border spinner-border-sm"></span>
                <p>Cargando historial...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="state-card">
                <i class="bi bi-exclamation-circle state-icon"></i>
                <h3>No se pudo cargar el historial</h3>
                <p role="alert">@mensajeError</p>

                <button type="button"
                        class="secondary-button"
                        @onclick="CargarHistorial">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reintentar
                </button>
            </div>
        }
        else if (historial.Count == 0)
        {
            <div class="state-card">
                <i class="bi bi-clock-history state-icon"></i>
                <h3>Sin modificaciones</h3>
                <p>Este gasto todavía no tiene cambios registrados.</p>
            </div>
        }
        else
        {
            <div class="history-list">
                @foreach (var cambio in historial)
                {
                    var datos = CompararDatos(cambio);
                    var aportes = CompararAportes(cambio);
                    var reparto = CompararReparto(cambio);
                    var comprobantes = CompararComprobantes(cambio);
                    var campos = datos.Select(fila => fila.Dato).ToList();
                    if (aportes.Count > 0)
                        campos.Add("Aportes");
                    if (reparto.Count > 0)
                        campos.Add("Reparto entre socios");

                    if (comprobantes.Count > 0)
                        campos.Add("Comprobantes");

                    var secciones = new[]
                    {
                        (Titulo: "Datos del gasto", Columna: "Dato", Filas: datos),
                        (Titulo: "Aportes por socio", Columna: "Socio", Filas: aportes),
                        (Titulo: "Reparto entre socios", Columna: "Socio", Filas: reparto),
                        (Titulo: "Comprobantes", Columna: "Archivo", Filas: comprobantes)
                    };

                    <details class="history-card" @key="cambio.Id">
                        <summary class="history-toggle">
                            <strong class="history-summary">@(campos.Count > 0 ? string.Join(" · ", campos) : "Sin diferencias visibles")</strong>
                            <span class="history-header">
                                <span class="history-user">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    @cambio.NombreUsuario
                                </span>
                                <span class="history-date">@FechaArgentina(cambio.FechaCambio)</span>
                            </span>
                        </summary>

                        <div class="history-reason">
                            <span>Motivo de la modificación</span>
                            <p>@cambio.Motivo</p>
                        </div>

                        <div class="history-comparison">
                            @foreach (var seccion in secciones.Where(seccion => seccion.Filas.Count > 0))
                            {
                                <h3>@seccion.Titulo</h3>
                                <div class="table-container">
                                    <table class="comparison-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">@seccion.Columna</th>
                                                <th scope="col">Antes</th>
                                                <th scope="col">Después</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var fila in seccion.Filas)
                                            {
                                                <tr class="changed-row">
                                                    <th scope="row">@fila.Dato</th>
                                                    <td>@fila.Antes</td>
                                                    <td>@fila.Despues</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (campos.Count == 0)
                            {
                                <p class="comparison-help">Este registro no contiene diferencias entre los datos comparados.</p>
                            }
                        </div>
                    </details>
                }
            </div>
        }

        <footer class="modal-actions">
            <button type="button"
                    class="secondary-button"
                    @onclick="Cerrar">
                Cerrar
            </button>
        </footer>
    </section>
</div>

@code {
    [Parameter]
    public int GastoId { get; set; }

    [Parameter]
    public EventCallback OnCerrar { get; set; }

    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private readonly TimeZoneInfo zonaArgentina =
        TimeZoneInfo.FindSystemTimeZoneById(
            "America/Argentina/Buenos_Aires");

    private List<GastoHistorialDTO> historial = new();

    private bool cargando = true;
    private bool cargaEnCurso;

    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorial();
    }

    private async Task CargarHistorial()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var respuesta =
                await Http.Get<List<GastoHistorialDTO>>(
                    $"api/gasto/{GastoId}/historial");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError =
                        "No se pudo consultar el historial del gasto.";
                }

                return;
            }

            historial = respuesta.Respuesta ?? new();
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError =
                "No se pudo cargar el historial. Verificá la conexión.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private string FechaArgentina(DateTime fecha)
    {
        var fechaUtc = DateTime.SpecifyKind(
            fecha,
            DateTimeKind.Utc);

        return TimeZoneInfo.ConvertTimeFromUtc(
                fechaUtc,
                zonaArgentina)
            .ToString("dd/MM/yyyy HH:mm", cultura);
    }

    private string Moneda(decimal monto)
    {
        return "$ " + monto.ToString("N2", cultura);
    }

    private static List<(string Dato, string Antes, string Despues)> CompararComprobantes(
        GastoHistorialDTO cambio)
    {
        var filas = new List<(string Dato, string Antes, string Despues)>();

        foreach (var nombre in cambio.DatosAnteriores.ComprobantesModificados ?? new List<string>())
            filas.Add((nombre, "Adjunto", "Quitado"));

        foreach (var nombre in cambio.DatosNuevos.ComprobantesModificados ?? new List<string>())
            filas.Add((nombre, "—", "Agregado"));

        return filas;
    }

    private List<(string Dato, string Antes, string Despues)> CompararDatos(GastoHistorialDTO cambio)
    {
        var anterior = cambio.DatosAnteriores;
        var nuevo = cambio.DatosNuevos;
        var filas = new List<(string Dato, string Antes, string Despues)>();

        if (anterior.Fecha.Date != nuevo.Fecha.Date)
            filas.Add(("Fecha", anterior.Fecha.ToString("dd/MM/yyyy"), nuevo.Fecha.ToString("dd/MM/yyyy")));

        if (anterior.TipoGastoId != nuevo.TipoGastoId || anterior.TipoGasto != nuevo.TipoGasto)
        {
            var mismoNombre = anterior.TipoGasto == nuevo.TipoGasto;
            filas.Add(("Tipo de gasto",
                mismoNombre ? $"{anterior.TipoGasto} (#{anterior.TipoGastoId})" : anterior.TipoGasto,
                mismoNombre ? $"{nuevo.TipoGasto} (#{nuevo.TipoGastoId})" : nuevo.TipoGasto));
        }

        if (anterior.Descripcion != nuevo.Descripcion)
            filas.Add(("Descripción", anterior.Descripcion, nuevo.Descripcion));

        if (anterior.Monto != nuevo.Monto)
            filas.Add(("Monto total", Moneda(anterior.Monto), Moneda(nuevo.Monto)));

        return filas;
    }

    private List<(string Dato, string Antes, string Despues)> CompararAportes(GastoHistorialDTO cambio)
    {
        var filas = new List<(string Dato, string Antes, string Despues)>();
        foreach (var socioId in SocioIds(cambio))
        {
            var anterior = Aporte(cambio.DatosAnteriores, socioId);
            var nuevo = Aporte(cambio.DatosNuevos, socioId);
            if (anterior?.Monto == nuevo?.Monto && anterior?.Profesional == nuevo?.Profesional)
                continue;

            filas.Add(CompararImporteSocio(socioId, anterior?.Profesional, anterior?.Monto,
                nuevo?.Profesional, nuevo?.Monto, "Sin aporte"));
        }
        return filas;
    }

    private List<(string Dato, string Antes, string Despues)> CompararReparto(GastoHistorialDTO cambio)
    {
        var filas = new List<(string Dato, string Antes, string Despues)>();
        foreach (var socioId in SocioIdsReparto(cambio))
        {
            var anterior = ParteReparto(cambio.DatosAnteriores, socioId);
            var nuevo = ParteReparto(cambio.DatosNuevos, socioId);
            if (anterior?.Monto == nuevo?.Monto && anterior?.Profesional == nuevo?.Profesional)
                continue;

            filas.Add(CompararImporteSocio(socioId, anterior?.Profesional, anterior?.Monto,
                nuevo?.Profesional, nuevo?.Monto, "Sin parte registrada"));
        }
        return filas;
    }

    private (string Dato, string Antes, string Despues) CompararImporteSocio(
        int socioId, string? nombreAnterior, decimal? montoAnterior,
        string? nombreNuevo, decimal? montoNuevo, string sinImporte)
    {
        var socio = nombreNuevo ?? nombreAnterior ?? $"Socio #{socioId}";
        var cambioNombre = montoAnterior.HasValue && montoNuevo.HasValue && nombreAnterior != nombreNuevo;

        return (socio,
            montoAnterior is decimal anterior
                ? cambioNombre ? $"{nombreAnterior} · {Moneda(anterior)}" : Moneda(anterior)
                : sinImporte,
            montoNuevo is decimal nuevo
                ? cambioNombre ? $"{nombreNuevo} · {Moneda(nuevo)}" : Moneda(nuevo)
                : sinImporte);
    }

    private static IEnumerable<int> SocioIds(GastoHistorialDTO cambio)
    {
        return cambio.DatosAnteriores.GastoSocios
            .Select(aporte => aporte.SocioId)
            .Union(
                cambio.DatosNuevos.GastoSocios
                    .Select(aporte => aporte.SocioId))
            .OrderBy(id => id);
    }

    private static GastoSocioListadoDTO? Aporte(
        GastoListadoDTO version,
        int socioId)
    {
        return version.GastoSocios.FirstOrDefault(
            aporte => aporte.SocioId == socioId);
    }

    private static IEnumerable<int> SocioIdsReparto(
    GastoHistorialDTO cambio)
    {
        var anteriores = cambio.DatosAnteriores.GastoRepartos
            ?? new List<GastoRepartoListadoDTO>();

        var nuevos = cambio.DatosNuevos.GastoRepartos
            ?? new List<GastoRepartoListadoDTO>();

        return anteriores
            .Select(reparto => reparto.SocioId)
            .Union(
                nuevos.Select(reparto => reparto.SocioId))
            .OrderBy(id => id);
    }

    private static GastoRepartoListadoDTO? ParteReparto(
        GastoListadoDTO version,
        int socioId)
    {
        return version.GastoRepartos?
            .FirstOrDefault(reparto =>
                reparto.SocioId == socioId);
    }



    private async Task Cerrar()
    {
        await OnCerrar.InvokeAsync();
    }
}