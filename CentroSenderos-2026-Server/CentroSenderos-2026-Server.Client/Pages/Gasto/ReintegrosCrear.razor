@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text.Json
@inject IHttpServicio Http

<div class="reintegro-overlay">
    <section class="reintegro-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloReintegro">

        <header class="reintegro-header">
            <div>
                <button type="button"
                        class="reintegro-back"
                        disabled="@guardando"
                        @onclick="Cerrar">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </button>

                <h2 id="tituloReintegro">Registrar reintegro</h2>
                <p>Registrá la devolución de Caja Senderos a un socio.</p>
            </div>

            <button type="button"
                    class="reintegro-close"
                    aria-label="Cerrar"
                    disabled="@guardando"
                    @onclick="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        @if (cargando)
        {
            <p class="reintegro-state" role="status">
                Cargando socios y gastos...
            </p>
        }
        else if (!datosCargados)
        {
            <div class="reintegro-state">
                <p role="alert">@mensaje</p>

                <button type="button"
                        class="reintegro-secondary"
                        @onclick="CargarDatos">
                    Reintentar
                </button>
            </div>
        }
        else
        {
            <EditForm Model="@modelo"
                      OnSubmit="Grabar"
                      FormName="RegistrarReintegro">

                <DataAnnotationsValidator />
                <ValidationSummary class="reintegro-error" />

                @if (gastoPrincipal != null)
                {
                    <div class="reintegro-principal">
                        <span>GASTO PRINCIPAL</span>
                        <strong>@gastoPrincipal.Descripcion</strong>
                        <small>
                            @gastoPrincipal.Fecha.ToString("dd/MM/yyyy")
                            · @gastoPrincipal.TipoGasto
                        </small>
                    </div>

                    <h3>Adelantos de los socios</h3>

                    <div class="reintegro-table-wrap reintegro-resumen">
                        <table class="reintegro-table">
                            <thead>
                                <tr>
                                    <th>Socio</th>
                                    <th>Adelantó</th>
                                    <th>Recibió de Caja</th>
                                    <th>Pendiente</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var socioId in SocioIdsPrincipal)
                                {
                                    var pendiente = PendienteSocio(
                                        gastoPrincipal, socioId);

                                    <tr @key="socioId">
                                        <th scope="row">@NombreSocio(socioId)</th>
                                        <td>@Moneda(Adelantado(gastoPrincipal, socioId))</td>
                                        <td>@Moneda(Recibido(gastoPrincipal, socioId))</td>
                                        <td>
                                            <span class="@(pendiente > 0
                                                ? "reintegro-estado favor"
                                                : "reintegro-estado saldado")">
                                                @(pendiente > 0
                                                    ? Moneda(pendiente)
                                                    : "Reintegrado")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="reintegro-help">
                        Caja Senderos asume el gasto completo.
                        Sus pagos directos no generan un reintegro a favor de Caja.
                    </p>
                }

                <fieldset disabled="@(guardando || guardado || resultadoIncierto)"
                          class="reintegro-fields">

                    <div class="reintegro-grid">
                        <div class="reintegro-field">
                            <label for="reintegroPagador">
                                QUIÉN DEVUELVE EL DINERO
                            </label>

                            <input id="reintegroPagador"
                                   type="text"
                                   value="Caja Senderos"
                                   readonly />

                            <ValidationMessage For="@(() => modelo.SocioPagadorId)" />
                        </div>

                        <div class="reintegro-field">
                            <label for="reintegroReceptor">
                                QUIÉN RECIBE EL DINERO
                            </label>

                            <InputSelect id="reintegroReceptor"
                                         @bind-Value="modelo.SocioReceptorId"
                                         @bind-Value:after="ActualizarGastos">

                                <option value="0">Seleccione un socio</option>

                                @foreach (var socio in ReceptoresDisponibles)
                                {
                                    <option value="@socio.Id">
                                        @NombreSocio(socio.Id) —
                                        @Moneda(PendienteSocio(gastoPrincipal!, socio.Id)) pendiente
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => modelo.SocioReceptorId)" />
                        </div>

                        <div class="reintegro-field">
                            <label for="reintegroFecha">FECHA</label>

                            <InputDate id="reintegroFecha"
                                       @bind-Value="modelo.Fecha"
                                       @bind-Value:after="ActualizarGastos" />

                            <ValidationMessage For="@(() => modelo.Fecha)" />
                        </div>
                    </div>

                    @if (modelo.SocioReceptorId > 0)
                    {
                        <div class="reintegro-transferencia" role="status">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>
                                <strong>Caja Senderos</strong> le reintegra a
                                <strong>@NombreSocio(modelo.SocioReceptorId)</strong>.
                            </span>
                        </div>
                    }

                    <h3>Importe a reintegrar</h3>

                    <p class="reintegro-help">
                        El gasto principal queda seleccionado con el saldo completo.
                        Podés reducir el importe o incluir otros gastos del mismo socio.
                    </p>

                    @if (!ReceptoresDisponibles.Any())
                    {
                        <p class="reintegro-state">
                            No hay socios activos con reintegros pendientes
                            para este gasto.
                        </p>
                    }
                    else if (modelo.SocioReceptorId == 0)
                    {
                        <p class="reintegro-state">
                            Seleccioná el socio que recibe el reintegro.
                        </p>
                    }
                    else if (!filas.Any(fila => fila.Gasto.Id == GastoId))
                    {
                        <p class="reintegro-state">
                            El gasto principal no está disponible para este socio
                            y esta fecha. La devolución no puede ser anterior al gasto.
                        </p>
                    }
                    else
                    {
                        <label class="reintegro-otros">
                            <InputCheckbox @bind-Value="incluirOtros"
                                           @bind-Value:after="CambiarOtros" />
                            Incluir otros gastos pendientes
                        </label>

                        <div class="reintegro-table-wrap">
                            <table class="reintegro-table">
                                <thead>
                                    <tr>
                                        <th>Aplicar</th>
                                        <th>Gasto</th>
                                        <th>Pendiente</th>
                                        <th>Importe a devolver</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var fila in filas.Where(f =>
                                        f.Gasto.Id == GastoId || incluirOtros))
                                    {
                                        <tr @key="fila.Gasto.Id">
                                            <td>
                                                @if (fila.Gasto.Id == GastoId)
                                                {
                                                    <span class="reintegro-principal-label">
                                                        Principal
                                                    </span>
                                                }
                                                else
                                                {
                                                    <InputCheckbox
                                                        @bind-Value="fila.Seleccionado"
                                                        @bind-Value:after="() => CambiarSeleccion(fila)"
                                                        aria-label="@($"Aplicar a {fila.Gasto.Descripcion}")" />
                                                }
                                            </td>

                                            <td>
                                                <strong>@fila.Gasto.Descripcion</strong>
                                                <small>
                                                    @fila.Gasto.Fecha.ToString("dd/MM/yyyy")
                                                    · @fila.Gasto.TipoGasto
                                                </small>
                                            </td>

                                            <td>@Moneda(fila.Disponible)</td>

                                            <td>
                                                <InputNumber
                                                    @bind-Value="fila.Monto"
                                                    disabled="@(!fila.Seleccionado)"
                                                    min="0.01"
                                                    max="@fila.Disponible.ToString(CultureInfo.InvariantCulture)"
                                                    step="0.01"
                                                    aria-label="@($"Importe para {fila.Gasto.Descripcion}")" />

                                                <button type="button"
                                                        class="reintegro-completar"
                                                        disabled="@(!fila.Seleccionado)"
                                                        @onclick="() => CompletarImporte(fila)">
                                                    Usar saldo completo
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="reintegro-total">
                        <span>Total del reintegro</span>
                        <strong>@TotalTexto</strong>
                    </div>

                    <p class="reintegro-help">
                        Podés devolver una parte o todo lo pendiente.
                        Para otro destinatario, registrá otro reintegro.
                    </p>

                    <div class="reintegro-field">
                        <label for="reintegroObservacion">
                            OBSERVACIÓN (OPCIONAL)
                        </label>

                        <InputTextArea id="reintegroObservacion"
                                       @bind-Value="modelo.Observacion"
                                       placeholder="Detalle de la devolución" />
                    </div>
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <p class="reintegro-error" role="alert">@mensaje</p>
                }

                <footer class="reintegro-actions">
                    <button type="button"
                            class="reintegro-secondary"
                            disabled="@guardando"
                            @onclick="Cerrar">
                        @(guardado || resultadoIncierto ? "Cerrar" : "Cancelar")
                    </button>

                    <button type="submit"
                            class="reintegro-primary"
                            disabled="@(guardando || guardado || resultadoIncierto ||
                                !filas.Any(fila => fila.Gasto.Id == GastoId))">
                        @(guardando ? "Guardando..." : "Registrar reintegro")
                    </button>
                </footer>
            </EditForm>
        }
    </section>
</div>

@code {
    [Parameter] public int GastoId { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private ReintegroSocioDTO modelo = new()
    {
        Fecha = DateTime.Today
    };

    private List<SocioListadoDTO> socios = new();
    private List<GastoListadoDTO> gastos = new();
    private List<FilaGasto> filas = new();

    private SocioListadoDTO? caja;
    private GastoListadoDTO? gastoPrincipal;

    private bool incluirOtros;
    private bool cargando;
    private bool datosCargados;
    private bool guardando;
    private bool guardado;
    private bool resultadoIncierto;

    private string mensaje = string.Empty;

    private IEnumerable<int> SocioIdsPrincipal =>
        gastoPrincipal == null || caja == null
            ? Enumerable.Empty<int>()
            : gastoPrincipal.GastoSocios
                .Where(aporte => aporte.SocioId != caja.Id)
                .Select(aporte => aporte.SocioId)
                .Distinct()
                .OrderBy(id => NombreSocio(id));

    private IEnumerable<SocioListadoDTO> ReceptoresDisponibles =>
        socios.Where(socio =>
            !socio.EsCaja &&
            gastoPrincipal != null &&
            PendienteSocio(gastoPrincipal, socio.Id) > 0);

    private string TotalTexto
    {
        get
        {
            try
            {
                return Moneda(filas
                    .Where(fila => fila.Seleccionado)
                    .Sum(fila => fila.Monto));
            }
            catch (OverflowException)
            {
                return "Importe fuera de rango";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        if (cargando || guardando || guardado || resultadoIncierto)
            return;

        cargando = true;
        datosCargados = false;
        mensaje = string.Empty;
        filas = new();
        incluirOtros = false;
        caja = null;
        gastoPrincipal = null;

        modelo = new ReintegroSocioDTO
        {
            Fecha = DateTime.Today
        };

        try
        {
            var respuestaSocios = await Http.Get<List<SocioListadoDTO>>(
                "api/socio/ListaSocio");

            if (respuestaSocios.Error)
            {
                mensaje = respuestaSocios.ObtenerError();
                return;
            }

            if (respuestaSocios.Respuesta == null)
            {
                mensaje = "No se pudo obtener el listado de socios.";
                return;
            }

            socios = respuestaSocios.Respuesta
                .OrderBy(socio => socio.Profesional)
                .ToList();

            caja = socios.SingleOrDefault(socio => socio.EsCaja);

            if (caja == null)
            {
                mensaje = "Caja Senderos no está registrada o está inactiva.";
                return;
            }

            modelo.SocioPagadorId = caja.Id;

            var respuestaGastos = await Http.Get<List<GastoListadoDTO>>(
                "api/gasto/ListaGastos");

            if (respuestaGastos.Error)
            {
                mensaje = respuestaGastos.ObtenerError();
                return;
            }

            if (respuestaGastos.Respuesta == null)
            {
                mensaje = "No se pudo obtener el listado de gastos.";
                return;
            }

            gastos = respuestaGastos.Respuesta;

            gastoPrincipal = gastos.FirstOrDefault(gasto =>
                gasto.Id == GastoId);

            if (gastoPrincipal == null)
            {
                mensaje = "El gasto principal no existe o está dado de baja.";
                return;
            }

            if (!GastoCompatible(gastoPrincipal))
            {
                mensaje =
                    "Este gasto tiene pagos inválidos, un reparto anterior " +
                    "o reintegros del esquema anterior. Debe revisarse " +
                    "antes de registrar una devolución de Caja Senderos.";

                return;
            }

            var receptores = ReceptoresDisponibles.ToList();

            if (receptores.Count == 1)
                modelo.SocioReceptorId = receptores[0].Id;

            ActualizarGastos();
            datosCargados = true;
        }
        catch (Exception)
        {
            mensaje =
                "No se pudieron cargar los datos. " +
                "Verificá la conexión y reintentá.";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool GastoCompatible(GastoListadoDTO gasto)
    {
        return caja != null &&
            gasto.Monto > 0 &&
            gasto.GastoRepartos.Count == 1 &&
            gasto.GastoRepartos[0].SocioId == caja.Id &&
            gasto.GastoRepartos[0].Monto == gasto.Monto &&
            gasto.GastoSocios.All(aporte => aporte.Monto > 0) &&
            gasto.GastoSocios.Sum(aporte => aporte.Monto) == gasto.Monto &&
            gasto.GastoReintegros.All(reintegro =>
                reintegro.SocioPagadorId == caja.Id &&
                reintegro.SocioReceptorId != caja.Id);
    }

    private static decimal Adelantado(GastoListadoDTO gasto, int socioId)
    {
        return gasto.GastoSocios
            .Where(aporte => aporte.SocioId == socioId)
            .Sum(aporte => aporte.Monto);
    }

    private decimal Recibido(GastoListadoDTO gasto, int socioId)
    {
        if (caja == null)
            return 0m;

        return gasto.GastoReintegros
            .Where(reintegro =>
                reintegro.SocioPagadorId == caja.Id &&
                reintegro.SocioReceptorId == socioId)
            .Sum(reintegro => reintegro.Monto);
    }

    private decimal PendienteSocio(GastoListadoDTO gasto, int socioId)
    {
        return Adelantado(gasto, socioId) - Recibido(gasto, socioId);
    }

    private decimal PendienteCaja(GastoListadoDTO gasto)
    {
        if (caja == null)
            return 0m;

        var pagosDirectos = Adelantado(gasto, caja.Id);

        var reintegrado = gasto.GastoReintegros
            .Where(reintegro => reintegro.SocioPagadorId == caja.Id)
            .Sum(reintegro => reintegro.Monto);

        return gasto.Monto - pagosDirectos - reintegrado;
    }

    private void ActualizarGastos()
    {
        mensaje = string.Empty;
        incluirOtros = false;
        filas = new();

        if (caja == null || modelo.SocioReceptorId <= 0 ||
            modelo.SocioReceptorId == caja.Id)
        {
            return;
        }

        modelo.SocioPagadorId = caja.Id;

        filas = gastos
            .Where(gasto =>
                gasto.Fecha.Date <= modelo.Fecha.Date &&
                GastoCompatible(gasto) &&
                PendienteSocio(gasto, modelo.SocioReceptorId) > 0 &&
                PendienteCaja(gasto) > 0)
            .OrderByDescending(gasto => gasto.Id == GastoId)
            .ThenBy(gasto => gasto.Fecha)
            .ThenBy(gasto => gasto.Id)
            .Select(gasto =>
            {
                var disponible = Math.Min(
                    PendienteSocio(gasto, modelo.SocioReceptorId),
                    PendienteCaja(gasto));

                return new FilaGasto
                {
                    Gasto = gasto,
                    Seleccionado = gasto.Id == GastoId,
                    Disponible = disponible,
                    Monto = gasto.Id == GastoId ? disponible : 0m
                };
            })
            .ToList();
    }

    private void CambiarSeleccion(FilaGasto fila)
    {
        fila.Monto = fila.Seleccionado ? fila.Disponible : 0m;
        mensaje = string.Empty;
    }

    private void CambiarOtros()
    {
        if (!incluirOtros)
        {
            foreach (var fila in filas.Where(f => f.Gasto.Id != GastoId))
            {
                fila.Seleccionado = false;
                fila.Monto = 0m;
            }
        }

        mensaje = string.Empty;
    }

    private void CompletarImporte(FilaGasto fila)
    {
        if (guardando || guardado ||
            resultadoIncierto || !fila.Seleccionado)
        {
            return;
        }

        fila.Monto = fila.Disponible;
        mensaje = string.Empty;
    }

    private async Task Grabar(EditContext formulario)
    {
        if (guardando || guardado || resultadoIncierto || !datosCargados)
            return;

        mensaje = string.Empty;

        if (caja == null ||
            !ReceptoresDisponibles.Any(s =>
                s.Id == modelo.SocioReceptorId))
        {
            mensaje = "Seleccioná un socio con un reintegro pendiente.";
            return;
        }

        modelo.SocioPagadorId = caja.Id;

        var seleccionadas = filas
            .Where(fila => fila.Seleccionado)
            .ToList();

        if (!seleccionadas.Any(fila => fila.Gasto.Id == GastoId))
        {
            mensaje = "El reintegro debe incluir el gasto desde el que lo abriste.";
            return;
        }

        if (seleccionadas.Any(fila =>
            fila.Monto <= 0 ||
            fila.Monto > fila.Disponible ||
            decimal.Round(fila.Monto, 2) != fila.Monto))
        {
            mensaje =
                "Cada importe debe ser positivo, tener hasta dos decimales " +
                "y no superar el saldo pendiente.";

            return;
        }

        try
        {
            modelo.Monto = seleccionadas.Sum(fila => fila.Monto);
        }
        catch (OverflowException)
        {
            mensaje = "El total supera el importe permitido.";
            return;
        }

        if (modelo.Monto <= 0 ||
            modelo.Monto > 9999999999999999.99m)
        {
            mensaje = "El monto total no es válido.";
            return;
        }

        if (modelo.Fecha.Date == DateTime.MinValue.Date ||
            seleccionadas.Any(fila =>
                modelo.Fecha.Date < fila.Gasto.Fecha.Date))
        {
            mensaje = "La fecha debe ser válida y no puede ser anterior a los gastos.";
            return;
        }

        modelo.Detalles = seleccionadas
            .Select(fila => new ReintegroSocioDetalleDTO
            {
                GastoId = fila.Gasto.Id,
                Monto = fila.Monto
            })
            .ToList();

        if (!formulario.Validate())
            return;

        guardando = true;

        try
        {
            var respuesta = await Http.Post<ReintegroSocioDTO, int>(
                "api/reintegrosocio/insertar",
                modelo);

            if (respuesta.Error)
            {
                if ((int)respuesta.HttpResponseMessage.StatusCode >= 500)
                {
                    resultadoIncierto = true;
                    mensaje =
                        "No se pudo confirmar el registro. Cerrá y verificá " +
                        "los saldos antes de volver a intentarlo.";

                    return;
                }

                mensaje = respuesta.ObtenerError();

                var contenido = await respuesta.HttpResponseMessage
                    .Content.ReadAsStringAsync();

                try
                {
                    using var documento = JsonDocument.Parse(contenido);

                    if (documento.RootElement.ValueKind == JsonValueKind.Object &&
                        documento.RootElement.TryGetProperty("mensaje", out var detalle) &&
                        detalle.ValueKind == JsonValueKind.String &&
                        !string.IsNullOrWhiteSpace(detalle.GetString()))
                    {
                        mensaje = detalle.GetString()!;
                    }
                }
                catch (JsonException)
                {
                }

                return;
            }

            guardado = true;
            await OnGuardado.InvokeAsync();
        }
        catch (Exception)
        {
            if (guardado)
            {
                mensaje =
                    "El reintegro se registró. Cerrá y recargá el listado " +
                    "para actualizar los saldos.";
            }
            else
            {
                resultadoIncierto = true;
                mensaje =
                    "No se pudo confirmar el registro. Cerrá y verificá " +
                    "los saldos antes de volver a intentarlo.";
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private string NombreSocio(int socioId)
    {
        var socio = socios.FirstOrDefault(s => s.Id == socioId);

        if (socio?.EsCaja == true || caja?.Id == socioId)
            return "Caja Senderos";

        if (!string.IsNullOrWhiteSpace(socio?.Profesional))
            return socio.Profesional;

        var nombre = gastoPrincipal?.GastoSocios
            .FirstOrDefault(aporte => aporte.SocioId == socioId)
            ?.Profesional;

        return string.IsNullOrWhiteSpace(nombre) ? "Socio" : nombre;
    }

   private static string Moneda(decimal monto)
        {
            return "$ " + monto.ToString("N2",CultureInfo.GetCultureInfo("es-AR"));
        }

    private async Task Cerrar()
    {
        if (!guardando)
            await OnCerrar.InvokeAsync();
    }

    private class FilaGasto
    {
        public GastoListadoDTO Gasto { get; set; } = new();
        public decimal Disponible { get; set; }
        public bool Seleccionado { get; set; }
        public decimal Monto { get; set; }
    }
}