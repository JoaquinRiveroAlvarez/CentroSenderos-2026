@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http

<div class="detalle-overlay" @onclick="Cerrar">
    <section class="detalle-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloDetalleGasto"
             @onclick:stopPropagation="true">

        <header class="modal-header">
            <div>
                <h2 id="tituloDetalleGasto">@(ReintegroCaja == null ? "Detalle del gasto" : "Detalle del reintegro")</h2>
                <p>@(ReintegroCaja == null ? "Información del gasto, pagos y reparto entre socios." : "Información del reintegro y gastos asociados.")</p>
            </div>

            <button type="button"
                    class="close-button"
                    aria-label="Cerrar detalle"
                    @onclick="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="detalle-contenido">
            @if (gasto is { Anulado: true } anulado)
            {
                <section class="gasto-anulado-card" aria-labelledby="titulo-gasto-anulado">
                    <header class="gasto-anulado-header">
                        <span class="anulacion-icono" aria-hidden="true"><i class="bi bi-slash-circle"></i></span>
                        <h3 id="titulo-gasto-anulado">Gasto anulado</h3>
                    </header>
                    <dl class="gasto-anulado-datos">
                        @if (anulado.FechaAnulacion is DateTime fecha)
                        {
                            <div>
                                <dt>Fecha y hora</dt>
                                <dd>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(fecha, DateTimeKind.Utc), ZonaArgentina).ToString("dd/MM/yyyy · HH:mm")</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(anulado.UsuarioAnulacion))
                        {
                            <div>
                                <dt>Anulado por</dt>
                                <dd>@anulado.UsuarioAnulacion</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(anulado.MotivoAnulacion))
                        {
                            <div class="gasto-anulado-motivo">
                                <dt>Motivo</dt>
                                <dd>@anulado.MotivoAnulacion</dd>
                            </div>
                        }
                        @if (anulado.ReintegrosRevertidos.Count > 0)
                        {
                            <div class="gasto-anulado-motivo">
                                <dt>Reintegros revertidos</dt>
                                <dd>@NombreMotivoReversion(anulado.MotivoReversion)</dd>
                                @foreach (var reintegro in anulado.ReintegrosRevertidos.OrderBy(r => r.Key))
                                {
                                    <dd>Reintegro #@reintegro.Key · @Moneda(reintegro.Value)</dd>
                                }
                            </div>
                        }
                    </dl>
                </section>
            }
            @if (mostrarAnulacion && gasto is { Anulado: false } && !SoloLectura)
            {
                <section class="anulacion-card" aria-labelledby="titulo-anulacion">
                    <div class="anulacion-encabezado">
                        <span class="anulacion-icono" aria-hidden="true"><i class="bi bi-slash-circle"></i></span>
                        <div>
                            <h3 id="titulo-anulacion">Confirmar anulación</h3>
                            <p>Se conservará el gasto en el historial. Si Caja aportó, se registrará la reversión.</p>
                        </div>
                    </div>
                    @if (gasto.GastoReintegros.Count > 0)
                    {
                        <div class="anulacion-campo">
                            <strong>Reintegros a revertir · @Moneda(gasto.GastoReintegros.Sum(r => r.Monto))</strong>
                            <ul class="anulacion-reintegros">
                                @foreach (var reintegro in gasto.GastoReintegros.GroupBy(r => r.ReintegroSocioId))
                                {
                                    <li>Reintegro #@reintegro.Key · @Moneda(reintegro.Sum(r => r.Monto))</li>
                                }
                            </ul>
                            <label for="motivo-reversion">¿Qué pasó con el dinero?</label>
                            <select id="motivo-reversion" @bind="motivoReversion" disabled="@anulando">
                                <option value="">Elegí una opción</option>
                                <option value="@MotivoReversionReintegro.RegistroErroneo">Se registró por error y Caja no pagó</option>
                                <option value="@MotivoReversionReintegro.DineroDevuelto">El socio ya devolvió todo el importe indicado</option>
                            </select>
                            <small>Si todavía falta devolver dinero, conservá el gasto.</small>
                        </div>
                    }
                    <div class="anulacion-campo">
                        <label for="motivo-anulacion">Motivo de la anulación</label>
                        <textarea id="motivo-anulacion" maxlength="500" rows="3"
                                  placeholder="Escribí por qué anulás este gasto"
                                  aria-describedby="anulacion-ayuda" required
                                  @bind="motivoAnulacion" @bind:event="oninput" disabled="@anulando"></textarea>
                        <small id="anulacion-ayuda">Obligatorio · @motivoAnulacion.Length/500</small>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorAnulacion))
                    {
                        <p class="anulacion-error" role="alert">@errorAnulacion</p>
                    }
                    <div class="anulacion-acciones">
                        <button type="button" class="secondary-button mantener-gasto-button" disabled="@anulando"
                                @onclick="OcultarAnulacion">Conservar gasto</button>
                        <button type="button" class="secondary-button confirmar-anulacion-button"
                                disabled="@(anulando || string.IsNullOrWhiteSpace(motivoAnulacion) || (gasto.GastoReintegros.Count > 0 && !motivoReversion.HasValue))" @onclick="AnularGasto">
                            @(anulando ? "Anulando…" : gasto.GastoReintegros.Count > 0 ? "Anular y revertir reintegros" : "Confirmar anulación")
                        </button>
                    </div>
                </section>
            }
            @if (cargando)
            {
                <div class="state-card" role="status">
                    <span class="spinner-border spinner-border-sm"></span>
                    <p>@(ReintegroCaja == null ? "Cargando gasto…" : "Cargando reintegro…")</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(mensajeError))
            {
                <div class="state-card">
                    <i class="bi bi-exclamation-circle state-icon"></i>
                    <h3>@(ReintegroCaja == null ? "No se pudo cargar el gasto" : "No se pudo cargar el reintegro")</h3>
                    <p role="alert">@mensajeError</p>

                    <button type="button"
                            class="secondary-button"
                            @onclick="CargarDetalle">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reintentar
                    </button>
                </div>
            }
            else if (ReintegroCaja is { } reintegroCaja)
            {
                <section class="detail-section">
                    <h3>Información del reintegro</h3>
                    <dl class="detail-grid">
                        <div class="detail-field">
                            <dt>Fecha</dt>
                            <dd>@reintegroCaja.Fecha.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div class="detail-field">
                            <dt>Número de registro</dt>
                            <dd>#@reintegroCaja.OrigenId</dd>
                        </div>
                        <div class="detail-field">
                            <dt>Pagado por</dt>
                            <dd>Caja Senderos</dd>
                        </div>
                        <div class="detail-field">
                            <dt>Socio receptor</dt>
                            <dd>@reintegroCaja.Referencia</dd>
                        </div>
                    </dl>
                </section>

                <section class="detail-section">
                    <h3>Gastos reintegrados</h3>
                    @if (gastosReintegro.Count == 0)
                    {
                        <p class="empty-aportes">Sin gastos asociados.</p>
                    }
                    else
                    {
                        <div class="aportes-list">
                            @foreach (var item in gastosReintegro)
                            {
                                <div class="aporte-row" @key="item.GastoId">
                                    <button type="button" class="aporte-name aporte-enlace"
                                            @onclick="() => OnVerGasto.InvokeAsync(item.GastoId)">
                                        <i class="bi bi-receipt" aria-hidden="true"></i>
                                        <span>@item.Descripcion</span>
                                    </button>
                                    <strong class="aporte-amount">@Moneda(item.Monto)</strong>
                                    @if (item.Revertido)
                                    {
                                        <span class="badge text-bg-secondary">Revertido</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="total-box">
                        <span>Total reintegrado</span>
                        <strong>@Moneda(-reintegroCaja.Importe)</strong>
                    </div>
                </section>
            }
            else if (gasto != null)
            {
                var cajaId = CajaIdDetalle;
                var compatible = gasto.EsCompatibleConCaja(cajaId);
                var pagadoCaja = PagoSocio(cajaId);
                var adelantado = gasto.GastoSocios.Where(aporte => aporte.SocioId != cajaId)
                    .Sum(aporte => aporte.Monto);
                var reintegrado = gasto.GastoReintegros
                    .Where(item => item.SocioPagadorId == cajaId && item.SocioReceptorId != cajaId)
                    .Sum(item => item.Monto);
                var pendiente = compatible ? -gasto.SaldoSocio(cajaId) : 0m;

                <section class="detail-section" aria-label="Resumen del gasto">
                    <h3 class="gasto-titulo">@gasto.Descripcion</h3>
                    <p class="gasto-fecha-tipo">@gasto.TipoGasto · @gasto.Fecha.ToString("dd/MM/yyyy")</p>

                    <div class="resumen-gasto">
                        <dl class="resumen-importes">
                            <div>
                                <dt>Total del gasto</dt>
                                <dd>@Moneda(gasto.Monto)</dd>
                            </div>
                            <div class="resumen-pendiente">
                                <dt>Pendiente de reintegrar</dt>
                                <dd>@(gasto.Anulado ? "No corresponde" : compatible ? Moneda(pendiente) : "Por revisar")</dd>
                            </div>
                        </dl>

                        @if (cajaId > 0)
                        {
                            <ul class="resumen-desglose" aria-label="Desglose de importes">
                                <li>Caja pagó <strong>@Moneda(pagadoCaja)</strong></li>
                                <li>Los socios adelantaron <strong>@Moneda(adelantado)</strong></li>
                                <li>Caja ya devolvió <strong>@Moneda(reintegrado)</strong></li>
                            </ul>
                        }
                    </div>
                    @if (!compatible)
                    {
                        <p class="reparto-help">
                            @(cajaId > 0
                                ? "Revisá los pagos, el reparto y los reintegros antes de calcular el pendiente."
                                : "Configurá Caja Senderos para calcular el saldo del gasto.")
                        </p>
                    }
                </section>

                <GastoComprobantes @key="GastoId" GastoId="GastoId" EnfocarAlAbrir="IrAComprobantes" />

                <section class="detail-section">
                    <h3>Pagos realizados</h3>

                    @if (gasto.GastoSocios.Count == 0)
                    {
                        <p class="empty-aportes">
                            No hay pagos registrados para este gasto.
                        </p>
                    }
                    else
                    {
                        <div class="aportes-list aportes-lista-simple">
                            @foreach (var aporte in gasto.GastoSocios)
                            {
                                <div class="aporte-row" @key="aporte.SocioId">
                                    <div class="aporte-name">
                                        <i class="bi bi-person"></i>
                                        <span>@aporte.Profesional</span>
                                    </div>

                                    <strong class="aporte-amount">
                                        @Moneda(aporte.Monto)
                                    </strong>
                                </div>
                            }
                        </div>
                    }

                </section>

                <section class="detail-section">
                    <h3>Reintegros registrados</h3>
                    @if (gasto.GastoReintegros.Count == 0)
                    {
                        <p class="empty-aportes">Todavía no hay reintegros registrados.</p>
                    }
                    else
                    {
                        <div class="aportes-list aportes-lista-simple">
                            @foreach (var reintegro in gasto.GastoReintegros.OrderBy(item => item.Fecha).ThenBy(item => item.ReintegroSocioId))
                            {
                                <div class="aporte-row" @key="reintegro.ReintegroSocioId">
                                    <div class="aporte-name">
                                        <i class="bi bi-arrow-left-right"></i>
                                        <span>
                                            @reintegro.Fecha.ToString("dd/MM/yyyy"):
                                            @NombreSocio(reintegro.SocioPagadorId)
                                            → @NombreSocio(reintegro.SocioReceptorId)
                                        </span>
                                    </div>
                                    <strong class="aporte-amount">@Moneda(reintegro.Monto)</strong>
                                </div>
                            }
                        </div>
                        <p class="reparto-help">Importes aplicados a este gasto. Una transferencia puede incluir otros gastos.</p>
                    }
                </section>


                <details class="detail-section reparto-desplegable">
                    <summary>Ver reparto entre socios</summary>

                    @if (gasto.GastoRepartos.Count == 0)
                    {
                        <div class="reparto-pendiente" role="status">
                            <i class="bi bi-info-circle"></i>
                            <p>
                                Este gasto todavía no tiene un reparto registrado.
                                Sus pagos se conservan, pero no se puede calcular
                                el saldo de cada socio.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="reparto-table-container">
                            <table class="reparto-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Socio</th>
                                        <th scope="col" class="reparto-importe">
                                            Pagó
                                        </th>
                                        <th scope="col" class="reparto-importe">
                                            Le corresponde
                                        </th>
                                        <th scope="col" class="reparto-importe">
                                            Pendiente actual
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var socioId in SocioIdsDetalle)
                                    {
                                        var parte = gasto.GastoRepartos
                                            .Where(item => item.SocioId == socioId)
                                            .Sum(item => item.Monto);

                                        var pago = PagoSocio(socioId);
                                        var saldo = gasto.SaldoSocio(socioId);

                                        <tr @key="socioId">
                                            <th scope="row">
                                                @NombreSocio(socioId)
                                            </th>

                                            <td class="reparto-importe">
                                                @Moneda(pago)
                                            </td>

                                            <td class="reparto-importe">
                                                @Moneda(parte)
                                            </td>

                                            <td class="reparto-importe">
                                                <span class="@ClaseSaldo(saldo)">
                                                    @TextoSaldo(saldo)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <p class="reparto-help">
                            El pendiente actual incluye los reintegros registrados.
                            Caja Senderos devuelve a cada socio el importe que adelantó.
                        </p>
                    }
                </details>
            }

        </div>

        <footer class="modal-actions">
            @if (gasto is { Anulado: true, TieneHistorial: true } && OnHistorial.HasDelegate)
            {
                <button type="button" class="secondary-button historial-gasto-button" @onclick="AbrirHistorial">Ver historial</button>
            }
            @if (!SoloLectura && !mostrarAnulacion &&
                 gasto is { Anulado: false } &&
                 !cargando &&
                 string.IsNullOrWhiteSpace(mensajeError))
            {
                @if (PuedeReintegrar)
                {
                    <button type="button"
                            class="secondary-button reintegro-button"
                            @onclick="AbrirReintegro">
                        <i class="bi bi-arrow-left-right"></i>
                        Registrar reintegro
                    </button>
                }

                @if (OnDuplicar.HasDelegate)
                {
                    <button type="button"
                            class="secondary-button duplicar-gasto-button"
                            @onclick="() => OnDuplicar.InvokeAsync(gasto)">
                        <i class="bi bi-copy" aria-hidden="true"></i>
                        Duplicar como borrador
                    </button>
                }

                @if (gasto.TieneHistorial && OnHistorial.HasDelegate)
                {
                    <button type="button"
                            class="secondary-button historial-gasto-button"
                            @onclick="AbrirHistorial">
                        <i class="bi bi-clock-history"></i>
                        Ver historial
                    </button>
                }

                <button type="button"
                        class="secondary-button editar-gasto-button"
                        title="@(gasto.GastoReintegros.Count > 0 ? "Editar descripción y tipo de gasto" : "Editar gasto")"
                        @onclick="AbrirEditar">
                    <i class="bi bi-pencil"></i>
                    Editar
                </button>

                <button type="button" class="secondary-button anular-gasto-button"
                        @onclick="() => mostrarAnulacion = true">
                    <i class="bi bi-slash-circle" aria-hidden="true"></i>
                    Anular gasto
                </button>

                @if (gasto.GastoReintegros.Count > 0)
                {
                    <p class="acciones-ayuda" role="status">
                        Este gasto tiene reintegros: solo se pueden editar la descripción y el tipo de gasto.
                    </p>
                }
            }

            <button type="button"
                    class="secondary-button"
                    @onclick="Cerrar">
                Cerrar
            </button>
        </footer>
    </section>
</div>

@code {
    [Parameter]
    public int GastoId { get; set; }

    [Parameter]
    public bool IrAComprobantes { get; set; }

    [Parameter]
    public MovimientoCajaDTO? ReintegroCaja { get; set; }

    [Parameter]
    public EventCallback<int> OnVerGasto { get; set; }

    private List<GastoMovimientoCajaDTO> gastosReintegro = new();

    [Parameter]
    public EventCallback OnCerrar { get; set; }

    [Parameter]
    public EventCallback<int> OnEditar { get; set; }

    [Parameter]
    public EventCallback<GastoListadoDTO> OnDuplicar { get; set; }

    [Parameter]
    public EventCallback<int> OnHistorial { get; set; }

    [Parameter]
    public int CajaId { get; set; }

    [Parameter]
    public bool SoloLectura { get; set; }

    [Parameter]
    public EventCallback<int> OnReintegro { get; set; }

    private int CajaIdDetalle => CajaId > 0 ? CajaId : gasto?.CajaId ?? 0;

    private bool PuedeReintegrar => gasto != null &&
        gasto.EsCompatibleConCaja(CajaIdDetalle) &&
        SocioIdsDetalle.Any(socioId => gasto.SaldoSocio(socioId) < 0) &&
        SocioIdsDetalle.Any(socioId => gasto.SaldoSocio(socioId) > 0);

    private async Task AbrirReintegro()
    {
        if (PuedeReintegrar)
            await OnReintegro.InvokeAsync(GastoId);
    }

    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    [Parameter]
    public EventCallback OnAnulado { get; set; }

    private static readonly TimeZoneInfo ZonaArgentina =
        TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires");
    private bool mostrarAnulacion;
    private bool anulando;
    private MotivoReversionReintegro? motivoReversion;

    private static string NombreMotivoReversion(MotivoReversionReintegro? motivo) =>
        motivo == MotivoReversionReintegro.DineroDevuelto ? "Dinero devuelto a Caja" : "Registro incorrecto";

    private string motivoAnulacion = string.Empty;
    private string errorAnulacion = string.Empty;

    private void OcultarAnulacion()
    {
        mostrarAnulacion = false;
        motivoReversion = null;
        motivoAnulacion = string.Empty;
        errorAnulacion = string.Empty;
    }

    private async Task AnularGasto()
    {
        if (SoloLectura || gasto is not { Anulado: false } || anulando)
            return;

        anulando = true;
        errorAnulacion = string.Empty;
        try
        {
            var solicitud = new AnularGastoDTO
            {
                Motivo = motivoAnulacion,
                MotivoReversion = motivoReversion,
                ReintegrosConfirmados = gasto.GastoReintegros.GroupBy(r => r.ReintegroSocioId)
                    .ToDictionary(grupo => grupo.Key, grupo => grupo.Sum(r => r.Monto))
            };
            var respuesta = await Http.Post<AnularGastoDTO, RespuestaDTO>($"api/gasto/{GastoId}/anular", solicitud);
            if (respuesta.Error)
            {
                errorAnulacion = respuesta.ObtenerError();
                motivoReversion = null;
                await CargarDetalle();
                return;
            }

            OcultarAnulacion();
            await CargarDetalle();
            await OnAnulado.InvokeAsync();
        }
        catch (Exception)
        {
            errorAnulacion = "No pudimos confirmar la anulación. Volvé a intentar.";
        }
        finally
        {
            anulando = false;
        }
    }

    private GastoListadoDTO? gasto;

    private bool cargando = true;
    private bool cargaEnCurso;

    private string mensajeError = string.Empty;

    private IEnumerable<int> SocioIdsDetalle =>
        gasto == null
            ? Enumerable.Empty<int>()
            : gasto.GastoRepartos
                .Select(reparto => reparto.SocioId)
                .Union(gasto.GastoSocios.Select(aporte => aporte.SocioId));

    protected override async Task OnInitializedAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            if (ReintegroCaja is { } reintegro)
            {
                var respuestaReintegro = await Http.Get<List<GastoMovimientoCajaDTO>>(
                    $"api/caja/reintegros/{reintegro.OrigenId}/gastos");
                if (respuestaReintegro.Error)
                {
                    mensajeError = respuestaReintegro.ObtenerError();
                    if (string.IsNullOrWhiteSpace(mensajeError))
                        mensajeError = "No se pudieron consultar los gastos del reintegro.";
                }
                else
                {
                    gastosReintegro = respuestaReintegro.Respuesta ?? new();
                }

                return;
            }

            var respuesta =
                await Http.Get<GastoListadoDTO>(
                    $"api/gasto/{GastoId}/detalle");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError =
                        "No se pudo consultar el detalle del gasto.";
                }

                return;
            }

            gasto = respuesta.Respuesta;

            if (gasto == null)
            {
                mensajeError =
                    "No se encontraron los datos del gasto.";
            }
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError = ReintegroCaja == null
                ? "No se pudo consultar el detalle del gasto."
                : "No se pudieron consultar los gastos del reintegro.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private decimal PagoSocio(int socioId)
    {
        return gasto?.GastoSocios
            .Where(aporte => aporte.SocioId == socioId)
            .Sum(aporte => aporte.Monto) ?? 0m;
    }

    private string NombreSocio(int socioId)
    {
        if (socioId == CajaIdDetalle && socioId > 0)
            return "Caja Senderos";

        return gasto?.GastoRepartos
            .FirstOrDefault(reparto =>
                reparto.SocioId == socioId)?.Profesional
            ?? gasto?.GastoSocios
                .FirstOrDefault(aporte =>
                    aporte.SocioId == socioId)?.Profesional
            ?? "Socio";
    }

    private string Moneda(decimal monto)
    {
        return "$ " + monto.ToString("N2", cultura);
    }

    private string TextoSaldo(decimal saldo)
    {
        if (saldo < 0)
            return $"Debe {Moneda(-saldo)}";

        if (saldo > 0)
            return $"Tiene {Moneda(saldo)} a favor";

        return "Saldado";
    }

    private static string ClaseSaldo(decimal saldo)
    {
        if (saldo > 0)
            return "reparto-saldo positivo";

        if (saldo < 0)
            return "reparto-saldo negativo";

        return "reparto-saldo neutro";
    }

    private async Task AbrirEditar()
    {
        if (gasto == null)
            return;

        await OnEditar.InvokeAsync(GastoId);
    }

    private async Task AbrirHistorial()
    {
        if (gasto == null || !gasto.TieneHistorial)
            return;

        await OnHistorial.InvokeAsync(GastoId);
    }

    private async Task Cerrar()
    {
        if (!anulando)
            await OnCerrar.InvokeAsync();
    }
}
