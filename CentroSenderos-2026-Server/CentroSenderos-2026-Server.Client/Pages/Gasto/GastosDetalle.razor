@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Servicio.ServiciosHttp
@using System.Globalization

@inject IHttpServicio Http

<div class="detalle-overlay" @onclick="Cerrar">
    <section class="detalle-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloDetalleGasto"
             @onclick:stopPropagation="true">

        <header class="modal-header">
            <div>
                <h2 id="tituloDetalleGasto">Detalle del gasto</h2>
                <p>Información del gasto, pagos y reparto entre socios.</p>
            </div>

            <button type="button"
                    class="close-button"
                    aria-label="Cerrar detalle"
                    @onclick="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="detalle-contenido">
        @if (cargando)
        {
            <div class="state-card" role="status">
                <span class="spinner-border spinner-border-sm"></span>
                <p>Cargando gasto...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="state-card">
                <i class="bi bi-exclamation-circle state-icon"></i>
                <h3>No se pudo cargar el gasto</h3>
                <p role="alert">@mensajeError</p>

                <button type="button"
                        class="secondary-button"
                        @onclick="CargarDetalle">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reintentar
                </button>
            </div>
        }
        else if (gasto != null)
        {
            <section class="detail-section">
                <h3>Información del gasto</h3>

                <dl class="detail-grid">
                    <div class="detail-field">
                        <dt>Tipo de gasto</dt>
                        <dd>@gasto.TipoGasto</dd>
                    </div>

                    <div class="detail-field">
                        <dt>Fecha</dt>
                        <dd>@gasto.Fecha.ToString("dd/MM/yyyy")</dd>
                    </div>

                    <div class="detail-field full-width">
                        <dt>Descripción</dt>
                        <dd class="description">@gasto.Descripcion</dd>
                    </div>
                </dl>
            </section>

            <section class="detail-section">
                <h3>Pagos realizados</h3>

                @if (gasto.GastoSocios.Count == 0)
                {
                    <p class="empty-aportes">
                        No hay pagos registrados para este gasto.
                    </p>
                }
                else
                {
                    <div class="aportes-list">
                        @foreach (var aporte in gasto.GastoSocios)
                        {
                            <div class="aporte-row" @key="aporte.SocioId">
                                <div class="aporte-name">
                                    <i class="bi bi-person"></i>
                                    <span>@aporte.Profesional</span>
                                </div>

                                <strong class="aporte-amount">
                                    @Moneda(aporte.Monto)
                                </strong>
                            </div>
                        }
                    </div>
                }

                <div class="total-box">
                    <span>Monto total</span>
                    <strong>@Moneda(gasto.Monto)</strong>
                </div>
            </section>

            <section class="detail-section">
                <h3>Reparto entre socios</h3>

                @if (gasto.GastoRepartos.Count == 0)
                {
                    <div class="reparto-pendiente" role="status">
                        <i class="bi bi-info-circle"></i>
                        <p>
                            Este gasto todavía no tiene un reparto registrado.
                            Sus pagos se conservan, pero no se puede calcular
                            el saldo de cada socio.
                        </p>
                    </div>
                }
                else
                {
                    <div class="reparto-table-container">
                        <table class="reparto-table">
                            <thead>
                                <tr>
                                    <th scope="col">Socio</th>
                                    <th scope="col" class="reparto-importe">
                                        Pagó
                                    </th>
                                    <th scope="col" class="reparto-importe">
                                        Le corresponde
                                    </th>
                                    <th scope="col" class="reparto-importe">
                                        Pendiente actual
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var socioId in SocioIdsDetalle)
                                {
                                    var reparto = gasto.GastoRepartos
                                        .FirstOrDefault(item =>
                                            item.SocioId == socioId);

                                    var pago = PagoSocio(socioId);
                                    var parte = reparto?.Monto ?? 0m;
                                    var saldo = gasto.SaldoSocio(socioId);

                                    <tr @key="socioId">
                                        <th scope="row">
                                            @NombreSocio(socioId)
                                        </th>

                                        <td class="reparto-importe">
                                            @Moneda(pago)
                                        </td>

                                        <td class="reparto-importe">
                                            @Moneda(parte)
                                        </td>

                                        <td class="reparto-importe">
                                            <span class="@ClaseSaldo(saldo)">
                                                @TextoSaldo(saldo)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="reparto-help">
                        El pendiente actual incluye los reintegros registrados.
                        Si varias personas deben devolver dinero, registrá
                        un reintegro por cada pagador y destinatario.
                    </p>
                }
            </section>
        }

        @if (gasto != null && !cargando && string.IsNullOrWhiteSpace(mensajeError) && gasto.GastoReintegros.Count > 0)
        {
            <section class="detail-section">
                <h3>Reintegros registrados</h3>
                <div class="aportes-list">
                    @foreach (var reintegro in gasto.GastoReintegros.OrderByDescending(item => item.Fecha).ThenByDescending(item => item.ReintegroSocioId))
                    {
                        <div class="aporte-row" @key="reintegro.ReintegroSocioId">
                            <div class="aporte-name">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>
                                    @reintegro.Fecha.ToString("dd/MM/yyyy"):
                                    @NombreSocio(reintegro.SocioPagadorId)
                                    → @NombreSocio(reintegro.SocioReceptorId)
                                </span>
                            </div>
                            <strong class="aporte-amount">@Moneda(reintegro.Monto)</strong>
                        </div>
                    }
                </div>
                <p class="reparto-help">Importes aplicados a este gasto. Una transferencia puede incluir otros gastos.</p>
            </section>
        }

        </div>

        <footer class="modal-actions">
            @if (gasto != null &&
                 !cargando &&
                 string.IsNullOrWhiteSpace(mensajeError))
            {
                @if (PuedeReintegrar)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="AbrirReintegro">
                        <i class="bi bi-arrow-left-right"></i>
                        Registrar reintegro
                    </button>
                }

                @if (gasto.TieneHistorial)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="AbrirHistorial">
                        <i class="bi bi-clock-history"></i>
                        Ver historial
                    </button>
                }

                <button type="button"
                        class="secondary-button"
                        title="@(gasto.GastoReintegros.Count > 0 ? "Editar descripción y tipo de gasto" : "Editar gasto")"
                        @onclick="AbrirEditar">
                    <i class="bi bi-pencil"></i>
                    Editar
                </button>

                @if (gasto.GastoReintegros.Count > 0)
                {
                    <p class="acciones-ayuda" role="status">
                        Este gasto tiene reintegros: solo se pueden editar la descripción y el tipo de gasto.
                    </p>
                }
            }

            <button type="button"
                    class="secondary-button"
                    @onclick="Cerrar">
                Cerrar
            </button>
        </footer>
    </section>
</div>

@code {
    [Parameter]
    public int GastoId { get; set; }

    [Parameter]
    public EventCallback OnCerrar { get; set; }

    [Parameter]
    public EventCallback<int> OnEditar { get; set; }

    [Parameter]
    public EventCallback<int> OnHistorial { get; set; }

    [Parameter]
    public EventCallback<int> OnReintegro { get; set; }

    private bool PuedeReintegrar => gasto != null &&
        gasto.GastoRepartos.Count > 0 &&
        gasto.GastoRepartos.Sum(parte => parte.Monto) == gasto.Monto &&
        gasto.GastoSocios.Sum(aporte => aporte.Monto) == gasto.Monto &&
        SocioIdsDetalle.Any(socioId => gasto.SaldoSocio(socioId) < 0) &&
        SocioIdsDetalle.Any(socioId => gasto.SaldoSocio(socioId) > 0);

    private async Task AbrirReintegro()
    {
        if (PuedeReintegrar)
            await OnReintegro.InvokeAsync(GastoId);
    }

    private readonly CultureInfo cultura =
        CultureInfo.GetCultureInfo("es-AR");

    private GastoListadoDTO? gasto;

    private bool cargando = true;
    private bool cargaEnCurso;

    private string mensajeError = string.Empty;

    private IEnumerable<int> SocioIdsDetalle =>
        gasto == null
            ? Enumerable.Empty<int>()
            : gasto.GastoRepartos
                .Select(reparto => reparto.SocioId)
                .Union(
                    gasto.GastoSocios.Select(aporte => aporte.SocioId))
                .OrderBy(id => id);

    protected override async Task OnInitializedAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        if (cargaEnCurso)
            return;

        cargaEnCurso = true;
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var respuesta =
                await Http.Get<GastoListadoDTO>(
                    $"api/gasto/{GastoId}/detalle");

            if (respuesta.Error)
            {
                mensajeError = respuesta.ObtenerError();

                if (string.IsNullOrWhiteSpace(mensajeError))
                {
                    mensajeError =
                        "No se pudo consultar el detalle del gasto.";
                }

                return;
            }

            gasto = respuesta.Respuesta;

            if (gasto == null)
            {
                mensajeError =
                    "No se encontraron los datos del gasto.";
            }
        }
        catch (TaskCanceledException)
        {
            mensajeError =
                "La consulta tardó demasiado. Volvé a intentarlo.";
        }
        catch (Exception)
        {
            mensajeError =
                "No se pudo cargar el gasto. Verificá la conexión.";
        }
        finally
        {
            cargando = false;
            cargaEnCurso = false;
        }
    }

    private decimal PagoSocio(int socioId)
    {
        return gasto?.GastoSocios
            .Where(aporte => aporte.SocioId == socioId)
            .Sum(aporte => aporte.Monto) ?? 0m;
    }

    private string NombreSocio(int socioId)
    {
        return gasto?.GastoRepartos
            .FirstOrDefault(reparto =>
                reparto.SocioId == socioId)?.Profesional
            ?? gasto?.GastoSocios
                .FirstOrDefault(aporte =>
                    aporte.SocioId == socioId)?.Profesional
            ?? "Socio";
    }

    private string Moneda(decimal monto)
        {
            return "$ " + monto.ToString("N2", cultura);
        }

    private string TextoSaldo(decimal saldo)
    {
        if (saldo < 0)
            return $"Debe {Moneda(-saldo)}";

        if (saldo > 0)
            return $"Tiene {Moneda(saldo)} a favor";

        return "Saldado";
    }

    private static string ClaseSaldo(decimal saldo)
    {
        if (saldo > 0)
            return "reparto-saldo positivo";

        if (saldo < 0)
            return "reparto-saldo negativo";

        return "reparto-saldo neutro";
    }

    private async Task AbrirEditar()
    {
        if (gasto == null)
            return;

        await OnEditar.InvokeAsync(GastoId);
    }

    private async Task AbrirHistorial()
    {
        if (gasto == null || !gasto.TieneHistorial)
            return;

        await OnHistorial.InvokeAsync(GastoId);
    }

    private async Task Cerrar()
    {
        await OnCerrar.InvokeAsync();
    }
}
