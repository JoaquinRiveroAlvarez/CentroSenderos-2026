@page "/tipodocumento"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using CentroSenderos_2026_Shared.DTO
@using Microsoft.AspNetCore.Authorization
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="documentos-page" inert="@(vista != Vista.Ninguna)">
    <div class="page-header">
        <div>

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de documento</h1>
            <p>Administrá los tipos de documentos que se pueden cargar a los pacientes.</p>
        </div>

        <button type="button" class="new-button" @onclick="AbrirCrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo tipo</span>
        </button>
    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar tipos de documento" Placeholder="Buscar por nombre o descripción..." />

    @if (Estado == "eliminado")
    {
        <div class="success-message" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>Tipo de documento eliminado correctamente.</span>
        </div>
    }

    @if (cargando)
    {
        <div class="state-card">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <p>Cargando tipos de documento...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(MensajeCarga))
    {
        <div class="state-card">
            <i class="bi bi-exclamation-circle"></i>
            <h2>No pudimos cargar los tipos de documento</h2>
            <p>@MensajeCarga</p>

            <button type="button" class="retry-button" @onclick="Cargar">
                Reintentar
            </button>
        </div>
    }
    else if (lista.Count == 0)
    {
        <div class="state-card">
            <i class="bi bi-file-earmark-text"></i>
            <h2>No hay tipos de documento registrados</h2>
            <p>Creá el primero para organizar los documentos de los pacientes.</p>
            <button type="button" class="new-button" @onclick="AbrirCrear">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Nuevo tipo</span>
            </button>
        </div>
    }
    else if (!DocumentosFiltrados.Any())
    {
        <div class="state-card">
            <i class="bi bi-search"></i>
            <h2>No encontramos coincidencias</h2>
            <p>Probá con otro nombre o descripción.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <span>Tipo de documento</span>
                <span>Descripción</span>
                <span aria-hidden="true"></span>
            </div>

            @foreach (var item in DocumentosFiltrados)
            {
                <div class="documento-row" style="position: relative" @key="item.Id">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />
                    <div class="documento-name">
                        <i class="bi bi-file-earmark-text"></i>
                        <strong>@item.Tipo</strong>
                    </div>

                    <div class="documento-description">
                        @(string.IsNullOrWhiteSpace(item.Descripcion)
                            ? "Sin descripción"
                            : item.Descripcion)
                    </div>

                    <div class="documento-actions" aria-hidden="true"></div>
                </div>
            }

            <div class="list-footer">
                Mostrando @DocumentosFiltrados.Count() de @lista.Count tipos de documento
            </div>
        </div>
    }
</div>

@if (vista == Vista.Detalle)
{
    <ModalAdministracion Icono="bi-file-earmark-text" Titulo="Detalle de tipo de documento" CerrarAlTocarFondo="true"
                         Ocupado="@ocupado" Inactivo="@confirmarEliminar" AlCerrar="CerrarModal">
        <div class="administracion-cuerpo">
            @if (ocupado)
            {
                <p role="status">Cargando tipo de documento…</p>
            }
            else if (modelo is not null)
            {
                <dl class="administracion-campo"><dt>Nombre</dt><dd>@modelo.Tipo</dd></dl>
                <dl class="administracion-campo"><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(modelo.Descripcion) ? "Sin descripción" : modelo.Descripcion)</dd></dl>
            }
            @if (!string.IsNullOrWhiteSpace(mensajeModal))
            {
                <AvisoSenderos Mensaje="@mensajeModal" />
            }
        </div>
        @if (!ocupado)
        {
            <footer class="administracion-acciones">
                @if (modelo is not null)
                {
                    <button type="button" class="administracion-eliminar" @onclick="() => confirmarEliminar = true">Eliminar</button>
                }
                <button type="button" @onclick="CerrarModal">Cerrar</button>
                @if (modelo is not null)
                {
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                }
            </footer>
        }
    </ModalAdministracion>
}

@if ((vista is Vista.Crear or Vista.Editar) && modelo is not null)
{
    var editando = vista == Vista.Editar;
    <ModalAdministracion Icono="bi-file-earmark-text" Titulo="@(editando ? "Editar tipo de documento" : "Nuevo tipo de documento")"
                         Ocupado="@ocupado" Inactivo="@confirmarDescarte" AlCerrar="SolicitarCerrar">
        <EditForm Model="@modelo" OnValidSubmit="Guardar" class="administracion-formulario">
            <DataAnnotationsValidator />
            <div class="administracion-cuerpo">
                <ValidationSummary />
                <div class="administracion-campo">
                    <label for="administracion-tipodocumento-nombre">Nombre</label>
                    <InputText id="administracion-tipodocumento-nombre" @bind-Value="modelo.Tipo" disabled="@ocupado" />
                    <ValidationMessage For="@(() => modelo!.Tipo)" />
                </div>
                <div class="administracion-campo">
                    <label for="administracion-tipodocumento-descripcion">Descripción</label>
                    <InputTextArea id="administracion-tipodocumento-descripcion" @bind-Value="modelo.Descripcion" disabled="@ocupado" />
                    <ValidationMessage For="@(() => modelo!.Descripcion)" />
                </div>
                @if (!string.IsNullOrWhiteSpace(mensajeModal))
                {
                    <AvisoSenderos Mensaje="@mensajeModal" />
                }
            </div>
            <footer class="administracion-acciones">
                <button type="button" disabled="@ocupado" @onclick="SolicitarCerrar">Cancelar</button>
                <button type="submit" class="administracion-primario" disabled="@ocupado">
                    @(ocupado ? "Guardando…" : editando ? "Guardar cambios" : "Guardar")
                </button>
            </footer>
        </EditForm>
    </ModalAdministracion>
}

@if (confirmarEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar el tipo de documento?" Ocupado="@ocupado" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>El tipo de documento <strong>@modelo?.Tipo</strong> dejará de estar disponible.</p>
            @if (!string.IsNullOrWhiteSpace(mensajeModal))
            {
                <AvisoSenderos Mensaje="@mensajeModal" />
            }
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@ocupado" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@ocupado" @onclick="Eliminar">
                @(ocupado ? "Eliminando…" : "Eliminar")
            </button>
        </footer>
    </ModalAdministracion>
}

@if (confirmarDescarte)
{
    <ConfirmacionDescarte OnContinuar="() => confirmarDescarte = false" OnDescartar="DescartarCambios" />
}

@code {
    private enum Vista { Ninguna, Crear, Editar, Detalle }
    private Vista vista;
    private TipoDocumentoDTO? modelo;
    private (string? Tipo, string? Descripcion) estadoInicial;
    private int idSeleccionado;
    private bool ocupado;
    private bool confirmarDescarte;
    private bool confirmarEliminar;
    private string mensajeModal = string.Empty;
    private string resultadoLocal = string.Empty;

    private void AbrirCrear()
    {
        resultadoLocal = string.Empty;
        PrepararFormulario(new TipoDocumentoDTO { Tipo = string.Empty, Descripcion = string.Empty }, Vista.Crear);
    }

    private void AbrirEditar()
    {
        if (modelo is not null)
            PrepararFormulario(modelo, Vista.Editar);
    }

    private void PrepararFormulario(TipoDocumentoDTO datos, Vista destino)
    {
        modelo = datos;
        estadoInicial = (datos.Tipo, datos.Descripcion);
        mensajeModal = string.Empty;
        vista = destino;
    }

    private async Task AbrirDetalle(int id)
    {
        idSeleccionado = id;
        vista = Vista.Detalle;
        modelo = null;
        mensajeModal = string.Empty;
        ocupado = true;

        try
        {
            var respuesta = await Http.Get<TipoDocumentoDTO>($"api/tipodocumento/{id}");
            modelo = respuesta.Error ? null : respuesta.Respuesta;
            if (modelo is null)
                mensajeModal = respuesta.Error ? respuesta.ObtenerError() : "No se encontró el tipo de documento.";
        }
        catch
        {
            mensajeModal = "No pudimos consultar el tipo de documento. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private void SolicitarCerrar()
    {
        if (ocupado)
            return;

        if (modelo is not null && estadoInicial != (modelo.Tipo, modelo.Descripcion))
        {
            confirmarDescarte = true;
            return;
        }

        DescartarCambios();
    }

    private void DescartarCambios()
    {
        confirmarDescarte = false;
        if (vista == Vista.Editar && modelo is not null)
        {
            modelo.Tipo = estadoInicial.Tipo ?? string.Empty;
            modelo.Descripcion = estadoInicial.Descripcion ?? string.Empty;
            mensajeModal = string.Empty;
            vista = Vista.Detalle;
            return;
        }

        CerrarModal();
    }

    private void CerrarModal()
    {
        if (ocupado || confirmarEliminar)
            return;

        vista = Vista.Ninguna;
        modelo = null;
        mensajeModal = string.Empty;
    }

    private async Task Guardar()
    {
        if (ocupado || modelo is null)
            return;

        var editando = vista == Vista.Editar;
        ocupado = true;
        mensajeModal = string.Empty;

        try
        {
            if (editando)
            {
                var respuesta = await Http.Put<TipoDocumentoDTO, RespuestaDTO>($"api/tipodocumento/{idSeleccionado}", modelo);
                if (respuesta.Error)
                {
                    mensajeModal = respuesta.ObtenerError();
                    return;
                }
            }
            else
            {
                var respuesta = await Http.Post<TipoDocumentoDTO, int>("api/tipodocumento", modelo);
                if (respuesta.Error)
                {
                    mensajeModal = respuesta.ObtenerError();
                    return;
                }
            }

            vista = editando ? Vista.Detalle : Vista.Ninguna;
            resultadoLocal = editando ? "actualizado" : "creado";
            await Cargar();
        }
        catch
        {
            mensajeModal = "No pudimos guardar el tipo de documento. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        confirmarEliminar = false;
        mensajeModal = string.Empty;
    }

    private async Task Eliminar()
    {
        if (ocupado)
            return;

        ocupado = true;
        mensajeModal = string.Empty;

        try
        {
            var respuesta = await Http.Delete($"api/tipodocumento/{idSeleccionado}");
            if (respuesta.Error)
            {
                mensajeModal = respuesta.ObtenerError();
                return;
            }

            confirmarEliminar = false;
            vista = Vista.Ninguna;
            modelo = null;
            resultadoLocal = "eliminado";
            await Cargar();
        }
        catch
        {
            mensajeModal = "No pudimos eliminar el tipo de documento. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    private List<TipoDocumentoDTO> lista = new();
    private string textoBusqueda = string.Empty;
    private string MensajeCarga = string.Empty;
    private bool cargando = true;

    private IEnumerable<TipoDocumentoDTO> DocumentosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? lista
            : lista.Where(item =>
                FiltrosEntidades.ContieneTexto(item.Tipo, textoBusqueda) ||
                FiltrosEntidades.ContieneTexto(item.Descripcion, textoBusqueda));

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender || Estado != "eliminado")
        return;

    await Task.Delay(5000);

    // Evita volver al listado si la persona ya navegó a otra página.
    if (Nav.ToBaseRelativePath(Nav.Uri) == "tipodocumento?estado=eliminado")
    {
        Nav.NavigateTo("/tipodocumento", replace: true);
    }
}

    private async Task Cargar()
    {
        cargando = true;
        MensajeCarga = string.Empty;

        var respuesta = await Http.Get<List<TipoDocumentoDTO>>(
            "api/tipodocumento/ListaTipoDocumentos");

        if (respuesta.Error)
        {
            lista = new();

            var error = respuesta.ObtenerError();

            // El endpoint actual devuelve 404 si aún no hay tipos registrados.
            if (!error.Contains(
                    "No hay tipos de documentos registrados",
                    StringComparison.OrdinalIgnoreCase))
            {
                MensajeCarga = error;
            }
        }
        else
        {
            lista = respuesta.Respuesta ?? new();
        }

        cargando = false;
    }


    private void Volver() => Nav.NavigateTo("/admin");
}