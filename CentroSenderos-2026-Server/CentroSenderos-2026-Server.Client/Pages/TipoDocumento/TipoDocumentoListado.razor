@page "/tipodocumento"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using CentroSenderos_2026_Shared.DTO
@using Microsoft.AspNetCore.Authorization
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="documentos-page" inert="@(seleccionado is not null)">
    <div class="page-header">
        <div>

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de documento</h1>
            <p>Administrá los tipos de documentos que se pueden cargar a los pacientes.</p>
        </div>

        <button type="button" class="new-button" @onclick="IrACrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo tipo</span>
        </button>
    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar tipos de documento" Placeholder="Buscar por nombre o descripción..." />

    @if (Estado == "eliminado")
    {
        <div class="success-message" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>Tipo de documento eliminado correctamente.</span>
        </div>
    }

    @if (cargando)
    {
        <div class="state-card">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <p>Cargando tipos de documento...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(MensajeCarga))
    {
        <div class="state-card">
            <i class="bi bi-exclamation-circle"></i>
            <h2>No pudimos cargar los tipos de documento</h2>
            <p>@MensajeCarga</p>

            <button type="button" class="retry-button" @onclick="Cargar">
                Reintentar
            </button>
        </div>
    }
    else if (lista.Count == 0)
    {
        <div class="state-card">
            <i class="bi bi-file-earmark-text"></i>
            <h2>No hay tipos de documento registrados</h2>
            <p>Creá el primero para organizar los documentos de los pacientes.</p>
        </div>
    }
    else if (!DocumentosFiltrados.Any())
    {
        <div class="state-card">
            <i class="bi bi-search"></i>
            <h2>Sin resultados</h2>
            <p>Probá con otro nombre o descripción.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <span>Tipo de documento</span>
                <span>Descripción</span>
                <span aria-hidden="true"></span>
            </div>

            @foreach (var item in DocumentosFiltrados)
            {
                <div class="documento-row" style="position: relative" @key="item.Id">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => SeleccionarDetalle(item)" />
                    <div class="documento-name">
                        <i class="bi bi-file-earmark-text"></i>
                        <strong>@item.Tipo</strong>
                    </div>

                    <div class="documento-description">
                        @(string.IsNullOrWhiteSpace(item.Descripcion)
                            ? "Sin descripción"
                            : item.Descripcion)
                    </div>

                    <div class="documento-actions" aria-hidden="true"></div>
                </div>
            }

            <div class="list-footer">
                Mostrando @DocumentosFiltrados.Count() de @lista.Count tipos de documento
            </div>
        </div>
    }
</div>

@if (seleccionado is { } detalle)
{
    <ModalAdministracion Titulo="Detalle de tipo de documento"
                         CerrarAlTocarFondo="true" AlCerrar="CerrarDetalle">
        <div class="administracion-cuerpo">
            <dl class="administracion-campo">
                <dt>Nombre</dt>
                <dd>@detalle.Tipo</dd>
            </dl>
            <dl class="administracion-campo">
                <dt>Descripción</dt>
                <dd>@(string.IsNullOrWhiteSpace(detalle.Descripcion) ? "Sin descripción" : detalle.Descripcion)</dd>
            </dl>
        </div>
        <footer class="administracion-acciones">
            <button type="button" @onclick="CerrarDetalle">Cerrar</button>
            <button type="button" class="administracion-primario" @onclick="() => IrAEditar(detalle.Id)">Editar</button>
        </footer>
    </ModalAdministracion>
}

@code {
    private TipoDocumentoDTO? seleccionado;

    private void SeleccionarDetalle(TipoDocumentoDTO item) => seleccionado = item;

    private void CerrarDetalle() => seleccionado = null;

    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    private List<TipoDocumentoDTO> lista = new();
    private string textoBusqueda = string.Empty;
    private string MensajeCarga = string.Empty;
    private bool cargando = true;

    private IEnumerable<TipoDocumentoDTO> DocumentosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? lista
            : lista.Where(item =>
                FiltrosEntidades.ContieneTexto(item.Tipo, textoBusqueda) ||
                FiltrosEntidades.ContieneTexto(item.Descripcion, textoBusqueda));

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender || Estado != "eliminado")
        return;

    await Task.Delay(5000);

    // Evita volver al listado si la persona ya navegó a otra página.
    if (Nav.ToBaseRelativePath(Nav.Uri) == "tipodocumento?estado=eliminado")
    {
        Nav.NavigateTo("/tipodocumento", replace: true);
    }
}

    private async Task Cargar()
    {
        cargando = true;
        MensajeCarga = string.Empty;

        var respuesta = await Http.Get<List<TipoDocumentoDTO>>(
            "api/tipodocumento/ListaTipoDocumentos");

        if (respuesta.Error)
        {
            lista = new();

            var error = respuesta.ObtenerError();

            // El endpoint actual devuelve 404 si aún no hay tipos registrados.
            if (!error.Contains(
                    "No hay tipos de documentos registrados",
                    StringComparison.OrdinalIgnoreCase))
            {
                MensajeCarga = error;
            }
        }
        else
        {
            lista = respuesta.Respuesta ?? new();
        }

        cargando = false;
    }

    private void IrACrear() =>
        Nav.NavigateTo("/tipodocumento/crear");

    private void IrAEditar(int id) =>
        Nav.NavigateTo($"/tipodocumento/editar/{id}");

    private void Volver() => Nav.NavigateTo("/admin");
}