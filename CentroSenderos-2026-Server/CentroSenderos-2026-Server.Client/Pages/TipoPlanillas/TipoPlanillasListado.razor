@page "/tipoplanillas"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="planillas-page">
    <div class="page-header">
        <div>
            <h1>Tipos de planilla</h1>
            <p>Administrá las categorías de planillas de Centro Senderos.</p>
        </div>

        <button type="button" class="new-button" @onclick="IrACrear">
            <i class="bi bi-plus-lg"></i>
            Nuevo tipo
        </button>
    </div>

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="search"
               aria-label="Buscar tipos de planilla"
               placeholder="Buscar por nombre o descripción..."
               @bind="busqueda"
               @bind:event="oninput" />
    </div>

    @if (cargando)
    {
        <div class="state-card">Cargando tipos de planilla...</div>
    }
    else if (lista.Count == 0)
    {
        <div class="state-card">
            <i class="bi bi-file-earmark-text"></i>
            <h2>No hay tipos de planilla registrados</h2>
            <p>Creá el primero para comenzar a organizarlos.</p>
        </div>
    }
    else if (!TiposFiltrados.Any())
    {
        <div class="state-card">
            <i class="bi bi-search"></i>
            <h2>Sin resultados</h2>
            <p>Probá con otro nombre o descripción.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <span>Tipo de planilla</span>
                <span>Descripción</span>
                <span class="actions-heading">Acción</span>
            </div>

            @foreach (var item in TiposFiltrados)
            {
                <div class="planilla-row" @key="item.Id">
                    <div class="planilla-name">
                        <i class="bi bi-file-earmark-text"></i>
                        <strong>@item.Tipo</strong>
                    </div>

                    <div class="planilla-description">
                        @(string.IsNullOrWhiteSpace(item.Descripcion)
                            ? "Sin descripción"
                            : item.Descripcion)
                    </div>

                    <div class="planilla-actions">
                        <button type="button"
                                class="edit-button"
                                aria-label="@($"Editar {item.Tipo}")"
                                @onclick="() => IrAEditar(item.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="list-footer">
                Mostrando @TiposFiltrados.Count() de @lista.Count tipos de planilla
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="error-message" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            @Mensaje
        </div>
    }
</div>

@code {
    private List<TipoListadoDTO> lista = new();
    private bool cargando = true;
    private string Mensaje = string.Empty;
    private string busqueda = string.Empty;

    private IEnumerable<TipoListadoDTO> TiposFiltrados =>
        string.IsNullOrWhiteSpace(busqueda)
            ? lista
            : lista.Where(x =>
                (x.Tipo?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Descripcion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var resp = await Http.Get<List<TipoListadoDTO>>(
            "api/tipoplanillas/ListaTipoPlanillas");

        lista = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : string.Empty;
        cargando = false;
    }

    private void IrACrear() => Nav.NavigateTo("/tipoplanillas/crear");

    private void IrAEditar(int id) =>
        Nav.NavigateTo($"/tipoplanillas/editar/{id}");
}