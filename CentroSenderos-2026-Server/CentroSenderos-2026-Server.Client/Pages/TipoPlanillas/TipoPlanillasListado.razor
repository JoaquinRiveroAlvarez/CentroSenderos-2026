@page "/tipoplanillas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="planillas-page" inert="@(vista != Vista.Ninguna)">
    <div class="page-header">
        <div>

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de planilla</h1>
            <p>Administrá las categorías de planillas de Centro Senderos.</p>
        </div>

        <button type="button" class="new-button" @onclick="AbrirCrear">
            <i class="bi bi-plus-lg"></i>
            Nuevo tipo
        </button>
    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="busqueda" Etiqueta="Buscar tipos de planilla" Placeholder="Buscar por nombre o descripción..." />

    @if (cargando)
    {
        <div class="state-card">Cargando tipos de planilla...</div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="state-card">
            <i class="bi bi-file-earmark-text"></i>
            <h2>No hay tipos de planilla registrados</h2>
            <p>Creá el primero para comenzar a organizarlos.</p>
            <button type="button" class="new-button" @onclick="AbrirCrear">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Nuevo tipo</span>
            </button>
        </div>
    }
    else if (lista.Count > 0 && !TiposFiltrados.Any())
    {
        <div class="state-card">
            <i class="bi bi-search"></i>
            <h2>Sin resultados</h2>
            <p>Probá con otro nombre o descripción.</p>
        </div>
    }
    else if (lista.Count > 0)
    {
        <div class="list-card">
            <div class="list-header">
                <span>Tipo de planilla</span>
                <span>Descripción</span>
                <span aria-hidden="true"></span>
            </div>

            @foreach (var item in TiposFiltrados)
            {
                <div class="planilla-row" style="position: relative" @key="item.Id">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />
                    <div class="planilla-name">
                        <i class="bi bi-file-earmark-text"></i>
                        <strong>@item.Tipo</strong>
                    </div>

                    <div class="planilla-description">
                        @(string.IsNullOrWhiteSpace(item.Descripcion)
                            ? "Sin descripción"
                            : item.Descripcion)
                    </div>

                    <div class="planilla-actions" aria-hidden="true"></div>
                </div>
            }

            <div class="list-footer">
                Mostrando @TiposFiltrados.Count() de @lista.Count tipos de planilla
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultadoLocal))
    {
        <p role="status">Tipo de planilla @resultadoLocal correctamente.</p>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="error-message" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            @Mensaje
        </div>
    }
</div>

@if (vista == Vista.Detalle)
{
    <ModalAdministracion Titulo="Detalle de tipo de planilla" CerrarAlTocarFondo="true"
                         Ocupado="@ocupado" Inactivo="@confirmarEliminar" AlCerrar="CerrarModal">
        <div class="administracion-cuerpo">
            @if (ocupado)
            {
                <p role="status">Cargando tipo de planilla…</p>
            }
            else if (modelo is not null)
            {
                <dl class="administracion-campo"><dt>Nombre</dt><dd>@modelo.Tipo</dd></dl>
                <dl class="administracion-campo"><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(modelo.Descripcion) ? "Sin descripción" : modelo.Descripcion)</dd></dl>
            }
            @if (!string.IsNullOrWhiteSpace(mensajeModal))
            {
                <p class="administracion-error" role="alert">@mensajeModal</p>
            }
        </div>
        @if (!ocupado)
        {
            <footer class="administracion-acciones">
                @if (modelo is not null)
                {
                    <button type="button" class="administracion-eliminar" @onclick="() => confirmarEliminar = true">Eliminar</button>
                }
                <button type="button" @onclick="CerrarModal">Cerrar</button>
                @if (modelo is not null)
                {
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                }
            </footer>
        }
    </ModalAdministracion>
}

@if ((vista is Vista.Crear or Vista.Editar) && modelo is not null)
{
    var editando = vista == Vista.Editar;
    <ModalAdministracion Titulo="@(editando ? "Editar tipo de planilla" : "Nuevo tipo de planilla")"
                         Ocupado="@ocupado" Inactivo="@confirmarDescarte" AlCerrar="SolicitarCerrar">
        <EditForm Model="@modelo" OnValidSubmit="Guardar" class="administracion-formulario">
            <DataAnnotationsValidator />
            <div class="administracion-cuerpo">
                <ValidationSummary />
                <div class="administracion-campo">
                    <label for="administracion-tipoplanillas-nombre">Nombre</label>
                    <InputText id="administracion-tipoplanillas-nombre" @bind-Value="modelo.Tipo" disabled="@ocupado" />
                    <ValidationMessage For="@(() => modelo!.Tipo)" />
                </div>
                <div class="administracion-campo">
                    <label for="administracion-tipoplanillas-descripcion">Descripción</label>
                    <InputTextArea id="administracion-tipoplanillas-descripcion" @bind-Value="modelo.Descripcion" disabled="@ocupado" />
                    <ValidationMessage For="@(() => modelo!.Descripcion)" />
                </div>
                @if (!string.IsNullOrWhiteSpace(mensajeModal))
                {
                    <p class="administracion-error" role="alert">@mensajeModal</p>
                }
            </div>
            <footer class="administracion-acciones">
                <button type="button" disabled="@ocupado" @onclick="SolicitarCerrar">Cancelar</button>
                <button type="submit" class="administracion-primario" disabled="@ocupado">
                    @(ocupado ? "Guardando…" : editando ? "Guardar cambios" : "Guardar")
                </button>
            </footer>
        </EditForm>
    </ModalAdministracion>
}

@if (confirmarEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar el tipo de planilla?" Ocupado="@ocupado" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>El tipo de planilla <strong>@modelo?.Tipo</strong> dejará de estar disponible.</p>
            @if (!string.IsNullOrWhiteSpace(mensajeModal))
            {
                <p class="administracion-error" role="alert">@mensajeModal</p>
            }
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@ocupado" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@ocupado" @onclick="Eliminar">
                @(ocupado ? "Eliminando…" : "Eliminar")
            </button>
        </footer>
    </ModalAdministracion>
}

@if (confirmarDescarte)
{
    <ConfirmacionDescarte OnContinuar="() => confirmarDescarte = false" OnDescartar="DescartarCambios" />
}

@code {
    private enum Vista { Ninguna, Crear, Editar, Detalle }
    private Vista vista;
    private TipoDTO? modelo;
    private (string? Tipo, string? Descripcion) estadoInicial;
    private int idSeleccionado;
    private bool ocupado;
    private bool confirmarDescarte;
    private bool confirmarEliminar;
    private string mensajeModal = string.Empty;
    private string resultadoLocal = string.Empty;

    private void AbrirCrear()
    {
        resultadoLocal = string.Empty;
        PrepararFormulario(new TipoDTO { Tipo = string.Empty, Descripcion = string.Empty }, Vista.Crear);
    }

    private void AbrirEditar()
    {
        if (modelo is not null)
            PrepararFormulario(modelo, Vista.Editar);
    }

    private void PrepararFormulario(TipoDTO datos, Vista destino)
    {
        modelo = datos;
        estadoInicial = (datos.Tipo, datos.Descripcion);
        mensajeModal = string.Empty;
        vista = destino;
    }

    private async Task AbrirDetalle(int id)
    {
        idSeleccionado = id;
        vista = Vista.Detalle;
        modelo = null;
        mensajeModal = string.Empty;
        ocupado = true;

        try
        {
            var respuesta = await Http.Get<TipoDTO>($"api/tipoplanillas/{id}");
            modelo = respuesta.Error ? null : respuesta.Respuesta;
            if (modelo is null)
                mensajeModal = respuesta.Error ? respuesta.ObtenerError() : "No se encontró el tipo de planilla.";
        }
        catch
        {
            mensajeModal = "No pudimos consultar el tipo de planilla. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private void SolicitarCerrar()
    {
        if (ocupado)
            return;

        if (modelo is not null && estadoInicial != (modelo.Tipo, modelo.Descripcion))
        {
            confirmarDescarte = true;
            return;
        }

        DescartarCambios();
    }

    private void DescartarCambios()
    {
        confirmarDescarte = false;
        if (vista == Vista.Editar && modelo is not null)
        {
            modelo.Tipo = estadoInicial.Tipo ?? string.Empty;
            modelo.Descripcion = estadoInicial.Descripcion ?? string.Empty;
            mensajeModal = string.Empty;
            vista = Vista.Detalle;
            return;
        }

        CerrarModal();
    }

    private void CerrarModal()
    {
        if (ocupado || confirmarEliminar)
            return;

        vista = Vista.Ninguna;
        modelo = null;
        mensajeModal = string.Empty;
    }

    private async Task Guardar()
    {
        if (ocupado || modelo is null)
            return;

        var editando = vista == Vista.Editar;
        ocupado = true;
        mensajeModal = string.Empty;

        try
        {
            if (editando)
            {
                var respuesta = await Http.Put<TipoDTO, RespuestaDTO>($"api/tipoplanillas/{idSeleccionado}", modelo);
                if (respuesta.Error)
                {
                    mensajeModal = respuesta.ObtenerError();
                    return;
                }
            }
            else
            {
                var respuesta = await Http.Post<TipoDTO, int>("api/tipoplanillas", modelo);
                if (respuesta.Error)
                {
                    mensajeModal = respuesta.ObtenerError();
                    return;
                }
            }

            vista = editando ? Vista.Detalle : Vista.Ninguna;
            resultadoLocal = editando ? "actualizado" : "creado";
            await Cargar();
        }
        catch
        {
            mensajeModal = "No pudimos guardar el tipo de planilla. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        confirmarEliminar = false;
        mensajeModal = string.Empty;
    }

    private async Task Eliminar()
    {
        if (ocupado)
            return;

        ocupado = true;
        mensajeModal = string.Empty;

        try
        {
            var respuesta = await Http.Delete($"api/tipoplanillas/{idSeleccionado}");
            if (respuesta.Error)
            {
                mensajeModal = respuesta.ObtenerError();
                return;
            }

            confirmarEliminar = false;
            vista = Vista.Ninguna;
            modelo = null;
            resultadoLocal = "eliminado";
            await Cargar();
        }
        catch
        {
            mensajeModal = "No pudimos eliminar el tipo de planilla. Intentá nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private List<TipoListadoDTO> lista = new();
    private bool cargando = true;
    private string Mensaje = string.Empty;
    private string busqueda = string.Empty;

    private IEnumerable<TipoListadoDTO> TiposFiltrados =>
        string.IsNullOrWhiteSpace(busqueda)
            ? lista
            : lista.Where(x =>
                FiltrosEntidades.ContieneTexto(x.Tipo, busqueda) ||
                FiltrosEntidades.ContieneTexto(x.Descripcion, busqueda));

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        cargando = true;
        var resp = await Http.Get<List<TipoListadoDTO>>(
            "api/tipoplanillas/ListaTipoPlanillas");

        lista = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : string.Empty;
        cargando = false;
    }


    private void Volver() => Nav.NavigateTo("/admin");
}