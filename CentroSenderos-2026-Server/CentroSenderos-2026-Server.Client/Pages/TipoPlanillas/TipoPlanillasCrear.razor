@page "/tipoplanillas/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-planilla-page">

    <div class="planilla-card">

        <div class="planilla-card-header">

            <div>
                <h1>Nueva Planilla</h1>

                <p>
                    Complete los detalles del tipo de planilla
                </p>
            </div>

            <button type="button"
                    class="close-button"
                    @onclick="Cancelar">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="planilla-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />


            <div class="field-group">

                <label>Tipo de planilla</label>

                <InputText class="form-input"
                           @bind-Value="modelo.Tipo"
                           placeholder="Ingresar tipo de planilla" />

            </div>


            <div class="field-group">

                <label>Descripción</label>

                <InputTextArea class="form-textarea"
                               @bind-Value="modelo.Descripcion"
                               placeholder="Ingresar descripción" />

            </div>


            <div class="form-actions">

                <button type="button"
                        class="cancel-button"
                        @onclick="Cancelar">

                    Cancelar

                </button>

                <button type="submit"
                        class="save-button">

                    Guardar

                </button>

            </div>

        </EditForm>

    </div>


    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <p class="form-message">
            @Mensaje
        </p>
    }

</div>

<p>@Mensaje</p>

@code {
    private TipoDTO modelo = new TipoDTO
    {
        Tipo = string.Empty,
        Descripcion = string.Empty
    };
    private string Mensaje = "";

    private async Task Grabar()
    {
        var resp = await Http.Post<TipoDTO, int>("api/tipoplanillas", modelo);
        Mensaje = resp.Error ? resp.ObtenerError() : $"Guardado correctamente. ID: {resp.Respuesta}";
        if (!resp.Error) Nav.NavigateTo("/tipoplanillas", true);



    }

    private void Cancelar() => Nav.NavigateTo("/tipoplanillas");
}

