@page "/tipoplanillas/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-planilla-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <h1>Crear tipo de planilla</h1>

    <EditForm Model="@modelo"
              OnValidSubmit="Grabar"
              FormName="CrearTipoPlanillaForm"
              class="planilla-form">

        <DataAnnotationsValidator />

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">01</span>
                <span>Información de la planilla</span>
            </div>

            <div class="form-grid">
                <div class="field-group">
                    <label for="tipoPlanilla">Nombre del tipo</label>

                    <InputText id="tipoPlanilla"
                               class="form-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Insertar nombre" />

                    <ValidationMessage For="@(() => modelo.Tipo)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="descripcionPlanilla">Descripción</label>

                    <InputTextArea id="descripcionPlanilla"
                                   class="form-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Insertar descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)"
                                       class="validation-message" />
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="form-message" role="alert">
                @Mensaje
            </div>
        }

        <div class="form-actions">
            <button type="button"
                    class="cancel-button"
                    disabled="@guardando"
                    @onclick="Cancelar">
                Cancelar
            </button>

            <button type="submit"
                    class="save-button"
                    disabled="@guardando">
                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar tipo de planilla</span>
                }
            </button>
        </div>

    </EditForm>
</div>

@code {
    private TipoDTO modelo = new()
    {
        Tipo = string.Empty,
        Descripcion = string.Empty
    };

    private bool guardando;
    private string Mensaje = string.Empty;

    private async Task Grabar()
    {
        Mensaje = string.Empty;
        guardando = true;

        var resp = await Http.Post<TipoDTO, int>(
            "api/tipoplanillas",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo("/tipoplanillas");
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void Cancelar() => Nav.NavigateTo("/tipoplanillas");

    private void Volver() => Nav.NavigateTo("/tipoplanillas");
}