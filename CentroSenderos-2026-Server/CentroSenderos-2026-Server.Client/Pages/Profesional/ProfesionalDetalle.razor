@page "/profesionales/detalle/{id:int}"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="detalle-profesional-page">

    <button type="button"
            class="back-button"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver a Profesionales</span>
    </button>

    <div class="detalle-title-row">
        <h1>Detalle Profesional</h1>

        <div class="badges-row">
            @if (!string.IsNullOrWhiteSpace(modelo.RolAsignado))
            {
                <span class="rol-badge">
                    <i class="bi bi-person-badge"></i>
                    @(modelo.RolAsignado == "admin" ? "Administrador" :
                      modelo.RolAsignado == "equipo" ? "Equipo" :
                      modelo.RolAsignado == "profesional" ? "Profesional" :
                      modelo.RolAsignado == "AdministradorEquipo" ? "Administrador/Equipo" :
                      modelo.RolAsignado)
                </span>
            }

            @if (modelo.EsSocio)
            {
                <span class="socio-badge">
                    <i class="bi bi-star-fill"></i>
                    Socio
                </span>
            }
        </div>
    </div>

    @if (cargando)
    {
        <div class="detalle-loading">Cargando datos del profesional...</div>
    }
    else if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="detalle-mensaje">@Mensaje</div>
    }
    else
    {
        @if (Estado == "actualizado")
        {
            <div class="success-message">
                <i class="bi bi-check-circle-fill"></i>
                <div>
                    <strong>Profesional actualizado</strong>
                    <span>Los cambios se guardaron correctamente.</span>
                </div>
            </div>
        }
        else if (Estado == "creado")
        {
            <div class="success-message">
                <i class="bi bi-check-circle-fill"></i>
                <div>
                    <strong>Profesional registrado</strong>
                    <span>El profesional fue registrado correctamente.</span>
                </div>
            </div>
        }

        <div class="profesional-detail">

            <!-- 01 - INFORMACIÓN PERSONAL -->
            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>
                <div class="form-grid form-grid-2">
                    <div class="field-group">
                        <label>Nombre completo</label>
                        <div class="form-value">@MostrarValor(modelo.Nombre)</div>
                    </div>
                    <div class="field-group">
                        <label>CUIT</label>
                        <div class="form-value">@MostrarValor(modelo.Cuit)</div>
                    </div>
                </div>
            </section>

            <!-- 02 - INFORMACIÓN PROFESIONAL -->
            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Profesional</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">
                        <label>Área</label>

                        <div class="form-value">
                            @MostrarValor(modelo.Area)
                        </div>
                    </div>

                    <div class="field-group">
                        <label>M.P.</label>

                        <div class="form-value">
                            @MostrarValor(modelo.MP)
                        </div>
                    </div>

                    <div class="field-group">
                        <label>R.N.P.</label>

                        <div class="form-value">
                            @MostrarValor(modelo.RNP)
                        </div>
                    </div>

                    <div class="field-group prestaciones-field">
                        <label>Prestaciones</label>

                        @if (modelo.TipoPrestacionNombres.Count > 0)
                        {
                            <div class="prestaciones-detalle">

                                @foreach (var prestacion
                                    in modelo.TipoPrestacionNombres)
                                {
                                    <span class="prestacion-badge">
                                        <i class="bi bi-check-circle"></i>
                                        @prestacion
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="form-value">
                                No tiene prestaciones asignadas
                            </div>
                        }

                    </div>

                </div>

            </section>

            <!-- 03 - DATOS DE CONTACTO -->
            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>

                <div class="form-grid form-grid-2">

                    <div class="field-group">
                        <label>Teléfono</label>

                        <div class="form-value">
                            @MostrarValor(modelo.Telefono)
                        </div>
                    </div>

                    <div class="field-group">
                        <label>Email</label>

                        <div class="form-value">
                            @MostrarValor(modelo.Email)
                        </div>
                    </div>

                </div>

            </section>

            <!-- ACCIONES -->
            <div class="form-actions">
                <button type="button"
                        class="edit-button"
                        @onclick="Editar">
                    <i class="bi bi-pencil-square"></i>
                    <span>Editar Profesional</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int id { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }

    private ProfesionalDTO modelo = CrearModeloVacio();
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync() => await CargarProfesional();

    private async Task CargarProfesional()
    {
        cargando = true;
        Mensaje = "";
        var resp = await Http.Get<ProfesionalDTO>($"api/profesional/{id}");
        modelo = !resp.Error && resp.Respuesta != null ? resp.Respuesta : CrearModeloVacio();
        if (resp.Error) Mensaje = resp.ObtenerError();
        cargando = false;
    }

    private void Editar() => Nav.NavigateTo($"/profesionales/editar/{id}");
    private void Volver() => Nav.NavigateTo("/profesionales");

    private static string MostrarValor(object? valor) =>
        string.IsNullOrWhiteSpace(valor?.ToString()) ? "—" : valor.ToString()!;

    private static ProfesionalDTO CrearModeloVacio() => new()
    {
        Nombre = string.Empty,
        Area = string.Empty,
        Cuit = string.Empty,
        MP = string.Empty,
        RNP = string.Empty,
        Telefono = string.Empty,
        Email = string.Empty,
        RolAsignado = string.Empty
    };
}
