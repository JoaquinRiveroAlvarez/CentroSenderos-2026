@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav

<div class="paciente-detalle-fondo" @onclick="Cerrar" @onkeydown="ProcesarTecla">
    <section class="paciente-dialog" role="dialog" aria-modal="true" aria-labelledby="profesional-titulo" tabindex="-1" @ref="dialogo" @onclick:stopPropagation="true">
        <header class="detalle-encabezado">
            <div class="detalle-identidad"><span class="detalle-icono"><i class="bi bi-person-badge"></i></span><div><span>Detalle del profesional</span><h1 id="profesional-titulo">@(modelo?.Nombre ?? "Ficha del profesional")</h1></div></div>
            <button type="button" class="detalle-cerrar" aria-label="Cerrar detalle" @onclick="Cerrar"><i class="bi bi-x-lg"></i></button>
        </header>
        <div class="detalle-contenido">
            @if (Estado is "creado" or "actualizado")
            {
                <div class="detalle-exito" role="status"><i class="bi bi-check-circle"></i>@(Estado == "creado" ? "Profesional registrado correctamente." : "Los cambios se guardaron correctamente.")</div>
            }
            @if (cargando)
            {
                <p class="detalle-mensaje" role="status">Cargando datos del profesional...</p>
            }
            else if (modelo != null)
            {
                <section class="detalle-contexto" aria-label="Identificación">
                    <div><span>Área</span><strong>@Mostrar(modelo.Area)</strong></div>
                    <div><span>CUIT</span><strong>@Mostrar(modelo.Cuit)</strong></div>
                </section>
                <div class="detalle-principal">
                    <section class="detalle-panel">
                        <h2 class="panel-titulo"><i class="bi bi-person-vcard"></i>Información profesional</h2>
                        <div class="dato-tarjeta"><span>Matrícula profesional (M.P.)</span><strong>@Mostrar(modelo.MP)</strong></div>
                        <div class="dato-tarjeta"><span>R.N.P.</span><strong>@Mostrar(modelo.RNP)</strong></div>
                        <div class="dato-tarjeta"><span>Rol en el sistema</span><strong>@NombreRol(modelo.RolAsignado)</strong></div>
                        @if (modelo.EsSocio)
                        {
                            <div class="dato-tarjeta"><strong><i class="bi bi-star-fill"></i>Socio del centro</strong></div>
                        }
                    </section>
                    <section class="detalle-panel">
                        <h2 class="panel-titulo"><i class="bi bi-telephone"></i>Datos de contacto</h2>
                        <div class="dato-tarjeta"><span>Teléfono</span><strong>@Mostrar(modelo.Telefono)</strong></div>
                        <div class="dato-tarjeta"><span>Email</span><strong>@Mostrar(modelo.Email)</strong></div>
                    </section>
                </div>
                <section class="detalle-panel">
                    <h2 class="panel-titulo"><i class="bi bi-clipboard2-check"></i>Prestaciones</h2>
                    <div class="prestaciones-detalle">
                        @foreach (var prestacion in modelo.TipoPrestacionNombres)
                        {
                            <span class="prestacion-badge">@prestacion</span>
                        }
                        @if (modelo.TipoPrestacionNombres.Count == 0)
                        {
                            <p class="detalle-mensaje">No tiene prestaciones asignadas.</p>
                        }
                    </div>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <p class="detalle-error" role="alert">@Mensaje</p>
            }
        </div>
        <footer class="detalle-acciones">
            <button type="button" class="detalle-btn-cerrar" @onclick="Cerrar">Cerrar</button>
            @if (!cargando && modelo != null)
            {
                <button type="button" class="detalle-btn-turnos" @onclick="VerTurnos"><i class="bi bi-calendar3"></i>Ver turnos</button>
                <button type="button" class="detalle-btn-editar" @onclick="Editar"><i class="bi bi-pencil-square"></i>Editar profesional</button>
            }
        </footer>
    </section>
</div>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Estado { get; set; }
    [Parameter] public string ContextoListado { get; set; } = "/profesionales";
    [Parameter] public EventCallback OnCerrar { get; set; }
    private ProfesionalDTO? modelo;
    private bool cargando = true;
    private string Mensaje = "";
    private int? idCargado;
    private ElementReference dialogo;
    private bool enfocar = true;
    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id) return;
        idCargado = Id;
        modelo = null;
        cargando = true;
        Mensaje = "";
        try
        {
            var resp = await Http.Get<ProfesionalDTO>($"api/profesional/{Id}");
            if (!resp.Error && resp.Respuesta != null)
            {
                modelo = resp.Respuesta;
                modelo.TipoPrestacionNombres ??= new();
            }
            else Mensaje = resp.Error ? resp.ObtenerError() : "No se encontró el profesional.";
        }
        catch { Mensaje = "No pudimos cargar el profesional. Cerrá la ficha e intentá nuevamente."; }
        finally { cargando = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (enfocar) { enfocar = false; await dialogo.FocusAsync(); }
    }
    private Task Cerrar() => OnCerrar.InvokeAsync();
    private async Task ProcesarTecla(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    { if (e.Key == "Escape") await Cerrar(); }
    private void Editar() => Nav.NavigateTo($"/profesionales/editar/{Id}?volver=" + Uri.EscapeDataString(ContextoListado + (ContextoListado.Contains('?') ? "&" : "?") + $"detalle={Id}"));
    private void VerTurnos() => Nav.NavigateTo($"/turnos?profesionales={Id}");
    private static string Mostrar(object? valor) => string.IsNullOrWhiteSpace(valor?.ToString()) ? "—" : valor.ToString()!;
    private static string NombreRol(string? rol) => rol switch { "admin" => "Administrador", "equipo" => "Equipo", "profesional" => "Profesional", "AdministradorEquipo" => "Administrador/Equipo", _ => Mostrar(rol) };
}
