@page "/profesionales"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="profesionales-page">

    <div class="profesionales-header">

        <h1>Gestión de Profesionales</h1>

        <div class="profesionales-actions">

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar profesional..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>

            <button type="button"
                    class="filter-button">
                <i class="bi bi-funnel"></i>
                <span>Filtros</span>
            </button>

            <button type="button"
                    class="new-professional-button"
                    @onclick="IrACrear">

                <i class="bi bi-person-plus"></i>
                <span>Nuevo Profesional</span>

            </button>

        </div>

    </div>


    @if (cargando)
    {
        <div class="profesionales-loading">
            <span>Cargando profesionales...</span>
        </div>
    }
    else if (listaProfesionales == null || listaProfesionales.Count == 0)
    {
        <p class="profesionales-mensaje">
            No hay profesionales registrados.
        </p>
    }
    else if (!ProfesionalesFiltrados.Any())
    {
        <p class="profesionales-mensaje">
            No se encontraron profesionales que coincidan con la búsqueda.
        </p>
    }
    else
    {
        <div class="profesionales-card">

            <div class="profesionales-table-wrapper">

                <table class="profesionales-table">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Área</th>
                            <th>M.P.</th>
                            <th>R.N.P.</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var profesional in ProfesionalesFiltrados)
                        {
                            <tr @onclick="() => IrAEditar(profesional.Id)">

                                <td class="profesional-nombre">
                                    @MostrarValor(profesional.Nombre)
                                </td>

                                <td>
                                    @MostrarValor(profesional.Area)
                                </td>

                                <td>
                                    @MostrarValor(profesional.MP)
                                </td>

                                <td>
                                    @MostrarValor(profesional.RNP)
                                </td>

                                <td>
                                    @MostrarValor(profesional.Cuit)
                                </td>

                                <td>
                                    @MostrarValor(profesional.Telefono)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <p class="profesionales-mensaje error">
            @Mensaje
        </p>
    }

</div>


@code {

    private List<ProfesionalListadoDTO>? listaProfesionales;

    private bool cargando = true;

    private string Mensaje = "";

    private string textoBusqueda = "";


    private IEnumerable<ProfesionalListadoDTO> ProfesionalesFiltrados =>
        listaProfesionales?
            .Where(p =>
                string.IsNullOrWhiteSpace(textoBusqueda) ||

                (p.Nombre?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Area?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Cuit?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.MP?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.RNP?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Telefono?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ?? Enumerable.Empty<ProfesionalListadoDTO>();


    protected override async Task OnInitializedAsync()
    {
        await CargarProfesionales();
    }


    private async Task CargarProfesionales()
    {
        cargando = true;

        var resp = await Http.Get<List<ProfesionalListadoDTO>>(
            "api/profesional/ListaProfesional"
        );

        if (resp.Error &&
            resp.HttpResponseMessage.StatusCode ==
            System.Net.HttpStatusCode.NotFound)
        {
            listaProfesionales = new();
            Mensaje = "";
        }
        else
        {
            listaProfesionales =
                resp.Error
                    ? new()
                    : resp.Respuesta ?? new();

            Mensaje =
                resp.Error
                    ? resp.ObtenerError()
                    : "";
        }

        cargando = false;
    }


    private void IrAEditar(int id)
    {
        Nav.NavigateTo(
            $"/profesionales/editar/{id}"
        );
    }


    private void IrACrear()
    {
        Nav.NavigateTo(
            "/profesionales/crear"
        );
    }


    private static string MostrarValor(object? valor)
    {
        if (valor is null)
            return "—";

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }
}