@page "/profesionales"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<h3>Listado de Profesionales</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="IrACrear">Nuevo Profesional</button>
</div>

@if (cargando)
{
    <p>Cargando profesionales...</p>
}
else if (listaProfesionales == null || listaProfesionales.Count == 0)
{
    <p>No hay profesionales registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Área/Profesión</th>
                <th>CUIT</th>
                <th>Matrícula (MP)</th>
                <th>RNP</th>
                <th>Teléfono</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profesional in listaProfesionales)
            {
                <tr style="cursor:pointer" @onclick="() => IrAEditar(profesional.Id)">
                    <td>@profesional.Id</td>
                    <td>@profesional.Nombre</td>
                    <td>@profesional.Area</td>
                    <td>@profesional.Cuit</td>
                    <td>@profesional.MP</td>
                    <td>@profesional.RNP</td>
                    <td>@profesional.Telefono</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>@Mensaje</p>

@code {
    private List<ProfesionalListadoDTO> listaProfesionales = new();
    private bool cargando = true;
    private string Mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarProfesionales();
    }

    private async Task CargarProfesionales()
    {
        cargando = true;
        var resp = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
        listaProfesionales = resp.Error ? new() : resp.Respuesta ?? new();
        Mensaje = resp.Error ? resp.ObtenerError() : "";
        cargando = false;
    }

    private void IrAEditar(int id)
    {
        Nav.NavigateTo($"/profesionales/editar/{id}");
    }

    private void IrACrear()
    {
        Nav.NavigateTo("/profesionales/crear");
    }
}
