@page "/profesionales"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="profesionales-page">

    <div class="profesionales-header">

        <h1>Gestión de Profesionales</h1>

        <div class="profesionales-actions">

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar profesional..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>

            @*  boton de filtros deshabilitado por el momento 
             
         <button type="button"
                    class="filter-button">
                <i class="bi bi-funnel"></i>
                <span>Filtros</span>
            </button> *@

            <button type="button"
                    class="new-professional-button"
                    @onclick="IrACrear">

                <i class="bi bi-person-plus"></i>
                <span>Nuevo Profesional</span>

            </button>

        </div>

    </div>


    @if (cargando)
    {
        <div class="profesionales-estado">
            <div class="estado-spinner"></div>

            <div>
                <h3>Cargando profesionales</h3>
                <p>Estamos obteniendo la información registrada.</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="profesionales-estado error">
            <div class="estado-icono">
                <i class="bi bi-exclamation-circle"></i>
            </div>

            <div>
                <h3>No pudimos cargar los profesionales</h3>
                <p>@Mensaje</p>

                <button type="button"
                        class="estado-button secundario"
                        @onclick="CargarProfesionales">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reintentar
                </button>
            </div>
        </div>
    }
    else if (listaProfesionales == null || listaProfesionales.Count == 0)
    {
        <div class="profesionales-estado">
            <div class="estado-icono">
                <i class="bi bi-person-workspace"></i>
            </div>

            <div>
                <h3>No hay profesionales registrados</h3>
                <p>
                    Todavía no se registraron profesionales en Senderos.
                </p>

                <button type="button"
                        class="estado-button principal"
                        @onclick="IrACrear">
                    <i class="bi bi-person-plus"></i>
                    Nuevo Profesional
                </button>
            </div>
        </div>
    }
    else if (!ProfesionalesFiltrados.Any())
    {
        <div class="profesionales-estado">
            <div class="estado-icono">
                <i class="bi bi-search"></i>
            </div>

            <div>
                <h3>No encontramos resultados</h3>

                <p>
                    No hay profesionales que coincidan con
                    <strong>"@textoBusqueda"</strong>.
                </p>

                <button type="button"
                        class="estado-button secundario"
                        @onclick="LimpiarBusqueda">
                    <i class="bi bi-x-circle"></i>
                    Limpiar búsqueda
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="profesionales-card">

            <div class="profesionales-table-wrapper">

                <table class="profesionales-table">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Área</th>
                            <th>M.P.</th>
                            <th>R.N.P.</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var profesional in ProfesionalesFiltrados)
                        {
                            <tr @onclick="() => IrADetalle(profesional.Id)">

                                <td class="profesional-nombre">

                                    <div class="nombre-con-socio">

                                        <span>
                                            @MostrarValor(profesional.Nombre)
                                        </span>

                                        @if (profesional.EsSocio)
                                        {
                                            <span class="socio-badge">
                                                <i class="bi bi-star-fill"></i>
                                                Socio
                                            </span>
                                        }

                                    </div>

                                </td>

                                <td>@MostrarValor(profesional.Area)</td>
                                <td>@MostrarValor(profesional.MP)</td>
                                <td>@MostrarValor(profesional.RNP)</td>
                                <td>@MostrarValor(profesional.Cuit)</td>
                                <td>@MostrarValor(profesional.Telefono)</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="profesionales-footer">
                Mostrando
                <strong>@ProfesionalesFiltrados.Count()</strong>
                de
                <strong>@listaProfesionales.Count</strong>
                profesionales
            </div>

        </div>
    }

</div>


@code {

    private List<ProfesionalListadoDTO>? listaProfesionales;

    private bool cargando = true;

    private string Mensaje = "";

    private string textoBusqueda = "";


    private IEnumerable<ProfesionalListadoDTO> ProfesionalesFiltrados =>
        listaProfesionales?
            .Where(p =>
                string.IsNullOrWhiteSpace(textoBusqueda) ||

                (p.Nombre?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Area?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Cuit?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.MP?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.RNP?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||

                (p.Telefono?.ToString()?.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ?? Enumerable.Empty<ProfesionalListadoDTO>();


    protected override async Task OnInitializedAsync()
    {
        await CargarProfesionales();
    }


    private async Task CargarProfesionales()
    {
        cargando = true;
        Mensaje = "";
        var resp = await Http.Get<List<ProfesionalListadoDTO>>( 
            "api/profesional/ListaProfesional"
        );

        if (resp.Error &&
            resp.HttpResponseMessage.StatusCode ==
            System.Net.HttpStatusCode.NotFound)
        {
            listaProfesionales = new();
            Mensaje = "";
        }
        else
        {
            listaProfesionales =
                resp.Error
                    ? new()
                    : resp.Respuesta ?? new();

            Mensaje =
                resp.Error
                    ? resp.ObtenerError()
                    : "";
        }

        cargando = false;
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
    }

 private void IrADetalle(int id)
{
    Nav.NavigateTo(
        $"/profesionales/detalle/{id}"
    );
}


    private void IrACrear()
    {
        Nav.NavigateTo(
            "/profesionales/crear"
        );
    }


    private static string MostrarValor(object? valor)
    {
        if (valor is null)
            return "—";

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }
}