@page "/profesionales/crear"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-profesional-page" inert="@confirmarDescarte">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <header class="page-header">
        <span class="page-heading-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
        <div>
            <h1>Crear profesional</h1>
            <p>Registrá sus datos personales, prestaciones e información de contacto.</p>
        </div>
    </header>

    <EditForm Model="@modelo"
              OnValidSubmit="Grabar"
              FormName="CrearProfesionalForm"
              class="profesional-form">

        <DataAnnotationsValidator />

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">01</span>
                <span>Información personal</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalNombre">Nombre completo</label>

                    <InputText id="profesionalNombre" class="form-input"
                               @bind-Value="modelo.Nombre"
                               placeholder="Nombre completo" />

                    <ValidationMessage For="@(() => modelo.Nombre)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="profesionalCuit">CUIT</label>

                    <InputText id="profesionalCuit" class="form-input"
                               @bind-Value="modelo.Cuit"
                               placeholder="Ej: 20-12345678-9" />

                    <ValidationMessage For="@(() => modelo.Cuit)"
                                       class="validation-message" />
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">02</span>
                <span>Información profesional</span>
            </div>

            <div class="form-grid form-grid-3">


                <div class="field-group">
                    <label>Áreas</label>
                    <AreasProfesional Areas="AreasDerivadas"
                                      MostrarAyuda="true"
                                      TienePrestacionesSinArea="@TienePrestacionesSinArea"
                                      TextoVacio="@(modelo.TipoPrestacionIds.Count == 0 ? "Seleccioná las prestaciones del profesional." : "Sin área asignada")" />
                </div>

                <div class="field-group">
                    <label for="profesionalRNP">R.N.P.</label>

                    <InputText id="profesionalRNP" class="form-input"
                               @bind-Value="modelo.RNP"
                               placeholder="Ingresar R.N.P." />

                    <ValidationMessage For="@(() => modelo.RNP)"
                                       class="validation-message" />
                </div>
                <div class="field-group prestaciones-field">
                    <label for="profesionalPrestaciones">Prestaciones</label>

                    <div class="catalogo-selector">
<EntradaConBusqueda
                                 id="profesionalPrestaciones"
                                 @bind-Value="prestacionSeleccionadaId"
                                 @bind-Value:after="AgregarPrestacion"
                                 Disabled="@(guardando)"
                                     Etiqueta="Prestación" Placeholder="Seleccioná una prestación"
                                     Opciones="OpcionesPrestacionesFormulario" />
                    <button type="button" class="catalogo-agregar" disabled="@guardando" aria-label="Crear prestación" title="Crear prestación" @onclick="() => tipoprestacionModal.Abrir()"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                    </div>

                    @if (modelo.TipoPrestacionIds.Count > 0)
                    {
                        <div class="prestaciones-seleccionadas">
                            @foreach (var prestacionId in modelo.TipoPrestacionIds)
                            {
                                var prestacion = ObtenerPrestacion(prestacionId);

                                if (prestacion is not null)
                                {
                                    <div class="prestacion-chip prestacion-matricula">
                                        <span>@prestacion.Tipo</span>
                                        <label>Matrícula
                                            <input class="form-input" aria-label="Matrícula de @prestacion.Tipo" placeholder="Ej.: MP-1234" maxlength="30" value="@modelo.MatriculasPorPrestacion.GetValueOrDefault(prestacionId)"
                                                   @onchange="e => modelo.MatriculasPorPrestacion[prestacionId] = e.Value?.ToString() ?? string.Empty" />
                                        </label>

                                        <button type="button"
                                                class="prestacion-chip-remove"
                                                title="Quitar prestación"
                                                disabled="@(guardando)"
                                                @onclick="() => QuitarPrestacion(prestacion.Id)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <span class="prestaciones-help">
                            Todavía no hay prestaciones asignadas.
                        </span>
                    }
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">03</span>
                <span>Datos de contacto</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalTelefono">Teléfono</label>

                    <InputText id="profesionalTelefono" class="form-input"
                               @bind-Value="modelo.Telefono"
                               placeholder="Ej: +54 351 1234567" />

                    <ValidationMessage For="@(() => modelo.Telefono)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="profesionalEmail">Email</label>

                    <InputText id="profesionalEmail" class="form-input"
                               @bind-Value="modelo.Email"
                               placeholder="Ej: profesional@senderos.com" />

                    <ValidationMessage For="@(() => modelo.Email)"
                                       class="validation-message" />
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">04</span>
                <span>Usuario del sistema</span>
            </div>
            <p>Se creará una cuenta con el email registrado y contraseña inicial 123456.</p>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalRol">Rol</label>

                    <EntradaConBusqueda
                                 id="profesionalRol"
                                 @bind-Value="modelo.RolAsignado"
                                 Disabled="@(guardando)"
                                     Etiqueta="Rol" Placeholder="Seleccioná un rol"
                                     Opciones="OpcionesRoles" />
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="form-message">
                @Mensaje
            </div>
        }

        <div class="form-actions">

            <button type="button"
                    class="cancel-button"
                    disabled="@guardando"
                    @onclick="Cancelar">
                Cancelar
            </button>

            <button type="submit"
                    class="save-button"
                    disabled="@guardando">

                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar profesional</span>
                }

            </button>

        </div>

    </EditForm>

</div>

<CrearCatalogo @ref="tipoprestacionModal" Recurso="tipoprestacion" Etiqueta="prestación" Creado="PrestacionCreada" />

@if (confirmarDescarte)
{
    <ConfirmacionDescarte OnContinuar="() => confirmarDescarte = false"
                          OnDescartar="SalirDelFormulario" />
}

@code {
    #region Opciones de los buscadores

    private IEnumerable<OpcionSelector> OpcionesPrestacionesFormulario =>
        PrestacionesDisponibles
            .Select(prestacion => new OpcionSelector(prestacion.Id.ToString(), prestacion.Tipo, prestacion.TipoAreaNombre ?? "Sin área asignada"));

    private IEnumerable<OpcionSelector> OpcionesRoles =>
        new OpcionSelector[]
        {
            new OpcionSelector("equipo", "Equipo"),
            new OpcionSelector("profesional", "Profesional")
        };

    #endregion


    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesSeleccionadas =>
        listaTipoPrestaciones.Where(prestacion => modelo.TipoPrestacionIds.Contains(prestacion.Id));

    private IEnumerable<string> AreasDerivadas => PrestacionesSeleccionadas
        .Where(prestacion => !string.IsNullOrWhiteSpace(prestacion.TipoAreaNombre))
        .Select(prestacion => prestacion.TipoAreaNombre!)
        .Distinct()
        .OrderBy(nombre => nombre);

    private bool TienePrestacionesSinArea => modelo.TipoPrestacionIds.Any(id =>
        !listaTipoPrestaciones.Any(prestacion => prestacion.Id == id &&
            prestacion.TipoAreaId.HasValue && !string.IsNullOrWhiteSpace(prestacion.TipoAreaNombre)));


    private CrearCatalogo tipoprestacionModal = default!;
    private async Task PrestacionCreada(TipoListadoDTO tipo)
    {
        await CargarTipoPrestaciones();
        prestacionSeleccionadaId = tipo.Id;
        AgregarPrestacion();
    }

    [SupplyParameterFromQuery(Name = "volver")]
    public string? VolverA { get; set; }

    private string ContextoListado => !string.IsNullOrEmpty(VolverA) &&
        (VolverA == "/profesionales" || VolverA.StartsWith("/profesionales?", StringComparison.Ordinal))
        ? VolverA : "/profesionales";

    private ProfesionalDTO modelo = new()
    {
        Nombre = string.Empty,
        Area = string.Empty,
        Cuit = string.Empty,
        MP = string.Empty,
        RNP = string.Empty,
        Telefono = string.Empty,
        Email = string.Empty,
        RolAsignado = "profesional",
        TipoPrestacionIds = new List<int>(),
        TipoPrestacionNombres = new List<string>()
    };

    private List<TipoPrestacionListadoDTO> listaTipoPrestaciones = new();

    private int? prestacionSeleccionadaId;

    private bool guardando;
    private bool confirmarDescarte;
    private string? estadoInicial;
    private string Mensaje = string.Empty;

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesDisponibles =>
        listaTipoPrestaciones
            .Where(prestacion =>
                !modelo.TipoPrestacionIds.Contains(prestacion.Id))
            .OrderBy(prestacion => prestacion.Tipo);

    protected override async Task OnInitializedAsync()
    {
        estadoInicial = CapturarEstado();
        await CargarTipoPrestaciones();
    }

    private async Task CargarTipoPrestaciones()
    {
        var resp =
            await Http.Get<List<TipoPrestacionListadoDTO>>(
                "api/tipoprestacion/ListaTipoPrestacion"
            );

        if (!resp.Error && resp.Respuesta != null)
        {
            listaTipoPrestaciones = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AgregarPrestacion()
    {
        if (!prestacionSeleccionadaId.HasValue)
        {
            return;
        }

        var prestacionId = prestacionSeleccionadaId.Value;

        if (!modelo.TipoPrestacionIds.Contains(prestacionId))
        {
            modelo.TipoPrestacionIds.Add(prestacionId);
        }

        // Vacía el selector después de agregar.
        prestacionSeleccionadaId = null;
    }

    private void QuitarPrestacion(int prestacionId)
    {
        modelo.TipoPrestacionIds.Remove(prestacionId);
        modelo.MatriculasPorPrestacion.Remove(prestacionId);
    }

    private TipoPrestacionListadoDTO? ObtenerPrestacion(
        int prestacionId)
    {
        return listaTipoPrestaciones
            .FirstOrDefault(prestacion =>
                prestacion.Id == prestacionId);
    }

    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp = await Http.Post<ProfesionalDTO, int>(
            "api/profesional",
            modelo
        );

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            guardando = false;
            return;
        }

        var profesionalId = resp.Respuesta;

        guardando = false;

        Nav.NavigateTo(
            ContextoListado + (ContextoListado.Contains('?') ? "&" : "?") + $"detalle={profesionalId}&estado=creado"
        );
    }

    private string CapturarEstado() => System.Text.Json.JsonSerializer.Serialize(new
    {
        modelo.Nombre,
        modelo.Cuit,
        modelo.RNP,
        modelo.Telefono,
        modelo.Email,
        modelo.RolAsignado,
        Prestaciones = modelo.TipoPrestacionIds.OrderBy(id => id)
            .Select(id => new
            {
                Id = id,
                Matricula = modelo.MatriculasPorPrestacion.GetValueOrDefault(id) ?? string.Empty
            })
    });

    private void Cancelar() => Volver();

    private void Volver()
    {
        if (guardando || confirmarDescarte)
            return;

        if (estadoInicial is not null && estadoInicial != CapturarEstado())
        {
            confirmarDescarte = true;
            return;
        }

        SalirDelFormulario();
    }

    private void SalirDelFormulario() => Nav.NavigateTo(ContextoListado);
}
