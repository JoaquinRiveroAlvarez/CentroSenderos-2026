@page "/profesionales/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-profesional-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>


    <h1>Crear Profesional</h1>

    <EditForm Model="@modelo"
              OnValidSubmit="Grabar"
              FormName="CrearProfesionalForm"
              class="profesional-form">

        <DataAnnotationsValidator />

        <section class="form-section">

            <div class="section-title">
                <span class="section-number">01</span>
                <span>Información Personal</span>
            </div>

            <div class="form-grid form-grid-2">

                <div class="field-group">
                    <label>Nombre completo</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.Nombre"
                               placeholder="Insertar nombre completo" />

                    <ValidationMessage For="@(() => modelo.Nombre)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label>CUIT</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.Cuit"
                               placeholder="Ej: 20-12345678-9" />

                    <ValidationMessage For="@(() => modelo.Cuit)"
                                       class="validation-message" />
                </div>

            </div>

        </section>

        <section class="form-section">

            <div class="section-title">
                <span class="section-number">02</span>
                <span>Información Profesional</span>
            </div>

            <div class="form-grid form-grid-3">

                <div class="field-group">
                    <label>Área</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.Area"
                               placeholder="Ej: Psicología" />

                    <ValidationMessage For="@(() => modelo.Area)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label>M.P. (Matrícula Profesional)</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.MP"
                               placeholder="Ingresar M.P." />

                    <ValidationMessage For="@(() => modelo.MP)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label>R.N.P.</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.RNP"
                               placeholder="Ingresar R.N.P." />

                    <ValidationMessage For="@(() => modelo.RNP)"
                                       class="validation-message" />
                </div>

            </div>

        </section>

        <section class="form-section">

            <div class="section-title">
                <span class="section-number">03</span>
                <span>Datos de Contacto</span>
            </div>

            <div class="form-grid form-grid-2">

                <div class="field-group">
                    <label>Teléfono</label>

                    <InputText class="form-input"
                               @bind-Value="modelo.Telefono"
                               placeholder="Ej: +54 351 1234567" />

                    <ValidationMessage For="@(() => modelo.Telefono)"
                                       class="validation-message" />
                </div>

            </div>

        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">04</span>
                <span>Usuario del Sistema</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label>Email</label>
                    <InputText class="form-input"
                               @bind-Value="modelo.Email"
                               placeholder="Ej: profesional@senderos.com" />
                    <ValidationMessage For="@(() => modelo.Email)" class="validation-message" />
                </div>

                <div class="field-group">
                    <label>Rol</label>
                    <InputSelect class="form-input" @bind-Value="modelo.RolAsignado">
                        <option value="">-- Seleccionar rol --</option>
                        <option value="admin">Admin</option>
                        <option value="equipo">Equipo</option>
                        <option value="profesional">Profesional</option>
                    </InputSelect>
                </div>
            </div>
        </section>



        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="form-message">
                @Mensaje
            </div>
        }

        <div class="form-actions">

            <button type="button"
                    class="cancel-button"
                    disabled="@guardando"
                    @onclick="Cancelar">
                Cancelar
            </button>

            <button type="submit"
                    class="save-button"
                    disabled="@guardando">

                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar Profesional</span>
                }

            </button>

        </div>

    </EditForm>

</div>

@code {

    private ProfesionalDTO modelo = new()
    {
        Nombre = string.Empty,
        Area = string.Empty,
        Cuit = string.Empty,
        MP = string.Empty,
        RNP = string.Empty,
        Telefono = string.Empty,
        Email = string.Empty,
        RolAsignado = string.Empty
    };

    private bool guardando = false;

    private string Mensaje = "";

    private async Task Grabar()
    {
        guardando = true;
        Mensaje = "";

        var resp = await Http.Post<ProfesionalDTO, int>(
            "api/profesional",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            var profesionalId = resp.Respuesta;

            // Asignar rol en Identity si se seleccionó
            if (!string.IsNullOrWhiteSpace(modelo.RolAsignado))
            {
                var rolResp = await Http.Post<RolAsignacionDTO, string>(
                    "api/seguridad/asignarRol",
                    new RolAsignacionDTO { Email = modelo.Email, Rol = modelo.RolAsignado }
                );

                if (rolResp.Error)
                {
                    Mensaje = $"Profesional creado, pero error al asignar rol: {rolResp.ObtenerError()}";
                }
            }

            Nav.NavigateTo($"/profesionales/detalle/{profesionalId}?estado=creado");
        }

    }

    private void Cancelar()
    {
        Nav.NavigateTo("/profesionales");
    }

    private void Volver()
    {
        Nav.NavigateTo("/profesionales");
    }
}