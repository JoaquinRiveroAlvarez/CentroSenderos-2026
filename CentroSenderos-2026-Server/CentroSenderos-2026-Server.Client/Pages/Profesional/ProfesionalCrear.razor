@page "/profesionales/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-profesional-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <header class="page-header">
        <span class="page-heading-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
        <div>
            <h1>Crear profesional</h1>
            <p>Registrá sus datos personales, prestaciones e información de contacto.</p>
        </div>
    </header>

    <EditForm Model="@modelo"
              OnValidSubmit="Grabar"
              FormName="CrearProfesionalForm"
              class="profesional-form">

        <DataAnnotationsValidator />

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">01</span>
                <span>Información personal</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalNombre">Nombre completo</label>

                    <InputText id="profesionalNombre" class="form-input"
                               @bind-Value="modelo.Nombre"
                               placeholder="Nombre completo" />

                    <ValidationMessage For="@(() => modelo.Nombre)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="profesionalCuit">CUIT</label>

                    <InputText id="profesionalCuit" class="form-input"
                               @bind-Value="modelo.Cuit"
                               placeholder="Ej: 20-12345678-9" />

                    <ValidationMessage For="@(() => modelo.Cuit)"
                                       class="validation-message" />
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">02</span>
                <span>Información profesional</span>
            </div>

            <div class="form-grid form-grid-3">


                <div class="field-group">
                    <label for="areaProfesional">Área</label>

                    <InputSelect id="areaProfesional"
                                 class="form-input"
                                 @bind-Value="modelo.Area"
                                 disabled="@(guardando || listaTipoAreas.Count == 0)">

                        <option value="">
                            -- Seleccionar área --
                        </option>

                        @foreach (var area in listaTipoAreas.OrderBy(x => x.Tipo))
                        {
                            <option value="@area.Tipo">
                                @area.Tipo
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => modelo.Area)"
                                       class="validation-message" />

                    @if (!cargandoAreas && listaTipoAreas.Count == 0)
                    {
                        <span class="areas-help">Primero cargá un tipo de área desde Administración.</span>
                    }
                </div>

                <div class="field-group">
                    <label for="profesionalMP">M.P. (Matrícula Profesional)</label>

                    <InputText id="profesionalMP" class="form-input"
                               @bind-Value="modelo.MP"
                               placeholder="Ingresar M.P." />

                    <ValidationMessage For="@(() => modelo.MP)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="profesionalRNP">R.N.P.</label>

                    <InputText id="profesionalRNP" class="form-input"
                               @bind-Value="modelo.RNP"
                               placeholder="Ingresar R.N.P." />

                    <ValidationMessage For="@(() => modelo.RNP)"
                                       class="validation-message" />
                </div>
                <div class="field-group prestaciones-field">
                    <label for="profesionalPrestaciones">Prestaciones</label>

                    <InputSelect class="form-input"
                                 id="profesionalPrestaciones"
                                 @bind-Value="prestacionSeleccionadaId"
                                 @bind-Value:after="AgregarPrestacion"
                                 disabled="@(guardando)">

                        <option value="">
                            -- Seleccionar prestación --
                        </option>

                        @foreach (var prestacion in PrestacionesDisponibles)
                        {
                            <option value="@prestacion.Id">
                                @prestacion.Tipo
                            </option>
                        }
                    </InputSelect>

                    @if (modelo.TipoPrestacionIds.Count > 0)
                    {
                        <div class="prestaciones-seleccionadas">
                            @foreach (var prestacionId in modelo.TipoPrestacionIds)
                            {
                                var prestacion = ObtenerPrestacion(prestacionId);

                                if (prestacion is not null)
                                {
                                    <div class="prestacion-chip">
                                        <span>@prestacion.Tipo</span>

                                        <button type="button"
                                                class="prestacion-chip-remove"
                                                title="Quitar prestación"
                                                disabled="@(guardando)"
                                                @onclick="() => QuitarPrestacion(prestacion.Id)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <span class="prestaciones-help">
                            Todavía no hay prestaciones asignadas.
                        </span>
                    }
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">03</span>
                <span>Datos de contacto</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalTelefono">Teléfono</label>

                    <InputText id="profesionalTelefono" class="form-input"
                               @bind-Value="modelo.Telefono"
                               placeholder="Ej: +54 351 1234567" />

                    <ValidationMessage For="@(() => modelo.Telefono)"
                                       class="validation-message" />
                </div>

                <div class="field-group">
                    <label for="profesionalEmail">Email</label>

                    <InputText id="profesionalEmail" class="form-input"
                               @bind-Value="modelo.Email"
                               placeholder="Ej: profesional@senderos.com" />

                    <ValidationMessage For="@(() => modelo.Email)"
                                       class="validation-message" />
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title">
                <span class="section-number">04</span>
                <span>Usuario del sistema</span>
            </div>

            <div class="form-grid form-grid-2">
                <div class="field-group">
                    <label for="profesionalRol">Rol</label>

                    <InputSelect class="form-input"
                                 id="profesionalRol"
                                 @bind-Value="modelo.RolAsignado"
                                 disabled="@(guardando)">

                        <option value="">
                            -- Seleccionar rol --
                        </option>

                        <option value="admin">
                            Administrador
                        </option>

                        <option value="equipo">
                            Equipo
                        </option>

                        <option value="profesional">
                            Profesional
                        </option>

                        <option value="AdministradorEquipo">
                            Administrador/Equipo
                        </option>
                    </InputSelect>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="form-message">
                @Mensaje
            </div>
        }

        <div class="form-actions">

            <button type="button"
                    class="cancel-button"
                    disabled="@guardando"
                    @onclick="Cancelar">
                Cancelar
            </button>

            <button type="submit"
                    class="save-button"
                    disabled="@guardando">

                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar profesional</span>
                }

            </button>

        </div>

    </EditForm>

</div>

@code {
    [SupplyParameterFromQuery(Name = "volver")]
    public string? VolverA { get; set; }

    private string ContextoListado => !string.IsNullOrEmpty(VolverA) &&
        (VolverA == "/profesionales" || VolverA.StartsWith("/profesionales?", StringComparison.Ordinal))
        ? VolverA : "/profesionales";

    private ProfesionalDTO modelo = new()
    {
        Nombre = string.Empty,
        Area = string.Empty,
        Cuit = string.Empty,
        MP = string.Empty,
        RNP = string.Empty,
        Telefono = string.Empty,
        Email = string.Empty,
        RolAsignado = string.Empty,
        TipoPrestacionIds = new List<int>(),
        TipoPrestacionNombres = new List<string>()
    };

    private List<TipoPrestacionListadoDTO> listaTipoPrestaciones = new();
    private List<TipoListadoDTO> listaTipoAreas = new();
    private bool cargandoAreas = true;

    private int? prestacionSeleccionadaId;

    private bool guardando;
    private string Mensaje = string.Empty;

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesDisponibles =>
        listaTipoPrestaciones
            .Where(prestacion =>
                !modelo.TipoPrestacionIds.Contains(prestacion.Id))
            .OrderBy(prestacion => prestacion.Tipo);

    protected override async Task OnInitializedAsync()
    {
        await CargarTipoPrestaciones();
        await CargarTipoAreas();
    }

    private async Task CargarTipoPrestaciones()
    {
        var resp =
            await Http.Get<List<TipoPrestacionListadoDTO>>(
                "api/tipoprestacion/ListaTipoPrestacion"
            );

        if (!resp.Error && resp.Respuesta != null)
        {
            listaTipoPrestaciones = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private async Task CargarTipoAreas()
    {
        cargandoAreas = true;

        try
        {
            var respuesta = await Http.Get<List<TipoListadoDTO>>(
                "api/tipoarea/ListaTipoArea");

            if (respuesta.Error)
            {
                Mensaje = respuesta.ObtenerError();
                return;
            }

            listaTipoAreas = respuesta.Respuesta ?? new();
        }
        catch
        {
            Mensaje = "No pudimos cargar las áreas. Intentá nuevamente.";
        }
        finally
        {
            cargandoAreas = false;
        }
    }

    private void AgregarPrestacion()
    {
        if (!prestacionSeleccionadaId.HasValue)
        {
            return;
        }

        var prestacionId = prestacionSeleccionadaId.Value;

        if (!modelo.TipoPrestacionIds.Contains(prestacionId))
        {
            modelo.TipoPrestacionIds.Add(prestacionId);
        }

        // Vacía el selector después de agregar.
        prestacionSeleccionadaId = null;
    }

    private void QuitarPrestacion(int prestacionId)
    {
        modelo.TipoPrestacionIds.Remove(prestacionId);
    }

    private TipoPrestacionListadoDTO? ObtenerPrestacion(
        int prestacionId)
    {
        return listaTipoPrestaciones
            .FirstOrDefault(prestacion =>
                prestacion.Id == prestacionId);
    }

    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp = await Http.Post<ProfesionalDTO, int>(
            "api/profesional",
            modelo
        );

        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            guardando = false;
            return;
        }

        var profesionalId = resp.Respuesta;

        if (!string.IsNullOrWhiteSpace(modelo.RolAsignado))
        {
            var rolResp = await Http.Post<RolAsignacionDTO, string>(
                "api/seguridad/asignarRol",
                new RolAsignacionDTO
                {
                    Email = modelo.Email,
                    Rol = modelo.RolAsignado
                }
            );

            if (rolResp.Error)
            {
                Mensaje =
                    "Profesional creado, pero ocurrió un error " +
                    $"al asignar el rol: {rolResp.ObtenerError()}";

                guardando = false;
                return;
            }
        }

        guardando = false;

        Nav.NavigateTo(
            ContextoListado + (ContextoListado.Contains('?') ? "&" : "?") + $"detalle={profesionalId}&estado=creado"
        );
    }

    private void Cancelar()
    {
        Nav.NavigateTo(ContextoListado);
    }

    private void Volver()
    {
        Nav.NavigateTo(ContextoListado);
    }
}