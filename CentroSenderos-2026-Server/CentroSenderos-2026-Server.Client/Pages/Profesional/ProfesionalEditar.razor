@page "/profesionales/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="editar-profesional-page">

    <button type="button"
            class="back-button"
            disabled="@(guardando || eliminando)"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <div class="editar-title-row">
        <h1>Editar Profesional</h1>

        @if (!cargando && !errorCarga &&
             !string.IsNullOrWhiteSpace(modelo.RolAsignado))
        {
            <span class="rol-badge">
                <i class="bi bi-person-badge"></i>
                @ObtenerNombreRol(modelo.RolAsignado)
            </span>
        }

        @if (!cargando && !errorCarga && modelo.EsSocio)
        {
            <span class="socio-badge">
                <i class="bi bi-star-fill"></i>
                <span>Socio</span>
            </span>
        }
    </div>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del profesional...
        </div>
    }
    else if (errorCarga)
    {
        <div class="form-message" role="alert">
            @Mensaje
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarProfesionalForm"
                  class="profesional-form">

            <DataAnnotationsValidator />

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-2">
                    <div class="field-group">
                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />
                    </div>

                    <div class="field-group">
                        <label>CUIT</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Cuit"
                                   placeholder="Ej: 20-12345678-9" />

                        <ValidationMessage For="@(() => modelo.Cuit)"
                                           class="validation-message" />
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Profesional</span>
                </div>

                <div class="form-grid form-grid-3">
                    <div class="field-group prestaciones-field">
                        <label>Prestaciones</label>

                        <InputSelect class="form-input"
                                     @bind-Value="prestacionSeleccionadaId"
                                     @bind-Value:after="AgregarPrestacion"
                                     disabled="@(guardando || eliminando)">

                            <option value="">
                                -- Seleccionar prestación --
                            </option>

                            @foreach (var prestacion in PrestacionesDisponibles)
                            {
                                <option value="@prestacion.Id">
                                    @prestacion.Tipo
                                </option>
                            }
                        </InputSelect>

                        @if (modelo.TipoPrestacionIds.Count > 0)
                        {
                            <div class="prestaciones-seleccionadas">
                                @foreach (var prestacionId in modelo.TipoPrestacionIds)
                                {
                                    var prestacion = ObtenerPrestacion(prestacionId);

                                    if (prestacion is not null)
                                    {
                                        <div class="prestacion-chip">
                                            <span>@prestacion.Tipo</span>

                                            <button type="button"
                                                    class="prestacion-chip-remove"
                                                    title="Quitar prestación"
                                                    disabled="@(guardando || eliminando)"
                                                    @onclick="() => QuitarPrestacion(prestacion.Id)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <span class="prestaciones-help">
                                Todavía no hay prestaciones asignadas.
                            </span>
                        }
                    </div>

                    <div class="field-group">
                        <label for="areaProfesional">Área</label>

                        <InputSelect id="areaProfesional"
                                     class="form-input"
                                     @bind-Value="modelo.Area"
                                     @bind-Value:after="AlSeleccionarArea"
                                     disabled="@(guardando || eliminando || listaTipoAreas.Count == 0)">

                            <option value="">
                                -- Seleccionar área --
                            </option>

                            @foreach (var area in listaTipoAreas.OrderBy(x => x.Tipo))
                            {
                                <option value="@area.Tipo">
                                    @area.Tipo
                                </option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.Area)"
                                           class="validation-message" />

                        @if (!string.IsNullOrWhiteSpace(areaAnteriorSinCatalogo))
                        {
                            <span class="areas-help">
                                El área anterior «@areaAnteriorSinCatalogo»
                                no figura en el catálogo. Seleccioná una
                                de las áreas disponibles.
                            </span>
                        }
                        else if (listaTipoAreas.Count == 0)
                        {
                            <span class="areas-help">
                                No hay áreas disponibles. Cargá un tipo de área
                                desde Administración para poder editar este profesional.
                            </span>
                        }
                    </div>

                    <div class="field-group">
                        <label>M.P. (Matrícula Profesional)</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.MP"
                                   placeholder="Ingresar M.P." />

                        <ValidationMessage For="@(() => modelo.MP)"
                                           class="validation-message" />
                    </div>

                    <div class="field-group">
                        <label>R.N.P.</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.RNP"
                                   placeholder="Ingresar R.N.P." />

                        <ValidationMessage For="@(() => modelo.RNP)"
                                           class="validation-message" />
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>

                <div class="form-grid form-grid-2">
                    <div class="field-group">
                        <label>Teléfono</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Telefono"
                                   placeholder="Ej: +54 351 1234567" />

                        <ValidationMessage For="@(() => modelo.Telefono)"
                                           class="validation-message" />
                    </div>

                    <div class="field-group">
                        <label>Email</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Email"
                                   placeholder="Ej: profesional@senderos.com" />

                        <ValidationMessage For="@(() => modelo.Email)"
                                           class="validation-message" />
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">04</span>
                    <span>Usuario del Sistema</span>
                </div>

                <div class="form-grid form-grid-2">
                    <div class="field-group">
                        <label>Rol</label>

                        <InputSelect class="form-input"
                                     @bind-Value="modelo.RolAsignado"
                                     disabled="@(guardando || eliminando)">

                            <option value="">
                                -- Seleccionar rol --
                            </option>

                            <option value="admin">
                                Administrador
                            </option>

                            <option value="equipo">
                                Equipo
                            </option>

                            <option value="profesional">
                                Profesional
                            </option>

                            <option value="AdministradorEquipo">
                                Administrador/Equipo
                            </option>
                        </InputSelect>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message" role="alert">
                    @Mensaje
                </div>
            }

            <div class="form-actions">
                <button type="button"
                        class="delete-button"
                        disabled="@(guardando || eliminando)"
                        @onclick="AbrirConfirmacionEliminar">
                    <i class="bi bi-trash"></i>
                    <span>Eliminar Profesional</span>
                </button>

                <div class="form-actions-right">
                    <button type="button"
                            class="cancel-button"
                            disabled="@(guardando || eliminando)"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@(guardando || eliminando || listaTipoAreas.Count == 0)">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Profesional</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">
        <div class="delete-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloEliminarProfesional">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2 id="tituloEliminarProfesional">
                ¿Eliminar profesional?
            </h2>

            <p>
                ¿Estás seguro de que querés eliminar a
                <strong>@modelo.Nombre</strong>?
                El profesional dejará de aparecer entre los registros activos.
            </p>

            @if (!string.IsNullOrWhiteSpace(MensajeEliminar))
            {
                <div class="delete-error" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@MensajeEliminar</span>
                </div>
            }

            <div class="delete-modal-actions">
                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash"></i>
                        <span>Eliminar profesional</span>
                    }
                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }

    private ProfesionalDTO modelo = CrearModeloVacio();

    private List<TipoPrestacionListadoDTO> listaTipoPrestaciones = new();
    private List<TipoListadoDTO> listaTipoAreas = new();

    private int? prestacionSeleccionadaId;

    private bool cargando = true;
    private bool errorCarga;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string MensajeEliminar = string.Empty;
    private string rolOriginal = string.Empty;
    private string areaAnteriorSinCatalogo = string.Empty;

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesDisponibles =>
        listaTipoPrestaciones
            .Where(prestacion =>
                !modelo.TipoPrestacionIds.Contains(prestacion.Id))
            .OrderBy(prestacion => prestacion.Tipo);

    protected override async Task OnParametersSetAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        errorCarga = false;
        mostrarConfirmacionEliminar = false;
        Mensaje = string.Empty;
        MensajeEliminar = string.Empty;
        areaAnteriorSinCatalogo = string.Empty;
        listaTipoAreas = new();
        listaTipoPrestaciones = new();

        try
        {
            var prestacionesTask =
                Http.Get<List<TipoPrestacionListadoDTO>>(
                    "api/tipoprestacion/ListaTipoPrestacion");

            var areasTask =
                Http.Get<List<TipoListadoDTO>>(
                    "api/tipoarea/ListaTipoArea");

            var profesionalTask =
                Http.Get<ProfesionalDTO>(
                    $"api/profesional/{id}");

            await Task.WhenAll(
                prestacionesTask,
                areasTask,
                profesionalTask);

            var prestacionesResp = await prestacionesTask;
            var areasResp = await areasTask;
            var profesionalResp = await profesionalTask;

            if (profesionalResp.Error ||
                profesionalResp.Respuesta is null)
            {
                errorCarga = true;
                Mensaje = profesionalResp.Error
                    ? profesionalResp.ObtenerError()
                    : "No se encontró el profesional.";
                return;
            }

            modelo = profesionalResp.Respuesta;
            modelo.TipoPrestacionIds ??= new List<int>();
            modelo.TipoPrestacionNombres ??= new List<string>();
            rolOriginal = modelo.RolAsignado ?? string.Empty;

            if (!prestacionesResp.Error)
            {
                listaTipoPrestaciones =
                    prestacionesResp.Respuesta ?? new();
            }
            else
            {
                Mensaje = prestacionesResp.ObtenerError();
            }

            if (!areasResp.Error)
            {
                listaTipoAreas = areasResp.Respuesta ?? new();

                var areaRegistrada = listaTipoAreas.FirstOrDefault(
                    area => string.Equals(
                        area.Tipo,
                        modelo.Area?.Trim(),
                        StringComparison.OrdinalIgnoreCase));

                if (areaRegistrada is not null)
                {
                    modelo.Area = areaRegistrada.Tipo;
                }
                else if (!string.IsNullOrWhiteSpace(modelo.Area) &&
                         listaTipoAreas.Count > 0)
                {
                    areaAnteriorSinCatalogo = modelo.Area;
                    modelo.Area = string.Empty;
                }
            }
            else
            {
                Mensaje = areasResp.ObtenerError();
            }
        }
        catch
        {
            errorCarga = true;
            Mensaje =
                "No pudimos cargar los datos del profesional. Intentá nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AlSeleccionarArea()
    {
        areaAnteriorSinCatalogo = string.Empty;
    }

    private void AgregarPrestacion()
    {
        if (!prestacionSeleccionadaId.HasValue)
            return;

        var prestacionId = prestacionSeleccionadaId.Value;

        if (!modelo.TipoPrestacionIds.Contains(prestacionId))
            modelo.TipoPrestacionIds.Add(prestacionId);

        prestacionSeleccionadaId = null;
    }

    private void QuitarPrestacion(int prestacionId)
    {
        modelo.TipoPrestacionIds.Remove(prestacionId);
    }

    private TipoPrestacionListadoDTO? ObtenerPrestacion(int prestacionId)
    {
        return listaTipoPrestaciones.FirstOrDefault(
            prestacion => prestacion.Id == prestacionId);
    }

    private async Task Grabar()
    {
        if (guardando || eliminando)
            return;

        if (!listaTipoAreas.Any(area =>
                string.Equals(
                    area.Tipo,
                    modelo.Area,
                    StringComparison.Ordinal)))
        {
            Mensaje = "Seleccioná un área válida.";
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        try
        {
            var rolCambio = !string.Equals(
                modelo.RolAsignado ?? string.Empty,
                rolOriginal,
                StringComparison.OrdinalIgnoreCase);

            var resp = await Http.Put<ProfesionalDTO, RespuestaDTO>(
                $"api/profesional/{id}",
                modelo);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            if (rolCambio &&
                !string.IsNullOrWhiteSpace(modelo.RolAsignado))
            {
                var rolResp = await Http.Post<RolAsignacionDTO, string>(
                    "api/seguridad/asignarRol",
                    new RolAsignacionDTO
                    {
                        Email = modelo.Email,
                        Rol = modelo.RolAsignado
                    });

                if (rolResp.Error)
                {
                    Mensaje =
                        "Los datos del profesional se actualizaron, " +
                        "pero ocurrió un error al asignar el rol: " +
                        rolResp.ObtenerError();
                    return;
                }
            }

            Nav.NavigateTo(
                $"/profesionales/detalle/{id}?estado=actualizado");
        }
        catch
        {
            Mensaje =
                "No pudimos guardar los cambios. Intentá nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (guardando || eliminando)
            return;

        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        if (eliminando)
            return;

        MensajeEliminar = string.Empty;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (guardando || eliminando)
            return;

        eliminando = true;
        MensajeEliminar = string.Empty;

        try
        {
            var resp = await Http.Delete($"api/profesional/{id}");

            if (resp.Error)
            {
                MensajeEliminar = resp.ObtenerError();
                return;
            }

            mostrarConfirmacionEliminar = false;
            Nav.NavigateTo("/profesionales?estado=eliminado");
        }
        catch
        {
            MensajeEliminar =
                "No pudimos eliminar el profesional. Intentá nuevamente.";
        }
        finally
        {
            eliminando = false;
        }
    }

    private static string ObtenerNombreRol(string rol)
    {
        return rol switch
        {
            "admin" => "Administrador",
            "equipo" => "Equipo",
            "profesional" => "Profesional",
            "AdministradorEquipo" => "Administrador/Equipo",
            _ => rol
        };
    }

    private void Cancelar()
    {
        Nav.NavigateTo($"/profesionales/detalle/{id}");
    }

    private void Volver()
    {
        Nav.NavigateTo($"/profesionales/detalle/{id}");
    }

    private static ProfesionalDTO CrearModeloVacio()
    {
        return new ProfesionalDTO
        {
            Nombre = string.Empty,
            Area = string.Empty,
            Cuit = string.Empty,
            MP = string.Empty,
            RNP = string.Empty,
            Telefono = string.Empty,
            Email = string.Empty,
            RolAsignado = string.Empty,
            TipoPrestacionIds = new List<int>(),
            TipoPrestacionNombres = new List<string>()
        };
    }
}