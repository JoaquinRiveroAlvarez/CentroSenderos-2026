@page "/profesionales/editar/{id:int}"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="editar-profesional-page">



    <button type="button"
            class="back-button"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>


    <h1>Editar Profesional</h1>

    @if (cargando)
    {
        <div class="editar-loading">
            Cargando datos del profesional...
        </div>
    }
    else
    {
        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  FormName="EditarProfesionalForm"
                  class="profesional-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />


            <!-- =========================================
                 01 - INFORMACIÓN PERSONAL
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Nombre completo</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Nombre"
                                   placeholder="Nombre completo" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>CUIT</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Cuit"
                                   placeholder="Ej: 20-12345678-9" />

                        <ValidationMessage For="@(() => modelo.Cuit)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 02 - INFORMACIÓN PROFESIONAL
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Información Profesional</span>
                </div>

                <div class="form-grid form-grid-3">

                    <div class="field-group">

                        <label>Área</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Area"
                                   placeholder="Ej: Psicología" />

                        <ValidationMessage For="@(() => modelo.Area)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>M.P. (Matrícula Profesional)</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.MP"
                                   placeholder="Ingresar M.P." />

                        <ValidationMessage For="@(() => modelo.MP)"
                                           class="validation-message" />

                    </div>


                    <div class="field-group">

                        <label>R.N.P.</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.RNP"
                                   placeholder="Ingresar R.N.P." />

                        <ValidationMessage For="@(() => modelo.RNP)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 03 - DATOS DE CONTACTO
            ========================================== -->

            <section class="form-section">

                <div class="section-title">
                    <span class="section-number">03</span>
                    <span>Datos de Contacto</span>
                </div>

                <div class="form-grid form-grid-2">

                    <div class="field-group">

                        <label>Teléfono</label>

                        <InputText class="form-input"
                                   @bind-Value="modelo.Telefono"
                                   placeholder="Ej: +54 351 1234567" />

                        <ValidationMessage For="@(() => modelo.Telefono)"
                                           class="validation-message" />

                    </div>

                </div>

            </section>


            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    @Mensaje
                </div>
            }


            <!-- =========================================
                 ACCIONES
            ========================================== -->

            <div class="form-actions">

                <button type="button"
                        class="delete-button"
                        disabled="@eliminando"
                        @onclick="AbrirConfirmacionEliminar">
                    Eliminar Profesional
                </button>


                <div class="form-actions-right">

                    <button type="button"
                            class="cancel-button"
                            disabled="@guardando"
                            @onclick="Cancelar">
                        Cancelar
                    </button>


                    <button type="submit"
                            class="save-button"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Profesional</span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>


@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>¿Estás seguro que querés eliminar?</h2>

            <p>
                Por favor, confirmá que deseás eliminar definitivamente
                este profesional.
            </p>

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public int id { get; set; }


    private ProfesionalDTO modelo = CrearModeloVacio();

    private bool cargando = true;
    private bool guardando = false;
    private bool eliminando = false;
    private bool mostrarConfirmacionEliminar = false;

    private string Mensaje = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarProfesional();
    }


    private async Task CargarProfesional()
    {
        cargando = true;
        Mensaje = "";

        var resp = await Http.Get<ProfesionalDTO>(
            $"api/profesional/{id}"
        );

        if (!resp.Error && resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            modelo = CrearModeloVacio();
            Mensaje = resp.ObtenerError();
        }

        cargando = false;
    }


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = "";

        var resp = await Http.Put<ProfesionalDTO, RespuestaDTO>(
            $"api/profesional/{id}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo("/profesionales");
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        Mensaje = "";

        var resp = await Http.Delete(
            $"api/profesional/{id}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;
            Nav.NavigateTo("/profesionales");
        }
        else
        {
            Mensaje = resp.ObtenerError();
            mostrarConfirmacionEliminar = false;
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/profesionales");
    }


    private static ProfesionalDTO CrearModeloVacio()
    {
        return new ProfesionalDTO
        {
            Nombre = string.Empty,
            Area = string.Empty,
            Cuit = string.Empty,
            MP = string.Empty,
            RNP = string.Empty,
            Telefono = string.Empty
        };
    }

    private void Volver()
    {
        Nav.NavigateTo("/profesionales");
    }

}