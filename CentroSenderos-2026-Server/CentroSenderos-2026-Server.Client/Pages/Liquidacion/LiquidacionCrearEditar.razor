    }

    private void RecalcularMonto()
    {
        if (tipoModalidadId == 3)
        {
            montoFacturacion = (cantidadModCompleto * montoModCompleto) + (cantidadMedioMod * montoMedioMod);
        }
        else
        {
            montoFacturacion = cantidad * montoUnitario;
        }
        RecalcularRetencion();
    }

    private void RecalcularRetencion()
    {
        montoRetencion = Math.Round(montoFacturacion * (porcentajeRetencion / 100m), 2);
        cobroProfesional = montoFacturacion - montoRetencion;
        if (detalleIdEnEdicion > 0)
        {
            saldoPendiente = Math.Max(0m, montoRetencion - montoAbonadoExistente);
        }
        else
        {
            montoAbonadoExistente = 0;
            saldoPendiente = montoRetencion;
        }
    }

    // ======== DETECCIÓN Y EXPLICACIÓN DE MODIFICACIONES ========
    private decimal? ObtenerPrecioBaseReferencia()
    {
        if (origMontoUnitario.HasValue && origMontoUnitario.Value > 0)
            return origMontoUnitario.Value;

        var pr = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
        if (pr != null && pr.MontoSesion > 0)
            return pr.MontoSesion;

        return null;
    }

    private decimal? ObtenerPorcentajeBaseReferencia()
    {
        if (origPorcentaje.HasValue && origPorcentaje.Value > 0)
            return origPorcentaje.Value;

        var pr = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
        if (pr != null && pr.PorcentajeRetencion > 0)
            return pr.PorcentajeRetencion;

        return null;
    }

    private bool EsModalidadModificada() =>
        origTipoModalidadId.HasValue && origTipoModalidadId.Value != tipoModalidadId;

    private bool EsPacienteModificado() =>
        origPacienteId.HasValue && origPacienteId.Value > 0 && origPacienteId.Value != pacienteId;

    private bool EsPrestacionModificada() =>
        origTipoPrestacionId.HasValue && origTipoPrestacionId.Value > 0 && origTipoPrestacionId.Value != tipoPrestacionId;

    private bool EsObraSocialModificada()
    {
        if (!origTipoModalidadId.HasValue) return false;
        int? actualOS = tipoModalidadId == 2 && tipoObraSocialId > 0 ? tipoObraSocialId : null;
        return origTipoObraSocialId != actualOS && (origTipoObraSocialId.HasValue || actualOS.HasValue);
    }

    private bool EsPrecioUnitarioModificado()
    {
        var baseVal = ObtenerPrecioBaseReferencia();
        return baseVal.HasValue && Math.Abs(baseVal.Value - montoUnitario) > 0.01m;
    }

    private bool EsCantidadModificada() =>
        origCantidad.HasValue && origCantidad.Value > 0 && origCantidad.Value != cantidad;

    private bool EsCantidadModCompletoModificada() =>
        origCantidadModCompleto.HasValue && origCantidadModCompleto.Value != cantidadModCompleto;

    private bool EsMontoModCompletoModificado() =>
        origMontoModCompleto.HasValue && Math.Abs(origMontoModCompleto.Value - montoModCompleto) > 0.01m;

    private bool EsCantidadMedioModModificada() =>
        origCantidadMedioMod.HasValue && origCantidadMedioMod.Value != cantidadMedioMod;

    private bool EsMontoMedioModModificado() =>
        origMontoMedioMod.HasValue && Math.Abs(origMontoMedioMod.Value - montoMedioMod) > 0.01m;

    private bool EsPorcentajeModificado()
    {
        var basePorc = ObtenerPorcentajeBaseReferencia();
        return basePorc.HasValue && Math.Abs(basePorc.Value - porcentajeRetencion) > 0.01m;
    }

    private List<string> ConstruirListaDiferenciasDetalle()
    {
        var difs = new List<string>();

        if (EsModalidadModificada())
            difs.Add($"Modalidad: '{ObtenerNombreModalidad(tipoModalidadId)}' (original: '{ObtenerNombreModalidad(origTipoModalidadId!.Value)}').");

        if (EsPacienteModificado())
        {
            var actualPac = listaPacientes.FirstOrDefault(p => p.Id == pacienteId)?.Nombre ?? "Sin paciente";
            difs.Add($"Paciente: '{actualPac}' (original: '{origPacienteNombre ?? "N/D"}').");
        }

        if (EsPrestacionModificada())
        {
            var actualPrest = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId)?.Tipo ?? "Sin prestación";
            difs.Add($"Prestación: '{actualPrest}' (original: '{origTipoPrestacionNombre ?? "N/D"}').");
        }

        if (EsObraSocialModificada())
        {
            var actualOS = listaObrasSociales.FirstOrDefault(o => o.Id == tipoObraSocialId)?.Tipo ?? "Particular";
            difs.Add($"Obra Social: '{actualOS}' (original: '{origTipoObraSocialNombre ?? "Particular"}').");
        }

        if (tipoModalidadId == 3)
        {
            if (EsCantidadModCompletoModificada())
                difs.Add($"Cant. Módulos Completos: {cantidadModCompleto} (agenda/original: {origCantidadModCompleto}).");
            if (EsMontoModCompletoModificado())
                difs.Add($"Valor Módulo Completo: ${montoModCompleto:N0} (original: ${origMontoModCompleto:N0}).");
            if (EsCantidadMedioModModificada())
                difs.Add($"Cant. Medios Módulos: {cantidadMedioMod} (agenda/original: {origCantidadMedioMod}).");
            if (EsMontoMedioModModificado())
                difs.Add($"Valor Medio Módulo: ${montoMedioMod:N0} (original: ${origMontoMedioMod:N0}).");
        }
        else
        {
            if (EsPrecioUnitarioModificado())
            {
                var baseVal = ObtenerPrecioBaseReferencia()!.Value;
                difs.Add($"Valor unitario: ${montoUnitario:N0} (original: ${baseVal:N0}).");
            }
            if (EsCantidadModificada())
            {
                difs.Add($"Cantidad de sesiones: {cantidad} (en agenda/original: {origCantidad}).");
            }
        }

        if (EsPorcentajeModificado())
        {
            var basePorc = ObtenerPorcentajeBaseReferencia()!.Value;
            difs.Add($"% Retención Centro: {porcentajeRetencion:0.##}% (original: {basePorc:0.##}%).");
        }

        return difs;
    }

    private async Task AgregarOActualizarDetalle()
    {
        if (tipoModalidadId <= 2 && pacienteId <= 0)
        {
            MostrarAlerta("Debe seleccionar un paciente para esta modalidad.", "danger");
            return;
        }

        if (tipoModalidadId == 2 && tipoObraSocialId <= 0)
        {
            MostrarAlerta("Debe seleccionar una obra social para la modalidad Obra Social.", "danger");
            return;
        }

        if (montoFacturacion <= 0)
        {
            MostrarAlerta("El monto de facturación debe ser mayor a cero.", "danger");
            return;
        }

        if (!indiceDetalleEnEdicion.HasValue && EsFacturaActualYaGuardada())
        {
            MostrarAlerta("Este detalle ya se encuentra agregado a la liquidación. Editelo desde la tabla si necesita modificarlo.", "warning");
            return;
        }

        bool sinCoincidenciaAgenda = detalleActualSinCoincidenciaAgenda;
        string? avisoValidacion = null;
        string tipoAvisoValidacion = "success";

        // Si no tiene turnos de agenda vinculados (detalle manual) o es un alta manual, validar contra el calendario
        if (!indiceDetalleEnEdicion.HasValue && turnosIdsDetalleActual.Count == 0 && profesionalId > 0)
        {
            validandoDetalle = true;
            try
            {
                var turnosEnUso = detallesCargados.SelectMany(d => d.TurnosIds).Distinct().ToList();
                var req = new ValidarDetalleManualRequestDTO
                {
                    LiquidacionId = Id ?? 0,
                    ProfesionalId = profesionalId,
                    FechaDesde = fechaDesde,
                    FechaHasta = fechaHasta,
                    TipoModalidadId = tipoModalidadId,
                    PacienteId = tipoModalidadId <= 2 && pacienteId > 0 ? pacienteId : null,
                    TipoPrestacionId = tipoPrestacionId > 0 ? tipoPrestacionId : null,
                    TipoObraSocialId = tipoModalidadId == 2 && tipoObraSocialId > 0 ? tipoObraSocialId : null,
                    TurnosYaEnLiquidacionActual = turnosEnUso
                };

                var resVal = await Http.Post<ValidarDetalleManualRequestDTO, ValidarDetalleManualResponseDTO>("api/liquidacion/validar-detalle-manual", req);
                if (!resVal.Error && resVal.Respuesta != null)
                {
                    var val = resVal.Respuesta;
                    if (val.BloquearAgregado)
                    {
                        MostrarAlerta(val.Mensaje, "danger");
                        return;
                    }

                    if (val.EstadoCoincidencia == "CoincidePendiente")
                    {
                        turnosIdsDetalleActual = new List<int>(val.TurnosIdsCoincidentes);
                        turnosAsociadosDetalleActual = new List<TurnoLiquidacionItemDTO>(val.TurnosCoincidentes);
                        sinCoincidenciaAgenda = false;

                        // Establecer baseline desde la agenda si no existía
                        origTipoModalidadId ??= tipoModalidadId;
                        origPacienteId ??= (pacienteId > 0 ? pacienteId : null);
                        origPacienteNombre ??= listaPacientes.FirstOrDefault(p => p.Id == pacienteId)?.Nombre;
                        origTipoPrestacionId ??= (tipoPrestacionId > 0 ? tipoPrestacionId : null);
                        origTipoPrestacionNombre ??= listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId)?.Tipo;
                        origTipoObraSocialId ??= (tipoModalidadId == 2 && tipoObraSocialId > 0 ? tipoObraSocialId : null);
                        origTipoObraSocialNombre ??= listaObrasSociales.FirstOrDefault(o => o.Id == tipoObraSocialId)?.Tipo;
                        origCantidad = val.CantidadTurnosAgenda;
                        origCantidadModCompleto = val.CantidadModulosCompletosAgenda;
                        origCantidadMedioMod = val.CantidadMediosModulosAgenda;
                        if (val.MontoSugeridoAgenda.HasValue && val.MontoSugeridoAgenda.Value > 0)
                            origMontoUnitario ??= val.MontoSugeridoAgenda.Value;
                        if (val.PorcentajeRetencionAgenda.HasValue && val.PorcentajeRetencionAgenda.Value > 0)
                            origPorcentaje ??= val.PorcentajeRetencionAgenda.Value;

                        avisoValidacion = val.Mensaje;
                        tipoAvisoValidacion = "success";
                    }
                    else
                    {
                        sinCoincidenciaAgenda = true;
                        avisoValidacion = val.Mensaje;
                        tipoAvisoValidacion = "warning";
                    }
                }
            }
            finally
            {
                validandoDetalle = false;
            }
        }

        var pac = listaPacientes.FirstOrDefault(p => p.Id == pacienteId);
        var prest = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId);
        var os = listaObrasSociales.FirstOrDefault(o => o.Id == tipoObraSocialId);
        string modalidadTexto = ObtenerNombreModalidad(tipoModalidadId);

        var diferencias = ConstruirListaDiferenciasDetalle();
        bool valoresModificados = diferencias.Count > 0;
        string? resumenDif = valoresModificados ? string.Join(" • ", diferencias) : null;

        // Asegurar que exista snapshot base para futuras comparaciones si estaba vacío
        if (!origMontoUnitario.HasValue && prest != null && prest.MontoSesion > 0)
            origMontoUnitario = prest.MontoSesion;
        if (!origPorcentaje.HasValue && prest != null && prest.PorcentajeRetencion > 0)
            origPorcentaje = prest.PorcentajeRetencion;

        var nuevo = new GuardarDetalleLiquidacionDTO
        {
            Id = detalleIdEnEdicion,
            TipoModalidadId = tipoModalidadId,
            TipoModalidadNombre = modalidadTexto,
            PacienteId = tipoModalidadId <= 2 && pacienteId > 0 ? pacienteId : null,
            PacienteNombreCompleto = pac?.Nombre ?? (tipoModalidadId >= 3 ? "Uso Institucional / Alquiler" : ""),
            TipoPrestacionId = tipoPrestacionId > 0 ? tipoPrestacionId : null,
            TipoPrestacionNombre = prest?.Tipo ?? modalidadTexto,
            TipoObraSocialId = tipoModalidadId == 2 && tipoObraSocialId > 0 ? tipoObraSocialId : null,
            TipoObraSocialNombre = tipoModalidadId == 2 ? (os?.Tipo ?? "") : "",
            MontoUnitario = montoUnitario,
            Cantidad = tipoModalidadId == 3 ? (cantidadModCompleto + cantidadMedioMod) : cantidad,
            MontoModuloCompleto = cantidadModCompleto > 0 ? montoModCompleto : null,
            CantidadModuloCompleto = cantidadModCompleto > 0 ? cantidadModCompleto : null,
            MontoMedioModulo = cantidadMedioMod > 0 ? montoMedioMod : null,
            CantidadMedioModulo = cantidadMedioMod > 0 ? cantidadMedioMod : null,
            MontoFacturacion = montoFacturacion,
            Porcentaje = porcentajeRetencion,
            Retencion = montoRetencion,
            Saldo = detalleIdEnEdicion > 0 ? Math.Max(0m, montoRetencion - montoAbonadoExistente) : montoRetencion,
            EstadoPago = detalleIdEnEdicion > 0
                ? (Math.Max(0m, montoRetencion - montoAbonadoExistente) <= 0 ? EnumEstadoPagoLiquidacion.Pagado : (montoAbonadoExistente > 0 ? EnumEstadoPagoLiquidacion.Parcial : EnumEstadoPagoLiquidacion.Pendiente))
                : (montoRetencion <= 0 ? EnumEstadoPagoLiquidacion.Pagado : EnumEstadoPagoLiquidacion.Pendiente),
            TipoModalidadIdOriginal = origTipoModalidadId,
            TipoPrestacionIdOriginal = origTipoPrestacionId,
            TipoPrestacionNombreOriginal = origTipoPrestacionNombre,
            TipoObraSocialIdOriginal = origTipoObraSocialId,
            TipoObraSocialNombreOriginal = origTipoObraSocialNombre,
            PacienteIdOriginal = origPacienteId,
            PacienteNombreOriginal = origPacienteNombre,
            MontoUnitarioOriginal = origMontoUnitario,
            CantidadOriginal = origCantidad,
            MontoModuloCompletoOriginal = origMontoModCompleto,
            CantidadModuloCompletoOriginal = origCantidadModCompleto,
            MontoMedioModuloOriginal = origMontoMedioMod,
            CantidadMedioModuloOriginal = origCantidadMedioMod,
            PorcentajeOriginal = origPorcentaje,
            ValoresModificadosManualmente = valoresModificados,
            SinCoincidenciaAgenda = sinCoincidenciaAgenda,
            ResumenCambiosManuales = resumenDif,
            SesionesCobradas = indiceDetalleEnEdicion.HasValue ? detallesCargados[indiceDetalleEnEdicion.Value].SesionesCobradas : 0,
            TurnosIds = new List<int>(turnosIdsDetalleActual),
            TurnosAsociados = new List<TurnoLiquidacionItemDTO>(turnosAsociadosDetalleActual)
        };

        if (indiceDetalleEnEdicion.HasValue)
        {
            detallesCargados[indiceDetalleEnEdicion.Value] = nuevo;
            indiceDetalleEnEdicion = null;
            MostrarAlerta(
                valoresModificados
                    ? "Detalle actualizado. Se mantendrá el registro de las diferencias manuales."
                    : "Detalle actualizado correctamente.",
                valoresModificados ? "warning" : "success");
        }
        else
        {
            detallesCargados.Add(nuevo);
            if (!string.IsNullOrEmpty(avisoValidacion))
                MostrarAlerta($"Detalle agregado. {avisoValidacion}", tipoAvisoValidacion);
            else
                MostrarAlerta("Detalle agregado a la liquidación con éxito.", "success");
        }

        if (FacturasPendientesSinCargar().Count == 0 && string.IsNullOrEmpty(avisoValidacion))
        {
            seccionDetalleAbierta = false;
        }

        LimpiarFormularioDetalle();
        MarcarCambios();
    }

