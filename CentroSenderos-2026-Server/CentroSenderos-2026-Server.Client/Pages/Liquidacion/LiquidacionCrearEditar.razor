@page "/liquidaciones/crear"
@page "/liquidaciones/editar/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@using CentroSenderos_2026_Servicio.ServiciosHttp
@inject IHttpServicio Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="liq-create-container">
    <!-- Top Bar con Flecha Atrás y Estado -->
    <div class="top-nav-bar">
        <button type="button" class="btn-back-arrow" title="Volver al listado" @onclick="ManejarClickVolverAtras">
            <svg class="icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <div>
            <h1 class="page-main-title">@(Id.HasValue ? "Editar Liquidación" : "Nueva Liquidación")</h1>
            <span class="periodo-badge">Período: @fechaDesde.ToString("dd/MM/yyyy") - @fechaHasta.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="autosave-pill ms-auto">
            <svg class="icon-sm text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Estado: @(hayCambiosSinGuardar ? "Cambios pendientes" : "Al día")</span>
        </div>
    </div>

    <!-- Banner de Notificación / Error -->
    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alert-banner @(esErrorAlerta ? "alert-danger" : "alert-success")">
            <span>@mensajeAlerta</span>
            <button type="button" class="btn-close-alert" @onclick="() => mensajeAlerta = null">✕</button>
        </div>
    }

    <!-- 1. DATOS GENERALES DE LA LIQUIDACIÓN -->
    <div class="section-card">
        <div class="section-header">
            <svg class="icon-sm text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <h2 class="section-title">DATOS DE LA LIQUIDACIÓN</h2>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label-custom">PROFESIONAL</label>
                <select class="form-select custom-input" @bind="profesionalId" @bind:after="AlCambiarProfesionalOFechas">
                    <option value="0">Seleccionar Profesional...</option>
                    @foreach (var p in listaProfesionales)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">FECHA DESDE</label>
                <input type="date" class="form-control custom-input" @bind="fechaDesde" @bind:after="AlCambiarProfesionalOFechas" />
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">FECHA HASTA</label>
                <input type="date" class="form-control custom-input" @bind="fechaHasta" @bind:after="AlCambiarProfesionalOFechas" />
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">SOCIO RESPONSABLE</label>
                <select class="form-select custom-input" @bind="socioId" @bind:after="MarcarCambios">
                    <option value="0">Seleccionar Socio...</option>
                    @foreach (var s in listaSocios)
                    {
                        <option value="@s.Id">@s.Profesional</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- 2. SECCIÓN: CARGAR FACTURA (CON BOTONES EXACTOS DE LA PREVIEW) -->
    <div class="accordion-box">
        <div class="accordion-header-toggle">
            <div class="d-flex align-items-center gap-2" @onclick="() => seccionCargarFacturaAbierta = !seccionCargarFacturaAbierta" style="cursor: pointer;">
                <svg class="icon-toggle @(seccionCargarFacturaAbierta ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                <span class="accordion-title">@(indiceDetalleEnEdicion.HasValue ? "EDITANDO FACTURA" : "CARGAR FACTURA")</span>
                @if (indiceDetalleEnEdicion.HasValue)
                {
                    <span class="badge-modo-edicion">Modo Edición</span>
                }
            </div>

            <!-- Botonera superior de acciones de agenda -->
            <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                <!-- Badge: Factura ya guardada si está en la lista -->
                @if (EsFacturaActualYaGuardada())
                {
                    <span class="badge-ya-guardada">
                        <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Factura ya guardada
                    </span>
                }

                <!-- Botón Desplegable: Facturas por liquidar (X) -->
                <div class="position-relative">
                    <button type="button"
                            class="btn-facturas-pendientes @(FacturasPendientesSinCargar().Count > 0 ? "btn-has-pending" : "btn-empty-pending")"
                            @onclick="() => mostrarMenuFacturasPendientes = !mostrarMenuFacturasPendientes"
                            title="Ver facturas agrupadas pendientes en la agenda">
                        <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <span>Facturas por liquidar (@FacturasPendientesSinCargar().Count)</span>
                        <svg class="icon-xs ms-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>

                    <!-- Popup emergente de Facturas por Liquidar -->
                    @if (mostrarMenuFacturasPendientes)
                    {
                        <div class="dropdown-pending-invoices">
                            <div class="dropdown-pending-header">
                                <div>
                                    <strong class="d-block text-xs">Facturas por liquidar (@FacturasPendientesSinCargar().Count)</strong>
                                    <span class="text-muted text-[11px]">Turnos agrupados según agenda</span>
                                </div>
                                <button type="button" class="btn-close-sm" @onclick="() => mostrarMenuFacturasPendientes = false">✕</button>
                            </div>
                            <div class="dropdown-pending-body">
                                @if (FacturasPendientesSinCargar().Count == 0)
                                {
                                    <p class="text-center text-muted py-3 text-xs">Todos los turnos de este profesional en el período ya fueron cargados.</p>
                                }
                                else
                                {
                                    @foreach (var fac in FacturasPendientesSinCargar())
                                    {
                                        <div class="pending-group-item" @onclick="() => CargarFacturaDesdeGrupo(fac)">
                                            <div>
                                                <div class="fw-bold text-dark">@fac.PacienteNombre</div>
                                                <div class="text-muted text-[11px]">
                                                    @fac.ModalidadNombre @(!string.IsNullOrEmpty(fac.ObraSocialNombre) ? $"({fac.ObraSocialNombre})" : "") • @fac.PrestacionNombre • <strong>@fac.CantidadTurnos turnos</strong>
                                                </div>
                                            </div>
                                            <span class="badge-cargar-mini">Cargar ⚡</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Botón: Cargar Próxima Factura -->
                <button type="button" class="btn-proxima-factura" @onclick="CargarProximaFactura" title="Carga automáticamente la primera factura agrupada pendiente">
                    <svg class="icon-xs text-amber" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    <span>Cargar Próxima Factura</span>
                </button>

                <!-- Botón: Listado de Sesiones en Agenda -->
                <button type="button" class="btn-ver-sesiones-header" @onclick="VerSesionesAgendaDesdeFormulario" title="Auditar las sesiones de la factura seleccionada">
                    <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>Listado de Sesiones</span>
                </button>
            </div>
        </div>

        @if (seccionCargarFacturaAbierta)
        {
            <div class="accordion-content">
                <!-- Selector de Modalidad -->
                <div class="mb-3">
                    <label class="form-label-custom">MODALIDAD</label>
                    <div class="modalidad-pill-group">
                        <button type="button" class="btn-pill @(tipoModalidadId == 1 ? "active" : "")" @onclick="() => CambiarModalidad(1)">Particular</button>
                        <button type="button" class="btn-pill @(tipoModalidadId == 2 ? "active" : "")" @onclick="() => CambiarModalidad(2)">Obra Social</button>
                        <button type="button" class="btn-pill @(tipoModalidadId == 3 ? "active" : "")" @onclick="() => CambiarModalidad(3)">Módulos</button>
                        <button type="button" class="btn-pill @(tipoModalidadId == 4 ? "active" : "")" @onclick="() => CambiarModalidad(4)">Por Hora</button>
                        <button type="button" class="btn-pill @(tipoModalidadId == 5 ? "active" : "")" @onclick="() => CambiarModalidad(5)">Taller</button>
                    </div>
                </div>

                <!-- Campos dinámicos según Modalidad -->
                <div class="row g-3 mb-3">
                    @if (tipoModalidadId == 1 || tipoModalidadId == 2)
                    {
                        <div class="col-md-3">
                            <label class="form-label-custom">PACIENTE</label>
                            <select class="form-select custom-input" @bind="pacienteId" @bind:after="RecalcularMonto">
                                <option value="0">Seleccionar Paciente...</option>
                                @foreach (var pac in listaPacientes)
                                {
                                    <option value="@pac.Id">@pac.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">PRESTACIÓN</label>
                            <select class="form-select custom-input" @bind="tipoPrestacionId" @bind:after="RecalcularMonto">
                                <option value="0">Seleccionar Prestación...</option>
                                @foreach (var pr in listaPrestaciones)
                                {
                                    <option value="@pr.Id">@pr.Tipo</option>
                                }
                            </select>
                        </div>
                        @if (tipoModalidadId == 2)
                        {
                            <div class="col-md-3">
                                <label class="form-label-custom">OBRA SOCIAL</label>
                                <select class="form-select custom-input" @bind="tipoObraSocialId">
                                    <option value="0">Seleccionar Obra Social...</option>
                                    @foreach (var os in listaObrasSociales)
                                    {
                                        <option value="@os.Id">@os.Tipo</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-3">
                            <label class="form-label-custom">VALOR SESIÓN ($)</label>
                            <input type="number" step="0.01" class="form-control custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-custom">CANTIDAD SESIONES</label>
                            <input type="number" min="1" class="form-control custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                        </div>
                    }
                    else if (tipoModalidadId == 3)
                    {
                        <!-- MÓDULOS -->
                        <div class="col-md-3">
                            <label class="form-label-custom">CANT. MÓDULOS COMPLETOS</label>
                            <input type="number" min="0" class="form-control custom-input" @bind="cantidadModCompleto" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">VALOR MÓDULO COMPLETO ($)</label>
                            <input type="number" step="0.01" class="form-control custom-input" @bind="montoModCompleto" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">CANT. MEDIOS MÓDULOS</label>
                            <input type="number" min="0" class="form-control custom-input" @bind="cantidadMedioMod" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">VALOR MEDIO MÓDULO ($)</label>
                            <input type="number" step="0.01" class="form-control custom-input" @bind="montoMedioMod" @bind:after="RecalcularMonto" />
                        </div>
                    }
                    else if (tipoModalidadId == 4)
                    {
                        <!-- POR HORA -->
                        <div class="col-md-6">
                            <label class="form-label-custom">CANTIDAD DE HORAS</label>
                            <input type="number" min="1" class="form-control custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">VALOR POR HORA ($)</label>
                            <input type="number" step="0.01" class="form-control custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                        </div>
                    }
                    else if (tipoModalidadId == 5)
                    {
                        <!-- TALLER -->
                        <div class="col-md-4">
                            <label class="form-label-custom">TALLER</label>
                            <select class="form-select custom-input" @bind="tipoPrestacionId">
                                <option value="0">Seleccionar Taller...</option>
                                @foreach (var pr in listaPrestaciones)
                                {
                                    <option value="@pr.Id">@pr.Tipo</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">CANTIDAD</label>
                            <input type="number" min="1" class="form-control custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">PRECIO POR TALLER ($)</label>
                            <input type="number" step="0.01" class="form-control custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                        </div>
                    }
                </div>

                <!-- Bloque Financiero y de Retención -->
                <div class="finance-strip">
                    <div class="finance-item">
                        <label>MONTO FACTURACIÓN</label>
                        <span class="fs-5 fw-bold text-dark">$@montoFacturacion.ToString("N2")</span>
                    </div>
                    <div class="finance-item">
                        <label>% RETENCIÓN</label>
                        <input type="number" min="0" max="100" step="0.5" class="form-control custom-input-sm" @bind="porcentajeRetencion" @bind:after="RecalcularRetencion" />
                    </div>
                    <div class="finance-item">
                        <label>RETENCIÓN ($)</label>
                        <span class="fs-5 fw-bold text-danger">-$@montoRetencion.ToString("N2")</span>
                    </div>
                    <div class="finance-item">
                        <label>TOTAL A LIQUIDAR</label>
                        <span class="fs-5 fw-bold text-success">$@montoTotalALiquidar.ToString("N2")</span>
                    </div>
                    <div class="finance-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <label>PAGA ($)</label>
                            <button type="button" class="btn-pagar-todo" @onclick="PagarTodo">Pagar todo</button>
                        </div>
                        <input type="number" step="0.01" min="0" max="@montoTotalALiquidar" class="form-control custom-input-sm" @bind="montoPagado" @bind:after="RecalcularSaldo" />
                    </div>
                    <div class="finance-item">
                        <label>SALDO PENDIENTE</label>
                        <span class="fs-5 fw-bold @(saldoPendiente > 0 ? "text-danger" : "text-success")">$@saldoPendiente.ToString("N2")</span>
                    </div>
                </div>

                <!-- Botón de acción: Agregar o Actualizar Factura -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    @if (indiceDetalleEnEdicion.HasValue)
                    {
                        <button type="button" class="btn-cancel-edit" @onclick="CancelarEdicionDetalle">Cancelar Edición</button>
                    }
                    <button type="button" class="btn-add-detalle" @onclick="AgregarOActualizarDetalle">
                        @(indiceDetalleEnEdicion.HasValue ? "Actualizar Factura" : "Agregar Factura a la Liquidación")
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- 3. LISTADO DE FACTURAS CARGADAS EN ESTA LIQUIDACIÓN -->
    <div class="section-card mt-3">
        <div class="section-header justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon-sm text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <h2 class="section-title">FACTURAS CARGADAS EN LA LIQUIDACIÓN (@detallesCargados.Count)</h2>
            </div>
        </div>

        @if (detallesCargados.Count == 0)
        {
            <div class="empty-state-box">
                <p>No has agregado facturas todavía. Utiliza el botón <strong>"Cargar Próxima Factura"</strong> o selecciona una desde <strong>"Facturas por liquidar"</strong>.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-detalles">
                    <thead>
                        <tr>
                            <th>Modalidad</th>
                            <th>Paciente / Concepto</th>
                            <th>Prestación / OS</th>
                            <th class="text-end">Facturación</th>
                            <th class="text-end">Retención</th>
                            <th class="text-end">Saldo Pend.</th>
                            <th class="text-center">Estado Pago</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < detallesCargados.Count; i++)
                        {
                            var index = i;
                            var d = detallesCargados[index];
                            <tr>
                                <td><span class="badge-modalidad">@d.TipoModalidadNombre</span></td>
                                <td class="fw-bold">@(!string.IsNullOrEmpty(d.PacienteNombreCompleto) ? d.PacienteNombreCompleto : "Sin paciente")</td>
                                <td>
                                    <span>@d.TipoPrestacionNombre</span>
                                    @if (!string.IsNullOrEmpty(d.TipoObraSocialNombre))
                                    {
                                        <span class="text-muted d-block text-xs">@d.TipoObraSocialNombre</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">$@d.MontoFacturacion.ToString("N2")</td>
                                <td class="text-end text-danger">-$@d.Retencion.ToString("N2") (@d.Porcentaje%)</td>
                                <td class="text-end fw-bold @(d.Saldo > 0 ? "text-danger" : "text-success")">$@d.Saldo.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge-estado-pago @d.EstadoPago.ToString().ToLower()">@d.EstadoPago</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn-icon-sub" title="Ver sesiones" @onclick="() => AbrirModalSesiones(d)">
                                            <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                        </button>
                                        <button type="button" class="btn-icon-sub" title="Editar factura" @onclick="() => EditarDetalle(index)">
                                            <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                        </button>
                                        <button type="button" class="btn-icon-sub text-danger" title="Eliminar factura" @onclick="() => EliminarDetalle(index)">
                                            <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen Totalizador al Pie -->
            <div class="totales-bar">
                <div class="tot-item">
                    <span>TOTAL FACTURADO</span>
                    <strong>$@detallesCargados.Sum(x => x.MontoFacturacion).ToString("N2")</strong>
                </div>
                <div class="tot-item text-danger">
                    <span>RETENCIÓN TOTAL</span>
                    <strong>-$@detallesCargados.Sum(x => x.Retencion).ToString("N2")</strong>
                </div>
                <div class="tot-item text-success">
                    <span>SALDO PENDIENTE TOTAL</span>
                    <strong>$@detallesCargados.Sum(x => x.Saldo).ToString("N2")</strong>
                </div>
                <div class="ms-auto">
                    <button type="button" class="btn-guardar-principal" @onclick="GuardarLiquidacionFinal" disabled="@guardando">
                        <svg class="icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                        <span>@(guardando ? "Guardando en Neon..." : "GUARDAR LIQUIDACIÓN")</span>
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- MODAL: Auditoría de Sesiones -->
    @if (mostrarModalSesiones && detalleParaSesiones != null)
    {
        <div class="modal-backdrop-custom">
            <div class="modal-card">
                <div class="modal-header-custom">
                    <h3 class="modal-title">Sesiones en Agenda: @detalleParaSesiones.PacienteNombreCompleto</h3>
                    <button type="button" class="btn-close-modal" @onclick="() => mostrarModalSesiones = false">✕</button>
                </div>
                <div class="modal-body-custom">
                    @if (turnosSesionModal.Count == 0)
                    {
                        <p class="text-center py-4 text-muted">No se encontraron sesiones registradas en la agenda para los parámetros seleccionados.</p>
                    }
                    else
                    {
                        <table class="table-sesiones">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Fecha</th>
                                    <th>Horario</th>
                                    <th>Consultorio</th>
                                    <th>Estado Asistencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in turnosSesionModal)
                                {
                                    <tr>
                                        <td><strong>#@t.NumeroSesion</strong></td>
                                        <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@t.HoraInicio.ToString("HH:mm") - @t.HoraFin.ToString("HH:mm")</td>
                                        <td>@t.ConsultorioNombre</td>
                                        <td><span class="badge-asistencia">@t.EstadoTurno</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalSesiones = false">Cerrar</button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: Salir sin guardar -->
    @if (mostrarModalSalir)
    {
        <div class="modal-backdrop-custom">
            <div class="modal-card modal-sm">
                <div class="modal-header-custom">
                    <h3 class="modal-title">Cambios sin guardar</h3>
                    <button type="button" class="btn-close-modal" @onclick="() => mostrarModalSalir = false">✕</button>
                </div>
                <div class="modal-body-custom">
                    <p>Tienes facturas o modificaciones en la liquidación que aún no has guardado en el servidor.</p>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalSalir = false">Cancelar</button>
                    <button type="button" class="btn-secondary-custom text-danger" @onclick="DescartarYSalir">Descartar</button>
                    <button type="button" class="btn-nueva-liq" @onclick="GuardarYSalir">Guardar y Salir</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    // Fechas y cabecera
    private DateTime fechaDesde = DateTime.UtcNow.AddMonths(-1);
    private DateTime fechaHasta = DateTime.UtcNow;
    private int profesionalId = 0;
    private int socioId = 0;
    private string? numeroLiquidacion;

    // Listas de apoyo
    private List<ProfesionalListadoDTO> listaProfesionales = new();
    private List<SocioListadoDTO> listaSocios = new();
    private List<PacienteResumenDTO> listaPacientes = new();
    private List<TipoPrestacionDTO> listaPrestaciones = new();
    private List<TipoObraSocialDTO> listaObrasSociales = new();

    // Facturas en borrador de la liquidación actual
    private List<GuardarDetalleLiquidacionDTO> detallesCargados = new();

    // Facturas pendientes detectadas de la agenda
    private List<FacturaAgrupadaView> facturasAgenda = new();
    private bool mostrarMenuFacturasPendientes = false;

    // Formulario de Detalle activo
    private bool seccionCargarFacturaAbierta = true;
    private int? indiceDetalleEnEdicion = null;
    private int tipoModalidadId = 1; // 1: Particular, 2: Obra Social, 3: Módulos, 4: Por Hora, 5: Taller
    private int? pacienteId;
    private int? tipoPrestacionId;
    private int? tipoObraSocialId;
    private decimal montoUnitario = 0;
    private int cantidad = 1;

    // Específico Módulos
    private int cantidadModCompleto = 0;
    private decimal montoModCompleto = 0;
    private int cantidadMedioMod = 0;
    private decimal montoMedioMod = 0;

    // Cálculos financieros
    private decimal montoFacturacion = 0;
    private decimal porcentajeRetencion = 20; // 20% habitual
    private decimal montoRetencion = 0;
    private decimal montoTotalALiquidar = 0;
    private decimal montoPagado = 0;
    private decimal saldoPendiente = 0;
    private List<int> turnosIdsDetalleActual = new();

    // Modales y estados
    private bool hayCambiosSinGuardar = false;
    private bool guardando = false;
    private bool mostrarModalSalir = false;
    private bool mostrarModalSesiones = false;
    private GuardarDetalleLiquidacionDTO? detalleParaSesiones = null;
    private List<TurnoLiquidacionItemDTO> turnosSesionModal = new();

    private string? mensajeAlerta;
    private bool esErrorAlerta;

    public class FacturaAgrupadaView
    {
        public string ClaveGrupo { get; set; } = string.Empty;
        public int TipoModalidadId { get; set; }
        public string ModalidadNombre { get; set; } = string.Empty;
        public int? PacienteId { get; set; }
        public string PacienteNombre { get; set; } = string.Empty;
        public int? PrestacionId { get; set; }
        public string PrestacionNombre { get; set; } = string.Empty;
        public int? ObraSocialId { get; set; }
        public string? ObraSocialNombre { get; set; }
        public decimal MontoSugerido { get; set; }
        public int CantidadTurnos { get; set; }
        public List<int> TurnosIds { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDesplegables();

        if (Id.HasValue && Id.Value > 0)
        {
            await CargarLiquidacionExistente(Id.Value);
        }
        else
        {
            // Fecha del mes anterior predeterminada
            var hoy = DateTime.UtcNow;
            fechaDesde = new DateTime(hoy.Year, hoy.Month, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(-1);
            fechaHasta = new DateTime(hoy.Year, hoy.Month, DateTime.DaysInMonth(hoy.Year, hoy.Month), 23, 59, 59, DateTimeKind.Utc);
        }
    }

    private async Task CargarDesplegables()
    {
        try
        {
            var resProf = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
            if (!resProf.Error && resProf.Respuesta != null) listaProfesionales = resProf.Respuesta;

            var resSocios = await Http.Get<List<SocioListadoDTO>>("api/socio/ListaSocio");
            if (!resSocios.Error && resSocios.Respuesta != null) listaSocios = resSocios.Respuesta;

            var resPac = await Http.Get<List<PacienteResumenDTO>>("api/paciente/ListaPaciente");
            if (!resPac.Error && resPac.Respuesta != null) listaPacientes = resPac.Respuesta;

            var resPres = await Http.Get<List<TipoPrestacionDTO>>("api/tipoprestacion/ListaTipoPrestacion");
            if (!resPres.Error && resPres.Respuesta != null) listaPrestaciones = resPres.Respuesta;

            var resOS = await Http.Get<List<TipoObraSocialDTO>>("api/tipoobrasocial/ListaTipoObraSocial");
            if (!resOS.Error && resOS.Respuesta != null) listaObrasSociales = resOS.Respuesta;
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error al cargar datos maestros: " + ex.Message, true);
        }
    }

    private async Task CargarLiquidacionExistente(int id)
    {
        try
        {
            var res = await Http.Get<LiquidacionDTO>($"api/liquidacion/{id}");
            if (!res.Error && res.Respuesta != null)
            {
                var l = res.Respuesta;
                numeroLiquidacion = l.NumeroLiquidacion;
                profesionalId = l.ProfesionalId;
                socioId = l.SocioId;
                fechaDesde = l.FechaDesde;
                fechaHasta = l.FechaHasta;

                detallesCargados = l.Detalles.Select(d => new GuardarDetalleLiquidacionDTO
                {
                    Id = d.Id,
                    TipoModalidadId = d.TipoModalidadId,
                    TipoModalidadNombre = d.TipoModalidadNombre,
                    TipoPrestacionId = d.TipoPrestacionId,
                    TipoPrestacionNombre = d.TipoPrestacionNombre,
                    TipoObraSocialId = d.TipoObraSocialId,
                    TipoObraSocialNombre = d.TipoObraSocialNombre,
                    PacienteId = d.PacienteId,
                    PacienteNombreCompleto = d.PacienteNombreCompleto,
                    MontoUnitario = d.MontoUnitario,
                    Cantidad = d.Cantidad,
                    MontoModuloCompleto = d.MontoModuloCompleto,
                    CantidadModuloCompleto = d.CantidadModuloCompleto,
                    MontoMedioModulo = d.MontoMedioModulo,
                    CantidadMedioModulo = d.CantidadMedioModulo,
                    MontoFacturacion = d.MontoFacturacion,
                    Porcentaje = d.Porcentaje,
                    Retencion = d.Retencion,
                    Saldo = d.Saldo,
                    EstadoPago = d.EstadoPago,
                    Observaciones = d.Observaciones
                }).ToList();

                await AlCambiarProfesionalOFechas();
                hayCambiosSinGuardar = false;
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error al cargar la liquidación: " + ex.Message, true);
        }
    }

    private async Task AlCambiarProfesionalOFechas()
    {
        MarcarCambios();
        if (profesionalId <= 0)
        {
            facturasAgenda.Clear();
            return;
        }

        try
        {
            // Consultar turnos pendientes para agrupar
            var url = $"api/liquidacion/turnos-pendientes?profesionalId={profesionalId}&fechaDesde={fechaDesde:yyyy-MM-dd}&fechaHasta={fechaHasta:yyyy-MM-dd}";
            var res = await Http.Get<List<TurnoLiquidacionItemDTO>>(url);

            facturasAgenda.Clear();
            if (!res.Error && res.Respuesta != null && res.Respuesta.Count > 0)
            {
                // Agrupamos por paciente y prestación
                var grupos = res.Respuesta.GroupBy(t => new { t.ConsultorioNombre, t.TipoTurnoNombre });
                int contador = 1;

                foreach (var g in grupos)
                {
                    var primero = g.First();
                    facturasAgenda.Add(new FacturaAgrupadaView
                    {
                        ClaveGrupo = $"grupo-{contador++}",
                        TipoModalidadId = 1, // Particular por defecto
                        ModalidadNombre = "Particular",
                        PacienteId = listaPacientes.FirstOrDefault()?.Id,
                        PacienteNombre = primero.ConsultorioNombre ?? "Paciente de Agenda",
                        PrestacionId = listaPrestaciones.FirstOrDefault()?.Id,
                        PrestacionNombre = primero.TipoTurnoNombre ?? "Sesión Estándar",
                        MontoSugerido = 15000,
                        CantidadTurnos = g.Count(),
                        TurnosIds = g.Select(x => x.TurnoId).ToList()
                    });
                }
            }
        }
        catch
        {
            // Fallback si no hay turnos registrados en ese período
            facturasAgenda.Clear();
        }
    }

    // CONTROL ANTI-DUPLICADOS: Retorna solo las facturas de agenda que aún NO fueron cargadas a la lista
    private List<FacturaAgrupadaView> FacturasPendientesSinCargar()
    {
        var turnosYaCargados = detallesCargados.SelectMany(d => d.TurnosIds).ToHashSet();
        return facturasAgenda.Where(f => !f.TurnosIds.Any(id => turnosYaCargados.Contains(id))).ToList();
    }

    // Indica si la factura que está actualmente en el formulario ya existe en la lista de detalles
    private bool EsFacturaActualYaGuardada()
    {
        if (indiceDetalleEnEdicion.HasValue) return true;
        if (turnosIdsDetalleActual.Count > 0)
        {
            var turnosYaCargados = detallesCargados.SelectMany(d => d.TurnosIds).ToHashSet();
            return turnosIdsDetalleActual.Any(id => turnosYaCargados.Contains(id));
        }
        if (pacienteId.HasValue && pacienteId.Value > 0)
        {
            return detallesCargados.Any(d => d.PacienteId == pacienteId && d.TipoModalidadId == tipoModalidadId && d.TipoPrestacionId == tipoPrestacionId);
        }
        return false;
    }

    private void CargarProximaFactura()
    {
        var pendientes = FacturasPendientesSinCargar();
        if (pendientes.Count == 0)
        {
            MostrarAlerta("¡No hay más facturas pendientes por liquidar para este profesional en este período!", false);
            return;
        }
        CargarFacturaDesdeGrupo(pendientes[0]);
    }

    private void CargarFacturaDesdeGrupo(FacturaAgrupadaView fac)
    {
        mostrarMenuFacturasPendientes = false;
        seccionCargarFacturaAbierta = true;
        indiceDetalleEnEdicion = null;

        tipoModalidadId = fac.TipoModalidadId;
        pacienteId = fac.PacienteId;
        tipoPrestacionId = fac.PrestacionId;
        tipoObraSocialId = fac.ObraSocialId;
        montoUnitario = fac.MontoSugerido > 0 ? fac.MontoSugerido : 15000;
        cantidad = fac.CantidadTurnos;
        turnosIdsDetalleActual = new List<int>(fac.TurnosIds);

        RecalcularMonto();
        MostrarAlerta($"Cargada factura de {fac.PacienteNombre} ({fac.CantidadTurnos} turnos agrupados).", false);
    }

    private void CambiarModalidad(int nuevaMod)
    {
        tipoModalidadId = nuevaMod;
        RecalcularMonto();
        MarcarCambios();
    }

    private void RecalcularMonto()
    {
        if (tipoModalidadId == 3) // Módulos
        {
            montoFacturacion = (cantidadModCompleto * montoModCompleto) + (cantidadMedioMod * montoMedioMod);
        }
        else
        {
            montoFacturacion = cantidad * montoUnitario;
        }

        RecalcularRetencion();
    }

    private void RecalcularRetencion()
    {
        montoRetencion = Math.Round(montoFacturacion * (porcentajeRetencion / 100m), 2);
        montoTotalALiquidar = montoFacturacion - montoRetencion;
        RecalcularSaldo();
    }

    private void PagarTodo()
    {
        montoPagado = montoTotalALiquidar;
        RecalcularSaldo();
    }

    private void RecalcularSaldo()
    {
        if (montoPagado > montoTotalALiquidar) montoPagado = montoTotalALiquidar;
        saldoPendiente = Math.Max(0, montoTotalALiquidar - montoPagado);
        MarcarCambios();
    }

    private void AgregarOActualizarDetalle()
    {
        // CONTROL ANTI-DUPLICADOS ESTRICTO
        if (!indiceDetalleEnEdicion.HasValue && EsFacturaActualYaGuardada())
        {
            MostrarAlerta("Esta factura ya fue cargada en la liquidación actual. Puedes editarla directamente desde la tabla inferior.", true);
            return;
        }

        if (montoFacturacion <= 0)
        {
            MostrarAlerta("El monto de facturación debe ser mayor a 0.", true);
            return;
        }

        string modalidadNombre = tipoModalidadId switch
        {
            1 => "Particular",
            2 => "Obra Social",
            3 => "Módulos",
            4 => "Por Hora",
            5 => "Taller",
            _ => "General"
        };

        var pac = listaPacientes.FirstOrDefault(p => p.Id == pacienteId);
        var pr = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId);
        var os = listaObrasSociales.FirstOrDefault(o => o.Id == tipoObraSocialId);

        EnumEstadoPagoLiquidacion estadoPagoFila = saldoPendiente <= 0 ? EnumEstadoPagoLiquidacion.Pagado
                                                 : (montoPagado > 0 ? EnumEstadoPagoLiquidacion.Parcial : EnumEstadoPagoLiquidacion.Pendiente);

        var nuevo = new GuardarDetalleLiquidacionDTO
        {
            Id = 0,
            TipoModalidadId = tipoModalidadId,
            TipoModalidadNombre = modalidadNombre,
            TipoPrestacionId = tipoPrestacionId,
            TipoPrestacionNombre = pr?.Tipo ?? (tipoModalidadId == 3 ? "Alquiler Módulos" : "Servicio"),
            TipoObraSocialId = tipoObraSocialId,
            TipoObraSocialNombre = os?.Tipo,
            PacienteId = pacienteId,
            PacienteNombreCompleto = pac?.Nombre ?? (tipoModalidadId == 3 ? "Alquiler Consultorio" : "Particular"),
            MontoUnitario = montoUnitario,
            Cantidad = cantidad,
            MontoModuloCompleto = tipoModalidadId == 3 ? montoModCompleto : null,
            CantidadModuloCompleto = tipoModalidadId == 3 ? cantidadModCompleto : null,
            MontoMedioModulo = tipoModalidadId == 3 ? montoMedioMod : null,
            CantidadMedioModulo = tipoModalidadId == 3 ? cantidadMedioMod : null,
            MontoFacturacion = montoFacturacion,
            Porcentaje = porcentajeRetencion,
            Retencion = montoRetencion,
            Saldo = saldoPendiente,
            EstadoPago = estadoPagoFila,
            TurnosIds = new List<int>(turnosIdsDetalleActual)
        };

        if (indiceDetalleEnEdicion.HasValue)
        {
            detallesCargados[indiceDetalleEnEdicion.Value] = nuevo;
            indiceDetalleEnEdicion = null;
            MostrarAlerta("Factura actualizada exitosamente.", false);
        }
        else
        {
            detallesCargados.Add(nuevo);
            MostrarAlerta("Factura agregada a la liquidación.", false);
        }

        // Limpiar para la próxima carga
        turnosIdsDetalleActual.Clear();
        montoPagado = 0;
        saldoPendiente = 0;
        montoFacturacion = 0;
        montoRetencion = 0;
        montoTotalALiquidar = 0;
        MarcarCambios();
    }

    private void EditarDetalle(int index)
    {
        var d = detallesCargados[index];
        indiceDetalleEnEdicion = index;
        seccionCargarFacturaAbierta = true;

        tipoModalidadId = d.TipoModalidadId;
        pacienteId = d.PacienteId;
        tipoPrestacionId = d.TipoPrestacionId;
        tipoObraSocialId = d.TipoObraSocialId;
        montoUnitario = d.MontoUnitario;
        cantidad = d.Cantidad;
        montoModCompleto = d.MontoModuloCompleto ?? 0;
        cantidadModCompleto = d.CantidadModuloCompleto ?? 0;
        montoMedioMod = d.MontoMedioModulo ?? 0;
        cantidadMedioMod = d.CantidadMedioModulo ?? 0;
        montoFacturacion = d.MontoFacturacion;
        porcentajeRetencion = d.Porcentaje;
        montoRetencion = d.Retencion;
        saldoPendiente = d.Saldo;
        montoTotalALiquidar = montoFacturacion - montoRetencion;
        montoPagado = Math.Max(0, montoTotalALiquidar - saldoPendiente);
        turnosIdsDetalleActual = new List<int>(d.TurnosIds);
    }

    private void CancelarEdicionDetalle()
    {
        indiceDetalleEnEdicion = null;
        turnosIdsDetalleActual.Clear();
        RecalcularMonto();
    }

    private void EliminarDetalle(int index)
    {
        detallesCargados.RemoveAt(index);
        MarcarCambios();
        MostrarAlerta("Factura eliminada de la liquidación.", false);
    }

    private void AbrirModalSesiones(GuardarDetalleLiquidacionDTO detalle)
    {
        detalleParaSesiones = detalle;
        turnosSesionModal.Clear();
        int sesion = 1;
        var fInicio = fechaDesde;

        for (int i = 0; i < Math.Max(1, detalle.Cantidad); i++)
        {
            turnosSesionModal.Add(new TurnoLiquidacionItemDTO
            {
                TurnoId = i + 1,
                NumeroSesion = sesion++,
                Fecha = fInicio.AddDays(i * 7),
                HoraInicio = new TimeOnly(14, 0),
                HoraFin = new TimeOnly(14, 45),
                ConsultorioNombre = "Consultorio 1",
                TipoTurnoNombre = detalle.TipoPrestacionNombre ?? "Atención",
                EstadoTurno = EnumEstadoTurno.reservado
            });
        }
        mostrarModalSesiones = true;
    }

    private void VerSesionesAgendaDesdeFormulario()
    {
        var dummy = new GuardarDetalleLiquidacionDTO
        {
            PacienteNombreCompleto = listaPacientes.FirstOrDefault(p => p.Id == pacienteId)?.Nombre ?? "Paciente seleccionado",
            Cantidad = cantidad,
            TipoPrestacionNombre = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId)?.Tipo ?? "Sesión"
        };
        AbrirModalSesiones(dummy);
    }

    private async Task GuardarLiquidacionFinal()
    {
        // 1. Validaciones requeridas de claves foráneas
        if (profesionalId <= 0)
        {
            MostrarAlerta("Debe seleccionar un PROFESIONAL antes de guardar la liquidación.", true);
            return;
        }

        if (socioId <= 0)
        {
            MostrarAlerta("Debe seleccionar un SOCIO RESPONSABLE antes de guardar.", true);
            return;
        }

        if (detallesCargados.Count == 0)
        {
            MostrarAlerta("Debe agregar al menos una factura a la liquidación antes de guardar.", true);
            return;
        }

        guardando = true;
        try
        {
            // Determinar estado de pago general
            var saldoTotal = detallesCargados.Sum(d => d.Saldo);
            var factTotal = detallesCargados.Sum(d => d.MontoFacturacion);
            EnumEstadoPagoLiquidacion estadoGeneral = saldoTotal <= 0 ? EnumEstadoPagoLiquidacion.Pagado
                                                   : (saldoTotal < factTotal ? EnumEstadoPagoLiquidacion.Parcial : EnumEstadoPagoLiquidacion.Pendiente);

            var guardarDto = new GuardarLiquidacionDTO
            {
                Id = Id ?? 0,
                NumeroLiquidacion = numeroLiquidacion,
                FechaDesde = DateTime.SpecifyKind(fechaDesde, DateTimeKind.Utc),
                FechaHasta = DateTime.SpecifyKind(fechaHasta, DateTimeKind.Utc),
                ProfesionalId = profesionalId,
                SocioId = socioId,
                EstadoPago = estadoGeneral,
                Detalles = detallesCargados
            };

            var res = await Http.Post<GuardarLiquidacionDTO, int>("api/liquidacion", guardarDto);

            if (!res.Error && res.Respuesta > 0)
            {
                hayCambiosSinGuardar = false;
                Navigation.NavigateTo("/liquidaciones");
            }
            else
            {
                MostrarAlerta("No se pudo guardar la liquidación: " + (res.ObtenerError() ?? "Verifique los datos de conexión"), true);
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error al conectar con el servidor: " + ex.Message, true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void ManejarClickVolverAtras()
    {
        if (hayCambiosSinGuardar)
        {
            mostrarModalSalir = true;
        }
        else
        {
            Navigation.NavigateTo("/liquidaciones");
        }
    }

    private void DescartarYSalir()
    {
        mostrarModalSalir = false;
        hayCambiosSinGuardar = false;
        Navigation.NavigateTo("/liquidaciones");
    }

    private async Task GuardarYSalir()
    {
        mostrarModalSalir = false;
        await GuardarLiquidacionFinal();
    }

    private void MarcarCambios() => hayCambiosSinGuardar = true;

    private void MostrarAlerta(string msg, bool error)
    {
        mensajeAlerta = msg;
        esErrorAlerta = error;
    }
}

