    private async Task CargarFacturasPendientesAgenda()
    {
        if (profesionalId <= 0)
        {
            facturasPendientesAgenda.Clear();
            return;
        }

        try
        {
            string url = $"api/liquidacion/turnos-pendientes?profesionalId={profesionalId}&fechaDesde={fechaDesde:yyyy-MM-dd}&fechaHasta={fechaHasta:yyyy-MM-dd}";
            var r = await Http.Get<List<TurnoLiquidacionItemDTO>>(url);
            if (!r.Error && r.Respuesta != null && r.Respuesta.Count > 0)
            {
                facturasPendientesAgenda = r.Respuesta
                    .GroupBy(t => new
                    {
                        PacienteId = t.TipoModalidadId >= 3 ? (int?)null : t.PacienteId,
                        TipoPrestacionId = t.TipoModalidadId == 3 ? (int?)null : t.TipoPrestacionId,
                        ObraSocialId = t.TipoModalidadId == 2 ? t.ObraSocialId : (int?)null,
                        t.TipoModalidadId,
                        t.ProfesionalId
                    })
                    .Select(g =>
                    {
                        var lista = g.OrderBy(x => x.Fecha).ThenBy(x => x.HoraInicio).ToList();
                        for (int i = 0; i < lista.Count; i++)
                            lista[i].NumeroSesion = i + 1;

                        var primerTurno = lista[0];
                        var prest = listaPrestaciones.FirstOrDefault(p => p.Id == primerTurno.TipoPrestacionId);
                        var modalidadId = primerTurno.TipoModalidadId > 0 ? primerTurno.TipoModalidadId : (primerTurno.ObraSocialId.HasValue ? 2 : 1);
                        var modalidadNombre = ObtenerNombreModalidad(modalidadId);
                        string pacNombre = modalidadId >= 3
                            ? "Uso Institucional / Alquiler"
                            : (primerTurno.PacienteNombreCompleto ?? primerTurno.PacienteNombre ?? "Sin nombre");
                        string prestNombre = modalidadId == 3
                            ? "Módulos"
                            : (!string.IsNullOrEmpty(primerTurno.TipoPrestacionNombre) ? primerTurno.TipoPrestacionNombre : primerTurno.TipoTurnoNombre);

                        return new FacturaAgrupadaAgendaDTO
                        {
                            PacienteId = modalidadId >= 3 ? null : primerTurno.PacienteId,
                            PacienteNombre = pacNombre,
                            TituloGrupo = modalidadId >= 3 ? $"{modalidadNombre} • {prestNombre}" : pacNombre,
                            ProfesionalId = primerTurno.ProfesionalId,
                            ProfesionalNombre = primerTurno.ProfesionalNombre,
                            TipoModalidadId = modalidadId,
                            ModalidadNombre = modalidadNombre,
                            TipoPrestacionId = modalidadId == 3 ? null : primerTurno.TipoPrestacionId,
                            PrestacionNombre = prestNombre,
                            TipoObraSocialId = modalidadId == 2 ? primerTurno.ObraSocialId : null,
                            ObraSocialNombre = modalidadId == 2 ? primerTurno.ObraSocialNombre : null,
                            MontoSesion = primerTurno.MontoSesion > 0 ? primerTurno.MontoSesion : (prest?.MontoSesion ?? 0),
                            PorcentajeRetencion = primerTurno.PorcentajeRetencion > 0 ? primerTurno.PorcentajeRetencion : (prest?.PorcentajeRetencion ?? (modalidadId >= 3 ? 100 : 20)),
                            CantidadTurnos = lista.Count,
                            CantidadModulosCompletos = lista.Count(x => x.EsModuloCompleto),
                            CantidadMediosModulos = lista.Count(x => x.EsMedioModulo),
                            TurnosIds = lista.Select(x => x.TurnoId).Distinct().ToList(),
                            Turnos = lista
                        };
                    }).ToList();
            }
            else
            {
                facturasPendientesAgenda.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar turnos pendientes: {ex.Message}");
            facturasPendientesAgenda.Clear();
        }
    }

    private List<FacturaAgrupadaAgendaDTO> FacturasPendientesSinCargar()
    {
        var turnosYaCargados = detallesCargados.SelectMany(d => d.TurnosIds).ToHashSet();

        return facturasPendientesAgenda
            .Where(f => !f.TurnosIds.Any(idT => turnosYaCargados.Contains(idT)))
            .Where(f => !detallesCargados.Any(d =>
                d.TipoModalidadId == f.TipoModalidadId &&
                (f.TipoModalidadId >= 3
                    ? (f.TipoModalidadId == 3 || d.TipoPrestacionId == f.TipoPrestacionId)
                    : (d.PacienteId == f.PacienteId && d.TipoPrestacionId == f.TipoPrestacionId && d.TipoObraSocialId == f.TipoObraSocialId))))
            .ToList();
    }

    private bool EsFacturaActualYaGuardada()
    {
        if (indiceDetalleEnEdicion.HasValue) return false;
        if (tipoModalidadId <= 2 && pacienteId <= 0) return false;
        if (tipoModalidadId > 2 && tipoPrestacionId <= 0 && tipoModalidadId == 5) return false;

        int? osBuscada = tipoModalidadId == 2 && tipoObraSocialId > 0 ? tipoObraSocialId : null;

        return detallesCargados.Any(d =>
            d.TipoModalidadId == tipoModalidadId &&
            (tipoModalidadId >= 3
                ? (tipoModalidadId == 3 || d.TipoPrestacionId == (tipoPrestacionId > 0 ? tipoPrestacionId : (int?)null))
                : (d.PacienteId == pacienteId &&
                   d.TipoPrestacionId == (tipoPrestacionId > 0 ? tipoPrestacionId : (int?)null) &&
                   d.TipoObraSocialId == osBuscada)));
    }

    private void CargarProximaFactura()
    {
        var pendientes = FacturasPendientesSinCargar();
        if (pendientes.Count == 0)
        {
            MostrarAlerta("No hay más facturas agrupadas pendientes en la agenda para este profesional.", "warning");
            return;
        }

        CargarFacturaDesdeGrupo(pendientes.First());
    }

    private void CargarFacturaDesdeGrupo(FacturaAgrupadaAgendaDTO fac)
    {
        indiceDetalleEnEdicion = null;
        detalleIdEnEdicion = 0;
        detalleActualSinCoincidenciaAgenda = false;

        tipoModalidadId = fac.TipoModalidadId;
        pacienteId = fac.PacienteId ?? 0;
        tipoPrestacionId = fac.TipoPrestacionId ?? 0;
        tipoObraSocialId = fac.TipoObraSocialId ?? 0;
        montoUnitario = fac.MontoSesion;
        cantidad = fac.CantidadTurnos;
        cantidadModCompleto = fac.CantidadModulosCompletos;
        cantidadMedioMod = fac.CantidadMediosModulos;
        montoModCompleto = 50000;
        montoMedioMod = 30000;
        porcentajeRetencion = fac.PorcentajeRetencion > 0 ? fac.PorcentajeRetencion : (tipoModalidadId >= 3 ? 100 : 20);
        turnosIdsDetalleActual = new List<int>(fac.TurnosIds);
        turnosAsociadosDetalleActual = new List<TurnoLiquidacionItemDTO>(fac.Turnos);

        // Guardar snapshot original de la agenda
        origTipoModalidadId = tipoModalidadId;
        origPacienteId = pacienteId > 0 ? pacienteId : null;
        origPacienteNombre = fac.PacienteNombre;
        origTipoPrestacionId = tipoPrestacionId > 0 ? tipoPrestacionId : null;
        origTipoPrestacionNombre = fac.PrestacionNombre;
        origTipoObraSocialId = tipoObraSocialId > 0 ? tipoObraSocialId : null;
        origTipoObraSocialNombre = fac.ObraSocialNombre;
        origMontoUnitario = montoUnitario;
        origCantidad = cantidad;
        origCantidadModCompleto = cantidadModCompleto;
        origMontoModCompleto = montoModCompleto;
        origCantidadMedioMod = cantidadMedioMod;
        origMontoMedioMod = montoMedioMod;
        origPorcentaje = porcentajeRetencion;

        RecalcularMonto();
        mostrarMenuFacturasPendientes = false;
        seccionDetalleAbierta = true;
        MostrarAlerta($"Detalle de {fac.TituloGrupo} ({fac.CantidadTurnos} turnos) precargado desde la agenda.", "success");
    }

    private void CambiarModalidad(int modId)
    {
        tipoModalidadId = modId;
        if (tipoModalidadId >= 3)
        {
            porcentajeRetencion = 100;
            if (!origPorcentaje.HasValue) origPorcentaje = 100;
        }
        else
        {
            var p = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
            porcentajeRetencion = p != null && p.PorcentajeRetencion > 0 ? p.PorcentajeRetencion : 20;
        }
        RecalcularMonto();
    }

    private void OnPrestacionSeleccionada()
    {
        var p = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
        if (p != null)
        {
            if (p.MontoSesion > 0) montoUnitario = p.MontoSesion;
            porcentajeRetencion = p.PorcentajeRetencion > 0 ? p.PorcentajeRetencion : (tipoModalidadId >= 3 ? 100 : 20);

            if (!origTipoModalidadId.HasValue)
            {
                origTipoPrestacionId = p.Id;
                origTipoPrestacionNombre = p.Tipo;
                origMontoUnitario = p.MontoSesion;
                origPorcentaje = porcentajeRetencion;
            }
        }
        RecalcularMonto();
    }

