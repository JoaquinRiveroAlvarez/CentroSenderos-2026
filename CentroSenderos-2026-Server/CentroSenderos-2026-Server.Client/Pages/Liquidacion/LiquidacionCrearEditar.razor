            var dto = new ModificarPagoLiquidacionDTO
            {
                PagoId = pagoAModificar.Id,
                LiquidacionId = Id.Value,
                ModificadoPor = usuarioLogueadoActual,
                Motivo = motivoModificacionTexto.Trim(),
                Metodos = metodosPagoModificacion,
                Imputaciones = itemsDetallesModificacion.Where(x => x.Seleccionado && x.MontoACobrar > 0).Select(x => new CobroDetalleImputacionDTO
                {
                    DetalleLiquidacionId = x.DetalleId,
                    MontoImputado = x.MontoACobrar,
                    CantidadSesionesCobradas = x.SesionesACobrar ?? 1m
                }).ToList()
            };

            var res = await Http.Post<ModificarPagoLiquidacionDTO, object>("api/liquidacion/modificar-cobro", dto);
            if (!res.Error)
            {
                mostrarModalModificarCobro = false;
                await RecargarLiquidacionDesdeServidor(Id.Value);
                if (indiceDetalleEnEdicion.HasValue)
                    EditarDetalle(indiceDetalleEnEdicion.Value);
                MostrarAlerta("Cobro modificado correctamente. El registro previo se conservó en el historial.", "success");
            }
            else
            {
                MostrarAlerta("Error al modificar cobro: " + res.ObtenerError(), "danger");
            }
        }
        finally
        {
            procesandoCobro = false;
        }
    }

    // ======== GUARDAR LIQUIDACIÓN (SIN REDIRIGIR AL LISTADO) ========
    private async Task<bool> GuardarLiquidacionFinal()
    {
        if (profesionalId <= 0)
        {
            MostrarAlerta("Debe seleccionar un profesional para la liquidación.", "danger");
            return false;
        }

        if (detallesCargados.Count == 0)
        {
            MostrarAlerta("Debe cargar al menos un detalle en la liquidación antes de guardar.", "danger");
            return false;
        }

        guardando = true;
        try
        {
            var dto = new GuardarLiquidacionDTO
            {
                Id = Id ?? 0,
                NumeroLiquidacion = numeroLiquidacion,
                FechaDesde = fechaDesde,
                FechaHasta = fechaHasta,
                ProfesionalId = profesionalId,
                SocioId = socioId,
                UsuarioResponsable = usuarioResponsable,
                EstadoPago = EstadoGeneralCalculado,
                Observaciones = $"Liquidación generada con {detallesCargados.Count} conceptos.",
                Detalles = detallesCargados
            };

            var res = await Http.Post<GuardarLiquidacionDTO, int>("api/liquidacion", dto);
            if (!res.Error)
            {
                int idGuardado = res.Respuesta > 0 ? res.Respuesta : (Id ?? 0);
                hayCambiosSinGuardar = false;

                if (!Id.HasValue || Id.Value == 0)
                {
                    idCargadoActual = idGuardado;
                    Id = idGuardado;
                    permitirSalida = true;
                    Navigation.NavigateTo($"/liquidaciones/editar/{idGuardado}", replace: true);
                    permitirSalida = false;
                }

                await RecargarLiquidacionDesdeServidor(idGuardado);
                MostrarAlerta($"Liquidación #{numeroLiquidacion} guardada correctamente.", "success");
                return true;
            }
            else
            {
                MostrarAlerta("Error al guardar en el servidor: " + res.ObtenerError(), "danger");
                return false;
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error inesperado al guardar: " + ex.Message, "danger");
            return false;
        }
        finally
        {
            guardando = false;
        }
    }

    // ======== PROTECCIÓN DE SALIDA / NAVIGATION LOCK ========
    private void AntesDeNavegar(LocationChangingContext contexto)
    {
        if (!hayCambiosSinGuardar || permitirSalida) return;

        contexto.PreventNavigation();
        destinoPendiente = contexto.TargetLocation;
        mostrarModalSalir = true;
        StateHasChanged();
    }

    private void ManejarClickVolverAtras()
    {
        Navigation.NavigateTo("/liquidaciones");
    }

    private void CancelarSalida()
    {
        mostrarModalSalir = false;
        destinoPendiente = null;
    }

    private void DescartarYSalir()
    {
        var destino = string.IsNullOrWhiteSpace(destinoPendiente) ? "/liquidaciones" : destinoPendiente;
        mostrarModalSalir = false;
        destinoPendiente = null;
        hayCambiosSinGuardar = false;
        permitirSalida = true;
        Navigation.NavigateTo(destino);
    }

    private async Task GuardarYSalir()
    {
        var destino = string.IsNullOrWhiteSpace(destinoPendiente) ? "/liquidaciones" : destinoPendiente;
        mostrarModalSalir = false;
        destinoPendiente = null;

        bool ok = await GuardarLiquidacionFinal();
        if (ok)
        {
            permitirSalida = true;
            Navigation.NavigateTo(destino);
        }
    }

    private void MarcarCambios() => hayCambiosSinGuardar = true;

    private void MostrarAlerta(string msg, string tipo)
    {
        mensajeAlerta = msg;
        tipoAlerta = tipo;
    }
}