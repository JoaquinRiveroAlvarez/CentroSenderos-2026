    private void AbrirModalRegistrarCobro(int? soloDetalleId)
    {
        itemsDetallesACobrar = detallesCargados.Where(d => d.Id > 0 && d.Saldo > 0).Select(d =>
        {
            bool preseleccionado = !soloDetalleId.HasValue || d.Id == soloDetalleId.Value;
            decimal sesionesPend = Math.Max(0m, d.Cantidad - d.SesionesCobradas);
            return new ItemDetalleCobroSeleccion
            {
                DetalleId = d.Id,
                Seleccionado = preseleccionado,
                PacienteNombre = d.PacienteNombreCompleto ?? "Sin Paciente",
                PrestacionNombre = d.TipoPrestacionNombre ?? "Sesión",
                ModalidadNombre = d.TipoModalidadNombre,
                CantidadSesionesTotal = Math.Max(1, d.Cantidad),
                SesionesYaCobradas = d.SesionesCobradas,
                SaldoPendiente = d.Saldo,
                MontoACobrar = d.Saldo,
                SesionesACobrar = sesionesPend > 0 ? sesionesPend : 1
            };
        }).ToList();

        metodosPagoOperacion = new List<CobroMetodoPagoDTO>
        {
            new CobroMetodoPagoDTO
            {
                MetodoPago = MetodoDePago.Efectivo,
                MetodoPagoNombre = "Efectivo",
                Monto = itemsDetallesACobrar.Where(x => x.Seleccionado).Sum(x => x.MontoACobrar)
            }
        };

        mostrarModalRegistrarCobro = true;
    }

    private void AlCambiarSesionesCobro(ItemDetalleCobroSeleccion item)
    {
        if (item.SesionesACobrar.HasValue)
        {
            decimal maxSes = item.SesionesPendientes > 0 ? item.SesionesPendientes : item.CantidadSesionesTotal;
            decimal ses = Math.Clamp(item.SesionesACobrar.Value, 0m, maxSes);
            item.SesionesACobrar = ses;

            if (maxSes > 0)
            {
                if (Math.Abs(ses - maxSes) < 0.001m)
                    item.MontoACobrar = item.SaldoPendiente;
                else
                    item.MontoACobrar = Math.Round((item.SaldoPendiente / maxSes) * ses, 2);
            }
        }
        SincronizarMetodosPagoDesdeConceptos();
    }

    private void AlCambiarMontoCobro(ItemDetalleCobroSeleccion item)
    {
        item.MontoACobrar = Math.Clamp(item.MontoACobrar, 0m, item.SaldoPendiente);
        decimal maxSes = item.SesionesPendientes > 0 ? item.SesionesPendientes : item.CantidadSesionesTotal;
        if (item.SaldoPendiente > 0 && maxSes > 0)
        {
            item.SesionesACobrar = Math.Round((item.MontoACobrar / item.SaldoPendiente) * maxSes, 2);
        }
        SincronizarMetodosPagoDesdeConceptos();
    }

    private void SincronizarMetodosPagoDesdeConceptos()
    {
        if (metodosPagoOperacion.Count == 1)
        {
            metodosPagoOperacion[0].Monto = TotalCobroImputadoSeleccionado;
        }
    }

    private void IgualarMetodosPagoConConceptos()
    {
        if (metodosPagoOperacion.Count == 0)
        {
            metodosPagoOperacion.Add(new CobroMetodoPagoDTO { MetodoPago = MetodoDePago.Efectivo, MetodoPagoNombre = "Efectivo", Monto = TotalCobroImputadoSeleccionado });
            return;
        }
        decimal otros = metodosPagoOperacion.Skip(1).Sum(m => m.Monto);
        metodosPagoOperacion[0].Monto = Math.Max(0m, TotalCobroImputadoSeleccionado - otros);
    }

    private void AgregarMetodoPagoFila()
    {
        decimal restante = Math.Max(0m, TotalCobroImputadoSeleccionado - TotalMetodosPagoOperacion);
        metodosPagoOperacion.Add(new CobroMetodoPagoDTO
        {
            MetodoPago = MetodoDePago.Transferencia,
            MetodoPagoNombre = "Transferencia",
            Monto = restante
        });
    }

    private void QuitarMetodoPagoFila(List<CobroMetodoPagoDTO> lista, CobroMetodoPagoDTO item)
    {
        if (lista.Count <= 1) return;
        lista.Remove(item);
        if (ReferenceEquals(lista, metodosPagoOperacion))
            SincronizarMetodosPagoDesdeConceptos();
        else
            SincronizarMetodosPagoModificacion();
    }

    private async Task ConfirmarRegistroCobro()
    {
        if (!Id.HasValue) return;
        procesandoCobro = true;
        try
        {
            var dto = new RegistrarCobroLiquidacionDTO
            {
                LiquidacionId = Id.Value,
                RegistradoPor = usuarioLogueadoActual,
                Metodos = metodosPagoOperacion,
                Imputaciones = itemsDetallesACobrar.Where(x => x.Seleccionado && x.MontoACobrar > 0).Select(x => new CobroDetalleImputacionDTO
                {
                    DetalleLiquidacionId = x.DetalleId,
                    MontoImputado = x.MontoACobrar,
                    CantidadSesionesCobradas = x.SesionesACobrar ?? 1m
                }).ToList()
            };

            var res = await Http.Post<RegistrarCobroLiquidacionDTO, object>("api/liquidacion/registrar-cobro", dto);
            if (!res.Error)
            {
                mostrarModalRegistrarCobro = false;
                await RecargarLiquidacionDesdeServidor(Id.Value);
                if (indiceDetalleEnEdicion.HasValue)
                    EditarDetalle(indiceDetalleEnEdicion.Value);
                MostrarAlerta("Cobro registrado exitosamente.", "success");
            }
            else
            {
                MostrarAlerta("Error al registrar el cobro: " + res.ObtenerError(), "danger");
            }
        }
        finally
        {
            procesandoCobro = false;
        }
    }

