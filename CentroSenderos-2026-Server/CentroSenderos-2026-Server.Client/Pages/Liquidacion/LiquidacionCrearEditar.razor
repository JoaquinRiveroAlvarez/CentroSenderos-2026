            decimal maxSes = item.SesionesPendientes > 0 ? item.SesionesPendientes : item.CantidadSesionesTotal;
            decimal ses = Math.Clamp(item.SesionesACobrar.Value, 0m, maxSes);
            item.SesionesACobrar = ses;

            if (maxSes > 0)
            {
                if (Math.Abs(ses - maxSes) < 0.001m)
                    item.MontoACobrar = item.SaldoPendiente;
                else
                    item.MontoACobrar = Math.Round((item.SaldoPendiente / maxSes) * ses, 2);
            }
        }
        SincronizarMetodosPagoModificacion();
    }

    private void AlCambiarMontoModificacion(ItemDetalleCobroSeleccion item)
    {
        item.MontoACobrar = Math.Clamp(item.MontoACobrar, 0m, item.SaldoPendiente);
        decimal maxSes = item.SesionesPendientes > 0 ? item.SesionesPendientes : item.CantidadSesionesTotal;
        if (item.SaldoPendiente > 0 && maxSes > 0)
        {
            item.SesionesACobrar = Math.Round((item.MontoACobrar / item.SaldoPendiente) * maxSes, 2);
        }
        SincronizarMetodosPagoModificacion();
    }

