@page "/liquidaciones/crear"
@page "/liquidaciones/editar/{Id:int}"
@attribute [Authorize(Roles = "Socio")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@using CentroSenderos_2026_Servicio.ServiciosHttp
@inject IHttpServicio Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<NavigationLock ConfirmExternalNavigation="hayCambiosSinGuardar" OnBeforeInternalNavigation="AntesDeNavegar" />

<div class="liq-create-container">
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-custom"></div>
            <p class="mt-2 text-muted">Cargando datos de la liquidación...</p>
        </div>
    }
    else
    {
        <!-- Top Bar con Flecha Atrás, N° de Liquidación, Botones de Cobro y Estado -->
        <div class="top-nav-bar">
            <button type="button" class="btn-back-arrow" title="Volver al listado" @onclick="ManejarClickVolverAtras">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:20px;height:20px;min-width:20px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </button>
            <div>
                <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                    <h1 class="page-main-title">@(EsEdicionLiquidacion ? "Editar Liquidación" : "Nueva Liquidación")</h1>
                    <span class="badge-tag-nro" title="Número único de liquidación">#@numeroLiquidacion</span>
                    @if (EsEdicionLiquidacion)
                    {
                        <span class="badge-status-header @ObtenerClaseEstadoBadge(EstadoGeneralCalculado)">@FormatearEstadoPago(EstadoGeneralCalculado)</span>
                    }
                </div>
                <span class="periodo-badge">Período: @fechaDesde.ToString("dd/MM/yyyy") - @fechaHasta.ToString("dd/MM/yyyy")</span>
            </div>

            <!-- Botonera de acciones superiores (Cobro, Historial, Estado) -->
            <div class="top-actions-right ms-auto">
                @if (EsEdicionLiquidacion)
                {
                    <button type="button" class="btn-top-cobro" @onclick="() => SolicitarAbrirRegistrarCobro(null)" disabled="@(TotalSaldoLiquidacion <= 0)" title="Registrar un cobro a esta liquidación">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:15px;height:15px;"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        <span>Registrar Cobro</span>
                    </button>
                    <button type="button" class="btn-top-historial" @onclick="() => AbrirModalHistorialPagos(null)" title="Ver historial de cobros">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <span>Historial de Cobros (@historialPagos.Count)</span>
                    </button>
                }
                <div class="autosave-pill @(hayCambiosSinGuardar ? "autosave-pending" : "")">
                    <svg width="14" height="14" class="@(hayCambiosSinGuardar ? "text-warning" : "text-success")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;min-width:14px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>@(hayCambiosSinGuardar ? "Cambios sin guardar" : "Al día")</span>
                </div>
            </div>
        </div>

        <!-- Banner de Notificación / Advertencia / Error -->
        @if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            <div class="alert-banner @ObtenerClaseAlerta(tipoAlerta)" role="alert">
                <div class="alert-banner-content">
                    @if (tipoAlerta == "danger")
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;min-width:18px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    }
                    else if (tipoAlerta == "warning")
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;min-width:18px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;min-width:18px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    }
                    <span>@mensajeAlerta</span>
                </div>
                <button type="button" class="btn-close-alert" title="Cerrar aviso" @onclick="() => mensajeAlerta = null">✕</button>
            </div>
        }

        <!-- 1. DATOS GENERALES DE LA LIQUIDACIÓN -->
        <div class="section-card">
            <div class="section-header" style="justify-content:space-between;">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;min-width:18px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <h2 class="section-title">DATOS DE LA LIQUIDACIÓN</h2>
                </div>
                @if (EsEdicionLiquidacion)
                {
                    <span class="badge-tag-mini" title="En modo edición no es posible modificar el profesional, período ni responsable.">Campos de cabecera bloqueados en edición</span>
                }
            </div>
            <div class="row-fields">
                <div class="field-col">
                    <label class="form-label-custom">PROFESIONAL</label>
                    <select class="custom-input @(EsEdicionLiquidacion ? "input-locked" : "")"
                            @bind="profesionalId"
                            @bind:after="AlCambiarProfesionalOFechas"
                            disabled="@EsEdicionLiquidacion">
                        <option value="0">Seleccionar Profesional...</option>
                        @foreach (var p in listaProfesionales)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </div>

                <div class="field-col">
                    <label class="form-label-custom">FECHA DESDE</label>
                    <input type="date"
                           class="custom-input @(EsEdicionLiquidacion ? "input-locked" : "")"
                           @bind="fechaDesde"
                           @bind:after="AlCambiarProfesionalOFechas"
                           disabled="@EsEdicionLiquidacion" />
                </div>

                <div class="field-col">
                    <label class="form-label-custom">FECHA HASTA</label>
                    <input type="date"
                           class="custom-input @(EsEdicionLiquidacion ? "input-locked" : "")"
                           @bind="fechaHasta"
                           @bind:after="AlCambiarProfesionalOFechas"
                           disabled="@EsEdicionLiquidacion" />
                </div>

                <div class="field-col">
                    <label class="form-label-custom">SOCIO RESPONSABLE</label>
                    <input type="text"
                           class="custom-input input-locked"
                           value="@usuarioResponsable"
                           readonly
                           disabled
                           title="Se asigna automáticamente según el usuario con sesión iniciada." />
                </div>
            </div>
        </div>

        <!-- 2. SECCIÓN: DETALLE LIQUIDACIÓN -->
        <div class="accordion-box">
            <div class="accordion-header-toggle">
                <div class="toggle-click-area" @onclick="() => seccionDetalleAbierta = !seccionDetalleAbierta">
                    <svg width="18" height="18" class="icon-toggle @(seccionDetalleAbierta ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;min-width:18px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    <span class="accordion-title">DETALLE LIQUIDACIÓN</span>
                    @if (indiceDetalleEnEdicion.HasValue)
                    {
                        <span class="badge-modo-edicion">Editando detalle</span>
                    }
                    else
                    {
                        <span class="badge-nuevo-detalle">Nuevo detalle</span>
                    }
                </div>

                <!-- Botonera superior de acciones de agenda -->
                <div class="header-actions-area">
                    @if (EsFacturaActualYaGuardada())
                    {
                        <span class="badge-ya-guardada">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:12px;height:12px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Detalle ya agregado</span>
                        </span>
                    }

                    <!-- Botón Desplegable: Facturas por liquidar (X) -->
                    <div class="position-relative">
                        <button type="button"
                                class="btn-facturas-pendientes @(FacturasPendientesSinCargar().Count > 0 ? "btn-has-pending" : "btn-empty-pending")"
                                @onclick="ToggleMenuFacturasPendientes"
                                title="Ver turnos agrupados pendientes en la agenda">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>Facturas por liquidar (@FacturasPendientesSinCargar().Count)</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>

                        @if (mostrarMenuFacturasPendientes)
                        {
                            <div class="dropdown-pending-invoices">
                                <div class="dropdown-pending-header">
                                    <div>
                                        <strong style="display:block; font-size:12px; color:#0f172a;">Pendientes por liquidar (@FacturasPendientesSinCargar().Count)</strong>
                                        <span style="color:#64748b; font-size:11px;">Turnos agrupados según agenda</span>
                                    </div>
                                    <button type="button" class="btn-close-sm" @onclick="() => mostrarMenuFacturasPendientes = false">✕</button>
                                </div>
                                <div class="dropdown-pending-body">
                                    @if (FacturasPendientesSinCargar().Count == 0)
                                    {
                                        <p style="text-align:center; color:#94a3b8; padding:1.2rem; font-size:12px; margin:0;">
                                            @(profesionalId > 0 ? "No hay turnos pendientes para este profesional en el período." : "Seleccione un profesional para ver sus turnos pendientes.")
                                        </p>
                                    }
                                    else
                                    {
                                        @foreach (var fac in FacturasPendientesSinCargar())
                                        {
                                            <div class="pending-group-item" @onclick="() => CargarFacturaDesdeGrupo(fac)">
                                                <div style="flex:1; min-width:0; padding-right:8px;">
                                                    <div style="font-weight:700; color:#0f172a; font-size:12px;">@fac.TituloGrupo</div>
                                                    <div style="font-size:11px; color:#64748b; line-height:1.3;">
                                                        @fac.ModalidadNombre @(!string.IsNullOrEmpty(fac.ObraSocialNombre) && fac.TipoModalidadId == 2 ? $"({fac.ObraSocialNombre})" : "") • @fac.PrestacionNombre • <strong>@fac.CantidadTurnos @(fac.CantidadTurnos == 1 ? "turno" : "turnos")</strong>
                                                    </div>
                                                </div>
                                                <span class="badge-cargar-mini">Cargar ⚡</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botón: Cargar Próxima Factura -->
                    <button type="button" class="btn-proxima-factura" @onclick="CargarProximaFactura" title="Carga automáticamente el primer grupo pendiente de la agenda">
                        <svg width="14" height="14" style="width:14px;height:14px;color:#d97706;" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        <span>Cargar Próxima Factura</span>
                    </button>
                </div>
            </div>

            @if (seccionDetalleAbierta)
            {
                <div class="accordion-content">
                    <!-- Barra de estado y acciones de cobro del detalle en edición -->
                    @if (indiceDetalleEnEdicion.HasValue)
                    {
                        var detEdit = detallesCargados[indiceDetalleEnEdicion.Value];
                        <div class="detail-edit-status-bar">
                            <div style="display:flex; align-items:center; gap:0.65rem; flex-wrap:wrap;">
                                <span class="form-label-custom" style="margin:0;">ESTADO DEL DETALLE:</span>
                                <span class="badge-status-header @ObtenerClaseEstadoBadge(detEdit.EstadoPago)">
                                    @FormatearEstadoPago(detEdit.EstadoPago)
                                </span>
                                @if (detEdit.SinCoincidenciaAgenda)
                                {
                                    <span class="badge-sin-agenda">Sin coincidencia en agenda</span>
                                }
                                else if (turnosIdsDetalleActual.Count > 0)
                                {
                                    <span class="badge-con-agenda">@turnosIdsDetalleActual.Count turno(s) de agenda</span>
                                }
                            </div>
                            <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                @if (detEdit.Id > 0 && EsEdicionLiquidacion)
                                {
                                    @if (detEdit.Saldo > 0)
                                    {
                                        <button type="button" class="btn-cobrar-detalle" @onclick="() => SolicitarAbrirRegistrarCobro(detEdit.Id)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                                            <span>Cobrar</span>
                                        </button>
                                    }
                                    @if (detEdit.EstadoPago == EnumEstadoPagoLiquidacion.Parcial || detEdit.EstadoPago == EnumEstadoPagoLiquidacion.Pagado || DetalleTieneHistorialCobros(detEdit.Id))
                                    {
                                        <button type="button" class="btn-historial-detalle" @onclick="() => AbrirModalHistorialPagos(detEdit.Id)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                            <span>Historial de cobros</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <!-- Selector de Modalidad -->
                    <div style="margin-bottom: 1rem;">
                        <label class="form-label-custom">MODALIDAD</label>
                        <div class="modalidad-pill-group @(EsModalidadModificada() ? "group-modificado" : "")">
                            <button type="button" class="btn-pill @(tipoModalidadId == 1 ? "active" : "")" @onclick="() => CambiarModalidad(1)">Particular</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 2 ? "active" : "")" @onclick="() => CambiarModalidad(2)">Obra Social</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 3 ? "active" : "")" @onclick="() => CambiarModalidad(3)">Módulos</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 4 ? "active" : "")" @onclick="() => CambiarModalidad(4)">Por Hora</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 5 ? "active" : "")" @onclick="() => CambiarModalidad(5)">Taller</button>
                        </div>
                    </div>

                    <!-- Campos dinámicos según modalidad -->
                    <div class="row-fields" style="margin-bottom: 1rem;">
                        @if (tipoModalidadId == 1 || tipoModalidadId == 2)
                        {
                            <!-- PARTICULAR / OBRA SOCIAL -->
                            <div class="field-col" style="flex: 2 1 200px;">
                                <label class="form-label-custom">PACIENTE (@listaPacientes.Count disponibles)</label>
                                <select class="custom-input @(EsPacienteModificado() ? "input-modificado" : "")"
                                        @bind="pacienteId"
                                        @bind:after="MarcarCambioFormularioDetalle">
                                    <option value="0">Seleccionar Paciente...</option>
                                    @foreach (var pac in listaPacientes)
                                    {
                                        <option value="@pac.Id">@pac.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="field-col" style="flex: 2 1 200px;">
                                <label class="form-label-custom">PRESTACIÓN (@listaPrestaciones.Count disponibles)</label>
                                <select class="custom-input @(EsPrestacionModificada() ? "input-modificado" : "")"
                                        @bind="tipoPrestacionId"
                                        @bind:after="OnPrestacionSeleccionada">
                                    <option value="0">Seleccionar Prestación...</option>
                                    @foreach (var pr in listaPrestaciones)
                                    {
                                        <option value="@pr.Id">@pr.Tipo (@pr.PorcentajeRetencion.ToString("0.##")%)</option>
                                    }
                                </select>
                            </div>
                            @if (tipoModalidadId == 2)
                            {
                                <div class="field-col" style="flex: 2 1 200px;">
                                    <label class="form-label-custom">OBRA SOCIAL</label>
                                    <select class="custom-input @(EsObraSocialModificada() ? "input-modificado" : "")"
                                            @bind="tipoObraSocialId"
                                            @bind:after="MarcarCambioFormularioDetalle">
                                        <option value="0">Seleccionar Obra Social...</option>
                                        @foreach (var os in listaObrasSociales)
                                        {
                                            <option value="@os.Id">@os.Tipo</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="field-col" style="flex: 1 1 120px;">
                                <label class="form-label-custom">VALOR SESIÓN ($)</label>
                                <input type="number"
                                       step="any"
                                       class="custom-input @(EsPrecioUnitarioModificado() ? "input-modificado" : "")"
                                       @bind="montoUnitario"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col" style="flex: 1 1 100px;">
                                <label class="form-label-custom">CANTIDAD SESIONES</label>
                                <input type="number"
                                       min="1"
                                       class="custom-input @(EsCantidadModificada() ? "input-modificado" : "")"
                                       @bind="cantidad"
                                       @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 3)
                        {
                            <!-- MÓDULOS -->
                            <div class="field-col">
                                <label class="form-label-custom">CANT. MÓDULOS COMPLETOS</label>
                                <input type="number"
                                       min="0"
                                       class="custom-input @(EsCantidadModCompletoModificada() ? "input-modificado" : "")"
                                       @bind="cantidadModCompleto"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR MÓDULO COMPLETO ($)</label>
                                <input type="number"
                                       step="any"
                                       class="custom-input @(EsMontoModCompletoModificado() ? "input-modificado" : "")"
                                       @bind="montoModCompleto"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">CANT. MEDIOS MÓDULOS</label>
                                <input type="number"
                                       min="0"
                                       class="custom-input @(EsCantidadMedioModModificada() ? "input-modificado" : "")"
                                       @bind="cantidadMedioMod"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR MEDIO MÓDULO ($)</label>
                                <input type="number"
                                       step="any"
                                       class="custom-input @(EsMontoMedioModModificado() ? "input-modificado" : "")"
                                       @bind="montoMedioMod"
                                       @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 4)
                        {
                            <!-- POR HORA -->
                            <div class="field-col">
                                <label class="form-label-custom">CANTIDAD DE HORAS</label>
                                <input type="number"
                                       min="1"
                                       class="custom-input @(EsCantidadModificada() ? "input-modificado" : "")"
                                       @bind="cantidad"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR POR HORA ($)</label>
                                <input type="number"
                                       step="any"
                                       class="custom-input @(EsPrecioUnitarioModificado() ? "input-modificado" : "")"
                                       @bind="montoUnitario"
                                       @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 5)
                        {
                            <!-- TALLER -->
                            <div class="field-col">
                                <label class="form-label-custom">TALLER</label>
                                <select class="custom-input @(EsPrestacionModificada() ? "input-modificado" : "")"
                                        @bind="tipoPrestacionId"
                                        @bind:after="OnPrestacionSeleccionada">
                                    <option value="0">Seleccionar Taller...</option>
                                    @foreach (var pr in listaPrestaciones)
                                    {
                                        <option value="@pr.Id">@pr.Tipo</option>
                                    }
                                </select>
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">CANTIDAD</label>
                                <input type="number"
                                       min="1"
                                       class="custom-input @(EsCantidadModificada() ? "input-modificado" : "")"
                                       @bind="cantidad"
                                       @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">PRECIO POR TALLER ($)</label>
                                <input type="number"
                                       step="any"
                                       class="custom-input @(EsPrecioUnitarioModificado() ? "input-modificado" : "")"
                                       @bind="montoUnitario"
                                       @bind:after="RecalcularMonto" />
                            </div>
                        }
                    </div>

                    <!-- ADVERTENCIA DETALLADA SI SE MODIFICARON CAMPOS / VALORES -->
                    @{
                        var diferenciasActuales = ConstruirListaDiferenciasDetalle();
                    }
                    @if (diferenciasActuales.Count > 0)
                    {
                        <div class="warning-alert-pill" style="flex-direction:column; align-items:flex-start; gap:0.35rem;">
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;min-width:16px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                <strong>Valores modificados respecto a la agenda / prestación original:</strong>
                            </div>
                            <ul class="diff-list">
                                @foreach (var dif in diferenciasActuales)
                                {
                                    <li>@dif</li>
                                }
                            </ul>
                        </div>
                    }
                    else if (indiceDetalleEnEdicion.HasValue && detallesCargados[indiceDetalleEnEdicion.Value].ValoresModificadosManualmente && !string.IsNullOrWhiteSpace(detallesCargados[indiceDetalleEnEdicion.Value].ResumenCambiosManuales))
                    {
                        <div class="warning-alert-pill">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;min-width:16px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            <span><strong>Valores modificados manualmente:</strong> @detallesCargados[indiceDetalleEnEdicion.Value].ResumenCambiosManuales</span>
                        </div>
                    }

                    @if (indiceDetalleEnEdicion.HasValue && detallesCargados[indiceDetalleEnEdicion.Value].SinCoincidenciaAgenda)
                    {
                        <div class="warning-alert-pill" style="background:#fff7ed; border-left-color:#ea580c; color:#9a3412;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;min-width:16px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <span><strong>Detalle sin coincidencia en calendario:</strong> Fue cargado manualmente y no coincidió con ningún turno registrado para el profesional y período.</span>
                        </div>
                    }

                    <!-- Bloque Financiero y de Retención (SIN Paga Profesional ni Pagar todo) -->
                    <div class="finance-strip @(indiceDetalleEnEdicion.HasValue && detallesCargados[indiceDetalleEnEdicion.Value].Id > 0 ? "finance-strip-6" : "finance-strip-5")">
                        <div class="finance-item">
                            <label>MONTO FACTURACIÓN</label>
                            <span class="fs-num font-bold text-dark">$@montoFacturacion.ToString("N2")</span>
                        </div>
                        <div class="finance-item">
                            <label>% RETENCIÓN CENTRO</label>
                            <input type="number"
                                   step="any"
                                   class="custom-input-sm font-bold text-centro @(EsPorcentajeModificado() ? "input-modificado" : "")"
                                   @bind="porcentajeRetencion"
                                   @bind:after="RecalcularRetencion" />
                        </div>
                        <div class="finance-item">
                            <label>INGRESO CENTRO (RETENCIÓN $)</label>
                            <span class="fs-num font-bold text-success">+$@montoRetencion.ToString("N2")</span>
                        </div>
                        <div class="finance-item">
                            <label>COBRO PROFESIONAL ($)</label>
                            <span class="fs-num font-bold text-primary">$@cobroProfesional.ToString("N2")</span>
                        </div>
                        @if (indiceDetalleEnEdicion.HasValue && detallesCargados[indiceDetalleEnEdicion.Value].Id > 0)
                        {
                            <div class="finance-item">
                                <label>ABONADO AL CENTRO ($)</label>
                                <span class="fs-num font-bold text-dark">$@montoAbonadoExistente.ToString("N2")</span>
                            </div>
                        }
                        <div class="finance-item">
                            <label>SALDO PENDIENTE CENTRO</label>
                            <span class="fs-num font-bold @(saldoPendiente > 0 ? "text-danger" : "text-muted")">$@saldoPendiente.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Botones de Acción del Detalle -->
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-top:1rem;">
                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <button type="button"
                                    class="btn-agregar-detalle"
                                    @onclick="AgregarOActualizarDetalle"
                                    disabled="@(validandoDetalle || (!indiceDetalleEnEdicion.HasValue && EsFacturaActualYaGuardada()))">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                @if (validandoDetalle)
                                {
                                    <span>Validando agenda...</span>
                                }
                                else if (indiceDetalleEnEdicion.HasValue)
                                {
                                    <span>Guardar Cambios del Detalle</span>
                                }
                                else if (EsFacturaActualYaGuardada())
                                {
                                    <span>DETALLE YA AGREGADO</span>
                                }
                                else
                                {
                                    <span>AGREGAR DETALLE</span>
                                }
                            </button>

                            @if (indiceDetalleEnEdicion.HasValue)
                            {
                                <button type="button" class="btn-cancelar-detalle" @onclick="CancelarEdicionDetalle">Cancelar edición</button>
                            }
                        </div>

                        @if (indiceDetalleEnEdicion.HasValue)
                        {
                            var detEdit = detallesCargados[indiceDetalleEnEdicion.Value];
                            bool bloqueadoPorCobros = DetalleTieneCobrosAsociados(detEdit);

                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <button type="button"
                                        class="btn-eliminar-detalle"
                                        disabled="@bloqueadoPorCobros"
                                        title="@(bloqueadoPorCobros ? "No se puede eliminar un detalle que posee cobros registrados o en el historial." : "Eliminar este detalle de la liquidación")"
                                        @onclick="() => SolicitarEliminarDetalleEnEdicion(detEdit)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:14px;height:14px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    <span>Eliminar detalle</span>
                                </button>
                                @if (bloqueadoPorCobros)
                                {
                                    <span style="font-size:0.72rem; color:#991b1b; font-weight:600;">Tiene cobros asociados</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 3. DETALLES DE LA LIQUIDACIÓN CON DESPLIEGUE INLINE DE SESIONES -->
        <div class="section-card" style="margin-top: 1.5rem;">
            <div class="section-header" style="justify-content: space-between; flex-wrap:wrap; gap:0.5rem;">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <h2 class="section-title">DETALLES DE LA LIQUIDACIÓN (@detallesCargados.Count conceptos)</h2>
                </div>
                <span style="font-size:11px; color:#64748b; font-weight:600;">Tocá una fila para desplegar las sesiones • Usá el lápiz para editar</span>
            </div>

            @if (detallesCargados.Count == 0)
            {
                <div class="empty-detalles-box">
                    <p style="margin:0 0 0.25rem 0; font-weight:600; color:#475569;">No hay detalles agregados a esta liquidación todavía.</p>
                    <span style="font-size:12px; color:#94a3b8;">Utiliza el botón &quot;Cargar Próxima Factura&quot; o completa el formulario superior para añadir prestaciones.</span>
                </div>
            }
            else
            {
                <div class="detalles-hierarchical-container">
                    @foreach (var grupoMod in detallesCargados.GroupBy(d => d.TipoModalidadNombre))
                    {
                        var modNombre = grupoMod.Key;
                        var subFactMod = grupoMod.Sum(x => x.MontoFacturacion);
                        var subRetMod = grupoMod.Sum(x => x.Retencion);
                        var subCobroProfMod = subFactMod - subRetMod;
                        var subSaldoMod = grupoMod.Sum(x => x.Saldo);
                        var subAbonadoMod = subRetMod - subSaldoMod;

                        <div class="group-level-1-modalidad">
                            <div class="group-header-modalidad">
                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <span class="badge-modalidad-pill">@modNombre</span>
                                    <span style="font-size:12px; color:#64748b;">(@grupoMod.Count() registros)</span>
                                </div>
                                <div class="group-totals-chips">
                                    <span>Facturado: <strong>$@subFactMod.ToString("N0")</strong></span>
                                    <span>Retención Centro: <strong class="text-success">+$@subRetMod.ToString("N0")</strong></span>
                                    <span>Cobro Prof.: <strong class="text-primary">$@subCobroProfMod.ToString("N0")</strong></span>
                                    <span>Abonado: <strong>$@subAbonadoMod.ToString("N0")</strong></span>
                                    <span>Saldo: <strong class="@(subSaldoMod > 0 ? "text-danger" : "text-muted")">$@subSaldoMod.ToString("N0")</strong></span>
                                </div>
                            </div>

                            @foreach (var grupoOS in grupoMod.GroupBy(d => !string.IsNullOrEmpty(d.TipoObraSocialNombre) ? d.TipoObraSocialNombre : (modNombre == "Obra Social" ? "Sin Obra Social Asignada" : "Atención Directa / Consultorio")))
                            {
                                var osNombre = grupoOS.Key;
                                var subFactOS = grupoOS.Sum(x => x.MontoFacturacion);
                                var subRetOS = grupoOS.Sum(x => x.Retencion);
                                var subCobroOS = subFactOS - subRetOS;
                                var subSaldoOS = grupoOS.Sum(x => x.Saldo);

                                <div class="group-level-2-obrasocial group-header-obrasocial-styled">
                                    <div class="group-header-obrasocial">
                                        <div style="display:flex; align-items:center; gap:0.5rem;">
                                            <svg width="15" height="15" style="color:#0284c7; width:15px; height:15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                                            <span style="font-weight:750; font-size:13px; color:#0f172a;">@osNombre</span>
                                        </div>
                                        <div class="chips-resumen-obrasocial">
                                            <span class="chip-os chip-subtotal">Subtotal: $@subFactOS.ToString("N0")</span>
                                            <span class="chip-os chip-retencion">Ret. Centro: +$@subRetOS.ToString("N0")</span>
                                            <span class="chip-os chip-prof">Cobro: $@subCobroOS.ToString("N0")</span>
                                            <span class="chip-os @(subSaldoOS > 0 ? "chip-saldo" : "chip-saldado")">
                                                @(subSaldoOS > 0 ? $"Saldo: ${subSaldoOS.ToString("N0")}" : "Saldado")
                                            </span>
                                        </div>
                                    </div>

                                    @foreach (var grupoPrest in grupoOS.GroupBy(d => d.TipoPrestacionNombre ?? d.TipoModalidadNombre))
                                    {
                                        var prestNombre = grupoPrest.Key;

                                        <div class="group-level-3-prestacion">
                                            <div class="group-header-prestacion">
                                                <span class="prestacion-title-tag">@prestNombre</span>
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table-detalles">
                                                    <thead>
                                                        <tr>
                                                            <th>Paciente / Detalle</th>
                                                            <th>Sesiones</th>
                                                            <th class="text-end">Facturado</th>
                                                            <th class="text-end">Ret. Centro</th>
                                                            <th class="text-end">Cobro Prof.</th>
                                                            <th class="text-end">Abonado</th>
                                                            <th class="text-end">Saldo Centro</th>
                                                            <th class="text-center">Estado</th>
                                                            <th class="text-center" style="width:54px;">Editar</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var d in grupoPrest)
                                                        {
                                                            var index = detallesCargados.IndexOf(d);
                                                            var cobroFila = d.MontoFacturacion - d.Retencion;
                                                            var abonadoFila = d.Retencion - d.Saldo;
                                                            var estaExpandido = detallesExpandidos.Contains(index);
                                                            var estaEnEdicion = indiceDetalleEnEdicion == index;

                                                            <tr class="detalle-row-clickable @(estaExpandido ? "row-expanded-active" : "") @(estaEnEdicion ? "row-editing-active" : "")"
                                                                @onclick="() => ToggleExpandirDetalle(index)">
                                                                <td>
                                                                    <div style="display:flex; align-items:center; gap:0.45rem; flex-wrap:wrap;">
                                                                        <span class="expand-caret">@(estaExpandido ? "▼" : "▶")</span>
                                                                        <span style="font-weight:700; color:#0f172a;">@(!string.IsNullOrEmpty(d.PacienteNombreCompleto) ? d.PacienteNombreCompleto : "Sin paciente")</span>
                                                                        @if (d.ValoresModificadosManualmente)
                                                                        {
                                                                            <span class="badge-tag-modificado" title="@d.ResumenCambiosManuales">Modificado</span>
                                                                        }
                                                                        @if (d.SinCoincidenciaAgenda)
                                                                        {
                                                                            <span class="badge-sin-agenda" title="No coincide con ningún turno del calendario">Sin agenda</span>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <span>@d.Cantidad ses.</span>
                                                                    @if (d.SesionesCobradas > 0 && d.SesionesCobradas < d.Cantidad)
                                                                    {
                                                                        <div style="font-size:0.68rem; color:#0f766e; font-weight:600;">@d.SesionesCobradas.ToString("0.##")/@d.Cantidad cobr.</div>
                                                                    }
                                                                </td>
                                                                <td class="text-end font-bold text-dark">$@d.MontoFacturacion.ToString("N2")</td>
                                                                <td class="text-end font-bold text-success">+$@d.Retencion.ToString("N2")</td>
                                                                <td class="text-end font-bold text-primary">$@cobroFila.ToString("N2")</td>
                                                                <td class="text-end font-bold text-dark">$@abonadoFila.ToString("N2")</td>
                                                                <td class="text-end font-bold @(d.Saldo > 0 ? "text-danger" : "text-muted")">$@d.Saldo.ToString("N2")</td>
                                                                <td class="text-center">
                                                                    @switch (d.EstadoPago)
                                                                    {
                                                                        case EnumEstadoPagoLiquidacion.Pagado:
                                                                            <span class="badge-mini-pagado">Cobrado</span>
                                                                            break;
                                                                        case EnumEstadoPagoLiquidacion.Parcial:
                                                                            <span class="badge-mini-parcial">Cobro parcial</span>
                                                                            break;
                                                                        default:
                                                                            <span class="badge-mini-pendiente">Pendiente de cobro</span>
                                                                            break;
                                                                    }
                                                                </td>
                                                                <td class="text-center" @onclick:stopPropagation="true">
                                                                    <button type="button"
                                                                            class="btn-icon-table text-primary"
                                                                            title="Editar detalle en la sección superior"
                                                                            @onclick="() => EditarDetalle(index)">
                                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                                                    </button>
                                                                </td>
                                                            </tr>

                                                            @if (estaExpandido)
                                                            {
                                                                <tr class="row-inline-sesiones">
                                                                    <td colspan="9" style="padding:0.75rem 1rem; background:#f8fafc;">
                                                                        @if (cargandoTurnosInline.Contains(index))
                                                                        {
                                                                            <div style="font-size:0.78rem; color:#64748b; padding:0.4rem;">Cargando sesiones de la agenda...</div>
                                                                        }
                                                                        else if (d.TurnosAsociados == null || d.TurnosAsociados.Count == 0)
                                                                        {
                                                                            <div style="font-size:0.78rem; color:#64748b; padding:0.4rem;">
                                                                                @(d.SinCoincidenciaAgenda
                                                                                    ? "Detalle cargado manualmente sin coincidencia con turnos del calendario."
                                                                                    : "No hay sesiones de agenda vinculadas a este detalle.")
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="inline-sesiones-list">
                                                                                @foreach (var t in d.TurnosAsociados)
                                                                                {
                                                                                    var keyPacToggle = $"{index}_{t.TurnoId}";
                                                                                    bool mostrarPacientesTurno = pacientesTurnoExpandidos.Contains(keyPacToggle);

                                                                                    <div class="inline-sesion-card">
                                                                                        <div class="inline-sesion-row-top">
                                                                                            <span class="sesion-num-tag">#@t.NumeroSesion</span>
                                                                                            <span class="sesion-fecha">@t.Fecha.ToString("dd/MM/yyyy")</span>
                                                                                            <span class="sesion-hora">@t.HoraInicio.ToString(@"hh\:mm") - @t.HoraFin.ToString(@"hh\:mm")</span>
                                                                                            <span class="sesion-consultorio" title="@t.ConsultorioNombre">@FormatearConsultorioCorto(t.ConsultorioNombre)</span>
                                                                                            <span class="badge-tag-mini">@(string.IsNullOrEmpty(t.NumeroLiquidacion) ? numeroLiquidacion : t.NumeroLiquidacion)</span>
                                                                                            <span class="@ObtenerClaseEstadoTurnoBadge(t.EstadoTurno)">@FormatearEstadoTurno(t.EstadoTurno)</span>
                                                                                            <span class="sesion-tipo-tag">@t.TipoTurnoOriginal</span>
                                                                                        </div>

                                                                                        <div class="inline-sesion-row-bottom">
                                                                                            @if (d.TipoModalidadId >= 3)
                                                                                            {
                                                                                                <span style="font-size:0.76rem; color:#475569;">
                                                                                                    Prestación: <strong>@t.TipoTurnoNombre</strong>
                                                                                                </span>
                                                                                                @if (t.PacientesTurno != null && t.PacientesTurno.Count > 0)
                                                                                                {
                                                                                                    <button type="button"
                                                                                                            class="btn-ver-pacientes-inline"
                                                                                                            @onclick:stopPropagation="true"
                                                                                                            @onclick="() => TogglePacientesTurno(keyPacToggle)">
                                                                                                        @(mostrarPacientesTurno ? "Ocultar pacientes" : $"Ver pacientes ({t.PacientesTurno.Count})")
                                                                                                    </button>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span style="font-size:0.72rem; color:#94a3b8;">Sin pacientes asignados</span>
                                                                                                }
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span style="font-size:0.76rem; color:#334155;">
                                                                                                    Paciente: <strong>@(string.IsNullOrWhiteSpace(t.PacienteNombre) ? d.PacienteNombreCompleto : t.PacienteNombre)</strong>
                                                                                                </span>
                                                                                                <span class="asistencia-pill @ObtenerClaseAsistencia(t.EstadoPaciente)">
                                                                                                    Asistencia: @FormatearAsistencia(t.EstadoPaciente)
                                                                                                </span>
                                                                                            }
                                                                                        </div>

                                                                                        @if (d.TipoModalidadId >= 3 && mostrarPacientesTurno && t.PacientesTurno != null && t.PacientesTurno.Count > 0)
                                                                                        {
                                                                                            <div class="inline-pacientes-sublist">
                                                                                                @foreach (var pacT in t.PacientesTurno)
                                                                                                {
                                                                                                    <div class="inline-paciente-item">
                                                                                                        <span>
                                                                                                            <strong>@pacT.PacienteNombre</strong>
                                                                                                            @if (!string.IsNullOrWhiteSpace(pacT.ObraSocialNombre))
                                                                                                            {
                                                                                                                <span style="color:#64748b;"> (@pacT.ObraSocialNombre)</span>
                                                                                                            }
                                                                                                        </span>
                                                                                                        <span class="asistencia-pill @ObtenerClaseAsistencia(pacT.Asistencia)">
                                                                                                            @FormatearAsistencia(pacT.Asistencia)
                                                                                                        </span>
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 4. TOTALES DE LA LIQUIDACIÓN Y BOTÓN GUARDAR -->
        <div class="totals-summary-card">
            <div class="totals-inner-row">
                <div class="totals-grid-metrics">
                    <div class="metric-box">
                        <span class="summary-label">FACTURADO PROF.</span>
                        <div class="summary-val text-dark">$@detallesCargados.Sum(d => d.MontoFacturacion).ToString("N2")</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">RETENCIÓN CENTRO</span>
                        <div class="summary-val text-success">+$@detallesCargados.Sum(d => d.Retencion).ToString("N2")</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">COBRO PROFESIONAL</span>
                        <div class="summary-val text-primary">$@((detallesCargados.Sum(d => d.MontoFacturacion) - detallesCargados.Sum(d => d.Retencion)).ToString("N2"))</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">TOTAL ABONADO</span>
                        <div class="summary-val text-dark">$@((detallesCargados.Sum(d => d.Retencion) - detallesCargados.Sum(d => d.Saldo)).ToString("N2"))</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">SALDO PENDIENTE CENTRO</span>
                        <div class="summary-val text-danger">$@detallesCargados.Sum(d => d.Saldo).ToString("N2")</div>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn-guardar-principal" disabled="@guardando" @onclick="GuardarLiquidacionFinal">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;min-width:18px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@(guardando ? "Guardando..." : "GUARDAR LIQUIDACIÓN")</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- ================= MODALES ================= -->

<!-- 1. MODAL CONFIRMAR ELIMINACIÓN DE DETALLE -->
@if (mostrarModalEliminarDetalle && detalleAEliminar != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom" style="max-width:500px;">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="20" height="20" class="text-danger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <h3 style="color:#dc2626;">Eliminar detalle de liquidación</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalEliminarDetalle = false">✕</button>
            </div>
            <div class="modal-body-custom">
                <p>¿Está seguro de eliminar este detalle de la liquidación?</p>
                <div class="box-warning-details">
                    <div>Concepto: <strong>@detalleAEliminar.PacienteNombreCompleto</strong></div>
                    <div>Modalidad / Prestación: <strong>@detalleAEliminar.TipoModalidadNombre • @detalleAEliminar.TipoPrestacionNombre</strong></div>
                    <div>Facturado: <strong>$@detalleAEliminar.MontoFacturacion.ToString("N2")</strong> • Retención: <strong>$@detalleAEliminar.Retencion.ToString("N2")</strong></div>
                </div>
                <p style="font-size:0.78rem; color:#64748b; margin-bottom:0;">
                    Si tiene turnos de la agenda asociados (@detalleAEliminar.TurnosIds.Count), volverán a quedar disponibles como pendientes al guardar la liquidación.
                </p>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalEliminarDetalle = false">Cancelar</button>
                <button type="button" class="btn-danger-custom" @onclick="ConfirmarEliminarDetalle">Confirmar Eliminación</button>
            </div>
        </div>
    </div>
}

<!-- 2. MODAL REGISTRAR COBRO CON SINCRONIZACIÓN AUTOMÁTICA Y SESIONES PARCIALES -->
@if (mostrarModalRegistrarCobro)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom" style="max-width:860px;">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="20" height="20" style="color:#0d9488;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    <h3>Registrar Cobro sobre #@numeroLiquidacion</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalRegistrarCobro = false">✕</button>
            </div>
            <div class="modal-body-custom" style="max-height:75vh; overflow-y:auto;">
                <div style="font-weight:700; font-size:0.85rem; color:#0f172a; margin-bottom:0.5rem;">
                    1. Seleccionar conceptos de la liquidación a cobrar:
                </div>
                <div style="max-height:240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:1rem;">
                    <table class="table-detalles">
                        <thead>
                            <tr>
                                <th style="width:36px;"></th>
                                <th>Paciente / Concepto</th>
                                <th>Saldo Pendiente</th>
                                <th>Sesiones a Cobrar</th>
                                <th>Monto a Cobrar ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in itemsDetallesACobrar)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" @bind="item.Seleccionado" @bind:after="SincronizarMetodosPagoDesdeConceptos" />
                                    </td>
                                    <td>
                                        <div style="font-weight:700; color:#0f172a;">@item.PacienteNombre</div>
                                        <span style="font-size:0.7rem; color:#64748b;">
                                            @item.PrestacionNombre (@item.ModalidadNombre) • @item.SesionesPendientes.ToString("0.##")/@item.CantidadSesionesTotal ses. pend.
                                        </span>
                                    </td>
                                    <td class="font-bold text-danger">$@item.SaldoPendiente.ToString("N2")</td>
                                    <td>
                                        <input type="number"
                                               step="0.25"
                                               min="0"
                                               max="@item.SesionesPendientes"
                                               style="width:82px; height:30px;"
                                               class="custom-input-sm"
                                               @bind="item.SesionesACobrar"
                                               @bind:after="() => AlCambiarSesionesCobro(item)"
                                               disabled="@(!item.Seleccionado)" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               step="any"
                                               min="0"
                                               max="@item.SaldoPendiente"
                                               style="width:125px; height:30px;"
                                               class="custom-input-sm"
                                               @bind="item.MontoACobrar"
                                               @bind:after="() => AlCambiarMontoCobro(item)"
                                               disabled="@(!item.Seleccionado)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; background:#f8fafc; padding:0.6rem 0.85rem; border-radius:6px; border:1px solid #e2e8f0;">
                    <span style="font-size:0.85rem; font-weight:700;">Total de Conceptos Seleccionados:</span>
                    <strong style="font-size:1.15rem; color:#0d9488;">$@TotalCobroImputadoSeleccionado.ToString("N2")</strong>
                </div>

                <div style="font-weight:700; font-size:0.85rem; color:#0f172a; margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
                    <span>2. Métodos de Pago utilizados:</span>
                    <div style="display:flex; gap:0.5rem;">
                        @if (Math.Abs(TotalCobroImputadoSeleccionado - TotalMetodosPagoOperacion) > 0.01m)
                        {
                            <button type="button" class="btn-secondary-custom" style="padding:2px 8px; font-size:0.75rem; background:#dbeafe; color:#1d4ed8;" @onclick="IgualarMetodosPagoConConceptos">Igualar monto ($@TotalCobroImputadoSeleccionado.ToString("N2"))</button>
                        }
                        <button type="button" class="btn-secondary-custom" style="padding:2px 8px; font-size:0.75rem;" @onclick="AgregarMetodoPagoFila">+ Agregar Método</button>
                    </div>
                </div>

                @foreach (var mp in metodosPagoOperacion)
                {
                    <div style="display:grid; grid-template-columns: 140px 130px 1fr 1fr 30px; gap:8px; margin-bottom:8px; align-items:center;">
                        <select style="height:32px;" class="custom-input-sm" @bind="mp.MetodoPago" @bind:after="() => mp.MetodoPagoNombre = mp.MetodoPago.ToString()">
                            <option value="@MetodoDePago.Efectivo">Efectivo</option>
                            <option value="@MetodoDePago.Transferencia">Transferencia</option>
                        </select>
                        <input type="number" step="any" placeholder="Monto" style="height:32px;" class="custom-input-sm" @bind="mp.Monto" />
                        @if (mp.MetodoPago == MetodoDePago.Transferencia)
                        {
                            <input type="text" placeholder="Cuenta / CBU origen (opcional)" style="height:32px;" class="custom-input-sm" @bind="mp.CuentaOrigen" />
                            <input type="text" placeholder="N° Comprobante" style="height:32px;" class="custom-input-sm" @bind="mp.NumeroComprobante" />
                        }
                        else
                        {
                            <div style="color:#94a3b8; font-size:0.75rem; padding-left:4px;">Pago en efectivo directo</div>
                            <div></div>
                        }
                        <button type="button" style="border:none; background:none; color:#ef4444; font-weight:700; cursor:pointer;" disabled="@(metodosPagoOperacion.Count <= 1)" @onclick="() => QuitarMetodoPagoFila(metodosPagoOperacion, mp)">✕</button>
                    </div>
                }

                @if (Math.Abs(TotalCobroImputadoSeleccionado - TotalMetodosPagoOperacion) > 0.01m)
                {
                    <div style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:6px; padding:0.45rem 0.75rem; font-size:0.78rem; margin-top:0.5rem;">
                        La suma de métodos ($@TotalMetodosPagoOperacion.ToString("N2")) debe coincidir con el total seleccionado ($@TotalCobroImputadoSeleccionado.ToString("N2")).
                    </div>
                }
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalRegistrarCobro = false">Cancelar</button>
                <button type="button"
                        class="btn-guardar-principal"
                        style="background:#0d9488;"
                        @onclick="ConfirmarRegistroCobro"
                        disabled="@(procesandoCobro || TotalCobroImputadoSeleccionado <= 0 || Math.Abs(TotalCobroImputadoSeleccionado - TotalMetodosPagoOperacion) > 0.01m)">
                    @(procesandoCobro ? "Asentando..." : $"Asentar Cobro (${TotalMetodosPagoOperacion:N2})")
                </button>
            </div>
        </div>
    </div>
}

<!-- 3. MODAL HISTORIAL DE COBROS (VIGENTES, MODIFICADOS Y ANULADOS) -->
@if (mostrarModalHistorialPagos)
{
    var pagosAMostrar = filtroDetalleIdHistorial.HasValue
        ? historialPagos.Where(p => p.Imputaciones.Any(i => i.DetalleLiquidacionId == filtroDetalleIdHistorial.Value)).ToList()
        : historialPagos;

    <div class="modal-backdrop-custom">
        <div class="modal-card-custom" style="max-width:780px;">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <h3>Historial de Cobros - #@numeroLiquidacion</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalHistorialPagos = false">✕</button>
            </div>
            <div class="modal-body-custom" style="max-height:500px; overflow-y:auto;">
                @if (filtroDetalleIdHistorial.HasValue)
                {
                    <div class="historial-filter-bar">
                        <span>Mostrando únicamente los cobros del detalle seleccionado.</span>
                        <button type="button" class="btn-secondary-custom" style="padding:0.25rem 0.65rem; font-size:0.75rem;" @onclick="() => filtroDetalleIdHistorial = null">
                            Ver historial completo (@historialPagos.Count)
                        </button>
                    </div>
                }

                @if (pagosAMostrar.Count == 0)
                {
                    <div style="text-align:center; padding:2rem; color:#94a3b8;">No se registran cobros para este criterio.</div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.75rem;">
                        @foreach (var pago in pagosAMostrar)
                        {
                            <div class="section-card" style="margin:0; padding:0.9rem; @(pago.Anulado ? "background:#fff5f5; border-color:#fecaca;" : (pago.Modificado ? "background:#fffbeb; border-color:#fde68a;" : ""))">
                                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.45rem;">
                                    <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                        <strong style="font-size:1.05rem; color:#0f172a;">$@pago.MontoTotal.ToString("N2")</strong>
                                        <span class="badge-tag-mini">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (pago.Anulado)
                                        {
                                            <span class="badge-mini-pendiente">ANULADO</span>
                                        }
                                        else if (pago.Modificado)
                                        {
                                            <span class="badge-mini-parcial">MODIFICADO</span>
                                        }
                                        else
                                        {
                                            <span class="badge-mini-pagado">VIGENTE</span>
                                        }

                                        @if (pago.PagoOriginalId.HasValue)
                                        {
                                            <span class="badge-tag-mini">Reemplaza cobro #@pago.PagoOriginalId</span>
                                        }
                                    </div>
                                    @if (!pago.Anulado && !pago.Modificado)
                                    {
                                        <div style="display:flex; align-items:center; gap:0.65rem;">
                                            <button type="button" class="btn-icon-table text-primary" style="font-size:0.75rem; font-weight:700;" @onclick="() => AbrirModalModificarCobro(pago)">
                                                Modificar
                                            </button>
                                            <button type="button" class="btn-icon-table text-danger" style="font-size:0.75rem; font-weight:700;" @onclick="() => AbrirModalAnularCobro(pago)">
                                                Anular
                                            </button>
                                        </div>
                                    }
                                </div>

                                <div style="font-size:0.76rem; color:#64748b; margin-bottom:0.35rem;">
                                    Registrado por: <strong>@pago.RegistradoPor</strong>
                                    @foreach (var m in pago.Metodos)
                                    {
                                        <span style="margin-left:6px;" class="badge-tag-mini">@m.MetodoPagoNombre: $@m.Monto.ToString("N2") @(!string.IsNullOrEmpty(m.CuentaOrigen) ? $"({m.CuentaOrigen})" : "") @(!string.IsNullOrEmpty(m.NumeroComprobante) ? $"#{m.NumeroComprobante}" : "")</span>
                                    }
                                </div>

                                @if (pago.Imputaciones.Count > 0)
                                {
                                    <div style="font-size:0.74rem; color:#475569; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:0.4rem 0.6rem; margin-top:0.35rem;">
                                        @foreach (var imp in pago.Imputaciones)
                                        {
                                            <div>• <strong>@imp.PacienteNombre</strong> (@imp.PrestacionNombre): <strong>$@imp.MontoImputado.ToString("N2")</strong> (@imp.CantidadSesionesCobradas.ToString("0.##") ses.)</div>
                                        }
                                    </div>
                                }

                                @if (pago.Modificado)
                                {
                                    <div style="background:#fef3c7; border-left:3px solid #d97706; padding:0.4rem 0.6rem; margin-top:0.5rem; font-size:0.75rem; color:#92400e; border-radius:4px;">
                                        Modificado por <strong>@pago.ModificadoPor</strong> el @pago.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") — Motivo: @pago.MotivoModificacion
                                    </div>
                                }

                                @if (pago.Anulado)
                                {
                                    <div style="background:#fef2f2; border-left:3px solid #dc2626; padding:0.4rem 0.6rem; margin-top:0.5rem; font-size:0.75rem; color:#991b1b; border-radius:4px;">
                                        Anulado por <strong>@pago.AnuladoPor</strong> el @pago.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm") — Motivo: @pago.MotivoAnulacion
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalHistorialPagos = false">Cerrar</button>
            </div>
        </div>
    </div>
}

<!-- 4. MODAL MODIFICAR COBRO -->
@if (mostrarModalModificarCobro && pagoAModificar != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom" style="max-width:860px;">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="18" height="18" class="text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                    <h3>Modificar Cobro #@pagoAModificar.Id</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalModificarCobro = false">✕</button>
            </div>
            <div class="modal-body-custom" style="max-height:75vh; overflow-y:auto;">
                <p style="font-size:0.8rem; color:#475569; margin-bottom:0.75rem;">
                    El registro anterior quedará guardado como <strong>Modificado</strong> en el historial y se registrará esta versión actualizada.
                </p>

                <div style="font-weight:700; font-size:0.85rem; color:#0f172a; margin-bottom:0.5rem;">
                    1. Conceptos incluidos en el cobro:
                </div>
                <div style="max-height:220px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:1rem;">
                    <table class="table-detalles">
                        <thead>
                            <tr>
                                <th style="width:36px;"></th>
                                <th>Paciente / Concepto</th>
                                <th>Saldo Disponible</th>
                                <th>Sesiones a Cobrar</th>
                                <th>Monto a Cobrar ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in itemsDetallesModificacion)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" @bind="item.Seleccionado" @bind:after="SincronizarMetodosPagoModificacion" />
                                    </td>
                                    <td>
                                        <div style="font-weight:700; color:#0f172a;">@item.PacienteNombre</div>
                                        <span style="font-size:0.7rem; color:#64748b;">@item.PrestacionNombre (@item.ModalidadNombre)</span>
                                    </td>
                                    <td class="font-bold text-danger">$@item.SaldoPendiente.ToString("N2")</td>
                                    <td>
                                        <input type="number"
                                               step="0.25"
                                               min="0"
                                               max="@item.SesionesPendientes"
                                               style="width:82px; height:30px;"
                                               class="custom-input-sm"
                                               @bind="item.SesionesACobrar"
                                               @bind:after="() => AlCambiarSesionesModificacion(item)"
                                               disabled="@(!item.Seleccionado)" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               step="any"
                                               min="0"
                                               max="@item.SaldoPendiente"
                                               style="width:125px; height:30px;"
                                               class="custom-input-sm"
                                               @bind="item.MontoACobrar"
                                               @bind:after="() => AlCambiarMontoModificacion(item)"
                                               disabled="@(!item.Seleccionado)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; background:#f8fafc; padding:0.6rem 0.85rem; border-radius:6px; border:1px solid #e2e8f0;">
                    <span style="font-size:0.85rem; font-weight:700;">Nuevo Total del Cobro:</span>
                    <strong style="font-size:1.15rem; color:#0d9488;">$@TotalModificacionSeleccionado.ToString("N2")</strong>
                </div>

                <div style="font-weight:700; font-size:0.85rem; color:#0f172a; margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center;">
                    <span>2. Métodos de Pago:</span>
                    <div style="display:flex; gap:0.5rem;">
                        @if (Math.Abs(TotalModificacionSeleccionado - TotalMetodosModificacion) > 0.01m)
                        {
                            <button type="button" class="btn-secondary-custom" style="padding:2px 8px; font-size:0.75rem; background:#dbeafe; color:#1d4ed8;" @onclick="IgualarMetodosModificacion">Igualar ($@TotalModificacionSeleccionado.ToString("N2"))</button>
                        }
                        <button type="button" class="btn-secondary-custom" style="padding:2px 8px; font-size:0.75rem;" @onclick="AgregarMetodoModificacionFila">+ Agregar Método</button>
                    </div>
                </div>

                @foreach (var mp in metodosPagoModificacion)
                {
                    <div style="display:grid; grid-template-columns: 140px 130px 1fr 1fr 30px; gap:8px; margin-bottom:8px; align-items:center;">
                        <select style="height:32px;" class="custom-input-sm" @bind="mp.MetodoPago" @bind:after="() => mp.MetodoPagoNombre = mp.MetodoPago.ToString()">
                            <option value="@MetodoDePago.Efectivo">Efectivo</option>
                            <option value="@MetodoDePago.Transferencia">Transferencia</option>
                        </select>
                        <input type="number" step="any" placeholder="Monto" style="height:32px;" class="custom-input-sm" @bind="mp.Monto" />
                        @if (mp.MetodoPago == MetodoDePago.Transferencia)
                        {
                            <input type="text" placeholder="Cuenta / CBU origen" style="height:32px;" class="custom-input-sm" @bind="mp.CuentaOrigen" />
                            <input type="text" placeholder="N° Comprobante" style="height:32px;" class="custom-input-sm" @bind="mp.NumeroComprobante" />
                        }
                        else
                        {
                            <div style="color:#94a3b8; font-size:0.75rem; padding-left:4px;">Pago en efectivo directo</div>
                            <div></div>
                        }
                        <button type="button" style="border:none; background:none; color:#ef4444; font-weight:700; cursor:pointer;" disabled="@(metodosPagoModificacion.Count <= 1)" @onclick="() => QuitarMetodoPagoFila(metodosPagoModificacion, mp)">✕</button>
                    </div>
                }

                <div class="field-col" style="margin-top:0.85rem;">
                    <label class="form-label-custom">MOTIVO DE MODIFICACIÓN (OBLIGATORIO)</label>
                    <input type="text" class="custom-input" placeholder="Ej: Corrección de monto abonado o cambio de medio de pago" @bind="motivoModificacionTexto" />
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalModificarCobro = false">Cancelar</button>
                <button type="button"
                        class="btn-guardar-principal"
                        @onclick="ConfirmarModificacionCobro"
                        disabled="@(procesandoCobro || string.IsNullOrWhiteSpace(motivoModificacionTexto) || TotalModificacionSeleccionado <= 0 || Math.Abs(TotalModificacionSeleccionado - TotalMetodosModificacion) > 0.01m)">
                    @(procesandoCobro ? "Guardando..." : "Confirmar Modificación")
                </button>
            </div>
        </div>
    </div>
}

<!-- 5. MODAL ANULAR COBRO -->
@if (mostrarModalAnularCobro && pagoAAnular != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom" style="max-width:500px;">
            <div class="modal-header-custom">
                <h3 style="color:#dc2626; margin:0; font-size:1.05rem;">Anular Cobro</h3>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalAnularCobro = false">✕</button>
            </div>
            <div class="modal-body-custom">
                <p>¿Está seguro de anular el cobro de <strong>$@pagoAAnular.MontoTotal.ToString("N2")</strong>? El saldo se revertirá a pendiente.</p>
                <div class="field-col" style="margin-top:0.75rem;">
                    <label class="form-label-custom">Usuario responsable</label>
                    <input type="text" class="custom-input input-locked" value="@usuarioResponsable" readonly disabled />
                </div>
                <div class="field-col" style="margin-top:0.75rem;">
                    <label class="form-label-custom">Motivo Obligatorio</label>
                    <input type="text" class="custom-input" placeholder="Ej: Error en el monto o transferencia rechazada" @bind="motivoAnulacionTexto" />
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalAnularCobro = false">Cancelar</button>
