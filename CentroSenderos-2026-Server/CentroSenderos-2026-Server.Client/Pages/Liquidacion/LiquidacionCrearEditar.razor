                ValoresModificadosManualmente = d.ValoresModificadosManualmente,
                SinCoincidenciaAgenda = d.SinCoincidenciaAgenda,
                ResumenCambiosManuales = d.ResumenCambiosManuales,
                SesionesCobradas = d.SesionesCobradas,
                TurnosIds = d.TurnosAsociados.Select(t => t.TurnoId).ToList(),
                TurnosAsociados = d.TurnosAsociados
            }).ToList();

            await CargarHistorialPagos();
            await CargarFacturasPendientesAgenda();
            hayCambiosSinGuardar = false;
        }
        else
        {
            MostrarAlerta("No se pudo cargar la liquidación solicitada: " + rLiq.ObtenerError(), "danger");
        }
    }

