@code {
    [Parameter] public int? Id { get; set; }

    private bool cargando = true;
    private bool guardando = false;
    private bool hayCambiosSinGuardar = false;
    private bool seccionCargarFacturaAbierta = true;
    private bool mostrarMenuFacturasPendientes = false;
    private bool mostrarModalSesiones = false;
    private bool mostrarModalSalir = false;

    private string? mensajeAlerta;
    private bool esErrorAlerta = false;

    private List<ProfesionalListadoDTO> listaProfesionales = new();
    private List<PacienteResumenDTO> listaPacientes = new();
    private List<TipoPrestacionListadoDTO> listaPrestaciones = new();
    private List<TipoObraSocialDTO> listaObrasSociales = new();
    private List<SocioListadoDTO> listaSocios = new();

    private List<FacturaAgrupadaAgendaDTO> facturasPendientesAgenda = new();

    private string numeroLiquidacion = "";
    private int profesionalId = 0;
    private int socioId = 0;
    private DateTime fechaDesde = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime fechaHasta = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month));

    private int? indiceDetalleEnEdicion = null;
    private int tipoModalidadId = 1;
    private int pacienteId = 0;
    private int tipoPrestacionId = 0;
    private int tipoObraSocialId = 0;
    private decimal montoUnitario = 0;
    private int cantidad = 1;

    private int cantidadModCompleto = 0;
    private decimal montoModCompleto = 50000;
    private int cantidadMedioMod = 0;
    private decimal montoMedioMod = 30000;

    private decimal montoFacturacion = 0;
    private decimal porcentajeRetencion = 20;
    private decimal montoRetencion = 0;
    private decimal cobroProfesional = 0;
    private decimal montoAbonado = 0;
    private decimal saldoPendiente = 0;
    private List<int> turnosIdsDetalleActual = new();

    private List<GuardarDetalleLiquidacionDTO> detallesCargados = new();

    private GuardarDetalleLiquidacionDTO? detalleParaSesiones;
    private List<TurnoLiquidacionItemDTO> turnosSesionModal = new();

    public class FacturaAgrupadaAgendaDTO
    {
        public int PacienteId { get; set; }
        public string PacienteNombre { get; set; } = "";
        public int TipoModalidadId { get; set; }
        public string ModalidadNombre { get; set; } = "";
        public int TipoPrestacionId { get; set; }
        public string PrestacionNombre { get; set; } = "";
        public int? TipoObraSocialId { get; set; }
        public string? ObraSocialNombre { get; set; }
        public decimal MontoSesion { get; set; }
        public decimal PorcentajeRetencion { get; set; }
        public int CantidadTurnos { get; set; }
        public List<int> TurnosIds { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        cargando = true;
        try
        {
            var rProf = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
            if (!rProf.Error && rProf.Respuesta != null) listaProfesionales = rProf.Respuesta;

            var rPac = await Http.Get<List<PacienteResumenDTO>>("api/paciente/resumen");
            if (!rPac.Error && rPac.Respuesta != null) listaPacientes = rPac.Respuesta;

            var rPrest = await Http.Get<List<TipoPrestacionListadoDTO>>("api/tipoprestacion");
            if (!rPrest.Error && rPrest.Respuesta != null) listaPrestaciones = rPrest.Respuesta;

            var rOS = await Http.Get<List<TipoObraSocialDTO>>("api/tipoobrasocial");
            if (!rOS.Error && rOS.Respuesta != null) listaObrasSociales = rOS.Respuesta;

            var rSocios = await Http.Get<List<SocioListadoDTO>>("api/socio");
            if (!rSocios.Error && rSocios.Respuesta != null)
            {
                listaSocios = rSocios.Respuesta;
                if (socioId == 0 && listaSocios.Count > 0) socioId = listaSocios.First().Id;
            }

            if (Id.HasValue && Id.Value > 0)
            {
                var rLiq = await Http.Get<LiquidacionDTO>($"api/liquidacion/{Id.Value}");
                if (!rLiq.Error && rLiq.Respuesta != null)
                {
                    var liq = rLiq.Respuesta;
                    numeroLiquidacion = liq.NumeroLiquidacion;
                    profesionalId = liq.ProfesionalId;
                    socioId = liq.SocioId;
                    fechaDesde = liq.FechaDesde;
                    fechaHasta = liq.FechaHasta;

                    detallesCargados = liq.Detalles.Select(d => new GuardarDetalleLiquidacionDTO
                    {
                        Id = d.Id,
                        TipoModalidadId = d.TipoModalidadId,
                        TipoModalidadNombre = d.TipoModalidadNombre,
                        PacienteId = d.PacienteId,
                        PacienteNombreCompleto = d.PacienteNombreCompleto,
                        TipoPrestacionId = d.TipoPrestacionId,
                        TipoPrestacionNombre = d.TipoPrestacionNombre,
                        TipoObraSocialId = d.TipoObraSocialId,
                        TipoObraSocialNombre = d.TipoObraSocialNombre,
                        MontoUnitario = d.MontoUnitario,
                        Cantidad = d.Cantidad,
                        MontoFacturacion = d.MontoFacturacion,
                        Porcentaje = d.Porcentaje,
                        Retencion = d.Retencion,
                        Saldo = d.Saldo,
                        EstadoPago = d.EstadoPago,
                        TurnosIds = new List<int>()
                    }).ToList();
                }
            }
            else
            {
                numeroLiquidacion = $"LIQ-{DateTime.Now:yyyyMMdd-HHmm}";
            }

            await CargarFacturasPendientesAgenda();
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error al cargar datos: " + ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AlCambiarProfesionalOFechas()
    {
        MarcarCambios();
        await CargarFacturasPendientesAgenda();
    }

    private async Task CargarFacturasPendientesAgenda()
    {
        if (profesionalId <= 0)
        {
            facturasPendientesAgenda.Clear();
            return;
        }

        try
        {
            string url = $"api/liquidacion/turnos-pendientes?profesionalId={profesionalId}&fechaDesde={fechaDesde:yyyy-MM-dd}&fechaHasta={fechaHasta:yyyy-MM-dd}";
            var r = await Http.Get<List<TurnoLiquidacionItemDTO>>(url);
            if (!r.Error && r.Respuesta != null)
            {
                facturasPendientesAgenda = r.Respuesta
                    .GroupBy(t => new { t.PacienteId, t.TipoPrestacionId, t.ObraSocialId, t.TipoModalidadId })
                    .Select(g =>
                    {
                        var primerTurno = g.First();
                        var prest = listaPrestaciones.FirstOrDefault(p => p.Id == primerTurno.TipoPrestacionId);
                        var modalidadId = primerTurno.TipoModalidadId > 0 ? primerTurno.TipoModalidadId : (primerTurno.ObraSocialId.HasValue ? 2 : 1);
                        var modalidadNombre = modalidadId switch
                        {
                            2 => "Obra Social",
                            3 => "Módulos",
                            4 => "Por Hora",
                            5 => "Taller",
                            _ => "Particular"
                        };

                        return new FacturaAgrupadaAgendaDTO
                        {
                            PacienteId = primerTurno.PacienteId ?? 0,
                            PacienteNombre = primerTurno.PacienteNombreCompleto ?? primerTurno.PacienteNombre ?? "Sin nombre",
                            TipoModalidadId = modalidadId,
                            ModalidadNombre = modalidadNombre,
                            TipoPrestacionId = primerTurno.TipoPrestacionId ?? 0,
                            PrestacionNombre = primerTurno.TipoTurnoNombre,
                            TipoObraSocialId = primerTurno.ObraSocialId,
                            ObraSocialNombre = primerTurno.ObraSocialNombre,
                            MontoSesion = primerTurno.MontoSesion > 0 ? primerTurno.MontoSesion : (prest?.MontoSesion ?? 15000),
                            PorcentajeRetencion = prest?.PorcentajeRetencion ?? (modalidadId >= 3 ? 100 : 20),
                            CantidadTurnos = g.Count(),
                            TurnosIds = g.Select(x => x.TurnoId).ToList()
                        };
                    }).ToList();
            }
        }
        catch
        {
            facturasPendientesAgenda.Clear();
        }
    }

    private List<FacturaAgrupadaAgendaDTO> FacturasPendientesSinCargar()
    {
        return facturasPendientesAgenda
            .Where(f => !detallesCargados.Any(d =>
                d.PacienteId == f.PacienteId &&
                d.TipoPrestacionId == f.TipoPrestacionId &&
                d.TipoModalidadId == f.TipoModalidadId &&
                d.TipoObraSocialId == f.TipoObraSocialId))
            .ToList();
    }

    private bool EsFacturaActualYaGuardada()
    {
        if (indiceDetalleEnEdicion.HasValue) return false;
        if (pacienteId <= 0 && tipoModalidadId <= 2) return false;

        return detallesCargados.Any(d =>
            d.PacienteId == pacienteId &&
            d.TipoPrestacionId == tipoPrestacionId &&
            d.TipoModalidadId == tipoModalidadId &&
            d.TipoObraSocialId == (tipoObraSocialId > 0 ? tipoObraSocialId : (int?)null));
    }

    private void CargarProximaFactura()
    {
        var pendientes = FacturasPendientesSinCargar();
        if (pendientes.Count == 0)
        {
            MostrarAlerta("No hay más facturas agrupadas pendientes en la agenda para este profesional.", false);
            return;
        }

        var prox = pendientes.First();
        CargarFacturaDesdeGrupo(prox);
    }

    private void CargarFacturaDesdeGrupo(FacturaAgrupadaAgendaDTO fac)
    {
        tipoModalidadId = fac.TipoModalidadId;
        pacienteId = fac.PacienteId;
        tipoPrestacionId = fac.TipoPrestacionId;
        tipoObraSocialId = fac.TipoObraSocialId ?? 0;
        montoUnitario = fac.MontoSesion;
        cantidad = fac.CantidadTurnos;
        porcentajeRetencion = fac.PorcentajeRetencion;
        turnosIdsDetalleActual = new List<int>(fac.TurnosIds);

        RecalcularMonto();
        mostrarMenuFacturasPendientes = false;
        seccionCargarFacturaAbierta = true;
        MostrarAlerta($"Factura de {fac.PacienteNombre} ({fac.CantidadTurnos} turnos) precargada en el formulario.", false);
    }

    private void CambiarModalidad(int modId)
    {
        tipoModalidadId = modId;
        if (tipoModalidadId >= 3)
        {
            porcentajeRetencion = 100;
        }
        else
        {
            var p = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
            porcentajeRetencion = p != null && p.PorcentajeRetencion > 0 ? p.PorcentajeRetencion : 20;
        }
        RecalcularMonto();
    }

    private void OnPrestacionSeleccionada()
    {
        var p = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
        if (p != null)
        {
            if (p.MontoSesion > 0) montoUnitario = p.MontoSesion;
            porcentajeRetencion = p.PorcentajeRetencion > 0 ? p.PorcentajeRetencion : (tipoModalidadId >= 3 ? 100 : 20);
        }
        RecalcularMonto();
    }

    private void RecalcularMonto()
    {
        if (tipoModalidadId == 3)
        {
            montoFacturacion = (cantidadModCompleto * montoModCompleto) + (cantidadMedioMod * montoMedioMod);
        }
        else
        {
            montoFacturacion = cantidad * montoUnitario;
        }
        RecalcularRetencion();
    }

    private void RecalcularRetencion()
    {
        montoRetencion = Math.Round(montoFacturacion * (porcentajeRetencion / 100m), 2);
        cobroProfesional = montoFacturacion - montoRetencion;
        montoAbonado = 0;
        saldoPendiente = montoRetencion;
    }

    private void RecalcularSaldo()
    {
        if (montoAbonado > montoRetencion) montoAbonado = montoRetencion;
        if (montoAbonado < 0) montoAbonado = 0;
        saldoPendiente = montoRetencion - montoAbonado;
    }

    private void AbonarTodo()
    {
        montoAbonado = montoRetencion;
        saldoPendiente = 0;
    }

    private bool EsValorModificado()
    {
        if (tipoPrestacionId <= 0) return false;
        var p = listaPrestaciones.FirstOrDefault(x => x.Id == tipoPrestacionId);
        if (p == null) return false;

        bool precioDistinto = (p.MontoSesion > 0 && p.MontoSesion != montoUnitario);
        bool retencionDistinta = (p.PorcentajeRetencion > 0 && p.PorcentajeRetencion != porcentajeRetencion);
        return precioDistinto || retencionDistinta;
    }

    private void AgregarOActualizarDetalle()
    {
        if (tipoModalidadId <= 2 && pacienteId <= 0)
        {
            MostrarAlerta("Debe seleccionar un paciente.", true);
            return;
        }

        if (montoFacturacion <= 0)
        {
            MostrarAlerta("El monto de facturación debe ser mayor a cero.", true);
            return;
        }

        if (!indiceDetalleEnEdicion.HasValue && EsFacturaActualYaGuardada())
        {
            MostrarAlerta("Esta factura (mismo paciente, modalidad y prestación) ya está agregada a la liquidación. Edítela si necesita modificarla.", true);
            return;
        }

        var pac = listaPacientes.FirstOrDefault(p => p.Id == pacienteId);
        var prest = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId);
        var os = listaObrasSociales.FirstOrDefault(o => o.Id == tipoObraSocialId);

        string modalidadTexto = tipoModalidadId switch
        {
            2 => "Obra Social",
            3 => "Módulos",
            4 => "Por Hora",
            5 => "Taller",
            _ => "Particular"
        };

        EnumEstadoPagoLiquidacion est = saldoPendiente <= 0 ? EnumEstadoPagoLiquidacion.Pagado
            : (montoAbonado > 0 ? EnumEstadoPagoLiquidacion.Parcial : EnumEstadoPagoLiquidacion.Pendiente);

        var nuevo = new GuardarDetalleLiquidacionDTO
        {
            TipoModalidadId = tipoModalidadId,
            TipoModalidadNombre = modalidadTexto,
            PacienteId = pacienteId > 0 ? pacienteId : null,
            PacienteNombreCompleto = pac?.Nombre ?? (tipoModalidadId >= 3 ? "Uso Institucional / Alquiler" : ""),
            TipoPrestacionId = tipoPrestacionId > 0 ? tipoPrestacionId : null,
            TipoPrestacionNombre = prest?.Tipo ?? modalidadTexto,
            TipoObraSocialId = tipoObraSocialId > 0 ? tipoObraSocialId : null,
            TipoObraSocialNombre = os?.Tipo ?? "",
            MontoUnitario = montoUnitario,
            Cantidad = tipoModalidadId == 3 ? (cantidadModCompleto + cantidadMedioMod) : cantidad,
            MontoModuloCompleto = cantidadModCompleto > 0 ? montoModCompleto : null,
            CantidadModuloCompleto = cantidadModCompleto > 0 ? cantidadModCompleto : null,
            MontoMedioModulo = cantidadMedioMod > 0 ? montoMedioMod : null,
            CantidadMedioModulo = cantidadMedioMod > 0 ? cantidadMedioMod : null,
            MontoFacturacion = montoFacturacion,
            Porcentaje = porcentajeRetencion,
            Retencion = montoRetencion,
            Saldo = saldoPendiente,
            EstadoPago = est,
            TurnosIds = new List<int>(turnosIdsDetalleActual)
        };

        if (indiceDetalleEnEdicion.HasValue)
        {
            detallesCargados[indiceDetalleEnEdicion.Value] = nuevo;
            indiceDetalleEnEdicion = null;
            MostrarAlerta("Factura actualizada correctamente.", false);
        }
        else
        {
            detallesCargados.Add(nuevo);
            MostrarAlerta("Factura agregada a la liquidación con éxito.", false);
        }

        turnosIdsDetalleActual.Clear();
        montoAbonado = 0;
        saldoPendiente = 0;
        MarcarCambios();
    }

    private void EditarDetalle(int index)
    {
        if (index < 0 || index >= detallesCargados.Count) return;
        indiceDetalleEnEdicion = index;
        seccionCargarFacturaAbierta = true;

        var d = detallesCargados[index];
        tipoModalidadId = d.TipoModalidadId;
        pacienteId = d.PacienteId ?? 0;
        tipoPrestacionId = d.TipoPrestacionId ?? 0;
        tipoObraSocialId = d.TipoObraSocialId ?? 0;
        montoUnitario = d.MontoUnitario;
        cantidad = d.Cantidad;
        montoModCompleto = d.MontoModuloCompleto ?? 50000;
        cantidadModCompleto = d.CantidadModuloCompleto ?? 0;
        montoMedioMod = d.MontoMedioModulo ?? 30000;
        cantidadMedioMod = d.CantidadMedioModulo ?? 0;
        montoFacturacion = d.MontoFacturacion;
        porcentajeRetencion = d.Porcentaje;
        montoRetencion = d.Retencion;
        cobroProfesional = montoFacturacion - montoRetencion;
        montoAbonado = d.Retencion - d.Saldo;
        saldoPendiente = d.Saldo;
        turnosIdsDetalleActual = new List<int>(d.TurnosIds);
    }

    private void CancelarEdicionDetalle()
    {
        indiceDetalleEnEdicion = null;
        montoAbonado = 0;
        saldoPendiente = 0;
    }

    private void EliminarDetalle(int index)
    {
        if (index < 0 || index >= detallesCargados.Count) return;
        detallesCargados.RemoveAt(index);
        MostrarAlerta("Factura eliminada de la liquidación.", false);
        MarcarCambios();
    }

    private async Task AbrirModalSesiones(GuardarDetalleLiquidacionDTO detalle)
    {
        detalleParaSesiones = detalle;
        turnosSesionModal.Clear();

        if (detalle.Id > 0)
        {
            var res = await Http.Get<List<TurnoLiquidacionItemDTO>>($"api/liquidacion/detalle/{detalle.Id}/turnos");
            if (!res.Error && res.Respuesta != null)
            {
                turnosSesionModal = res.Respuesta;
            }
        }
        else if (detalle.TurnosIds != null && detalle.TurnosIds.Count > 0)
        {
            int nro = 1;
            foreach (var tId in detalle.TurnosIds)
            {
                turnosSesionModal.Add(new TurnoLiquidacionItemDTO
                {
                    TurnoId = tId,
                    NumeroSesion = nro++,
                    Fecha = fechaDesde,
                    HoraInicio = new TimeOnly(9, 0),
                    HoraFin = new TimeOnly(10, 0),
                    ConsultorioNombre = "Consultorio Asignado",
                    TipoTurnoNombre = detalle.TipoPrestacionNombre ?? "Sesión",
                    EstadoTurno = EnumEstadoTurno.atendido
                });
            }
        }

        mostrarModalSesiones = true;
    }

    private void VerSesionesAgendaDesdeFormulario()
    {
        if (turnosIdsDetalleActual.Count == 0)
        {
            MostrarAlerta("Esta factura manual aún no tiene sesiones de agenda vinculadas.", false);
            return;
        }

        detalleParaSesiones = new GuardarDetalleLiquidacionDTO
        {
            PacienteNombreCompleto = listaPacientes.FirstOrDefault(p => p.Id == pacienteId)?.Nombre ?? "Paciente seleccionado",
            TurnosIds = new List<int>(turnosIdsDetalleActual)
        };

        int nro = 1;
        turnosSesionModal = turnosIdsDetalleActual.Select(id => new TurnoLiquidacionItemDTO
        {
            TurnoId = id,
            NumeroSesion = nro++,
            Fecha = fechaDesde,
            HoraInicio = new TimeOnly(9, 0),
            HoraFin = new TimeOnly(10, 0),
            ConsultorioNombre = "Consultorio Asignado",
            TipoTurnoNombre = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId)?.Tipo ?? "Sesión",
            EstadoTurno = EnumEstadoTurno.atendido
        }).ToList();

        mostrarModalSesiones = true;
    }

    private async Task GuardarLiquidacionFinal()
    {
        if (profesionalId <= 0)
        {
            MostrarAlerta("Debe seleccionar un profesional para la liquidación.", true);
            return;
        }

        if (socioId <= 0)
        {
            MostrarAlerta("Debe asignar un socio responsable.", true);
            return;
        }

        if (detallesCargados.Count == 0)
        {
            MostrarAlerta("Debe cargar al menos una factura en la liquidación antes de guardar.", true);
            return;
        }

        guardando = true;
        try
        {
            decimal totalSaldo = detallesCargados.Sum(d => d.Saldo);
            decimal totalRet = detallesCargados.Sum(d => d.Retencion);
            EnumEstadoPagoLiquidacion estadoPagoGeneralCalculado = totalSaldo <= 0 ? EnumEstadoPagoLiquidacion.Pagado
                : (totalSaldo < totalRet ? EnumEstadoPagoLiquidacion.Parcial : EnumEstadoPagoLiquidacion.Pendiente);

            var dto = new GuardarLiquidacionDTO
            {
                Id = Id ?? 0,
                NumeroLiquidacion = numeroLiquidacion,
                FechaDesde = fechaDesde,
                FechaHasta = fechaHasta,
                ProfesionalId = profesionalId,
                SocioId = socioId,
                EstadoPago = estadoPagoGeneralCalculado,
                Observaciones = $"Liquidación generada con {detallesCargados.Count} conceptos.",
                Detalles = detallesCargados
            };

            var res = await Http.Post<GuardarLiquidacionDTO, int>("api/liquidacion", dto);
            if (!res.Error)
            {
                hayCambiosSinGuardar = false;
                Navigation.NavigateTo("/liquidaciones");
            }
            else
            {
                MostrarAlerta("Error al guardar en el servidor: " + res.ObtenerError(), true);
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("Error inesperado al guardar: " + ex.Message, true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void ManejarClickVolverAtras()
    {
        if (hayCambiosSinGuardar)
        {
            mostrarModalSalir = true;
        }
        else
        {
            Navigation.NavigateTo("/liquidaciones");
        }
    }

    private void DescartarYSalir()
    {
        mostrarModalSalir = false;
        hayCambiosSinGuardar = false;
        Navigation.NavigateTo("/liquidaciones");
    }

    private async Task GuardarYSalir()
    {
        mostrarModalSalir = false;
        await GuardarLiquidacionFinal();
    }

    private void MarcarCambios() => hayCambiosSinGuardar = true;

    private void MostrarAlerta(string msg, bool error)
    {
        mensajeAlerta = msg;
        esErrorAlerta = error;
    }
}