    private async Task ToggleExpandirDetalle(int index)
    {
        if (detallesExpandidos.Contains(index))
        {
            detallesExpandidos.Remove(index);
            return;
        }

        detallesExpandidos.Add(index);
        if (index < 0 || index >= detallesCargados.Count) return;

        var d = detallesCargados[index];
        if (d.TurnosAsociados != null && d.TurnosAsociados.Count > 0)
            return;

        if (d.Id > 0 || (d.TurnosIds != null && d.TurnosIds.Count > 0))
        {
            cargandoTurnosInline.Add(index);
            StateHasChanged();
            try
            {
                if (d.Id > 0)
                {
                    var res = await Http.Get<List<TurnoLiquidacionItemDTO>>($"api/liquidacion/detalle/{d.Id}/turnos");
                    if (!res.Error && res.Respuesta != null)
                        d.TurnosAsociados = res.Respuesta;
                }
                else if (d.TurnosIds != null && d.TurnosIds.Count > 0)
                {
                    string q = $"api/liquidacion/turnos-por-ids?profesionalId={profesionalId}" + (d.PacienteId.HasValue ? $"&pacienteId={d.PacienteId.Value}" : "");
                    var res = await Http.Post<List<int>, List<TurnoLiquidacionItemDTO>>(q, d.TurnosIds);
                    if (!res.Error && res.Respuesta != null)
                        d.TurnosAsociados = res.Respuesta;
                }
            }
            finally
            {
                cargandoTurnosInline.Remove(index);
            }
        }
    }

