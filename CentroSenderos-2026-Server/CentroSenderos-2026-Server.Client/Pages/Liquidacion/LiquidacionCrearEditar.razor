    private static string FormatearConsultorioCorto(string? consultorioNombre)
    {
        if (string.IsNullOrWhiteSpace(consultorioNombre)) return "S/C";
        var trimmed = consultorioNombre.Trim();
        var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && int.TryParse(parts[^1], out _))
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{parts[^1]}";
        }
        return trimmed.Length > 6 ? trimmed[..6] : trimmed;
    }

