@page "/liquidaciones/crear"
@page "/liquidaciones/editar/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@using CentroSenderos_2026_Shared.Enum
@using CentroSenderos_2026_Servicio.ServiciosHttp
@inject IHttpServicio Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="liq-create-container">
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-custom"></div>
            <p class="mt-2 text-muted">Cargando datos de la liquidación...</p>
        </div>
    }
    else
    {
        <!-- Top Bar con Flecha Atrás y Estado -->
        <div class="top-nav-bar">
            <button type="button" class="btn-back-arrow" title="Volver al listado" @onclick="ManejarClickVolverAtras">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:20px;height:20px;min-width:20px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            </button>
            <div>
                <h1 class="page-main-title">@(Id.HasValue ? "Editar Liquidación" : "Nueva Liquidación")</h1>
                <span class="periodo-badge">Período: @fechaDesde.ToString("dd/MM/yyyy") - @fechaHasta.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="autosave-pill ms-auto">
                <svg width="14" height="14" class="text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;min-width:14px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Estado: @(hayCambiosSinGuardar ? "Cambios pendientes" : "Al día")</span>
            </div>
        </div>

        <!-- Banner de Notificación / Error -->
        @if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            <div class="alert-banner @(esErrorAlerta ? "alert-danger" : "alert-success")">
                <span>@mensajeAlerta</span>
                <button type="button" class="btn-close-alert" @onclick="() => mensajeAlerta = null">✕</button>
            </div>
        }

        <!-- 1. DATOS GENERALES DE LA LIQUIDACIÓN -->
        <div class="section-card">
            <div class="section-header">
                <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;min-width:18px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <h2 class="section-title">DATOS DE LA LIQUIDACIÓN</h2>
            </div>
            <div class="row-fields">
                <div class="field-col">
                    <label class="form-label-custom">PROFESIONAL</label>
                    <select class="custom-input" @bind="profesionalId" @bind:after="AlCambiarProfesionalOFechas">
                        <option value="0">Seleccionar Profesional...</option>
                        @foreach (var p in listaProfesionales)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </div>

                <div class="field-col">
                    <label class="form-label-custom">FECHA DESDE</label>
                    <input type="date" class="custom-input" @bind="fechaDesde" @bind:after="AlCambiarProfesionalOFechas" />
                </div>

                <div class="field-col">
                    <label class="form-label-custom">FECHA HASTA</label>
                    <input type="date" class="custom-input" @bind="fechaHasta" @bind:after="AlCambiarProfesionalOFechas" />
                </div>

                <div class="field-col">
                    <label class="form-label-custom">SOCIO RESPONSABLE</label>
                    <select class="custom-input" @bind="socioId" @bind:after="MarcarCambios">
                        <option value="0">Seleccionar Socio...</option>
                        @foreach (var s in listaSocios)
                        {
                            <option value="@s.Id">@s.Profesional</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- 2. SECCIÓN: CARGAR FACTURA -->
        <div class="accordion-box">
            <div class="accordion-header-toggle">
                <div class="toggle-click-area" @onclick="() => seccionCargarFacturaAbierta = !seccionCargarFacturaAbierta">
                    <svg width="18" height="18" class="icon-toggle @(seccionCargarFacturaAbierta ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;min-width:18px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    <span class="accordion-title">@(indiceDetalleEnEdicion.HasValue ? "EDITANDO FACTURA" : "CARGAR FACTURA")</span>
                    @if (indiceDetalleEnEdicion.HasValue)
                    {
                        <span class="badge-modo-edicion">Modo Edición</span>
                    }
                </div>

                <!-- Botonera superior de acciones de agenda -->
                <div class="header-actions-area">
                    <!-- Badge: Factura ya guardada si está en la lista -->
                    @if (EsFacturaActualYaGuardada())
                    {
                        <span class="badge-ya-guardada">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:12px;height:12px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Factura ya guardada</span>
                        </span>
                    }

                    <!-- Botón Desplegable: Facturas por liquidar (X) -->
                    <div class="position-relative">
                        <button type="button"
                                class="btn-facturas-pendientes @(FacturasPendientesSinCargar().Count > 0 ? "btn-has-pending" : "btn-empty-pending")"
                                @onclick="() => mostrarMenuFacturasPendientes = !mostrarMenuFacturasPendientes"
                                title="Ver facturas agrupadas pendientes en la agenda">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>Facturas por liquidar (@FacturasPendientesSinCargar().Count)</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>

                        <!-- Popup emergente de Facturas por Liquidar -->
                        @if (mostrarMenuFacturasPendientes)
                        {
                            <div class="dropdown-pending-invoices">
                                <div class="dropdown-pending-header">
                                    <div>
                                        <strong style="display:block; font-size:12px;">Facturas por liquidar (@FacturasPendientesSinCargar().Count)</strong>
                                        <span style="color:#64748b; font-size:11px;">Turnos agrupados según agenda</span>
                                    </div>
                                    <button type="button" class="btn-close-sm" @onclick="() => mostrarMenuFacturasPendientes = false">✕</button>
                                </div>
                                <div class="dropdown-pending-body">
                                    @if (FacturasPendientesSinCargar().Count == 0)
                                    {
                                        <p style="text-align:center; color:#94a3b8; padding:1rem; font-size:12px;">Todos los turnos de este profesional en el período ya fueron cargados.</p>
                                    }
                                    else
                                    {
                                        @foreach (var fac in FacturasPendientesSinCargar())
                                        {
                                            <div class="pending-group-item" @onclick="() => CargarFacturaDesdeGrupo(fac)">
                                                <div>
                                                    <div style="font-weight:700; color:#0f172a;">@fac.PacienteNombre</div>
                                                    <div style="font-size:11px; color:#64748b;">
                                                        @fac.ModalidadNombre @(!string.IsNullOrEmpty(fac.ObraSocialNombre) ? $"({fac.ObraSocialNombre})" : "") • @fac.PrestacionNombre • <strong>@fac.CantidadTurnos turnos</strong>
                                                    </div>
                                                </div>
                                                <span class="badge-cargar-mini">Cargar ⚡</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botón: Cargar Próxima Factura -->
                    <button type="button" class="btn-proxima-factura" @onclick="CargarProximaFactura" title="Carga automáticamente la primera factura agrupada pendiente">
                        <svg width="14" height="14" style="width:14px;height:14px;color:#d97706;" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        <span>Cargar Próxima Factura</span>
                    </button>

                    <!-- Botón: Listado de Sesiones en Agenda -->
                    <button type="button" class="btn-ver-sesiones-header" @onclick="VerSesionesAgendaDesdeFormulario" title="Auditar las sesiones de la factura seleccionada">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>Listado de Sesiones</span>
                    </button>
                </div>
            </div>

            @if (seccionCargarFacturaAbierta)
            {
                <div class="accordion-content">
                    <!-- Selector de Modalidad -->
                    <div style="margin-bottom: 1rem;">
                        <label class="form-label-custom">MODALIDAD</label>
                        <div class="modalidad-pill-group">
                            <button type="button" class="btn-pill @(tipoModalidadId == 1 ? "active" : "")" @onclick="() => CambiarModalidad(1)">Particular</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 2 ? "active" : "")" @onclick="() => CambiarModalidad(2)">Obra Social</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 3 ? "active" : "")" @onclick="() => CambiarModalidad(3)">Módulos</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 4 ? "active" : "")" @onclick="() => CambiarModalidad(4)">Por Hora</button>
                            <button type="button" class="btn-pill @(tipoModalidadId == 5 ? "active" : "")" @onclick="() => CambiarModalidad(5)">Taller</button>
                        </div>
                    </div>

                    <!-- Campos dinámicos según modalidad -->
                    <div class="row-fields" style="margin-bottom: 1rem;">
                        @if (tipoModalidadId == 1 || tipoModalidadId == 2)
                        {
                            <!-- PARTICULAR / OBRA SOCIAL -->
                            <div class="field-col" style="flex: 2 1 200px;">
                                <label class="form-label-custom">PACIENTE</label>
                                <select class="custom-input" @bind="pacienteId">
                                    <option value="0">Seleccionar Paciente...</option>
                                    @foreach (var pac in listaPacientes)
                                    {
                                        <option value="@pac.Id">@pac.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="field-col" style="flex: 2 1 200px;">
                                <label class="form-label-custom">PRESTACIÓN</label>
                                <select class="custom-input" @bind="tipoPrestacionId" @bind:after="OnPrestacionSeleccionada">
                                    <option value="0">Seleccionar Prestación...</option>
                                    @foreach (var pr in listaPrestaciones)
                                    {
                                        <option value="@pr.Id">@pr.Tipo (@pr.PorcentajeRetencion.ToString("0.##")%)</option>
                                    }
                                </select>
                            </div>
                            @if (tipoModalidadId == 2)
                            {
                                <div class="field-col" style="flex: 2 1 200px;">
                                    <label class="form-label-custom">OBRA SOCIAL</label>
                                    <select class="custom-input" @bind="tipoObraSocialId">
                                        <option value="0">Seleccionar Obra Social...</option>
                                        @foreach (var os in listaObrasSociales)
                                        {
                                            <option value="@os.Id">@os.Tipo</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="field-col" style="flex: 1 1 120px;">
                                <label class="form-label-custom">VALOR SESIÓN ($)</label>
                                <input type="number" step="0.01" class="custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col" style="flex: 1 1 100px;">
                                <label class="form-label-custom">CANTIDAD SESIONES</label>
                                <input type="number" min="1" class="custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 3)
                        {
                            <!-- MÓDULOS -->
                            <div class="field-col">
                                <label class="form-label-custom">CANT. MÓDULOS COMPLETOS</label>
                                <input type="number" min="0" class="custom-input" @bind="cantidadModCompleto" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR MÓDULO COMPLETO ($)</label>
                                <input type="number" step="0.01" class="custom-input" @bind="montoModCompleto" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">CANT. MEDIOS MÓDULOS</label>
                                <input type="number" min="0" class="custom-input" @bind="cantidadMedioMod" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR MEDIO MÓDULO ($)</label>
                                <input type="number" step="0.01" class="custom-input" @bind="montoMedioMod" @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 4)
                        {
                            <!-- POR HORA -->
                            <div class="field-col">
                                <label class="form-label-custom">CANTIDAD DE HORAS</label>
                                <input type="number" min="1" class="custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">VALOR POR HORA ($)</label>
                                <input type="number" step="0.01" class="custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                            </div>
                        }
                        else if (tipoModalidadId == 5)
                        {
                            <!-- TALLER -->
                            <div class="field-col">
                                <label class="form-label-custom">TALLER</label>
                                <select class="custom-input" @bind="tipoPrestacionId" @bind:after="OnPrestacionSeleccionada">
                                    <option value="0">Seleccionar Taller...</option>
                                    @foreach (var pr in listaPrestaciones)
                                    {
                                        <option value="@pr.Id">@pr.Tipo</option>
                                    }
                                </select>
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">CANTIDAD</label>
                                <input type="number" min="1" class="custom-input" @bind="cantidad" @bind:after="RecalcularMonto" />
                            </div>
                            <div class="field-col">
                                <label class="form-label-custom">PRECIO POR TALLER ($)</label>
                                <input type="number" step="0.01" class="custom-input" @bind="montoUnitario" @bind:after="RecalcularMonto" />
                            </div>
                        }
                    </div>

                    <!-- ADVERTENCIA SI SE MODIFICARON VALORES PREESTABLECIDOS -->
                    @if (EsValorModificado())
                    {
                        var pr = listaPrestaciones.FirstOrDefault(p => p.Id == tipoPrestacionId);
                        <div class="warning-alert-pill">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;min-width:16px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            <span><strong>Valores modificados manualmente:</strong> Los valores actuales ($@montoUnitario.ToString("N0") / @porcentajeRetencion%) difieren de la prestación configurada (@pr?.Tipo: $@(pr?.MontoSesion.ToString("N0")) / @(pr?.PorcentajeRetencion)% retención).</span>
                        </div>
                    }

                    <!-- Bloque Financiero y de Retención (Perspectiva Centro Senderos) -->
                    <div class="finance-strip">
                        <div class="finance-item">
                            <label>MONTO FACTURACIÓN</label>
                            <span class="fs-num font-bold text-dark">$@montoFacturacion.ToString("N2")</span>
                        </div>
                        <div class="finance-item">
                            <label>% RETENCIÓN CENTRO</label>
                            <input type="number" min="0" max="100" step="0.5" class="custom-input-sm font-bold text-centro" @bind="porcentajeRetencion" @bind:after="RecalcularRetencion" />
                        </div>
                        <div class="finance-item">
                            <label>RETENCIÓN CENTRO ($)</label>
                            <span class="fs-num font-bold text-success">+$@montoRetencion.ToString("N2")</span>
                        </div>
                        <div class="finance-item">
                            <label>COBRO PROFESIONAL ($)</label>
                            <span class="fs-num font-bold text-primary">$@cobroProfesional.ToString("N2")</span>
                        </div>
                        <div class="finance-item">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <label>ABONA ($)</label>
                                <button type="button" class="btn-pagar-todo" @onclick="AbonarTodo">Abonar todo</button>
                            </div>
                            <input type="number" step="0.01" min="0" max="@montoRetencion" class="custom-input-sm" @bind="montoAbonado" @bind:after="RecalcularSaldo" />
                        </div>
                        <div class="finance-item">
                            <label>SALDO PENDIENTE CENTRO</label>
                            <span class="fs-num font-bold @(saldoPendiente > 0 ? "text-danger" : "text-muted")">$@saldoPendiente.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Botones de Acción de la Factura -->
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-top:1rem;">
                        <button type="button" class="btn-agregar-detalle" @onclick="AgregarOActualizarDetalle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>@(indiceDetalleEnEdicion.HasValue ? "Guardar Cambios de la Factura" : "Agregar Factura a la Liquidación")</span>
                        </button>
                        @if (indiceDetalleEnEdicion.HasValue)
                        {
                            <button type="button" class="btn-cancelar-detalle" @onclick="CancelarEdicionDetalle">Cancelar</button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 3. DETALLES DE LA LIQUIDACIÓN CON AGRUPACIÓN JERÁRQUICA: MODALIDAD -> OBRA SOCIAL -> PRESTACIÓN -->
        <div class="section-card" style="margin-top: 1.5rem;">
            <div class="section-header" style="justify-content: space-between;">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <h2 class="section-title">DETALLES DE LA LIQUIDACIÓN (@detallesCargados.Count conceptos)</h2>
                </div>
                <span style="font-size:11px; color:#64748b; font-weight:600;">Jerarquía: 1° Modalidad • 2° Obra Social • 3° Prestación</span>
            </div>

            @if (detallesCargados.Count == 0)
            {
                <div class="empty-detalles-box">
                    <p style="margin:0 0 0.25rem 0; font-weight:600; color:#475569;">No hay facturas agregadas a esta liquidación todavía.</p>
                    <span style="font-size:12px; color:#94a3b8;">Utiliza el botón &quot;Cargar Próxima Factura&quot; o completa el formulario superior para añadir prestaciones.</span>
                </div>
            }
            else
            {
                <div class="detalles-hierarchical-container">
                    @foreach (var grupoMod in detallesCargados.GroupBy(d => d.TipoModalidadNombre))
                    {
                        var modNombre = grupoMod.Key;
                        var subFactMod = grupoMod.Sum(x => x.MontoFacturacion);
                        var subRetMod = grupoMod.Sum(x => x.Retencion);
                        var subCobroProfMod = subFactMod - subRetMod;
                        var subSaldoMod = grupoMod.Sum(x => x.Saldo);
                        var subAbonadoMod = subRetMod - subSaldoMod;

                        <div class="group-level-1-modalidad">
                            <!-- ENCABEZADO NIVEL 1: MODALIDAD -->
                            <div class="group-header-modalidad">
                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <span class="badge-modalidad-pill">@modNombre</span>
                                    <span style="font-size:12px; color:#64748b;">(@grupoMod.Count() registros)</span>
                                </div>
                                <div class="group-totals-chips">
                                    <span>Facturado: <strong>$@subFactMod.ToString("N0")</strong></span>
                                    <span>Retención Centro: <strong class="text-success">+$@subRetMod.ToString("N0")</strong></span>
                                    <span>Cobro Prof.: <strong class="text-primary">$@subCobroProfMod.ToString("N0")</strong></span>
                                    <span>Abonado: <strong>$@subAbonadoMod.ToString("N0")</strong></span>
                                    <span>Saldo: <strong class="@(subSaldoMod > 0 ? "text-danger" : "text-muted")">$@subSaldoMod.ToString("N0")</strong></span>
                                </div>
                            </div>

                            <!-- NIVEL 2: OBRA SOCIAL -->
                            @foreach (var grupoOS in grupoMod.GroupBy(d => !string.IsNullOrEmpty(d.TipoObraSocialNombre) ? d.TipoObraSocialNombre : (modNombre == "Obra Social" ? "Sin Obra Social Asignada" : "Atención Directa / Consultorio")))
                            {
                                var osNombre = grupoOS.Key;
                                var subFactOS = grupoOS.Sum(x => x.MontoFacturacion);
                                var subRetOS = grupoOS.Sum(x => x.Retencion);
                                var subCobroOS = subFactOS - subRetOS;
                                var subSaldoOS = grupoOS.Sum(x => x.Saldo);
                                var subAbonadoOS = subRetOS - subSaldoOS;

                                <div class="group-level-2-obrasocial">
                                    <div class="group-header-obrasocial">
                                        <div style="display:flex; align-items:center; gap:0.5rem;">
                                            <svg width="14" height="14" style="color:#64748b; width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"></path></svg>
                                            <span style="font-weight:700; font-size:13px; color:#1e293b;">@osNombre</span>
                                        </div>
                                        <div class="group-totals-chips-sm">
                                            <span>Subtotal: $@subFactOS.ToString("N0")</span>
                                            <span>Ret. Centro: +$@subRetOS.ToString("N0")</span>
                                            <span>Cobro: $@subCobroOS.ToString("N0")</span>
                                            <span>Saldo: $@subSaldoOS.ToString("N0")</span>
                                        </div>
                                    </div>

                                    <!-- NIVEL 3: PRESTACIÓN -->
                                    @foreach (var grupoPrest in grupoOS.GroupBy(d => d.TipoPrestacionNombre))
                                    {
                                        var prestNombre = grupoPrest.Key;

                                        <div class="group-level-3-prestacion">
                                            <div class="group-header-prestacion">
                                                <span class="prestacion-title-tag">@prestNombre</span>
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table-detalles">
                                                    <thead>
                                                        <tr>
                                                            <th>Paciente / Detalle</th>
                                                            <th>Sesiones</th>
                                                            <th class="text-end">Facturado</th>
                                                            <th class="text-end">Ret. Centro</th>
                                                            <th class="text-end">Cobro Prof.</th>
                                                            <th class="text-end">Abonado</th>
                                                            <th class="text-end">Saldo Centro</th>
                                                            <th class="text-center">Estado</th>
                                                            <th class="text-center">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var d in grupoPrest)
                                                        {
                                                            var index = detallesCargados.IndexOf(d);
                                                            var cobroFila = d.MontoFacturacion - d.Retencion;
                                                            var abonadoFila = d.Retencion - d.Saldo;

                                                            <tr>
                                                                <td style="font-weight:700; color:#0f172a;">@(!string.IsNullOrEmpty(d.PacienteNombreCompleto) ? d.PacienteNombreCompleto : "Sin paciente")</td>
                                                                <td>@d.Cantidad ses.</td>
                                                                <td class="text-end font-bold text-dark">$@d.MontoFacturacion.ToString("N2")</td>
                                                                <td class="text-end font-bold text-success">+$@d.Retencion.ToString("N2")</td>
                                                                <td class="text-end font-bold text-primary">$@cobroFila.ToString("N2")</td>
                                                                <td class="text-end font-bold text-dark">$@abonadoFila.ToString("N2")</td>
                                                                <td class="text-end font-bold @(d.Saldo > 0 ? "text-danger" : "text-muted")">$@d.Saldo.ToString("N2")</td>
                                                                <td class="text-center">
                                                                    @switch (d.EstadoPago)
                                                                    {
                                                                        case EnumEstadoPagoLiquidacion.Pagado:
                                                                            <span class="badge-mini-pagado">PAGADO</span>
                                                                            break;
                                                                        case EnumEstadoPagoLiquidacion.Parcial:
                                                                            <span class="badge-mini-parcial">PARCIAL</span>
                                                                            break;
                                                                        default:
                                                                            <span class="badge-mini-pendiente">PENDIENTE</span>
                                                                            break;
                                                                    }
                                                                </td>
                                                                <td class="text-center">
                                                                    <div style="display:flex; align-items:center; justify-content:center; gap:4px;">
                                                                        <button type="button" class="btn-icon-table" title="Ver sesiones de la agenda" @onclick="() => AbrirModalSesiones(d)">
                                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                                        </button>
                                                                        <button type="button" class="btn-icon-table text-primary" title="Editar factura" @onclick="() => EditarDetalle(index)">
                                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                                                        </button>
                                                                        <button type="button" class="btn-icon-table text-danger" title="Eliminar factura" @onclick="() => EliminarDetalle(index)">
                                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 4. TOTALES DE LA LIQUIDACIÓN Y BOTÓN GUARDAR -->
        <div class="totals-summary-card">
            <div class="totals-inner-row">
                <div class="totals-grid-metrics">
                    <div class="metric-box">
                        <span class="summary-label">FACTURADO PROF.</span>
                        <div class="summary-val text-dark">$@detallesCargados.Sum(d => d.MontoFacturacion).ToString("N2")</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">RETENCIÓN CENTRO</span>
                        <div class="summary-val text-success">+$@detallesCargados.Sum(d => d.Retencion).ToString("N2")</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">COBRO PROFESIONAL</span>
                        <div class="summary-val text-primary">$@((detallesCargados.Sum(d => d.MontoFacturacion) - detallesCargados.Sum(d => d.Retencion)).ToString("N2"))</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">TOTAL ABONADO</span>
                        <div class="summary-val text-dark">$@((detallesCargados.Sum(d => d.Retencion) - detallesCargados.Sum(d => d.Saldo)).ToString("N2"))</div>
                    </div>
                    <div class="metric-box">
                        <span class="summary-label">SALDO PENDIENTE CENTRO</span>
                        <div class="summary-val text-danger">$@detallesCargados.Sum(d => d.Saldo).ToString("N2")</div>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn-guardar-principal" disabled="@guardando" @onclick="GuardarLiquidacionFinal">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;min-width:18px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@(guardando ? "Guardando..." : "GUARDAR LIQUIDACIÓN")</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL: DETALLE DE SESIONES DE LA FACTURA -->
@if (mostrarModalSesiones && detalleParaSesiones != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom modal-lg">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="18" height="18" class="text-primary-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <h3>Sesiones de la Agenda - @detalleParaSesiones.PacienteNombreCompleto</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalSesiones = false">✕</button>
            </div>
            <div class="modal-body-custom">
                @if (turnosSesionModal.Count == 0)
                {
                    <p style="text-align:center; color:#94a3b8; padding:1.5rem;">No hay sesiones asociadas a este registro.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-detalles">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Fecha</th>
                                    <th>Horario</th>
                                    <th>Consultorio</th>
                                    <th>Prestación</th>
                                    <th>Estado Turno</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in turnosSesionModal)
                                {
                                    <tr>
                                        <td>@t.NumeroSesion</td>
                                        <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@t.HoraInicio.ToString(@"hh\:mm") - @t.HoraFin.ToString(@"hh\:mm")</td>
                                        <td>@t.ConsultorioNombre</td>
                                        <td>@t.TipoTurnoNombre</td>
                                        <td><span class="badge-mini-pagado">Atendido</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="() => mostrarModalSesiones = false">Cerrar</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: CONFIRMAR SALIDA SIN GUARDAR -->
@if (mostrarModalSalir)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom">
            <div class="modal-header-custom">
                <div class="modal-title-with-icon">
                    <svg width="20" height="20" class="text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <h3>Cambios sin guardar</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => mostrarModalSalir = false">✕</button>
            </div>
            <div class="modal-body-custom">
                <p>Tiene cambios pendientes en la liquidación. Si sale ahora se perderán las facturas no guardadas.</p>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" @onclick="DescartarYSalir">Descartar y Salir</button>
                <button type="button" class="btn-guardar-principal" @onclick="GuardarYSalir">Guardar Cambios</button>
            </div>
        </div>
    </div>
}

