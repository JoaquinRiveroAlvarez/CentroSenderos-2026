    // ======== MODIFICAR COBRO ========
    private void AbrirModalModificarCobro(PagoLiquidacionHistorialDTO pago)
    {
        pagoAModificar = pago;
        motivoModificacionTexto = "";

        itemsDetallesModificacion = detallesCargados.Where(d => d.Id > 0).Select(d =>
        {
            var impAnterior = pago.Imputaciones.FirstOrDefault(i => i.DetalleLiquidacionId == d.Id);
            decimal montoPrevio = impAnterior?.MontoImputado ?? 0m;
            decimal sesPrevias = impAnterior?.CantidadSesionesCobradas ?? 0m;
            decimal saldoDisponibleReal = d.Saldo + montoPrevio;
            decimal sesionesCobradasOtros = Math.Max(0m, d.SesionesCobradas - sesPrevias);
            decimal sesionesMax = Math.Max(0m, d.Cantidad - sesionesCobradasOtros);

            return new ItemDetalleCobroSeleccion
            {
                DetalleId = d.Id,
                Seleccionado = impAnterior != null,
                PacienteNombre = d.PacienteNombreCompleto ?? "Sin Paciente",
                PrestacionNombre = d.TipoPrestacionNombre ?? "Sesión",
                ModalidadNombre = d.TipoModalidadNombre,
                CantidadSesionesTotal = Math.Max(1, d.Cantidad),
                SesionesYaCobradas = sesionesCobradasOtros,
                SaldoPendiente = saldoDisponibleReal,
                MontoACobrar = impAnterior != null ? montoPrevio : saldoDisponibleReal,
                SesionesACobrar = impAnterior != null ? sesPrevias : sesionesMax
            };
        }).Where(x => x.SaldoPendiente > 0 || x.Seleccionado).ToList();

        metodosPagoModificacion = pago.Metodos.Select(m => new CobroMetodoPagoDTO
        {
            MetodoPago = m.MetodoPago,
            MetodoPagoNombre = m.MetodoPagoNombre,
            Monto = m.Monto,
            CuentaOrigen = m.CuentaOrigen,
            NumeroComprobante = m.NumeroComprobante
        }).ToList();

        if (metodosPagoModificacion.Count == 0)
        {
            metodosPagoModificacion.Add(new CobroMetodoPagoDTO
            {
                MetodoPago = MetodoDePago.Efectivo,
                MetodoPagoNombre = "Efectivo",
                Monto = TotalModificacionSeleccionado
            });
        }

        mostrarModalModificarCobro = true;
    }

    private void AlCambiarSesionesModificacion(ItemDetalleCobroSeleccion item)
