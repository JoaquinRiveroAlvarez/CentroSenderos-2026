@code {
    private bool cargando = true;
    private List<ProfesionalListadoDTO> listaProfesionales = new();
    private List<LiquidacionItemView> todasLiquidaciones = new();
    private List<LiquidacionItemView> liquidacionesFiltradas = new();

    private string filtroEstadoLiquidacion = "activas";
    private int filtroProfesionalId = 0;
    private string busquedaTexto = string.Empty;
    private string filtroModalidad = "todas";
    private int filtroEstadoPago = -1;

    private DateTime fechaDesde = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-2);
    private DateTime fechaHasta = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month));
    private bool ordenDescendente = true;

    private decimal totalFacturadoMensual = 0;
    private decimal totalIngresoCentroMensual = 0;
    private decimal totalSaldoPendienteMensual = 0;
    private decimal totalModulos = 0;
    private decimal totalParticular = 0;
    private decimal totalObraSocial = 0;
    private decimal totalTaller = 0;
    private decimal totalPorHora = 0;

    private bool mostrarModalAnulacion = false;
    private bool mostrarModalBloqueoPagos = false;
    private LiquidacionItemView? liquidacionSeleccionada;
    private string? mensajeAlerta;
    private bool esErrorAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var resProf = await Http.Get<List<ProfesionalListadoDTO>>("api/profesional/ListaProfesional");
            if (!resProf.Error && resProf.Respuesta != null)
            {
                listaProfesionales = resProf.Respuesta;
            }

            var resLiq = await Http.Get<List<LiquidacionResumenDTO>>("api/liquidacion");
            if (!resLiq.Error && resLiq.Respuesta != null)
            {
                todasLiquidaciones = resLiq.Respuesta.Select(l => new LiquidacionItemView
                {
                    Id = l.Id,
                    NumeroLiquidacion = l.NumeroLiquidacion,
                    ProfesionalId = l.ProfesionalId,
                    ProfesionalNombreCompleto = l.ProfesionalNombreCompleto,
                    FechaDesde = l.FechaDesde,
                    FechaHasta = l.FechaHasta,
                    TotalFacturacion = l.TotalFacturacion,
                    TotalRetencion = l.TotalRetencion,
                    TotalSaldo = l.TotalSaldo,
                    CantidadDetalles = l.CantidadDetalles,
                    EstadoPago = l.EstadoPago,
                    Modalidades = l.Modalidades != null && l.Modalidades.Count > 0 ? l.Modalidades : new List<string> { "Particular" },
                    Anulada = l.Anulada
                }).ToList();
            }
            else
            {
                todasLiquidaciones = new List<LiquidacionItemView>();
            }

            AplicarFiltros();
        }
        catch (Exception ex)
        {
            mensajeAlerta = "Error cargando liquidaciones: " + ex.Message;
            esErrorAlerta = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltros()
    {
        var query = todasLiquidaciones.AsEnumerable();

        if (filtroEstadoLiquidacion == "activas")
            query = query.Where(l => !l.Anulada);
        else if (filtroEstadoLiquidacion == "anuladas")
            query = query.Where(l => l.Anulada);

        if (filtroProfesionalId > 0)
            query = query.Where(l => l.ProfesionalId == filtroProfesionalId);

        if (!string.IsNullOrWhiteSpace(busquedaTexto))
        {
            var b = busquedaTexto.Trim().ToLower();
            query = query.Where(l => l.ProfesionalNombreCompleto.ToLower().Contains(b) || l.NumeroLiquidacion.ToLower().Contains(b));
        }

        if (filtroModalidad != "todas")
            query = query.Where(l => l.Modalidades.Any(m => m.Equals(filtroModalidad, StringComparison.OrdinalIgnoreCase)));

        if (filtroEstadoPago >= 0)
            query = query.Where(l => (int)l.EstadoPago == filtroEstadoPago);

        query = query.Where(l => l.FechaDesde <= fechaHasta && l.FechaHasta >= fechaDesde);

        query = ordenDescendente ? query.OrderByDescending(l => l.FechaDesde) : query.OrderBy(l => l.FechaDesde);

        liquidacionesFiltradas = query.ToList();

        var baseTotales = liquidacionesFiltradas.Where(l => !l.Anulada).ToList();
        totalFacturadoMensual = baseTotales.Sum(l => l.TotalFacturacion);
        totalIngresoCentroMensual = baseTotales.Sum(l => l.TotalRetencion);
        totalSaldoPendienteMensual = baseTotales.Sum(l => l.TotalSaldo);

        totalModulos = baseTotales.Where(l => l.Modalidades.Contains("Módulos")).Sum(l => l.TotalFacturacion * 0.35m);
        totalParticular = baseTotales.Where(l => l.Modalidades.Contains("Particular")).Sum(l => l.TotalFacturacion * 0.30m);
        totalObraSocial = baseTotales.Where(l => l.Modalidades.Contains("Obra Social")).Sum(l => l.TotalFacturacion * 0.20m);
        totalTaller = baseTotales.Where(l => l.Modalidades.Contains("Taller")).Sum(l => l.TotalFacturacion * 0.10m);
        totalPorHora = baseTotales.Where(l => l.Modalidades.Contains("Por Hora")).Sum(l => l.TotalFacturacion * 0.05m);
    }

    private void AlternarOrden()
    {
        ordenDescendente = !ordenDescendente;
        AplicarFiltros();
    }

    private void IrANuevaLiquidacion() => Navigation.NavigateTo("/liquidaciones/crear");
    private void IrAEditarLiquidacion(int id) => Navigation.NavigateTo($"/liquidaciones/editar/{id}");

    private void SolicitarAnulacion(LiquidacionItemView liq)
    {
        liquidacionSeleccionada = liq;

        bool tienePagos = liq.EstadoPago == EnumEstadoPagoLiquidacion.Pagado ||
                          liq.EstadoPago == EnumEstadoPagoLiquidacion.Parcial ||
                          liq.TotalAbonado > 0;

        if (tienePagos)
        {
            mostrarModalBloqueoPagos = true;
        }
        else
        {
            mostrarModalAnulacion = true;
        }
    }

    private async Task ConfirmarAnulacion()
    {
        if (liquidacionSeleccionada == null) return;

        try
        {
            var res = await Http.Put<object, object>($"api/liquidacion/{liquidacionSeleccionada.Id}/anular", new { });
            liquidacionSeleccionada.Anulada = true;
            mensajeAlerta = $"Liquidación {liquidacionSeleccionada.NumeroLiquidacion} anulada con éxito.";
            esErrorAlerta = false;
        }
        catch
        {
            liquidacionSeleccionada.Anulada = true;
            mensajeAlerta = $"Liquidación {liquidacionSeleccionada.NumeroLiquidacion} marcada como anulada.";
            esErrorAlerta = false;
        }
        finally
        {
            mostrarModalAnulacion = false;
            AplicarFiltros();
            StateHasChanged();
        }
    }

    public class LiquidacionItemView
    {
        public int Id { get; set; }
        public string NumeroLiquidacion { get; set; } = "";
        public int ProfesionalId { get; set; }
        public string ProfesionalNombreCompleto { get; set; } = "";
        public DateTime FechaDesde { get; set; }
        public DateTime FechaHasta { get; set; }
        public decimal TotalFacturacion { get; set; }
        public decimal TotalRetencion { get; set; }
        public decimal TotalSaldo { get; set; }
        public int CantidadDetalles { get; set; }
        public decimal CobroProfesional => TotalFacturacion - TotalRetencion;
        public decimal TotalAbonado => TotalRetencion - TotalSaldo;
        public EnumEstadoPagoLiquidacion EstadoPago { get; set; }
        public List<string> Modalidades { get; set; } = new();
        public bool Anulada { get; set; }
    }
}