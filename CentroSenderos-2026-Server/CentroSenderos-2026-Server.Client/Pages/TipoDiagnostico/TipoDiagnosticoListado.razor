@page "/tipodiagnostico"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="diagnosticos-page" inert="@(modalActual != ModalDiagnostico.Ninguno)">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">

                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>

            </button>

            <h1>Tipos de Diagnóstico</h1>

            <p>
                Gestioná los diagnósticos y patologías disponibles para los pacientes.
            </p>

        </div>

        <div class="header-actions">

            <button type="button"
                    class="btn-nueva"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nuevo Diagnóstico

            </button>

        </div>

    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar por nombre o descripción" Placeholder="Buscar por nombre o descripción..." />

    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border spinner-border-sm"
                 role="status">
            </div>

            <span>Cargando diagnósticos...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-file-medical"></i>
            </div>

            <h2>No hay tipos de diagnóstico registrados</h2>

            <p>
                Creá un nuevo tipo de diagnóstico para comenzar.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nuevo Diagnóstico

            </button>

        </div>
    }
    else if (lista.Count > 0 && !DiagnosticosFiltrados.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos coincidencias</h2>

            <p>
                No hay diagnósticos que coincidan con
                "@textoBusqueda".
            </p>

        </div>
    }
    else if (lista.Count > 0)
    {
        <div class="list-card">

            <div class="list-header">

                <div>DIAGNÓSTICO</div>
                <div>DESCRIPCIÓN</div>
                <div></div>

            </div>

            <div class="list-body">

                @foreach (var item in DiagnosticosFiltrados)
                {
                    <div class="diagnostico-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="diagnostico-info">

                            <div class="diagnostico-icon">
                                <i class="bi bi-file-medical"></i>
                            </div>

                            <div class="diagnostico-nombre">
                                @MostrarValor(item.Tipo)
                            </div>

                        </div>

                        <div class="diagnostico-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-descripcion">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>

                        <div class="diagnostico-action">
                            
                        </div>

                    </div>
                }

            </div>

            <div class="list-footer">

                <span>
                    Mostrando @DiagnosticosFiltrados.Count()
                    de @lista.Count
                    @(lista.Count == 1 ? "diagnóstico" : "diagnósticos")
                </span>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalDiagnostico.Ninguno)
    {
        <AvisoSenderos Mensaje="@Mensaje" />
    }

</div>

@* Modal de detalle *@

@if (modalActual == ModalDiagnostico.Detalle)
{
    <ModalAdministracion Icono="bi-file-medical" Titulo="Detalle de diagnóstico" CerrarAlTocarFondo="true" Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar" AlCerrar="SolicitarCerrarModal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando diagnóstico...</span>

                </div>
            }
            else
            {
                <div class="administracion-cuerpo">

                <div class="field-group administracion-campo">

                    <label>DIAGNÓSTICO</label>

                    <div class="administracion-valor detail-value">
                        @MostrarValor(modelo.Tipo)
                    </div>

                </div>

                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <div class="administracion-valor detail-value detail-value-large">

                        @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                        {
                            <span class="sin-descripcion">
                                Sin descripción
                            </span>
                        }
                        else
                        {
                            @modelo.Descripcion
                        }

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <AvisoSenderos Mensaje="@Mensaje" />
                }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                    <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                </footer>
            }

    </ModalAdministracion>
}

@* Modal de creación *@

@if (modalActual == ModalDiagnostico.Crear)
{
    <ModalAdministracion Icono="bi-file-medical" Titulo="Nuevo diagnóstico" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCerrarModal">


            <EditForm Model="@modelo"
                      OnValidSubmit="CrearDiagnostico" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="field-group administracion-campo">

                    <label>DIAGNÓSTICO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del diagnóstico" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>

                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <AvisoSenderos Mensaje="@Mensaje" />
                }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrarModal">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando)">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}

@* Modal de edición *@

@if (modalActual == ModalDiagnostico.Editar)
{
    <ModalAdministracion Icono="bi-file-medical" Titulo="Editar diagnóstico" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCancelarEdicion">


            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="field-group administracion-campo">

                    <label>DIAGNÓSTICO</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre del diagnóstico" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>

                <div class="field-group administracion-campo">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <AvisoSenderos Mensaje="@Mensaje" />
                }

                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCancelarEdicion">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando || eliminando)">
                        @(guardando ? "Guardando…" : "Guardar cambios")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}

@* Confirmación de eliminación *@

@if (mostrarConfirmacionEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar este registro?" Ocupado="@eliminando" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>Si confirmás, el registro dejará de estar disponible.</p>
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@eliminando" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@eliminando" @onclick="ConfirmarEliminar">@(eliminando ? "Eliminando…" : "Eliminar")</button>
        </footer>
    </ModalAdministracion>
}

@if (salidaPendiente is not null)
{
    <ConfirmacionDescarte OnContinuar="SeguirEditando"
                          OnDescartar="DescartarCambios" />
}

@code {
    private Func<Task>? salidaPendiente;
    private string? estadoInicial;
    private string CapturarEstadoFormulario() => System.Text.Json.JsonSerializer.Serialize(modelo);

    private void SeguirEditando() => salidaPendiente = null;

    private async Task DescartarCambios()
    {
        var salir = salidaPendiente;
        salidaPendiente = null;
        if (salir is not null)
            await salir();
    }

    private Task SolicitarCancelarEdicion() => SolicitarSalida(CancelarEdicion);

    private Task SolicitarCerrarModal() => SolicitarSalida(() =>
    {
        CerrarModal();
        return Task.CompletedTask;
    });

    private async Task SolicitarSalida(Func<Task> salir)
    {
        if (guardando || eliminando || cargandoDetalle || salidaPendiente is not null)
            return;

        if ((modalActual is ModalDiagnostico.Crear or ModalDiagnostico.Editar) &&
            estadoInicial is not null && estadoInicial != CapturarEstadoFormulario())
        {
            salidaPendiente = salir;
            return;
        }

        await salir();
    }


    private enum ModalDiagnostico
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }

    private List<TipoListadoDTO> lista = new();
    private TipoDTO modelo = CrearModeloVacio();

    private ModalDiagnostico modalActual = ModalDiagnostico.Ninguno;

    private int? idSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private IEnumerable<TipoListadoDTO> DiagnosticosFiltrados =>
        lista.Where(x =>
            string.IsNullOrWhiteSpace(textoBusqueda)
            ||
            FiltrosEntidades.ContieneTexto(x.Tipo, textoBusqueda)
            ||
            FiltrosEntidades.ContieneTexto(x.Descripcion, textoBusqueda)
        );

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;

        var resp = await Http.Get<List<TipoListadoDTO>>(
            "api/tipodiagnostico/ListaTipoDiagnostico"
        );

        lista = resp.Error
            ? new()
            : resp.Respuesta ?? new();

        Mensaje = resp.Error
            ? resp.ObtenerError()
            : string.Empty;

        cargando = false;
    }

    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;
        idSeleccionado = id;
        modelo = CrearModeloVacio();

        modalActual = ModalDiagnostico.Detalle;
        cargandoDetalle = true;

        var resp = await Http.Get<TipoDTO>(
            $"api/tipodiagnostico/{id}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalDiagnostico.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void AbrirCrear()
    {
        Mensaje = string.Empty;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalDiagnostico.Crear;
    }

    private async Task CrearDiagnostico()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        var resp = await Http.Post<TipoDTO, int>(
            "api/tipodiagnostico",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            modalActual = ModalDiagnostico.Ninguno;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirEditar()
    {
        Mensaje = string.Empty;
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalDiagnostico.Editar;
    }

    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;
        cargandoDetalle = true;
        modalActual = ModalDiagnostico.Detalle;

        var resp = await Http.Get<TipoDTO>(
            $"api/tipodiagnostico/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalDiagnostico.Editar;
        }

        cargandoDetalle = false;
    }

    private async Task GuardarCambios()
    {
        if (idSeleccionado is null ||
            guardando ||
            eliminando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        var resp = await Http.Put<TipoDTO, RespuestaDTO>(
            $"api/tipodiagnostico/{idSeleccionado.Value}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            await Cargar();
            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (!guardando && !eliminando)
        {
            mostrarConfirmacionEliminar = true;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null || eliminando)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        var resp = await Http.Delete(
            $"api/tipodiagnostico/{idSeleccionado.Value}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;
            modalActual = ModalDiagnostico.Ninguno;
            idSeleccionado = null;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
        {
            return;
        }

        cargandoDetalle = true;
        modalActual = ModalDiagnostico.Detalle;

        var resp = await Http.Get<TipoDTO>(
            $"api/tipodiagnostico/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalDiagnostico.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void CerrarModal()
    {
        if (guardando || eliminando)
        {
            return;
        }

        modalActual = ModalDiagnostico.Ninguno;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        Mensaje = string.Empty;
    }

    private static TipoDTO CrearModeloVacio()
    {
        return new TipoDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty
        };
    }

    private static string MostrarValor(object? valor)
    {
        if (valor is null)
        {
            return "—";
        }

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}