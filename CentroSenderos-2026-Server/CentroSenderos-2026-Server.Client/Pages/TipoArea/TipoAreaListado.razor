@page "/tipoarea"
@attribute [Authorize]
@using CentroSenderos_2026_Shared.DTO
@using Microsoft.AspNetCore.Authorization
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="areas-page">
    <div class="page-header">
        <div>

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de área</h1>
            <p>Administrá las áreas disponibles para los profesionales.</p>
        </div>

        <button type="button" class="new-button" @onclick="IrACrear">
            <i class="bi bi-plus-lg"></i>
            <span>Nueva área</span>
        </button>
    </div>

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="search"
               aria-label="Buscar tipos de área"
               placeholder="Buscar por nombre o descripción..."
               @bind="busqueda"
               @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrWhiteSpace(MensajeExito))
    {
        <div class="success-message" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>@MensajeExito</span>
        </div>
    }

    @if (cargando)
    {
        <div class="state-card">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <p>Cargando tipos de área...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(MensajeCarga))
    {
        <div class="state-card">
            <i class="bi bi-exclamation-circle"></i>
            <h2>No pudimos cargar las áreas</h2>
            <p>@MensajeCarga</p>

            <button type="button" class="retry-button" @onclick="Cargar">
                Reintentar
            </button>
        </div>
    }
    else if (areas.Count == 0)
    {
        <div class="state-card">
            <i class="bi bi-diagram-3"></i>
            <h2>No hay tipos de área registrados</h2>
            <p>Creá el primero para asignarlo a los profesionales.</p>
        </div>
    }
    else if (!AreasFiltradas.Any())
    {
        <div class="state-card">
            <i class="bi bi-search"></i>
            <h2>Sin resultados</h2>
            <p>Probá con otro nombre o descripción.</p>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <span>Área</span>
                <span>Descripción</span>
                <span class="actions-heading">Acción</span>
            </div>

            @foreach (var area in AreasFiltradas)
            {
                <div class="area-row" @key="area.Id">
                    <div class="area-name">
                        <i class="bi bi-diagram-3"></i>
                        <strong>@area.Tipo</strong>
                    </div>

                    <div class="area-description">
                        @(string.IsNullOrWhiteSpace(area.Descripcion)
                            ? "Sin descripción"
                            : area.Descripcion)
                    </div>

                    <div class="area-actions">
                        <button type="button"
                                class="edit-button"
                                title="Editar"
                                aria-label="@($"Editar {area.Tipo}")"
                                @onclick="() => IrAEditar(area.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="list-footer">
                Mostrando @AreasFiltradas.Count() de @areas.Count tipos de área
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "estado")]
    public string? Estado { get; set; }

    private List<TipoListadoDTO> areas = new();
    private string busqueda = string.Empty;
    private string MensajeCarga = string.Empty;
    private bool cargando = true;

    private string MensajeExito => Estado switch
    {
        "creado" => "Tipo de área creado correctamente.",
        "actualizado" => "Tipo de área actualizado correctamente.",
        "eliminado" => "Tipo de área eliminado correctamente.",
        _ => string.Empty
    };

    private IEnumerable<TipoListadoDTO> AreasFiltradas =>
        string.IsNullOrWhiteSpace(busqueda)
            ? areas
            : areas.Where(area =>
                area.Tipo.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ||
                (area.Descripcion?.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        MensajeCarga = string.Empty;

        try
        {
            var respuesta = await Http.Get<List<TipoListadoDTO>>(
                "api/tipoarea/ListaTipoArea");

            if (respuesta.Error)
            {
                areas = new();
                MensajeCarga = respuesta.ObtenerError();
            }
            else
            {
                areas = respuesta.Respuesta ?? new();
            }
        }
        catch
        {
            areas = new();
            MensajeCarga = "No pudimos cargar las áreas. Intentá nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(MensajeExito))
            return;

        await Task.Delay(5000);

        var rutaActual = Nav.ToBaseRelativePath(Nav.Uri);

        if (rutaActual == $"tipoarea?estado={Estado}")
            Nav.NavigateTo("/tipoarea", replace: true);
    }

    private void IrACrear() =>
        Nav.NavigateTo("/tipoarea/crear");

    private void IrAEditar(int id) =>
        Nav.NavigateTo($"/tipoarea/editar/{id}");

    private void Volver() => Nav.NavigateTo("/admin");
}