@page "/tipoprestacion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="prestaciones-page" inert="@(modalActual != ModalPrestacion.Ninguno)">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Prestación</h1>

            <p>
                Gestioná las prestaciones disponibles en Senderos.
            </p>

        </div>


        <div class="header-actions">


            <button type="button"
                    class="btn-nueva"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>

    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar prestación" Placeholder="Buscar prestación..." AlLimpiar="LimpiarFiltrosCatalogo">
        <Filtros>
            <SelectorConBusqueda Id="filtroAreasPrestaciones" Etiqueta="Área" Placeholder="Todas las áreas" Opciones="OpcionesAreasFiltro" @bind-Seleccionadas="areasFiltro" VersionLimpieza="versionLimpieza" />
        </Filtros>
    </BarraBusquedaCatalogo>

    <!-- =====================================================
         LISTADO
    ====================================================== -->
    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
            </div>

            <span>Cargando prestaciones...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clipboard2-pulse"></i>
            </div>

            <h2>No hay prestaciones registradas</h2>

            <p>
                Todavía no se registraron tipos de prestación.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !PrestacionesFiltradas.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay prestaciones que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else if (lista.Count > 0)
    {
        <div class="list-card">

            <div class="list-header">

                <div>PRESTACIÓN</div>
                <div>DESCRIPCIÓN</div>
                <div>CÓDIGO</div>
                <div>MONTO SESIÓN</div>
                <div>% RETENCIÓN CENTRO</div>
                <div></div>

            </div>


            <div class="list-body">

                @foreach (var item in PrestacionesFiltradas)
                {
                    <div class="prestacion-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="prestacion-info">

                            <div class="prestacion-icon">
                                <i class="bi bi-clipboard2-pulse"></i>
                            </div>

                            <div class="prestacion-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                                <span class="prestacion-area @(item.TipoAreaId.HasValue ? "" : "sin-area")">
                                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                                    @MostrarArea(item.TipoAreaNombre)
                                </span>

                            </div>

                        </div>


                        <div class="prestacion-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="prestacion-codigo">

                            @if (string.IsNullOrWhiteSpace(item.Cod))
                            {
                                <span class="sin-dato">
                                    —
                                </span>
                            }
                            else
                            {
                                @item.Cod
                            }

                        </div>


                        <div class="prestacion-monto">
                            @FormatearMonto(item.MontoSesion)
                        </div>

                        <div class="prestacion-retencion">
                            <span class="retencion-badge @(item.PorcentajeRetencion >= 100 ? "retencion-badge-completa" : "retencion-badge-normal")">
                                @item.PorcentajeRetencion.ToString("0.##")%
                            </span>
                        </div>

                        <div class="prestacion-action">
                            
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@PrestacionesFiltradas.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "prestación" : "prestaciones")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalPrestacion.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


<!-- =========================================================
     MODAL DETALLE
========================================================= -->
@if (modalActual == ModalPrestacion.Detalle)
{
    <ModalAdministracion Titulo="Detalle de prestación" CerrarAlTocarFondo="true" Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar" AlCerrar="SolicitarCerrarModal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando prestación...</span>

                </div>
            }
            else
            {
                <div class="administracion-cuerpo">


                <div class="detail-grid">

                    <div class="field-group administracion-campo field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <div class="administracion-valor detail-value">
                            @MostrarValor(modelo.Tipo)
                        </div>

                    </div>


                    <div class="field-group administracion-campo field-full">
                        <label>ÁREA</label>
                        <div class="administracion-valor detail-value">@MostrarArea(modelo.TipoAreaNombre)</div>
                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>DESCRIPCIÓN</label>

                        <div class="administracion-valor detail-value detail-value-large">

                            @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @modelo.Descripcion
                            }

                        </div>

                    </div>


                    <div class="field-group administracion-campo">

                        <label>CÓDIGO</label>

                        <div class="administracion-valor detail-value">
                            @MostrarValor(modelo.Cod)
                        </div>

                    </div>


                    <div class="field-group administracion-campo">
                        <label>MONTO POR SESIÓN</label>
                        <div class="detail-money">
                            <span class="detail-money-prefix">$</span>
                            <span class="detail-money-value">
                                @FormatearMontoSinSigno(modelo.MontoSesion)
                            </span>
                        </div>
                    </div>

                    <div class="field-group administracion-campo">
                        <label>% RETENCIÓN CENTRO</label>
                        <div class="detail-retencion">
                            <span class="retencion-badge @(modelo.PorcentajeRetencion >= 100 ? "retencion-badge-completa" : "retencion-badge-normal")">
                                @modelo.PorcentajeRetencion.ToString("0.##")% Retención
                            </span>
                            <span class="retencion-profesional">
                                (@((100 - modelo.PorcentajeRetencion).ToString("0.##"))% Profesional)
                            </span>
                        </div>
                        @if (modelo.MontoSesion > 0)
                        {
                            var retencionPesos = modelo.MontoSesion * (modelo.PorcentajeRetencion / 100m);
                            var cobroProfPesos = modelo.MontoSesion - retencionPesos;
                            <div class="split-info">
                                <span>Centro: <strong>$@FormatearMontoSinSigno(retencionPesos)</strong></span>
                                <span> • </span>
                                <span>Profesional: <strong>$@FormatearMontoSinSigno(cobroProfPesos)</strong></span>
                            </div>
                        }
                    </div>

                </div>


                </div>
                <footer class="administracion-acciones">
                    <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                    <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                    <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
                </footer>
            }

    </ModalAdministracion>
}


<!-- =========================================================
     MODAL CREAR
========================================================= -->
@if (modalActual == ModalPrestacion.Crear)
{
    <ModalAdministracion IconoFormulario="bi-clipboard2-pulse" Titulo="Nueva prestación" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCerrarModal">



            <EditForm Model="@modelo"
                      OnValidSubmit="CrearPrestacion" class="administracion-formulario">
                <div class="administracion-cuerpo">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group administracion-campo field-full">

                        <label for="areaPrestacion">ÁREA</label>

                        <EntradaConBusqueda id="areaPrestacion"
                                            Etiqueta="Área" Placeholder="Seleccioná un área"
                                            @bind-Value="modelo.TipoAreaId"
                                            Opciones="OpcionesAreasFormulario"
                                            Disabled="@(guardando || !AreasDisponibles)" />

                        <button type="button" class="prestacion-area-nueva" disabled="@(guardando || cargandoAreas)"
                                @onclick="() => altaArea.Abrir()">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Nueva área
                        </button>

                        <ValidationMessage For="@(() => modelo.TipoAreaId)" />

                        <p id="areaPrestacionAyuda" class="prestacion-area-ayuda">
                            @(cargandoAreas
                                ? "Cargando áreas…"
                                : "Cada prestación pertenece a un área. Seleccionala para guardar desde Administración.")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(errorAreas))
                        {
                            <p class="prestacion-area-error" role="alert">@errorAreas</p>

                            <button type="button"
                                    class="prestacion-area-reintentar"
                                    @onclick="CargarAreas">
                                Reintentar cargar áreas
                            </button>
                        }
                        else if (!cargandoAreas && listaAreas.Count == 0)
                        {
                            <p class="prestacion-area-ayuda" role="status">
                                No hay áreas activas. Usá Nueva área para crear la primera.
                            </p>

                            <button type="button"
                                    class="prestacion-area-reintentar"
                                    @onclick="CargarAreas">
                                Actualizar áreas
                            </button>
                        }

                    </div>

                    <div class="field-group administracion-campo field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Psicología, Fonoaudiología, Kinesiología..." />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group administracion-campo field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción de la prestación" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group administracion-campo">

                        <label>CÓDIGO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Cod"
                                   placeholder="Ej: PSI-001" />

                        <ValidationMessage For="@(() => modelo.Cod)" />

                    </div>


                    <div class="field-group administracion-campo">
                        <label>MONTO POR SESIÓN</label>
                        <div class="money-input-group">
                            <span class="money-prefix">$</span>
                            <InputNumber class="money-input"
                                         @bind-Value="modelo.MontoSesion"
                                         step="0.01" />
                        </div>
                        <ValidationMessage For="@(() => modelo.MontoSesion)" />
                    </div>

                    <div class="field-group administracion-campo">
                        <label>% RETENCIÓN CENTRO</label>
                        <div class="money-input-group">
                            <InputNumber class="money-input"
                                         @bind-Value="modelo.PorcentajeRetencion"
                                         step="1" min="0" max="100" />
                            <span class="money-suffix">%</span>
                        </div>
                        <small class="helper-text">
                            20% habitual para prestaciones clínicas | 100% para módulos o talleres.
                        </small>
                        <ValidationMessage For="@(() => modelo.PorcentajeRetencion)" />
                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrarModal">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando || !AreasDisponibles)">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}


<!-- =========================================================
     MODAL EDITAR
========================================================= -->
