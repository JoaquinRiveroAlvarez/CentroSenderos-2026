                                         step="0.01" />
                        </div>
                        <ValidationMessage For="@(() => modelo.MontoSesion)" />
                    </div>

                    <div class="field-group administracion-campo">
                        <label>% RETENCIÓN CENTRO</label>
                        <div class="money-input-group">
                            <InputNumber class="money-input"
                                         @bind-Value="modelo.PorcentajeRetencion"
                                         step="1" min="0" max="100" />
                            <span class="money-suffix">%</span>
                        </div>
                        <small class="helper-text">
                            20% habitual para prestaciones clínicas | 100% para módulos o talleres.
                        </small>
                        <ValidationMessage For="@(() => modelo.PorcentajeRetencion)" />
                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCancelarEdicion">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@(guardando || !AreasDisponibles)">
                        @(guardando ? "Guardando…" : "Guardar cambios")
                    </button>
                </footer>

            </EditForm>

    </ModalAdministracion>
}


<!-- =========================================================
     CONFIRMAR ELIMINACIÓN
========================================================= -->
@if (mostrarConfirmacionEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar este registro?" Ocupado="@eliminando" AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>Si confirmás, el registro dejará de estar disponible.</p>
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@eliminando" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@eliminando" @onclick="ConfirmarEliminar">@(eliminando ? "Eliminando…" : "Eliminar")</button>
        </footer>
    </ModalAdministracion>
}


@if (salidaPendiente is not null)
{
    <ConfirmacionDescarte OnContinuar="SeguirEditando"
                          OnDescartar="DescartarCambios" />
}

<CrearCatalogo @ref="altaArea" Recurso="tipoarea" Etiqueta="área" Creado="SeleccionarAreaCreada" />

@code {
    private CrearCatalogo altaArea = default!;

    private void SeleccionarAreaCreada(TipoListadoDTO area)
    {
        listaAreas.Add(area);
        errorAreas = string.Empty;
        modelo.TipoAreaId = area.Id;
    }

    private Func<Task>? salidaPendiente;
    private string? estadoInicial;
    private string CapturarEstadoFormulario() => System.Text.Json.JsonSerializer.Serialize(modelo);

    private void SeguirEditando() => salidaPendiente = null;

    private async Task DescartarCambios()
    {
        var salir = salidaPendiente;
        salidaPendiente = null;
        if (salir is not null)
            await salir();
    }

    private Task SolicitarCancelarEdicion() => SolicitarSalida(CancelarEdicion);

    private Task SolicitarCerrarModal() => SolicitarSalida(() =>
    {
        CerrarModal();
        return Task.CompletedTask;
    });

    private async Task SolicitarSalida(Func<Task> salir)
    {
        if (guardando || eliminando || cargandoDetalle || salidaPendiente is not null)
            return;

        if ((modalActual is ModalPrestacion.Crear or ModalPrestacion.Editar) &&
            estadoInicial is not null && estadoInicial != CapturarEstadoFormulario())
        {
            salidaPendiente = salir;
            return;
        }

        await salir();
    }


    // =====================================================
    // ÁREA DE LA PRESTACIÓN
    // =====================================================

    private List<TipoListadoDTO> listaAreas = new();

    private bool cargandoAreas;

    private string errorAreas = string.Empty;

    private bool AreasDisponibles =>
        !cargandoAreas &&
        string.IsNullOrWhiteSpace(errorAreas) &&
        listaAreas.Count > 0;

    private static string MostrarArea(string? nombre) =>
        string.IsNullOrWhiteSpace(nombre)
            ? "Sin área asignada"
            : nombre;


    private async Task CargarAreas()
    {
        cargandoAreas = true;
        errorAreas = string.Empty;

        try
        {
            var respuesta =
                await Http.Get<List<TipoListadoDTO>>(
                    "api/tipoarea/ListaTipoArea"
                );

            if (respuesta.Error)
                errorAreas = "No pudimos cargar las áreas. Reintentá para poder guardar la prestación.";
            else
                listaAreas = respuesta.Respuesta ?? new();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorAreas = "No pudimos conectarnos para cargar las áreas. Intentá nuevamente.";
        }
        finally
        {
            cargandoAreas = false;
        }
    }

    private bool ValidarAreaSeleccionada()
    {
        if (!AreasDisponibles ||
            !listaAreas.Any(area => area.Id == modelo.TipoAreaId))
        {
            Mensaje = "Seleccioná un área activa para la prestación.";
            return false;
        }
        return true;
    }



    private enum ModalPrestacion
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }


    private List<TipoPrestacionListadoDTO> lista = new();

    private TipoPrestacionDTO modelo = CrearModeloVacio();

    private ModalPrestacion modalActual =
        ModalPrestacion.Ninguno;


    private int? idSeleccionado;


    private bool cargando = true;

    private bool cargandoDetalle = false;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    // =====================================================
    // FILTRADO
    // =====================================================

    #region Filtros de área

    private HashSet<string> areasFiltro = new();
    private int versionLimpieza;
    private IEnumerable<OpcionSelector> OpcionesAreasFormulario => listaAreas
        .OrderBy(area => area.Tipo)
        .Select(area => new OpcionSelector(area.Id.ToString(), area.Tipo))
        .Concat(modelo.TipoAreaId.HasValue && !listaAreas.Any(area => area.Id == modelo.TipoAreaId)
            ? new[] { new OpcionSelector(modelo.TipoAreaId.Value.ToString(), MostrarArea(modelo.TipoAreaNombre) + " (no disponible)", Deshabilitada: true) }
            : Array.Empty<OpcionSelector>());
    private IEnumerable<OpcionSelector> OpcionesAreasFiltro => lista
        .GroupBy(prestacion => prestacion.TipoAreaId)
        .Select(grupo => new OpcionSelector(
            grupo.Key?.ToString() ?? "sin-area",
            MostrarArea(grupo.First().TipoAreaNombre)))
        .OrderBy(opcion => opcion.Texto);

    private void LimpiarFiltrosCatalogo()
    {
        textoBusqueda = string.Empty;
        areasFiltro.Clear();
        versionLimpieza++;
    }

    #endregion

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesFiltradas
    {
        get
        {
            var filtradasPorArea = lista.Where(item => areasFiltro.Count == 0 ||
                areasFiltro.Contains(item.TipoAreaId?.ToString() ?? "sin-area"));

            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return filtradasPorArea;
            }

            var busqueda = textoBusqueda.Trim();

            return filtradasPorArea.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                ContieneTexto(item.Cod, busqueda) ||
                ContieneTexto(MostrarArea(item.TipoAreaNombre), busqueda) ||
                item.MontoSesion
                    .ToString()
                    .Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await CargarAreas();
        await Cargar();
    }


    // =====================================================
    // LISTADO
    // =====================================================

    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Get<List<TipoPrestacionListadoDTO>>(
                "api/tipoprestacion/ListaTipoPrestacion"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    // =====================================================
    // DETALLE
    // =====================================================

    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;

        idSeleccionado = id;

        modelo = CrearModeloVacio();

        modalActual = ModalPrestacion.Detalle;

        cargandoDetalle = true;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{id}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Ninguno;
        }


        cargandoDetalle = false;
    }


    // =====================================================
    // CREAR
    // =====================================================

    private void AbrirCrear()
    {
        Mensaje = string.Empty;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalPrestacion.Crear;
    }


    private async Task CrearPrestacion()
    {
        if (!ValidarAreaSeleccionada())
            return;

        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Post<TipoPrestacionDTO, int>(
                "api/tipoprestacion",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            modalActual = ModalPrestacion.Ninguno;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void AbrirEditar()
    {
        Mensaje = string.Empty;

        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalPrestacion.Editar;
    }


    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }


        Mensaje = string.Empty;

        cargandoDetalle = true;

        modalActual = ModalPrestacion.Detalle;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Editar;
        }


        cargandoDetalle = false;
    }


    private async Task GuardarCambios()
    {
        if (idSeleccionado is null || !ValidarAreaSeleccionada())
            return;


        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Put<TipoPrestacionDTO, RespuestaDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            await Cargar();

            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // =====================================================
    // ELIMINAR
    // =====================================================

    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null)
            return;


        eliminando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Delete(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            modalActual = ModalPrestacion.Ninguno;

            idSeleccionado = null;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    // =====================================================
    // RECARGAR DETALLE
    // =====================================================

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;


        cargandoDetalle = true;

        modalActual = ModalPrestacion.Detalle;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Ninguno;
        }


        cargandoDetalle = false;
    }


    // =====================================================
    // CERRAR
    // =====================================================

    private void CerrarModal()
    {
        if (guardando || eliminando)
            return;


        modalActual = ModalPrestacion.Ninguno;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        Mensaje = string.Empty;
    }


    // =====================================================
    // AUXILIARES
    // =====================================================

    private static TipoPrestacionDTO CrearModeloVacio()
    {
        return new TipoPrestacionDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            Cod = string.Empty,
            MontoSesion = 0,
            PorcentajeRetencion = 20
        };
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && FiltrosEntidades.ContieneTexto(valor, busqueda);
    }


    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }


    private static string FormatearMonto(decimal monto)
    {
        return $"$ {monto:N0}";
    }


    private static string FormatearMontoSinSigno(decimal monto)
    {
        return $"{monto:N0}";
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}