@page "/tipoprestacion"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="prestaciones-page">

    @* =====================================================
       ENCABEZADO
       ===================================================== *@

    <div class="page-header">
        
        <div class="header-title">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>
            <h1>Tipos de Prestación</h1>
            <p>Gestioná las prestaciones disponibles en Senderos.</p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar prestación..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>

            <button type="button"
                    class="btn-nueva"
                    @onclick="IrACrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>

    </div>


    @* =====================================================
       CONTENIDO
       ===================================================== *@

    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <span>Cargando prestaciones...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clipboard2-pulse"></i>
            </div>

            <h2>No hay prestaciones registradas</h2>

            <p>
                Todavía no se registraron tipos de prestación.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="IrACrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !PrestacionesFiltradas.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay prestaciones que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else if (lista.Count > 0)
    {
        <div class="list-card">

            @* =========================
               ENCABEZADO DEL LISTADO
               ========================= *@

            <div class="list-header">

                <div>PRESTACIÓN</div>

                <div>DESCRIPCIÓN</div>

                <div>CÓDIGO</div>

                <div>MONTO SESIÓN</div>

                <div></div>

            </div>


            @* =========================
               FILAS
               ========================= *@

            <div class="list-body">

                @foreach (var item in PrestacionesFiltradas)
                {
                    <div class="prestacion-row"
                         role="button"
                         tabindex="0"
                         @onclick="() => IrAEditar(item.Id)">

                        @* Prestación *@

                        <div class="prestacion-info">

                            <div class="prestacion-icon">
                                <i class="bi bi-clipboard2-pulse"></i>
                            </div>

                            <div class="prestacion-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        @* Descripción *@

                        <div class="prestacion-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        @* Código *@

                        <div class="prestacion-codigo">

                            @if (string.IsNullOrWhiteSpace(item.Cod))
                            {
                                <span class="sin-dato">
                                    —
                                </span>
                            }
                            else
                            {
                                @item.Cod
                            }

                        </div>


                        @* Monto *@

                        <div class="prestacion-monto">
                            @FormatearMonto(item.MontoSesion)
                        </div>


                        @* Ir a editar *@

                        <div class="prestacion-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>


            @* =========================
               PIE DEL LISTADO
               ========================= *@

            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@PrestacionesFiltradas.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "prestación" : "prestaciones")
                </span>

            </div>

        </div>
    }


    @* =====================================================
       ERROR DE API
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


@code {

    private List<TipoPrestacionListadoDTO> lista = new();

    private bool cargando = true;

    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    // =====================================================
    // FILTRADO
    // =====================================================

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                ContieneTexto(item.Cod, busqueda) ||
                item.MontoSesion
                    .ToString()
                    .Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
            );
        }
    }


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    // =====================================================
    // CARGAR PRESTACIONES
    // =====================================================

    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;

        var resp =
            await Http.Get<List<TipoPrestacionListadoDTO>>(
                "api/tipoprestacion/ListaTipoPrestacion"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    // =====================================================
    // BÚSQUEDA
    // =====================================================

    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && valor.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            );
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    // =====================================================
    // FORMATO MONTO
    // =====================================================

    private static string FormatearMonto(decimal monto)
    {
        return $"$ {monto:N0}";
    }


    // =====================================================
    // NAVEGACIÓN
    // =====================================================

    private void IrAEditar(int id)
    {
        Nav.NavigateTo(
            $"/tipoprestacion/editar/{id}"
        );
    }


    private void IrACrear()
    {
        Nav.NavigateTo(
            "/tipoprestacion/crear"
        );
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}