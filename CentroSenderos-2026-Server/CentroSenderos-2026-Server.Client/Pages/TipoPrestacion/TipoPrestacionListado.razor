@page "/tipoprestacion"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="prestaciones-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Tipos de Prestación</h1>

            <p>
                Gestioná las prestaciones disponibles en Senderos.
            </p>

        </div>


        <div class="header-actions">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar prestación..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />

            </div>


            <button type="button"
                    class="btn-nueva"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>

    </div>


    <!-- =====================================================
         LISTADO
    ====================================================== -->
    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border"
                 role="status">
            </div>

            <span>Cargando prestaciones...</span>

        </div>
    }
    else if (lista.Count == 0 && string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-clipboard2-pulse"></i>
            </div>

            <h2>No hay prestaciones registradas</h2>

            <p>
                Todavía no se registraron tipos de prestación.
                Podés crear el primero desde esta pantalla.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                <span>Nueva Prestación</span>

            </button>

        </div>
    }
    else if (lista.Count > 0 && !PrestacionesFiltradas.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay prestaciones que coincidan con
                "<strong>@textoBusqueda</strong>".
            </p>

            <button type="button"
                    class="btn-limpiar-busqueda"
                    @onclick="LimpiarBusqueda">

                Limpiar búsqueda

            </button>

        </div>
    }
    else if (lista.Count > 0)
    {
        <div class="list-card">

            <div class="list-header">

                <div>PRESTACIÓN</div>
                <div>DESCRIPCIÓN</div>
                <div>CÓDIGO</div>
                <div>MONTO SESIÓN</div>
                <div></div>

            </div>


            <div class="list-body">

                @foreach (var item in PrestacionesFiltradas)
                {
                    <div class="prestacion-row"
                         role="button"
                         tabindex="0"
                         @onclick="() => AbrirDetalle(item.Id)">

                        <div class="prestacion-info">

                            <div class="prestacion-icon">
                                <i class="bi bi-clipboard2-pulse"></i>
                            </div>

                            <div class="prestacion-nombre">

                                @if (string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    <span class="sin-dato">
                                        Sin nombre
                                    </span>
                                }
                                else
                                {
                                    @item.Tipo
                                }

                            </div>

                        </div>


                        <div class="prestacion-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>


                        <div class="prestacion-codigo">

                            @if (string.IsNullOrWhiteSpace(item.Cod))
                            {
                                <span class="sin-dato">
                                    —
                                </span>
                            }
                            else
                            {
                                @item.Cod
                            }

                        </div>


                        <div class="prestacion-monto">
                            @FormatearMonto(item.MontoSesion)
                        </div>


                        <div class="prestacion-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>


            <div class="list-footer">

                <span>
                    Mostrando
                    <strong>@PrestacionesFiltradas.Count()</strong>
                    de
                    <strong>@lista.Count</strong>
                    @(lista.Count == 1 ? "prestación" : "prestaciones")
                </span>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalPrestacion.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@Mensaje</span>

        </div>
    }

</div>


<!-- =========================================================
     MODAL DETALLE
========================================================= -->
@if (modalActual == ModalPrestacion.Detalle)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando prestación...</span>

                </div>
            }
            else
            {
                <div class="modal-header">

                    <div>

                        <h2>Detalle Prestación</h2>

                        <p>
                            Información del tipo de prestación seleccionado.
                        </p>

                    </div>


                    <button type="button"
                            class="close-button"
                            title="Cerrar"
                            @onclick="CerrarModal">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <div class="detail-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <div class="detail-value">
                            @MostrarValor(modelo.Tipo)
                        </div>

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <div class="detail-value detail-value-large">

                            @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                            {
                                <span class="sin-dato">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @modelo.Descripcion
                            }

                        </div>

                    </div>


                    <div class="field-group">

                        <label>CÓDIGO</label>

                        <div class="detail-value">
                            @MostrarValor(modelo.Cod)
                        </div>

                    </div>


                    <div class="field-group">

                        <label>MONTO POR SESIÓN</label>

                        <div class="detail-money">

                            <span class="detail-money-prefix">
                                $
                            </span>

                            <span class="detail-money-value">
                                @FormatearMontoSinSigno(modelo.MontoSesion)
                            </span>

                        </div>

                    </div>

                </div>


                <div class="modal-actions detail-actions">

                    <button type="button"
                            class="btn-cerrar"
                            @onclick="CerrarModal">

                        Cerrar

                    </button>


                    <button type="button"
                            class="btn-editar"
                            @onclick="AbrirEditar">

                        <i class="bi bi-pencil-square"></i>
                        Editar

                    </button>

                </div>
            }

        </div>

    </div>
}


<!-- =========================================================
     MODAL CREAR
========================================================= -->
@if (modalActual == ModalPrestacion.Crear)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Nueva Prestación</h2>

                    <p>
                        Complete los datos del tipo de prestación.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        title="Cerrar"
                        disabled="@guardando"
                        @onclick="CerrarModal">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="CrearPrestacion">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Psicología, Fonoaudiología, Kinesiología..." />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción de la prestación" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group">

                        <label>CÓDIGO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Cod"
                                   placeholder="Ej: PSI-001" />

                        <ValidationMessage For="@(() => modelo.Cod)" />

                    </div>


                    <div class="field-group">

                        <label>MONTO POR SESIÓN</label>

                        <div class="money-input-group">

                            <span class="money-prefix">
                                $
                            </span>

                            <InputNumber class="money-input"
                                         @bind-Value="modelo.MontoSesion"
                                         step="0.01" />

                        </div>

                        <ValidationMessage For="@(() => modelo.MontoSesion)" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@guardando"
                            @onclick="CerrarModal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-guardar"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


<!-- =========================================================
     MODAL EDITAR
========================================================= -->
@if (modalActual == ModalPrestacion.Editar)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Editar Prestación</h2>

                    <p>
                        Modifique los datos del tipo de prestación.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        title="Volver al detalle"
                        disabled="@guardando"
                        @onclick="CancelarEdicion">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Psicología, Fonoaudiología, Kinesiología..." />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción de la prestación" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group">

                        <label>CÓDIGO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Cod"
                                   placeholder="Ej: PSI-001" />

                        <ValidationMessage For="@(() => modelo.Cod)" />

                    </div>


                    <div class="field-group">

                        <label>MONTO POR SESIÓN</label>

                        <div class="money-input-group">

                            <span class="money-prefix">
                                $
                            </span>

                            <InputNumber class="money-input"
                                         @bind-Value="modelo.MontoSesion"
                                         step="0.01" />

                        </div>

                        <ValidationMessage For="@(() => modelo.MontoSesion)" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="modal-actions edit-actions">

                    <button type="button"
                            class="btn-eliminar"
                            disabled="@guardando"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>

                        Eliminar Prestación

                    </button>


                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                disabled="@guardando"
                                @onclick="CancelarEdicion">

                            Cancelar

                        </button>


                        <button type="submit"
                                class="btn-guardar"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>

        </div>

    </div>
}


<!-- =========================================================
     CONFIRMAR ELIMINACIÓN
========================================================= -->
@if (mostrarConfirmacionEliminar)
{
    <div class="delete-modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>


            <h2>
                ¿Estás seguro que querés eliminar esta prestación?
            </h2>


            <p>
                Esta acción no se puede deshacer.
                La prestación será eliminada definitivamente.
            </p>


            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    private enum ModalPrestacion
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }


    private List<TipoPrestacionListadoDTO> lista = new();

    private TipoPrestacionDTO modelo = CrearModeloVacio();

    private ModalPrestacion modalActual =
        ModalPrestacion.Ninguno;


    private int? idSeleccionado;


    private bool cargando = true;

    private bool cargandoDetalle = false;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;


    private string Mensaje = string.Empty;

    private string textoBusqueda = string.Empty;


    // =====================================================
    // FILTRADO
    // =====================================================

    private IEnumerable<TipoPrestacionListadoDTO> PrestacionesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                return lista;
            }

            var busqueda = textoBusqueda.Trim();

            return lista.Where(item =>
                ContieneTexto(item.Tipo, busqueda) ||
                ContieneTexto(item.Descripcion, busqueda) ||
                ContieneTexto(item.Cod, busqueda) ||
                item.MontoSesion
                    .ToString()
                    .Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase
                    )
            );
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }


    // =====================================================
    // LISTADO
    // =====================================================

    private async Task Cargar()
    {
        cargando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Get<List<TipoPrestacionListadoDTO>>(
                "api/tipoprestacion/ListaTipoPrestacion"
            );


        if (resp.Error)
        {
            lista = new();

            Mensaje = resp.ObtenerError();
        }
        else
        {
            lista = resp.Respuesta ?? new();
        }


        cargando = false;
    }


    // =====================================================
    // DETALLE
    // =====================================================

    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;

        idSeleccionado = id;

        modelo = CrearModeloVacio();

        modalActual = ModalPrestacion.Detalle;

        cargandoDetalle = true;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{id}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Ninguno;
        }


        cargandoDetalle = false;
    }


    // =====================================================
    // CREAR
    // =====================================================

    private void AbrirCrear()
    {
        Mensaje = string.Empty;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        modalActual = ModalPrestacion.Crear;
    }


    private async Task CrearPrestacion()
    {
        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Post<TipoPrestacionDTO, int>(
                "api/tipoprestacion",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            modalActual = ModalPrestacion.Ninguno;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void AbrirEditar()
    {
        Mensaje = string.Empty;

        modalActual = ModalPrestacion.Editar;
    }


    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }


        Mensaje = string.Empty;

        cargandoDetalle = true;

        modalActual = ModalPrestacion.Detalle;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Editar;
        }


        cargandoDetalle = false;
    }


    private async Task GuardarCambios()
    {
        if (idSeleccionado is null)
            return;


        guardando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Put<TipoPrestacionDTO, RespuestaDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}",
                modelo
            );


        guardando = false;


        if (!resp.Error)
        {
            await Cargar();

            await RecargarDetalle();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    // =====================================================
    // ELIMINAR
    // =====================================================

    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null)
            return;


        eliminando = true;

        Mensaje = string.Empty;


        var resp =
            await Http.Delete(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            modalActual = ModalPrestacion.Ninguno;

            idSeleccionado = null;

            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    // =====================================================
    // RECARGAR DETALLE
    // =====================================================

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
            return;


        cargandoDetalle = true;

        modalActual = ModalPrestacion.Detalle;


        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{idSeleccionado.Value}"
            );


        if (!resp.Error &&
            resp.Respuesta != null)
        {
            modelo = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();

            modalActual = ModalPrestacion.Ninguno;
        }


        cargandoDetalle = false;
    }


    // =====================================================
    // CERRAR
    // =====================================================

    private void CerrarModal()
    {
        if (guardando || eliminando)
            return;


        modalActual = ModalPrestacion.Ninguno;

        idSeleccionado = null;

        modelo = CrearModeloVacio();

        Mensaje = string.Empty;
    }


    // =====================================================
    // AUXILIARES
    // =====================================================

    private static TipoPrestacionDTO CrearModeloVacio()
    {
        return new TipoPrestacionDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            Cod = string.Empty,
            MontoSesion = 0
        };
    }


    private static bool ContieneTexto(
        string? valor,
        string busqueda)
    {
        return !string.IsNullOrWhiteSpace(valor)
            && valor.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            );
    }


    private static string MostrarValor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }


    private static string FormatearMonto(decimal monto)
    {
        return $"$ {monto:N0}";
    }


    private static string FormatearMontoSinSigno(decimal monto)
    {
        return $"{monto:N0}";
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }


    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}