    <ModalAdministracion IconoFormulario="bi-clipboard2-pulse" Titulo="Editar prestación" Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)" AlCerrar="SolicitarCancelarEdicion">



            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios" class="administracion-formulario">
                <div class="administracion-cuerpo">

