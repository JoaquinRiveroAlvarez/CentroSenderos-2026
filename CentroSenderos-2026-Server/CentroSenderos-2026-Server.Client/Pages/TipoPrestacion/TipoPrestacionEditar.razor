@page "/tipoprestacion/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="prestacion-form-page">

    <div class="prestacion-card">

        <div class="card-header">
            
            <div>
                <button type="button"
                        class="back-button"
                        @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </button>
                <h1>Editar Prestación</h1>
                <p>Modifique los datos del tipo de prestación.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        @if (cargando)
        {
            <div class="loading-state">

                <div class="spinner-border"
                     role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>

                <span>Cargando prestación...</span>

            </div>
        }
        else
        {
            <EditForm Model="@modelo"
                      OnValidSubmit="Grabar"
                      class="prestacion-form">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="form-grid">

                    <div class="field-group field-full">

                        <label>TIPO DE PRESTACIÓN</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Tipo"
                                   placeholder="Ej: Psicología, Fonoaudiología, Kinesiología..." />

                        <ValidationMessage For="@(() => modelo.Tipo)" />

                    </div>


                    <div class="field-group field-full">

                        <label>DESCRIPCIÓN</label>

                        <InputTextArea class="senderos-textarea"
                                       @bind-Value="modelo.Descripcion"
                                       placeholder="Ingrese una descripción de la prestación" />

                        <ValidationMessage For="@(() => modelo.Descripcion)" />

                    </div>


                    <div class="field-group">

                        <label>CÓDIGO</label>

                        <InputText class="senderos-input"
                                   @bind-Value="modelo.Cod"
                                   placeholder="Ej: PSI-001" />

                        <ValidationMessage For="@(() => modelo.Cod)" />

                    </div>


                    <div class="field-group">

                        <label>MONTO POR SESIÓN</label>

                        <div class="money-input-group">

                            <span class="money-prefix">$</span>

                            <InputNumber class="money-input"
                                         @bind-Value="modelo.MontoSesion"
                                         step="0.01" />

                        </div>

                        <ValidationMessage For="@(() => modelo.MontoSesion)" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>

                        <span>@Mensaje</span>

                    </div>
                }


                <div class="form-actions editar-actions">

                    <button type="button"
                            class="btn-eliminar"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>
                        Eliminar Prestación

                    </button>


                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                @onclick="Cancelar">

                            Cancelar

                        </button>


                        <button type="submit"
                                class="btn-guardar"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>
        }

    </div>

</div>


@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>
                ¿Estás seguro que querés eliminar esta prestación?
            </h2>

            <p>
                Esta acción no se puede deshacer.
                La prestación será eliminada definitivamente.
            </p>

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public int id { get; set; }


    private TipoPrestacionDTO modelo = CrearModeloVacio();

    private bool cargando = true;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;

    private string Mensaje = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarPrestacion();
    }


    private async Task CargarPrestacion()
    {
        cargando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Get<TipoPrestacionDTO>(
                $"api/tipoprestacion/{id}"
            );

        if (resp.Error)
        {
            modelo = CrearModeloVacio();
            Mensaje = resp.ObtenerError();
        }
        else
        {
            modelo =
                resp.Respuesta
                ?? CrearModeloVacio();
        }

        cargando = false;
    }


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Put<TipoPrestacionDTO, RespuestaDTO>(
                $"api/tipoprestacion/{id}",
                modelo
            );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/tipoprestacion",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        eliminando = true;
        Mensaje = string.Empty;

        var resp =
            await Http.Delete(
                $"api/tipoprestacion/{id}"
            );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/tipoprestacion",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/tipoprestacion");
    }


    private static TipoPrestacionDTO CrearModeloVacio()
    {
        return new TipoPrestacionDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty,
            Cod = string.Empty,
            MontoSesion = 0
        };
    }


    private void Volver()
    {
        Nav.NavigateTo("/tipoprestacion");
    }

}