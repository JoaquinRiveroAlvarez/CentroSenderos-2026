@page "/planillas/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="crear-planilla-page">

    <button type="button"
            class="back-button"
            disabled="@guardando"
            @onclick="Volver">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </button>

    <h1>Nueva planilla</h1>

    @if (cargando)
    {
        <div class="loading-message">
            Cargando tipos de planilla...
        </div>
    }
    else
    {
        <div class="planilla-form">

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">01</span>
                    <span>Información de la planilla</span>
                </div>

                <div class="form-grid">
                    <div class="field-group">
                        <label for="nombrePlanilla">Nombre</label>

                        <input id="nombrePlanilla"
                               class="form-input"
                               type="text"
                               maxlength="150"
                               disabled="@guardando"
                               placeholder="Ej.: Ficha de ingreso"
                               @bind="nombre"
                               @bind:event="oninput" />
                    </div>

                    <div class="field-group">
                        <label for="tipoPlanilla">Tipo de planilla</label>

                        <select id="tipoPlanilla"
                                class="form-input"
                                disabled="@guardando"
                                @bind="tipoPlanillaId">
                            <option value="0">Seleccione un tipo</option>

                            @foreach (var tipo in tiposPlanilla)
                            {
                                <option value="@tipo.Id">@tipo.Tipo</option>
                            }
                        </select>
                    </div>

                    <div class="field-group full-width">
                        <label for="descripcionPlanilla">Descripción</label>

                        <textarea id="descripcionPlanilla"
                                  class="form-textarea"
                                  maxlength="1000"
                                  disabled="@guardando"
                                  placeholder="Describí para qué se utiliza esta planilla"
                                  @bind="descripcion"
                                  @bind:event="oninput"></textarea>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <span class="section-number">02</span>
                    <span>Archivo PDF</span>
                </div>

                <div class="file-field">
                    <div class="file-icon">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>

                    <div class="file-content">
                        <strong>Seleccioná la planilla base</strong>
                        <span>Archivo PDF de hasta 20 MB</span>

                        <InputFile @key="versionArchivo"
                                   OnChange="SeleccionarArchivo"
                                   accept=".pdf,application/pdf"
                                   disabled="@guardando"
                                   class="file-input" />

                        @if (archivo != null)
                        {
                            <div class="selected-file">
                                <span>
                                    <i class="bi bi-check-circle"></i>
                                    @archivo.Name
                                </span>

                                <button type="button"
                                        class="remove-file-button"
                                        title="Quitar archivo"
                                        aria-label="Quitar archivo seleccionado"
                                        disabled="@guardando"
                                        @onclick="QuitarArchivo">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(MensajeArchivo))
                {
                    <div class="form-message" role="alert">
                        @MensajeArchivo
                    </div>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message" role="alert">
                    @Mensaje
                </div>
            }

            <div class="form-actions">
                <button type="button"
                        class="cancel-button"
                        disabled="@guardando"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="button"
                        class="save-button"
                        disabled="@(guardando || tiposPlanilla.Count == 0)"
                        @onclick="Guardar">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar planilla</span>
                    }
                </button>
            </div>

        </div>
    }
</div>

@code {
    private const long LimiteArchivoBytes = 20 * 1024 * 1024;

    private List<TipoListadoDTO> tiposPlanilla = new();

    private string nombre = string.Empty;
    private string descripcion = string.Empty;
    private int tipoPlanillaId;

    private IBrowserFile? archivo;
    private int versionArchivo;

    private bool cargando = true;
    private bool guardando;

    private string Mensaje = string.Empty;
    private string MensajeArchivo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await Http.Get<List<TipoListadoDTO>>(
                "api/tipoplanillas/ListaTipoPlanillas");

            if (resp.Error)
            {
                Mensaje = "No se pudieron cargar los tipos de planilla. "
                    + "Verificá que haya tipos disponibles e intentá nuevamente.";
                return;
            }

            tiposPlanilla = resp.Respuesta ?? new();

            if (tiposPlanilla.Count == 0)
            {
                Mensaje = "Primero registrá un tipo de planilla "
                    + "en la sección Tipos de planilla.";
            }
        }
        catch
        {
            Mensaje = "No se pudieron cargar los tipos de planilla. "
                + "Intentá nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        MensajeArchivo = string.Empty;
        archivo = null;

        var seleccionado = e.File;

        if (!seleccionado.Name.EndsWith(
            ".pdf",
            StringComparison.OrdinalIgnoreCase))
        {
            MensajeArchivo = "Seleccioná un archivo PDF.";
        }
        else if (seleccionado.Name.Length > 255)
        {
            MensajeArchivo = "El nombre del archivo no puede superar "
                + "los 255 caracteres.";
        }
        else if (seleccionado.Size == 0)
        {
            MensajeArchivo = "El archivo seleccionado está vacío.";
        }
        else if (seleccionado.Size > LimiteArchivoBytes)
        {
            MensajeArchivo = "El archivo no puede superar los 20 MB.";
        }
        else
        {
            archivo = seleccionado;
        }

        if (archivo == null)
        {
            // Reinicia el selector para permitir elegir el mismo archivo.
            versionArchivo++;
        }
    }

    private void QuitarArchivo()
    {
        if (guardando)
            return;

        archivo = null;
        MensajeArchivo = string.Empty;
        versionArchivo++;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        Mensaje = string.Empty;
        MensajeArchivo = string.Empty;

        var nombreLimpio = nombre.Trim();
        var descripcionLimpia = descripcion.Trim();

        if (string.IsNullOrWhiteSpace(nombreLimpio))
        {
            Mensaje = "Ingresá un nombre para la planilla.";
            return;
        }

        if (nombreLimpio.Length > 150)
        {
            Mensaje = "El nombre no puede superar los 150 caracteres.";
            return;
        }

        if (!tiposPlanilla.Any(t => t.Id == tipoPlanillaId))
        {
            Mensaje = "Seleccioná un tipo de planilla disponible.";
            return;
        }

        if (descripcionLimpia.Length > 1000)
        {
            Mensaje = "La descripción no puede superar los 1000 caracteres.";
            return;
        }

        var archivoSeleccionado = archivo;

        if (archivoSeleccionado == null)
        {
            MensajeArchivo = "Seleccioná el PDF que querés guardar.";
            return;
        }

        guardando = true;

        try
        {
            // Leemos el archivo antes de enviarlo a la API.
            using var stream = archivoSeleccionado.OpenReadStream(
                LimiteArchivoBytes);

            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);

            using var contenido =
                new System.Net.Http.MultipartFormDataContent();

            contenido.Add(
                new System.Net.Http.StringContent(nombreLimpio),
                "nombre");

            contenido.Add(
                new System.Net.Http.StringContent(descripcionLimpia),
                "descripcion");

            contenido.Add(
                new System.Net.Http.StringContent(
                    tipoPlanillaId.ToString(
                        System.Globalization.CultureInfo.InvariantCulture)),
                "tipoPlanillaId");

            var contenidoArchivo =
                new System.Net.Http.ByteArrayContent(ms.ToArray());

            contenidoArchivo.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    "application/pdf");

            contenido.Add(
                contenidoArchivo,
                "archivo",
                archivoSeleccionado.Name);

            var resp = await Http.PostMultipart<int>(
                "api/planillas",
                contenido);

            if (resp.Error)
            {
                Mensaje = resp.ObtenerError();
                return;
            }

            Nav.NavigateTo("/planillas");
        }
        catch
        {
            Mensaje = "No se pudo guardar la planilla. "
                + "Intentá nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        if (!guardando)
            Nav.NavigateTo("/planillas");
    }

    private void Volver()
    {
        if (!guardando)
            Nav.NavigateTo("/planillas");
    }
}