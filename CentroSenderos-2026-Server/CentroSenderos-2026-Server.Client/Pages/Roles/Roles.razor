@page "/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<PageTitle>Gestión de roles | Centro Senderos</PageTitle>

<div class="roles-page" inert="@(usuarioSeleccionado is not null)">
    <header class="page-header">
        <button type="button" class="back-button" @onclick="Volver">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Volver
        </button>
        <h1>Gestión de roles</h1>
        <p>Consultá las cuentas del sistema y administrá sus roles.</p>
    </header>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar usuario"
                           Placeholder="Buscar por correo electrónico…" />

    @if (cargando)
    {
        <div class="state-card" role="status">Cargando usuarios…</div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeCarga))
    {
        <div class="state-card" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <h2>Error al cargar usuarios</h2>
            <p>@mensajeCarga</p>
            <button type="button" class="state-button" @onclick="CargarUsuarios">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                Reintentar
            </button>
        </div>
    }
    else if (usuarios.Count == 0)
    {
        <div class="state-card">
            <i class="bi bi-people" aria-hidden="true"></i>
            <h2>No hay usuarios registrados</h2>
        </div>
    }
    else if (!UsuariosFiltrados.Any())
    {
        <div class="state-card">
            <i class="bi bi-search" aria-hidden="true"></i>
            <h2>Sin resultados</h2>
            <p>Probá con otro correo electrónico.</p>
            <BotonLimpiarFiltros AlLimpiar="LimpiarBusqueda" />
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <span>Correo electrónico</span>
                <span>Roles</span>
            </div>
            @foreach (var cuentaListado in UsuariosFiltrados)
            {
                <div class="user-row" @key="cuentaListado.Id">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {CorreoVisible(cuentaListado)}")"
                                                 Abrir="() => AbrirDetalle(cuentaListado)" />
                    <div class="user-email">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <strong>@CorreoVisible(cuentaListado)</strong>
                    </div>
                    <div class="role-badges">
                        @if (cuentaListado.Roles.Count == 0)
                        {
                            <span class="muted">Sin roles</span>
                        }
                        @foreach (var rol in cuentaListado.Roles)
                        {
                            <span class="role-badge">@NombreRol(rol)</span>
                        }
                    </div>
                </div>
            }
            <div class="list-footer">Mostrando @UsuariosFiltrados.Count() de @usuarios.Count usuarios</div>
        </div>
    }
</div>

@if (usuarioSeleccionado is { } cuenta)
{
    <ModalAdministracion Titulo="@TituloModal" CerrarAlTocarFondo="@(vista == Vista.Detalle)"
                         Ocupado="@guardando" Inactivo="@confirmarDescarte" AlCerrar="SolicitarCerrar">
        @if (vista == Vista.Contrasena)
        {
            <EditForm Model="restablecimiento" OnValidSubmit="RestablecerContrasena" class="administracion-formulario">
                <DataAnnotationsValidator />
                <div class="administracion-cuerpo">
                    <dl class="administracion-campo"><dt>Correo electrónico</dt><dd>@CorreoVisible(cuenta)</dd></dl>
                    <ValidationSummary />
                    <div class="administracion-campo">
                        <label for="nueva-contrasena">Nueva contraseña</label>
                        <InputText id="nueva-contrasena" type="password" autocomplete="new-password"
                                   @bind-Value="restablecimiento.NuevaContrasena" disabled="@guardando" />
                    </div>
                    <div class="administracion-campo">
                        <label for="confirmacion-contrasena">Confirmá la nueva contraseña</label>
                        <InputText id="confirmacion-contrasena" type="password" autocomplete="new-password"
                                   @bind-Value="restablecimiento.Confirmacion" disabled="@guardando" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorAccion))
                    {
                        <p class="administracion-error" role="alert">@errorAccion</p>
                    }
                </div>
                <footer class="administracion-acciones">
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrar">Cancelar</button>
                    <button type="submit" class="administracion-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : "Guardar contraseña")
                    </button>
                </footer>
            </EditForm>
        }
        else
        {
            <div class="administracion-cuerpo">
                <dl class="administracion-campo"><dt>Correo electrónico</dt><dd>@CorreoVisible(cuenta)</dd></dl>

                @if (vista == Vista.Detalle)
                {
                    <dl class="administracion-campo">
                        <dt>Roles asignados</dt>
                        <dd class="role-badges">
                            @if (cuenta.Roles.Count == 0)
                            {
                                <span class="muted">Sin roles</span>
                            }
                            @foreach (var rol in cuenta.Roles)
                            {
                                <span class="role-badge">@NombreRol(rol)</span>
                            }
                        </dd>
                    </dl>
                }
                else if (cambioPendiente is not null)
                {
                    <div class="role-warning">
                        <strong>Se eliminarán las planillas privadas de esta cuenta.</strong>
                        <p>Esta acción quita el rol Profesional. Las planillas eliminadas no se pueden recuperar desde la aplicación.</p>
                    </div>
                }
                else
                {
                    <p class="role-hint">Los cambios de rol se guardan al aplicarlos.</p>
                    <ul class="role-options">
                        @foreach (var (rol, nombre) in RolesDisponibles)
                        {
                            var asignado = TieneRol(cuenta, rol);
                            <li @key="rol">
                                <div>
                                    <strong>@nombre</strong>
                                    <span class="role-badge @(asignado ? null : "role-badge-inactive")">
                                        @(asignado ? "Asignado" : "Sin asignar")
                                    </span>
                                </div>
                                @if (PuedeGestionarRol(rol))
                                {
                                    <button type="button" class="role-button" disabled="@(guardando || !string.IsNullOrEmpty(mensajeCarga))"
                                            aria-label="@(asignado ? $"Quitar rol {nombre}" : $"Asignar rol {nombre}")"
                                            @onclick="() => SolicitarCambio(cuenta, rol, asignado)">
                                        @(asignado ? "Quitar" : "Asignar")
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(errorAccion))
                {
                    <p class="administracion-error" role="alert">@errorAccion</p>
                }
                @if (!string.IsNullOrWhiteSpace(avisoAccion))
                {
                    <p class="role-notice" role="status">@avisoAccion</p>
                }
            </div>
            <footer class="administracion-acciones">
                @if (vista == Vista.Detalle)
                {
                    <button type="button" @onclick="SolicitarCerrar">Cerrar</button>
                    @if (puedeGestionarPrivilegiados)
                    {
                        <button type="button" @onclick="() => AbrirRestablecimiento(cuenta)">Restablecer contraseña</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(cuenta.Email))
                    {
                        <button type="button" class="administracion-primario" @onclick="() => IrAVista(Vista.Roles)">Gestionar roles</button>
                    }
                }
                else if (cambioPendiente is { } pendiente)
                {
                    <button type="button" disabled="@guardando" @onclick="CancelarCambio">Cancelar</button>
                    <button type="button" class="administracion-peligro" disabled="@guardando"
                            @onclick="() => CambiarRol(cuenta, pendiente.Rol, pendiente.Quitar)">
                        @(guardando ? "Aplicando…" : "Confirmar cambio")
                    </button>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(mensajeCarga))
                    {
                        <button type="button" disabled="@guardando" @onclick="ActualizarRoles">Actualizar roles</button>
                    }
                    <button type="button" disabled="@guardando" @onclick="SolicitarCerrar">Volver al detalle</button>
                }
            </footer>
        }
    </ModalAdministracion>
}

@if (confirmarDescarte)
{
    <ConfirmacionDescarte OnContinuar="() => confirmarDescarte = false" OnDescartar="CerrarRestablecimiento" />
}

@code {
    private enum Vista { Detalle, Roles, Contrasena }

    private static readonly (string Rol, string Nombre)[] RolesDisponibles =
        [("Socio", "Socio"), ("admin", "Admin"), ("Calendario", "Calendario"),
         ("equipo", "Equipo"), ("profesional", "Profesional")];

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> EstadoAutenticacion { get; set; } = default!;

    private List<UsuarioDTO> usuarios = new();
    private UsuarioDTO? usuarioSeleccionado;
    private RestablecerContrasenaDTO restablecimiento = new();
    private (string Rol, bool Quitar)? cambioPendiente;
    private Vista vista;
    private bool puedeGestionarPrivilegiados;
    private bool cargando = true;
    private bool guardando;
    private bool confirmarDescarte;
    private string textoBusqueda = string.Empty;
    private string mensajeCarga = string.Empty;
    private string errorAccion = string.Empty;
    private string avisoAccion = string.Empty;

    private string TituloModal => vista switch
    {
        Vista.Contrasena => "Restablecer contraseña",
        Vista.Roles when cambioPendiente is not null => "Confirmar cambio de rol",
        Vista.Roles => "Gestionar roles",
        _ => "Detalle del usuario"
    };

    private IEnumerable<UsuarioDTO> UsuariosFiltrados =>
        usuarios.Where(cuenta => cuenta.Email.Contains(textoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion).User;
        puedeGestionarPrivilegiados = usuario.IsInRole("Socio") || usuario.IsInRole("admin");
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        mensajeCarga = string.Empty;
        try
        {
            var respuesta = await Http.Get<List<UsuarioDTO>>("api/seguridad/usuarios");
            if (respuesta.Error)
                mensajeCarga = respuesta.ObtenerError();
            else
            {
                usuarios = respuesta.Respuesta ?? new();
                if (usuarioSeleccionado is { } cuentaActual)
                    usuarioSeleccionado = usuarios.FirstOrDefault(item => item.Id == cuentaActual.Id);
            }
        }
        catch (HttpRequestException)
        {
            mensajeCarga = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirDetalle(UsuarioDTO cuenta)
    {
        usuarioSeleccionado = cuenta;
        IrAVista(Vista.Detalle);
    }

    private void IrAVista(Vista destino)
    {
        vista = destino;
        errorAccion = string.Empty;
        avisoAccion = string.Empty;
    }

    private void AbrirRestablecimiento(UsuarioDTO cuenta)
    {
        restablecimiento = new() { UsuarioId = cuenta.Id };
        IrAVista(Vista.Contrasena);
    }

    private async Task RestablecerContrasena()
    {
        if (guardando)
            return;

        guardando = true;
        errorAccion = string.Empty;
        try
        {
            var resultado = await Http.Post<RestablecerContrasenaDTO, string>(
                "api/seguridad/restablecerContrasena", restablecimiento);
            if (resultado.Error)
            {
                errorAccion = resultado.ObtenerError();
                return;
            }

            CerrarRestablecimiento();
            avisoAccion = "Contraseña restablecida.";
        }
        catch (HttpRequestException)
        {
            errorAccion = "No se pudo verificar el restablecimiento. Volvé a intentarlo.";
        }
        finally
        {
            restablecimiento.NuevaContrasena = string.Empty;
            restablecimiento.Confirmacion = string.Empty;
            guardando = false;
        }
    }

    private Task SolicitarCambio(UsuarioDTO cuenta, string rol, bool quitar)
    {
        if (guardando || cambioPendiente is not null)
            return Task.CompletedTask;

        if ((quitar && rol == "profesional") || (!quitar && rol == "equipo" && TieneRol(cuenta, "profesional")))
        {
            errorAccion = string.Empty;
            avisoAccion = string.Empty;
            cambioPendiente = (rol, quitar);
            return Task.CompletedTask;
        }

        return CambiarRol(cuenta, rol, quitar);
    }

    private async Task CambiarRol(UsuarioDTO cuenta, string rol, bool quitar)
    {
        if (guardando || !PuedeGestionarRol(rol))
            return;

        guardando = true;
        errorAccion = string.Empty;
        avisoAccion = string.Empty;
        try
        {
            var operacion = quitar ? "removerRol" : "asignarRol";
            var respuesta = await Http.Post<RolAsignacionDTO, string>(
                $"api/seguridad/{operacion}", new RolAsignacionDTO { Email = cuenta.Email, Rol = rol });

            if (respuesta.Error)
            {
                errorAccion = respuesta.ObtenerError();
                return;
            }

            cambioPendiente = null;
            avisoAccion = quitar ? $"Se quitó el rol {NombreRol(rol)}." : $"Se asignó el rol {NombreRol(rol)}.";
            await RecargarRoles();
        }
        catch (HttpRequestException)
        {
            cambioPendiente = null;
            await RecargarRoles();
            errorAccion = "No se pudo confirmar el cambio. Revisá los roles antes de volver a intentarlo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task ActualizarRoles()
    {
        guardando = true;
        try
        {
            await RecargarRoles();
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task RecargarRoles()
    {
        await CargarUsuarios();
        errorAccion = string.IsNullOrEmpty(mensajeCarga) ? string.Empty : "No se pudieron actualizar los roles en pantalla. " + mensajeCarga;
    }

    private void SolicitarCerrar()
    {
        if (guardando || confirmarDescarte)
            return;

        if (vista == Vista.Contrasena)
        {
            if (!string.IsNullOrEmpty(restablecimiento.NuevaContrasena) || !string.IsNullOrEmpty(restablecimiento.Confirmacion))
                confirmarDescarte = true;
            else
                CerrarRestablecimiento();
        }
        else if (cambioPendiente is not null)
            CancelarCambio();
        else if (vista == Vista.Roles)
            IrAVista(Vista.Detalle);
        else
            usuarioSeleccionado = null;
    }

    private void CerrarRestablecimiento()
    {
        confirmarDescarte = false;
        restablecimiento = new();
        IrAVista(Vista.Detalle);
    }

    private void CancelarCambio()
    {
        cambioPendiente = null;
        errorAccion = string.Empty;
    }

    private bool PuedeGestionarRol(string rol) =>
        rol is not ("Socio" or "admin") || puedeGestionarPrivilegiados;

    private static bool TieneRol(UsuarioDTO cuenta, string rol) =>
        cuenta.Roles.Contains(rol, StringComparer.OrdinalIgnoreCase);

    private static string NombreRol(string rol) =>
        RolesDisponibles.FirstOrDefault(opcion => string.Equals(opcion.Rol, rol, StringComparison.OrdinalIgnoreCase)).Nombre ?? rol;

    private static string CorreoVisible(UsuarioDTO cuenta) =>
        string.IsNullOrWhiteSpace(cuenta.Email) ? "Cuenta sin correo" : cuenta.Email;

    private void LimpiarBusqueda() => textoBusqueda = string.Empty;

    private void Volver() => Nav.NavigateTo("/admin");
}
