@page "/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="roles-page">

    <div class="page-header">
        <div class="header-title">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <h1>Gestión de Roles</h1>
            <p>Asigná o remové roles a los usuarios del sistema.</p>
        </div>

        <div class="header-actions">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar usuario..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorAccion))
    {
        <p role="alert">@errorAccion</p>
    }

    @if (cargando)
    {
        <div class="estado-card">
            <div class="spinner-border" role="status"></div>
            <span>Cargando usuarios...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="estado-card error">
            <div class="estado-icon"><i class="bi bi-exclamation-circle"></i></div>
            <h3>Error al cargar usuarios</h3>
            <p>@Mensaje</p>
            <button type="button"
                    class="estado-button secundario"
                    @onclick="CargarUsuarios">
                <i class="bi bi-arrow-clockwise"></i>
                Reintentar
            </button>
        </div>
    }
    else if (usuarios == null || usuarios.Count == 0)
    {
        <div class="estado-card">
            <div class="estado-icon"><i class="bi bi-people"></i></div>
            <h2>No hay usuarios registrados</h2>
            <p>Actualmente no existen usuarios en el sistema.</p>
        </div>
    }
    else if (!UsuariosFiltrados.Any())
    {
        <div class="estado-card">
            <div class="estado-icon"><i class="bi bi-search"></i></div>
            <h3>No encontramos resultados</h3>
            <p>No hay usuarios que coincidan con <strong>"@textoBusqueda"</strong>.</p>
            <button type="button"
                    class="estado-button secundario"
                    @onclick="LimpiarBusqueda">
                <i class="bi bi-x-circle"></i>
                Limpiar búsqueda
            </button>
        </div>
    }
    else
    {
        <div class="list-card">
            <div class="list-header">
                <div>EMAIL</div>
                <div>ROLES</div>
                <div>ACCIONES</div>
            </div>

            <div class="list-body">
                @foreach (var u in UsuariosFiltrados)
                {
                    <div class="socio-row">
                        <div class="socio-nombre">@u.Email</div>
                        <div class="socio-observacion">
                            @(u.Roles.Any() ? string.Join(", ", u.Roles.Select(NombreRol)) : "Sin roles")
                        </div>
                        <div class="socio-action">
                            @foreach (var (rol, nombre) in RolesDisponibles)
                            {
                                var asignado = u.Roles.Contains(rol, StringComparer.OrdinalIgnoreCase);
                                if (rol is not ("Socio" or "admin") || PuedeGestionarPrivilegiados)
                                {
                                    <button type="button" class="btn-rol" disabled="@guardando"
                                            @onclick="() => CambiarRol(u.Email, rol, asignado)">
                                        @(asignado ? $"Quitar {nombre}" : $"Asignar {nombre}")
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="list-footer">
                Mostrando <strong>@UsuariosFiltrados.Count()</strong> de <strong>@usuarios.Count</strong> usuarios
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> EstadoAutenticacion { get; set; } = default!;

    private static readonly (string Rol, string Nombre)[] RolesDisponibles =
        [("Socio", "Socio"), ("admin", "Admin"), ("Calendario", "Calendario"),
         ("equipo", "Equipo"), ("profesional", "Profesional")];
    private bool PuedeGestionarPrivilegiados;
    private bool guardando;
    private string errorAccion = string.Empty;

    private List<UsuarioDTO> usuarios = new();
    private string textoBusqueda = string.Empty;
    private bool cargando = true;
    private string Mensaje = string.Empty;

    private IEnumerable<UsuarioDTO> UsuariosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? usuarios
            : usuarios.Where(u => u.Email.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion).User;
        PuedeGestionarPrivilegiados = usuario.IsInRole("Socio") || usuario.IsInRole("admin");
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        Mensaje = string.Empty;

        var resp = await Http.Get<List<UsuarioDTO>>("api/seguridad/usuarios");
        if (!resp.Error && resp.Respuesta != null)
            usuarios = resp.Respuesta;
        else
            Mensaje = resp.ObtenerError();

        cargando = false;
    }

    private async Task CambiarRol(string email, string rol, bool asignado)
    {
        guardando = true;
        errorAccion = string.Empty;
        try
        {
            var operacion = asignado ? "removerRol" : "asignarRol";
            var resp = await Http.Post<RolAsignacionDTO, string>(
                $"api/seguridad/{operacion}", new RolAsignacionDTO { Email = email, Rol = rol });
            if (resp.Error)
                errorAccion = resp.ObtenerError();
            else
                await CargarUsuarios();
        }
        finally
        {
            guardando = false;
        }
    }

    private static string NombreRol(string rol)
    {
        foreach (var opcion in RolesDisponibles)
            if (string.Equals(opcion.Rol, rol, StringComparison.OrdinalIgnoreCase))
                return opcion.Nombre;

        return rol;
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
    }

    private void Volver() => Nav.NavigateTo("/admin");
}
