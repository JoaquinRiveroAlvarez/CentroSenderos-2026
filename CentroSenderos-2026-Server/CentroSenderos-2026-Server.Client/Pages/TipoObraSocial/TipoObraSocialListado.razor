@page "/tipoobrasocial"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obras-sociales-page">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">

                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>

            </button>

            <h1>Obras Sociales</h1>

            <p>
                Gestioná las obras sociales disponibles para los pacientes.
            </p>

        </div>

        <div class="header-actions">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar por nombre, CUIT o descripción..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />

            </div>

            <button type="button"
                    class="btn-nueva"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nueva Obra Social

            </button>

        </div>

    </div>

    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border spinner-border-sm"
                 role="status">
            </div>

            <span>Cargando obras sociales...</span>

        </div>
    }
    else if (lista.Count == 0)
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-building"></i>
            </div>

            <h2>No hay obras sociales registradas</h2>

            <p>
                Creá una nueva obra social para comenzar.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nueva Obra Social

            </button>

        </div>
    }
    else if (!ObrasSocialesFiltradas.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay obras sociales que coincidan con
                "@textoBusqueda".
            </p>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">

                <div>OBRA SOCIAL</div>
                <div>CUIT</div>
                <div>DESCRIPCIÓN</div>
                <div></div>

            </div>

            <div class="list-body">

                @foreach (var item in ObrasSocialesFiltradas)
                {
                    <div class="obra-row"
                         @onclick="() => AbrirDetalle(item.Id)">

                        <div class="obra-info">

                            <div class="obra-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <div class="obra-nombre">
                                @MostrarValor(item.Tipo)
                            </div>

                        </div>

                        <div class="obra-cuit">
                            @FormatearCuitParaMostrar(item.Cuit)
                        </div>

                        <div class="obra-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-descripcion">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>

                        <div class="obra-action">
                            <i class="bi bi-chevron-right"></i>
                        </div>

                    </div>
                }

            </div>

            <div class="list-footer">

                <span>
                    Mostrando @ObrasSocialesFiltradas.Count()
                    de @lista.Count
                    @(lista.Count == 1 ? "obra social" : "obras sociales")
                </span>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalObraSocial.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>
            <span>@Mensaje</span>

        </div>
    }

</div>

@* Modal de detalle *@

@if (modalActual == ModalObraSocial.Detalle)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            @if (cargandoDetalle)
            {
                <div class="modal-loading">

                    <div class="spinner-border"
                         role="status">
                    </div>

                    <span>Cargando obra social...</span>

                </div>
            }
            else
            {
                <div class="modal-header">

                    <div>

                        <h2>Detalle Obra Social</h2>

                        <p>
                            Información de la obra social seleccionada.
                        </p>

                    </div>

                    <button type="button"
                            class="close-button"
                            title="Cerrar"
                            @onclick="CerrarModal">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

                <div class="field-group">

                    <label>OBRA SOCIAL</label>

                    <div class="detail-value">
                        @MostrarValor(modelo.Tipo)
                    </div>

                </div>

                <div class="field-group">

                    <label>CUIT</label>

                    <div class="detail-value">
                        @FormatearCuitParaMostrar(modelo.Cuit)
                    </div>

                </div>

                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <div class="detail-value detail-value-large">

                        @if (string.IsNullOrWhiteSpace(modelo.Descripcion))
                        {
                            <span class="sin-descripcion">
                                Sin descripción
                            </span>
                        }
                        else
                        {
                            @modelo.Descripcion
                        }

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>

                    </div>
                }

                <div class="modal-actions detail-actions">

                    <button type="button"
                            class="btn-cerrar"
                            @onclick="CerrarModal">

                        Cerrar

                    </button>

                    <button type="button"
                            class="btn-editar"
                            @onclick="AbrirEditar">

                        <i class="bi bi-pencil-square"></i>
                        Editar

                    </button>

                </div>
            }

        </div>

    </div>
}

@* Modal de creación *@

@if (modalActual == ModalObraSocial.Crear)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Nueva Obra Social</h2>

                    <p>
                        Complete los datos de la obra social.
                    </p>

                </div>

                <button type="button"
                        class="close-button"
                        title="Cerrar"
                        disabled="@guardando"
                        @onclick="CerrarModal">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <EditForm Model="@modelo"
                      OnValidSubmit="CrearObraSocial">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="field-group">

                    <label>OBRA SOCIAL</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre de la obra social" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>

                <div class="field-group">

                    <label>CUIT</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Cuit"
                               @onblur="FormatearCuitModelo"
                               inputmode="numeric"
                               maxlength="13"
                               placeholder="Ej.: 30-12345678-9" />

                    <small class="field-help">
                        Ingresá los 11 números del CUIT, con o sin guiones.
                    </small>

                    <ValidationMessage For="@(() => modelo.Cuit)" />

                </div>

                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>

                    </div>
                }

                <div class="modal-actions">

                    <button type="button"
                            class="btn-cancelar"
                            disabled="@guardando"
                            @onclick="CerrarModal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn-guardar"
                            disabled="@guardando">

                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@* Modal de edición *@

@if (modalActual == ModalObraSocial.Editar)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="modal-header">

                <div>

                    <h2>Editar Obra Social</h2>

                    <p>
                        Modifique los datos de la obra social.
                    </p>

                </div>

                <button type="button"
                        class="close-button"
                        title="Volver al detalle"
                        disabled="@(guardando || eliminando)"
                        @onclick="CancelarEdicion">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

            <EditForm Model="@modelo"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="field-group">

                    <label>OBRA SOCIAL</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre de la obra social" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>

                <div class="field-group">

                    <label>CUIT</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Cuit"
                               @onblur="FormatearCuitModelo"
                               inputmode="numeric"
                               maxlength="13"
                               placeholder="Ej.: 30-12345678-9" />

                    <small class="field-help">
                        Ingresá los 11 números del CUIT, con o sin guiones.
                    </small>

                    <ValidationMessage For="@(() => modelo.Cuit)" />

                </div>

                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>

                    </div>
                }

                <div class="modal-actions edit-actions">

                    <button type="button"
                            class="btn-eliminar"
                            disabled="@(guardando || eliminando)"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>
                        Eliminar

                    </button>

                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                disabled="@(guardando || eliminando)"
                                @onclick="CancelarEdicion">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="btn-guardar"
                                disabled="@(guardando || eliminando)">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>

        </div>

    </div>
}

@* Confirmación de eliminación *@

@if (mostrarConfirmacionEliminar)
{
    <div class="delete-modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h2>
                ¿Estás seguro que querés eliminar esta obra social?
            </h2>

            <p>
                Esta acción no se puede deshacer.
                La obra social será eliminada definitivamente.
            </p>

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}

@code {

    private enum ModalObraSocial
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }

    private List<TipoObraSocialDTO> lista = new();
    private TipoObraSocialDTO modelo = CrearModeloVacio();

    private ModalObraSocial modalActual = ModalObraSocial.Ninguno;

    private int? idSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private IEnumerable<TipoObraSocialDTO> ObrasSocialesFiltradas =>
        lista.Where(x =>
            string.IsNullOrWhiteSpace(textoBusqueda)
            ||
            (x.Tipo?.Contains(
                textoBusqueda,
                StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (x.Descripcion?.Contains(
                textoBusqueda,
                StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            CoincideCuit(x.Cuit)
        );

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;

        var resp = await Http.Get<List<TipoObraSocialDTO>>(
            "api/tipoobrasocial/ListaTipoObraSocial"
        );

        lista = resp.Error
            ? new()
            : resp.Respuesta ?? new();

        Mensaje = resp.Error
            ? resp.ObtenerError()
            : string.Empty;

        cargando = false;
    }

    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;
        idSeleccionado = id;
        modelo = CrearModeloVacio();

        modalActual = ModalObraSocial.Detalle;
        cargandoDetalle = true;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{id}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void AbrirCrear()
    {
        Mensaje = string.Empty;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        modalActual = ModalObraSocial.Crear;
    }

    private async Task CrearObraSocial()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Post<TipoObraSocialDTO, int>(
            "api/tipoobrasocial",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            modalActual = ModalObraSocial.Ninguno;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirEditar()
    {
        Mensaje = string.Empty;
        modelo.Cuit = FormatearCuit(modelo.Cuit);
        modalActual = ModalObraSocial.Editar;
    }

    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;
        cargandoDetalle = true;
        modalActual = ModalObraSocial.Detalle;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Editar;
        }

        cargandoDetalle = false;
    }

    private async Task GuardarCambios()
    {
        if (idSeleccionado is null ||
            guardando ||
            eliminando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Put<TipoObraSocialDTO, RespuestaDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            await Cargar();
            await RecargarDetalle();
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (!guardando && !eliminando)
        {
            mostrarConfirmacionEliminar = true;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null || eliminando)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        var resp = await Http.Delete(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;
            modalActual = ModalObraSocial.Ninguno;
            idSeleccionado = null;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
        {
            return;
        }

        cargandoDetalle = true;
        modalActual = ModalObraSocial.Detalle;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void CerrarModal()
    {
        if (guardando || eliminando)
        {
            return;
        }

        modalActual = ModalObraSocial.Ninguno;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        Mensaje = string.Empty;
    }

    private void FormatearCuitModelo()
    {
        modelo.Cuit = FormatearCuit(modelo.Cuit);
    }

    private bool CoincideCuit(string? cuit)
    {
        var busquedaNormalizada = NormalizarCuit(textoBusqueda);

        if (string.IsNullOrWhiteSpace(busquedaNormalizada))
        {
            return false;
        }

        return NormalizarCuit(cuit).Contains(
            busquedaNormalizada,
            StringComparison.OrdinalIgnoreCase
        );
    }

    private static string NormalizarCuit(string? cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit))
        {
            return string.Empty;
        }

        return new string(
            cuit.Where(char.IsDigit).ToArray()
        );
    }

    private static string FormatearCuit(string? cuit)
    {
        var cuitNormalizado = NormalizarCuit(cuit);

        if (cuitNormalizado.Length != 11)
        {
            return cuit?.Trim() ?? string.Empty;
        }

        return $"{cuitNormalizado[..2]}-" +
               $"{cuitNormalizado.Substring(2, 8)}-" +
               $"{cuitNormalizado[^1]}";
    }

    private static string FormatearCuitParaMostrar(string? cuit)
    {
        var cuitFormateado = FormatearCuit(cuit);

        return string.IsNullOrWhiteSpace(cuitFormateado)
            ? "—"
            : cuitFormateado;
    }

    private static TipoObraSocialDTO CrearModeloVacio()
    {
        return new TipoObraSocialDTO
        {
            Tipo = string.Empty,
            Cuit = string.Empty,
            Descripcion = string.Empty
        };
    }

    private static string MostrarValor(object? valor)
    {
        if (valor is null)
        {
            return "—";
        }

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}