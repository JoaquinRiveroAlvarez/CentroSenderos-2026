@page "/tipoobrasocial"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Socio,admin,Calendario")]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obras-sociales-page" inert="@(modalActual != ModalObraSocial.Ninguno)">

    <div class="page-header">

        <div class="header-title">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">

                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>

            </button>

            <h1>Obras Sociales</h1>

            <p>
                Gestioná las obras sociales disponibles para los pacientes.
            </p>

        </div>

        <div class="header-actions">

            <button type="button"
                    class="btn-nueva"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nueva Obra Social

            </button>

        </div>

    </div>

    <BarraBusquedaCatalogo @bind-Busqueda="textoBusqueda" Etiqueta="Buscar por nombre, CUIT o descripción" Placeholder="Buscar por nombre, CUIT o descripción..." />

    @if (cargando)
    {
        <div class="estado-card">

            <div class="spinner-border spinner-border-sm"
                 role="status">
            </div>

            <span>Cargando obras sociales...</span>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeCarga))
    {
        <div class="estado-card" role="alert">
            <h2>No pudimos cargar las obras sociales</h2>
            <p>@mensajeCarga</p>
            <button type="button" class="btn-nueva-estado" @onclick="Cargar">Reintentar</button>
        </div>
    }
    else if (lista.Count == 0)
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-building"></i>
            </div>

            <h2>No hay obras sociales registradas</h2>

            <p>
                Creá una nueva obra social para comenzar.
            </p>

            <button type="button"
                    class="btn-nueva-estado"
                    @onclick="AbrirCrear">

                <i class="bi bi-plus-lg"></i>
                Nueva Obra Social

            </button>

        </div>
    }
    else if (!ObrasSocialesFiltradas.Any())
    {
        <div class="estado-card">

            <div class="estado-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2>No encontramos resultados</h2>

            <p>
                No hay obras sociales que coincidan con
                "@textoBusqueda".
            </p>

        </div>
    }
    else
    {
        <div class="list-card">

            <div class="list-header">

                <div>OBRA SOCIAL</div>
                <div>CUIT</div>
                <div>DESCRIPCIÓN</div>
                <div></div>

            </div>

            <div class="list-body">

                @foreach (var item in ObrasSocialesFiltradas)
                {
                    <div class="obra-row" style="position: relative">
                    <AccesoDetalleAdministracion Etiqueta="@($"Ver detalle de {item.Tipo}")" Abrir="() => AbrirDetalle(item.Id)" />

                        <div class="obra-info">

                            <div class="obra-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <div class="obra-nombre">
                                @MostrarValor(item.Tipo)
                            </div>

                        </div>

                        <div class="obra-cuit">
                            @FormatearCuitParaMostrar(item.Cuit)
                        </div>

                        <div class="obra-descripcion">

                            @if (string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span class="sin-descripcion">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @item.Descripcion
                            }

                        </div>

                        <div class="obra-action">
                            
                        </div>

                    </div>
                }

            </div>

            <div class="list-footer">

                <span>
                    Mostrando @ObrasSocialesFiltradas.Count()
                    de @lista.Count
                    @(lista.Count == 1 ? "obra social" : "obras sociales")
                </span>

            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje) &&
         modalActual == ModalObraSocial.Ninguno)
    {
        <div class="mensaje-error">

            <i class="bi bi-exclamation-circle"></i>
            <span>@Mensaje</span>

        </div>
    }

</div>

@if (modalActual == ModalObraSocial.Detalle)
{
    <ModalAdministracion Titulo="Detalle de obra social" CerrarAlTocarFondo="true"
                         Ocupado="@(cargandoDetalle || eliminando)" Inactivo="@mostrarConfirmacionEliminar"
                         AlCerrar="SolicitarCerrarModal">
        <div class="administracion-cuerpo">
            @if (cargandoDetalle)
            {
                <p role="status">Cargando obra social…</p>
            }
            else
            {
                <dl class="administracion-campo"><dt>Obra social</dt><dd>@MostrarValor(modelo.Tipo)</dd></dl>
                <dl class="administracion-campo"><dt>CUIT</dt><dd>@FormatearCuitParaMostrar(modelo.Cuit)</dd></dl>
                <dl class="administracion-campo"><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(modelo.Descripcion) ? "Sin descripción" : modelo.Descripcion)</dd></dl>
                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <p class="administracion-error" role="alert">@Mensaje</p>
                }
            }
        </div>
        @if (!cargandoDetalle)
        {
            <footer class="administracion-acciones">
                <button type="button" class="administracion-eliminar" @onclick="AbrirConfirmacionEliminar">Eliminar</button>
                <button type="button" @onclick="SolicitarCerrarModal">Cerrar</button>
                <button type="button" class="administracion-primario" @onclick="AbrirEditar">Editar</button>
            </footer>
        }
    </ModalAdministracion>
}

@if (modalActual is ModalObraSocial.Crear or ModalObraSocial.Editar)
{
    var editando = modalActual == ModalObraSocial.Editar;
    <ModalAdministracion Titulo="@(editando ? "Editar obra social" : "Nueva obra social")"
                         Ocupado="@guardando" Inactivo="@(salidaPendiente is not null)"
                         AlCerrar="CerrarFormulario">
        <EditForm Model="@modelo" OnValidSubmit="GuardarFormulario" class="administracion-formulario">
            <DataAnnotationsValidator />
            <div class="administracion-cuerpo">
                <ValidationSummary />
                <div class="administracion-campo">
                    <label for="administracion-obra-nombre">Obra social</label>
                    <InputText id="administracion-obra-nombre" @bind-Value="modelo.Tipo" disabled="@guardando" />
                    <ValidationMessage For="@(() => modelo.Tipo)" />
                </div>
                <div class="administracion-campo">
                    <label for="administracion-obra-cuit">CUIT</label>
                    <InputText id="administracion-obra-cuit" @bind-Value="modelo.Cuit" @onblur="FormatearCuitModelo"
                               inputmode="numeric" maxlength="13" placeholder="Ej.: 30-12345678-9" disabled="@guardando" />
                    <ValidationMessage For="@(() => modelo.Cuit)" />
                </div>
                <div class="administracion-campo">
                    <label for="administracion-obra-descripcion">Descripción</label>
                    <InputTextArea id="administracion-obra-descripcion" @bind-Value="modelo.Descripcion" disabled="@guardando" />
                    <ValidationMessage For="@(() => modelo.Descripcion)" />
                </div>
                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <p class="administracion-error" role="alert">@Mensaje</p>
                }
            </div>
            <footer class="administracion-acciones">
                <button type="button" disabled="@guardando" @onclick="CerrarFormulario">Cancelar</button>
                <button type="submit" class="administracion-primario" disabled="@guardando">
                    @(guardando ? "Guardando…" : editando ? "Guardar cambios" : "Guardar")
                </button>
            </footer>
        </EditForm>
    </ModalAdministracion>
}

@if (mostrarConfirmacionEliminar)
{
    <ModalAdministracion Titulo="¿Eliminar la obra social?" Ocupado="@eliminando"
                         AlCerrar="CerrarConfirmacionEliminar">
        <div class="administracion-cuerpo">
            <p>La obra social <strong>@modelo.Tipo</strong> dejará de estar disponible.</p>
        </div>
        <footer class="administracion-acciones">
            <button type="button" disabled="@eliminando" @onclick="CerrarConfirmacionEliminar">Cancelar</button>
            <button type="button" class="administracion-peligro" disabled="@eliminando" @onclick="ConfirmarEliminar">
                @(eliminando ? "Eliminando…" : "Eliminar")
            </button>
        </footer>
    </ModalAdministracion>
}

@if (salidaPendiente is not null)
{
    <ConfirmacionDescarte OnContinuar="SeguirEditando"
                          OnDescartar="DescartarCambios" />
}

@code {
    private Task CerrarFormulario() => modalActual == ModalObraSocial.Editar
        ? SolicitarCancelarEdicion()
        : SolicitarCerrarModal();

    private Task GuardarFormulario() => modalActual == ModalObraSocial.Editar
        ? GuardarCambios()
        : CrearObraSocial();

    private Func<Task>? salidaPendiente;
    private string? estadoInicial;
    private string CapturarEstadoFormulario() => System.Text.Json.JsonSerializer.Serialize(modelo);

    private void SeguirEditando() => salidaPendiente = null;

    private async Task DescartarCambios()
    {
        var salir = salidaPendiente;
        salidaPendiente = null;
        if (salir is not null)
            await salir();
    }

    private Task SolicitarCancelarEdicion() => SolicitarSalida(CancelarEdicion);

    private Task SolicitarCerrarModal() => SolicitarSalida(() =>
    {
        CerrarModal();
        return Task.CompletedTask;
    });

    private async Task SolicitarSalida(Func<Task> salir)
    {
        if (guardando || eliminando || cargandoDetalle || salidaPendiente is not null)
            return;

        if ((modalActual is ModalObraSocial.Crear or ModalObraSocial.Editar) &&
            estadoInicial is not null && estadoInicial != CapturarEstadoFormulario())
        {
            salidaPendiente = salir;
            return;
        }

        await salir();
    }


    private enum ModalObraSocial
    {
        Ninguno,
        Detalle,
        Crear,
        Editar
    }

    private List<TipoObraSocialDTO> lista = new();
    private string mensajeCarga = string.Empty;
    private TipoObraSocialDTO modelo = CrearModeloVacio();

    private ModalObraSocial modalActual = ModalObraSocial.Ninguno;

    private int? idSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;

    private string Mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private IEnumerable<TipoObraSocialDTO> ObrasSocialesFiltradas =>
        lista.Where(x =>
            string.IsNullOrWhiteSpace(textoBusqueda)
            ||
            FiltrosEntidades.ContieneTexto(x.Tipo, textoBusqueda)
            ||
            FiltrosEntidades.ContieneTexto(x.Descripcion, textoBusqueda)
            ||
            CoincideCuit(x.Cuit)
        );

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        mensajeCarga = string.Empty;

        try
        {
            var respuesta = await Http.Get<List<TipoObraSocialDTO>>(
                "api/tipoobrasocial/ListaTipoObraSocial");

            if (!respuesta.Error && respuesta.Respuesta is not null)
            {
                lista = respuesta.Respuesta;
                return;
            }

            mensajeCarga = respuesta.HttpResponseMessage?.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Volvé a iniciar sesión para consultar el listado.",
                System.Net.HttpStatusCode.Forbidden => "Tu cuenta no tiene permiso para consultar el listado.",
                { } codigo => $"El servidor no devolvió el listado (HTTP {(int)codigo}).",
                _ => "No recibimos el listado. Intentá nuevamente."
            };
        }
        catch
        {
            mensajeCarga = "No se pudo consultar el listado. Verificá la conexión e intentá nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AbrirDetalle(int id)
    {
        Mensaje = string.Empty;
        idSeleccionado = id;
        modelo = CrearModeloVacio();

        modalActual = ModalObraSocial.Detalle;
        cargandoDetalle = true;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{id}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void AbrirCrear()
    {
        Mensaje = string.Empty;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalObraSocial.Crear;
    }

    private async Task CrearObraSocial()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Post<TipoObraSocialDTO, int>(
            "api/tipoobrasocial",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            modalActual = ModalObraSocial.Ninguno;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirEditar()
    {
        Mensaje = string.Empty;
        modelo.Cuit = FormatearCuit(modelo.Cuit);
        estadoInicial = CapturarEstadoFormulario();
        modalActual = ModalObraSocial.Editar;
    }

    private async Task CancelarEdicion()
    {
        if (guardando ||
            eliminando ||
            idSeleccionado is null)
        {
            return;
        }

        Mensaje = string.Empty;
        cargandoDetalle = true;
        modalActual = ModalObraSocial.Detalle;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Editar;
        }

        cargandoDetalle = false;
    }

    private async Task GuardarCambios()
    {
        if (idSeleccionado is null ||
            guardando ||
            eliminando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Put<TipoObraSocialDTO, RespuestaDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            await Cargar();
            await RecargarDetalle();
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (!guardando && !eliminando)
        {
            mostrarConfirmacionEliminar = true;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task ConfirmarEliminar()
    {
        if (idSeleccionado is null || eliminando)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        var resp = await Http.Delete(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;
            modalActual = ModalObraSocial.Ninguno;
            idSeleccionado = null;
            modelo = CrearModeloVacio();

            await Cargar();
        }
        else
        {
            Mensaje = resp.ObtenerError();
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task RecargarDetalle()
    {
        if (idSeleccionado is null)
        {
            return;
        }

        cargandoDetalle = true;
        modalActual = ModalObraSocial.Detalle;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{idSeleccionado.Value}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            modalActual = ModalObraSocial.Ninguno;
        }

        cargandoDetalle = false;
    }

    private void CerrarModal()
    {
        if (guardando || eliminando)
        {
            return;
        }

        modalActual = ModalObraSocial.Ninguno;
        idSeleccionado = null;
        modelo = CrearModeloVacio();
        Mensaje = string.Empty;
    }

    private void FormatearCuitModelo()
    {
        modelo.Cuit = FormatearCuit(modelo.Cuit);
    }

    private bool CoincideCuit(string? cuit)
    {
        var busquedaNormalizada = NormalizarCuit(textoBusqueda);

        if (string.IsNullOrWhiteSpace(busquedaNormalizada))
        {
            return false;
        }

        return NormalizarCuit(cuit).Contains(
            busquedaNormalizada,
            StringComparison.OrdinalIgnoreCase
        );
    }

    private static string NormalizarCuit(string? cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit))
        {
            return string.Empty;
        }

        return new string(
            cuit.Where(char.IsDigit).ToArray()
        );
    }

    private static string FormatearCuit(string? cuit)
    {
        var cuitNormalizado = NormalizarCuit(cuit);

        if (cuitNormalizado.Length != 11)
        {
            return cuit?.Trim() ?? string.Empty;
        }

        return $"{cuitNormalizado[..2]}-" +
               $"{cuitNormalizado.Substring(2, 8)}-" +
               $"{cuitNormalizado[^1]}";
    }

    private static string FormatearCuitParaMostrar(string? cuit)
    {
        var cuitFormateado = FormatearCuit(cuit);

        return string.IsNullOrWhiteSpace(cuitFormateado)
            ? "—"
            : cuitFormateado;
    }

    private static TipoObraSocialDTO CrearModeloVacio()
    {
        return new TipoObraSocialDTO
        {
            Tipo = string.Empty,
            Cuit = string.Empty,
            Descripcion = string.Empty
        };
    }

    private static string MostrarValor(object? valor)
    {
        if (valor is null)
        {
            return "—";
        }

        var texto = valor.ToString();

        return string.IsNullOrWhiteSpace(texto)
            ? "—"
            : texto;
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin");
    }
}