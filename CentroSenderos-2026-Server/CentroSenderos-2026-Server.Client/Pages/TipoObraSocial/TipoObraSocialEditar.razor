@page "/tipoobrasocial/editar/{id:int}"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obra-social-form-page">

    <div class="obra-social-card">

        <div class="card-header">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>
            <div>
                <h1>Editar Obra Social</h1>
                <p>Modifique los datos de la obra social.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        @if (cargando)
        {
            <div class="loading-state">

                <div class="spinner-border"
                     role="status">
                </div>

                <span>Cargando obra social...</span>

            </div>
        }
        else
        {
            <EditForm Model="@modelo"
                      OnValidSubmit="Grabar"
                      class="obra-social-form">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <div class="field-group">

                    <label>OBRA SOCIAL</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre de la obra social" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>


                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>


                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">
                        @Mensaje
                    </div>
                }


                <div class="form-actions editar-actions">

                    <button type="button"
                            class="btn-eliminar"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>
                        Eliminar Obra Social

                    </button>


                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                @onclick="Cancelar">

                            Cancelar

                        </button>


                        <button type="submit"
                                class="btn-guardar"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>
        }

    </div>

</div>


@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>


            <h2>
                ¿Estás seguro que querés eliminar esta obra social?
            </h2>


            <p>
                Esta acción no se puede deshacer.
                La obra social será eliminada definitivamente.
            </p>


            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>


                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public int id { get; set; }


    private TipoDTO modelo = CrearModeloVacio();

    private bool cargando = true;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarConfirmacionEliminar = false;

    private string Mensaje = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarObraSocial();
    }


    private async Task CargarObraSocial()
    {
        cargando = true;

        var resp =
            await Http.Get<TipoDTO>(
                $"api/tipoobrasocial/{id}"
            );

        modelo =
            resp.Error
                ? CrearModeloVacio()
                : resp.Respuesta ?? CrearModeloVacio();

        Mensaje =
            resp.Error
                ? resp.ObtenerError()
                : "";

        cargando = false;
    }


    private async Task Grabar()
    {
        guardando = true;

        Mensaje = "";

        var resp =
            await Http.Put<TipoDTO, RespuestaDTO>(
                $"api/tipoobrasocial/{id}",
                modelo
            );

        guardando = false;


        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/tipoobrasocial",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void AbrirConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = true;
    }


    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }


    private async Task ConfirmarEliminar()
    {
        eliminando = true;

        Mensaje = "";

        var resp =
            await Http.Delete(
                $"api/tipoobrasocial/{id}"
            );

        eliminando = false;


        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo(
                "/tipoobrasocial",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();

            mostrarConfirmacionEliminar = false;
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }


    private static TipoDTO CrearModeloVacio()
    {
        return new TipoDTO
        {
            Tipo = string.Empty,
            Descripcion = string.Empty
        };
    }


    private void Volver()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }
}