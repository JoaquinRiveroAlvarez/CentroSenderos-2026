@page "/tipoobrasocial/editar/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obra-social-form-page">

    <div class="obra-social-card">

        <div class="card-header">

            <div>

                <button type="button"
                        class="back-button"
                        @onclick="Volver">

                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>

                </button>

                <h1>Editar Obra Social</h1>

                <p>
                    Modifique los datos de la obra social.
                </p>

            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    disabled="@(guardando || eliminando)"
                    @onclick="Cancelar">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>

        @if (cargando)
        {
            <div class="loading-state">

                <div class="spinner-border"
                     role="status">
                </div>

                <span>Cargando obra social...</span>

            </div>
        }
        else if (!obraSocialEncontrada)
        {
            <div class="error-state">

                <div class="error-state-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>

                <h2>No se pudo cargar la obra social</h2>

                <p>@Mensaje</p>

                <button type="button"
                        class="btn-volver-listado"
                        @onclick="Volver">

                    Volver al listado

                </button>

            </div>
        }
        else
        {
            <EditForm Model="@modelo"
                      OnValidSubmit="Grabar"
                      class="obra-social-form">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="field-group">

                    <label>OBRA SOCIAL</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Tipo"
                               placeholder="Ingresar nombre de la obra social" />

                    <ValidationMessage For="@(() => modelo.Tipo)" />

                </div>

                <div class="field-group">

                    <label>CUIT</label>

                    <InputText class="senderos-input"
                               @bind-Value="modelo.Cuit"
                               @onblur="FormatearCuitModelo"
                               inputmode="numeric"
                               maxlength="13"
                               placeholder="Ej.: 30-12345678-9" />

                    <small class="field-help">
                        Ingresá los 11 números del CUIT, con o sin guiones.
                    </small>

                    <ValidationMessage For="@(() => modelo.Cuit)" />

                </div>

                <div class="field-group">

                    <label>DESCRIPCIÓN</label>

                    <InputTextArea class="senderos-textarea"
                                   @bind-Value="modelo.Descripcion"
                                   placeholder="Ingresar una descripción" />

                    <ValidationMessage For="@(() => modelo.Descripcion)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="form-message">

                        <i class="bi bi-exclamation-circle"></i>
                        <span>@Mensaje</span>

                    </div>
                }

                <div class="form-actions editar-actions">

                    <button type="button"
                            class="btn-eliminar"
                            disabled="@(guardando || eliminando)"
                            @onclick="AbrirConfirmacionEliminar">

                        <i class="bi bi-trash3"></i>
                        Eliminar Obra Social

                    </button>

                    <div class="right-actions">

                        <button type="button"
                                class="btn-cancelar"
                                disabled="@(guardando || eliminando)"
                                @onclick="Cancelar">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="btn-guardar"
                                disabled="@(guardando || eliminando)">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Cambios</span>
                            }

                        </button>

                    </div>

                </div>

            </EditForm>
        }

    </div>

</div>

@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <div class="delete-warning-icon">

                <i class="bi bi-exclamation-triangle-fill"></i>

            </div>

            <h2>
                ¿Estás seguro que querés eliminar esta obra social?
            </h2>

            <p>
                Esta acción no se puede deshacer.
                La obra social será eliminada definitivamente.
            </p>

            <div class="delete-modal-actions">

                <button type="button"
                        class="confirm-delete-button"
                        disabled="@eliminando"
                        @onclick="ConfirmarEliminar">

                    @if (eliminando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <span>Eliminar</span>
                    }

                </button>

                <button type="button"
                        class="modal-cancel-button"
                        disabled="@eliminando"
                        @onclick="CerrarConfirmacionEliminar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int id { get; set; }

    private TipoObraSocialDTO modelo = CrearModeloVacio();

    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool mostrarConfirmacionEliminar;
    private bool obraSocialEncontrada;

    private string Mensaje = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await CargarObraSocial();
    }

    private async Task CargarObraSocial()
    {
        cargando = true;
        obraSocialEncontrada = false;
        Mensaje = string.Empty;

        var resp = await Http.Get<TipoObraSocialDTO>(
            $"api/tipoobrasocial/{id}"
        );

        if (!resp.Error && resp.Respuesta is not null)
        {
            modelo = resp.Respuesta;
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            obraSocialEncontrada = true;
        }
        else
        {
            modelo = CrearModeloVacio();
            Mensaje = resp.ObtenerError();
        }

        cargando = false;
    }

    private async Task Grabar()
    {
        if (guardando || eliminando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Put<TipoObraSocialDTO, RespuestaDTO>(
            $"api/tipoobrasocial/{id}",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo("/tipoobrasocial", true);
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void AbrirConfirmacionEliminar()
    {
        if (!guardando && !eliminando)
        {
            mostrarConfirmacionEliminar = true;
        }
    }

    private void CerrarConfirmacionEliminar()
    {
        if (!eliminando)
        {
            mostrarConfirmacionEliminar = false;
        }
    }

    private async Task ConfirmarEliminar()
    {
        if (eliminando)
        {
            return;
        }

        eliminando = true;
        Mensaje = string.Empty;

        var resp = await Http.Delete(
            $"api/tipoobrasocial/{id}"
        );

        eliminando = false;

        if (!resp.Error)
        {
            mostrarConfirmacionEliminar = false;

            Nav.NavigateTo("/tipoobrasocial", true);
        }
        else
        {
            Mensaje = resp.ObtenerError();
            mostrarConfirmacionEliminar = false;
        }
    }

    private void FormatearCuitModelo()
    {
        modelo.Cuit = FormatearCuit(modelo.Cuit);
    }

    private static string NormalizarCuit(string? cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit))
        {
            return string.Empty;
        }

        return new string(
            cuit.Where(char.IsDigit).ToArray()
        );
    }

    private static string FormatearCuit(string? cuit)
    {
        var cuitNormalizado = NormalizarCuit(cuit);

        if (cuitNormalizado.Length != 11)
        {
            return cuit?.Trim() ?? string.Empty;
        }

        return $"{cuitNormalizado[..2]}-" +
               $"{cuitNormalizado.Substring(2, 8)}-" +
               $"{cuitNormalizado[^1]}";
    }

    private static TipoObraSocialDTO CrearModeloVacio()
    {
        return new TipoObraSocialDTO
        {
            Tipo = string.Empty,
            Cuit = string.Empty,
            Descripcion = string.Empty
        };
    }

    private void Cancelar()
    {
        if (!guardando && !eliminando)
        {
            Nav.NavigateTo($"/tipoobrasocial/detalle/{id}");
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }
}