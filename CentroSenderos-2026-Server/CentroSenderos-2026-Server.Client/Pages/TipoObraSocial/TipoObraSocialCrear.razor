@page "/tipoobrasocial/crear"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obra-social-form-page">

    <div class="obra-social-card">

        <div class="card-header">

            <div>

                <button type="button"
                        class="back-button"
                        @onclick="Volver">

                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>

                </button>

                <h1>Nueva Obra Social</h1>

                <p>
                    Complete los datos de la obra social.
                </p>

            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    disabled="@guardando"
                    @onclick="Cancelar">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>

        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="obra-social-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />

            <div class="field-group">

                <label>OBRA SOCIAL</label>

                <InputText class="senderos-input"
                           @bind-Value="modelo.Tipo"
                           placeholder="Ingresar nombre de la obra social" />

                <ValidationMessage For="@(() => modelo.Tipo)" />

            </div>

            <div class="field-group">

                <label>CUIT</label>

                <InputText class="senderos-input"
                           @bind-Value="modelo.Cuit"
                           @onblur="FormatearCuitModelo"
                           inputmode="numeric"
                           maxlength="13"
                           placeholder="Ej.: 30-12345678-9" />

                <small class="field-help">
                    Ingresá los 11 números del CUIT, con o sin guiones.
                </small>

                <ValidationMessage For="@(() => modelo.Cuit)" />

            </div>

            <div class="field-group">

                <label>DESCRIPCIÓN</label>

                <InputTextArea class="senderos-textarea"
                               @bind-Value="modelo.Descripcion"
                               placeholder="Ingresar una descripción" />

                <ValidationMessage For="@(() => modelo.Descripcion)" />

            </div>

            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">

                    <i class="bi bi-exclamation-circle"></i>
                    <span>@Mensaje</span>

                </div>
            }

            <div class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        disabled="@guardando"
                        @onclick="Cancelar">

                    Cancelar

                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Obra Social</span>
                    }

                </button>

            </div>

        </EditForm>

    </div>

</div>

@code {

    private TipoObraSocialDTO modelo = CrearModeloVacio();

    private string Mensaje = string.Empty;
    private bool guardando;

    private async Task Grabar()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        Mensaje = string.Empty;

        modelo.Cuit = NormalizarCuit(modelo.Cuit);

        var resp = await Http.Post<TipoObraSocialDTO, int>(
            "api/tipoobrasocial",
            modelo
        );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo("/tipoobrasocial", true);
        }
        else
        {
            modelo.Cuit = FormatearCuit(modelo.Cuit);
            Mensaje = resp.ObtenerError();
        }
    }

    private void FormatearCuitModelo()
    {
        modelo.Cuit = FormatearCuit(modelo.Cuit);
    }

    private static string NormalizarCuit(string? cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit))
        {
            return string.Empty;
        }

        return new string(
            cuit.Where(char.IsDigit).ToArray()
        );
    }

    private static string FormatearCuit(string? cuit)
    {
        var cuitNormalizado = NormalizarCuit(cuit);

        if (cuitNormalizado.Length != 11)
        {
            return cuit?.Trim() ?? string.Empty;
        }

        return $"{cuitNormalizado[..2]}-" +
               $"{cuitNormalizado.Substring(2, 8)}-" +
               $"{cuitNormalizado[^1]}";
    }

    private static TipoObraSocialDTO CrearModeloVacio()
    {
        return new TipoObraSocialDTO
        {
            Tipo = string.Empty,
            Cuit = string.Empty,
            Descripcion = string.Empty
        };
    }

    private void Cancelar()
    {
        if (!guardando)
        {
            Nav.NavigateTo("/tipoobrasocial");
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }
}