@page "/tipoobrasocial/crear"
@using CentroSenderos_2026_Shared.DTO
@inject IHttpServicio Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="obra-social-form-page">

    <div class="obra-social-card">

        <div class="card-header">
            <button type="button"
                    class="back-button"
                    @onclick="Volver">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>
            <div>
                <h1>Nueva Obra Social</h1>
                <p>Complete los datos de la obra social.</p>
            </div>

            <button type="button"
                    class="close-button"
                    title="Cerrar"
                    @onclick="Cancelar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <EditForm Model="@modelo"
                  OnValidSubmit="Grabar"
                  class="obra-social-form">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />


            <div class="field-group">

                <label>OBRA SOCIAL</label>

                <InputText class="senderos-input"
                           @bind-Value="modelo.Tipo"
                           placeholder="Ingresar nombre de la obra social" />

                <ValidationMessage For="@(() => modelo.Tipo)" />

            </div>


            <div class="field-group">

                <label>DESCRIPCIÓN</label>

                <InputTextArea class="senderos-textarea"
                               @bind-Value="modelo.Descripcion"
                               placeholder="Ingresar una descripción" />

                <ValidationMessage For="@(() => modelo.Descripcion)" />

            </div>


            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="form-message">
                    @Mensaje
                </div>
            }


            <div class="form-actions">

                <button type="button"
                        class="btn-cancelar"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                <button type="submit"
                        class="btn-guardar"
                        disabled="@guardando">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar</span>
                    }

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private TipoDTO modelo = new()
    {
        Tipo = string.Empty,
        Descripcion = string.Empty
    };

    private string Mensaje = "";

    private bool guardando = false;


    private async Task Grabar()
    {
        guardando = true;
        Mensaje = "";

        var resp =
            await Http.Post<TipoDTO, int>(
                "api/tipoobrasocial",
                modelo
            );

        guardando = false;

        if (!resp.Error)
        {
            Nav.NavigateTo(
                "/tipoobrasocial",
                true
            );
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }


    private void Cancelar()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }


    private void Volver()
    {
        Nav.NavigateTo("/tipoobrasocial");
    }
}