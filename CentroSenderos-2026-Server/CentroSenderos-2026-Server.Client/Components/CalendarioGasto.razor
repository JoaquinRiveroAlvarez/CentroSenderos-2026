@inherits InputBase<DateTime?>
@using System.Globalization
@using System.Diagnostics.CodeAnalysis

<div class="calendario-campo" @onkeydown="CerrarConEscape">
    <button type="button" @attributes="AdditionalAttributes"
            class="calendario-disparador @CssClass"
            disabled="@Deshabilitado" aria-expanded="@(abierto ? "true" : "false")" @onclick="Alternar">
        <span>@(CurrentValue?.ToString("dd/MM/yyyy") ?? "Seleccionar fecha")</span>
        <i class="bi bi-calendar3" aria-hidden="true"></i>
    </button>

    @if (abierto && !Deshabilitado)
    {
        <div class="calendario-panel">
            <div class="calendario-encabezado">
                <button type="button" aria-label="Mes anterior"
                        disabled="@(mes == DateTime.MinValue.Date)"
                        @onclick="() => CambiarMes(-1)">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="calendario-mes">
                    <strong aria-live="polite">@mes.ToString("MMMM", cultura)</strong>
                    <input type="number" min="1" max="9999" aria-label="Año del calendario"
                           value="@mes.Year" @onchange="CambiarAnio" />
                </div>
                <button type="button" aria-label="Mes siguiente"
                        disabled="@(mes.Year == 9999 && mes.Month == 12)"
                        @onclick="() => CambiarMes(1)">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>

            <div class="calendario-dias">
                @foreach (var dia in nombresDias)
                {
                    <span aria-hidden="true">@dia</span>
                }
                @for (var i = 0; i < ((int)mes.DayOfWeek + 6) % 7; i++)
                {
                    <span aria-hidden="true"></span>
                }
                @for (var i = 0; i < DateTime.DaysInMonth(mes.Year, mes.Month); i++)
                {
                    var fecha = mes.AddDays(i);
                    <button type="button"
                            aria-label="@fecha.ToString("D", cultura)"
                            aria-current="@(fecha == DateTime.Today ? "date" : null)"
                            aria-pressed="@(fecha == CurrentValue?.Date ? "true" : "false")"
                            @onclick="() => Seleccionar(fecha)">@fecha.Day</button>
                }
            </div>

            <div class="calendario-acciones">
                <button type="button" @onclick="() => Seleccionar(DateTime.Today)">Hoy</button>
                @if (PermiteLimpiar)
                {
                    <button type="button" @onclick="() => Seleccionar(null)">Limpiar</button>
                }
                <button type="button" @onclick="() => abierto = false">Cerrar</button>
            </div>
        </div>
    }
</div>

@code {
    #region Parámetros y estado

    [Parameter]
    public bool Deshabilitado { get; set; }

    [Parameter]
    public bool PermiteLimpiar { get; set; }

    private static readonly CultureInfo cultura = CultureInfo.GetCultureInfo("es-AR");
    private static readonly string[] nombresDias = ["Lu", "Ma", "Mi", "Ju", "Vi", "Sá", "Do"];
    private bool abierto;
    private DateTime mes;

    #endregion

    #region Selección de fecha

    private void Alternar()
    {
        abierto = !abierto;
        if (abierto)
        {
            var fecha = CurrentValue ?? DateTime.Today;
            mes = new DateTime(fecha.Year, fecha.Month, 1);
        }
    }

    private void CambiarMes(int cantidad) => mes = mes.AddMonths(cantidad);

    private void CambiarAnio(ChangeEventArgs evento)
    {
        if (int.TryParse(evento.Value?.ToString(), out var anio) && anio is >= 1 and <= 9999)
            mes = new DateTime(anio, mes.Month, 1);
    }

    private void Seleccionar(DateTime? fecha)
    {
        CurrentValue = fecha;
        abierto = false;
    }

    private void CerrarConEscape(KeyboardEventArgs evento)
    {
        if (evento.Key == "Escape")
            abierto = false;
    }

    protected override bool TryParseValueFromString(string? value, out DateTime? result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (DateTime.TryParse(value, cultura, DateTimeStyles.None, out var fecha))
        {
            result = fecha;
            validationErrorMessage = null;
            return true;
        }

        result = null;
        validationErrorMessage = "Ingresá una fecha válida.";
        return false;
    }

    #endregion
}
