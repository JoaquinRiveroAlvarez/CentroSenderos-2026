<div class="administracion-fondo @(Icono is null ? null : "administracion-fondo-ficha")" inert="@Inactivo" @onclick="CerrarDesdeFondo">
    <section class="administracion-modal" role="dialog" aria-modal="true"
             aria-labelledby="@idTitulo" @onclick:stopPropagation="true">
        <header class="administracion-cabecera">
            @if (Icono is not null)
            {
                <span class="administracion-icono" aria-hidden="true"><i class="bi @Icono"></i></span>
                <div>
                    <span class="administracion-seccion">Administración</span>
                    <h2 id="@idTitulo">@Titulo</h2>
                </div>
            }
            else
            {
                <h2 id="@idTitulo">@Titulo</h2>
            }
            <button type="button" class="administracion-x" aria-label="Cerrar"
                    disabled="@Ocupado" @onclick="AlCerrar">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </header>
        @ChildContent
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string? Icono { get; set; }
    [Parameter] public bool CerrarAlTocarFondo { get; set; }
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public bool Inactivo { get; set; }
    [Parameter] public EventCallback AlCerrar { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string idTitulo = $"administracion-{Guid.NewGuid():N}";

    private Task CerrarDesdeFondo() => CerrarAlTocarFondo && !Ocupado && !Inactivo
        ? AlCerrar.InvokeAsync()
        : Task.CompletedTask;
}
