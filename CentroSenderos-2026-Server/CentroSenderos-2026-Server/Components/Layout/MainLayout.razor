@inherits LayoutComponentBase

<AuthorizeView Context="layoutContext">

    <Authorized>

        <div class="layout layout-private">

            <NavMenu />

            <main class="main-content">

                <header class="top-row">

                    <div class="topbar-identity">

                        <span class="topbar-brand-name">
                            SENDEROS
                        </span>

                        <span class="topbar-divider"
                              aria-hidden="true"></span>

                        <span class="topbar-subtitle">
                            Espacio Terapéutico Integral
                        </span>

                    </div>

                    <NavLink href="Account/Manage"
                             class="topbar-account"
                             title="Mi cuenta"
                             aria-label="Mi cuenta">

                        <i class="bi bi-person-circle"
                           aria-hidden="true"></i>

                        <span>Mi cuenta</span>

                    </NavLink>

                </header>

                <div class="page-content">
                    @Body
                </div>

            </main>

        </div>

    </Authorized>

    <NotAuthorized>

        <div class="layout layout-public">

            <main class="main-content">

                <header class="top-row">

                    <div class="topbar-identity">

                        <img src="/imagenes/logo-senderos-sin-fondo.png"
                             alt=""
                             class="topbar-logo" />

                        <span class="topbar-brand-name">
                            SENDEROS
                        </span>

                        <span class="topbar-divider"
                              aria-hidden="true"></span>

                        <span class="topbar-subtitle">
                            Espacio Terapéutico Integral
                        </span>

                    </div>

                </header>

                <div class="page-content">
                    @Body
                </div>

            </main>

        </div>

    </NotAuthorized>

</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>