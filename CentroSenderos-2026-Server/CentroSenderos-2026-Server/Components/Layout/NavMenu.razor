@implements IDisposable
@inject NavigationManager NavigationManager

<aside class="sidebar" aria-label="Navegación del sistema">

    <div class="sidebar-header">

        <a href="/turnos"
           class="sidebar-brand"
           aria-label="Centro Senderos — Ir a Turnos">

            <img src="/imagenes/logo-senderos-sin-fondo.png"
                 alt="Centro Senderos" />

        </a>

    </div>

    <nav class="sidebar-nav" aria-label="Menú principal">

        <AuthorizeView Context="menuContext">

            <Authorized>

                <NavLink href="turnos"
                         class="sidebar-link"
                         title="Turnos">

                    <i class="bi bi-calendar"
                       aria-hidden="true"></i>

                    <span>Turnos</span>

                </NavLink>

                <NavLink href="profesionales"
                         class="sidebar-link"
                         title="Profesionales">

                    <i class="bi bi-person-workspace"
                       aria-hidden="true"></i>

                    <span>Profesionales</span>

                </NavLink>

                <NavLink href="pacientes"
                         class="sidebar-link"
                         title="Pacientes">

                    <i class="bi bi-people"
                       aria-hidden="true"></i>

                    <span>Pacientes</span>

                </NavLink>

                <NavLink href="gastos"
                         class="sidebar-link"
                         title="Caja">

                    <i class="bi bi-wallet2"
                       aria-hidden="true"></i>

                    <span>Caja</span>

                </NavLink>

                <NavLink href="liquidaciones"
                         class="sidebar-link"
                         title="Liquidaciones">

                    <i class="bi bi-receipt"
                       aria-hidden="true"></i>

                    <span>Liquidaciones</span>

                </NavLink>

                <NavLink href="planillas"
                         class="sidebar-link"
                         title="Planillas">

                    <i class="bi bi-table"
                       aria-hidden="true"></i>

                    <span>Planillas</span>

                </NavLink>

                <NavLink href="admin"
                         class="sidebar-link"
                         title="Administración">

                    <i class="bi bi-shield-lock"
                       aria-hidden="true"></i>

                    <span>Administración</span>

                </NavLink>

            </Authorized>

        </AuthorizeView>

    </nav>

    <div class="sidebar-footer">

        <AuthorizeView Context="accountContext">

            <Authorized>

                <form action="Account/Logout" method="post">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="ReturnUrl"
                           value="@currentUrl" />

                    <button type="submit"
                            class="sidebar-link logout-button"
                            title="Cerrar sesión">

                        <i class="bi bi-box-arrow-left"
                           aria-hidden="true"></i>

                        <span>Salir</span>

                    </button>

                </form>

            </Authorized>

        </AuthorizeView>

    </div>

</aside>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(
            NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(
            e.Location);

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}