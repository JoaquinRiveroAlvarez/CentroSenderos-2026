@inherits LayoutComponentBase
@layout CentroSenderos_2026_Server.Components.Layout.MainLayout

<div class="cuenta">
    <header class="cuenta-encabezado">
        <span class="cuenta-icono" aria-hidden="true"><i class="bi bi-person-circle"></i></span>
        <div>
            <h1>Mi cuenta</h1>
            <p>Administrá tu perfil, tus datos y la seguridad de tu cuenta.</p>
        </div>
