<StatusMessage Message="@StatusMessage" />
<h2>Códigos de recuperación</h2>
<div class="alert alert-warning" role="alert">
    <p><strong>Guardá estos códigos en un lugar seguro.</strong></p>
    <p>Si perdés acceso a tu aplicación de autenticación, podés usar uno de estos códigos para entrar a tu cuenta.</p>
</div>
<div class="cuenta-codigos">
    @foreach (var codigo in RecoveryCodes)
    {
        <code>@codigo</code>
    }
</div>
<a href="Account/Manage/TwoFactorAuthentication" class="btn btn-primary">Volver a seguridad</a>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
