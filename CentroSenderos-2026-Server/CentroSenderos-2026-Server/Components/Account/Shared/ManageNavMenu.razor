@using Microsoft.AspNetCore.Identity
@using CentroSenderos_2026_BD

@inject SignInManager<MiUsuario> SignInManager

<nav class="cuenta-menu" aria-label="Secciones de Mi cuenta">
<ul>
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage" Match="NavLinkMatch.All"><i class="bi bi-person" aria-hidden="true"></i><span>Perfil</span></NavLink>
    </li>
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage/Email"><i class="bi bi-envelope" aria-hidden="true"></i><span>Correo electrónico</span></NavLink>
    </li>
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage/ChangePassword"><i class="bi bi-lock" aria-hidden="true"></i><span>Contraseña</span></NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li>
            <NavLink class="cuenta-enlace" href="Account/Manage/ExternalLogins"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span>Accesos externos</span></NavLink>
        </li>
    }
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage/TwoFactorAuthentication"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Verificación en dos pasos</span></NavLink>
    </li>
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage/Passkeys"><i class="bi bi-key" aria-hidden="true"></i><span>Claves de acceso</span></NavLink>
    </li>
    <li>
        <NavLink class="cuenta-enlace" href="Account/Manage/PersonalData"><i class="bi bi-file-earmark-person" aria-hidden="true"></i><span>Datos personales</span></NavLink>
    </li>
</ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
