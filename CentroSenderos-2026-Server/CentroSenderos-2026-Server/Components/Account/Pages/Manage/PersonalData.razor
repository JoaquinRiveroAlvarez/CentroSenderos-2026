@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using CentroSenderos_2026_BD

@inject UserManager<MiUsuario> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<StatusMessage />
<h2>Datos personales</h2>

<div class="row">
    <div class="col-md-6">
        <p>Podés descargar los datos personales asociados a tu cuenta.</p>
        <p>
            <strong>Si eliminás tus datos, también se cerrará tu cuenta de forma permanente.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Descargar mis datos</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Eliminar mi cuenta</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
