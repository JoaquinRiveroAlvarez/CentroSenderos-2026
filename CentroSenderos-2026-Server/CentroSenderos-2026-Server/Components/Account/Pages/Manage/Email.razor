@page "/Account/Manage/Email"
@using Microsoft.AspNetCore.Identity
@using CentroSenderos_2026_BD
@inject UserManager<MiUsuario> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Correo electrónico | Mi cuenta</PageTitle>
<h2>Correo electrónico</h2>
<dl class="cuenta-dato">
    <dt>Correo actual</dt>
    <dd>@(correo ?? "Sin correo registrado")</dd>
    @if (!string.IsNullOrWhiteSpace(correo))
    {
        <dt>Estado</dt>
        <dd>@(confirmado ? "Verificado" : "Sin verificar")</dd>
    }
</dl>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string? correo;
    private bool confirmado;

    protected override async Task OnInitializedAsync()
    {
        var usuario = await UserManager.GetUserAsync(HttpContext.User);
        if (usuario is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        correo = await UserManager.GetEmailAsync(usuario);
        confirmado = await UserManager.IsEmailConfirmedAsync(usuario);
    }
}
